// Per-node-class allocation pools use separate free-slot and liveness metadata.

#if defined(_REENTRANT) && defined(HAVE_PTHREAD_H)
#include <pthread.h>
static pthread_mutex_t $CLASSNAME_allocation_mutex =
    PTHREAD_MUTEX_INITIALIZER;
#else
#ifndef ALLOC_MUTEX
#define ALLOC_MUTEX(CLASS_NAME, HOW)
#endif
#ifdef _REENTRANT
#error "Threaded AST allocation requires POSIX thread support"
#endif
#endif

#include <algorithm>
#include <cstdint>
#include <limits>

const unsigned $CLASSNAME::pool_size = DEFAULT_CLASS_ALLOCATION_POOL_SIZE;

#ifndef ROSE_ALLOC_MEMSET
#define ROSE_ALLOC_MEMSET 0
#endif

#if ROSE_ALLOC_MEMSET != 0 && ROSE_ALLOC_MEMSET != 2 && ROSE_ALLOC_MEMSET != 3
#error "ROSE_ALLOC_MEMSET must be 0, 2, or 3"
#endif

#ifndef ROSE_PEDANTIC_ALLOC
#define ROSE_PEDANTIC_ALLOC 0
#endif

#ifndef ROSE_ALLOC_MEMSET_OFFSET
// Number of pointer-sized words preserved by diagnostic fills.
#define ROSE_ALLOC_MEMSET_OFFSET 1
#endif

std::vector<unsigned char *> $CLASSNAME::pools;
std::vector<unsigned> $CLASSNAME::free_slots;
std::vector<std::vector<unsigned char>> $CLASSNAME::pool_live_flags;

// This macro protects allocation functions by locking/unlocking a mutex. We
// have one mutex defined for each Sage class. The HOW argument should be the
// word "lock" or "unlock".  Using a macro allows us to not have to use
// conditional compilation every time we access a mutex (in the case where
// mutexes aren't defined on one OS, we can place the conditional compilation
// around this macro definition rather than each use).
#ifndef ALLOC_MUTEX
#define ALLOC_MUTEX(CLASS_NAME, HOW)                                           \
  do {                                                                         \
    if (pthread_mutex_##HOW(&CLASS_NAME##_allocation_mutex)) {                 \
      fprintf(stderr, "%s mutex %s failed\n", #CLASS_NAME, #HOW);              \
      abort();                                                                 \
    }                                                                          \
  } while (0);
#endif

void *$CLASSNAME::operator new(size_t Size) {
  /* This entire function is protected by a mutex.  To avoid deadlock, be sure
   * to unlock the mutex before returning or throwing an exception. */
  ALLOC_MUTEX($CLASSNAME, lock);

#if ROSE_PEDANTIC_ALLOC
  ROSE_ASSERT(Size == sizeof($CLASSNAME));
#else
  if (Size != sizeof($CLASSNAME)) {
    void *object = ROSE_MALLOC(Size);
    ALLOC_MUTEX($CLASSNAME, unlock);
    return object;
  }
#endif

  if ($CLASSNAME::free_slots.empty()) {
    const size_t previous_pool_count = $CLASSNAME::pools.size();
    const size_t slot_count =
        (previous_pool_count + 1) * size_t($CLASSNAME::pool_size);
    ROSE_ASSERT(slot_count <= std::numeric_limits<unsigned>::max());
    unsigned char *alloc = (unsigned char *)ROSE_MALLOC(
        $CLASSNAME::pool_size * sizeof($CLASSNAME));
    ROSE_ASSERT(alloc != nullptr);

#if ROSE_ALLOC_MEMSET == 2
    memset(alloc, 0x00, $CLASSNAME::pool_size * sizeof($CLASSNAME));
#elif ROSE_ALLOC_MEMSET == 3
    memset(alloc, 0xAA, $CLASSNAME::pool_size * sizeof($CLASSNAME));
#endif
    try {
      // Every slot can be free at once, so operator delete never grows the
      // free list.
      if ($CLASSNAME::free_slots.capacity() < slot_count)
        $CLASSNAME::free_slots.reserve(
            std::max(slot_count, 2 * $CLASSNAME::free_slots.capacity()));
      $CLASSNAME::pools.push_back((unsigned char *)alloc);
      $CLASSNAME::pool_live_flags.emplace_back($CLASSNAME::pool_size, 0);
      {
        auto &all_pools = SgNode::allPools();
        SgNode::PoolEntry entry{(unsigned char *)alloc,
                                $CLASSNAME::pool_size * sizeof($CLASSNAME),
                                sizeof($CLASSNAME),
                                $CLASSNAME::pool_live_flags.back().data(),
                                V_$CLASSNAME,
                                &SgNode::PoolResetter<$CLASSNAME>::reset,
                                previous_pool_count};
        size_t insert_pos = 0;
        std::uintptr_t entry_base =
            reinterpret_cast<std::uintptr_t>(entry.base);
        while (insert_pos < all_pools.size()) {
          std::uintptr_t pool_base =
              reinterpret_cast<std::uintptr_t>(all_pools[insert_pos].base);
          if (pool_base >= entry_base) {
            break;
          }
          ++insert_pos;
        }
        all_pools.insert(all_pools.begin() + insert_pos, entry);
      }
    } catch (...) {
      $CLASSNAME::pool_live_flags.resize(previous_pool_count);
      $CLASSNAME::pools.resize(previous_pool_count);
      ROSE_FREE(alloc);
      ALLOC_MUTEX($CLASSNAME, unlock);
      throw;
    }
    // A new pool hands out its slots in address order.
    for (size_t slot = slot_count; slot-- > slot_count - $CLASSNAME::pool_size;)
      $CLASSNAME::free_slots.push_back(static_cast<unsigned>(slot));
  }

  const unsigned free_slot = $CLASSNAME::free_slots.back();
  $CLASSNAME::free_slots.pop_back();
  const size_t pool_index = free_slot / $CLASSNAME::pool_size;
  const size_t slot_index = free_slot % $CLASSNAME::pool_size;
  unsigned char *object_bytes = $CLASSNAME::pools[pool_index] +
                                slot_index * sizeof($CLASSNAME);
  $CLASSNAME *object = reinterpret_cast<$CLASSNAME *>(object_bytes);
  $CLASSNAME::pool_live_flags[pool_index][slot_index] = 1;

#if ROSE_ALLOC_MEMSET == 2 || ROSE_ALLOC_MEMSET == 3
  constexpr size_t preserved_bytes = ROSE_ALLOC_MEMSET_OFFSET * sizeof(void *);
  static_assert(ROSE_ALLOC_MEMSET_OFFSET >= 0 &&
                    preserved_bytes <= sizeof($CLASSNAME),
                "AST allocation fill offset exceeds the object storage");
  memset(object_bytes + preserved_bytes, ROSE_ALLOC_MEMSET == 2 ? 0x00 : 0xBB,
         sizeof($CLASSNAME) - preserved_bytes);
#endif

  ALLOC_MUTEX($CLASSNAME, unlock);

  return object;
}

void $CLASSNAME::operator delete(void *Pointer, size_t Size) {
  /* Entire function is protected by a mutex. To prevent deadlock, be sure to
   * unlock this mutex before returning or throwing an exception. */
  ALLOC_MUTEX($CLASSNAME, lock);

#if ROSE_PEDANTIC_ALLOC
  ROSE_ASSERT(Size == sizeof($CLASSNAME));
#endif

  unsigned char *object_bytes = (unsigned char *)Pointer;
  ROSE_ASSERT(object_bytes != nullptr);

  // Pools of every class are indexed by address, so the owning pool is found
  // without scanning this class's pools.
  const SgNode::PoolEntry *pool = SgNode::findPoolEntry(object_bytes);
  if (pool == nullptr || pool->variant != V_$CLASSNAME) {
    ROSE_FREE(Pointer);
    ALLOC_MUTEX($CLASSNAME, unlock);
    return;
  }
  const size_t pool_index = pool->pool_index;
  const std::uintptr_t offset =
      reinterpret_cast<std::uintptr_t>(object_bytes) -
      reinterpret_cast<std::uintptr_t>(pool->base);
  ROSE_ASSERT(pool_index < $CLASSNAME::pools.size() &&
              $CLASSNAME::pools[pool_index] == pool->base &&
              offset % sizeof($CLASSNAME) == 0);
  const size_t slot_index = static_cast<size_t>(offset / sizeof($CLASSNAME));
  ROSE_ASSERT($CLASSNAME::pool_live_flags[pool_index][slot_index] == 1);
  $CLASSNAME::pool_live_flags[pool_index][slot_index] = 0;

#if ROSE_ALLOC_MEMSET == 2 || ROSE_ALLOC_MEMSET == 3
  constexpr size_t preserved_bytes = ROSE_ALLOC_MEMSET_OFFSET * sizeof(void *);
  static_assert(ROSE_ALLOC_MEMSET_OFFSET >= 0 &&
                    preserved_bytes <= sizeof($CLASSNAME),
                "AST allocation fill offset exceeds the object storage");
  memset(object_bytes + preserved_bytes, ROSE_ALLOC_MEMSET == 2 ? 0x00 : 0xDD,
         sizeof($CLASSNAME) - preserved_bytes);
#endif

  ROSE_ASSERT($CLASSNAME::free_slots.size() <
              $CLASSNAME::free_slots.capacity());
  $CLASSNAME::free_slots.push_back(
      static_cast<unsigned>(pool_index * $CLASSNAME::pool_size + slot_index));

  ALLOC_MUTEX($CLASSNAME, unlock);
}

// Only sized operator delete is provided: the runtime selects this overload,
// and declaring both overloads breaks consumers that require an unambiguous
// pointer to the deallocation function.
