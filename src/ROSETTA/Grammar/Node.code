// -*- c++ -*-
HEADER_LAMBDA_CAPTURE_POST_CONSTRUCTION_INITIALIZATION_START
void post_construction_initialization() override;
HEADER_LAMBDA_CAPTURE_POST_CONSTRUCTION_INITIALIZATION_END

SOURCE_LAMBDA_CAPTURE_POST_CONSTRUCTION_INITIALIZATION_START
void SgLambdaCapture::post_construction_initialization() {
  if (p_capture_variable == nullptr ||
      p_capture_variable->get_parent() != nullptr ||
      p_capture_initializer == nullptr ||
      p_capture_initializer->get_parent() != nullptr ||
      p_capture_initializer == p_capture_variable ||
      (p_closure_variable != nullptr &&
       (p_closure_variable->get_parent() != nullptr ||
        p_closure_variable == p_capture_variable ||
        p_closure_variable == p_capture_initializer))) {
    fprintf(stderr,
            "REX_AST_INVARIANT[lambda-capture-operand]: capture requires "
            "distinct detached typed expressions\n");
    ROSE_ABORT();
  }
  p_capture_variable->set_parent(this);
  p_capture_initializer->set_parent(this);
  if (p_closure_variable != nullptr)
    p_closure_variable->set_parent(this);
}
SOURCE_LAMBDA_CAPTURE_POST_CONSTRUCTION_INITIALIZATION_END

