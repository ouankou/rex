      : rose_graph_integerpair_edge_hash_multimap_base_type() {}
  rose_graph_integerpair_edge_hash_multimap(
      const rose_graph_integerpair_edge_hash_multimap &rhs)
      : rose_graph_integerpair_edge_hash_multimap_base_type(rhs),
        parent(rhs.parent) {}

  void set_parent(SgNode *new_parent) { parent = new_parent; }
  SgNode *get_parent() { return parent; }

  void delete_elements() {}

  ~rose_graph_integerpair_edge_hash_multimap() { delete_elements(); }
};

