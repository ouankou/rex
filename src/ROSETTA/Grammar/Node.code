// MS 2002: global type
/*! \brief Access to C++ Run Time Information (RTI)

    I'm unclear as to where this is used (Markus put it here, I think).

    \internal This is not a part of the public interface to SAGE III.

 */
struct RTIValueDescriptor {
public:
  const void *field;
  std::string (*formatter)(const void *);

  RTIValueDescriptor() : field(nullptr), formatter(nullptr) {}

  RTIValueDescriptor(const void *field0,
                     std::string (*formatter0)(const void *))
      : field(field0), formatter(formatter0) {}
};

class RTIValue {
private:
  mutable std::string storage;
  RTIValueDescriptor descriptor;
  mutable bool materialized;

public:
  RTIValue() : storage(), descriptor(), materialized(true) {}

  RTIValue(const std::string &value0)
      : storage(value0), descriptor(), materialized(true) {}

  RTIValue(const RTIValueDescriptor &descriptor0)
      : storage(), descriptor(descriptor0),
        materialized(descriptor0.formatter == nullptr) {}

  const std::string &str() const {
    if (materialized == false && descriptor.formatter != nullptr) {
      storage = descriptor.formatter(descriptor.field);
      materialized = true;
    }

    return storage;
  }

  operator std::string() const { return str(); }
};

class RTIMemberData {
  // DQ (12/31/2005): Note that we can't use "using namespace std;"
  // to simplify this code, or so it seems.
public:
  // The first two of these fields are constants, and so this avoids the
  // constructor
  const char *type;
  const char *name;
  RTIValue value;

  RTIMemberData() : type(nullptr), name(nullptr), value() {}

  RTIMemberData(const char *type0, const char *name0, const std::string &value0)
      : type(type0), name(name0), value(value0) {}

  RTIMemberData(const char *type0, const char *name0,
                const RTIValueDescriptor &value0)
      : type(type0), name(name0), value(value0) {}
};

typedef std::vector<RTIMemberData> RTIReturnType;

struct ReferenceToPointerHandler;

/*! \brief Supporting class from copy mechanism within ROSE.

    This class forms a base class for the SgShallowCopy and SgTreeCopy
    classes to support the control of copying of subtrees (what IR nodes
    are copied by a deep or shallow copy).

    To tailor a specific type of copy operation derive a class from this
    abstract class and define the clone_node function as required.
    context information if required muyst be obtained through local
    analysis inside the function using the parent or scope information
    at each IR node.

    \note This is an abstract class.

    \internal Used in ROSETTA generated copy functions on each IR node.
              The location of this code should perhaps be changed to be in the
              generate copy code rather than Node.code in ROSETTA/Grammar.
 */
class SgCopyHelp {
public:
  enum class ProvenancePolicy {
    TransformationOutput,
    PreserveExactFrontendSemantic,
  };

  // Internal identity rebinding constructs a new graph; it is not a source
  // edit to that graph. This scope applies only to exact mapped copy targets.
  class ConstructionScope {
    friend class SgCopyHelp;
    SgCopyHelp *previous;
    ConstructionScope *previousScope;
    SgCopyHelp *owner;
    const SgNode *original;

  public:
    explicit ConstructionScope(SgCopyHelp &help,
                               const SgNode *original = nullptr);
    ~ConstructionScope();
    ConstructionScope(const ConstructionScope &) = delete;
    ConstructionScope &operator=(const ConstructionScope &) = delete;
  };
  static bool isConstructingCopy(const SgNode *node);
  bool isCopyingOriginal(const SgNode *node) const;

private:
  static SgCopyHelp *&activeConstruction();
  static ConstructionScope *&activeScope();

public:
  // STL map type
  typedef std::map<const SgNode *, SgNode *> copiedNodeMapType;
  using copiedTypeReplacementMapType =
      std::unordered_map<const SgNode *, SgNode *>;
  using copiedTypeReplacementSnapshot =
      std::shared_ptr<const copiedTypeReplacementMapType>;
  using copiedPreprocessingMapType =
      std::map<const PreprocessingInfo *, PreprocessingInfo *>;
  typedef std::set<const SgNode *> originalNodeSetType;
  typedef std::map<const SgNode *, originalNodeSetType> originalNodeMapType;
  typedef std::set<SgNode *> supersededNodeSetType;
  typedef std::pair<const SgNode *, SgNode *> fixupNodePairType;
  struct FixupNodePairLess {
    bool operator()(const fixupNodePairType &lhs,
                    const fixupNodePairType &rhs) const {
      std::less<const SgNode *> originalLess;
      if (originalLess(lhs.first, rhs.first)) {
        return true;
      }
      if (originalLess(rhs.first, lhs.first)) {
        return false;
      }

      return std::less<SgNode *>()(lhs.second, rhs.second);
    }
  };
  typedef std::set<fixupNodePairType, FixupNodePairLess> fixupNodePairSetType;

private:
  // DQ (10/8/2007): Added support for the depth to be kept track of in the AST
  // copy mechansim.
  //! This data member records the depth of the traversal (root node == 0)
  int depth;
  ProvenancePolicy provenancePolicy;

  // This is mostly used for SgSymbol IR nodes (but will likely be used for
  // other IR nodes in the future.
  //! This is internal state used to asscociate pairs of IR nodes copied instead
  //! of shared.
  copiedNodeMapType copiedNodeMap;
  copiedPreprocessingMapType copiedPreprocessingMap;

  // Multiple source identities can intentionally share a canonical target.
  // Track every source so exact-copy consumers can reject ambiguous roles
  // without scanning the entire transaction for each copied node.
  originalNodeMapType originalNodeMap;
  void removeOriginalNodePair(const SgNode *original, const SgNode *copy);

  // The pair mutators also index the two subsets that type materialization
  // seeds from, so a materialization never rescans every copied node (which
  // made whole-file copies quadratic).  The type index is copy-on-write: a
  // materialization holds an immutable snapshot of it, and a mutation made
  // while a snapshot is alive detaches the index first.
  std::shared_ptr<copiedTypeReplacementMapType> copiedTypeReplacements =
      std::make_shared<copiedTypeReplacementMapType>();
  std::unordered_set<const SgNode *> copiedFortranSourceNames;
  copiedTypeReplacementMapType &writableCopiedTypeReplacements();
  void indexCopiedNodePair(const SgNode *key, SgNode *value);
  void unindexCopiedNodePair(const SgNode *key);
  enum class ReferenceTargetKind { ExactNode, PlannedScope };
  using ReferenceBinding = std::function<void(SgNode *, ReferenceTargetKind)>;
  std::map<const SgNode *, std::vector<ReferenceBinding>> pendingReferences;
  void bindCopyReference(const SgNode *original, ReferenceBinding binding);

  // When a canonical copied node replaces a provisional deep copy in the
  // copied-node map, keep the superseded node so it can be discarded once
  // all copied edges have been rewired to the canonical node.
  supersededNodeSetType supersededNodeCopies;

  // Track fixup state for original/copy pairs so cyclic declaration links can
  // reuse in-progress work without recurring indefinitely.
  fixupNodePairSetType activeFixupNodePairs;
  fixupNodePairSetType completedFixupNodePairs;

public:
  // STL map iterator type
  typedef copiedNodeMapType::const_iterator copiedNodeMapTypeIterator;
  typedef supersededNodeSetType::iterator supersededNodeSetTypeIterator;
  typedef fixupNodePairSetType::iterator fixupNodePairSetTypeIterator;

  virtual SgNode *copyAst(const SgNode *n) = 0;
  template <class T> void bindCopiedReference(T *&edge, const T *original) {
    edge = nullptr;
    if (original != nullptr) {
      bindCopyReference(original, [&edge, original](SgNode *target,
                                                    ReferenceTargetKind kind) {
        edge = dynamic_cast<T *>(target);
        ASSERT_not_null(edge);
        ROSE_ASSERT(edge->variantT() == original->variantT() ||
                    (kind == ReferenceTargetKind::PlannedScope &&
                     isSgScopeStatement(original) != nullptr &&
                     isSgScopeStatement(edge) != nullptr));
      });
    }
  }
  void requireBoundCopiedReferences() const;
  void constructClassTypeCopy(const SgClassDeclaration *declaration);
  void constructEnumTypeCopy(const SgEnumDeclaration *declaration);
  void constructTemplateParameterTypeCopy(const SgTemplateParameter *parameter);

  SgNode *copyOrLookupAst(const SgNode *n) {
    if (n == nullptr) {
      return nullptr;
    }

    copiedNodeMapTypeIterator existing = copiedNodeMap.find(n);
    if (existing != copiedNodeMap.end()) {
      return existing->second;
    }

    return copyAst(n);
  }

  SgNode *copyOrLookupOwnedAst(const SgNode *n) {
    if (n == nullptr) {
      return nullptr;
    }

    copiedNodeMapTypeIterator existing = copiedNodeMap.find(n);
    if (existing != copiedNodeMap.end()) {
      return existing->second;
    }

    SgNode *copy = copyAst(n);
    if (copy == nullptr || copy == n) {
      fprintf(stderr,
              "REX_COPY_INVARIANT[owned-copy-edge]: source=%p copy=%p "
              "was not cloned by its exclusive owner transaction\n",
              static_cast<const void *>(n), static_cast<void *>(copy));
      ROSE_ABORT();
    }
    return copy;
  }

  // Default constructor (required to initialize the depth
  explicit SgCopyHelp(
      ProvenancePolicy policy = ProvenancePolicy::TransformationOutput)
      : depth(0), provenancePolicy(policy) {
    ROSE_ASSERT(policy == ProvenancePolicy::TransformationOutput ||
                policy == ProvenancePolicy::PreserveExactFrontendSemantic);
  }
  ProvenancePolicy getProvenancePolicy() const { return provenancePolicy; }

  // Defined the virtual destructor
  virtual ~SgCopyHelp() {}

  // DQ (10/8/2007): Access functions for the depth (inlined for performance).
  int get_depth() { return depth; }
  void incrementDepth() { depth++; }
  void decrementDepth() { depth--; }
  const copiedNodeMapType &get_copiedNodeMap() const { return copiedNodeMap; }
  const copiedPreprocessingMapType &get_copiedPreprocessingMap() const {
    return copiedPreprocessingMap;
  }
  void insertCopiedPreprocessingPair(const PreprocessingInfo *original,
                                     PreprocessingInfo *copy) {
    ROSE_ASSERT(original != nullptr && copy != nullptr && original != copy);
    ROSE_ASSERT(copiedPreprocessingMap.emplace(original, copy).second);
  }
  const originalNodeSetType &get_originalNodesForCopy(const SgNode *copy) const;
  //! Immutable snapshot of every non-identity type pair in the copied-node
  //! map; later pairs are not visible through it.
  copiedTypeReplacementSnapshot snapshotCopiedTypeReplacements() const {
    return copiedTypeReplacements;
  }
  //! Copied SgInitializedName sources that carry Fortran source-type syntax.
  const std::unordered_set<const SgNode *> &
  get_copiedFortranSourceNames() const {
    return copiedFortranSourceNames;
  }
  supersededNodeSetType &get_supersededNodeCopies() {
    return supersededNodeCopies;
  }
  bool beginFixupNodePair(const SgNode *original, SgNode *copy);
  void completeFixupNodePair(const SgNode *original, SgNode *copy);
  bool isFixupNodePairActive(const SgNode *original, SgNode *copy) const;
  bool isFixupNodePairCompleted(const SgNode *original, SgNode *copy) const;

  // Reset the state saved
  void clearState() {
    depth = 0;
    copiedNodeMap.clear();
    copiedPreprocessingMap.clear();
    originalNodeMap.clear();
    copiedTypeReplacements = std::make_shared<copiedTypeReplacementMapType>();
    copiedFortranSourceNames.clear();
    pendingReferences.clear();
    supersededNodeCopies.clear();
    activeFixupNodePairs.clear();
    completedFixupNodePairs.clear();
  }

  // Added things that generate symbols to the state (could be
  // SgDeclarationStatement or SgInitializedName objects).
  void insertCopiedNodePair(const SgNode *key, SgNode *value);
  void assignCopiedNodePair(const SgNode *key, SgNode *value);
  size_t eraseCopiedNodePair(const SgNode *key);
  void noteSupersededCopiedNode(SgNode *value);

  // Allow copy strategies to canonicalize the copied-node map before root
  // fixup starts. The default implementation only acts for non-identity
  // copies, so shallow/aliasing copy helpers remain inert.
  virtual void prepareRootCopyForFixup();

  // A copy producer that publishes a detached root into a known destination
  // may map semantic edges outside the structural copy transaction (most
  // notably the root declaration's enclosing scope).  The default contract is
  // exact identity; specialized producers must return the one explicitly
  // planned destination instead of relying on scope inference during fixup.
  // A null result means that no external edge was planned; this is distinct
  // from a valid identity plan where source and destination are the same node.
  virtual SgNode *
  plannedExternalSemanticCopyEdge(const SgNode *original) const {
    return NULL;
  }

  // Allow copy strategies to canonicalize the copied graph after the root node
  // finishes copying. The default implementation is a no-op for identity-only
  // copies and runs the shared deep-copy finalization otherwise.
  virtual void finalizeRootCopy();
};

/*! \brief Supporting class for "Shallow" copies of the AST.
    This class supports only shallow copies of the AST.
 */
class SgShallowCopy : public SgCopyHelp {
public:
  SgNode *copyAst(const SgNode *n) { return const_cast<SgNode *>(n); }
};

/*! \brief Supporting class for "Deep" copies of the AST.

    This class supports only deep copies of the AST.

\internal The name of this class should perhaps be changed to reflect that it is
a "deep" copy.

 */
class ROSE_DLL_API SgTreeCopy : public SgCopyHelp {
public:
  using SgCopyHelp::SgCopyHelp;
  SgNode *copyAst(const SgNode *n);
  void prepareRootCopyForFixup() override;
  void finalizeRootCopy() override;
};

// PC (8/3/2006): Support for subnode capturing
/*! \brief Supporting template class for "capturing" copies of the AST.

This class allows for retrieval of the clone of arbitrary source nodes
underneath the copied node.

*/
template <class CopyType> class SgCapturingCopy : public CopyType {
protected:
  std::vector<SgNode *> origList;
  std::vector<SgNode *> copyList;

public:
  SgCapturingCopy(std::vector<SgNode *> origList,
                  const CopyType &base = CopyType())
      // : origList(origList), CopyType(base)
      : CopyType(base), origList(origList), copyList(origList.size()) {}
  virtual ~SgCapturingCopy() {}
  SgNode *copyAst(const SgNode *n) {
    SgNode *newNode = CopyType::copyAst(n);
    int listSize = origList.size();
    for (int i = 0; i < listSize; i++) {
      if (origList[i] == n) {
        copyList[i] = newNode;
      }
    }
    return newNode;
  }
  const std::vector<SgNode *> &get_copyList() { return copyList; }
};

namespace ASTMemoryPool {
// Marker used by generated node code; it is compared but never dereferenced.
SgNode *validNodeMarker();
} // namespace ASTMemoryPool

class ROSE_VisitTraversal {
public:
  virtual ~ROSE_VisitTraversal() {};
  virtual void visit(SgNode *node) = 0;
  void traverseMemoryPool() { traverseMemoryPoolNodes(*this); }
  void traverseRepresentativeIRnodes() { traverseRepresentativeNodes(*this); }
};

class UnparseDelegate;
class UnparseFormatHelp;

