void SgNode::post_construction_initialization() {
  SourceStateConstruction::recordNode(this);
}

SgNode::SourceStateConstruction *&SgNode::SourceStateConstruction::current() {
  static thread_local SourceStateConstruction *scope = nullptr;
  return scope;
}

SgNode::SourceStateConstruction::SourceStateConstruction()
    : previous(current()) {
  current() = this;
}

SgNode::SourceStateConstruction::~SourceStateConstruction() {
  ROSE_ASSERT(current() == this);
  current() = previous;
}

void SgNode::SourceStateConstruction::recordNode(const SgNode *node) {
  for (auto *scope = current(); scope != nullptr; scope = scope->previous)
    scope->nodes.insert(node);
}

bool SgNode::SourceStateConstruction::contains(const SgNode *node) {
  for (auto *scope = current(); scope != nullptr; scope = scope->previous)
    if (scope->nodes.count(node) != 0)
      return true;
  return false;
}

namespace {
std::atomic<uint64_t> &globalAstModificationSequenceCounter() {
  static std::atomic<uint64_t> counter(0);
  return counter;
}

uint64_t noteAstModification() {
  return globalAstModificationSequenceCounter().fetch_add(
             1, std::memory_order_release) + 1;
}
} // namespace

uint64_t SgNode::get_globalAstModificationSequence() {
  return globalAstModificationSequenceCounter().load(std::memory_order_acquire);
}

void SgNode::set_isModified(bool isModified) {

  const bool became_modified = isModified && p_isModified == false;
  p_isModified = isModified;

  if (became_modified) {
    noteAstModification();
  }
}

bool SgNode::isUnderConstruction() const {
  return SgCopyHelp::isConstructingCopy(this) ||
         SourceStateConstruction::contains(this);
}

void SgNode::markAsModified() {

  // Construction preserves source edit state from typed metadata. Still
  // advance the structural sequence: caches must observe new bindings.
  const uint64_t sequence = noteAstModification();
  if (!isUnderConstruction()) {
    p_isModified = true;
    p_lastMutationSequence = sequence;
  }
}

void SgNode::markSourceMetadataAsModified() {
  if (!isUnderConstruction())
    p_isModified = true;
  noteAstModification();
}

bool SgNode::get_isModified() const {

  return p_isModified;
}

void SgNode::set_containsTransformation(bool containsTransformation) {

  const bool became_transformed =
      containsTransformation && p_containsTransformation == false;
  p_containsTransformation = containsTransformation;

  if (became_transformed) {
    noteAstModification();
  }
}

bool SgNode::get_containsTransformation() const {

  return p_containsTransformation;
}

//  ! Permits specification of parent node (connects the AST tree)
/*  ! This function is called internally to connect the elements of the grammar
 * to form the AST.
 */
void SgNode::set_parent(SgNode *parent) {
  // A detached node has no parent.
  ASSERT_require(this != parent);
  p_parent = parent;


  if ((variantT() == V_SgTemplateDeclaration) &&
      (parent != nullptr &&
       parent->variantT() == V_SgTemplateInstantiationFunctionDecl)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[parent-kind]: SgTemplateDeclaration cannot be "
            "owned by SgTemplateInstantiationFunctionDecl\n");
    ROSE_ABORT();
  }


  if ((variantT() == V_SgTemplateInstantiationDecl) &&
      (parent != nullptr && parent->variantT() == V_SgClassType)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[parent-kind]: SgTemplateInstantiationDecl "
            "cannot be owned by SgClassType\n");
    ROSE_ABORT();
  }
}

SgNode *SgNode::get_parent() const { return p_parent; }

//! Query whether the input node is an exact structural traversal child.
bool SgNode::isChild(SgNode *node) const {
  if (node == nullptr)
    return false;
  for (SgNode *child : get_traversalSuccessorContainer()) {
    if (child == node)
      return true;
  }
  return false;
}

std::string $CLASSNAME::unparseToString(SgUnparse_Info *info) const {
  std::string outputString = globalUnparseToString(this, info);
  return outputString;
}

std::string $CLASSNAME::unparseToString() const {
  return this->unparseToString(nullptr);
}

std::string $CLASSNAME::unparseToCompleteString() {
  SgUnparse_Info info;
  info.unset_SkipComments();
  info.unset_SkipWhitespaces();
  return globalUnparseToString(this, &info);
}

SgCopyHelp::copiedTypeReplacementMapType &
SgCopyHelp::writableCopiedTypeReplacements() {
  if (copiedTypeReplacements.use_count() != 1) {
    copiedTypeReplacements =
        std::make_shared<copiedTypeReplacementMapType>(*copiedTypeReplacements);
  }
  return *copiedTypeReplacements;
}

void SgCopyHelp::indexCopiedNodePair(const SgNode *key, SgNode *value) {
  unindexCopiedNodePair(key);
  if (key == value) {
    return;
  }
  if (isSgType(key) != nullptr) {
    ROSE_ASSERT(isSgType(value) != nullptr);
    writableCopiedTypeReplacements().emplace(key, value);
  } else if (const auto *name = isSgInitializedName(key);
             name != nullptr && name->get_fortran_source_type() != nullptr) {
    copiedFortranSourceNames.insert(name);
  }
}

void SgCopyHelp::unindexCopiedNodePair(const SgNode *key) {
  if (copiedTypeReplacements->count(key) != 0) {
    writableCopiedTypeReplacements().erase(key);
  }
  copiedFortranSourceNames.erase(key);
}

void SgCopyHelp::insertCopiedNodePair(const SgNode *key, SgNode *value) {
  if (copiedNodeMap.emplace(key, value).second) {
    const bool inserted = originalNodeMap[value].insert(key).second;
    ROSE_ASSERT(inserted);
    indexCopiedNodePair(key, value);
    const SgNode *sourceOwner = key->get_parent();
    const auto owner = copiedNodeMap.find(sourceOwner);
    const bool pendingParameterScope =
        isSgFunctionParameterScope(key) != nullptr &&
        isSgFunctionDeclaration(sourceOwner) != nullptr;
    if (key != value && sourceOwner != nullptr && !pendingParameterScope &&
        isCopyingOriginal(sourceOwner) && owner != copiedNodeMap.end() &&
        owner->second != sourceOwner) {
      ROSE_ASSERT(value->get_parent() == nullptr ||
                  value->get_parent() == sourceOwner ||
                  value->get_parent() == owner->second);
      value->set_parent(owner->second);
    }
    const auto pending = pendingReferences.find(key);
    if (pending != pendingReferences.end()) {
      for (const auto &binding : pending->second)
        binding(value, ReferenceTargetKind::ExactNode);
      pendingReferences.erase(pending);
    }
  }
}

void SgCopyHelp::bindCopyReference(const SgNode *original,
                                   ReferenceBinding binding) {
  const auto mapped = copiedNodeMap.find(original);
  if (mapped != copiedNodeMap.end()) {
    binding(mapped->second, ReferenceTargetKind::ExactNode);
    return;
  }

  std::unordered_set<const SgNode *> ancestors;
  const SgNode *semantic_owner = original;
  if (const auto *named = isSgNamedType(original)) {
    semantic_owner = named->get_declaration();
    ASSERT_not_null(semantic_owner);
  } else if (const auto *type = isSgTemplateType(original)) {
    semantic_owner = type->get_template_parameter();
    ASSERT_not_null(semantic_owner);
  }
  bool internal = false;
  for (const SgNode *owner = semantic_owner; owner != nullptr;
       owner = owner->get_parent()) {
    ROSE_ASSERT(ancestors.insert(owner).second);
    const auto mappedOwner = copiedNodeMap.find(owner);
    if (isCopyingOriginal(owner) ||
        (mappedOwner != copiedNodeMap.end() && mappedOwner->second != owner)) {
      internal = true;
      break;
    }
  }
  if (internal) {
    if (isSgDeclarationScope(original) != nullptr ||
        (isSgFunctionParameterScope(original) != nullptr &&
         isSgFunctionDeclaration(original->get_parent()) != nullptr)) {
      pendingReferences[original].push_back(std::move(binding));
      copyOrLookupOwnedAst(original);
      return;
    }
    if (const auto *type = isSgTemplateType(original)) {
      if (type->get_template_parameter()->get_type() != type) {
        auto *copy = isSgTemplateType(type->copy(*this));
        ROSE_ASSERT(copy != nullptr && copy != type &&
                    copiedNodeMap.at(original) == copy);
        binding(copy, ReferenceTargetKind::ExactNode);
        return;
      }
    }
    // Declaration-owned identities are published by their exact constructors.
    pendingReferences[original].push_back(std::move(binding));
    return;
  }

  SgNode *external = plannedExternalSemanticCopyEdge(original);
  auto kind = ReferenceTargetKind::ExactNode;
  if (external != nullptr && isSgScopeStatement(original) != nullptr &&
      isSgScopeStatement(external) != nullptr)
    kind = ReferenceTargetKind::PlannedScope;
  binding(external != nullptr ? external : const_cast<SgNode *>(original),
          kind);
}

void SgCopyHelp::requireBoundCopiedReferences() const {
  if (!pendingReferences.empty()) {
    const SgNode *original = pendingReferences.begin()->first;
    fprintf(stderr,
            "REX_COPY_INVARIANT[unconstructed-reference]: source=%p/%s name=%s "
            "has no exact target at the construction boundary\n",
            static_cast<const void *>(original),
            original->class_name().c_str(),
            SageInterface::get_name(original).c_str());
    if (const auto *type = isSgTemplateType(original)) {
      const auto *parameter = type->get_template_parameter();
      const auto mapped = copiedNodeMap.find(parameter);
      fprintf(stderr,
              "REX_COPY_INVARIANT[unconstructed-template-type]: "
              "name='%s' depth=%d index=%d substitution=%d parameter=%p "
              "declared-type=%d mapped-parameter=%p\n",
              type->get_name().str(), type->get_template_parameter_depth(),
              type->get_template_parameter_position(),
              type->get_is_pack_substitution(),
              static_cast<const void *>(parameter),
              parameter != nullptr && parameter->get_type() == type,
              static_cast<void *>(mapped != copiedNodeMap.end()
                                      ? mapped->second : nullptr));
    }
    ROSE_ABORT();
  }
}

const SgCopyHelp::originalNodeSetType &
SgCopyHelp::get_originalNodesForCopy(const SgNode *copy) const {
  static const originalNodeSetType noSources;
  const auto found = originalNodeMap.find(copy);
  return found != originalNodeMap.end() ? found->second : noSources;
}

void SgCopyHelp::removeOriginalNodePair(const SgNode *original,
                                        const SgNode *copy) {
  const auto found = originalNodeMap.find(copy);
  if (found == originalNodeMap.end() || found->second.erase(original) != 1) {
    fprintf(stderr,
            "REX_COPY_INVARIANT[reverse-identity-map]: source=%p copy=%p "
            "has no reverse transaction entry\n",
            static_cast<const void *>(original),
            static_cast<const void *>(copy));
    ROSE_ABORT();
  }
  if (found->second.empty()) {
    originalNodeMap.erase(found);
  }
}

void SgCopyHelp::assignCopiedNodePair(const SgNode *key, SgNode *value) {
  const auto existing = copiedNodeMap.find(key);
  if (existing == copiedNodeMap.end()) {
    insertCopiedNodePair(key, value);
  } else if (existing->second != value) {
    removeOriginalNodePair(key, existing->second);
    existing->second = value;
    const bool inserted = originalNodeMap[value].insert(key).second;
    ROSE_ASSERT(inserted);
    indexCopiedNodePair(key, value);
  }
}

size_t SgCopyHelp::eraseCopiedNodePair(const SgNode *key) {
  const auto existing = copiedNodeMap.find(key);
  if (existing == copiedNodeMap.end()) {
    return 0;
  }
  removeOriginalNodePair(key, existing->second);
  copiedNodeMap.erase(existing);
  unindexCopiedNodePair(key);
  return 1;
}

void SgCopyHelp::noteSupersededCopiedNode(SgNode *value) {
  if (value != nullptr) {
    supersededNodeCopies.insert(value);
  }
}

bool SgCopyHelp::beginFixupNodePair(const SgNode *original, SgNode *copy) {
  if (original == nullptr || copy == nullptr) {
    return false;
  }

  const fixupNodePairType pair(original, copy);
  if (completedFixupNodePairs.find(pair) != completedFixupNodePairs.end()) {
    return false;
  }

  return activeFixupNodePairs.insert(pair).second;
}

void SgCopyHelp::completeFixupNodePair(const SgNode *original, SgNode *copy) {
  if (original == nullptr || copy == nullptr) {
    return;
  }

  const fixupNodePairType pair(original, copy);
  activeFixupNodePairs.erase(pair);
  completedFixupNodePairs.insert(pair);
}

bool SgCopyHelp::isFixupNodePairActive(const SgNode *original,
                                       SgNode *copy) const {
  if (original == nullptr || copy == nullptr) {
    return false;
  }

  return activeFixupNodePairs.find(fixupNodePairType(original, copy)) !=
         activeFixupNodePairs.end();
}

bool SgCopyHelp::isFixupNodePairCompleted(const SgNode *original,
                                          SgNode *copy) const {
  if (original == nullptr || copy == nullptr) {
    return false;
  }

  return completedFixupNodePairs.find(fixupNodePairType(original, copy)) !=
         completedFixupNodePairs.end();
}

SgCopyHelp *&SgCopyHelp::activeConstruction() {
  static thread_local SgCopyHelp *active = nullptr;
  return active;
}

SgCopyHelp::ConstructionScope *&SgCopyHelp::activeScope() {
  static thread_local ConstructionScope *scope = nullptr;
  return scope;
}

SgCopyHelp::ConstructionScope::ConstructionScope(SgCopyHelp &help,
                                                 const SgNode *source)
    : previous(activeConstruction()), previousScope(activeScope()),
      owner(&help), original(source) {
  activeConstruction() = &help;
  activeScope() = this;
}

SgCopyHelp::ConstructionScope::~ConstructionScope() {
  ROSE_ASSERT(activeScope() == this);
  activeScope() = previousScope;
  activeConstruction() = previous;
}

bool SgCopyHelp::isCopyingOriginal(const SgNode *node) const {
  for (ConstructionScope *scope = activeScope(); scope != nullptr;
       scope = scope->previousScope) {
    if (scope->owner == this && scope->original == node) {
      return true;
    }
  }
  return false;
}

bool SgCopyHelp::isConstructingCopy(const SgNode *node) {
  SgCopyHelp *help = activeConstruction();
  if (help == nullptr)
    return false;
  const auto &originals = help->get_originalNodesForCopy(node);
  return !originals.empty() && originals.count(node) == 0;
}

SgNode *SgTreeCopy::copyAst(const SgNode *n) {
  SgNode *nCopy = nullptr;

  // Canonical semantic types are shared; owned source occurrences are copied.
  if (const SgType *type = isSgType(n)) {
    const SgFunctionType *functionType = isSgFunctionType(type);
    if (functionType != nullptr) {
      ASSERT_not_null(functionType->get_argument_list());
      ROSE_ASSERT(functionType->get_argument_list()->get_parent() ==
                  functionType);
    }
    const SgFunctionDeclaration *syntaxOwner = isSgFunctionDeclaration(
        functionType != nullptr ? functionType->get_parent() : nullptr);
    const SgTypedefType *alias = isSgTypedefType(type);
    const bool copyingAliasOwner =
        alias != nullptr && isCopyingOriginal(alias->get_declaration());
    std::vector<SgNode *> ownedChildren;
    const SgNode *owner = type->get_parent();
    if (owner != nullptr && isCopyingOriginal(owner))
      owner->appendDestructorOwnedNodes(ownedChildren);
    const auto *typedefOwner = isSgTypedefDeclaration(owner);
    const bool copyingTypeOwner =
        std::find(ownedChildren.begin(), ownedChildren.end(), type) !=
            ownedChildren.end() ||
        (typedefOwner != nullptr && isCopyingOriginal(typedefOwner) &&
         typedefOwner->get_base_type() == type);
    const bool copyingDeclaredExceptionSignature =
        syntaxOwner != nullptr &&
        syntaxOwner->get_declared_exception_signature() == functionType;
    if ((copyingTypeOwner &&
         (syntaxOwner == nullptr || copyingDeclaredExceptionSignature)) ||
        copyingAliasOwner || isSgNonrealType(type) != nullptr ||
        isSgDeclType(type) != nullptr || isSgTypeOfType(type) != nullptr ||
        type->has_source_prototype()) {
      nCopy = n->copy(*this);
    } else if (syntaxOwner != nullptr &&
               syntaxOwner->get_type_syntax() == functionType) {
      if (!syntaxOwner->get_type_syntax_is_available() ||
          syntaxOwner->get_type() == functionType ||
          functionType->get_argument_list() == nullptr ||
          functionType->get_argument_list()->get_parent() != functionType) {
        fprintf(stderr,
                "REX_COPY_INVARIANT[function-type-syntax-owner]: "
                "function=%p syntax=%p semantic=%p arguments=%p "
                "argument-owner=%p has no exact declaration-local syntax "
                "tree\n",
                static_cast<const void *>(syntaxOwner),
                static_cast<const void *>(functionType),
                static_cast<void *>(syntaxOwner->get_type()),
                static_cast<void *>(functionType->get_argument_list()),
                static_cast<void *>(
                    functionType->get_argument_list() != nullptr
                        ? functionType->get_argument_list()->get_parent()
                        : nullptr));
        ROSE_ABORT();
      }
      nCopy = n->copy(*this);
    } else {
      nCopy = const_cast<SgNode *>(n);
    }
  } else {
    // Every non-type structural node has a distinct copy.
    nCopy = n->copy(*this);
  }

  if (get_depth() == 0)
    requireBoundCopiedReferences();
  return nCopy;
}

// DQ (4/5/2017): Moved these function definition out of the header file to
// avoid warnings from assertion from the header file (OK if it appears once
// from compiling the source file).
VirtualCFG::CFGNode SgNode::cfgForBeginning() {
  return VirtualCFG::CFGNode(this, 0);
}

VirtualCFG::CFGNode SgNode::cfgForEnd() {
  return VirtualCFG::CFGNode(this, this->cfgIndexForEnd());
}

namespace SageInterface {
void registerAstTeardownAtExit();
}

void SgNode::initializeAstTeardown() {
  (void)allPools();
  (void)SgPointerMemberType::canonicalSemanticTypeCache();
  (void)SgTypeComplex::canonicalSemanticTypeCache();
  (void)SgTypeImaginary::canonicalSemanticTypeCache();
}

std::vector<SgNode::PoolEntry> &SgNode::allPools() {
  static std::vector<SgNode::PoolEntry> pools;
  static bool registered = false;
  if (!registered) {
    registered = true;
    SageInterface::registerAstTeardownAtExit();
  }
  return pools;
}

const SgNode::PoolEntry *SgNode::findPoolEntry(const unsigned char *ptr) {
  auto &pools = allPools();
  std::uintptr_t ptr_addr = reinterpret_cast<std::uintptr_t>(ptr);
  size_t lo = 0;
  size_t hi = pools.size();
  while (lo < hi) {
    size_t mid = lo + (hi - lo) / 2;
    const SgNode::PoolEntry &pool = pools[mid];
    std::uintptr_t base = reinterpret_cast<std::uintptr_t>(pool.base);
    std::uintptr_t end = base + pool.size;
    if (ptr_addr < base) {
      hi = mid;
    } else if (ptr_addr >= end) {
      lo = mid + 1;
    } else {
      return &pool;
    }
  }
  return nullptr;
}

VariantT SgNode::variantFromPool(SgNode const *n) {
  if (n == nullptr) {
    return (VariantT)0;
  }
  const unsigned char *ptr = reinterpret_cast<const unsigned char *>(n);
  const SgNode::PoolEntry *pool = findPoolEntry(ptr);
  if (pool == nullptr) {
    return (VariantT)0;
  }
  ROSE_ASSERT(pool->base != nullptr && pool->slot_size != 0);
  size_t offset = reinterpret_cast<std::uintptr_t>(ptr) -
                  reinterpret_cast<std::uintptr_t>(pool->base);
  return offset % pool->slot_size == 0 ? pool->variant : (VariantT)0;
}

bool SgNode::isLiveNode(const SgNode *node) {
  if (node == nullptr) {
    return false;
  }
  const unsigned char *ptr = reinterpret_cast<const unsigned char *>(node);
  const SgNode::PoolEntry *pool = findPoolEntry(ptr);
  if (pool == nullptr) {
    return true;
  }
  ROSE_ASSERT(pool->base != nullptr && pool->size != 0 &&
              pool->slot_size != 0 && pool->live_flags != nullptr);
  size_t offset = reinterpret_cast<std::uintptr_t>(ptr) -
                  reinterpret_cast<std::uintptr_t>(pool->base);
  if (offset % pool->slot_size != 0) {
    return false;
  }
  size_t slot_index = offset / pool->slot_size;
  return pool->live_flags[slot_index] != 0;
}

SOURCE_END
