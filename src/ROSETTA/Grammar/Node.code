public:
// Reconstruct source state without treating constructor bindings as user
// edits. Only nodes born inside this scope participate; mutations of existing
// nodes still record edits, and all bindings invalidate structural caches.
class SourceStateConstruction {
public:
  SourceStateConstruction();
  ~SourceStateConstruction();
  SourceStateConstruction(const SourceStateConstruction &) = delete;
  SourceStateConstruction &operator=(const SourceStateConstruction &) = delete;

private:
  friend class SgNode;
  static SourceStateConstruction *&current();
  static void recordNode(const SgNode *node);
  static bool contains(const SgNode *node);
  SourceStateConstruction *previous;
  std::set<const SgNode *> nodes;
};

bool isUnderConstruction() const;

/*! \brief All nodes in the AST contain a isModified flag used to track changes
   to the AST.

     This flag can be set but this is typically an internal function used to
   track the modifications to AST. Within future unparsing this flag will
   control where the token stream is used alternatively to the code generation
   from the AST.
 */
void set_isModified(bool isModified);

/*! \brief Records that this node was mutated.

    Unlike set_isModified(), this is the API for real AST mutations and
   advances the global modification sequence on every call.
 */
void markAsModified();
// Construction flags do not describe when a value changed. This sequence
// identifies actual setter mutations and is preserved by semantic copies.
uint64_t get_lastMutationSequence() const { return p_lastMutationSequence; }
// Location/provenance changes still invalidate source and structural caches,
// but do not change the semantic value represented by an expression.
void markSourceMetadataAsModified();

/*! \brief Many nodes can hide other AST nodes and we need to track when outer
   nodes contain modified nodes even if they are not themselves modified.

    This flag is required to support the unparsing using the token stream.
 */
void set_containsTransformation(bool containsTransformation);

/*! \brief Acess function for isModified flag

    This flag records if the current IR node has been modified.
    It is set to false after and ROSE front-end processing.
 */
bool get_isModified() const;

/*! \brief Acess function for containsTransformation flag

    This flag records if the current IR node has a nested AST node that is
