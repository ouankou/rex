  // access functions.
  void set_parent(SgNode *new_parent) { parent = new_parent; }
  SgNode *get_parent() { return parent; }

  void delete_elements() {}

  ~rose_graph_string_integer_hash_multimap() {
    delete_elements();

    parent = nullptr;
  }
};

