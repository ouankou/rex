  rose_graph_string_integer_hash_multimap()
      : rose_graph_string_integer_hash_multimap_base_type(), parent(nullptr) {}
  rose_graph_string_integer_hash_multimap(
      const rose_graph_string_integer_hash_multimap &rhs)
      : rose_graph_string_integer_hash_multimap_base_type(rhs),
        parent(rhs.parent) {}

