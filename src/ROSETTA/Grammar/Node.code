namespace SageInterface {
void registerAstTeardownAtExit();
}

void SgNode::initializeAstTeardown() { (void)allPools(); }

std::vector<SgNode::PoolEntry> &SgNode::allPools() {
  static std::vector<SgNode::PoolEntry> pools;
  static bool registered = false;
  if (!registered) {
    registered = true;
    SageInterface::registerAstTeardownAtExit();
  }
  return pools;
}

void SgNode::releaseAllPools() {
  std::vector<SgNode::PoolEntry>().swap(allPools());
}

const SgNode::PoolEntry *SgNode::findPoolEntry(const unsigned char *ptr) {
  auto &pools = allPools();
  std::uintptr_t ptr_addr = reinterpret_cast<std::uintptr_t>(ptr);
  size_t lo = 0;
  size_t hi = pools.size();
  while (lo < hi) {
    size_t mid = lo + (hi - lo) / 2;
    const SgNode::PoolEntry &pool = pools[mid];
    std::uintptr_t base = reinterpret_cast<std::uintptr_t>(pool.base);
    std::uintptr_t end = base + pool.size;
    if (ptr_addr < base) {
      hi = mid;
    } else if (ptr_addr >= end) {
      lo = mid + 1;
    } else {
      return &pool;
    }
  }
  return nullptr;
}

VariantT SgNode::variantFromPool(SgNode const *n) {
  if (n == nullptr) {
    return (VariantT)0;
  }
  const unsigned char *ptr = reinterpret_cast<const unsigned char *>(n);
  const SgNode::PoolEntry *pool = findPoolEntry(ptr);
  return pool ? pool->variant : (VariantT)0;
}

bool SgNode::isLiveNode(const SgNode *node) {
  if (node == nullptr) {
    return false;
  }
  const unsigned char *ptr =
      reinterpret_cast<const unsigned char *>(const_cast<SgNode *>(node));
  const SgNode::PoolEntry *pool = findPoolEntry(ptr);
  if (pool == nullptr) {
    return true;
  }
  if (pool->base == nullptr || pool->size == 0 || pool->slot_size == 0 ||
      pool->live_flags == nullptr) {
    return true;
  }
  size_t offset = static_cast<size_t>(ptr - pool->base);
  size_t slot_index = offset / pool->slot_size;
  return pool->live_flags[slot_index] != 0;
}

