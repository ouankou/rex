HEADER_START
          virtual SgName  get_name() const = 0;
          virtual SgType* get_type() const = 0;
          virtual SgNode* get_symbol_basis() const; // from HEADER

       // DQ (6/10/007): supports test of symbol declaration scope against symbol table's associated scope
          virtual SgScopeStatement* get_scope() const;

       // DQ (12/3/2011): refactoring support for symbol tables and symbols.
          SgName get_mangled_name() const;


HEADER_END


HEADER_GET_TYPE_START
          SgType* get_type() const override;
HEADER_GET_TYPE_END

HEADER_GET_NAME_START
          SgName get_name() const override;
          SgNode* get_symbol_basis() const override; // from GET_NAME
HEADER_GET_NAME_END


HEADER_DECLARATION_START
          SgMemberFunctionDeclaration* get_declaration() const;

       // DQ (6/10/2007): This is now deprecated in favor of a more uniform implementation for all symbols.
          SgClassDefinition *get_scope() const override ROSE_DEPRECATED_FUNCTION;

HEADER_DECLARATION_END


HEADER_LABEL_SYMBOL_START

      //! Type of label used (fortran only)
          enum label_type_enum
             {
               e_unknown_label_type      = 0,
               e_non_numeric_label_type  = 1,
               e_start_label_type        = 2,
               e_else_label_type         = 3,
               e_end_label_type          = 4,
            // DQ (2/1/2011): Added support for Fortran specific alternative return labels.
               e_alternative_return_type = 5,
               e_last_label_type         = 6
             };

          SgLabelSymbol ( SgInitializedName* initializedName );
          SgLabelSymbol ( SgStatement* statement, int numericValue,
                          label_type_enum labelType );

      //! Labels are scoped by their exact label-namespace symbol table, not
      //! by the labeled statement's lexical scope.
          SgScopeStatement* get_scope() const override;

HEADER_LABEL_SYMBOL_END


HEADER_ALIAS_SYMBOL_START
          SgAliasSymbol( const SgAliasSymbol & X );

          void post_construction_initialization() override;

          SgSymbol* get_alias() const;
          void set_alias(SgSymbol* alias);

      //! For a chain of aliased symbols, this function returns the last (non-aliased) symbol.
          SgSymbol* get_base() const;

      //! Where possible extract the declaration from the aliased symbol
          SgDeclarationStatement* get_declaration() const;

      //! An alias is visible in the exact symbol table that owns the alias,
      //! not in the canonical target declaration's scope.
          SgScopeStatement* get_scope() const override;
HEADER_ALIAS_SYMBOL_END

HEADER_RENAME_SYMBOL_START
          void post_construction_initialization() override;
          SgSymbol* get_original_symbol() const;
          void set_original_symbol(SgSymbol* original_symbol);

      //! A renamed symbol is semantically visible in the exact symbol table
      //! that owns the rename, not in the original declaration's scope.
          SgScopeStatement* get_scope() const override;

HEADER_RENAME_SYMBOL_END

HEADER_NAMESPACE_SYMBOL_START
          void post_construction_initialization() override;
HEADER_NAMESPACE_SYMBOL_END

HEADER_NAMELIST_SYMBOL_START
SgName get_name() const override;
SgType *get_type() const override;
SgNode *get_symbol_basis() const override;
SgScopeStatement *get_scope() const override;
const SgNameGroupPtrList &get_declarations() const { return p_declarations; }
void append_declaration(SgNameGroup *group);
void post_construction_initialization() override;
static SgNamelistSymbol *resolve(SgSymbol *symbol);
HEADER_NAMELIST_SYMBOL_END

SOURCE_NAMELIST_SYMBOL_START
void SgNamelistSymbol::post_construction_initialization() {
  ROSE_ASSERT(!p_declarations.empty());
  std::set<SgNameGroup *> seen;
  for (auto *group : p_declarations) {
    ROSE_ASSERT(group != nullptr && seen.insert(group).second);
  }
  get_scope();
}

SgScopeStatement *SgNamelistSymbol::get_scope() const {
  ROSE_ASSERT(!p_declarations.empty());
  auto *owner = isSgNamelistStatement(p_declarations.front()->get_parent());
  ROSE_ASSERT(owner != nullptr && owner->get_scope() != nullptr);
  auto *scope = owner->get_scope();
  ROSE_ASSERT(scope->get_symbol_table() != nullptr);
  auto *entries = scope->get_symbol_table()->get_table();
  ROSE_ASSERT(entries != nullptr);
  const SgName name(p_declarations.front()->get_group_name());
  for (auto *group : p_declarations) {
    group->validate_group();
    auto *declaration = isSgNamelistStatement(group->get_parent());
    ROSE_ASSERT(declaration != nullptr && declaration->get_scope() == scope);
    ROSE_ASSERT(entries->key_eq()(name, SgName(group->get_group_name())));
  }
  return scope;
}

SgName SgNamelistSymbol::get_name() const {
  ROSE_ASSERT(!p_declarations.empty());
  return SgName(p_declarations.front()->get_group_name());
}

SgNode *SgNamelistSymbol::get_symbol_basis() const {
  ROSE_ASSERT(!p_declarations.empty());
  return p_declarations.front();
}

void SgNamelistSymbol::append_declaration(SgNameGroup *group) {
  ROSE_ASSERT(group != nullptr);
  group->validate_group();
  auto *owner = isSgNamelistStatement(group->get_parent());
  auto *scope = get_scope();
  ROSE_ASSERT(owner != nullptr && owner->get_scope() == scope);
  ROSE_ASSERT(scope->get_symbol_table()->get_table()->key_eq()(
      get_name(), SgName(group->get_group_name())));
  ROSE_ASSERT(std::find(p_declarations.begin(), p_declarations.end(), group) ==
              p_declarations.end());
  p_declarations.push_back(group);
  markAsModified();
}

SgNamelistSymbol *SgNamelistSymbol::resolve(SgSymbol *symbol) {
  ROSE_ASSERT(symbol != nullptr);
  if (auto *alias = isSgAliasSymbol(symbol)) {
    symbol = alias->get_base();
  }
  auto *namelist = isSgNamelistSymbol(symbol);
  ROSE_ASSERT(namelist != nullptr);
  namelist->get_scope();
  return namelist;
}
SOURCE_NAMELIST_SYMBOL_END


SOURCE_START
static SgSymbol *validatedVisibilityBase(const SgSymbol *owner,
                                         SgSymbol *symbol) {
  std::set<const SgSymbol *> seen{owner};
  while (true) {
    if (auto *alias = isSgAliasSymbol(symbol)) {
      ROSE_ASSERT(seen.insert(alias).second);
      symbol = alias->get_alias();
    } else if (auto *rename = isSgRenameSymbol(symbol)) {
      ROSE_ASSERT(seen.insert(rename).second);
      symbol = rename->get_original_symbol();
    } else {
      break;
    }
  }
  ROSE_ASSERT(symbol != nullptr);
  auto *base = symbol;
  for (const auto *visited : seen)
    if (const auto *rename = isSgRenameSymbol(visited)) {
      ROSE_ASSERT(isSgFunctionDeclaration(base->get_symbol_basis()) != nullptr);
      ROSE_ASSERT(base->get_symbol_basis() == rename->get_declaration());
    }
  return base;
}

SgNode*
SgSymbol::get_symbol_basis() const
   {
     return NULL;
   }

SgScopeStatement*
SgSymbol::get_scope() const
   {
     SgScopeStatement* scope = NULL;
     const SgNode* basis = get_symbol_basis();

     ROSE_ASSERT(basis != NULL);

     const SgInitializedName* initializedName = isSgInitializedName(basis);
     if (initializedName != NULL)
        {
          scope = initializedName->get_scope();
        }

     const SgStatement* statement = isSgStatement(basis);
     if (statement != NULL)
        {
          scope = statement->get_scope();
        }

     ROSE_ASSERT(scope != NULL);
     return scope;
   }


SgName
SgSymbol::get_mangled_name() const
   {
     SgName mangledName;
     const SgSymbol* symbolFromTable = this;
     ROSE_ASSERT(symbolFromTable != NULL);

     switch(symbolFromTable->variantT())
        {
          case V_SgFunctionSymbol:
             {
               const SgFunctionSymbol* symbol = isSgFunctionSymbol(symbolFromTable);
               assert(symbol != NULL);
               SgFunctionDeclaration* functionDeclaration = symbol->get_declaration();

               ROSE_ASSERT(functionDeclaration != NULL);

               mangledName = functionDeclaration->get_mangled_name();

               break;
             }

          case V_SgMemberFunctionSymbol:
             {
               const SgMemberFunctionSymbol* symbol = isSgMemberFunctionSymbol(symbolFromTable);
               assert(symbol != NULL);
               SgFunctionDeclaration* functionDeclaration = symbol->get_declaration();

               ROSE_ASSERT(functionDeclaration != NULL);

               mangledName = functionDeclaration->get_mangled_name();
               break;
             }

          case V_SgClassSymbol:
             {
               const SgClassSymbol* symbol = isSgClassSymbol(symbolFromTable);
               assert(symbol != NULL);
               SgClassDeclaration* classDeclaration = symbol->get_declaration();

               ROSE_ASSERT(classDeclaration != NULL);

               mangledName = classDeclaration->get_mangled_name();
               break;
             }

          case V_SgEnumFieldSymbol:
             {
               const SgEnumFieldSymbol* symbol = isSgEnumFieldSymbol(symbolFromTable);
               assert(symbol != NULL);
               SgInitializedName* enumFieldName = symbol->get_declaration();

               ROSE_ASSERT(enumFieldName != NULL);

               mangledName = enumFieldName->get_mangled_name();
               break;
             }

          case V_SgEnumSymbol:
             {
               const SgEnumSymbol* symbol = isSgEnumSymbol(symbolFromTable);
               assert(symbol != NULL);
               SgEnumDeclaration* enumDeclaration = symbol->get_declaration();

               ROSE_ASSERT(enumDeclaration != NULL);

               mangledName = enumDeclaration->get_mangled_name();
               break;
             }

          case V_SgFunctionTypeSymbol:
             {
               const SgFunctionTypeSymbol* symbol = isSgFunctionTypeSymbol(symbolFromTable);
               assert(symbol != NULL);
               mangledName = symbol->get_name();

               break;
             }

          case V_SgLabelSymbol:
             {
               const SgLabelSymbol* symbol = isSgLabelSymbol(symbolFromTable);
               assert(symbol != NULL);
               SgLabelStatement* labelStatement = symbol->get_declaration();

               if (labelStatement == NULL)
                  {
                    assert(symbol->get_numeric_label_value() >= 0);
                    mangledName = Rose::StringUtility::numberToString(symbol->get_numeric_label_value());
                  }
                 else
                  {
                    mangledName = labelStatement->get_label();
                  }
               break;
             }

          case V_SgNamespaceSymbol:
             {
               const SgNamespaceSymbol* symbol = isSgNamespaceSymbol(symbolFromTable);
               assert(symbol != NULL);
               symbol->get_symbol_basis();
               if (symbol->get_aliasDeclaration() != NULL)
                  {
                    SgNamespaceAliasDeclarationStatement* namespaceAliasDeclarationStatement = symbol->get_aliasDeclaration();

                    ROSE_ASSERT(namespaceAliasDeclarationStatement != NULL);

                    mangledName = namespaceAliasDeclarationStatement->get_mangled_name();
                  }
                 else
                  {
                    SgNamespaceDeclarationStatement* namespaceDeclaration = symbol->get_declaration();

                    ROSE_ASSERT(namespaceDeclaration != NULL);

                    mangledName = namespaceDeclaration->get_mangled_name();
                  }
               break;
             }

          case V_SgTemplateSymbol:
             {
               const SgTemplateSymbol* symbol = isSgTemplateSymbol(symbolFromTable);
               assert(symbol != NULL);
               SgTemplateDeclaration* templateDeclaration = symbol->get_declaration();

               ROSE_ASSERT(templateDeclaration != NULL);

               mangledName = templateDeclaration->get_mangled_name();
               break;
             }

          case V_SgTypedefSymbol:
             {
               const SgTypedefSymbol* symbol = isSgTypedefSymbol(symbolFromTable);
               ROSE_ASSERT(symbol != NULL);
               SgTypedefDeclaration* typedefDeclaration = symbol->get_declaration();

               ROSE_ASSERT(typedefDeclaration != NULL);

               mangledName = typedefDeclaration->get_mangled_name();
               break;
             }

          case V_SgVariableSymbol:
             {
               const SgVariableSymbol* symbol = isSgVariableSymbol(symbolFromTable);
               ROSE_ASSERT(symbol != NULL);
               SgInitializedName* initializedName = symbol->get_declaration();

               ROSE_ASSERT(initializedName != NULL);

               mangledName = initializedName->get_mangled_name();
               break;
             }

          case V_SgAliasSymbol:
             {
               const SgAliasSymbol* symbol = isSgAliasSymbol(symbolFromTable);
               ROSE_ASSERT(symbol != NULL);
               mangledName = symbol->get_name();
               break;
             }

             case V_SgNamelistSymbol: {
               const auto *symbol = isSgNamelistSymbol(symbolFromTable);
               ROSE_ASSERT(symbol != nullptr);
               mangledName = symbol->get_scope()->get_mangled_name() +
                             "_namelist_" + symbol->get_name();
               break;
             }

             case V_SgTemplateFunctionSymbol: {
               const SgTemplateFunctionSymbol* symbol = isSgTemplateFunctionSymbol(symbolFromTable);
               ROSE_ASSERT(symbol != NULL);
               mangledName = symbol->get_name();
               break;
             }

          case V_SgTemplateClassSymbol:
             {
               const SgTemplateClassSymbol* symbol = isSgTemplateClassSymbol(symbolFromTable);
               ROSE_ASSERT(symbol != NULL);
               mangledName = symbol->get_name();
               break;
             }

          case V_SgTemplateMemberFunctionSymbol:
             {
               const SgTemplateMemberFunctionSymbol* symbol = isSgTemplateMemberFunctionSymbol(symbolFromTable);
               ROSE_ASSERT(symbol != NULL);
               mangledName = symbol->get_name();
               break;
             }

          case V_SgNonrealSymbol:
             {
               const SgNonrealSymbol* symbol = isSgNonrealSymbol(symbolFromTable);
               ROSE_ASSERT(symbol != NULL);
               mangledName = symbol->get_name();
               break;
             }

          case V_SgTemplateTypedefSymbol:
             {
               const SgTemplateTypedefSymbol* symbol = isSgTemplateTypedefSymbol(symbolFromTable);
               ROSE_ASSERT(symbol != NULL);
               ROSE_ASSERT(symbol->get_declaration() != NULL);

               SgTemplateTypedefDeclaration* typedefDeclaration = isSgTemplateTypedefDeclaration(symbol->get_declaration());
               if (typedefDeclaration != NULL)
                  {
                    mangledName = typedefDeclaration->get_mangled_name();
                 }
                 else
                  {
                    SgTemplateInstantiationTypedefDeclaration* typedefInstantiationDeclaration = isSgTemplateInstantiationTypedefDeclaration(symbol->get_declaration());
                    if (typedefInstantiationDeclaration != NULL)
                       {
                         mangledName = typedefInstantiationDeclaration->get_mangled_name();
                      }
                      else
                       {
                        fprintf(
                            stderr,
                            "REX_AST_INVARIANT[template-typedef-symbol]: "
                            "declaration=%p/%s is neither a template typedef "
                            "nor an instantiation\n",
                            static_cast<void *>(symbol->get_declaration()),
                            symbol->get_declaration()->class_name().c_str());
                        ROSE_ABORT();
                      }
                 }
                 break;
          }
          default: {
            fprintf(stderr,
                    "REX_AST_INVARIANT[symbol-mangled-name]: symbol=%p/%s "
                    "has no mangling case\n",
                    static_cast<const void *>(symbolFromTable),
                    symbolFromTable->class_name().c_str());
            ROSE_ABORT();
          }
        }

     return mangledName;
   }

SOURCE_END

SOURCE_GET_TYPE_START
SgType*
$CLASSNAME::get_type() const
   {
     return (get_declaration() != NULL) ? get_declaration()->get_type() : NULL;
   }

SOURCE_GET_TYPE_END


SOURCE_EMPTY_GET_TYPE_START
SgType*
$CLASSNAME::get_type() const
   {
     return NULL;
   }

SOURCE_EMPTY_GET_TYPE_END


SOURCE_SHORT_GET_NAME_START
SgName
$CLASSNAME::get_name() const
   {
     ROSE_ASSERT(get_declaration() != nullptr);
     return get_declaration()->get_name();
   }

SgNode*
$CLASSNAME::get_symbol_basis() const
   {
     ROSE_ASSERT(get_declaration() != nullptr);
     return get_declaration();
   }
SOURCE_SHORT_GET_NAME_END


SOURCE_SHORT_DEFAULT_GET_NAME_START
SgName
$CLASSNAME::get_name() const
   {
     return "Default_Symbol_Name";
   }

SgNode*
$CLASSNAME::get_symbol_basis() const
   {
     return NULL;
   }
SOURCE_SHORT_DEFAULT_GET_NAME_END


SOURCE_LABEL_SYMBOL_START
SgName SgLabelSymbol::get_name() const {
  get_symbol_basis();
  if (get_declaration() != nullptr)
    return get_declaration()->get_label();
  if (get_fortran_statement() != nullptr)
    return Rose::StringUtility::numberToString(get_numeric_label_value());
  return get_fortran_alternate_return_parameter()->get_name();
}

SgNode*
SgLabelSymbol::get_symbol_basis() const
   {
     const int basis_count = (get_declaration() != nullptr) +
                             (get_fortran_statement() != nullptr) +
                             (get_fortran_alternate_return_parameter() != nullptr);
     if (basis_count != 1)
        {
          fprintf(stderr,
                  "REX_SYMBOL_INVARIANT[label-basis]: label=%p has %d bases\n",
                  static_cast<const void*>(this), basis_count);
          ROSE_ABORT();
        }
     if (get_declaration() != nullptr)
       return get_declaration();
     if (get_fortran_statement() != nullptr)
       return get_fortran_statement();
     return get_fortran_alternate_return_parameter();
   }

SgScopeStatement*
SgLabelSymbol::get_scope() const
   {
     SgSymbolTable* symbolTable = isSgSymbolTable(get_parent());
     SgScopeStatement* scope = symbolTable != NULL
                                  ? isSgScopeStatement(symbolTable->get_parent())
                                  : NULL;
     if (symbolTable == NULL || scope == NULL ||
         scope->get_symbol_table() != symbolTable)
        {
          fprintf(stderr,
                  "REX_SYMBOL_INVARIANT[label-semantic-scope]: label=%p "
                  "parent=%p must belong to one exact scope-owned symbol "
                  "table before scope lookup\n",
                  static_cast<const void*>(this),
                  static_cast<void*>(get_parent()));
          ROSE_ABORT();
        }
     return scope;
   }

SgType*
SgLabelSymbol::get_type() const
   {
     return SgTypeLabel::createType();
   }

SgLabelSymbol::SgLabelSymbol ( SgInitializedName* initializedName )
   : SgSymbol()
   {
     ROSE_ASSERT(initializedName != NULL);

     ROSE_ASSERT(initializedName->get_name() == "*");

     p_declaration = NULL;
     p_fortran_statement = NULL;
     p_fortran_alternate_return_parameter = NULL;
     p_numeric_label_value = -1;

     p_label_type = e_alternative_return_type;

     set_fortran_alternate_return_parameter(initializedName);
     post_construction_initialization();
   }

   SgLabelSymbol::SgLabelSymbol(SgStatement *statement, int numericValue,
                                label_type_enum labelType)
       : SgSymbol() {
     if (statement == NULL || numericValue < 1 || numericValue > 99999 ||
         (labelType != e_start_label_type && labelType != e_end_label_type &&
          labelType != e_else_label_type) ||
         (labelType == e_else_label_type && isSgIfStmt(statement) == NULL)) {
       fprintf(stderr,
               "REX_SYMBOL_INVARIANT[fortran-label-construction]: "
               "statement=%p value=%d role=%d is not one exact numeric "
               "label\n",
               static_cast<void *>(statement), numericValue,
               static_cast<int>(labelType));
       ROSE_ABORT();
     }
     p_declaration = NULL;
     p_fortran_statement = statement;
     p_fortran_alternate_return_parameter = NULL;
     p_numeric_label_value = numericValue;
     p_label_type = labelType;
     post_construction_initialization();
   }

SOURCE_LABEL_SYMBOL_END


SOURCE_DECLARATION_START

SgMemberFunctionDeclaration*
SgMemberFunctionSymbol::get_declaration() const
   {
     SgFunctionDeclaration* funcionDeclaration = SgFunctionSymbol::get_declaration();
     if (funcionDeclaration == NULL)
          return NULL;
     SgMemberFunctionDeclaration* memberFuncionDeclaration = isSgMemberFunctionDeclaration(funcionDeclaration);
     ROSE_ASSERT(memberFuncionDeclaration != NULL);
     return memberFuncionDeclaration;
   }

SgClassDefinition*
SgMemberFunctionSymbol::get_scope() const
   {
     SgScopeStatement* scope = SgSymbol::get_scope();
     ROSE_ASSERT(scope != NULL);
     SgClassDefinition* classDefinition = isSgClassDefinition(scope);
     return classDefinition;
   }
SOURCE_DECLARATION_END




SOURCE_ALIAS_SYMBOL_START
SgName
SgAliasSymbol::get_name() const
   {
     SgSymbol* base = get_base();
     for (const SgAliasSymbol* alias = this; alias != nullptr;
          alias = isSgAliasSymbol(alias->get_alias()))
        {
          if (alias->get_isRenamed())
             return alias->get_new_name();
        }
     return base->get_name();
   }

SgNode*
SgAliasSymbol::get_symbol_basis() const
   {
     return get_base()->get_symbol_basis();
   }

SgType*
SgAliasSymbol::get_type() const
   {
     return get_base()->get_type();
   }

SgScopeStatement*
SgAliasSymbol::get_scope() const
   {
     SgSymbolTable* table = isSgSymbolTable(get_parent());
     SgScopeStatement* scope =
         table != NULL ? isSgScopeStatement(table->get_parent()) : NULL;
     size_t occurrences = 0;
     if (table != NULL && table->get_table() != NULL)
        {
          for (const auto &entry : *table->get_table())
             {
               if (entry.second == this)
                  ++occurrences;
             }
        }
     if (scope == NULL || occurrences != 1)
        {
          fprintf(stderr,
                  "REX_SYMBOL_INVARIANT[alias-symbol-scope]: symbol=%p "
                  "name='%s' table=%p scope=%p occurrences=%zu has no exact "
                  "visibility owner\n",
                  static_cast<const void*>(this), get_name().str(),
                  static_cast<void*>(table), static_cast<void*>(scope),
                  occurrences);
          ROSE_ABORT();
        }
     return scope;
   }

SgSymbol *SgAliasSymbol::get_base() const {
  validatedVisibilityBase(this, p_alias);
  auto *base = p_alias;
  while (auto *alias = isSgAliasSymbol(base))
    base = alias->get_alias();
  return base;
}

SgSymbol *SgAliasSymbol::get_alias() const { return p_alias; }

void SgAliasSymbol::set_alias(SgSymbol *alias) {
  validatedVisibilityBase(this, alias);
  p_alias = alias;
  markAsModified();
}

SgDeclarationStatement*
SgAliasSymbol::get_declaration() const
   {
     SgSymbol* base = get_base();
     SgNode* basis = base->get_symbol_basis();
     SgDeclarationStatement* declaration = isSgDeclarationStatement(basis);
     if (auto* name = isSgInitializedName(basis))
        {
          if (isSgVariableSymbol(base))
             declaration = isSgVariableDeclaration(name->get_parent());
          else if (isSgEnumFieldSymbol(base))
             declaration = name->get_declaration();
        }
     else if (auto* group = isSgNameGroup(basis))
        declaration = isSgNamelistStatement(group->get_parent());
     ROSE_ASSERT(declaration != nullptr);
     return declaration;
   }

SgAliasSymbol::SgAliasSymbol( const SgAliasSymbol & X ) : SgSymbol()
   {
     p_alias        = X.p_alias;
     p_isRenamed    = X.p_isRenamed;
     p_new_name     = X.p_new_name;
     p_causal_nodes = X.p_causal_nodes;

   }

void
SgAliasSymbol::post_construction_initialization()
   {
     ROSE_ASSERT(p_alias != NULL);
     get_base();
   }

SOURCE_ALIAS_SYMBOL_END


SOURCE_RENAME_SYMBOL_START
void SgRenameSymbol::post_construction_initialization() {
  validatedVisibilityBase(this, p_original_symbol);
}

SgSymbol *SgRenameSymbol::get_original_symbol() const { return p_original_symbol; }

void SgRenameSymbol::set_original_symbol(SgSymbol *original_symbol) {
  validatedVisibilityBase(this, original_symbol);
  p_original_symbol = original_symbol;
  markAsModified();
}

SgName
SgRenameSymbol::get_name() const
   {
     ROSE_ASSERT(p_original_symbol != NULL);

     return get_new_name();
   }

SgNode*
SgRenameSymbol::get_symbol_basis() const
   {
     return validatedVisibilityBase(this, p_original_symbol)->get_symbol_basis();
   }

SgType*
SgRenameSymbol::get_type() const
   {
     return validatedVisibilityBase(this, p_original_symbol)->get_type();
   }

   SgScopeStatement *SgRenameSymbol::get_scope() const {
     SgSymbolTable *table = isSgSymbolTable(get_parent());
     SgScopeStatement *scope =
         table != NULL ? isSgScopeStatement(table->get_parent()) : NULL;
     size_t occurrences = 0;
     if (table != NULL && table->get_table() != NULL) {
       for (const auto &entry : *table->get_table()) {
         if (entry.second == this)
           ++occurrences;
       }
     }
     if (scope == NULL || occurrences != 1) {
       fprintf(stderr,
               "REX_SYMBOL_INVARIANT[rename-symbol-scope]: symbol=%p "
               "name='%s' table=%p scope=%p occurrences=%zu has no exact "
               "visibility owner\n",
               static_cast<const void *>(this), get_name().str(),
               static_cast<void *>(table), static_cast<void *>(scope),
               occurrences);
       ROSE_ABORT();
     }
     return scope;
   }

SOURCE_RENAME_SYMBOL_END


SOURCE_NAMESPACE_SYMBOL_START

SgName
SgNamespaceSymbol::get_name() const
   {
     get_symbol_basis();
     return p_aliasDeclaration != NULL ? p_aliasDeclaration->get_name()
                                       : p_declaration->get_name();
   }

SgNode*
SgNamespaceSymbol::get_symbol_basis() const
   {
     if ((p_declaration == NULL) == (p_aliasDeclaration == NULL))
        {
          fprintf(stderr,
                  "REX_SYMBOL_INVARIANT[namespace-basis]: symbol=%p must "
                  "have exactly one typed namespace declaration basis\n",
                  static_cast<const void*>(this));
          ROSE_ABORT();
        }
     return p_aliasDeclaration != NULL ? static_cast<SgNode*>(p_aliasDeclaration)
                                       : p_declaration;
   }

void
SgNamespaceSymbol::post_construction_initialization()
   {
     get_symbol_basis();
   }

SOURCE_NAMESPACE_SYMBOL_END
