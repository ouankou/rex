//! internally
SgFile *operator[](unsigned int i);

//! Access function for retriving a SgFile object from the list stored
//! internally, but using the filename with full path.
SgFile *operator[](std::string filename);

//! function to generate output for all files in the project (arguments control
//! code generation)
