HEADER_FORMAT_ITEM_START
struct Intrinsic {
  enum class Kind { I, B, O, Z, F, E, EN, ES, EX, G, L, A, D };
  Kind kind;
  std::optional<int> width, digits, exponent_width;
};
struct Character {
  enum class Delimiter {
    single_quote,
    double_quote,
    hollerith_upper,
    hollerith_lower
  };
  std::string value;
  Delimiter delimiter;
};
struct Derived {
  std::optional<Character> tag;
  std::vector<std::int64_t> parameters;
};
struct Control {
  enum class Kind {
    T,
    TL,
    TR,
    X,
    Slash,
    Colon,
    SS,
    SP,
    S,
    P,
    BN,
    BZ,
    RU,
    RD,
    RZ,
    RN,
    RC,
    RP,
    DC,
    DP,
    Dollar,
    Backslash
  };
  Kind kind;
  std::int64_t count;
};
enum class Group { nested, unlimited };
struct Descriptor {
  std::variant<Intrinsic, Derived, Control, Character, Group> value;
  friend std::ostream &operator<<(std::ostream &out,
                                  const Descriptor &descriptor) {
    return out << "Fortran FORMAT descriptor variant "
               << descriptor.value.index();
  }
};
const Descriptor &get_descriptor() const { return p_descriptor; }
const std::optional<std::uint64_t> &get_repeat_count() const {
  return p_repeat_count;
}
SgFormatItemList *get_format_item_list() const { return p_format_item_list; }
static bool is_valid_descriptor(const Descriptor &descriptor,
                                std::optional<std::uint64_t> repeat,
                                bool has_group);
void validate() const;
void post_construction_initialization() override;
HEADER_FORMAT_ITEM_END

