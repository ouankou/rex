enum classifier {
  e_transformation = 0x1,     /*!< classify as a transformation */
  e_compiler_generated = 0x2, /*!< classify as compiler generated */
  e_output_in_code_generation =
      0x4,        /*!< classify as required when generating code in unparser
                     (orthogonal concept to transformation and compiler generated) */
  e_shared = 0x8, /*!< classify as a shared IR node */
  e_frontend_specific = 0x10, /*!< classify as frontend specific */
  e_source_position_unavailable_in_frontend =
      0x20, /*!< classify as unavailable from the frontend */
  e_comment_or_directive = 0x40, /*!< classify as a comment or directive (not a
                                    part of the language grammar) */
  e_token = 0x80, /*!< classify as a token from the parser (not a part of the
                     language grammar) */
  e_default_argument =
      0x100, /*!< classify as a default argument to a function call */
  e_implicit_cast = 0x200 /*!< classify as an implicit cast */
};

