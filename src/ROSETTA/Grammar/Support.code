                                                         filterTemplateSymbols);
}

template <class ReturnType>
bool templateParameterAndArgumentErrorChecking(
    SgTemplateParameterPtrList *templateParameterList,
    SgTemplateArgumentPtrList *templateArgumentList) {
  // Check which symbol kinds can be queried with template parameters and
  // arguments.

  bool returnValue = true;

  VariantT returnTypeVariant = (VariantT)ReturnType::static_variant;

  if ((returnTypeVariant != V_SgSymbol) &&
      (templateParameterList != NULL || templateArgumentList != NULL)) {
    if (templateParameterList != NULL) {
      returnValue = (returnTypeVariant == V_SgTemplateClassSymbol ||
                     returnTypeVariant == V_SgTemplateFunctionSymbol ||
                     returnTypeVariant == V_SgTemplateMemberFunctionSymbol ||
                     returnTypeVariant == V_SgNonrealSymbol);
    }

    if (templateParameterList != NULL && templateArgumentList != NULL) {
      returnValue = (returnTypeVariant == V_SgTemplateClassSymbol ||
                     returnTypeVariant == V_SgTemplateVariableSymbol ||
                     returnTypeVariant == V_SgNonrealSymbol);
    } else {
      if (templateArgumentList != NULL) {
        returnValue = (returnTypeVariant == V_SgClassSymbol ||
                       returnTypeVariant == V_SgFunctionSymbol ||
                       returnTypeVariant == V_SgMemberFunctionSymbol ||
                       returnTypeVariant == V_SgNonrealSymbol);
      }
    }
  }

  return returnValue;
}

template <class ReturnSymbolType>
ReturnSymbolType *
symbolFilter(ReturnSymbolType *symbol,
             SgTemplateParameterPtrList *templateParameterList,
             SgTemplateArgumentPtrList *templateArgumentList,
             bool filterTemplateSymbols) {
  if (symbol != NULL) {

    VariantT symbolVariant = symbol->variantT();

    if (templateParameterList != NULL) {
      if ((templateArgumentList != NULL) &&
          (symbolVariant == V_SgClassSymbol)) {
        symbol = NULL;
      }

      if ((templateArgumentList == NULL) &&
          (symbolVariant == V_SgFunctionSymbol ||
           symbolVariant == V_SgMemberFunctionSymbol)) {
        symbol = NULL;
      }
    } else {
      if (templateArgumentList != NULL) {
        if (symbolVariant == V_SgTemplateFunctionSymbol ||
            symbolVariant == V_SgTemplateMemberFunctionSymbol ||
            symbolVariant == V_SgTemplateClassSymbol) {
          symbol = NULL;
        }
      } else if (filterTemplateSymbols) {
        if (symbolVariant == V_SgTemplateFunctionSymbol ||
            symbolVariant == V_SgTemplateMemberFunctionSymbol ||
            symbolVariant == V_SgTemplateClassSymbol ||
            symbolVariant == V_SgTemplateTypedefSymbol ||
            symbolVariant == V_SgTemplateVariableSymbol) {
          symbol = NULL;
        }
      }
    }
  }

  return symbol;
}

bool isSubset(const std::vector<SgNode *> &a_vector,
              const SgUnorderedNodeSet &b_set) {
  return std::all_of(
      a_vector.begin(), a_vector.end(),
      [&b_set](SgNode *ptr) -> bool { return b_set.count(ptr) != 0; });
}

namespace {
template <class SageSymbol>
auto getTypeOfDeclaration(const SageSymbol *sym)
    -> decltype(sym->get_declaration()->get_type()) {
  auto ptr = sym->get_declaration();
  ASSERT_not_null(ptr);

  return ptr->get_type();
}

[[noreturn]]
auto getTypeOfDeclaration(const SgSymbol *) -> SgType * {
  ROSE_ABORT();
}

void eraseSymbolBasisFromExactLookup(SgSymbolTable *table, SgSymbol *symbol,
                                     const SgNode *basis) {
  if (table == NULL || symbol == NULL || basis == NULL)
    return;

  SymbolBasisExactIndex::iterator found =
      table->get_symbolBasisExactIndex().find(basis);
  const size_t occurrences =
      found == table->get_symbolBasisExactIndex().end()
          ? 0
          : static_cast<size_t>(
                std::count(found->second.begin(), found->second.end(), symbol));
  if (occurrences != 1) {
    fprintf(stderr,
            "REX_AST_INVARIANT[symbol-basis-index-erase]: table=%p "
            "symbol=%p/%s basis=%p has %zu indexed occurrences\n",
            static_cast<void *>(table), static_cast<void *>(symbol),
            symbol->class_name().c_str(), static_cast<const void *>(basis),
            occurrences);
    ROSE_ABORT();
  }
  std::vector<SgSymbol *> &symbols = found->second;
  symbols.erase(std::remove(symbols.begin(), symbols.end(), symbol),
                symbols.end());
  if (symbols.empty())
    table->get_symbolBasisExactIndex().erase(found);
}

} // namespace

const std::vector<SgSymbol *> &
SgSymbolTable::find_symbols_with_exact_basis(const SgNode *basis) const {
  static const std::vector<SgSymbol *> no_symbols;
  if (basis == NULL)
    return no_symbols;
  SymbolBasisExactIndex::const_iterator found =
      p_symbolBasisExactIndex.find(basis);
  return found != p_symbolBasisExactIndex.end() ? found->second : no_symbols;
}

void SgSymbolTable::reindex_symbol_basis(SgSymbol *symbol,
                                         const SgNode *prior_basis) {
  if (symbol == NULL || prior_basis == NULL ||
      symbol->get_symbol_basis() == NULL || symbol->get_parent() != this ||
      !exists(symbol)) {
    fprintf(
        stderr,
        "REX_AST_INVARIANT[symbol-basis-reindex]: table=%p symbol=%p "
        "prior=%p current=%p parent=%p does not identify one published "
        "basis replacement\n",
        static_cast<void *>(this), static_cast<void *>(symbol),
        static_cast<const void *>(prior_basis),
        static_cast<void *>(symbol != NULL ? symbol->get_symbol_basis() : NULL),
        static_cast<void *>(symbol != NULL ? symbol->get_parent() : NULL));
    ROSE_ABORT();
  }

  SymbolStoredNameMap::const_iterator stored_name =
      p_symbolStoredNameMap.find(symbol);
  if (stored_name == p_symbolStoredNameMap.end()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[symbol-basis-reindex]: table=%p symbol=%p has "
            "no exact stored-name identity\n",
            static_cast<void *>(this), static_cast<void *>(symbol));
    ROSE_ABORT();
  }

  const auto &prior_symbols = find_symbols_with_exact_basis(prior_basis);
  ROSE_ASSERT(std::count(prior_symbols.begin(), prior_symbols.end(), symbol) ==
              1);
  if (prior_basis == symbol->get_symbol_basis())
    return;
  const auto inserted =
      p_symbolBasisExactIndex.try_emplace(symbol->get_symbol_basis());
  try {
    auto &symbols = inserted.first->second;
    ROSE_ASSERT(std::find(symbols.begin(), symbols.end(), symbol) ==
                symbols.end());
    symbols.push_back(symbol);
  } catch (...) {
    if (inserted.second)
      p_symbolBasisExactIndex.erase(inserted.first);
    throw;
  }
  eraseSymbolBasisFromExactLookup(this, symbol, prior_basis);
}

SgName SgSymbolTable::stored_name_of(const SgSymbol *symbol) const {
  auto found = p_symbolStoredNameMap.find(symbol);
  if (symbol == NULL || !exists(symbol) ||
      found == p_symbolStoredNameMap.end() || symbol->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[symbol-stored-name]: table=%p symbol=%p "
            "has no exact stored name\n",
            static_cast<const void *>(this), static_cast<const void *>(symbol));
    ROSE_ABORT();
  }
  return found->second;
}

void SgSymbolTable::validate_exact_symbol_indexes() const {
  std::map<const SgNode *, std::vector<SgSymbol *>> expected_basis_index;
  SymbolStoredNameMap expected_stored_names;
  for (const auto &entry : *p_table) {
    SgSymbol *symbol = entry.second;
    if (symbol == NULL || symbol->get_parent() != this ||
        !expected_stored_names.emplace(symbol, entry.first).second) {
      fprintf(stderr,
              "REX_AST_INVARIANT[symbol-exact-index-audit]: table=%p "
              "contains a null, misowned, or multiply stored symbol=%p\n",
              static_cast<const void *>(this), static_cast<void *>(symbol));
      ROSE_ABORT();
    }
    if (SgNode *basis = symbol->get_symbol_basis())
      expected_basis_index[basis].push_back(symbol);
  }

  auto normalize = [](auto &index) {
    for (auto &entry : index)
      std::sort(entry.second.begin(), entry.second.end());
  };
  normalize(expected_basis_index);
  SymbolBasisExactIndex actual_basis_index = p_symbolBasisExactIndex;
  normalize(actual_basis_index);
  if (expected_basis_index != actual_basis_index ||
      expected_stored_names != p_symbolStoredNameMap) {
    fprintf(stderr,
            "REX_AST_INVARIANT[symbol-exact-index-audit]: table=%p has "
            "stale basis or stored-name indexes\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
}

template <class ReturnType>
ReturnType *SgSymbolTable::find_symbol_with_type_support(
    const SgName &nm, const SgType *type,
    SgTemplateParameterPtrList *templateParameterList,
    SgTemplateArgumentPtrList *templateArgumentList, bool filterTemplateSymbols,
    const SgUnorderedNodeSet *visibleAliasCausalNodes, bool searchBaseClasses) {

  ROSE_ASSERT(p_table != NULL);

  ROSE_ASSERT(templateParameterAndArgumentErrorChecking<ReturnType>(
                  templateParameterList, templateArgumentList) == true);

  const auto range = p_table->equal_range(nm);
  auto matchesType = [&](ReturnType *symbol) {
    if (type == NULL)
      return true;
    SgType *symbolType = getTypeOfDeclaration(symbol);
    if (symbolType == type)
      return true;
    SgFunctionType *symbolFunctionType = isSgFunctionType(symbolType);
    SgFunctionType *requestedFunctionType =
        isSgFunctionType(const_cast<SgType *>(type));
    return symbolFunctionType != NULL && requestedFunctionType != NULL &&
           SageInterface::isEquivalentFunctionType(symbolFunctionType,
                                                   requestedFunctionType);
  };

  // First look through only the local (non-aliased) symbols.

  {
    // Prefer an exact interned type before comparing copied function types.
    const int passes = type != NULL ? 2 : 1;
    for (int pass = 0; pass < passes; ++pass) {
      for (hash_iterator i = range.first; i != range.second; ++i) {
        p_iterator = i;

        ReturnType *symbol = dynamic_cast<ReturnType *>(p_iterator->second);

        symbol = symbolFilter<ReturnType>(symbol, templateParameterList,
                                          templateArgumentList,
                                          filterTemplateSymbols);

        // Resolve aliases to their base symbols in the following loop.
        if ((symbol != NULL) &&
            (symbol->variantT() == (VariantT)SgAliasSymbol::static_variant)) {
          symbol = NULL;
        }

        if (symbol != NULL &&
            (pass == 0 ? type == NULL || getTypeOfDeclaration(symbol) == type
                       : matchesType(symbol))) {
          p_name = nm;
          p_no_name = false;

          if (hasMatchingTemplateParametersArgumentsOrNoTemplateParametersArguments(
                  templateParameterList, templateArgumentList, symbol) ==
              true) {
            return symbol;
          }
        }
      }
    }
  }

  {

    for (hash_iterator i = range.first; i != range.second; ++i) {
      p_iterator = i;

      SgAliasSymbol *aliasedSymbol = isSgAliasSymbol(p_iterator->second);
      if (aliasedSymbol != NULL) {
        ReturnType *original_aliased_symbol =
            dynamic_cast<ReturnType *>(aliasedSymbol->get_base());

        original_aliased_symbol = symbolFilter<ReturnType>(
            original_aliased_symbol, templateParameterList,
            templateArgumentList, filterTemplateSymbols);

        if (original_aliased_symbol != NULL &&
            matchesType(original_aliased_symbol)) {
          p_name = nm;
          p_no_name = false;

          if (hasMatchingTemplateParametersArgumentsOrNoTemplateParametersArguments(
                  templateParameterList, templateArgumentList,
                  original_aliased_symbol) == true) {
            // Qualification sees an alias only after all its causal nodes.
            // Ordinary lookup does not apply traversal-order filtering.
            if (visibleAliasCausalNodes == NULL ||
                isSubset(aliasedSymbol->get_causal_nodes(),
                         *visibleAliasCausalNodes)) {
              return original_aliased_symbol;
            }
          }
        }
      }
    }
  }

  if (searchBaseClasses == true) {
    // AST copies may not have inherited symbols injected into their tables.
    SgNode *parentNode = this->get_parent();
    ROSE_ASSERT(parentNode != NULL);
    SgClassDefinition *classDefinition = isSgClassDefinition(parentNode);
    if (classDefinition != NULL) {
      SgBaseClassPtrList &base_classes = classDefinition->get_inheritances();

      for (SgBaseClass *baseClass : base_classes) {
        ROSE_ASSERT(baseClass != NULL);
        if (visibleAliasCausalNodes != NULL &&
            visibleAliasCausalNodes->find(baseClass) ==
                visibleAliasCausalNodes->end()) {
          continue;
        }
        if (isSgNonrealBaseClass(baseClass) != NULL ||
            isSgExpBaseClass(baseClass) != NULL) {
          // A dependent or expression base has no concrete class
          // symbol table to search. Its source spelling is resolved
          // through the typed nonreal/expression edge instead.
          continue;
        }
        SgClassDeclaration *baseClassDeclaration = baseClass->get_base_class();
        ROSE_ASSERT(baseClassDeclaration != NULL);
        SgClassDeclaration *baseClassDeclaration_defining =
            isSgClassDeclaration(
                baseClassDeclaration->get_definingDeclaration());

        // DQ: Note that we have to implement conditional lookup based on base
        // class permissions, plus the access permissions of base class members.
        if (baseClassDeclaration_defining != NULL) {
          SgClassDefinition *baseClassDefinition =
              baseClassDeclaration_defining->get_definition();
          ROSE_ASSERT(baseClassDefinition != NULL);

          ROSE_ASSERT(baseClassDefinition->get_symbol_table() != NULL);

          ReturnType *symbol =
              baseClassDefinition->get_symbol_table()
                  ->find_symbol_with_type_support<ReturnType>(
                      nm, type, templateParameterList, templateArgumentList,
                      filterTemplateSymbols, visibleAliasCausalNodes,
                      searchBaseClasses);
          if (symbol != NULL) {
            return symbol;
          }
        }
      }
    }
  }

  return NULL;
}

SgSymbol *SgSymbolTable::find_any() {
  ROSE_ASSERT(p_table != NULL);
  p_iterator = p_table->begin();
  p_no_name = true;
  if (p_iterator != p_table->end())
    return (SgSymbol *)p_iterator->second;

  return NULL;
}

SgVariableSymbol *SgSymbolTable::find_variable() {
  ROSE_ASSERT(p_table != NULL);

  p_iterator = p_table->begin();
  p_no_name = true;
  while (p_iterator != p_table->end()) {
    if (p_iterator->second->variantT() == V_SgVariableSymbol)
      return (SgVariableSymbol *)p_iterator->second;
    p_iterator++;
  }

  return NULL;
}

SgClassSymbol *SgSymbolTable::find_class() {
  ROSE_ASSERT(p_table != NULL);
  if (p_table) {
    p_iterator = p_table->begin();
    p_no_name = true;
    while (p_iterator != p_table->end()) {
      if (p_iterator->second->variantT() == V_SgClassSymbol)
        return (SgClassSymbol *)p_iterator->second;
      p_iterator++;
    }
  }

  return NULL;
}

SgFunctionSymbol *SgSymbolTable::find_function() {
  ROSE_ASSERT(p_table != NULL);
  if (p_table) {
    p_iterator = p_table->begin();
    p_no_name = true;
    while (p_iterator != p_table->end()) {
      if (isSgFunctionSymbol((*p_iterator).second))
        return (SgFunctionSymbol *)p_iterator->second;
      p_iterator++;
    }
  }

  return NULL;
}

