SgSymbolTable::find_class(const SgName &nm,
                          SgTemplateArgumentPtrList *templateArgumentsList) {
  bool filterTemplateSymbols = false;
  return find_symbol_with_type_support<SgClassSymbol>(
      nm, NULL, NULL, templateArgumentsList, filterTemplateSymbols);
}

