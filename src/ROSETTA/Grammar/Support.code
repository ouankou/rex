SOURCE_INITIALIZED_NAME_START
SgScopeStatement *SgInitializedName::get_scope() const { return p_scope; }

void SgInitializedName::set_scope(SgScopeStatement *scope) {
  if (p_structured_binding_scope != nullptr && scope != nullptr)
    ROSE_ASSERT(!SageInterface::isAncestor(this, scope));
  if (p_structured_binding_kind == e_resolved_structured_binding ||
      p_structured_binding_kind == e_dependent_structured_binding)
    ROSE_ASSERT(p_structured_binding_owner != nullptr && scope != nullptr &&
                scope ==
                    p_structured_binding_owner->get_structured_binding_scope());
  if (p_structured_binding_kind == e_structured_binding_holding_variable) {
    auto *context = isSgDeclarationScope(scope);
    ROSE_ASSERT(p_structured_binding_owner != nullptr && context != nullptr &&
                context->get_semantic_outer_scope() ==
                    p_structured_binding_owner->get_structured_binding_scope());
  }
  p_scope = scope;
  markAsModified();
}

SgExprListExp *SgInitializedName::get_structured_binding_pattern() const {
  return p_structured_binding_pattern;
}

void SgInitializedName::set_structured_binding_pattern(SgExprListExp *pattern) {
  ROSE_ASSERT(p_structured_binding_pattern == nullptr ||
              p_structured_binding_pattern->get_parent() == this);
  if (pattern != nullptr) {
    ROSE_ASSERT(
        p_name.is_null() &&
        p_structured_binding_kind == e_not_structured_binding &&
        p_structured_binding_scope != nullptr &&
        (pattern->get_parent() == nullptr || pattern->get_parent() == this));
    const auto &replacement = pattern->get_expressions();
    const auto *previous =
        p_structured_binding_pattern != nullptr
            ? &p_structured_binding_pattern->get_expressions()
            : nullptr;
    ROSE_ASSERT(previous == nullptr || previous->size() == replacement.size());
    for (size_t index = 0; index < replacement.size(); ++index) {
      auto *reference = isSgVarRefExp(replacement[index]);
      ROSE_ASSERT(reference != nullptr && reference->get_symbol() != nullptr);
      auto *binding = reference->get_symbol()->get_declaration();
      ROSE_ASSERT(binding != nullptr &&
                  binding->get_structured_binding_owner() == this &&
                  binding->get_scope() == p_structured_binding_scope &&
                  (binding->get_structured_binding_kind() ==
                       e_resolved_structured_binding ||
                   binding->get_structured_binding_kind() ==
                       e_dependent_structured_binding));
      if (previous != nullptr) {
        auto *old_reference = isSgVarRefExp((*previous)[index]);
        ROSE_ASSERT(old_reference != nullptr &&
                    old_reference->get_symbol() == reference->get_symbol());
      }
    }
  } else {
    ROSE_ASSERT(p_structured_binding_scope == nullptr);
  }
  if (p_structured_binding_pattern != nullptr &&
      p_structured_binding_pattern != pattern)
    p_structured_binding_pattern->set_parent(nullptr);
  p_structured_binding_pattern = pattern;
  if (pattern != nullptr)
    pattern->set_parent(this);
  markAsModified();
}

bool SgInitializedName::is_valid_structured_binding_initializer(
    SgType *type, SgInitializer *initializer) {
  if (type == nullptr || initializer == nullptr ||
      initializer->get_type() == nullptr)
    return false;
  constexpr auto wrappers =
      SgType::STRIP_TYPEDEF_TYPE | SgType::STRIP_MODIFIER_TYPE |
      SgType::STRIP_REFERENCE_TYPE | SgType::STRIP_RVALUE_REFERENCE_TYPE;
  return SageInterface::isEquivalentType(
      type->stripType(wrappers), initializer->get_type()->stripType(wrappers));
}

void SgInitializedName::initialize_structured_binding_scope(
    SgDeclarationScope *scope) {
  ROSE_ASSERT(p_name.is_null() &&
              p_structured_binding_kind == e_not_structured_binding &&
              p_structured_binding_scope == nullptr && scope != nullptr &&
              scope->get_parent() == nullptr &&
              scope->get_semantic_outer_scope() == nullptr &&
              !scope->get_is_default_nonreal_scope());
  ROSE_ASSERT(p_initptr == nullptr ||
              is_valid_structured_binding_initializer(p_typeptr, p_initptr));
  p_structured_binding_scope = scope;
  scope->set_parent(this);
  markAsModified();
}

bool SgInitializedName::is_valid_structured_binding(
    const SgName &name, SgType *type, SgInitializedName *owner,
    SgExpression *value, SgInitializedName *holding,
    structured_binding_kind_enum kind, bool has_initializer) {
  if (kind == e_not_structured_binding)
    return owner == nullptr && value == nullptr && holding == nullptr;
  if (kind == e_structured_binding_holding_variable) {
    if (owner == nullptr || !SgNode::isLiveNode(owner) ||
        !owner->get_name().is_null() || type == nullptr || value != nullptr ||
        holding != nullptr)
      return false;
    auto *reference_type = type->stripTypedefsAndModifiers();
    return isSgReferenceType(reference_type) != nullptr ||
           isSgRvalueReferenceType(reference_type) != nullptr;
  }
  if (owner == nullptr || !SgNode::isLiveNode(owner) || name.is_null() ||
      !owner->get_name().is_null() || type == nullptr ||
      owner->get_type() == nullptr || has_initializer)
    return false;
  if (kind == e_dependent_structured_binding)
    return value == nullptr && holding == nullptr;
  if (kind != e_resolved_structured_binding || value == nullptr ||
      !SgNode::isLiveNode(value) || value->get_type() == nullptr ||
      !value->isLValue())
    return false;
  constexpr auto wrappers =
      SgType::STRIP_TYPEDEF_TYPE | SgType::STRIP_MODIFIER_TYPE |
      SgType::STRIP_REFERENCE_TYPE | SgType::STRIP_RVALUE_REFERENCE_TYPE;
  if (type->stripType(wrappers) != value->get_type()->stripType(wrappers))
    return false;
  if (holding == nullptr)
    return true;
  if (!SgNode::isLiveNode(holding) || holding->get_type() == nullptr)
    return false;
  auto *reference = isSgVarRefExp(value);
  auto *storage_type = holding->get_type()->stripTypedefsAndModifiers();
  return (isSgReferenceType(storage_type) ||
          isSgRvalueReferenceType(storage_type)) &&
         reference != nullptr && reference->get_symbol() != nullptr &&
         reference->get_symbol()->get_declaration() == holding;
}

void SgInitializedName::initialize_structured_binding(
    SgInitializedName *owner, SgExpression *value, SgInitializedName *holding,
    structured_binding_kind_enum kind) {
  ROSE_ASSERT(p_structured_binding_kind == e_not_structured_binding &&
              p_structured_binding_owner == nullptr &&
              p_structured_binding_value == nullptr &&
              p_structured_binding_holding_variable == nullptr);
  ROSE_ASSERT(owner != this && kind != e_not_structured_binding &&
              is_valid_structured_binding(p_name, p_typeptr, owner, value,
                                          holding, kind, p_initptr != nullptr));
  ROSE_ASSERT(value == nullptr || value->get_parent() == nullptr);
  ROSE_ASSERT(owner->get_structured_binding_scope() != nullptr);
  if (kind == e_structured_binding_holding_variable) {
    auto *scope = isSgDeclarationScope(p_scope);
    ROSE_ASSERT(scope != nullptr && scope->get_semantic_outer_scope() ==
                                        owner->get_structured_binding_scope());
    ROSE_ASSERT(p_initptr == nullptr ||
                is_valid_structured_binding_initializer(p_typeptr, p_initptr));
  } else {
    ROSE_ASSERT(p_scope == owner->get_structured_binding_scope());
  }
  p_structured_binding_kind = kind;
  p_structured_binding_owner = owner;
  p_structured_binding_value = value;
  p_structured_binding_holding_variable = holding;
  if (value != nullptr)
    value->set_parent(this);
  markAsModified();
}

void SgInitializedName::validate_structured_binding() const {
  ROSE_ASSERT(is_valid_structured_binding(
      p_name, p_typeptr, p_structured_binding_owner, p_structured_binding_value,
      p_structured_binding_holding_variable, p_structured_binding_kind,
      p_initptr != nullptr));
  ROSE_ASSERT(p_structured_binding_owner != this);
  if (p_structured_binding_kind == e_not_structured_binding) {
    ROSE_ASSERT((p_structured_binding_pattern == nullptr) ==
                (p_structured_binding_scope == nullptr));
    if (p_structured_binding_scope != nullptr)
      ROSE_ASSERT(
          p_name.is_null() &&
          p_structured_binding_scope->get_parent() == this &&
          p_structured_binding_scope->get_semantic_outer_scope() == nullptr &&
          !p_structured_binding_scope->get_is_default_nonreal_scope() &&
          is_valid_structured_binding_initializer(p_typeptr, p_initptr));
    return;
  }
  ROSE_ASSERT(p_structured_binding_scope == nullptr &&
              p_structured_binding_pattern == nullptr);
  auto *owner = p_structured_binding_owner;
  if (p_structured_binding_kind == e_structured_binding_holding_variable) {
    auto *scope = isSgDeclarationScope(p_scope);
    auto *alias = get_structured_binding_alias();
    ROSE_ASSERT(p_initptr != nullptr && scope != nullptr &&
                alias->get_structured_binding_owner() == owner &&
                scope->get_semantic_outer_scope() == alias->get_scope() &&
                is_valid_structured_binding_initializer(p_typeptr, p_initptr));
    return;
  }
  ROSE_ASSERT(p_scope != nullptr &&
              p_scope == owner->get_structured_binding_scope() &&
              p_scope->get_parent() == owner);
  auto *pattern = owner->get_structured_binding_pattern();
  ROSE_ASSERT(pattern != nullptr && pattern->get_parent() == owner);
  size_t matches = 0;
  for (auto *element : pattern->get_expressions()) {
    auto *reference = isSgVarRefExp(element);
    ROSE_ASSERT(reference != nullptr && reference->get_symbol() != nullptr);
    matches += reference->get_symbol()->get_declaration() == this;
  }
  ROSE_ASSERT(matches == 1 &&
              (p_structured_binding_value == nullptr ||
               p_structured_binding_value->get_parent() == this));
  if (p_structured_binding_holding_variable != nullptr) {
    p_structured_binding_holding_variable->validate_structured_binding();
    auto *scope = isSgDeclarationScope(
        p_structured_binding_holding_variable->get_scope());
    ROSE_ASSERT(scope != nullptr &&
                scope->get_semantic_outer_scope() == p_scope);
  }
}

SgInitializedName *SgInitializedName::get_structured_binding_alias() const {
  ROSE_ASSERT(p_structured_binding_kind ==
                  e_structured_binding_holding_variable &&
              p_structured_binding_owner != nullptr);
  auto *pattern = p_structured_binding_owner->get_structured_binding_pattern();
  ASSERT_not_null(pattern);
  SgInitializedName *alias = nullptr;
  for (auto *element : pattern->get_expressions()) {
    auto *reference = isSgVarRefExp(element);
    ROSE_ASSERT(reference != nullptr && reference->get_symbol() != nullptr);
    auto *candidate = reference->get_symbol()->get_declaration();
    if (candidate->get_structured_binding_holding_variable() == this) {
      ROSE_ASSERT(alias == nullptr);
      alias = candidate;
    }
  }
  ASSERT_not_null(alias);
  return alias;
}

SgExpression *SgInitializedName::get_fortran_procedure_interface() const {
  return p_fortran_procedure_interface;
}

bool SgInitializedName::is_valid_fortran_procedure_interface(
    SgExpression *interface, SgType *type) {
  if (interface == nullptr)
    return true;
  while (SgModifierType *modifier = isSgModifierType(type))
    type = modifier->get_base_type();
  if (SgPointerType *pointer = isSgPointerType(type))
    type = pointer->get_base_type();
  SgFunctionType *procedure = isSgFunctionType(type);
  if (procedure == nullptr || SageInterface::containsUnknownType(type))
    return false;
  if (auto *reference = isSgFunctionRefExp(interface))
    return reference->get_symbol() != nullptr &&
           SageInterface::isEquivalentType(reference->get_type(), procedure);
  if (auto *reference = isSgVarRefExp(interface)) {
    SgType *binding = reference->get_type();
    while (SgModifierType *modifier = isSgModifierType(binding))
      binding = modifier->get_base_type();
    if (SgPointerType *pointer = isSgPointerType(binding))
      binding = pointer->get_base_type();
    return reference->get_symbol() != nullptr &&
           isSgFunctionType(binding) != nullptr &&
           SageInterface::isEquivalentType(binding, procedure);
  }
  if (auto *source = isSgTypeExpression(interface))
    return !SageInterface::containsUnknownType(
               source->get_represented_type()) &&
           SageInterface::fortranSourceTypeMatchesSemanticType(
               source->get_represented_type(), procedure->get_return_type());
  return false;
}

void SgInitializedName::set_fortran_procedure_interface(
    SgExpression *interface) {
  ROSE_ASSERT(p_fortran_procedure_interface == nullptr ||
              p_fortran_procedure_interface == interface);
  ROSE_ASSERT(interface == nullptr || interface->get_parent() == nullptr ||
              interface->get_parent() == this);
  ROSE_ASSERT(is_valid_fortran_procedure_interface(interface, p_typeptr));
  if (auto *source = isSgTypeExpression(interface)) {
    SgType *type = source->get_represented_type();
    if (type->get_fortran_source_syntax()) {
      ROSE_ASSERT(type->get_parent() == nullptr ||
                  type->get_parent() == source);
      type->set_parent(source);
    }
  }
  p_fortran_procedure_interface = interface;
  if (interface != nullptr)
    interface->set_parent(this);
}

void $CLASSNAME::construct_source_prototype_copy_symbol(
    const SgInitializedName &source, SgCopyHelp &help) {
  auto *source_list = isSgFunctionParameterList(source.get_parent());
  auto *prototype =
      source_list != nullptr
          ? isSgFunctionParameterTypeList(source_list->get_parent())
          : nullptr;
  if (prototype == nullptr)
    return;
  ROSE_ASSERT(prototype->get_source_parameters() == source_list &&
              prototype->get_source_parameter_scope() == source.get_scope());
  auto *scope = isSgFunctionParameterScope(get_scope());
  ROSE_ASSERT(scope != nullptr && scope != source.get_scope());
  ROSE_ASSERT(help.get_copiedNodeMap().at(source.get_scope()) == scope);
  auto *list =
      isSgFunctionParameterList(help.get_copiedNodeMap().at(source_list));
  ROSE_ASSERT(list != nullptr && list != source_list);
  ROSE_ASSERT(get_parent() == nullptr || get_parent() == list);
  set_parent(list);
  if (get_name().getString().empty())
    return;
  auto *original = source.get_scope()->find_symbol_from_declaration(&source);
  ROSE_ASSERT(isSgVariableSymbol(original) != nullptr);
  ROSE_ASSERT(scope->find_symbol_from_declaration(this) == nullptr);
  auto symbol = std::make_unique<SgVariableSymbol>(this);
  scope->insert_symbol(get_name(), symbol.get());
  help.insertCopiedNodePair(original, symbol.release());
}
bool SgInitializedName::FortranProcedureComponentBinding::isValidForType(
    SgType *type) const {
  SgPointerType *pointer = isSgPointerType(type);
  SgFunctionType *procedure =
      pointer != nullptr ? isSgFunctionType(pointer->get_base_type()) : nullptr;
  if (procedure == nullptr)
    return false;
  switch (kind) {
  case FortranProcedurePassKind::no_pass:
    return !passed_object_index && written_dummy_name.is_null();
  case FortranProcedurePassKind::implicit_pass:
  case FortranProcedurePassKind::explicit_pass:
    return passed_object_index == 0 && written_dummy_name.is_null() &&
           !procedure->get_arguments().empty();
  case FortranProcedurePassKind::named_pass:
    return passed_object_index &&
           *passed_object_index < procedure->get_arguments().size() &&
           !written_dummy_name.is_null();
  }
  return false;
}

SgInitializedName::SgInitializedName(SgName name, SgType *typeptr)
    : SgInitializedName(name, typeptr, nullptr) {}

// DQ (2/6/2007): Get the associated symbol from the symbol table in the stored
// scope
SgSymbol *SgInitializedName::get_symbol_from_symbol_table() const {
  auto lookup_in_scope_chain = [&](SgScopeStatement *scope) -> SgSymbol * {
    while (scope != NULL) {
      if (SgSymbol *symbol = scope->find_symbol_from_declaration(this))
        return symbol;

      SgScopeStatement *next_scope = scope->get_scope();
      if (next_scope == scope)
        break;
      scope = next_scope;
    }

    return NULL;
  };

  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  if (SgSymbol *symbol = lookup_in_scope_chain(scope))
    return symbol;

  SgDeclarationStatement *decl = get_declaration();
  if (decl != NULL) {
    // Deep-copied declarations can temporarily keep an explicit
    // initialized-name scope while the declaration statement itself is
    // still detached from the AST. Avoid asking the declaration for a
    // parent-derived scope until it is attached.
    if (decl->hasExplicitScope() == true || decl->get_parent() != NULL) {
      SgScopeStatement *decl_scope = decl->get_scope();
      if (decl_scope != NULL && decl_scope != scope) {
        if (SgSymbol *symbol = lookup_in_scope_chain(decl_scope))
          return symbol;
      }
    }
  }

  return NULL;
}

// PC (10/1/2009): Added support to get the symbol from the correct associated
// declaration
SgSymbol *SgInitializedName::search_for_symbol_from_symbol_table() const {
  SgInitializedName *slow = p_prev_decl_item;
  SgInitializedName *fast = p_prev_decl_item;
  while (fast != NULL && fast->p_prev_decl_item != NULL) {
    slow = slow->p_prev_decl_item;
    fast = fast->p_prev_decl_item->p_prev_decl_item;
    if (slow == fast) {
      fprintf(stderr,
              "REX_AST_INVARIANT[variable-redeclaration-chain]: declaration=%p "
              "name=%s contains a cycle\n",
              static_cast<const void *>(this), get_name().str());
      ROSE_ABORT();
    }
  }

  SgInitializedName *aPrevDeclItem = p_prev_decl_item;
  while (aPrevDeclItem != NULL && aPrevDeclItem->p_prev_decl_item != NULL) {
    aPrevDeclItem = aPrevDeclItem->p_prev_decl_item;
  }

  SgSymbol *symbol = 0;
  if (aPrevDeclItem != NULL)
    symbol = aPrevDeclItem->get_symbol_from_symbol_table();
  else
    symbol = get_symbol_from_symbol_table();

  // MS: for SgInitializedName in a forward declaration this always fails
  // because no symbol exists. Therefore this assert can be put back, once
  // symbols for such variables are available. assert(symbol != NULL);
  return symbol;
}

SgStorageModifier &SgInitializedName::get_storageModifier() {
  ROSE_ASSERT(p_storageModifier != NULL);
  return *p_storageModifier;
}

const SgStorageModifier &SgInitializedName::get_storageModifier() const {
  ROSE_ASSERT(p_storageModifier != NULL);
  return *p_storageModifier;
}

SgName SgInitializedName::get_qualified_name() const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);
  return SgName::assembleQualifiedName(scope->get_qualified_name(), get_name());
}

void SgInitializedName::post_construction_initialization() {
  preventConstructionOnStack(this);
  if (p_typeptr != nullptr && p_typeptr->has_source_prototype()) {
    ROSE_ASSERT(p_typeptr->get_parent() == nullptr ||
                p_typeptr->get_parent() == this);
    p_typeptr->set_parent(this);
  }
  ROSE_ASSERT(p_initptr == NULL || p_initptr->get_parent() == NULL ||
              p_initptr->get_parent() == this);

  p_storageModifier = new SgStorageModifier();
  assert(p_storageModifier != NULL);
  p_storageModifier->setDefault();

  p_storageModifier->set_parent(this);

  p_attributeMechanism = NULL;

  p_scope = NULL;

  if (p_initptr != NULL) {
    p_initptr->set_parent(this);
  }

  p_gnu_attribute_modifierVector =
      SgBitVector(e_last_gnu_variable_attribute, false);

  // Negative alignment denotes an absent explicit alignment.
  p_gnu_attribute_alignment = -1;

  p_isCoArray = false;

  p_shapeDeferred = false;
  p_initializationDeferred = false;
  p_protected_declaration = false;

  p_name_qualification_length_for_type = 0;
  p_type_elaboration_required_for_type = false;
  p_global_qualification_required_for_type = false;

  p_auto_decltype = NULL;

  p_structured_binding_pattern = NULL;

  p_is_braced_initialized = false;
  p_using_assignment_copy_constructor_syntax = false;
  p_needs_definitions = false;
  p_is_parameter_pack = false;
  p_is_pack_element = false;
}

SgName SgInitializedName::get_name() const { return p_name; }

void SgInitializedName::set_name(SgName name) {
  ROSE_ASSERT(p_structured_binding_scope == nullptr || name.is_null());
  if (p_structured_binding_kind != e_not_structured_binding)
    ROSE_ASSERT(is_valid_structured_binding(
        name, p_typeptr, p_structured_binding_owner, p_structured_binding_value,
        p_structured_binding_holding_variable, p_structured_binding_kind,
        p_initptr != nullptr));
  p_name = name;
  markAsModified();
}

SgType *SgInitializedName::get_type() const { return p_typeptr; }

void SgInitializedName::set_type(SgType *t) {
  if (!isUnderConstruction()) {
    if (p_structured_binding_kind != e_not_structured_binding)
      ROSE_ASSERT(is_valid_structured_binding(
          p_name, t, p_structured_binding_owner, p_structured_binding_value,
          p_structured_binding_holding_variable, p_structured_binding_kind,
          p_initptr != nullptr));
    if (p_structured_binding_pattern != nullptr ||
        p_structured_binding_kind == e_structured_binding_holding_variable)
      ROSE_ASSERT(t != nullptr && p_typeptr != nullptr &&
                  SageInterface::isEquivalentType(t, p_typeptr));
  }
  if (p_typeptr != t && !SgCopyHelp::isConstructingCopy(this))
    p_storage_size_bytes.reset();
  p_typeptr = t;
  markAsModified();
}

SgType *SgInitializedName::get_typeptr() const { return get_type(); }

void SgInitializedName::set_typeptr(SgType *t) { set_type(t); }

SgType *SgInitializedName::get_cxx_source_type() const {
  return p_cxx_source_type;
}

void SgInitializedName::set_cxx_source_type(SgType *type) {
  auto *pointer = isSgPointerType(type);
  auto *reference = isSgReferenceType(type);
  auto *rvalueReference = isSgRvalueReferenceType(type);
  const bool ownsSource =
      type != nullptr &&
      (type->has_source_prototype() || type->get_parent() == this ||
       (pointer != nullptr && pointer->get_base_type()->get_ptr_to() != pointer) ||
       (reference != nullptr && reference->get_base_type()->get_ref_to() != reference) ||
       (rvalueReference != nullptr &&
        rvalueReference->get_base_type()->get_rvalue_ref_to() != rvalueReference));
  if (ownsSource) {
    ROSE_ASSERT(type != p_typeptr);
    ROSE_ASSERT(type->get_parent() == nullptr || type->get_parent() == this);
  }
  if (p_cxx_source_type != nullptr && p_cxx_source_type != type &&
      p_cxx_source_type->get_parent() == this)
    p_cxx_source_type->set_parent(nullptr);
  p_cxx_source_type = type;
  if (ownsSource)
    type->set_parent(this);
  markAsModified();
}

SgInitializer *SgInitializedName::get_initializer() const { return p_initptr; }

void SgInitializedName::set_initializer(SgInitializer *i) {
  if (p_structured_binding_scope != nullptr ||
      p_structured_binding_kind == e_structured_binding_holding_variable) {
    ROSE_ASSERT(i != nullptr || isUnderConstruction());
    if (i != nullptr)
      ROSE_ASSERT(is_valid_structured_binding_initializer(p_typeptr, i));
  }
  if (p_structured_binding_kind != e_not_structured_binding &&
      !isUnderConstruction()) {
    if (p_structured_binding_kind == e_resolved_structured_binding ||
        p_structured_binding_kind == e_dependent_structured_binding)
      ROSE_ASSERT(i == nullptr);
    if (p_structured_binding_kind == e_structured_binding_holding_variable)
      ROSE_ASSERT(i != nullptr);
  }
  SgInitializer *previous = p_initptr;
  if (previous != NULL && previous != i && previous->get_parent() != NULL &&
      previous->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[initialized-name-initializer-owner]: "
            "initialized-name=%p cannot release initializer=%p owned by "
            "%p/%s\n",
            static_cast<void *>(this), static_cast<void *>(previous),
            static_cast<void *>(previous->get_parent()),
            previous->get_parent()->class_name().c_str());
    ROSE_ABORT();
  }
  if (i != NULL && i->get_parent() != NULL && i->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[initialized-name-initializer-owner]: "
            "initialized-name=%p cannot acquire initializer=%p owned by "
            "%p/%s\n",
            static_cast<void *>(this), static_cast<void *>(i),
            static_cast<void *>(i->get_parent()),
            i->get_parent()->class_name().c_str());
    ROSE_ABORT();
  }

  if (previous != NULL && previous != i && previous->get_parent() == this) {
    previous->set_parent(NULL);
  }

  p_initptr = i;
  if (i != NULL) {
    i->set_parent(this);
  }
  markAsModified();
}

SgName SgInitializedName::get_mangled_name(void) const {
  SgName mangled_name; // return value

  // Case 1: Function parameters.
  // Generate names for parameters such that
  //   int foo (int x, int y) { return x + y; }
  //   int foo (int, int);
  //   int foo (int a, int b);
  // all generate the same unique names for equivalent parameters.
  const SgFunctionParameterList *func_params =
      isSgFunctionParameterList(get_declaration());
  if (func_params) {
    // Find position (parameter number) in parameter list
    const SgInitializedNamePtrList &func_args = func_params->get_args();
    SgInitializedNamePtrList::const_iterator i;
    size_t param_num = 0;
    for (i = func_args.begin(); i != func_args.end() && *i != this; ++i)
      param_num++;
    if (i != func_args.end()) // found position
    {
      // Compute a mangled prefix from the function declaration.
      ostringstream s;
      const SgFunctionDeclaration *func_decl =
          isSgFunctionDeclaration(func_params->get_parent());
      if (func_decl)
        s << func_decl->get_mangled_name().str();
      s << "__ARG" << param_num + 1; // Append argument number (1-based)
      mangled_name = SgName(s.str());
    }
    // else, an error (see below).
  } else if (const auto *variableTemplate =
                 isSgTemplateVariableDeclaration(get_parent())) {
    ROSE_ASSERT(variableTemplate->get_variables().size() == 1 &&
                variableTemplate->get_variables().front() == this);
    ROSE_ASSERT(get_scope() != nullptr && !get_name().is_null());
    const auto &arguments = variableTemplate->get_semanticTemplateArguments();
    for (auto *argument : arguments) {
      ROSE_ASSERT(argument != nullptr &&
                  argument->get_parent() == variableTemplate);
    }
    if (variableTemplate->get_specializedTemplateDeclaration() == nullptr) {
      ROSE_ASSERT(arguments.empty());
      ROSE_ASSERT(variableTemplate->get_specialization() ==
                  SgDeclarationStatement::e_no_specialization);
      mangled_name =
          mangleTemplate(get_name(), SgTemplateParameterPtrList{}, get_scope());
    } else {
      mangled_name = mangleTemplate(get_name(), arguments, get_scope());
    }
  } else // Case 2: Not a function parameter
  {
    SgScopeStatement *scope = get_scope();
    if (scope == NULL) {
      MLOG_INFO_C("ROSETTA", "SgInitializedName = %p = %s \n", this,
                  get_name().str());
      get_file_info()->display("Error scope of SgInitializedName == NULL");
    }
    assert(scope != NULL);

    SgName qual_name = mangleQualifiers(scope);

    SgName name = get_name();
    if (name.get_length() > 0) // not empty
    {
      mangled_name = joinMangledQualifiers(qual_name, get_name());
    } else {
      // name is empty
      if (isSgCatchOptionStmt(scope)) // e.g., 'try {...} catch (int) {...}
      {
        mangled_name = joinMangledQualifiers(qual_name, SgName("CATCHARG"));
      } else {
        // MLOG_INFO_C("ROSETTA", "Must be a padding declaration (e.g. int:16)
        // \n");
        mangled_name =
            joinMangledQualifiers(qual_name, SgName("PADDING_VARIABLE"));
      }
    }
  }

  if (!mangled_name.get_length()) // Error: could not come up with a name.
  {
    MLOG_INFO_C("ROSETTA",
                "Error in SgInitializedName::get_mangled_name(void): zero "
                "length mangled name generated (see if this is realistic)\n");
    SgScopeStatement *scope = get_scope();
    assert(scope);
    MLOG_INFO_C("ROSETTA", "  Surrounding scope is '%s'\n",
                scope->sage_class_name());
    const SgDeclarationStatement *decl = get_declaration();
    MLOG_INFO_C("ROSETTA", "  Decl is '%s'\n",
                decl ? decl->sage_class_name() : "(none)");
    const SgDeclarationStatement *def = get_definition();
    MLOG_INFO_C("ROSETTA", "  Def is '%s'\n",
                def ? def->sage_class_name() : "(none)");
    const SgNode *par = decl ? decl->get_parent() : 0;
    MLOG_INFO_C("ROSETTA", "  Parent(decl) is '%s'\n",
                par ? par->sage_class_name() : "(none)");
  }

  return mangled_name;
}

SgDeclarationStatement *SgInitializedName::get_declaration() const {
  for (SgNode *r = get_parent(); r != NULL; r = r->get_parent()) {
    SgDeclarationStatement *d = isSgDeclarationStatement(r);

    if (d != NULL) {
      return d;
    }
  }

  return NULL;
}

SgVariableDefinition *SgInitializedName::get_definition() const {
  return get_variable_definition();
}

void SgInitializedName::set_definition(SgVariableDefinition *def) {
  SgVariableDefinition *variableDefinition = def;
  SgVariableDefinition *currentDefinition = get_variable_definition();
  if (currentDefinition != NULL && currentDefinition != variableDefinition &&
      variableDefinition != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[initialized-name-definition-owner]: "
            "name=%p already owns definition=%p and cannot replace it "
            "with definition=%p\n",
            static_cast<void *>(this), static_cast<void *>(currentDefinition),
            static_cast<void *>(variableDefinition));
    ROSE_ABORT();
  }

  if (currentDefinition != NULL && variableDefinition == NULL) {
    if (currentDefinition->get_vardefn() != this ||
        currentDefinition->get_parent() != this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[initialized-name-definition-owner]: "
              "name=%p cannot detach malformed definition=%p\n",
              static_cast<void *>(this),
              static_cast<void *>(currentDefinition));
      ROSE_ABORT();
    }
    currentDefinition->set_vardefn(NULL);
    currentDefinition->set_parent(NULL);
  } else if (variableDefinition != NULL) {
    if ((variableDefinition->get_vardefn() != NULL &&
         variableDefinition->get_vardefn() != this) ||
        (variableDefinition->get_parent() != NULL &&
         variableDefinition->get_parent() != this)) {
      fprintf(stderr,
              "REX_AST_INVARIANT[initialized-name-definition-owner]: "
              "name=%p cannot adopt definition=%p owned by name=%p "
              "parent=%p\n",
              static_cast<void *>(this),
              static_cast<void *>(variableDefinition),
              static_cast<void *>(variableDefinition->get_vardefn()),
              static_cast<void *>(variableDefinition->get_parent()));
      ROSE_ABORT();
    }
    variableDefinition->set_vardefn(this);
    variableDefinition->set_parent(this);
  }

  set_variable_definition(variableDefinition);
  markAsModified();
}

bool SgInitializedName::checkBit(unsigned int bit) const {
  assert(bit < e_last_gnu_variable_attribute);
  return (p_gnu_attribute_modifierVector[bit] == true);
}

void SgInitializedName::setBit(unsigned int bit) {
  assert(bit < e_last_gnu_variable_attribute);
  p_gnu_attribute_modifierVector[bit] = true;
}

void SgInitializedName::unsetBit(unsigned int bit) {
  assert(bit < e_last_gnu_variable_attribute);
  p_gnu_attribute_modifierVector[bit] = false;
}

