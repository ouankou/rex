//! Exact source ordinal for a clause split across a combined directive's
//! nested semantic owners. Absence is the only valid non-combined state.
const std::optional<std::size_t> &get_combined_source_order() const;

//! Publish the combined-source ordinal exactly once.
void initialize_combined_source_order(std::size_t source_order);

/*!\brief  OpenMP default clause values
 */

