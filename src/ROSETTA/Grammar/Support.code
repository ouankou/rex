SOURCE_NAME_START

SgName::operator std::string() const { return p_char; }

SgName::SgName() : p_char("") {}

unsigned int SgName::get_length() const {
  return p_char.size();
}

SgName::SgName(const char *str) : p_char(str ? str : "") {}

SgName::SgName(const std::string &str) : p_char(str) {}

SgName::SgName(const SgName &n) : SgSupport(), p_char(n.p_char) {}

int SgName::operator!=(const SgName &n1) const {
  return p_char != n1.p_char;
}

int SgName::operator==(const SgName &n1) const {

  return p_char == n1.p_char;
}

// DQ (11/27/2010): Added support for case insensitive name matching.
bool SgName::caseInsensitiveEquality(const SgName &x, const SgName &y) {
  // This function checks a case insensitive match of x against y.
  // This is required because Fortran is case insensitive.

  size_t x_length = x.p_char.length();
  size_t y_length = y.p_char.length();

  return (x_length == y_length)
             ? strncasecmp(x.p_char.c_str(), y.p_char.c_str(), x_length) == 0
             : false;
}

int SgName::operator<(const SgName &n1) const {

  return p_char < n1.p_char;
}

bool SgName::is_null(void) const {
  return p_char.empty();
}

void SgName::replace_space(char t) {

  int len = p_char.size();
  for (int i = 0; i < len; i++) {
    // if last one
    if (p_char[i] == ' ') {
      if (i == len - 1)
        p_char.resize(p_char.size() - 1);
      else
        p_char[i] = t;
    }
  }
}

SgName &SgName::operator<<(const std::string &str) {

  p_char += str;
  return *this;
}

SgName SgName::itoname(int val) {
  return SgName(std::to_string(val));
}

SgName &SgName::operator<<(int val) {

  SgName str = itoname(val);
  p_char += str.p_char;
  return *this;
}

SgName &SgName::operator=(const SgName &n1) {
  this->p_char = n1.p_char;
  return *this;
}

SgName &SgName::tail(int n) // keep string after n
{
  p_char = (unsigned int)n >= p_char.size() ? "" : p_char.substr(n);
  return *this;
}

SgName &SgName::head(int n) // keep first n chars
{
  p_char = (unsigned int)n >= p_char.size() ? p_char : p_char.substr(0, n);
  return *this;
}

const char *SgName::str() const {
  return p_char.c_str();
}

std::string &SgName::getString() {
  return p_char;
}

const std::string &SgName::getString() const {
  return p_char;
}

void SgName::display(const std::string &label) const {

  std::cout << label << ": " << p_char << "\n";
}

SgName operator+(const SgName &n1, const SgName &n2) {
  return SgName(n1.p_char + n2.p_char);
}

SgName &SgName::operator+=(const SgName &n1) {
  p_char += n1.p_char;
  return *this;
}

SgName SgName::assembleQualifiedName(const SgName &scopeQualifiedName,
                                     const SgName &localName) {
  if (scopeQualifiedName.is_null()) {
    return localName;
  }
  if (scopeQualifiedName == "::") {
    return SgName(scopeQualifiedName.getString() + localName.getString());
  }
  return SgName(scopeQualifiedName.getString() + "::" + localName.getString());
}

SgName SgName::invertCase() const {
  string s = p_char;

  for (char *str = s.data(); *str != '\0'; ++str) {
    const auto byte = static_cast<unsigned char>(*str);
    if (isupper(byte))
      *str = static_cast<char>(tolower(byte));
    else if (islower(byte))
      *str = static_cast<char>(toupper(byte));
  }

  return s;
}

SOURCE_NAME_END

