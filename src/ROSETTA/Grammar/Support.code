public:
// Frontend-provided scalar representation for this translation unit. KIND is
// zero for C/C++ scalar variants and the resolved positive KIND for Fortran.
// Floating precision and exponent range distinguish equally sized storage such
// as x87 extended precision and IEEE binary128.
  struct scalar_abi_layout {
    unsigned size_bits = 0;
    unsigned alignment_bits = 0;
    unsigned precision = 0;
    int max_exponent = 0;
    bool is_unsigned = false;

    bool operator==(const scalar_abi_layout &other) const {
      return size_bits == other.size_bits &&
             alignment_bits == other.alignment_bits &&
             precision == other.precision &&
             max_exponent == other.max_exponent &&
             is_unsigned == other.is_unsigned;
    }
  };

  struct target_abi_info {
    bool available = false;
    bool big_endian = false;
    unsigned pointer_size_bits = 0;
    unsigned pointer_alignment_bits = 0;
    std::map<std::pair<VariantT, int>, scalar_abi_layout> scalars;

    bool operator==(const target_abi_info &other) const {
      return available == other.available && big_endian == other.big_endian &&
             pointer_size_bits == other.pointer_size_bits &&
             pointer_alignment_bits == other.pointer_alignment_bits &&
             scalars == other.scalars;
    }

    friend std::ostream &operator<<(std::ostream &out,
                                    const target_abi_info &info) {
      return out << "target ABI available=" << info.available
                 << " pointer bits=" << info.pointer_size_bits
                 << " scalar count=" << info.scalars.size();
    }
  };

  enum source_origin_enum {
    e_parsed_source,
    e_command_line_source,
    e_generated_source
  };

  SgSourceFile(std::vector<std::string> &argv, SgProject *project);
  SgSourceFile(std::vector<std::string> &argv, SgProject *project,
               SgFileList *owner);
  SgSourceFile(std::vector<std::string> &argv, SgProject *project,
               SgFileList *owner, const std::string &sourceFilename,
               source_origin_enum origin);
  virtual int callFrontEnd() override;

  virtual int buildAST(std::vector<std::string> argv,
                       std::vector<std::string> inputCommandLine) override;

  //! Divide up the handling of different languages
  int build_Fortran_AST(std::vector<std::string> argv);

  int build_C_and_Cxx_AST(std::vector<std::string> argv,
                          std::vector<std::string> inputCommandLine);

  // DQ (12/23/2008): This sets up the Sg_File_Info in the SgFile and
  // initializes it with the correct name etc. This should be the only place
  // where the SgGlobal (global scope object) is built.
  void initializeGlobalScope();

  virtual void fixupCopy_scopes(SgNode *copy, SgCopyHelp &help) const override;
  virtual void fixupCopy_symbols(SgNode *copy, SgCopyHelp &help) const override;
  virtual void fixupCopy_references(SgNode *copy,
                                    SgCopyHelp &help) const override;

  // Token-map lookup never creates state. Replacement takes ownership of a
  // complete map after the previous token associations have been cleared.
  void post_construction_initialization() override;
  void
  set_tokenSubsequenceMap(std::map<SgNode *, TokenStreamSequenceToNodeMapping *>
                              *tokenStreamSequenceMap);
  std::map<SgNode *, TokenStreamSequenceToNodeMapping *> &
  get_tokenSubsequenceMap();
  const std::map<SgNode *, TokenStreamSequenceToNodeMapping *> &
  get_tokenSubsequenceMap() const;
  void clear_tokenSubsequenceMap();
  void copy_frontendAssociations(const SgSourceFile &source, SgCopyHelp &help);

