HEADER_OMP_CLAUSE_END

SOURCE_OMP_CLAUSE_START
const std::optional<std::size_t> &
SgOmpClause::get_combined_source_order() const {
  return p_combined_source_order;
}

void SgOmpClause::initialize_combined_source_order(std::size_t source_order) {
  if (p_combined_source_order.has_value()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[omp-clause-source-order-publication]: "
            "clause=%p already owns combined source order %zu\n",
            static_cast<void *>(this), *p_combined_source_order);
    ROSE_ABORT();
  }
  p_combined_source_order = source_order;
}
SOURCE_OMP_CLAUSE_END

HEADER_OMP_ITERATOR_DEFINITION_START
void post_construction_initialization() override;
HEADER_OMP_ITERATOR_DEFINITION_END

SOURCE_OMP_ITERATOR_DEFINITION_START
void SgOmpIteratorDefinition::post_construction_initialization() {
  if (p_iterator_name == nullptr || p_iterator_name->get_spelling().empty() ||
      p_begin == nullptr || p_end == nullptr) {
    fprintf(stderr, "REX_AST_INVARIANT[omp-iterator-construction]: "
                    "iterator requires typed name, begin, and end roles\n");
    ROSE_ABORT();
  }
  SgExpression *children[] = {p_iterator_type, p_iterator_name, p_begin, p_end,
                              p_step};
  for (size_t i = 0; i < 5; ++i) {
    if (children[i] == nullptr)
      continue;
    if (children[i]->get_parent() != nullptr) {
      fprintf(stderr, "REX_AST_INVARIANT[omp-iterator-construction]: "
                      "iterator child already has an owner\n");
      ROSE_ABORT();
    }
    for (size_t j = 0; j < i; ++j) {
      if (children[i] == children[j]) {
        fprintf(stderr, "REX_AST_INVARIANT[omp-iterator-construction]: "
                        "iterator roles share one child\n");
        ROSE_ABORT();
      }
    }
  }
  for (SgExpression *child : children) {
    if (child != nullptr)
      child->set_parent(this);
  }
}
SOURCE_OMP_ITERATOR_DEFINITION_END

HEADER_OMP_DIRECTIVE_KIND_CLAUSE_START
//! The immutable, nonempty source-order list of directive grammar
//! terminals.
const SgOmpClause::omp_directive_kind_list &get_directive_kinds() const;

//! Validate the typed list and reject empty, unknown, or duplicate
//! entries.
void validate_directive_kinds() const;

void post_construction_initialization() override;
HEADER_OMP_DIRECTIVE_KIND_CLAUSE_END

SOURCE_OMP_DIRECTIVE_KIND_CLAUSE_START
const SgOmpClause::omp_directive_kind_list &
SgOmpDirectiveKindClause::get_directive_kinds() const {
  validate_directive_kinds();
  return p_directive_kinds;
}

void SgOmpDirectiveKindClause::validate_directive_kinds() const {
  if (p_directive_kinds.empty()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-directive-kind-list]: clause=%p "
            "type=%s requires a nonempty typed directive-kind list\n",
            static_cast<const void *>(this), class_name().c_str());
    ROSE_ABORT();
  }

  std::set<SgOmpClause::omp_directive_kind_enum> seen;
  for (size_t index = 0; index < p_directive_kinds.size(); ++index) {
    const SgOmpClause::omp_directive_kind_enum kind = p_directive_kinds[index];
    switch (kind) {
    case SgOmpClause::e_omp_directive_kind_parallel:
    case SgOmpClause::e_omp_directive_kind_for:
    case SgOmpClause::e_omp_directive_kind_do:
    case SgOmpClause::e_omp_directive_kind_simd:
    case SgOmpClause::e_omp_directive_kind_target:
    case SgOmpClause::e_omp_directive_kind_teams:
    case SgOmpClause::e_omp_directive_kind_distribute:
    case SgOmpClause::e_omp_directive_kind_task:
    case SgOmpClause::e_omp_directive_kind_taskloop:
    case SgOmpClause::e_omp_directive_kind_sections:
    case SgOmpClause::e_omp_directive_kind_section:
    case SgOmpClause::e_omp_directive_kind_single:
    case SgOmpClause::e_omp_directive_kind_master:
    case SgOmpClause::e_omp_directive_kind_masked:
    case SgOmpClause::e_omp_directive_kind_critical:
    case SgOmpClause::e_omp_directive_kind_barrier:
    case SgOmpClause::e_omp_directive_kind_taskwait:
    case SgOmpClause::e_omp_directive_kind_taskgroup:
    case SgOmpClause::e_omp_directive_kind_atomic:
    case SgOmpClause::e_omp_directive_kind_flush:
    case SgOmpClause::e_omp_directive_kind_ordered:
    case SgOmpClause::e_omp_directive_kind_scan:
    case SgOmpClause::e_omp_directive_kind_scope:
    case SgOmpClause::e_omp_directive_kind_loop:
    case SgOmpClause::e_omp_directive_kind_workshare:
    case SgOmpClause::e_omp_directive_kind_cancel:
    case SgOmpClause::e_omp_directive_kind_metadirective:
      break;
    case SgOmpClause::e_omp_directive_kind_unknown:
    default:
      fprintf(stderr,
              "REX_AST_INVARIANT[openmp-directive-kind-list]: clause=%p "
              "type=%s has invalid directive kind=%d at index=%zu\n",
              static_cast<const void *>(this), class_name().c_str(),
              static_cast<int>(kind), index);
      ROSE_ABORT();
    }

    if (!seen.insert(kind).second) {
      fprintf(stderr,
              "REX_AST_INVARIANT[openmp-directive-kind-list]: clause=%p "
              "type=%s has duplicate directive kind=%d at index=%zu\n",
              static_cast<const void *>(this), class_name().c_str(),
              static_cast<int>(kind), index);
      ROSE_ABORT();
    }
  }
}

void SgOmpDirectiveKindClause::post_construction_initialization() {
  validate_directive_kinds();
}
SOURCE_OMP_DIRECTIVE_KIND_CLAUSE_END

HEADER_OMP_DESTROY_CLAUSE_START
void post_construction_initialization() override;
HEADER_OMP_DESTROY_CLAUSE_END

SOURCE_OMP_DESTROY_CLAUSE_START
void SgOmpDestroyClause::post_construction_initialization() {
  SgNode::post_construction_initialization();
  if (p_expression != nullptr) {
    ROSE_ASSERT(p_expression->get_parent() == nullptr);
    p_expression->set_parent(this);
  }
}
SOURCE_OMP_DESTROY_CLAUSE_END

