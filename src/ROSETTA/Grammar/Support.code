int SgFile::compileOutput(int fileNameIndex) {
  vector<string> argv = get_originalCommandLineArgumentList();
  ROSE_ASSERT(fileNameIndex == 0);
  ROSE_ASSERT(argv.size() > 1);

  // BP : 10/31/2001, strip out any rose options before passing the command
  // line.
  stripRoseCommandLineOptions(argv);

  if (get_Fortran_only()) {
    validateFortranCommandLineOptions(argv);
  }

  int errorCode = compileOutput(argv, fileNameIndex);

  return errorCode;
}

SgProject *SgFile::get_project() {
  SgNode *parent = get_parent();
  if (parent == NULL)
    return NULL;

  while (parent != NULL && isSgProject(parent) == NULL)
    parent = parent->get_parent();
  ROSE_ASSERT(parent != NULL);
  return isSgProject(parent);
}

//! get the current directory
string SgFile::getWorkingDirectory() { return Rose::getWorkingDirectory(); }

//! get the source directory
string SgFile::getSourceDirectory() {

  string sourceFile = get_sourceFileNameWithPath();
  assert(sourceFile.empty() == false);
  return Rose::StringUtility::getPathFromFileName(sourceFile);
}

string SgFile::generateOutputFileName() const {
  const std::string specifiedObject = get_objectFileNameWithoutPath();
  if (!specifiedObject.empty())
    return specifiedObject;

  // With a link command, objectFileNameWithPath can name the executable.
  // Only the explicit object name overrides the per-source object basename.
  const std::string sourceBasename = Rose::StringUtility::stripPathFromFileName(
      get_sourceFileNameWithPath());
  return Rose::StringUtility::stripFileSuffixFromFileName(sourceBasename) + ".o";
}

// Moved to cmdline.cpp: string SgFile::buildCompilerCommandLineOptions (
// vector<string> & argv, int fileNameIndex, const string& compilerName )

// Moved to sage_support.cpp: int SgFile::compileOutput ( vector<string>& argv,
// int fileNameIndex, const string& compilerNameOrig )

void SgFile::display(const std::string &label) const {
  // This function prints out the member data values within the object

  // DQ (6/25/2020): If we call display, then we mean for it to be displayed,
  // not hidden.
  printf("\nIn SgFile::display(%s) \n", label.c_str());

  MLOG_INFO_C("ROSETTA", "Output the SgFile::p_startOfConstruct object = %p \n",
              get_startOfConstruct());
  assert(get_startOfConstruct() != NULL);
  get_startOfConstruct()->display("Called from SgFile::display");

  printf("     p_verbose                                   = %s (value=%d) \n",
         (p_verbose > 1) ? "true" : "false", p_verbose);
  printf("     p_C_only()                                  = %s \n",
         (p_C_only == true) ? "true" : "false");

  printf("     p_Cxx_only()                                = %s \n",
         (p_Cxx_only == true) ? "true" : "false");
  printf("     p_Fortran_only()                            = %s \n",
         (p_Fortran_only == true) ? "true" : "false");
  printf("     p_CoArrayFortran_only()                     = %s \n",
         (p_CoArrayFortran_only == true) ? "true" : "false");

  printf("     p_requires_C_preprocessor                   = %s \n",
         (p_requires_C_preprocessor == true) ? "true" : "false");

  // DQ (2/5/2009): Putting this back now, so we have one at the SgProject and
  // one at the SgFile.
  string inputFormatName;
  switch (p_inputFormat) {
  case SgFile::e_unknown_output_format:
    inputFormatName = "unknown";
    break;
  case SgFile::e_fixed_form_output_format:
    inputFormatName = "fixed";
    break;
  case SgFile::e_free_form_output_format:
    inputFormatName = "free";
    break;

  default: {
    fprintf(stderr, "REX_AST_INVARIANT[file-input-format]: invalid value %d\n",
            p_inputFormat);
    ROSE_ABORT();
  }
  }

  printf(
      "     p_inputFormat                               = %s input format \n",
      inputFormatName.c_str());

  string outputFormatName;
  switch (p_outputFormat) {
  case SgFile::e_unknown_output_format:
    outputFormatName = "unknown";
    break;
  case SgFile::e_fixed_form_output_format:
    outputFormatName = "fixed";
    break;
  case SgFile::e_free_form_output_format:
    outputFormatName = "free";
    break;

  default: {
    fprintf(stderr, "REX_AST_INVARIANT[file-output-format]: invalid value %d\n",
            p_outputFormat);
    ROSE_ABORT();
  }
  }

  printf(
      "     p_outputFormat                              = %s output format \n",
      outputFormatName.c_str());

  string backendCompileFormatName;
  switch (p_backendCompileFormat) {
  case SgFile::e_unknown_output_format:
    backendCompileFormatName = "unknown";
    break;
  case SgFile::e_fixed_form_output_format:
    backendCompileFormatName = "fixed";
    break;
  case SgFile::e_free_form_output_format:
    backendCompileFormatName = "free";
    break;

  default: {
    fprintf(stderr,
            "REX_AST_INVARIANT[file-backend-compile-format]: invalid value "
            "%d\n",
            p_backendCompileFormat);
    ROSE_ABORT();
  }
  }

  printf(
      "     p_backendCompileFormat                      = %s output format \n",
      backendCompileFormatName.c_str());

  printf("     p_openmp                                    = %s \n",
         (p_openmp == true) ? "true" : "false");
  printf("     p_openmp_processed                          = %s \n",
         (p_openmp_processed == true) ? "true" : "false");
  printf("     p_cray_pointer_support                      = %s \n",
         (p_cray_pointer_support == true) ? "true" : "false");
  printf("     p_exit_after_parser                         = %s \n",
         (p_exit_after_parser == true) ? "true" : "false");

  printf("     p_skip_transformation                       = %s \n",
         (p_skip_transformation == true) ? "true" : "false");
  printf("     p_skip_unparse                              = %s \n",
         (p_skip_unparse == true) ? "true" : "false");
  printf("     p_skipfinalCompileStep                      = %s \n",
         (p_skipfinalCompileStep == true) ? "true" : "false");

  printf("     p_unparse_includes                          = %s \n",
         (p_unparse_includes == true) ? "true" : "false");
  printf("     p_unparse_line_directives                   = %s \n",
         (p_unparse_line_directives == true) ? "true" : "false");

  string outputLanguageName = get_outputLanguageOptionName(p_outputLanguage);

  printf("     p_outputLanguage                            = %s output "
         "language \n",
         outputLanguageName.c_str());

  printf("     p_sourceFileNameWithPath                    = %s \n",
         p_sourceFileNameWithPath.c_str());
  printf("     p_sourceFileNameWithoutPath                 = %s \n",
         p_sourceFileNameWithoutPath.c_str());
  printf("     p_unparse_output_filename                   = %s \n",
         p_unparse_output_filename.c_str());

  printf("     p_useBackendOnly                            = %s \n",
         (p_useBackendOnly == true) ? "true" : "false");
  printf("     p_compileOnly                               = %s \n",
         (p_compileOnly == true) ? "true" : "false");

  printf("     p_skip_commentsAndDirectives                = %s \n",
         (p_skip_commentsAndDirectives == true) ? "true" : "false");
  printf("     p_collectAllCommentsAndDirectives           = %s \n",
         (p_collectAllCommentsAndDirectives == true) ? "true" : "false");
  printf("     p_unparseHeaderFiles                        = %s \n",
         (p_unparseHeaderFiles == true) ? "true" : "false");

  printf("     p_preprocessorDirectivesAndCommentsList is %s pointer \n",
         (p_preprocessorDirectivesAndCommentsList != NULL) ? "VALID" : "NULL");

  printf("     p_markGeneratedFiles                        = %s \n",
         (p_markGeneratedFiles == true) ? "true" : "false");
  printf("     p_negative_test                             = %s \n",
         (p_negative_test == true) ? "true" : "false");
  printf("     p_strict_language_handling                  = %s \n",
         (p_strict_language_handling == true) ? "true" : "false");
  printf("     p_sourceFileUsesCppFileExtension            = %s \n",
         (p_sourceFileUsesCppFileExtension == true) ? "true" : "false");
  printf("     p_sourceFileUsesFortranFileExtension        = %s \n",
         (p_sourceFileUsesFortranFileExtension == true) ? "true" : "false");
  printf("     p_sourceFileUsesFortran77FileExtension      = %s \n",
         (p_sourceFileUsesFortran77FileExtension == true) ? "true" : "false");
  printf("     p_sourceFileUsesFortran90FileExtension      = %s \n",
         (p_sourceFileUsesFortran90FileExtension == true) ? "true" : "false");
  printf("     p_sourceFileUsesFortran95FileExtension      = %s \n",
         (p_sourceFileUsesFortran95FileExtension == true) ? "true" : "false");

  printf("     p_unparse_tokens                            = %s \n",
         (p_unparse_tokens == true) ? "true" : "false");

  printf("     p_detect_dangling_pointers                  = %d \n",
         p_detect_dangling_pointers);

  printf("     p_skipAstConsistancyTests                   = %s \n",
         (p_skipAstConsistancyTests == true) ? "true" : "false");

  // DQ (4/17/2015): Adding multifile handling support for commandline
  // generation.
  printf("     p_multifile_support                         = %s \n",
         (p_multifile_support == true) ? "true" : "false");

  // DQ (5/20/2021): Support for token-based unparsing (computation of first and
  // last statement in source file. printf ("     p_firstStatement = %p
  // \n",p_firstStatement); printf ("     p_lastStatement = %p
  // \n",p_lastStatement);
}

SOURCE_APPLICATION_FILE_END

SOURCE_APPLICATION_SOURCE_FILE_START

void SgSourceFile::initialization() {
  // DQ (3/2/2022): The SgSourceFile node has a number of new data members that
  // were not previously initialized.

  // Initialization

  p_globalScope = NULL;
  p_target_size_type = NULL;
  p_isHeaderFile = false;
  p_associated_include_file = NULL;
  p_frontendExternalFileList = NULL;
  p_processedToIncludeCppDirectivesAndComments = false;
}

#include "tokenStreamMapping.h"

void SgSourceFile::post_construction_initialization() {
  SgFile::post_construction_initialization();
  ROSE_ASSERT(!(p_isGeneratedSource && p_isCommandLineInputSource));
  ROSE_ASSERT(p_tokenSubsequenceMap == nullptr);
  p_tokenSubsequenceMap =
      new std::map<SgNode *, TokenStreamSequenceToNodeMapping *>();
  ROSE_ASSERT(Rose::tokenSubsequenceMapOfMapsBySourceFile
                  .emplace(this, p_tokenSubsequenceMap).second);
}

const std::map<SgNode *, TokenStreamSequenceToNodeMapping *> &
SgSourceFile::get_tokenSubsequenceMap() const {
  auto entry = Rose::tokenSubsequenceMapOfMapsBySourceFile.find(
      const_cast<SgSourceFile *>(this));
  if (p_tokenSubsequenceMap == nullptr ||
      entry == Rose::tokenSubsequenceMapOfMapsBySourceFile.end() ||
      entry->second != p_tokenSubsequenceMap) {
    fprintf(stderr, "REX_AST_INVARIANT[token-subsequence-owner]: source=%p "
                    "has no exact owned token map\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  return *p_tokenSubsequenceMap;
}

std::map<SgNode *, TokenStreamSequenceToNodeMapping *> &
SgSourceFile::get_tokenSubsequenceMap() {
  return const_cast<std::map<SgNode *, TokenStreamSequenceToNodeMapping *> &>(
      static_cast<const SgSourceFile *>(this)->get_tokenSubsequenceMap());
}

void SgSourceFile::clear_tokenSubsequenceMap() {
  auto &tokenMap = get_tokenSubsequenceMap();
  std::set<TokenStreamSequenceToNodeMapping *> owned;
  for (const auto &entry : tokenMap) {
    ROSE_ASSERT(entry.first != nullptr && entry.second != nullptr);
    owned.insert(entry.second);
  }
  auto &pool = TokenStreamSequenceToNodeMapping::tokenSequencePool;
  for (auto entry = pool.begin(); entry != pool.end();) {
    if (entry->first.sourceFile == this) {
      ROSE_ASSERT(entry->second != nullptr);
      owned.insert(entry->second);
      entry = pool.erase(entry);
    } else {
      ++entry;
    }
  }
  tokenMap.clear();
  for (auto *mapping : owned)
    delete mapping;
}

void SgSourceFile::release_tokenSubsequenceMap() {
  clear_tokenSubsequenceMap();
  ROSE_ASSERT(Rose::tokenSubsequenceMapOfMapsBySourceFile.erase(this) == 1);
  delete p_tokenSubsequenceMap;
  p_tokenSubsequenceMap = nullptr;
}

void SgSourceFile::set_tokenSubsequenceMap(
    std::map<SgNode *, TokenStreamSequenceToNodeMapping *> *tokenMap) {
  if (tokenMap == nullptr) {
    fprintf(stderr, "REX_AST_INVARIANT[token-subsequence-map]: "
                    "null map is not permitted\n");
    ROSE_ABORT();
  }
  if (tokenMap == p_tokenSubsequenceMap || !get_tokenSubsequenceMap().empty()) {
    fprintf(stderr, "REX_AST_INVARIANT[token-subsequence-publication]: "
                    "publication requires a fresh map and a cleared owner\n");
    ROSE_ABORT();
  }
  delete p_tokenSubsequenceMap;
  p_tokenSubsequenceMap = tokenMap;
  Rose::tokenSubsequenceMapOfMapsBySourceFile.at(this) = tokenMap;
}

void SgSourceFile::copy_frontendAssociations(const SgSourceFile &source,
                                             SgCopyHelp &help) {
  ROSE_ASSERT(get_tokenSubsequenceMap().empty());
  const auto &copies = help.get_copiedNodeMap();
  auto copiedNode = [&](SgNode *node) -> SgNode * {
    auto entry = copies.find(node);
    if (node == nullptr || entry == copies.end() || entry->second == nullptr ||
        entry->second == node) {
      fprintf(stderr,
              "REX_COPY_INVARIANT[token-node-identity]: source=%p "
              "token node=%p has no exact copy\n",
              static_cast<const void *>(&source), static_cast<void *>(node));
      ROSE_ABORT();
    }
    return entry->second;
  };
  std::map<const TokenStreamSequenceToNodeMapping *,
           TokenStreamSequenceToNodeMapping *>
      mappings;
  for (const auto &entry : source.get_tokenSubsequenceMap()) {
    ROSE_ASSERT(entry.second != nullptr);
    auto copy = mappings.find(entry.second);
    if (copy == mappings.end()) {
      auto *original = entry.second;
      TokenStreamSequenceToNodeMapping::NodeAssociation association{
          copiedNode(original->node),
          {},
          original->shared,
          original->constructedInEvaluationOfSynthesizedAttribute};
      for (SgNode *node : original->nodeVector)
        association.nodes.push_back(copiedNode(node));
      auto *mapping = TokenStreamSequenceToNodeMapping::createPublished(
          association,
          original->halfOpenInterval(
              TokenStreamIntervalKind::leading_whitespace),
          original->halfOpenInterval(
              TokenStreamIntervalKind::token_subsequence),
          original->halfOpenInterval(
              TokenStreamIntervalKind::trailing_whitespace),
          original->halfOpenInterval(TokenStreamIntervalKind::else_whitespace),
          p_token_list.size());
      copy = mappings.emplace(original, mapping).first;
    }
    ROSE_ASSERT(
        p_tokenSubsequenceMap->emplace(copiedNode(entry.first), copy->second)
            .second);
  }
  ROSE_ASSERT(p_frontendResolvedIncludeDirectivesMap.empty());
  const auto &records = help.get_copiedPreprocessingMap();
  for (const auto &[path, directives] :
       source.get_frontendResolvedIncludeDirectivesMap()) {
    ROSE_ASSERT(!path.empty() && !directives.empty());
    auto &copiedDirectives = p_frontendResolvedIncludeDirectivesMap[path];
    for (const PreprocessingInfo *original : directives) {
      ROSE_ASSERT(original != nullptr &&
                  original->getAttachedOwner() != nullptr);
      const auto record = records.find(original);
      ROSE_ASSERT(record != records.end());
      PreprocessingInfo *copy = record->second;
      const auto owner = copies.find(original->getAttachedOwner());
      ROSE_ASSERT(owner != copies.end() && copy != nullptr &&
                  copy != original &&
                  copy->getAttachedOwner() == owner->second &&
                  owner->second != original->getAttachedOwner());
      ROSE_ASSERT(copiedDirectives.insert(copy).second);
    }
  }
  if (p_associated_include_file != nullptr) {
    ROSE_ASSERT(p_associated_include_file->get_source_file() == this);
    p_associated_include_file->validateIncludeOwnership();
  }
}

void SgSourceFile::set_representativeWhitespaceStatementMap(
    std::map<SgScopeStatement *, SgStatement *>
        &representativeWhitespaceStatementMap) {
  std::map<SgScopeStatement *, SgStatement *> &frontierMap =
      this->get_representativeWhitespaceStatementMap();

  std::map<SgScopeStatement *, SgStatement *>::iterator i =
      representativeWhitespaceStatementMap.begin();
  while (i != representativeWhitespaceStatementMap.end()) {
    ROSE_ASSERT(i->first != NULL);
    ROSE_ASSERT(i->second != NULL);

    if (frontierMap.find(i->first) != frontierMap.end()) {
      MLOG_INFO_C("ROSETTA",
                  "SgSourceFile::set_representativeWhitespaceStatementMap(): "
                  "This is a redundant entry in the Map \n");
      MLOG_INFO_C("ROSETTA", "   --- filename = %s \n", getFileName().c_str());
      MLOG_INFO_C("ROSETTA", "   --- i->first  = %p = %s \n", i->first,
                  i->first->class_name().c_str());
      MLOG_INFO_C("ROSETTA", "   --- i->second = %p = %s \n", i->second,
                  i->second->class_name().c_str());
    } else {
      frontierMap.insert(*i);
    }
    i++;
  }
}

std::map<SgScopeStatement *, SgStatement *> &
SgSourceFile::get_representativeWhitespaceStatementMap() {
  ROSE_ASSERT(this->get_startOfConstruct() != NULL);

  int index = this->get_startOfConstruct()->get_file_id();

  if (index < 0) {
    MLOG_INFO_C("ROSETTA",
                "ERROR: we only have token stream subsequences for valid "
                "files: fileid < 0: index = %d \n",
                index);
    ROSE_ASSERT(false);
  }

  if (Rose::representativeWhitespaceStatementMapOfMaps.find(index) ==
      Rose::representativeWhitespaceStatementMapOfMaps.end()) {
    std::map<SgScopeStatement *, SgStatement *> *frontierNodesMap =
        new std::map<SgScopeStatement *, SgStatement *>();
    ROSE_ASSERT(frontierNodesMap != NULL);

    Rose::representativeWhitespaceStatementMapOfMaps.insert(
        std::pair<int, std::map<SgScopeStatement *, SgStatement *> *>(
            index, frontierNodesMap));
  }

  ROSE_ASSERT(Rose::representativeWhitespaceStatementMapOfMaps.find(index) !=
              Rose::representativeWhitespaceStatementMapOfMaps.end());
  ROSE_ASSERT(Rose::representativeWhitespaceStatementMapOfMaps[index] != NULL);

  std::map<SgScopeStatement *, SgStatement *> *result =
      Rose::representativeWhitespaceStatementMapOfMaps[index];
  ROSE_ASSERT(result != NULL);

  return *result;
}

void SgSourceFile::set_macroExpansionMap(
    std::map<SgStatement *, MacroExpansion *> &macroExpansionMap) {
  // DQ (11/30/2015): Provide a statement to use as a key in the macro expansion
  // map to get info about macro expansions. Rose::macroExpansionMap =
  // macroExpansionMap;

  // DQ (9/26/2018): We need to merge these results not overright the initial
  // results.  This is essential when we are supporting multiple files (or
  // header files in addition to the source file). Rose::frontierNodes =
  // tokenStreamSequenceMap;

  std::map<SgStatement *, MacroExpansion *> &frontierMap =
      this->get_macroExpansionMap();

  std::map<SgStatement *, MacroExpansion *>::iterator i =
      macroExpansionMap.begin();
  while (i != macroExpansionMap.end()) {
    ROSE_ASSERT(i->first != NULL);
    ROSE_ASSERT(i->second != NULL);

    // DQ (9/26/2018): Make sure this is not an entry that already exists in the
    // map.
    if (frontierMap.find(i->first) != frontierMap.end()) {
      MLOG_INFO_C("ROSETTA", "SgSourceFile::set_macroExpansionMap(): This is a "
                             "redundant entry in the Map \n");
      ROSE_ASSERT(false);
    }

    frontierMap.insert(*i);

    i++;
  }
}

std::map<SgStatement *, MacroExpansion *> &
SgSourceFile::get_macroExpansionMap() {
  // DQ (11/30/2015): Provide a statement to use as a key in the macro expansion
  // map to get info about macro expansions. DQ (11/30/2015): Not sure I want
  // this to be copy by value, but OK for now. return Rose::macroExpansionMap;

  ROSE_ASSERT(this->get_startOfConstruct() != NULL);

  int index = this->get_startOfConstruct()->get_file_id();

  if (index < 0) {
    MLOG_INFO_C("ROSETTA",
                "ERROR: we only have token stream subsequences for valid "
                "files: fileid < 0: index = %d \n",
                index);
    ROSE_ASSERT(false);
  }

  if (Rose::macroExpansionMapOfMaps.find(index) ==
      Rose::macroExpansionMapOfMaps.end()) {
    std::map<SgStatement *, MacroExpansion *> *frontierNodesMap =
        new std::map<SgStatement *, MacroExpansion *>();
    ROSE_ASSERT(frontierNodesMap != NULL);

    Rose::macroExpansionMapOfMaps.insert(
        std::pair<int, std::map<SgStatement *, MacroExpansion *> *>(
            index, frontierNodesMap));
  }

  ROSE_ASSERT(Rose::macroExpansionMapOfMaps.find(index) !=
              Rose::macroExpansionMapOfMaps.end());
  ROSE_ASSERT(Rose::macroExpansionMapOfMaps[index] != NULL);

  std::map<SgStatement *, MacroExpansion *> *result =
      Rose::macroExpansionMapOfMaps[index];
  ROSE_ASSERT(result != NULL);

  return *result;
}

SOURCE_APPLICATION_SOURCE_FILE_END

SOURCE_APPLICATION_DIRECTORY_START
int SgDirectory::numberOfFiles() const {
  assert(p_fileList != NULL);
  return p_fileList->get_listOfFiles().size();
}

SgFile *SgDirectory::get_file(int i) const {
  assert(p_fileList != NULL);
  return p_fileList->get_listOfFiles()[i];
}

int SgDirectory::numberOfDirectories() const {
  assert(p_directoryList != NULL);
  return p_directoryList->get_listOfDirectories().size();
}

SgDirectory *SgDirectory::get_directory(int i) const {
  assert(p_directoryList != NULL);
  return p_directoryList->get_listOfDirectories()[i];
}

void SgDirectory::post_construction_initialization() {
  // Make sure these data members start out as NULL.
  assert(p_fileList == NULL);
  assert(p_directoryList == NULL);

  // Initialize pointers to valid opjects with empty lists.
  p_fileList = new SgFileList();
  p_directoryList = new SgDirectoryList();

  assert(p_fileList != NULL);
  assert(p_directoryList != NULL);

  p_fileList->set_parent(this);
  p_directoryList->set_parent(this);
}

SOURCE_APPLICATION_DIRECTORY_END

SOURCE_APPLICATION_PROJECT_START

int SgProject::p_verbose = 0;

int SgProject::p_unparseHeaderFilesDebug = 0;

//! global to output the command line that goes to the backend compiler. Default
//! is false.
bool SgProject::p_showBackendCommandLine = false;

SgProject::SgProject() { initialization(); }

SgProject::SgProject(const SgProject &project) {
  initialization();
  MLOG_INFO_C(
      "ROSETTA",
      "ERROR: this SgProject copy constructor is not supposed to be used \n");
  MLOG_INFO_C("ROSETTA", "    use SgProject ( int & argc, char** & argv , int "
                         "& errorCode ) OR copy member function instead \n");
  ROSE_ABORT();
}

SgProject::SgProject(int argc, char **argv,
                     constant_folding_enum frontendConstantFolding) {
  initialization();

  p_frontendConstantFolding = frontendConstantFolding;

  std::vector<std::string> argvList(argv, argv + argc);
  int errorCode = parse(argvList);
  set_frontendErrorCode(errorCode);
}

SgProject::SgProject(const std::vector<std::string> &argv,
                     constant_folding_enum frontendConstantFolding) {
  initialization();

  p_frontendConstantFolding = frontendConstantFolding;

  int errorCode = parse(argv);
  set_frontendErrorCode(errorCode);
}

void SgProject::initialization() {
  p_mutationState = nullptr;
  p_callGraphState = nullptr;
  p_midendErrorCode = 0;
  p_openmp_linking = false;

  p_unparser__clobber_input_file = false;

  p_fileList_ptr = new SgFileList();
  assert(p_fileList_ptr != NULL);

  p_fileList_ptr->set_parent(this);

  p_frontendErrorCode = 0;
  p_backendErrorCode = 0;
  p_outputFileName = "";
  p_compileOnly = false;

  p_compilationPerformanceFile = "";
  p_C_PreprocessorOnly = false;
  p_skip_post_processing = false;
  p_suppressNameQualificationAcrossWholeTranslationUnit = false;

  p_attributeMechanism = NULL;

  p_directoryList = NULL;

  if (p_verbose > 0) {
    MLOG_INFO_C("ROSETTA",
                "Note: Verbose was already set to non-zero value = %d (valid "
                "range is 0...10) \n",
                p_verbose);
    assert(p_verbose <= 10);
  } else {
    p_verbose = 0;
  }

  assert(p_directoryList == NULL);

  p_directoryList = new SgDirectoryList();
  assert(p_directoryList != NULL);
  p_directoryList->set_parent(this);

  p_C_only = false;
  p_Cxx_only = false;

  p_C11_only = false;
  p_Cxx0x_only = false;
  p_Cxx11_only = false;
  p_C14_only = false;
  p_Cxx14_only = false;

  p_Fortran_only = false;
  p_addCppDirectivesToAST = false;

  p_frontendConstantFolding = e_original_expressions_only;

  // This semantic scope has no physical source file, but its located-node
  // contract still requires a complete compiler-generated range.
  Sg_File_Info *fi_gsaf =
      Sg_File_Info::generateDefaultFileInfoForCompilerGeneratedNode();
  p_globalScopeAcrossFiles = new SgGlobal(fi_gsaf);
  fi_gsaf->set_parent(p_globalScopeAcrossFiles);
  Sg_File_Info *globalScopeEnd =
      Sg_File_Info::generateDefaultFileInfoForCompilerGeneratedNode();
  p_globalScopeAcrossFiles->set_endOfConstruct(globalScopeEnd);
  globalScopeEnd->set_parent(p_globalScopeAcrossFiles);
  p_globalScopeAcrossFiles->set_parent(this);

  p_unparse_in_same_directory_as_input_file = false;

  // DQ (1/19/2014): This option "-S" is required for some build systems (e.g.
  // valgrind).
  p_stop_after_compilation_do_not_assemble_file = false;

  // DQ (1/20/2014): This option "-m32" over-rides the 64-bit mode on 64-bit
  // environments and is required for some build systems (e.g. valgrind).
  p_mode_32_bit = false;

  // DQ (3/19/2014): This option causes the output of source code to an existing
  // file to be an error.
  p_noclobber_output_file = false;

  // DQ (3/19/2014): This option causes the output of source code to an existing
  // file to be an error if it results in a different file.
  p_noclobber_if_different_output_file = false;

  // Pei-Hung (8/6/2014): This option appends PID into the output name to avoid
  // file collision in parallel compilation.
  p_appendPID = false;

  // DQ (9/15/2018): Added support for a report on the internal use of header
  // file unparsing. This is to support the header file unparsing when used with
  // and without the token based unparsing.
  p_reportOnHeaderFileUnparsing = false;

  p_usingApplicationRootDirectory = false;
}

SgFile *SgProject::operator[](unsigned int i) {
  assert(p_fileList_ptr != NULL);
  assert(i < (unsigned)numberOfFiles());
  return p_fileList_ptr->get_listOfFiles()[i];
}

SgFile *SgProject::operator[](std::string filename) {
  ROSE_ASSERT(p_fileList_ptr != NULL);
  ROSE_ASSERT(numberOfFiles() > 0);

  SgFilePtrList::iterator i = p_fileList_ptr->get_listOfFiles().begin();
  while (i != p_fileList_ptr->get_listOfFiles().end()) {
    ROSE_ASSERT(*i != NULL);
    // Find the matching SgFile object using the get_sourceFileNameWithPath()
    if (filename == (*i)->get_sourceFileNameWithPath()) {
      return *i;
    }

    i++;
  }

  return NULL;
}

std::ostream &operator<<(std::ostream &os,
                         const Rose_STL_Container<string> &l) {
  return os;
}

SgFilePtrList &SgProject::get_fileList() const {
  return p_fileList_ptr->get_listOfFiles();
}

int SgProject::numberOfFiles() const {
  assert(p_fileList_ptr != NULL);
  return p_fileList_ptr->get_listOfFiles().size();
}

int SgProject::numberOfDirectories() const {
  assert(p_directoryList != NULL);
  return p_directoryList->get_listOfDirectories().size();
}

SgFile &SgProject::get_file(int i) const {
  assert(i >= 0);
  assert(i < numberOfFiles());

  assert(p_fileList_ptr != NULL);
  SgFile *targetFile = p_fileList_ptr->get_listOfFiles()[i];
  assert(targetFile != NULL);

  return *targetFile;
}

void SgProject::set_file(SgFile &file) {
  assert(p_fileList_ptr != NULL);
  p_fileList_ptr->get_listOfFiles().push_back(&file);

  file.set_parent(p_fileList_ptr);

  assert(numberOfFiles() > 0);
}

SgFilePtrList SgProject::get_files() const {
  return p_fileList_ptr->get_listOfFiles();
}

void SgProject::unparse(UnparseFormatHelp *unparseFormatHelp,
                        UnparseDelegate *unparseDelegate) {
  extern void unparseProject(SgProject * project,
                             UnparseFormatHelp * unparseFormatHelp /* = NULL */,
                             UnparseDelegate * unparseDelegate /* = NULL */);
  unparseProject(this, unparseFormatHelp, unparseDelegate);
}

Rose_STL_Container<string> SgProject::getAbsolutePathFileNames() const {
  Rose_STL_Container<string> nameList;
  for (int i = 0; i < numberOfFiles(); i++) {
    SgFile &file = get_file(i);
    nameList.push_back(std::string(file.getFileName()));
  }

  return nameList;
}

int SgProject::get_verbose(void) { return p_verbose; }

void SgProject::set_verbose(int x) { p_verbose = x; }

int SgProject::get_unparseHeaderFilesDebug(void) {
