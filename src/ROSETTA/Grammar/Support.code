SOURCE_SYMBOL_TABLE_START

namespace {
void eraseSymbolBasisFromExactLookup(SgSymbolTable *table, SgSymbol *symbol,
                                     const SgNode *basis);
} // namespace

bool eqstr::operator()(const SgName &s1, const SgName &s2) const {
  ROSE_ASSERT(hash_multimap != NULL);

  if (hash_multimap->get_case_insensitive_semantics() == true) {
    return SgName::caseInsensitiveEquality(s1, s2);
  } else {
    // This is the SgName::operator==(const SgName & s1, const SgName & s2)
    // member function
    return s1 == s2;
  }
}

size_t hash_Name::operator()(const SgName &name) const {
  ROSE_ASSERT(hash_multimap != NULL);
  if (hash_multimap->get_case_insensitive_semantics() == true) {
    // We need to compute the hash on the normalized form of the name (pick
    // lower case).
    std::string s = name;

    std::transform(s.begin(), s.end(), s.begin(), [](unsigned char byte) {
      return static_cast<char>(::tolower(byte));
    });
    // Return hashed value on the normalized (lower case) string.
    return hasher(s.c_str());
  } else {
    return hasher(name.getString());
  }
}

SgSymbolTable::SgSymbolTable() : p_no_name(true) {
  int symbolTableSize = 17;

  p_table = new BaseHashType(symbolTableSize);
  ROSE_ASSERT(p_table != NULL);
}

SgSymbolTable::SgSymbolTable(int symbolTableSize) : p_no_name(true) {
  p_table = new BaseHashType(symbolTableSize);
  ROSE_ASSERT(p_table != NULL);
}

bool SgSymbolTable::isCaseInsensitive() const {
  ROSE_ASSERT(p_table != NULL);
  return p_table->get_case_insensitive_semantics();
}

void SgSymbolTable::setCaseInsensitive(bool b) {
  ROSE_ASSERT(p_table != NULL);

  // Make it NOT an error to redundantly set the case sensitivity/insensitivity.
  bool changingCaseSensitivity = b != p_table->get_case_insensitive_semantics();
  if (changingCaseSensitivity == true) {
    if (p_table->empty() == false) {
      MLOG_ERROR_C(
          "ROSETTA",
          "Error: Can't change case sensitivity of non-empty symbol table.\n");
      MLOG_ERROR_MORE_C(
          "   Solution: set the case sensitivity/insensitivity earlier in "
          "processing (immediately after the call to build the scope) \n");
    }
    ROSE_ASSERT(p_table->empty() == true);

    p_table->set_case_insensitive_semantics(b);
  }
}

SgName SgSymbolTable::get_name(const SgNode *node) const {
  SgName name;

  switch (node->variantT()) {
  case V_SgLabelStatement: {
    const SgLabelStatement *labelStatement = isSgLabelStatement(node);
    if (labelStatement->get_label() != NULL) {
      name = labelStatement->get_label();
    } else {
      ROSE_ASSERT(labelStatement->get_numeric_label() != NULL);
      name = labelStatement->get_numeric_label()->get_name();
    }
    break;
  }

  case V_SgClassDeclaration:
  case V_SgDerivedTypeStatement:
  case V_SgModuleStatement: {
    const SgClassDeclaration *classDeclaration = isSgClassDeclaration(node);
    name = classDeclaration->get_name();
    break;
  }

  case V_SgTemplateInstantiationDecl: {
    const SgTemplateInstantiationDecl *templateInstantiationDeclaration =
        isSgTemplateInstantiationDecl(node);
    name = templateInstantiationDeclaration->get_name();
    break;
  }

  case V_SgEnumDeclaration: {
    const SgEnumDeclaration *enumDeclaration = isSgEnumDeclaration(node);
    name = enumDeclaration->get_name();
    break;
  }

  case V_SgProgramHeaderStatement:
  case V_SgProcedureHeaderStatement: {
    const SgFunctionDeclaration *functionDeclaration =
        isSgFunctionDeclaration(node);
    ROSE_ASSERT(functionDeclaration != NULL);
    name =
        SageInterface::getFortranProgramUnitSymbolTableKey(functionDeclaration);
    break;
  }

  case V_SgFunctionDeclaration:
  case V_SgEntryStatement:
  case V_SgMemberFunctionDeclaration: {
    const SgFunctionDeclaration *functionDeclaration =
        isSgFunctionDeclaration(node);
    name = functionDeclaration->get_name();
    break;
  }

  case V_SgTemplateInstantiationFunctionDecl: {
    const SgTemplateInstantiationFunctionDecl *functionDeclaration =
        isSgTemplateInstantiationFunctionDecl(node);
    name = functionDeclaration->get_name();
    break;
  }

  case V_SgTemplateInstantiationMemberFunctionDecl: {
    const SgTemplateInstantiationMemberFunctionDecl *functionDeclaration =
        isSgTemplateInstantiationMemberFunctionDecl(node);
    name = functionDeclaration->get_name();
    break;
  }

  case V_SgTemplateInstantiationDirectiveStatement: {
    const SgTemplateInstantiationDirectiveStatement *directive =
        isSgTemplateInstantiationDirectiveStatement(node);
    name = directive->get_mangled_name();
    break;
  }

  case V_SgNamespaceDeclarationStatement: {
    const SgNamespaceDeclarationStatement *namespaceDeclarationStatement =
        isSgNamespaceDeclarationStatement(node);
    name = namespaceDeclarationStatement->get_name();
    break;
  }

  case V_SgNamespaceAliasDeclarationStatement: {
    const SgNamespaceAliasDeclarationStatement
        *namespaceAliasDeclarationStatement =
            isSgNamespaceAliasDeclarationStatement(node);
    name = namespaceAliasDeclarationStatement->get_name();
    break;
  }

  case V_SgTemplateFunctionDeclaration: {
    const SgTemplateFunctionDeclaration *templateDeclaration =
        isSgTemplateFunctionDeclaration(node);
    name = templateDeclaration->get_name();
    break;
  }

  case V_SgTemplateMemberFunctionDeclaration: {
    const SgTemplateMemberFunctionDeclaration *templateDeclaration =
        isSgTemplateMemberFunctionDeclaration(node);
    name = templateDeclaration->get_name();
    break;
  }

  case V_SgTemplateClassDeclaration: {
    const SgTemplateClassDeclaration *templateDeclaration =
        isSgTemplateClassDeclaration(node);
    name = templateDeclaration->get_name();
    break;
  }
  case V_SgTemplateDeclaration: {
    const SgTemplateDeclaration *templateDeclaration =
        isSgTemplateDeclaration(node);
    name = templateDeclaration->get_name();
    break;
  }

  case V_SgTypedefDeclaration: {
    const SgTypedefDeclaration *typedefDeclaration =
        isSgTypedefDeclaration(node);
    name = typedefDeclaration->get_name();
    break;
  }

  case V_SgTemplateInstantiationTypedefDeclaration: {
    const SgTemplateInstantiationTypedefDeclaration
        *templateInstantiationDeclaration =
            isSgTemplateInstantiationTypedefDeclaration(node);
    name = templateInstantiationDeclaration->get_name();
    break;
  }

  case V_SgTemplateTypedefDeclaration: {
    const SgTemplateTypedefDeclaration *templateDeclaration =
        isSgTemplateTypedefDeclaration(node);
    name = templateDeclaration->get_name();
    break;
  }

  case V_SgFunctionType: {
    const SgFunctionType *functionType = isSgFunctionType(node);
    ROSE_ASSERT(functionType != NULL);

    name = functionType->get_mangled();
    break;
  }

  case V_SgInitializedName: {
    const SgInitializedName *initializedName = isSgInitializedName(node);
    name = initializedName->get_name();
    break;
  }

  case V_SgNonrealDecl: {
    const SgNonrealDecl *nrdecl = isSgNonrealDecl(node);
    name = nrdecl->get_name();
    break;
  }

  default: {
    MLOG_WARN_C("ROSETTA",
                "SgSymbolTable::get_name(SgNode*) undefined for %s \n",
                node->class_name().c_str());
    ROSE_ASSERT(false);
  }
  }

  return name;
}

/* ************************************************************************
                               INSERT FUNCTIONS
   ************************************************************************/

void SgSymbolTable::insert(const SgName &nm, SgSymbol *sp) {


  ROSE_ASSERT(p_table != NULL);

  if (sp == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[symbol-table-insert]: symbol table cannot "
            "insert null symbol for name %s\n",
            nm.str());
    ROSE_ABORT();
  }
  if (sp->get_parent() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[symbol-table-insert]: symbol=%p name=%s "
            "is already owned by %p\n",
            static_cast<void *>(sp), nm.str(),
            static_cast<void *>(sp->get_parent()));
    ROSE_ABORT();
  }

  if (SgAliasSymbol *aliasSymbol = isSgAliasSymbol(sp)) {
    if (aliasSymbol->get_causal_nodes().empty()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[alias-provenance]: alias=%p name=%s target=%p "
              "has no construction-time causal node\n",
              static_cast<void *>(aliasSymbol), nm.str(),
              static_cast<void *>(aliasSymbol->get_alias()));
      ROSE_ABORT();
    }
    for (SgNode *causalNode : aliasSymbol->get_causal_nodes()) {
      if (causalNode == NULL) {
        fprintf(stderr,
                "REX_AST_INVARIANT[alias-provenance]: alias=%p name=%s has a "
                "null causal node\n",
                static_cast<void *>(aliasSymbol), nm.str());
        ROSE_ABORT();
      }
    }
  }

  if (p_symbolSet.find(sp) != p_symbolSet.end()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[symbol-table-insert]: symbol=%p name=%s "
            "is already indexed in table=%p\n",
            static_cast<void *>(sp), nm.str(), static_cast<void *>(this));
    ROSE_ABORT();
  }

  ROSE_ASSERT(p_symbolStoredNameMap.count(sp) == 0);
  SgNode *basis = sp->get_symbol_basis();
  auto basis_entry = p_symbolBasisExactIndex.end();
  size_t basis_size = 0;
  bool new_basis_entry = false;
  try {
    p_symbolSet.insert(sp);
    const auto named = p_symbolStoredNameMap.emplace(sp, nm);
    ROSE_ASSERT(named.second);
    if (basis != nullptr) {
      const auto inserted = p_symbolBasisExactIndex.try_emplace(basis);
      basis_entry = inserted.first;
      new_basis_entry = inserted.second;
      auto &symbols = basis_entry->second;
      basis_size = symbols.size();
      ROSE_ASSERT(std::find(symbols.begin(), symbols.end(), sp) ==
                  symbols.end());
      symbols.push_back(sp);
    }
    p_table->emplace(nm, sp);
  } catch (...) {
    if (basis_entry != p_symbolBasisExactIndex.end()) {
      basis_entry->second.resize(basis_size);
      if (new_basis_entry)
        p_symbolBasisExactIndex.erase(basis_entry);
    }
    p_symbolStoredNameMap.erase(sp);
    p_symbolSet.erase(sp);
    throw;
  }
  sp->set_parent(this);
}

/* ************************************************************************
                               REMOVE FUNCTIONS
   ************************************************************************/

// Detach all function-type symbols under this key without deleting them.
void SgSymbolTable::remove_function_type(const SgName &name) {
  ROSE_ASSERT(p_table != NULL);
  const auto range = p_table->equal_range(name);
  for (auto it = range.first; it != range.second;) {
    SgSymbol *symbol = (it++)->second;
    ROSE_ASSERT(symbol->variantT() == V_SgFunctionTypeSymbol);
    remove(symbol);
  }
}

namespace {
SgSymbol *findSymbolByExactBasis(const SgSymbolTable *table,
                                 const SgNode *basis) {
  ROSE_ASSERT(table != NULL && basis != NULL);
  const std::vector<SgSymbol *> &symbols =
      table->find_symbols_with_exact_basis(basis);
  SgSymbol *alias = NULL;
  for (SgSymbol *symbol : symbols) {
    ROSE_ASSERT(symbol != NULL && symbol->get_parent() == table &&
                symbol->get_symbol_basis() == basis && table->exists(symbol));
    if (isSgAliasSymbol(symbol) == NULL)
      return symbol;
    if (alias == NULL)
      alias = symbol;
  }
  return alias;
}
} // namespace

SgSymbol *SgSymbolTable::find(const SgInitializedName *initializedName) {
  return findSymbolByExactBasis(this, initializedName);
}

SgSymbol *SgSymbolTable::find(const SgFunctionType *functionType) {
  ROSE_ASSERT(p_table != NULL);
  ROSE_ASSERT(functionType != NULL);

  SgName name = functionType->get_mangled();
  p_iterator = p_table->find(name);
  while (p_iterator != p_table->end() &&
         get_table()->key_eq()((*p_iterator).first, name)) {
    ROSE_ASSERT(p_iterator->second != NULL);
    SgFunctionTypeSymbol *symbol = isSgFunctionTypeSymbol(p_iterator->second);
    if (symbol != nullptr && symbol->get_type() == functionType) {
      return symbol;
    }
    p_iterator++;
  }
  return NULL;
}

SgSymbol *SgSymbolTable::find(const SgStatement *statement) {
  return findSymbolByExactBasis(this, statement);
}

void SgSymbolTable::remove(const SgSymbol *symbol) {
  ROSE_ASSERT(p_table != NULL);
  const auto storedNameLookup = p_symbolStoredNameMap.find(symbol);
  ROSE_ASSERT(storedNameLookup != p_symbolStoredNameMap.end());
  const auto range = p_table->equal_range(storedNameLookup->second);
  const auto elementToDelete =
      std::find_if(range.first, range.second, [symbol](const auto &entry) {
        return entry.second == symbol;
      });
  ROSE_ASSERT(elementToDelete != range.second);
  SgSymbol *storedSymbol = elementToDelete->second;
  ROSE_ASSERT(storedSymbol != NULL && storedSymbol->get_parent() == this &&
              exists(storedSymbol));

  eraseSymbolBasisFromExactLookup(this, storedSymbol,
                                  storedSymbol->get_symbol_basis());
  p_symbolSet.erase(storedSymbol);
  p_symbolStoredNameMap.erase(storedSymbol);

  storedSymbol->set_parent(NULL);
  get_table()->erase(elementToDelete);
}

/* ************************************************************************
                               FIND FUNCTIONS
   ************************************************************************/

SgAliasSymbol *SgSymbolTable::find_aliased_symbol(const SgName &nm,
                                                  SgSymbol *sp) {
  ROSE_ASSERT(p_table != NULL);

  ROSE_ASSERT(sp != NULL);

  p_iterator = p_table->find(nm);

  while (p_iterator != p_table->end() &&
         get_table()->key_eq()(p_iterator->first, nm)) {
    p_name = nm;
    p_no_name = false;

    ROSE_ASSERT(p_iterator->second != NULL);
    SgAliasSymbol *aliasSymbol = isSgAliasSymbol(p_iterator->second);
    if ((aliasSymbol != NULL) && (aliasSymbol->get_base() == sp)) {
      return aliasSymbol;
    }

    p_iterator++;
  }

  return NULL;
}

bool SgSymbolTable::exists(const SgName &nm) const {
  ROSE_ASSERT(p_table != NULL);
  return p_table->find(nm) != p_table->end();
}

bool SgSymbolTable::exists(const SgSymbol *sp) const {
  return p_symbolSet.find(const_cast<SgSymbol *>(sp)) != p_symbolSet.end();
}

bool SgSymbolTable::exists(const SgName &nm, SgSymbol *sp) const {
  if (p_symbolSet.find(sp) == p_symbolSet.end())
    return false;
  const auto range = p_table->equal_range(nm);
  for (auto it = range.first; it != range.second; ++it)
    if (it->second == sp)
      return true;
  return false;
}

SgSymbol *
SgSymbolTable::find_any(const SgName &nm,
                        SgTemplateParameterPtrList *templateParameterList,
                        SgTemplateArgumentPtrList *templateArgumentList) {
  bool filterTemplateSymbols = false;
  return find_symbol_with_type_support<SgSymbol>(
      nm, NULL, templateParameterList, templateArgumentList,
      filterTemplateSymbols);
}

SgSymbol *SgSymbolTable::find_for_name_qualification(
    const SgName &nm, VariantT requestedSymbolKind, const SgType *type,
    SgTemplateParameterPtrList *templateParameterList,
    SgTemplateArgumentPtrList *templateArgumentList,
    const SgUnorderedNodeSet &visibleAliasCausalNodes, bool searchBaseClasses) {
  bool filterTemplateSymbols = false;
  switch (requestedSymbolKind) {
  case V_SgSymbol:
    return find_symbol_with_type_support<SgSymbol>(
        nm, type, templateParameterList, templateArgumentList,
        filterTemplateSymbols, &visibleAliasCausalNodes, searchBaseClasses);
  case V_SgVariableSymbol:
    return find_symbol_with_type_support<SgVariableSymbol>(
        nm, NULL, NULL, NULL, filterTemplateSymbols, &visibleAliasCausalNodes,
        searchBaseClasses);
  case V_SgClassSymbol:
    return find_symbol_with_type_support<SgClassSymbol>(
        nm, NULL, NULL, templateArgumentList, true, &visibleAliasCausalNodes,
        searchBaseClasses);
  case V_SgFunctionSymbol:
    return find_symbol_with_type_support<SgFunctionSymbol>(
        nm, type, NULL, templateArgumentList, filterTemplateSymbols,
        &visibleAliasCausalNodes, searchBaseClasses);
  case V_SgTypedefSymbol:
    return find_symbol_with_type_support<SgTypedefSymbol>(
        nm, NULL, NULL, NULL, filterTemplateSymbols, &visibleAliasCausalNodes,
        searchBaseClasses);
  case V_SgTemplateTypedefSymbol:
    return find_symbol_with_type_support<SgTemplateTypedefSymbol>(
        nm, NULL, templateParameterList, templateArgumentList,
        filterTemplateSymbols, &visibleAliasCausalNodes, searchBaseClasses);
  case V_SgEnumSymbol:
    return find_symbol_with_type_support<SgEnumSymbol>(
        nm, NULL, NULL, NULL, filterTemplateSymbols, &visibleAliasCausalNodes,
        searchBaseClasses);
  case V_SgEnumFieldSymbol:
    return find_symbol_with_type_support<SgEnumFieldSymbol>(
        nm, NULL, NULL, NULL, filterTemplateSymbols, &visibleAliasCausalNodes,
        searchBaseClasses);
  case V_SgNamespaceSymbol:
    return find_symbol_with_type_support<SgNamespaceSymbol>(
        nm, NULL, NULL, NULL, filterTemplateSymbols, &visibleAliasCausalNodes,
        searchBaseClasses);
  case V_SgTemplateClassSymbol:
    return find_symbol_with_type_support<SgTemplateClassSymbol>(
        nm, NULL, templateParameterList, templateArgumentList,
        filterTemplateSymbols, &visibleAliasCausalNodes, searchBaseClasses);
  case V_SgNonrealSymbol:
    return find_symbol_with_type_support<SgNonrealSymbol>(
        nm, NULL, templateParameterList, templateArgumentList,
        filterTemplateSymbols, &visibleAliasCausalNodes, searchBaseClasses);
  default:
    fprintf(stderr,
            "REX_NAME_QUALIFICATION_INVARIANT[symbol-kind]: unsupported "
            "explicit symbol kind\n");
    fprintf(stderr,
            "REX_NAME_QUALIFICATION_DETAIL[symbol-kind]: name=%s "
            "unsupported explicit symbol kind=%d\n",
            nm.str(), static_cast<int>(requestedSymbolKind));
    ROSE_ABORT();
  }
}

SgSymbol *SgSymbolTable::find_for_ast_copy_fixup(
    const SgName &nm, VariantT requestedSymbolKind, const SgType *type,
    SgTemplateParameterPtrList *templateParameterList,
    SgTemplateArgumentPtrList *templateArgumentList) {
  bool filterTemplateSymbols = false;
  const SgUnorderedNodeSet *visibleAliasCausalNodes = NULL;
  bool searchBaseClasses = true;
  switch (requestedSymbolKind) {
  case V_SgSymbol:
    return find_symbol_with_type_support<SgSymbol>(
        nm, type, templateParameterList, templateArgumentList,
        filterTemplateSymbols, visibleAliasCausalNodes, searchBaseClasses);
  case V_SgVariableSymbol:
    return find_symbol_with_type_support<SgVariableSymbol>(
        nm, NULL, NULL, NULL, filterTemplateSymbols, visibleAliasCausalNodes,
        searchBaseClasses);
  case V_SgClassSymbol:
    return find_symbol_with_type_support<SgClassSymbol>(
        nm, NULL, NULL, templateArgumentList, true, visibleAliasCausalNodes,
        searchBaseClasses);
  case V_SgFunctionSymbol:
    return find_symbol_with_type_support<SgFunctionSymbol>(
        nm, type, NULL, templateArgumentList, filterTemplateSymbols,
        visibleAliasCausalNodes, searchBaseClasses);
  case V_SgTypedefSymbol:
    return find_symbol_with_type_support<SgTypedefSymbol>(
        nm, NULL, NULL, NULL, filterTemplateSymbols, visibleAliasCausalNodes,
        searchBaseClasses);
  case V_SgEnumSymbol:
    return find_symbol_with_type_support<SgEnumSymbol>(
        nm, NULL, NULL, NULL, filterTemplateSymbols, visibleAliasCausalNodes,
        searchBaseClasses);
  case V_SgEnumFieldSymbol:
    return find_symbol_with_type_support<SgEnumFieldSymbol>(
        nm, NULL, NULL, NULL, filterTemplateSymbols, visibleAliasCausalNodes,
        searchBaseClasses);
  case V_SgNamespaceSymbol:
    return find_symbol_with_type_support<SgNamespaceSymbol>(
        nm, NULL, NULL, NULL, filterTemplateSymbols, visibleAliasCausalNodes,
        searchBaseClasses);
  case V_SgTemplateClassSymbol:
    return find_symbol_with_type_support<SgTemplateClassSymbol>(
        nm, NULL, templateParameterList, templateArgumentList,
        filterTemplateSymbols, visibleAliasCausalNodes, searchBaseClasses);
  default:
    fprintf(stderr, "REX_AST_INVARIANT[copy-fixup-symbol-kind]: unsupported "
                    "explicit symbol kind\n");
    ROSE_ABORT();
  }
}

SgTypedefSymbol *SgSymbolTable::find_typedef(const SgName &nm) {
  bool filterTemplateSymbols = false;
  return find_symbol_with_type_support<SgTypedefSymbol>(nm, NULL, NULL, NULL,
                                                        filterTemplateSymbols);
}

SgEnumSymbol *SgSymbolTable::find_enum(const SgName &nm) {
  bool filterTemplateSymbols = false;
  return find_symbol_with_type_support<SgEnumSymbol>(nm, NULL, NULL, NULL,
                                                     filterTemplateSymbols);
}

SgEnumFieldSymbol *SgSymbolTable::find_enum_field(const SgName &nm) {
  bool filterTemplateSymbols = false;
  return find_symbol_with_type_support<SgEnumFieldSymbol>(
      nm, NULL, NULL, NULL, filterTemplateSymbols);
}

SgVariableSymbol *SgSymbolTable::find_variable(const SgName &nm) {
  bool filterTemplateSymbols = false;
  return find_symbol_with_type_support<SgVariableSymbol>(nm, NULL, NULL, NULL,
                                                         filterTemplateSymbols);
}

SgClassSymbol *SgSymbolTable::find_class(const SgName &nm) {
  bool filterTemplateSymbols = true;
  SgClassSymbol *s = find_symbol_with_type_support<SgClassSymbol>(
      nm, NULL, NULL, NULL, filterTemplateSymbols);
  ROSE_ASSERT(isSgTemplateClassSymbol(s) == NULL);
  return s;
}

SgClassSymbol *SgSymbolTable::find_class_instantiation(
    SgTemplateClassDeclaration *primary,
    const SgTemplateArgumentPtrList &semanticArguments) const {
  if (p_table == nullptr || primary == nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[class-instantiation-lookup]: symbol table "
            "and primary template are required\n");
    ROSE_ABORT();
  }
  SgClassSymbol *found = nullptr;
  // Frontend completion and AST copying can change a published
  // instantiation's primary or complete arguments, so inspect current edges.
  for (const auto &entry : *p_table) {
    SgClassSymbol *symbol = isSgClassSymbol(entry.second);
    SgTemplateInstantiationDecl *declaration =
        symbol != nullptr
            ? isSgTemplateInstantiationDecl(symbol->get_declaration())
            : nullptr;
    if (declaration == nullptr ||
        declaration->get_templateDeclaration() != primary ||
        !SageInterface::templateArgumentListEquivalence(
            declaration->get_semanticTemplateArguments(), semanticArguments)) {
      continue;
    }
    if (found != nullptr && found != symbol) {
      fprintf(stderr,
              "REX_AST_INVARIANT[class-instantiation-lookup]: primary=%p "
              "has duplicate symbols=%p/%p for the same semantic arguments\n",
              static_cast<void *>(primary), static_cast<void *>(found),
              static_cast<void *>(symbol));
      ROSE_ABORT();
    }
    found = symbol;
  }
  return found;
}

bool SgSymbolTable::
    hasMatchingTemplateParametersArgumentsOrNoTemplateParametersArguments(
        SgTemplateParameterPtrList *templateParameterList,
        SgTemplateArgumentPtrList *templateArgumentsList, SgSymbol *symbol) {
  if (templateParameterList == nullptr) {
    return hasMatchingTemplateArgumentsOrNoTemplateArguments(
        templateArgumentsList, symbol);
  }
  if (!hasMatchingTemplateParametersOrNoTemplateParameters(
          templateParameterList, symbol)) {
    return false;
  }
  if (templateArgumentsList != nullptr &&
      (isSgTemplateClassSymbol(symbol) != nullptr ||
       isSgTemplateVariableSymbol(symbol) != nullptr)) {
    return hasMatchingTemplateArgumentsOrNoTemplateArguments(
        templateArgumentsList, symbol);
  }
  return true;
}

bool SgSymbolTable::hasMatchingTemplateParametersOrNoTemplateParameters(
    SgTemplateParameterPtrList *templateParameterList, SgSymbol *symbol) {

  return hasMatchingTemplateParametersOrArgumentsOrNoTemplateParametersOrArguments<
      SgTemplateParameter>(templateParameterList, symbol);
}

bool SgSymbolTable::hasMatchingTemplateArgumentsOrNoTemplateArguments(
    SgTemplateArgumentPtrList *templateArgumentsList, SgSymbol *symbol) {

  return hasMatchingTemplateParametersOrArgumentsOrNoTemplateParametersOrArguments<
      SgTemplateArgument>(templateArgumentsList, symbol);
}

template <class T>
std::vector<T *>
getTemplateParametersOrArgumentsList(SgSymbol *symbol) = delete;

template <>
std::vector<SgTemplateArgument *>
getTemplateParametersOrArgumentsList<SgTemplateArgument>(SgSymbol *symbol) {
  std::vector<SgTemplateArgument *> returnList;

  ROSE_ASSERT(symbol != NULL);
  switch (symbol->variantT()) {
  case V_SgClassSymbol: {
    SgClassSymbol *classSymbol = isSgClassSymbol(symbol);
    ROSE_ASSERT(classSymbol != NULL);

    SgClassDeclaration *classDeclaration = classSymbol->get_declaration();
    ROSE_ASSERT(classDeclaration != NULL);
    SgTemplateInstantiationDecl *templateClassInstantiation =
        isSgTemplateInstantiationDecl(classDeclaration);
    if (templateClassInstantiation != NULL) {
      returnList = templateClassInstantiation->get_semanticTemplateArguments();
    }
    break;
  }

  case V_SgFunctionSymbol: {
    SgFunctionSymbol *functionSymbol = isSgFunctionSymbol(symbol);
    ROSE_ASSERT(functionSymbol != NULL);

    SgFunctionDeclaration *functionDeclaration =
        functionSymbol->get_declaration();
    ROSE_ASSERT(functionDeclaration != NULL);
    SgTemplateInstantiationFunctionDecl *templateFunctionInstantiation =
        isSgTemplateInstantiationFunctionDecl(functionDeclaration);
    if (templateFunctionInstantiation != NULL) {
      returnList =
          templateFunctionInstantiation->get_deducedTemplateArguments();
    }
    break;
  }

  case V_SgMemberFunctionSymbol: {
    SgMemberFunctionSymbol *memberFunctionSymbol =
        isSgMemberFunctionSymbol(symbol);
    ROSE_ASSERT(memberFunctionSymbol != NULL);

    SgMemberFunctionDeclaration *memberFunctionDeclaration =
        memberFunctionSymbol->get_declaration();
    ROSE_ASSERT(memberFunctionDeclaration != NULL);
    SgTemplateInstantiationMemberFunctionDecl
        *templateMemberFunctionInstantiation =
            isSgTemplateInstantiationMemberFunctionDecl(
                memberFunctionDeclaration);
    if (templateMemberFunctionInstantiation != NULL) {
      returnList =
          templateMemberFunctionInstantiation->get_deducedTemplateArguments();
    }
    break;
  }

  case V_SgTemplateClassSymbol: {
    SgTemplateClassSymbol *templateClassSymbol =
        isSgTemplateClassSymbol(symbol);
    ROSE_ASSERT(templateClassSymbol != NULL);

    ROSE_ASSERT(templateClassSymbol->get_declaration() != NULL);

    SgTemplateClassDeclaration *templateClassDeclaration =
        isSgTemplateClassDeclaration(templateClassSymbol->get_declaration());

    ROSE_ASSERT(templateClassDeclaration != NULL);
    returnList =
        templateClassDeclaration->get_templateSpecializationArguments();
    break;
  }

  case V_SgTemplateVariableSymbol: {
    SgTemplateVariableSymbol *vsym = isSgTemplateVariableSymbol(symbol);
    ROSE_ASSERT(vsym != NULL);

    SgInitializedName *iname = vsym->get_declaration();
    ROSE_ASSERT(iname != NULL);

    SgTemplateVariableDeclaration *tplvdecl =
        isSgTemplateVariableDeclaration(iname->get_parent());
    ROSE_ASSERT(tplvdecl != NULL);

    returnList = tplvdecl->get_semanticTemplateArguments();
    break;
  }

  case V_SgTemplateTypedefSymbol: {
    SgTemplateTypedefSymbol *templateTypedefSymbol =
        isSgTemplateTypedefSymbol(symbol);
    ROSE_ASSERT(templateTypedefSymbol != NULL);

    ROSE_ASSERT(templateTypedefSymbol->get_declaration() != NULL);

    if (auto *instantiation = isSgTemplateInstantiationTypedefDeclaration(
            templateTypedefSymbol->get_declaration())) {
      return instantiation->get_templateArguments();
    }
    SgTemplateTypedefDeclaration *templateTypedefDeclaration =
        isSgTemplateTypedefDeclaration(
            templateTypedefSymbol->get_declaration());

    ROSE_ASSERT(templateTypedefDeclaration != NULL);
    returnList =
        templateTypedefDeclaration->get_templateSpecializationArguments();
    break;
  }

  case V_SgLabelSymbol:
  case V_SgVariableSymbol:
  case V_SgTypedefSymbol:
  case V_SgEnumSymbol:
  case V_SgEnumFieldSymbol:
  case V_SgNamespaceSymbol: {
    // This function requires this case so that it can be called within very
    // general contexts. However, for this case we only return the empty
    // template parameter list.

    break;
  }

  case V_SgNonrealSymbol: {
    SgNonrealSymbol *nrsym = isSgNonrealSymbol(symbol);
    ROSE_ASSERT(nrsym != NULL);
    SgNonrealDecl *nrdecl = isSgNonrealDecl(nrsym->get_declaration());
    ROSE_ASSERT(nrdecl != NULL);
    returnList = nrdecl->get_tpl_args();
    break;
  }

  case V_SgTemplateSymbol: {
    SgTemplateSymbol *tmplSymbol = isSgTemplateSymbol(symbol);
    ROSE_ASSERT(tmplSymbol != NULL);

    SgTemplateDeclaration *tmplDecl = tmplSymbol->get_declaration();
    ROSE_ASSERT(tmplDecl != NULL);

    // SgTemplateDeclaration does not carry specialization arguments.
    break;
  }

  default: {
    MLOG_ERROR_C("ROSETTA",
                 "Error: Default reached in "
                 "SgSymbolTable::getTemplateParametersOrArgumentsList<"
                 "SgTemplateArgument>(): symbol = %p = %s \n",
                 symbol, symbol->class_name().c_str());
    ROSE_ASSERT(false);
  }
  }

  return returnList;
}

template <>
std::vector<SgTemplateParameter *>
getTemplateParametersOrArgumentsList<SgTemplateParameter>(SgSymbol *symbol) {
  // Template specialization for handling template parameters.

  // DQ (8/11/2013): This function uses the STL copy operation and might have a
  // more efficient implementation.
  std::vector<SgTemplateParameter *> returnList;

  ROSE_ASSERT(symbol != NULL);

  switch (symbol->variantT()) {
  case V_SgTemplateClassSymbol: {
    SgTemplateClassSymbol *templateClassSymbol =
        isSgTemplateClassSymbol(symbol);
    ROSE_ASSERT(templateClassSymbol != NULL);

    SgClassDeclaration *classDeclaration =
        templateClassSymbol->get_declaration();
    ROSE_ASSERT(classDeclaration != NULL);
    SgTemplateClassDeclaration *templateClassDeclaration =
        isSgTemplateClassDeclaration(classDeclaration);
    ROSE_ASSERT(templateClassDeclaration != NULL);
    returnList = templateClassDeclaration->get_templateParameters();
    break;
  }

  case V_SgTemplateFunctionSymbol: {
    SgTemplateFunctionSymbol *templateFunctionSymbol =
        isSgTemplateFunctionSymbol(symbol);
    ROSE_ASSERT(templateFunctionSymbol != NULL);

    SgFunctionDeclaration *functionDeclaration =
        templateFunctionSymbol->get_declaration();
    ROSE_ASSERT(functionDeclaration != NULL);
    auto getTemplateParameters = [](SgFunctionDeclaration *candidate)
        -> const SgTemplateParameterPtrList * {
      if (candidate == NULL) {
        return NULL;
      }

      if (SgTemplateFunctionDeclaration *templateFunctionDeclaration =
              isSgTemplateFunctionDeclaration(candidate)) {
        return &(templateFunctionDeclaration->get_templateParameters());
      }

      if (SgTemplateInstantiationFunctionDecl *templateInstantiation =
              isSgTemplateInstantiationFunctionDecl(candidate)) {
        if (templateInstantiation->get_templateDeclaration() != NULL) {
          return &(templateInstantiation->get_templateDeclaration()
                       ->get_templateParameters());
        }
      }

      return NULL;
    };

    const SgTemplateParameterPtrList *templateParameters =
        getTemplateParameters(functionDeclaration);
    if (templateParameters == NULL) {
      templateParameters = getTemplateParameters(isSgFunctionDeclaration(
          functionDeclaration->get_firstNondefiningDeclaration()));
    }
    if (templateParameters == NULL) {
      templateParameters = getTemplateParameters(isSgFunctionDeclaration(
          functionDeclaration->get_definingDeclaration()));
    }

    if (templateParameters != NULL) {
      returnList = *templateParameters;
    } else {
      MLOG_ERROR_C("ROSETTA",
                   "Error: Default reached in "
                   "SgSymbolTable::getTemplateParametersOrArgumentsList<"
                   "SgTemplateParameter>(): symbol = %p = %s \n",
                   symbol, symbol->class_name().c_str());
      ROSE_ASSERT(false);
    }
    break;
  }

    // DQ (8/12/2013): Added case for SgTemplateMemberFunctionSymbol
  case V_SgTemplateMemberFunctionSymbol: {
    SgTemplateMemberFunctionSymbol *templateMemberFunctionSymbol =
        isSgTemplateMemberFunctionSymbol(symbol);
    ROSE_ASSERT(templateMemberFunctionSymbol != NULL);

    SgMemberFunctionDeclaration *memberFunctionDeclaration =
        templateMemberFunctionSymbol->get_declaration();
    ROSE_ASSERT(memberFunctionDeclaration != NULL);
    auto getTemplateParameters = [](SgMemberFunctionDeclaration *candidate)
        -> const SgTemplateParameterPtrList * {
      if (candidate == NULL) {
        return NULL;
      }

      if (SgTemplateMemberFunctionDeclaration
              *templateMemberFunctionDeclaration =
                  isSgTemplateMemberFunctionDeclaration(candidate)) {
        return &(templateMemberFunctionDeclaration->get_templateParameters());
      }

      if (SgTemplateInstantiationMemberFunctionDecl *templateInstantiation =
              isSgTemplateInstantiationMemberFunctionDecl(candidate)) {
        if (templateInstantiation->get_templateDeclaration() != NULL) {
          return &(templateInstantiation->get_templateDeclaration()
                       ->get_templateParameters());
        }
      }

      return NULL;
    };

    const SgTemplateParameterPtrList *templateParameters =
        getTemplateParameters(memberFunctionDeclaration);
    if (templateParameters == NULL) {
      templateParameters = getTemplateParameters(isSgMemberFunctionDeclaration(
          memberFunctionDeclaration->get_firstNondefiningDeclaration()));
    }
    if (templateParameters == NULL) {
      templateParameters = getTemplateParameters(isSgMemberFunctionDeclaration(
          memberFunctionDeclaration->get_definingDeclaration()));
    }

    if (templateParameters != NULL) {
      returnList = *templateParameters;
    } else {
      MLOG_ERROR_C("ROSETTA",
                   "Error: Default reached in "
                   "SgSymbolTable::getTemplateParametersOrArgumentsList<"
                   "SgTemplateParameter>(): symbol = %p = %s \n",
                   symbol, symbol->class_name().c_str());
      ROSE_ASSERT(false);
    }
    break;
  }

  case V_SgTemplateVariableSymbol: {
    SgTemplateVariableSymbol *vsym = isSgTemplateVariableSymbol(symbol);
    ROSE_ASSERT(vsym != NULL);

    SgInitializedName *iname = vsym->get_declaration();
    ROSE_ASSERT(iname != NULL);

    SgTemplateVariableDeclaration *tplvdecl =
        isSgTemplateVariableDeclaration(iname->get_parent());
    ROSE_ASSERT(tplvdecl != NULL);

    returnList = tplvdecl->get_templateParameters();
    break;
  }

  case V_SgTemplateTypedefSymbol: {
    auto *typedefSymbol = isSgTemplateTypedefSymbol(symbol);
    ROSE_ASSERT(typedefSymbol != nullptr);
    SgTypedefDeclaration *basis = typedefSymbol->get_declaration();
    if (auto *instantiation =
            isSgTemplateInstantiationTypedefDeclaration(basis)) {
      basis = instantiation->get_templateDeclaration();
    }
    auto *declaration = isSgTemplateTypedefDeclaration(basis);
    ROSE_ASSERT(declaration != nullptr);
    returnList = declaration->get_templateParameters();
    break;
  }
    // DQ (8/19/2013): Added case for other symbols (but we only return the
    // empty list for this case).
  case V_SgLabelSymbol:
  case V_SgClassSymbol:
  case V_SgVariableSymbol:
  case V_SgFunctionSymbol:
  case V_SgMemberFunctionSymbol:
  case V_SgTypedefSymbol:
  case V_SgEnumSymbol:
  case V_SgEnumFieldSymbol:
  case V_SgNamespaceSymbol: {
    // This function requires this case so that it can be called within very
    // general contexts. However, for this case we only return the empty
    // template parameter list.

    break;
  }

  case V_SgNonrealSymbol: {
    SgNonrealSymbol *nrsym = isSgNonrealSymbol(symbol);
    ROSE_ASSERT(nrsym != NULL);
    SgNonrealDecl *nrdecl = isSgNonrealDecl(nrsym->get_declaration());
    ROSE_ASSERT(nrdecl != NULL);
    returnList = nrdecl->get_tpl_params();
    break;
  }

  case V_SgTemplateSymbol: {
    SgTemplateSymbol *tmplSymbol = isSgTemplateSymbol(symbol);
    ROSE_ASSERT(tmplSymbol != NULL);

    SgTemplateDeclaration *tmplDecl = tmplSymbol->get_declaration();
    ROSE_ASSERT(tmplDecl != NULL);

    returnList = tmplDecl->get_templateParameters();
    break;
  }

  default: {
    MLOG_INFO_C("ROSETTA",
                "Exiting in "
                "SgSymbolTable::getTemplateParametersOrArgumentsList<"
                "SgTemplateParameter>(): symbol = %p = %s \n",
                symbol, symbol->class_name().c_str());
    ROSE_ASSERT(false);
  }
  }

  return returnList;
}

static bool exactTemplateSymbolIdentity(SgTemplateArgument *requested,
                                        SgTemplateArgument *existing) {
  return SageInterface::templateArgumentEquivalence(requested, existing);
}

static bool exactTemplateSymbolIdentity(SgTemplateParameter *requested,
                                        SgTemplateParameter *existing) {
  return SageInterface::templateParameterEquivalence(requested, existing);
}

template <class T>
bool SgSymbolTable::
    hasMatchingTemplateParametersOrArgumentsOrNoTemplateParametersOrArguments(
        std::vector<T *> *templateParametersOrArgumentsList, SgSymbol *symbol) {

  ROSE_ASSERT(symbol != NULL);

  // A null list is an intentional unfiltered lookup.  Once a caller supplies a
  // list, both cardinality and every parameter/argument identity must match.
  if (templateParametersOrArgumentsList == NULL) {
    return true;
  }

  std::vector<T *> symbolList = getTemplateParametersOrArgumentsList<T>(symbol);
  if (templateParametersOrArgumentsList->size() != symbolList.size()) {
    return false;
  }

  for (size_t index = 0; index < symbolList.size(); ++index) {
    T *requested = (*templateParametersOrArgumentsList)[index];
    T *existing = symbolList[index];
    if (requested == NULL || existing == NULL) {
      fprintf(stderr,
              "REX_AST_INVARIANT[template-symbol-identity]: symbol=%p "
              "type=%s contains a null template parameter or argument "
              "at index=%zu\n",
              static_cast<void *>(symbol), symbol->class_name().c_str(), index);
      ROSE_ABORT();
    }

    if (!exactTemplateSymbolIdentity(requested, existing)) {
      return false;
    }
  }

  return true;
}

