SOURCE_INCIDENCE_DIRECTED_GRAPH_START

void SgIncidenceDirectedGraph::post_construction_initialization() {
}

void SgIncidenceDirectedGraph::getSuccessors(
    const SgGraphNode *node, std::vector<SgGraphNode *> &vec) const {
  ROSE_ASSERT(node != nullptr);
  const rose_graph_integer_edge_hash_multimap &edges =
      get_node_index_to_edge_multimap_edgesOut();
  auto range = edges.equal_range(node->get_index());
  for (auto it = range.first; it != range.second; ++it) {
    SgDirectedGraphEdge *edge = isSgDirectedGraphEdge(it->second);
    ROSE_ASSERT(edge != nullptr);
    ROSE_ASSERT(edge->get_from() == node);
    SgGraphNode *target = edge->get_to();
    ROSE_ASSERT(target != nullptr);
    vec.push_back(target);
  }
}

void SgIncidenceDirectedGraph::getPredecessors(
    const SgGraphNode *node, std::vector<SgGraphNode *> &vec) const {
  ROSE_ASSERT(node != nullptr);
  const rose_graph_integer_edge_hash_multimap &edges =
      get_node_index_to_edge_multimap_edgesIn();
  auto range = edges.equal_range(node->get_index());
  for (auto it = range.first; it != range.second; ++it) {
    SgDirectedGraphEdge *edge = isSgDirectedGraphEdge(it->second);
    ROSE_ASSERT(edge != nullptr);
    ROSE_ASSERT(edge->get_to() == node);
    SgGraphNode *source = edge->get_from();
    ROSE_ASSERT(source != nullptr);
    vec.push_back(source);
  }
}

bool SgIncidenceDirectedGraph::checkIfDirectedGraphEdgeExists(
    SgGraphNode *src, SgGraphNode *trg) {
  ROSE_ASSERT(src != nullptr && trg != nullptr);

  const rose_graph_integer_edge_hash_multimap &edges =
      get_node_index_to_edge_multimap_edgesOut();
  auto range = edges.equal_range(src->get_index());
  for (auto it = range.first; it != range.second; ++it) {
    SgDirectedGraphEdge *edge = isSgDirectedGraphEdge(it->second);
    ROSE_ASSERT(edge != nullptr);
    if (edge->get_to() == trg)
      return true;
  }
  return false;
}

SOURCE_INCIDENCE_DIRECTED_GRAPH_END

SOURCE_NAME_GROUP_START
bool SgNameGroup::is_valid_group(const std::string &name,
                                 const SgVarRefExpPtrList &objects) {
  if (name.empty() || name.find('\0') != std::string::npos || objects.empty())
    return false;
  for (auto *reference : objects) {
    auto *symbol = reference != nullptr ? reference->get_symbol() : nullptr;
    auto *declaration = symbol != nullptr ? symbol->get_declaration() : nullptr;
    if (declaration == nullptr || declaration->get_type() == nullptr ||
        SageInterface::containsUnknownType(declaration->get_type()) ||
        std::count(objects.begin(), objects.end(), reference) != 1)
      return false;
  }
  return true;
}

void SgNameGroup::post_construction_initialization() {
  ROSE_ASSERT(is_valid_group(p_group_name, p_objects));
  for (auto *reference : p_objects)
    ROSE_ASSERT(reference->get_parent() == nullptr);
  for (auto *reference : p_objects)
    reference->set_parent(this);
}

void SgNameGroup::validate_group() const {
  ROSE_ASSERT(is_valid_group(p_group_name, p_objects));
  for (auto *reference : p_objects)
    ROSE_ASSERT(reference->get_parent() == this);
}

SOURCE_NAME_GROUP_END

SOURCE_DATA_STATEMENT_GROUP_START

bool SgDataStatementGroup::is_valid_group(
    const SgDataStatementObjectPtrList &objects,
    const SgDataStatementValuePtrList &values) {
  if (objects.empty() || !SgDataStatementValue::is_valid_values(values))
    return false;
  std::set<SgDataStatementObject *> seen;
  for (auto *object : objects)
    if (object == nullptr || !seen.insert(object).second ||
        !SgDataStatementObject::is_valid_object(
            object->get_variableReference_list()))
      return false;
  return true;
}

void SgDataStatementGroup::post_construction_initialization() {
  SgSupport::post_construction_initialization();
  ROSE_ASSERT(is_valid_group(p_object_list, p_value_list));
  for (auto *object : p_object_list)
    ROSE_ASSERT(object->get_parent() == nullptr);
  for (auto *value : p_value_list)
    ROSE_ASSERT(value->get_parent() == nullptr);
  for (auto *object : p_object_list)
    object->set_parent(this);
  for (auto *value : p_value_list)
    value->set_parent(this);
}

void SgDataStatementGroup::validate_group() const {
  ROSE_ASSERT(is_valid_group(p_object_list, p_value_list));
  for (auto *object : p_object_list) {
    ROSE_ASSERT(object->get_parent() == this);
    object->validate_object();
  }
  for (auto *value : p_value_list) {
    ROSE_ASSERT(value->get_parent() == this);
    value->validate_value();
  }
}

SOURCE_DATA_STATEMENT_GROUP_END

SOURCE_DATA_STATEMENT_OBJECT_START
bool SgDataStatementObject::is_valid_object(SgExprListExp *expressions) {
  if (expressions == nullptr || expressions->get_expressions().empty())
    return false;
  std::set<SgExpression *> seen;
  for (auto *expression : expressions->get_expressions())
    if (expression == nullptr || !seen.insert(expression).second ||
        expression->get_parent() != expressions)
      return false;
  return true;
}

void SgDataStatementObject::post_construction_initialization() {
  SgSupport::post_construction_initialization();
  ROSE_ASSERT(is_valid_object(p_variableReference_list));
  ROSE_ASSERT(p_variableReference_list->get_parent() == nullptr);
  p_variableReference_list->set_parent(this);
}

void SgDataStatementObject::validate_object() const {
  ROSE_ASSERT(is_valid_object(p_variableReference_list));
  ROSE_ASSERT(p_variableReference_list->get_parent() == this);
}
SOURCE_DATA_STATEMENT_OBJECT_END

SOURCE_DATA_STATEMENT_VALUE_START

bool SgDataStatementValue::is_valid_value(SgExpression *constant,
                                          SgExpression *repeat) {
  if (constant == nullptr || constant == repeat ||
      isSgExprListExp(constant) != nullptr || constant->get_type() == nullptr ||
      SageInterface::containsUnknownType(constant->get_type()))
    return false;
  if (repeat == nullptr)
    return true;
  return isSgExprListExp(repeat) == nullptr && repeat->get_type() != nullptr &&
         repeat->get_type()->isIntegerType() &&
         repeat->get_fortran_integer_constant_value_is_available() &&
         repeat->get_fortran_integer_constant_value() >= 0;
}

bool SgDataStatementValue::is_valid_values(
    const SgDataStatementValuePtrList &values) {
  if (values.empty())
    return false;
  std::set<SgDataStatementValue *> seen;
  for (auto *value : values)
    if (value == nullptr || !seen.insert(value).second ||
        !is_valid_value(value->get_constant_expression(),
                        value->get_repeat_expression()))
      return false;
  return true;
}

void SgDataStatementValue::post_construction_initialization() {
  SgSupport::post_construction_initialization();
  ROSE_ASSERT(is_valid_value(p_constant_expression, p_repeat_expression));
  ROSE_ASSERT(p_constant_expression->get_parent() == nullptr);
  ROSE_ASSERT(p_repeat_expression == nullptr ||
              p_repeat_expression->get_parent() == nullptr);
  p_constant_expression->set_parent(this);
  if (p_repeat_expression != nullptr)
    p_repeat_expression->set_parent(this);
}

void SgDataStatementValue::validate_value() const {
  ROSE_ASSERT(is_valid_value(p_constant_expression, p_repeat_expression));
  ROSE_ASSERT(p_constant_expression->get_parent() == this);
  ROSE_ASSERT(p_repeat_expression == nullptr ||
              p_repeat_expression->get_parent() == this);
}

SOURCE_DATA_STATEMENT_VALUE_END

SOURCE_FORMAT_ITEM_START
bool SgFormatItem::is_valid_descriptor(const Descriptor &descriptor,
                                       std::optional<std::uint64_t> repeat,
                                       bool has_group) {
  if (repeat && *repeat == 0)
    return false;
  const auto &value = descriptor.value;
  const auto *group = std::get_if<Group>(&value);
  if (has_group != (group != nullptr))
    return false;
  if (group != nullptr)
    return *group == Group::nested || (*group == Group::unlimited && !repeat);
  if (const auto *intrinsic = std::get_if<Intrinsic>(&value)) {
    using Kind = Intrinsic::Kind;
    const auto kind = intrinsic->kind;
    if (kind < Kind::I || kind > Kind::D ||
        (intrinsic->width && *intrinsic->width < 0) ||
        (intrinsic->digits && *intrinsic->digits < 0) ||
        (intrinsic->exponent_width && *intrinsic->exponent_width < 0))
      return false;
    if (kind == Kind::A || kind == Kind::L)
      return (kind == Kind::A || intrinsic->width) &&
             (kind == Kind::L || !intrinsic->width || *intrinsic->width > 0) &&
             !intrinsic->digits && !intrinsic->exponent_width;
    const bool integer = kind == Kind::I || kind == Kind::B ||
                         kind == Kind::O || kind == Kind::Z;
    const bool exponent = kind == Kind::E || kind == Kind::EN ||
                          kind == Kind::ES || kind == Kind::EX ||
                          kind == Kind::G;
    return intrinsic->width &&
           (integer || (kind == Kind::G && *intrinsic->width == 0) ||
            intrinsic->digits) &&
           (kind != Kind::G || *intrinsic->width != 0 ||
            !intrinsic->exponent_width) &&
           (exponent || !intrinsic->exponent_width) &&
           (!intrinsic->exponent_width || intrinsic->digits);
  }
  const auto valid_character = [](const Character &character, bool tag) {
    using Delimiter = Character::Delimiter;
    return character.delimiter == Delimiter::single_quote ||
           character.delimiter == Delimiter::double_quote ||
           (!tag && !character.value.empty() &&
            (character.delimiter == Delimiter::hollerith_upper ||
             character.delimiter == Delimiter::hollerith_lower));
  };
  if (const auto *derived = std::get_if<Derived>(&value))
    return !derived->tag || valid_character(*derived->tag, true);
  if (const auto *character = std::get_if<Character>(&value))
    return !repeat && valid_character(*character, false);
  const auto *control = std::get_if<Control>(&value);
  if (control == nullptr || repeat)
    return false;
  using Kind = Control::Kind;
  switch (control->kind) {
  case Kind::T:
  case Kind::TL:
  case Kind::TR:
  case Kind::X:
  case Kind::Slash:
    return control->count > 0;
  case Kind::P:
    return true;
  case Kind::Colon:
  case Kind::SS:
  case Kind::SP:
  case Kind::S:
  case Kind::BN:
  case Kind::BZ:
  case Kind::RU:
  case Kind::RD:
  case Kind::RZ:
  case Kind::RN:
  case Kind::RC:
  case Kind::RP:
  case Kind::DC:
  case Kind::DP:
  case Kind::Dollar:
  case Kind::Backslash:
    return control->count == 1;
  }
  return false;
}

void SgFormatItem::post_construction_initialization() {
  SgSupport::post_construction_initialization();
  if (p_format_item_list != nullptr) {
    ROSE_ASSERT(p_format_item_list->get_parent() == nullptr);
    p_format_item_list->set_parent(this);
  }
  validate();
}

void SgFormatItem::validate() const {
  ROSE_ASSERT(is_valid_descriptor(p_descriptor, p_repeat_count,
                                  p_format_item_list != nullptr));
  if (p_format_item_list != nullptr) {
    ROSE_ASSERT(p_format_item_list->get_parent() == this);
    ROSE_ASSERT(!p_format_item_list->get_format_item_list().empty());
    p_format_item_list->validate();
    if (std::get<Group>(p_descriptor.value) == Group::unlimited)
      ROSE_ASSERT(p_format_item_list->contains_data_edit());
    for (auto *child : p_format_item_list->get_format_item_list())
      ROSE_ASSERT(
          std::get_if<Group>(&child->get_descriptor().value) == nullptr ||
          std::get<Group>(child->get_descriptor().value) != Group::unlimited);
  }
}
SOURCE_FORMAT_ITEM_END

SOURCE_FORMAT_ITEM_LIST_START

const SgFormatItemPtrList &SgFormatItemList::get_format_item_list() const {
  return p_format_item_list;
}

bool SgFormatItemList::contains_data_edit() const {
  for (const auto *item : p_format_item_list) {
    const auto &value = item->get_descriptor().value;
    if (std::holds_alternative<SgFormatItem::Intrinsic>(value) ||
        std::holds_alternative<SgFormatItem::Derived>(value) ||
        (item->get_format_item_list() != nullptr &&
         item->get_format_item_list()->contains_data_edit()))
      return true;
  }
  return false;
}

void SgFormatItemList::post_construction_initialization() {
  SgSupport::post_construction_initialization();
  std::unordered_set<SgFormatItem *> seen;
  for (auto *item : p_format_item_list) {
    ASSERT_not_null(item);
    ROSE_ASSERT(seen.insert(item).second && item->get_parent() == nullptr);
    item->set_parent(this);
  }
  validate();
}

void SgFormatItemList::validate() const {
  std::unordered_set<SgFormatItem *> seen;
  for (std::size_t index = 0; index < p_format_item_list.size(); ++index) {
    auto *item = p_format_item_list[index];
    ASSERT_not_null(item);
    ROSE_ASSERT(seen.insert(item).second && item->get_parent() == this);
    item->validate();
    const auto *group =
        std::get_if<SgFormatItem::Group>(&item->get_descriptor().value);
    ROSE_ASSERT(group == nullptr || *group != SgFormatItem::Group::unlimited ||
                index + 1 == p_format_item_list.size());
  }
}

SOURCE_FORMAT_ITEM_LIST_END

SOURCE_OPENCL_ACCESS_MODE_MODIFIER_START

// Copy constructor
$CLASSNAME::$CLASSNAME(const $CLASSNAME &X) : SgModifier() {
  p_modifier = X.p_modifier;
}

$CLASSNAME &$CLASSNAME::operator=(const $CLASSNAME &X) {
  p_modifier = X.p_modifier;
  return *this;
}

void $CLASSNAME::post_construction_initialization() { p_modifier = e_default; }

bool $CLASSNAME::isUnknown() const { return p_modifier == e_unknown; }
void $CLASSNAME::setUnknown() { p_modifier = e_unknown; }

bool $CLASSNAME::isDefault() const { return p_modifier == e_default; }
void $CLASSNAME::setDefault() { p_modifier = e_default; }

bool $CLASSNAME::isReadOnly() const { return p_modifier == e_read_only; }
void $CLASSNAME::setReadOnly() { p_modifier = e_read_only; }

bool $CLASSNAME::isWriteOnly() const { return p_modifier == e_write_only; }
void $CLASSNAME::setWriteOnly() { p_modifier = e_write_only; }

bool $CLASSNAME::isReadWrite() const { return p_modifier == e_read_write; }
void $CLASSNAME::setReadWrite() { p_modifier = e_read_write; }

std::ostream &operator<<(std::ostream &os, const $CLASSNAME &m) {
  os << m.get_modifier();
  return os;
}

string $CLASSNAME::displayString() const {
  std::string s = "$CLASSNAME(";
  s += std::string("isUnknown() = ") +
       std::string(isUnknown() ? "true " : "false ");
  s += std::string("isDefault() = ") +
       std::string(isDefault() ? "true " : "false ");
  s += std::string("isReadOnly() = ") +
       std::string(isReadOnly() ? "true " : "false ");
  s += std::string("isWriteOnly() = ") +
       std::string(isWriteOnly() ? "true " : "false ");
  s += std::string("isReadWrite() = ") +
       std::string(isReadWrite() ? "true " : "false ");
  s += ")";
  return s;
}

void $CLASSNAME::display(std::string label) const {
  // DQ (6/25/2020): If we call display, then we mean for it to be displayed,
  // not hidden.
  printf("In $CLASSNAME::display(%s) \n", label.c_str());
  printf("%s \n", displayString().c_str());
}

SOURCE_OPENCL_ACCESS_MODE_MODIFIER_END

SOURCE_TYPE_TABLE_START

SgTypeTable::SgTypeTable() {
  p_type_table = new SgSymbolTable(1001);
  ROSE_ASSERT(p_type_table != NULL);

  p_type_table->set_parent(this);
}

void SgTypeTable::insert_type(const SgName &n, SgType *t) {
  ROSE_ASSERT(p_type_table != NULL);
  ROSE_ASSERT(t != NULL);

  auto symbol = std::make_unique<SgFunctionTypeSymbol>(n, t);
  p_type_table->insert(n, symbol.get());
  t->set_parent(symbol.release());
}

void SgTypeTable::remove_type(const SgName &n) {
  ROSE_ASSERT(p_type_table != NULL);
  p_type_table->remove_function_type(n);
}

SgType *SgTypeTable::lookup_type(const SgName &n) {

  ROSE_ASSERT(p_type_table != NULL);

  SgSymbol *symbol = p_type_table->find_function_type(n);

  SgFunctionTypeSymbol *fsymb = isSgFunctionTypeSymbol(symbol);

  SgType *returnType = NULL;

  if (fsymb != NULL) {
    returnType = fsymb->get_type();
    ROSE_ASSERT(returnType != NULL);
  }

  return returnType;
}

SOURCE_TYPE_TABLE_END

HEADER_INCLUDE_FILE_START

public:
void validateIncludeOwnership() const;

HEADER_INCLUDE_FILE_END

SOURCE_INCLUDE_FILE_START

void SgIncludeFile::validateIncludeOwnership() const {
  ROSE_ASSERT(p_source_file != nullptr &&
              p_source_file_of_translation_unit != nullptr &&
              p_including_source_file != nullptr);
  if (p_parent_include_file == nullptr) {
    ROSE_ASSERT(p_isRootSourceFile && get_parent() == p_source_file &&
                p_source_file_of_translation_unit == p_source_file &&
                p_including_source_file == p_source_file &&
                p_source_file->get_associated_include_file() == this);
  } else {
    ROSE_ASSERT(
        !p_isRootSourceFile && get_parent() == p_parent_include_file &&
        p_source_file_of_translation_unit ==
            p_parent_include_file->get_source_file_of_translation_unit() &&
        p_including_source_file == p_parent_include_file->get_source_file());
  }
  std::set<const SgIncludeFile *> children;
  for (const SgIncludeFile *child : p_include_file_list) {
    ROSE_ASSERT(child != nullptr && children.insert(child).second &&
                child->get_parent() == this &&
                child->get_parent_include_file() == this);
  }
}

SOURCE_INCLUDE_FILE_END

HEADER_ALIGNMENT_SPECIFIER_START
public:
  enum spelling_enum {
    e_unspecified,
    e_gnu,
    e_cxx11_gnu,
    e_c23_gnu,
    e_declspec,
    e_alignas,
    e_Alignas
  };
  SgExpression *get_operand() const;
  void validate() const;
  void post_construction_initialization() override;
HEADER_ALIGNMENT_SPECIFIER_END

SOURCE_ALIGNMENT_SPECIFIER_START
SgExpression *$CLASSNAME::get_operand() const { return p_operand; }

void $CLASSNAME::validate() const {
  ROSE_ASSERT(p_spelling >= e_gnu && p_spelling <= e_Alignas);
  const bool is_gnu = p_spelling == e_gnu || p_spelling == e_cxx11_gnu ||
                      p_spelling == e_c23_gnu;
  ROSE_ASSERT(p_operand != nullptr || is_gnu);
  ROSE_ASSERT(!p_is_pack_expansion || p_spelling == e_alignas);
  if (p_operand != nullptr) {
    ROSE_ASSERT(p_operand->get_parent() == nullptr ||
                p_operand->get_parent() == this);
    const auto *type_operand = isSgTypeExpression(p_operand);
    SgType *type = type_operand != nullptr
                       ? type_operand->get_represented_type()
                       : p_operand->get_type();
    ROSE_ASSERT(type != nullptr && !isSgTypeUnknown(type) &&
                !isSgTypeDefault(type));
    if (type_operand != nullptr)
      ROSE_ASSERT(p_spelling == e_alignas || p_spelling == e_Alignas);
  }
}

void $CLASSNAME::post_construction_initialization() {
  validate();
  if (p_operand != nullptr)
    p_operand->set_parent(this);
}
SOURCE_ALIGNMENT_SPECIFIER_END
