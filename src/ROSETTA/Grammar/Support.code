  return p_classificationBitField;
}

void Sg_File_Info::set_classificationBitField(unsigned int bitflags) {
  p_classificationBitField = bitflags;
}

const string &Sg_File_Info::getFilenameFromID(int id) {
  switch (id) {
  case NULL_FILE_ID: {
    static const std::string null_file_string = "NULL_FILE";
    return null_file_string;
  }
  case COPY_FILE_ID: {
    static const std::string copy_file_string = "COPY";
    return copy_file_string;
  }
  case TRANSFORMATION_FILE_ID: {
    static const std::string transformation_string = "transformation";
    return transformation_string;
  }
  case COMPILER_GENERATED_FILE_ID: {
    static const std::string compilerGenerated_string = "compilerGenerated";
    return compilerGenerated_string;
  }
  case COMPILER_GENERATED_MARKED_FOR_OUTPUT_FILE_ID: {
    fprintf(stderr,
            "REX_AST_INVARIANT[file-info-id]: compiler-generated output ID "
            "%d has no filename\n",
            id);
    ROSE_ABORT();
  }
  case BAD_FILE_ID: {
    static const std::string badfile_string = "badfile";
    return badfile_string;
  }

  default: {
    auto found = p_fileidtoname_map.find(id);
    if (found == p_fileidtoname_map.end()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[file-info-id]: file ID %d has no registered "
              "filename\n",
              id);
      ROSE_ABORT();
    }
    return found->second;
  }
  }
}

int Sg_File_Info::getIDFromFilename(std::string filename) {
  auto found = p_nametofileid_map.find(filename);
  if (found == p_nametofileid_map.end()) {
    return BAD_FILE_ID;
  }
  return found->second;
}

std::map<int, std::string> &Sg_File_Info::get_fileidtoname_map() {
  return p_fileidtoname_map;
}

void Sg_File_Info::set_fileidtoname_map(std::map<int, std::string> &X) {
  p_fileidtoname_map = X;
}

std::map<std::string, int> &Sg_File_Info::get_nametofileid_map() {
  return p_nametofileid_map;
}

// DQ (2/24/2010): These are static access functions where previously the
// ROSETTA generated ones were not static functions.
void Sg_File_Info::set_nametofileid_map(std::map<std::string, int> &X) {
  p_nametofileid_map = X;
}

