enum constant_folding_enum : std::uint8_t {
  e_original_expressions_only = 0,
  e_folded_values_only = 1,
  e_original_expressions_and_folded_values = 2,
  e_skip_post_processing = 3,
};

//! The only useful constructors (constant folding in the frontend is false by
//! default).
SgProject(const std::vector<std::string> &argv,
          constant_folding_enum frontendConstantFolding =
              e_original_expressions_only);
SgProject(int argc, char **argv,
          constant_folding_enum frontendConstantFolding =
              e_original_expressions_only);

//! process command line and store options in the SgProject object. This options
//! are used by parse und unparse.
void processCommandLine(const std::vector<std::string> &argv);
void processCommandLine(int argc, char **argv) {
  processCommandLine(std::vector<std::string>(argv, argv + argc));
}

//! parse input file(s)
int parse();

//! processes command line and parses all files.
//! Error code can be accessed using get_frontendErrorCode()
int parse(const std::vector<std::string> &argv);
int parse(int argc, char **argv) {
  return parse(std::vector<std::string>(argv, argv + argc));
}

public:
