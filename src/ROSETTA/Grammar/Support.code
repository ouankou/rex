SOURCE_FILE_INFORMATION_START

std::map<std::string, int> Sg_File_Info::p_nametofileid_map;
std::map<int, std::string> Sg_File_Info::p_fileidtoname_map;

// DQ (7/4/2005): Added to test internal consistancy
bool Sg_File_Info::ok() const {

  // DQ (10/22/2007): Are these reasonable constraints when #line n "" are used?
  bool lineNumberOK = p_line > 0;
  bool columnNumberOK = p_col > 0;

  bool filenameOK = p_file_id != NULL_FILE_ID;

  // A compiler generated node has no defined association with a file, line
  // number, or column number.
  bool compilerGenerated = isCompilerGenerated();

  // DQ (11/22/2006): Some nodes have no source position information and we have
  // the live with this at points in the processing. A node which was explicitly
  // marked as a sourcePositionUnavailableInFrontendcompiler has no defined
  // association with a file, line number, or column number.
  bool sourcePositionUnavailableInFrontend =
      isSourcePositionUnavailableInFrontend();

  // DQ (12/23/2006): If this is part of a transformation then it is OK by
  // definition. A node introduced as part of a transformation has no defined
  // association with a file, line number, or column number.
  bool transformation = isTransformation();

  bool physicalFileOK = (p_physical_file_id >= 0);

  if (physicalFileOK == false) {
    MLOG_INFO_C("ROSETTA",
                "Note: In Sg_File_Info::ok(): p_physical_file_id = %d \n",
                p_physical_file_id);
  }

  return (lineNumberOK && columnNumberOK && filenameOK) || compilerGenerated ||
         sourcePositionUnavailableInFrontend || transformation;
}

void Sg_File_Info::updateSourcePosition(Sg_File_Info *update) {
  ROSE_ASSERT(update != NULL);

  // Must have matching file name (only have to compare file_id's)
  ROSE_ASSERT(p_file_id == update->p_file_id);

  // Update only the line number and column number after verifying that the
  // filenames are the same.
  p_line = update->p_line;
  p_col = update->p_col;

  // DQ (12/20/2012): Added support for physical source position (existing
  // file_id and line data represents logical position data).
  ROSE_ASSERT(p_physical_file_id == update->p_physical_file_id);
  p_physical_line = update->p_physical_line;

  // DQ (1/23/2013): Added support for source sequence numbering information.
  p_source_sequence_number = update->p_source_sequence_number;
  p_physical_file_occurrence_id = update->p_physical_file_occurrence_id;
}

Sg_File_Info *Sg_File_Info::generateDefaultFileInfo() {
  return new Sg_File_Info(NULL_FILE_ID, 0, 0);
}

Sg_File_Info *Sg_File_Info::generateDefaultFileInfoForTransformationNode() {
  Sg_File_Info *returnValue = generateDefaultFileInfo();
  returnValue->setTransformation();
  returnValue->unsetSourcePositionUnavailableInFrontend();

  // DQ (1/11/2006): Added call to setOutputInCodeGeneration() because the
  // default behavior is to output all transformations.  Other functions allow
  // transformations to be specified that would not be output (useful for when
  // including new header files).
  returnValue->setOutputInCodeGeneration();

  returnValue->set_file_id(TRANSFORMATION_FILE_ID);

  return returnValue;
}

Sg_File_Info *Sg_File_Info::generateFileInfoForTransformationNode(int file_id) {
  Sg_File_Info *returnValue = generateDefaultFileInfoForTransformationNode();

  returnValue->set_file_id(file_id);

  return returnValue;
}

Sg_File_Info *
Sg_File_Info::generateFileInfoForTransformationNode(string filename) {
  Sg_File_Info *returnValue = generateDefaultFileInfoForTransformationNode();

  returnValue->set_filenameString(filename);

  return returnValue;
}

Sg_File_Info *Sg_File_Info::generateDefaultFileInfoForCompilerGeneratedNode() {
  Sg_File_Info *returnValue = generateDefaultFileInfo();

  // generateDefaultFileInfo() creates a NULL_FILE_ID placeholder,
  // whose constructor marks the position unavailable and output-capable.  A
  // compiler-generated position is a different, exact provenance category:
  // it must not inherit either placeholder bit or transformation provenance.
  returnValue->unsetSourcePositionUnavailableInFrontend();
  returnValue->unsetOutputInCodeGeneration();
  returnValue->unsetTransformation();
  returnValue->setCompilerGenerated();

  returnValue->set_file_id(COMPILER_GENERATED_FILE_ID);

  return returnValue;
}

Sg_File_Info &Sg_File_Info::operator=(const Sg_File_Info &X) {

  if (isImplicitCast() && !X.isImplicitCast()) {
    SgCastExp *owner = isSgCastExp(get_parent());
    if (owner != NULL && owner->get_cast_type() == SgCastExp::e_implicit_cast) {
      fprintf(stderr,
              "REX_AST_INVARIANT[implicit-cast-provenance-assignment]: "
              "typed implicit conversion=%p file-info=%p cannot erase its "
              "semantic provenance through assignment\n",
              static_cast<void *>(owner), static_cast<void *>(this));
      ROSE_ABORT();
    }
  }

  X.check_file_id("Sg_File_Info::operator=");
  const int physical_file_id = X.get_physical_file_id();
  p_file_id = X.p_file_id;
  p_line = X.p_line;
  p_col = X.p_col;
  p_classificationBitField = X.p_classificationBitField;
  p_fileIDsToUnparse = X.p_fileIDsToUnparse;
  p_fileLineNumbersToUnparse = X.p_fileLineNumbersToUnparse;

  // DQ (12/20/2012): Added support for physical source position (existing
  // file_id and line data represents logical position data).
  p_physical_file_id = physical_file_id;
  p_physical_line = X.p_physical_line;

  // DQ (1/23/2013): Added support for source sequence numbering information.
  p_source_sequence_number = X.p_source_sequence_number;
  p_physical_file_occurrence_id = X.p_physical_file_occurrence_id;

  // Record that this source position information was updated.
  markAsModified();

  return *this;
}

bool operator==(const Sg_File_Info &X, const Sg_File_Info &Y) {
  bool returnValue = false;

  // Make this most efficent by putting the least likely match first
  // (col, line, file) and the most expensive test (file) last.
  if (X.get_col() == Y.get_col()) {
    if (X.get_physical_line() == Y.get_physical_line()) {
      if (X.p_physical_file_id == Y.p_physical_file_id) {
        returnValue = true;
      }
    }
  }

  return returnValue;
}

bool operator!=(const Sg_File_Info &X, const Sg_File_Info &Y) {
  return operator==(X, Y) ? false : true;
}

bool operator>(const Sg_File_Info &X, const Sg_File_Info &Y) {
  bool result = false;
  if (X.isSameFile(Y) == true) {
    if (X.p_physical_line > Y.p_physical_line) {
      result = true;
    } else {
      if (X.p_physical_line == Y.p_physical_line) {
        if (X.p_col > Y.p_col) {
          result = true;
        }
      }
    }
  }

  return result;
}

bool operator<(const Sg_File_Info &X, const Sg_File_Info &Y) {
  bool result = false;
  if (X.isSameFile(Y) == true) {
    if (X.p_physical_line < Y.p_physical_line) {
      result = true;
    } else {
      if (X.p_physical_line == Y.p_physical_line) {
        if (X.p_col < Y.p_col) {
          result = true;
        }
      }
    }
  }

  return result;
}

bool operator>=(const Sg_File_Info &X, const Sg_File_Info &Y) {
  bool result = false;
  if (X.isSameFile(Y) == true) {
    if (X.p_physical_line > Y.p_physical_line) {
      result = true;
    } else {
      if (X.p_physical_line == Y.p_physical_line) {
        if (X.p_col >= Y.p_col)
          result = true;
      }
    }
  }

  return result;
}

bool operator<=(const Sg_File_Info &X, const Sg_File_Info &Y) {
  bool result = false;
  if (X.isSameFile(Y) == true) {
    if (X.p_physical_line < Y.p_physical_line) {
      result = true;
    } else {
      if (X.p_physical_line == Y.p_physical_line) {
        if (X.p_col <= Y.p_col)
          result = true;
      }
    }
  }

  return result;
}

// Liao 4/16/2010. The default value for display(label) cannot be instantiated
// from gdb,
//  which is very annoying during debugging. I added the empty parameter one to
//  better support debugging.
void Sg_File_Info::display() const { display(""); }

void Sg_File_Info::display(const std::string label) const {

  // DQ (6/25/2020): If we call display, then we mean for it to be displayed,
  // not hidden.
  printf("Inside of Sg_File_Info::display(%s) of this pointer = %p \n",
         label.c_str(), this);
  printf("     isTransformation                      = %s \n",
         isTransformation() == true ? "true (part of a transformation)"
                                    : "false");
  printf("     isCompilerGenerated                   = %s \n",
         isCompilerGenerated() == true ? "true (no position information)"
                                       : "false");
  printf("     isOutputInCodeGeneration              = %s \n",
         isOutputInCodeGeneration() == true ? "true (output in code generator)"
                                            : "false");
  printf("     isShared                              = %s \n",
         isShared() == true ? "true (shared within merged AST)" : "false");
  printf("     isFrontendSpecific                    = %s \n",
         isFrontendSpecific() == true
             ? "true (part of ROSE support for gnu compatability)"
             : "false");
  printf("     isSourcePositionUnavailableInFrontend = %s \n",
         isSourcePositionUnavailableInFrontend() == true
             ? "true (source position unavailable in frontend)"
             : "false");
  printf("     isCommentOrDirective                  = %s \n",
         isCommentOrDirective() == true
             ? "true (this is a comment or CPP directive)"
             : "false");
  printf("     isToken                               = %s \n",
         isToken() == true
             ? "true (this is from the token stream woven into the AST)"
             : "false");
  printf("     isDefaultArgument                     = %s \n",
         isDefaultArgument() == true ? "true (root of default argument)"
                                     : "false");
  printf("     isImplicitCast                        = %s \n",
         isImplicitCast() == true ? "true (implicit instead of explicit cast)"
                                  : "false");

  if (!isTransformation() && !isCompilerGenerated()) {
    printf("     (computed) filename = %s \n", get_filename());
    printf("     (computed) line     = %d  column = %d \n", get_line(),
           get_col());
  } else // Liao, 11/12/2012, more information for debugging
  {
    printf("     Filename and line, column info should be invalid for "
           "transformation or compiler generated objects\n");
    printf("     we print their values anyway for your reference\n");
    printf("     (computed) filename = %s \n", get_filename());
    printf("     (computed) line     = %d  column = %d \n", get_line(),
           get_col());
  }

  if (label.find("debug") != std::string::npos) {
    printf("     (internal) file_id   = %d \n", get_file_id());
    printf("     (internal) filename  = %s \n", get_raw_filename().c_str());
    printf("     (internal  line      = %d  column   = %d \n", p_line, p_col);
  }

  printf("     (computed) physical_file_id    = %d = %s \n",
         get_physical_file_id(), get_physical_filename().c_str());
  printf("     (internal) physical_file_id    = %d = %s \n",
         get_physical_file_id(),
         getFilenameFromID(get_physical_file_id()).c_str());
  printf("     (internal) physical_file_id    = %d = %s \n", p_physical_file_id,
         getFilenameFromID(p_physical_file_id).c_str());
  printf("     (computed) physical_line       = %d \n", p_physical_line);

  printf("     source_sequence_number         = %d \n",
         p_source_sequence_number);
  printf("     physical_file_occurrence_id    = %u \n",
         p_physical_file_occurrence_id);

}

string Sg_File_Info::displayString(const std::string &label) const {

  std::string s;
  s += std::string("Inside of Sg_File_Info::displayString(") + label +
       std::string(") \n");
  s += std::string("isTransformation    = ") +
       std::string(isTransformation() ? "true " : "false ") + std::string(" ");
  s += std::string("isCompilerGenerated = ") +
       std::string(isCompilerGenerated() ? "true " : "false ") +
       std::string(" ");
  if (!isTransformation() && !isCompilerGenerated()) {
    s += std::string("line number = ") +
         Rose::StringUtility::numberToString(get_line()) + std::string(" ");
    s += std::string("column number = ") +
         Rose::StringUtility::numberToString(get_col()) + std::string(" ");
    s += std::string("filename = ") + std::string(get_filename()) +
         std::string(" ");
  }

  return s;
}

void Sg_File_Info::display_static_data(const std::string label) {
  printf("Inside of Sg_File_Info::display_static_data(%s) \n", label.c_str());

  printf("p_nametofileid_map: \n");
  for (std::map<std::string, int>::iterator i = p_nametofileid_map.begin();
       i != p_nametofileid_map.end(); i++) {
    printf("name = %s id = %d \n", i->first.c_str(), i->second);
  }

  printf("p_fileidtoname_map: \n");
  for (std::map<int, std::string>::iterator i = p_fileidtoname_map.begin();
       i != p_fileidtoname_map.end(); i++) {
    printf("id = %d name = %s \n", i->first, i->second.c_str());
  }
}

namespace {
inline int validate_file_id_registration(int file_id) {
  ROSE_ASSERT(file_id >= Sg_File_Info::BAD_FILE_ID);
  if (file_id >= 0 &&
      Sg_File_Info::get_fileidtoname_map().count(file_id) == 0) {
    fprintf(stderr,
            "REX_AST_INVARIANT[file-info-registration]: positive file id %d "
            "has no registered filename\n",
            file_id);
    ROSE_ABORT();
  }
  return file_id;
}

int validate_physical_file_id(const Sg_File_Info &info, int physical_file_id) {
  validate_file_id_registration(physical_file_id);
  if (physical_file_id >= 0 || physical_file_id == Sg_File_Info::NULL_FILE_ID ||
      (physical_file_id == Sg_File_Info::TRANSFORMATION_FILE_ID &&
       info.isTransformation()) ||
      (physical_file_id == Sg_File_Info::COMPILER_GENERATED_FILE_ID &&
       info.isCompilerGenerated())) {
    return physical_file_id;
  }
  fprintf(stderr,
          "REX_AST_INVARIANT[file-info-physical-owner]: file-info=%p "
          "has impossible stored physical-file-id=%d transformation=%d "
          "compiler-generated=%d\n",
          static_cast<const void *>(&info), physical_file_id,
          info.isTransformation(), info.isCompilerGenerated());
  ROSE_ABORT();
}
} // namespace

Sg_File_Info::Sg_File_Info()
    : p_file_id(COPY_FILE_ID), p_line(0), p_col(0), p_classificationBitField(0),
      p_physical_file_id(NULL_FILE_ID), p_physical_line(0),
      p_source_sequence_number(0), p_physical_file_occurrence_id(0),
      p_fileIDsToUnparse(), p_fileLineNumbersToUnparse() {
  post_construction_initialization();
}

Sg_File_Info::Sg_File_Info(const std::string &filename, int line, int col)
    : p_file_id(NULL_FILE_ID), p_line(line), p_col(col),
      p_classificationBitField(0), p_physical_file_id(NULL_FILE_ID),
      p_physical_line(0), p_source_sequence_number(0),
      p_physical_file_occurrence_id(0), p_fileIDsToUnparse(),
      p_fileLineNumbersToUnparse() {
  set_filenameString(filename);

  set_physical_source_position_to_match_logical_source_position();

  post_construction_initialization();
}

Sg_File_Info::Sg_File_Info(const Sg_File_Info &X)
    : SgSupport(), p_file_id(validate_file_id_registration(X.p_file_id)),
      p_line(X.p_line), p_col(X.p_col),
      p_classificationBitField(X.p_classificationBitField),
      p_physical_file_id(X.get_physical_file_id()),
      p_physical_line(X.p_physical_line),
      p_source_sequence_number(X.p_source_sequence_number),
      p_physical_file_occurrence_id(X.p_physical_file_occurrence_id),
      p_fileIDsToUnparse(X.p_fileIDsToUnparse),
      p_fileLineNumbersToUnparse(X.p_fileLineNumbersToUnparse) {
  post_construction_initialization();
}

Sg_File_Info::Sg_File_Info(int file_id, int line, int column)
    : p_file_id(validate_file_id_registration(file_id)), p_line(line),
      p_col(column), p_classificationBitField(0),
      p_physical_file_id(validate_file_id_registration(file_id)),
      p_physical_line(0), p_source_sequence_number(0),
      p_physical_file_occurrence_id(0), p_fileIDsToUnparse(),
      p_fileLineNumbersToUnparse() {
  post_construction_initialization();
}

void Sg_File_Info::post_construction_initialization() {
  // JJW 10-26-2007 ensure that this object is not on the stack
  preventConstructionOnStack(this);

  // ROSE-1499 check that p_file_id is valid
  check_file_id("Sg_File_Info::post_construction_initialization");

  // Ensure default/null file infos are consistently flagged as having
  // unavailable source positions. Some constructors initialize file info
  // eagerly, so setSourcePositionToDefault() may not run.
  if ((p_file_id == NULL_FILE_ID || p_file_id == COPY_FILE_ID) &&
      p_classificationBitField == 0) {
    setSourcePositionUnavailableInFrontend();
    setOutputInCodeGeneration();
  }

  // Keep classification bits consistent with special file IDs.
  if (p_file_id == COMPILER_GENERATED_FILE_ID &&
      isCompilerGenerated() == false) {
    setCompilerGenerated();
  }
  if (p_file_id == TRANSFORMATION_FILE_ID && isTransformation() == false) {
    setTransformation();
  }
  get_physical_file_id();
}

// ROSE-1499, ROSE-1639 (added const to char*)
void Sg_File_Info::check_file_id(const char *label, bool assertion) const {
  if (((p_file_id >= 0) && (p_fileidtoname_map.count(p_file_id) == 0)) ||
      ((p_file_id < -6) || (p_file_id > (int)p_fileidtoname_map.size()))) {
    printf("ERROR from %s:\n", label);
    printf("  Sg_File_Info::this = %p\n", this);
    printf("  p_file_id = %d\n", p_file_id);
    printf("  p_nametofileid_map.size() = %zu\n", p_nametofileid_map.size());
    printf("  p_fileidtoname_map.size() = %zu\n", p_fileidtoname_map.size());
    printf("  isTransformation() = %d\n", isTransformation());
    printf("  isCompilerGenerated() = %d\n", isCompilerGenerated());
    printf("  isFrontendSpecific() = %d\n", isFrontendSpecific());
  }
  if (assertion) {
    ROSE_ASSERT((p_file_id < 0) || (p_fileidtoname_map.count(p_file_id) > 0));
    ROSE_ASSERT((p_file_id > -7) &&
                (p_file_id < (int)p_fileidtoname_map.size()));
  }
}

int Sg_File_Info::get_file_id() const {
  check_file_id("Sg_File_Info::get_file_id");

  if (isTransformation()) {
    return TRANSFORMATION_FILE_ID;
  }
  if (isCompilerGenerated()) {
    if (!isFrontendSpecific()) {
      return COMPILER_GENERATED_FILE_ID;
    }
    ROSE_ASSERT(p_file_id == COMPILER_GENERATED_FILE_ID ||
                p_file_id == TRANSFORMATION_FILE_ID ||
                p_fileidtoname_map.count(p_file_id) > 0);
  } else {
    ROSE_ASSERT(p_file_id == NULL_FILE_ID ||
                p_file_id == COMPILER_GENERATED_FILE_ID ||
                p_file_id == TRANSFORMATION_FILE_ID ||
                p_fileidtoname_map.count(p_file_id) > 0);
  }

  return p_file_id;
}

int Sg_File_Info::get_raw_file_id() const { return p_file_id; }

void Sg_File_Info::set_file_id(int file_id) {

  check_file_id("Sg_File_Info::set_file_id");

  p_file_id = validate_file_id_registration(file_id);
  markAsModified();
}

int Sg_File_Info::get_physical_file_id() const {
  return validate_physical_file_id(*this, p_physical_file_id);
}

int Sg_File_Info::get_raw_physical_file_id() const {
  return p_physical_file_id;
}

int Sg_File_Info::get_physical_file_id(int input_file_id) const {

  const int physical_file_id = get_physical_file_id();
  if (input_file_id == physical_file_id) {
    return physical_file_id;
  }

  const SgFileIdList::const_iterator shared =
      find(p_fileIDsToUnparse.begin(), p_fileIDsToUnparse.end(), input_file_id);
  if (shared != p_fileIDsToUnparse.end()) {
    return input_file_id;
  }

  fprintf(stderr,
          "REX_AST_INVARIANT[file-info-physical-owner]: file-info=%p "
          "requested-file-id=%d is neither exact-owner-id=%d nor a "
          "shared physical owner\n",
          static_cast<const void *>(this), input_file_id, physical_file_id);
  ROSE_ABORT();
}

void Sg_File_Info::set_physical_file_id(int physical_file_id) {

  p_physical_file_id = validate_physical_file_id(*this, physical_file_id);

  markAsModified();
}

void Sg_File_Info::
    set_physical_source_position_to_match_logical_source_position() {

  p_physical_file_id = validate_physical_file_id(*this, p_file_id);
  p_physical_line = p_line;

  markAsModified();
}

int Sg_File_Info::numberOfSourceFiles() { return p_nametofileid_map.size(); }

int Sg_File_Info::addFilenameToMap(const std::string &filename) {
  const auto existing = p_nametofileid_map.find(filename);
  int file_id;
  if (existing != p_nametofileid_map.end()) {
    file_id = existing->second;
  } else {
    file_id = p_nametofileid_map.size();
    p_nametofileid_map[filename] = file_id;
    p_fileidtoname_map[file_id] = filename;
  }

  ROSE_ASSERT(p_nametofileid_map.size() == p_fileidtoname_map.size());
  return file_id;
}

void Sg_File_Info::set_filenameString(const std::string &filename) {
  check_file_id("Sg_File_Info::set_filenameString");
  p_file_id = addFilenameToMap(filename);

  if (isSourcePositionUnavailableInFrontend() == true) {
    unsetSourcePositionUnavailableInFrontend();
  }
}

void Sg_File_Info::set_physical_filename(const std::string &filename) {
  p_physical_file_id = addFilenameToMap(filename);
}

const std::string &Sg_File_Info::get_filenameString() const {
  check_file_id("Sg_File_Info::get_filenameString");

  if (isTransformation()) {
    static const std::string transformation_string = "transformation";
    return transformation_string;
  }
  if (isCompilerGenerated() && !isFrontendSpecific()) {
    static const std::string compiler_generated_string = "compilerGenerated";
    return compiler_generated_string;
  }
  return getFilenameFromID(p_file_id);
}

const char *Sg_File_Info::get_filename() const {
  return get_filenameString().c_str();
}

string Sg_File_Info::get_raw_filename() const {

  return getFilenameFromID(p_file_id);
}

string Sg_File_Info::get_physical_filename() const {
  return getFilenameFromID(get_physical_file_id());
}

void Sg_File_Info::set_line(int line) {

  p_line = line;
  if (isTransformation() || isCompilerGenerated()) {
    if (line != 0) {
      MLOG_INFO_C(
          "ROSETTA",
          "warning: Sg_File_Info::set_line() tried to set non-zero line number "
          "to a transformation or compiler generated file info obj.\n");
    }
  } else {
    if (isSourcePositionUnavailableInFrontend() == true) {
      unsetSourcePositionUnavailableInFrontend();
    }
  }
}

int Sg_File_Info::get_line() const {
  int returnValue = p_line;
  if (isTransformation() || isCompilerGenerated() ||
      isSourcePositionUnavailableInFrontend())
    returnValue = 0;

  assert(returnValue >= 0);
  return returnValue;
}

int Sg_File_Info::get_line(int file_id) const {
  const int physical_file_id = get_physical_file_id();
  const SgFileIdList::const_iterator shared =
      find(p_fileIDsToUnparse.begin(), p_fileIDsToUnparse.end(), file_id);
  if (file_id != physical_file_id && shared == p_fileIDsToUnparse.end()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[file-info-logical-line-owner]: "
            "file-info=%p requested-file-id=%d is neither "
            "exact-owner-id=%d nor a shared physical owner\n",
            static_cast<const void *>(this), file_id, physical_file_id);
    ROSE_ABORT();
  }

  int returnValue = 0;
  if (!isTransformation() && !isCompilerGenerated() &&
      !isSourcePositionUnavailableInFrontend()) {
    if (file_id == physical_file_id) {
      returnValue = p_line;
    } else {
      const ptrdiff_t index = shared - p_fileIDsToUnparse.begin();
      ROSE_ASSERT(index >= 0);
      ROSE_ASSERT(index < (ptrdiff_t)p_fileIDsToUnparse.size());
      ROSE_ASSERT(p_fileLineNumbersToUnparse.size() ==
                  p_fileIDsToUnparse.size());
      ROSE_ASSERT(file_id == p_fileIDsToUnparse[index]);
      returnValue = p_fileLineNumbersToUnparse[index];
    }
  }

  assert(returnValue >= 0);
  return returnValue;
}

int Sg_File_Info::get_raw_line() const {
  return p_line;
}

void Sg_File_Info::set_physical_line(int line) {
  p_physical_line = line;
}

int Sg_File_Info::get_physical_line(int file_id) const {

  const int physical_file_id = get_physical_file_id();
  if (file_id == physical_file_id) {
    return p_physical_line;
  }

  const SgFileIdList::const_iterator shared =
      find(p_fileIDsToUnparse.begin(), p_fileIDsToUnparse.end(), file_id);
  if (shared == p_fileIDsToUnparse.end()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[file-info-physical-line-owner]: "
            "file-info=%p requested-file-id=%d is neither "
            "exact-owner-id=%d nor a shared physical owner\n",
            static_cast<const void *>(this), file_id, physical_file_id);
    ROSE_ABORT();
  }

  const ptrdiff_t index = shared - p_fileIDsToUnparse.begin();
  ROSE_ASSERT(index >= 0);
  ROSE_ASSERT(index < (ptrdiff_t)p_fileIDsToUnparse.size());
  ROSE_ASSERT(p_fileLineNumbersToUnparse.size() == p_fileIDsToUnparse.size());
  ROSE_ASSERT(file_id == p_fileIDsToUnparse[index]);
  return p_fileLineNumbersToUnparse[index];
}

int Sg_File_Info::get_physical_line() const {
  return p_physical_line;
}

void Sg_File_Info::set_source_sequence_number(unsigned int n) {
  p_source_sequence_number = n;
}

unsigned int Sg_File_Info::get_source_sequence_number() const {
  return p_source_sequence_number;
}

void Sg_File_Info::set_physical_file_occurrence_id(unsigned int n) {
  p_physical_file_occurrence_id = n;
  markAsModified();
}

unsigned int Sg_File_Info::get_physical_file_occurrence_id() const {
  return p_physical_file_occurrence_id;
}

int Sg_File_Info::get_col() const {
  assert(p_col >= 0);
  int returnValue = p_col;
  if (isTransformation() || isCompilerGenerated() ||
      isSourcePositionUnavailableInFrontend())
    returnValue = 0;

  assert(returnValue >= 0);
  return returnValue;
}

int Sg_File_Info::get_raw_col() const {
  assert(p_col >= 0);
  return p_col;
}

void Sg_File_Info::set_col(int n) {
  p_col = n;
  assert(p_col >= 0);
}

bool Sg_File_Info::hasPositionInSource() const {
  return !(isTransformation() || isCompilerGenerated() ||
           isOutputInCodeGeneration());
}

bool Sg_File_Info::isSameFile(SgFile *file) const {
  ROSE_ASSERT(file != NULL);
  Sg_File_Info *fileInfo = file->get_startOfConstruct();
  ROSE_ASSERT(fileInfo != NULL);
  const int physicalFileId = fileInfo->get_physical_file_id();
  return get_physical_file_id() == physicalFileId ||
         find(p_fileIDsToUnparse.begin(), p_fileIDsToUnparse.end(),
              physicalFileId) != p_fileIDsToUnparse.end();
}

bool Sg_File_Info::isSameFile(Sg_File_Info *fileInfo) const {
  ROSE_ASSERT(fileInfo != NULL);
  return get_physical_file_id() == fileInfo->get_physical_file_id();
}

bool Sg_File_Info::isSameFile(const Sg_File_Info &fileInfo) const {
  return get_physical_file_id() == fileInfo.get_physical_file_id();
}

//! Access functions for classification of File_Info objects
bool Sg_File_Info::isTransformation() const {
  return (p_classificationBitField & e_transformation);
}

// Keep SgLocatedNode file-info objects consistent: if a Sg_File_Info is
// attached to a located node, then all of that node's file-info objects must
// agree on classification bits that participate in IR invariants
// (start/end/operatorPosition).
#define ROSE_FILE_INFO_PROPAGATE_CLASSIFICATION_BIT(mask, set_bit)             \
  do {                                                                         \
    SgNode *parent = get_parent();                                             \
    auto apply = [&](Sg_File_Info *fi) {                                       \
      if (fi != NULL) {                                                        \
        if (set_bit)                                                           \
          fi->p_classificationBitField |= (mask);                              \
        else                                                                   \
          fi->p_classificationBitField &= ~(mask);                             \
      }                                                                        \
    };                                                                         \
                                                                               \
    SgLocatedNode *locatedNode = isSgLocatedNode(parent);                      \
    if (locatedNode != NULL) {                                                 \
      apply(locatedNode->get_startOfConstruct());                              \
      apply(locatedNode->get_endOfConstruct());                                \
                                                                               \
      SgExpression *expression = isSgExpression(locatedNode);                  \
      if (expression != NULL)                                                  \
        apply(expression->get_operatorPosition());                             \
    } else {                                                                   \
      SgInitializedName *initName = isSgInitializedName(parent);               \
      if (initName != NULL) {                                                  \
        apply(initName->get_startOfConstruct());                               \
        apply(initName->get_endOfConstruct());                                 \
      }                                                                        \
    }                                                                          \
  } while (false)

void Sg_File_Info::setTransformation() {
  p_classificationBitField |= e_transformation;

  // Transformation classification is a located-node invariant across every
  // owned Sg_File_Info.
  ROSE_FILE_INFO_PROPAGATE_CLASSIFICATION_BIT(e_transformation, true);
}

void Sg_File_Info::unsetTransformation() {
  p_classificationBitField &= ~e_transformation;

  ROSE_FILE_INFO_PROPAGATE_CLASSIFICATION_BIT(e_transformation, false);
}

bool Sg_File_Info::isCompilerGenerated() const {

  return (p_classificationBitField & e_compiler_generated);
}

void Sg_File_Info::setCompilerGenerated() {

  p_classificationBitField |= e_compiler_generated;
}

void Sg_File_Info::unsetCompilerGenerated() {
  p_classificationBitField &= ~e_compiler_generated;
}

bool Sg_File_Info::isOutputInCodeGeneration() const {
  return (p_classificationBitField & e_output_in_code_generation);
}

void Sg_File_Info::setOutputInCodeGeneration() {
  p_classificationBitField |= e_output_in_code_generation;

  // Classification is a located-node invariant: changing any owned
  // Sg_File_Info updates the complete start/end/operator-position set.
  ROSE_FILE_INFO_PROPAGATE_CLASSIFICATION_BIT(e_output_in_code_generation,
                                              true);
}

void Sg_File_Info::unsetOutputInCodeGeneration() {
  p_classificationBitField &= ~e_output_in_code_generation;

  ROSE_FILE_INFO_PROPAGATE_CLASSIFICATION_BIT(e_output_in_code_generation,
                                              false);
}

#undef ROSE_FILE_INFO_PROPAGATE_CLASSIFICATION_BIT

bool Sg_File_Info::isShared() const {
  return (p_classificationBitField & e_shared);
}

void Sg_File_Info::setShared() {
  // MK (8/3/05) : We always want to unparse the current file (this is a
  // performance issue)
  // DQ (10/27/2007): Make sure this is a valid file that we are trying to
  // share. I am unclear as to how important this is.
  int temp_file_id = this->get_file_id();
  if (temp_file_id < 0) {
    if (SgProject::get_verbose() > 0)
      MLOG_INFO_C("ROSETTA", "Warning: trying to share file id = %d < 0 \n",
                  temp_file_id);
  }

  p_classificationBitField |= e_shared;
}

void Sg_File_Info::unsetShared() {
  p_classificationBitField &= ~e_shared;
}

