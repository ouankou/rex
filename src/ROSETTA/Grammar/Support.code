HEADER_FUNCTION_TYPE_ARGUMENT_START
void post_construction_initialization() override;
//! The semantic type emitted at this argument position.
SgType *get_type() const;

//! Atomically replace the type through the exact owning parameter-type list.
void replace_type(SgType *type, SgFunctionParameterTypeList *owner);
HEADER_FUNCTION_TYPE_ARGUMENT_END

SOURCE_FUNCTION_TYPE_ARGUMENT_START
namespace {
bool canonicalFunctionArgumentOwnsType(const SgType *type) {
  auto *position = isSgFunctionTypeArgument(type->get_parent());
  auto *arguments = position != nullptr
                        ? isSgFunctionParameterTypeList(position->get_parent())
                        : nullptr;
  auto *function = arguments != nullptr
                       ? isSgFunctionType(arguments->get_parent())
                       : nullptr;
  auto *table = SgNode::get_globalFunctionTypeTable();
  if (function == nullptr || table == nullptr || type->has_source_prototype() ||
      function->has_source_prototype() ||
      function->get_semantic_signature() != nullptr ||
      function->get_argument_list() != arguments || position->get_type() != type)
    return false;
  const auto &positions = arguments->get_argument_qualification_use_sites();
  return std::count(positions.begin(), positions.end(), position) == 1 &&
         table->lookup_exact_function_type(function) == function;
}
} // namespace

void $CLASSNAME::post_construction_initialization() {
  ASSERT_not_null(p_type);
  if (p_type->has_source_prototype() || isSgDeclType(p_type) ||
      isSgTypeOfType(p_type)) {
    if (p_type->get_parent() == nullptr)
      p_type->set_parent(this);
    else
      ROSE_ASSERT(canonicalFunctionArgumentOwnsType(p_type));
  }
}

SgType *$CLASSNAME::get_type() const { return p_type; }

void $CLASSNAME::replace_type(SgType *type,
                              SgFunctionParameterTypeList *owner) {
  ASSERT_not_null(type);
  ASSERT_not_null(owner);
  if (get_parent() != owner) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-argument-qualification-use-site]: "
            "position=%p parent=%p cannot be updated by owner=%p\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(owner));
    ROSE_ABORT();
  }
  const bool owns_type = type->has_source_prototype() || isSgDeclType(type) ||
                         isSgTypeOfType(type);
  if (owns_type)
    ROSE_ASSERT(type->get_parent() == nullptr || type->get_parent() == this ||
                canonicalFunctionArgumentOwnsType(type));
  if (p_type != type && p_type->get_parent() == this)
    p_type->set_parent(nullptr);
  p_type = type;
  if (owns_type && p_type->get_parent() == nullptr)
    p_type->set_parent(this);
}
SOURCE_FUNCTION_TYPE_ARGUMENT_END

HEADER_STATEMENT_ATTRIBUTE_START
public:
enum statement_attribute_kind_enum {
  e_statement_attribute_fallthrough,
  e_statement_attribute_likely,
  e_statement_attribute_unlikely,
  e_statement_attribute_assume,
  e_statement_attribute_nomerge,
  e_statement_attribute_musttail,
  e_statement_attribute_always_inline,
  e_statement_attribute_opencl_unroll_hint,
  e_statement_attribute_loop_hint,
  e_last_statement_attribute_kind
};

// Closed source spellings accepted by Clang 22 for statement attributes.
// The attribute kind and this enum together preserve the exact namespace
// and syntax family without storing opaque source text.
enum statement_attribute_spelling_enum {
  e_statement_attribute_spelling_cxx11_unscoped,
  e_statement_attribute_spelling_c23_unscoped,
  e_statement_attribute_spelling_cxx11_clang,
  e_statement_attribute_spelling_c23_clang,
  e_statement_attribute_spelling_gnu,
  e_statement_attribute_spelling_cxx11_gnu,
  e_statement_attribute_spelling_c23_gnu,
  e_statement_attribute_spelling_pragma_clang_loop,
  e_statement_attribute_spelling_pragma_unroll,
  e_statement_attribute_spelling_pragma_nounroll,
  e_statement_attribute_spelling_pragma_unroll_and_jam,
  e_statement_attribute_spelling_pragma_nounroll_and_jam,
  e_last_statement_attribute_spelling
};

enum loop_hint_option_enum {
  e_loop_hint_option_none,
  e_loop_hint_option_vectorize,
  e_loop_hint_option_vectorize_width,
  e_loop_hint_option_interleave,
  e_loop_hint_option_interleave_count,
  e_loop_hint_option_unroll,
  e_loop_hint_option_unroll_count,
  e_loop_hint_option_unroll_and_jam,
  e_loop_hint_option_unroll_and_jam_count,
  e_loop_hint_option_pipeline_disabled,
  e_loop_hint_option_pipeline_initiation_interval,
  e_loop_hint_option_distribute,
  e_loop_hint_option_vectorize_predicate,
  e_last_loop_hint_option
};

enum loop_hint_state_enum {
  e_loop_hint_state_none,
  e_loop_hint_state_enable,
  e_loop_hint_state_disable,
  e_loop_hint_state_numeric,
  e_loop_hint_state_fixed_width,
  e_loop_hint_state_scalable_width,
  e_loop_hint_state_assume_safety,
  e_loop_hint_state_full,
  e_last_loop_hint_state
};

void post_construction_initialization() override;
SgExpression *get_expression_argument() const;
void set_expression_argument(SgExpression *replacement);
static bool fields_are_valid(statement_attribute_kind_enum kind,
                             statement_attribute_spelling_enum spelling,
                             bool has_expression,
                             unsigned long integral_argument,
                             loop_hint_option_enum loop_hint_option,
                             loop_hint_state_enum loop_hint_state);
void validate() const;
HEADER_STATEMENT_ATTRIBUTE_END

SOURCE_STATEMENT_ATTRIBUTE_START
void $CLASSNAME::post_construction_initialization() {
  if (p_expression_argument != NULL) {
    if (p_expression_argument->get_parent() != NULL &&
        p_expression_argument->get_parent() != this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[statement-attribute-expression-owner]: "
              "attribute=%p received expression=%p already owned by %p\n",
              static_cast<void *>(this),
              static_cast<void *>(p_expression_argument),
              static_cast<void *>(p_expression_argument->get_parent()));
      ROSE_ABORT();
    }
    p_expression_argument->set_parent(this);
  }
}

SgExpression *$CLASSNAME::get_expression_argument() const {
  return p_expression_argument;
}

void $CLASSNAME::set_expression_argument(SgExpression *replacement) {
  if (replacement == p_expression_argument) {
    if (replacement != NULL && replacement->get_parent() != this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[statement-attribute-expression-owner]: "
              "attribute=%p expression=%p has owner=%p\n",
              static_cast<void *>(this), static_cast<void *>(replacement),
              static_cast<void *>(replacement->get_parent()));
      ROSE_ABORT();
    }
    return;
  }
  if (replacement != NULL && replacement->get_parent() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[statement-attribute-expression-owner]: "
            "attribute=%p cannot adopt expression=%p owned by %p\n",
            static_cast<void *>(this), static_cast<void *>(replacement),
            static_cast<void *>(replacement->get_parent()));
    ROSE_ABORT();
  }
  if (p_expression_argument != NULL) {
    if (p_expression_argument->get_parent() != this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[statement-attribute-expression-owner]: "
              "attribute=%p current expression=%p has owner=%p\n",
              static_cast<void *>(this),
              static_cast<void *>(p_expression_argument),
              static_cast<void *>(p_expression_argument->get_parent()));
      ROSE_ABORT();
    }
    p_expression_argument->set_parent(NULL);
  }
  p_expression_argument = replacement;
  if (replacement != NULL)
    replacement->set_parent(this);
}

bool $CLASSNAME::fields_are_valid(statement_attribute_kind_enum kind,
                                  statement_attribute_spelling_enum spelling,
                                  bool has_expression,
                                  unsigned long integral_argument,
                                  loop_hint_option_enum loop_hint_option,
                                  loop_hint_state_enum loop_hint_state) {
  bool spelling_is_valid = false;
  switch (kind) {
  case e_statement_attribute_fallthrough:
    spelling_is_valid =
        spelling == e_statement_attribute_spelling_cxx11_unscoped ||
        spelling == e_statement_attribute_spelling_c23_unscoped ||
        spelling == e_statement_attribute_spelling_cxx11_clang ||
        spelling == e_statement_attribute_spelling_gnu ||
        spelling == e_statement_attribute_spelling_cxx11_gnu ||
        spelling == e_statement_attribute_spelling_c23_gnu;
    break;
  case e_statement_attribute_likely:
  case e_statement_attribute_unlikely:
    spelling_is_valid =
        spelling == e_statement_attribute_spelling_cxx11_unscoped ||
        spelling == e_statement_attribute_spelling_c23_clang;
    break;
  case e_statement_attribute_assume:
    spelling_is_valid =
        spelling == e_statement_attribute_spelling_cxx11_unscoped ||
        spelling == e_statement_attribute_spelling_gnu ||
        spelling == e_statement_attribute_spelling_cxx11_clang ||
        spelling == e_statement_attribute_spelling_c23_clang;
    break;
  case e_statement_attribute_nomerge:
  case e_statement_attribute_musttail:
    spelling_is_valid =
        spelling == e_statement_attribute_spelling_gnu ||
        spelling == e_statement_attribute_spelling_cxx11_clang ||
        spelling == e_statement_attribute_spelling_c23_clang;
    break;
  case e_statement_attribute_always_inline:
    spelling_is_valid =
        spelling == e_statement_attribute_spelling_gnu ||
        spelling == e_statement_attribute_spelling_cxx11_gnu ||
        spelling == e_statement_attribute_spelling_c23_gnu ||
        spelling == e_statement_attribute_spelling_cxx11_clang ||
        spelling == e_statement_attribute_spelling_c23_clang;
    break;
  case e_statement_attribute_opencl_unroll_hint:
    spelling_is_valid = spelling == e_statement_attribute_spelling_gnu;
    break;
  case e_statement_attribute_loop_hint:
    spelling_is_valid =
        spelling >= e_statement_attribute_spelling_pragma_clang_loop &&
        spelling <= e_statement_attribute_spelling_pragma_nounroll_and_jam;
    break;
  default:
    break;
  }
  if (!spelling_is_valid) {
    return false;
  }

  const bool is_assume = kind == e_statement_attribute_assume;
  const bool is_loop_hint = kind == e_statement_attribute_loop_hint;
  const bool loop_state_can_have_expression =
      loop_hint_state == e_loop_hint_state_numeric ||
      loop_hint_state == e_loop_hint_state_fixed_width ||
      loop_hint_state == e_loop_hint_state_scalable_width;
  const bool loop_state_requires_expression =
      loop_hint_state == e_loop_hint_state_numeric;

  if ((is_assume && !has_expression) ||
      (!is_assume && !is_loop_hint && has_expression) ||
      (is_loop_hint && has_expression && !loop_state_can_have_expression) ||
      (is_loop_hint && loop_state_requires_expression && !has_expression)) {
    return false;
  }

  if (kind != e_statement_attribute_opencl_unroll_hint &&
      integral_argument != 0) {
    return false;
  }

  if (is_loop_hint) {
    if (loop_hint_option <= e_loop_hint_option_none ||
        loop_hint_option >= e_last_loop_hint_option ||
        loop_hint_state <= e_loop_hint_state_none ||
        loop_hint_state >= e_last_loop_hint_state) {
      return false;
    }

    bool spelling_payload_is_valid = false;
    switch (spelling) {
    case e_statement_attribute_spelling_pragma_clang_loop:
      spelling_payload_is_valid = true;
      break;
    case e_statement_attribute_spelling_pragma_unroll:
      spelling_payload_is_valid =
          (loop_hint_option == e_loop_hint_option_unroll &&
           loop_hint_state == e_loop_hint_state_enable && !has_expression) ||
          (loop_hint_option == e_loop_hint_option_unroll_count &&
           loop_hint_state == e_loop_hint_state_numeric && has_expression);
      break;
    case e_statement_attribute_spelling_pragma_nounroll:
      spelling_payload_is_valid =
          loop_hint_option == e_loop_hint_option_unroll &&
          loop_hint_state == e_loop_hint_state_disable && !has_expression;
      break;
    case e_statement_attribute_spelling_pragma_unroll_and_jam:
      spelling_payload_is_valid =
          (loop_hint_option == e_loop_hint_option_unroll_and_jam &&
           loop_hint_state == e_loop_hint_state_enable && !has_expression) ||
          (loop_hint_option == e_loop_hint_option_unroll_and_jam_count &&
           loop_hint_state == e_loop_hint_state_numeric && has_expression);
      break;
    case e_statement_attribute_spelling_pragma_nounroll_and_jam:
      spelling_payload_is_valid =
          loop_hint_option == e_loop_hint_option_unroll_and_jam &&
          loop_hint_state == e_loop_hint_state_disable && !has_expression;
      break;
    default:
      break;
    }
    if (!spelling_payload_is_valid) {
      return false;
    }
  } else if (loop_hint_option != e_loop_hint_option_none ||
             loop_hint_state != e_loop_hint_state_none) {
    return false;
  }
  return true;
}

void $CLASSNAME::validate() const {
  const bool has_expression = p_expression_argument != NULL;
  if (has_expression && p_expression_argument->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[statement-attribute-expression-owner]: "
            "attribute=%p expression=%p has owner=%p\n",
            static_cast<const void *>(this),
            static_cast<void *>(p_expression_argument),
            static_cast<void *>(p_expression_argument->get_parent()));
    ROSE_ABORT();
  }

  if (!fields_are_valid(p_kind, p_spelling, has_expression, p_integral_argument,
                        p_loop_hint_option, p_loop_hint_state)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[statement-attribute-fields]: attribute=%p "
            "kind=%d spelling=%d expression=%p integral=%lu option=%d state=%d "
            "is malformed\n",
            static_cast<const void *>(this), static_cast<int>(p_kind),
            static_cast<int>(p_spelling),
            static_cast<void *>(p_expression_argument), p_integral_argument,
            static_cast<int>(p_loop_hint_option),
            static_cast<int>(p_loop_hint_state));
    ROSE_ABORT();
  }
}
SOURCE_STATEMENT_ATTRIBUTE_END

HEADER_STATEMENT_ATTRIBUTE_LIST_START
void post_construction_initialization() override;
const SgStatementAttributePtrList &get_attributes() const;
void append_attribute(SgStatementAttribute *attribute);
void validate() const;
HEADER_STATEMENT_ATTRIBUTE_LIST_END

SOURCE_STATEMENT_ATTRIBUTE_LIST_START
void $CLASSNAME::post_construction_initialization() {
  for (SgStatementAttribute *attribute : p_attributes) {
    if (attribute == NULL ||
        (attribute->get_parent() != NULL && attribute->get_parent() != this)) {
      fprintf(stderr,
              "REX_AST_INVARIANT[statement-attribute-list-owner]: list=%p "
              "contains null or multiply-owned attribute=%p\n",
              static_cast<void *>(this), static_cast<void *>(attribute));
      ROSE_ABORT();
    }
    attribute->set_parent(this);
  }
}

const SgStatementAttributePtrList &$CLASSNAME::get_attributes() const {
  validate();
  return p_attributes;
}

void $CLASSNAME::append_attribute(SgStatementAttribute *attribute) {
  if (attribute == NULL || attribute->get_parent() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[statement-attribute-list-owner]: list=%p cannot "
            "append null or owned attribute=%p owner=%p\n",
            static_cast<void *>(this), static_cast<void *>(attribute),
            static_cast<void *>(attribute != NULL ? attribute->get_parent()
                                                  : NULL));
    ROSE_ABORT();
  }
  attribute->validate();
  p_attributes.push_back(attribute);
  attribute->set_parent(this);
}

void $CLASSNAME::validate() const {
  for (SgStatementAttribute *attribute : p_attributes) {
    if (attribute == NULL || attribute->get_parent() != this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[statement-attribute-list-owner]: list=%p "
              "contains attribute=%p with owner=%p\n",
              static_cast<const void *>(this), static_cast<void *>(attribute),
              static_cast<void *>(attribute != NULL ? attribute->get_parent()
                                                    : NULL));
      ROSE_ABORT();
    }
    attribute->validate();
  }
}
SOURCE_STATEMENT_ATTRIBUTE_LIST_END

HEADER_FUNCTION_PARAMETER_TYPE_LIST_START

SgFunctionParameterScope *get_source_parameter_scope() const;
SgFunctionParameterList *get_source_parameters() const;
void initialize_source_prototype(SgFunctionParameterScope *scope,
                                 SgFunctionParameterList *parameters,
                                 SgScopeStatement *enclosing_scope);
void validate_source_prototype() const;
const SgTypePtrList &get_arguments() const;

//! Get the typed, per-position identities used to qualify argument
//! types.
const SgFunctionTypeArgumentPtrList &
get_argument_qualification_use_sites() const;

//! Reject any divergence between argument types and their position
//! identities.
void validate_argument_qualification_use_sites(const char *context) const;

//! Append new argument to argument type list
void append_argument(SgType *what);
void append_argument(SgType *what, const SgFunctionTypeArgument &source);

//! Insert new argument to argument type list
void insert_argument(size_t index, SgType *what);

//! Replace an argument type while retaining its exact qualification use site.
void replace_argument(size_t index, SgType *what);

SgFunctionParameterTypeList();

HEADER_FUNCTION_PARAMETER_TYPE_LIST_END

SOURCE_FUNCTION_PARAMETER_TYPE_LIST_START
SgFunctionParameterScope *$CLASSNAME::get_source_parameter_scope() const {
  return p_source_parameter_scope;
}

SgFunctionParameterList *$CLASSNAME::get_source_parameters() const {
  return p_source_parameters;
}

void $CLASSNAME::initialize_source_prototype(
    SgFunctionParameterScope *scope, SgFunctionParameterList *parameters,
    SgScopeStatement *enclosing_scope) {
  ROSE_ASSERT(p_source_parameter_scope == nullptr &&
              p_source_parameters == nullptr);
  ROSE_ASSERT(p_arguments.empty());
  ROSE_ASSERT(scope != nullptr && scope->get_parent() == nullptr);
  ROSE_ASSERT(parameters != nullptr && parameters->get_parent() == nullptr);
  ROSE_ASSERT(parameters->get_args().empty());
  ROSE_ASSERT(enclosing_scope != nullptr && enclosing_scope != scope);
  ROSE_ASSERT(scope->get_construction_physical_output_owner() == nullptr);
  ROSE_ASSERT(scope->get_construction_semantic_scope() == nullptr);
  ROSE_ASSERT(scope->get_completed_semantic_scope() == nullptr);
  p_source_parameter_scope = scope;
  p_source_parameters = parameters;
  scope->set_completed_semantic_scope(enclosing_scope);
  scope->set_parent(this);
  parameters->set_parent(this);
}

void $CLASSNAME::validate_source_prototype() const {
  ROSE_ASSERT((p_source_parameter_scope == nullptr) ==
              (p_source_parameters == nullptr));
  if (p_source_parameters == nullptr)
    return;
  ROSE_ASSERT(p_source_parameter_scope->get_parent() == this);
  ROSE_ASSERT(p_source_parameters->get_parent() == this);
  ROSE_ASSERT(
      p_source_parameter_scope->get_construction_physical_output_owner() ==
      nullptr);
  ROSE_ASSERT(p_source_parameter_scope->get_construction_semantic_scope() ==
              nullptr);
  ROSE_ASSERT(p_source_parameter_scope->get_completed_semantic_scope() !=
              nullptr);
  ROSE_ASSERT(p_source_parameter_scope->get_completed_semantic_scope() !=
              p_source_parameter_scope);
  size_t count = p_arguments.size();
  if (count != 0 && isSgTypeEllipse(p_arguments.back()))
    --count;
  ROSE_ASSERT(p_source_parameters->get_args().size() == count);
  for (SgInitializedName *parameter : p_source_parameters->get_args()) {
    ROSE_ASSERT(parameter != nullptr &&
                parameter->get_parent() == p_source_parameters);
    ROSE_ASSERT(parameter->get_scope() == p_source_parameter_scope);
    ROSE_ASSERT(!SageInterface::containsUnknownType(parameter->get_type()));
    ROSE_ASSERT(parameter->get_declptr() == nullptr);
    if (!parameter->get_name().getString().empty()) {
      SgSymbol *symbol =
          p_source_parameter_scope->find_symbol_from_declaration(parameter);
      ROSE_ASSERT(symbol != nullptr && symbol->get_symbol_basis() == parameter);
      ROSE_ASSERT(symbol->get_parent() ==
                  p_source_parameter_scope->get_symbol_table());
    }
  }
}

const SgTypePtrList &$CLASSNAME::get_arguments() const { return p_arguments; }

const SgFunctionTypeArgumentPtrList &
$CLASSNAME::get_argument_qualification_use_sites() const {
  return p_argument_qualification_use_sites;
}

void $CLASSNAME::validate_argument_qualification_use_sites(
    const char *context) const {
  if (p_arguments.size() != p_argument_qualification_use_sites.size()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-argument-qualification-use-site]: "
            "context=%s has %zu argument types but %zu position identities\n",
            context != NULL ? context : "<unknown>", p_arguments.size(),
            p_argument_qualification_use_sites.size());
    ROSE_ABORT();
  }
  for (size_t index = 0; index < p_arguments.size(); ++index) {
    SgType *argument_type = p_arguments[index];
    SgFunctionTypeArgument *position =
        p_argument_qualification_use_sites[index];
    if (argument_type == NULL || position == NULL ||
        std::find(p_argument_qualification_use_sites.begin(),
                  p_argument_qualification_use_sites.begin() + index,
                  position) !=
            p_argument_qualification_use_sites.begin() + index ||
        position->get_type() != argument_type ||
        position->get_parent() != this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[function-argument-qualification-use-site]: "
              "context=%s argument=%zu lacks a unique exact owned position "
              "identity\n",
              context != NULL ? context : "<unknown>", index);
      ROSE_ABORT();
    }
  }
}

void $CLASSNAME::append_argument(SgType *what) {
  insert_argument(p_arguments.size(), what);
}

void $CLASSNAME::append_argument(SgType *what,
                                 const SgFunctionTypeArgument &source) {
  ASSERT_not_null(what);
  auto qualification_tokens = source.get_source_type_qualification_tokens();
  append_argument(what);
  SgFunctionTypeArgument *position = p_argument_qualification_use_sites.back();
  position->set_is_pack_expansion(source.get_is_pack_expansion());
  position->set_source_type_qualification_present(
      source.get_source_type_qualification_present());
  position->set_source_type_global_qualification(
      source.get_source_type_global_qualification());
  position->get_source_type_qualification_tokens() =
      std::move(qualification_tokens);
  position->set_source_type_elaboration_required(
      source.get_source_type_elaboration_required());
}

void $CLASSNAME::replace_argument(size_t index, SgType *what) {
  ASSERT_not_null(what);
  if (p_arguments.size() != p_argument_qualification_use_sites.size() ||
      index >= p_arguments.size()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-argument-qualification-use-site]: "
            "replacement index %zu has no exact argument identity in %zu/%zu "
            "containers\n",
            index, p_arguments.size(),
            p_argument_qualification_use_sites.size());
    ROSE_ABORT();
  }
  SgFunctionTypeArgument *qualification_use_site =
      p_argument_qualification_use_sites[index];
  if (qualification_use_site == NULL ||
      qualification_use_site->get_parent() != this ||
      qualification_use_site->get_type() != p_arguments[index]) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-argument-qualification-use-site]: "
            "replacement index %zu has a malformed qualification identity\n",
            index);
    ROSE_ABORT();
  }
  p_arguments[index] = what;
  qualification_use_site->replace_type(what, this);
}

void $CLASSNAME::insert_argument(size_t index, SgType *what) {
  ASSERT_not_null(what);
  if (p_arguments.size() != p_argument_qualification_use_sites.size()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-argument-qualification-use-site]: "
            "argument and qualification-identity containers diverged before "
            "insertion\n");
    ROSE_ABORT();
  }
  if (index > p_arguments.size()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-argument-qualification-use-site]: "
            "insertion index %zu exceeds argument count %zu\n",
            index, p_arguments.size());
    ROSE_ABORT();
  }

  auto qualification_use_site = std::make_unique<SgFunctionTypeArgument>(what);
  p_arguments.insert(p_arguments.begin() + index, what);
  try {
    p_argument_qualification_use_sites.insert(
        p_argument_qualification_use_sites.begin() + index,
        qualification_use_site.get());
  } catch (...) {
    p_arguments.erase(p_arguments.begin() + index);
    throw;
  }
  qualification_use_site->set_parent(this);
  qualification_use_site.release();
}

SgFunctionParameterTypeList::SgFunctionParameterTypeList()
    : p_source_parameter_scope(nullptr), p_source_parameters(nullptr) {}

SOURCE_FUNCTION_PARAMETER_TYPE_LIST_END

SOURCE_TEMPLATE_PARAMETER_START

void SgTemplateParameter::post_construction_initialization() {
  preventConstructionOnStack(this);
  if (p_parameterType == nontype_parameter &&
      p_canonicalNonTypeParameter == nullptr) {
    p_canonicalNonTypeParameter = this;
  }
  (void)get_canonicalNonTypeParameter();
}

SgTemplateParameter *
SgTemplateParameter::get_canonicalNonTypeParameter() const {
  if (p_parameterType != nontype_parameter) {
    ROSE_ASSERT(p_canonicalNonTypeParameter == nullptr);
    return nullptr;
  }
  ASSERT_not_null(p_canonicalNonTypeParameter);
  ROSE_ASSERT(p_canonicalNonTypeParameter->get_parameterType() ==
              nontype_parameter);
  ROSE_ASSERT(p_canonicalNonTypeParameter->p_canonicalNonTypeParameter ==
              p_canonicalNonTypeParameter);
  return p_canonicalNonTypeParameter;
}

const std::optional<SgTemplateParameter::canonical_source_identity> &
SgTemplateParameter::get_canonical_source_identity() const {
  return p_canonical_source_identity;
}

void SgTemplateParameter::initialize_canonical_source_identity(
    const canonical_source_identity &identity) {
  if (get_parameterType() != nontype_parameter ||
      identity.expansion_file_id < 0 || identity.spelling_file_id < 0 ||
      p_canonical_source_identity.has_value()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[non-type-parameter-source-identity]: "
            "parameter=%p has no valid uninitialized source identity\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  const SgTemplateParameter *canonical = get_canonicalNonTypeParameter();
  if (canonical != this &&
      (!canonical->p_canonical_source_identity.has_value() ||
       !(*canonical->p_canonical_source_identity == identity))) {
    fprintf(stderr,
            "REX_AST_INVARIANT[non-type-parameter-source-identity]: "
            "parameter=%p disagrees with canonical parameter=%p\n",
            static_cast<void *>(this), static_cast<const void *>(canonical));
    ROSE_ABORT();
  }
  p_canonical_source_identity = identity;
}

// Delegate to the generated field initialization.
SgTemplateParameter::SgTemplateParameter(SgType *parameter,
                                         SgType *defaultParameter)
    : SgTemplateParameter(type_parameter, parameter, defaultParameter, nullptr,
                          nullptr, nullptr, nullptr) {}

SgName SgTemplateParameter::get_mangled_name(void) const {

  ostringstream mangled_name;
  switch (get_parameterType()) {
  case SgTemplateParameter::type_parameter: {
    const SgType *type = get_type();
    ASSERT_not_null(type);
    mangled_name << type->get_mangled().str();
    break;
  }

  case SgTemplateParameter::nontype_parameter: {
    ROSE_ASSERT(get_initializedName() != nullptr);
    const SgType *type = get_type();
    ASSERT_not_null(type);
    ROSE_ASSERT(get_initializedName()->get_parent() == this);
    ROSE_ASSERT(get_initializedName()->get_type() == type);
    mangled_name << "__nontype_" << type->get_mangled().str();
    break;
  }

  case SgTemplateParameter::template_parameter: {
    const SgDeclarationStatement *templateDeclaration =
        get_templateDeclaration();
    ROSE_ASSERT(templateDeclaration != NULL);
    mangled_name << templateDeclaration->get_mangled_name().str();
    break;
  }

  default: {
    MLOG_INFO_C("ROSETTA",
                "ERROR: In SgTemplateParameter::get_mangled_name(): default "
                "reached in switch: get_parameterType() = %d \n",
                get_parameterType());
    ROSE_ASSERT(false);
    break;
  }
  }

  string str_mangled_name(mangled_name.str());

  // Encode parameter pack distinction so packs don't collide with non-pack
  // manglings.
  if (get_is_parameter_pack()) {
    str_mangled_name += "__pack";
  }

  return str_mangled_name;
}

SOURCE_TEMPLATE_PARAMETER_END

SOURCE_TEMPLATE_ARGUMENT_START

namespace {
SgType *requiredTemplateArgumentType(SgType *type) {
  if (SageInterface::containsUnknownType(type)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[template-argument-construction]: type "
            "argument requires an exact semantic type\n");
    ROSE_ABORT();
  }
  return type;
}

SgType *requiredNonTypeTemplateArgumentType(SgExpression *argument) {
  SgType *type = argument != nullptr ? argument->get_type() : nullptr;
  if (argument == nullptr || argument->get_parent() != nullptr ||
      SageInterface::containsUnknownType(type)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[template-argument-construction]: non-type "
            "argument requires a detached expression with an exact value "
            "type\n");
    ROSE_ABORT();
  }
  return type;
}

SgTemplateDeclaration *
requiredTemplateArgumentDeclaration(SgTemplateDeclaration *declaration) {
  if (declaration == nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[template-argument-construction]: template "
            "argument requires an exact template declaration\n");
    ROSE_ABORT();
  }
  return declaration;
}
} // namespace

void SgTemplateArgument::post_construction_initialization() {
  preventConstructionOnStack(this);
  if (p_expression != nullptr) {
    ROSE_ASSERT(p_expression->get_parent() == nullptr);
    p_expression->set_parent(this);
  }
}

SgTemplateArgument::SgTemplateArgument(SgType *argument,
                                       bool explicitlySpecified,
                                       SgType *sourceSpelledType)
    : SgTemplateArgument(type_argument, false,
                         requiredTemplateArgumentType(argument), nullptr,
                         nullptr, explicitlySpecified) {
  if (sourceSpelledType != nullptr) {
    p_sourceSpelledType = requiredTemplateArgumentType(sourceSpelledType);
    if (sourceSpelledType->has_source_prototype()) {
      ROSE_ASSERT(sourceSpelledType->get_parent() == nullptr);
      sourceSpelledType->set_parent(this);
    }
  }
}

SgTemplateArgument::SgTemplateArgument(SgExpression *argument,
                                       bool explicitlySpecified)
    : SgTemplateArgument(nontype_argument, false,
                         requiredNonTypeTemplateArgumentType(argument),
                         argument, nullptr, explicitlySpecified) {}

SgTemplateArgument::SgTemplateArgument(SgTemplateDeclaration *argument,
                                       bool explicitlySpecified)
    : SgTemplateArgument(template_template_argument, false, nullptr, nullptr,
                         requiredTemplateArgumentDeclaration(argument),
                         explicitlySpecified) {}

SgTemplateArgument::SgTemplateArgument(bool explicitlySpecified)
    : SgTemplateArgument(start_of_pack_expansion_argument, false, nullptr,
                         nullptr, nullptr, explicitlySpecified) {}

SgName SgTemplateArgument::get_mangled_name(void) const {

  ostringstream mangled_name;
  switch (get_argumentType()) {
  case SgTemplateArgument::type_argument: {
    const SgType *type = get_type();
    ROSE_ASSERT(type != NULL);
    SgName mangled_type = type->get_mangled();

    mangled_name << mangled_type.str();
    break;
  }

  case SgTemplateArgument::nontype_argument: {
    const SgExpression *expr = get_expression();
    ROSE_ASSERT(expr != nullptr);
    mangled_name << mangleExpression(expr);
    break;
  }

  case SgTemplateArgument::template_template_argument: {
    const SgDeclarationStatement *templateDeclaration =
        get_templateDeclaration();
    ROSE_ASSERT(templateDeclaration != NULL);

    SgName mangled_templateDeclaration =
        templateDeclaration->get_mangled_name();

    mangled_name << mangled_templateDeclaration.str();
    break;
  }

  case SgTemplateArgument::start_of_pack_expansion_argument: {
    mangled_name << "start_of_pack_expansion_argument";
    break;
  }

  default: {
    fprintf(stderr,
            "REX_AST_INVARIANT[template-argument-mangle]: argument=%p has "
            "invalid kind=%d\n",
            static_cast<const void *>(this), get_argumentType());
    ROSE_ABORT();
  }
  }

  return mangled_name.str();
}

SgScopeStatement *SgTemplateArgument::get_scope() const {
  const SgNode *parentNode = this;
  while ((isSgScopeStatement(parentNode) == NULL) &&
         (parentNode->get_parent() != NULL)) {
    parentNode = parentNode->get_parent();
  }
  if (const SgScopeStatement *scope = isSgScopeStatement(parentNode))
    return const_cast<SgScopeStatement *>(scope);
  if (dynamic_cast<const SgType *>(parentNode) != NULL ||
      dynamic_cast<const SgSymbol *>(parentNode) != NULL)
    return NULL;
  fprintf(stderr,
          "REX_AST_INVARIANT[template-argument-scope]: argument=%p has "
          "no enclosing scope; parent chain ends at %p/%s\n",
          static_cast<const void *>(this), static_cast<const void *>(parentNode),
          parentNode->class_name().c_str());
  ROSE_ABORT();
}

// Qualification metadata must not set isModified: qualification alone does not
