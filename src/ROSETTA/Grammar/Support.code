void SgFunctionModifier::unsetOpenclWorkGroupSizeReq() {
  unsetBit(e_opencl_work_group_size_req, p_modifierVector);
}

// DQ (4/13/2019): Added C++11 options for function modifiers.
bool SgFunctionModifier::isMarkedDefault() const {
  return checkBit(e_marked_default, p_modifierVector);
}
void SgFunctionModifier::setMarkedDefault() {
  setBit(e_marked_default, p_modifierVector);
}
void SgFunctionModifier::unsetMarkedDefault() {
  unsetBit(e_marked_default, p_modifierVector);
}

// DQ (4/13/2019): Added C++11 options for function modifiers.
bool SgFunctionModifier::isMarkedDelete() const {
  return checkBit(e_marked_delete, p_modifierVector);
}
void SgFunctionModifier::setMarkedDelete() {
  setDeleted(true);
  setBit(e_marked_delete, p_modifierVector);
}
void SgFunctionModifier::unsetMarkedDelete() {
  unsetBit(e_marked_delete, p_modifierVector);
}

bool SgFunctionModifier::isDeleted() const {
  return checkBit(e_cxx_deleted, p_modifierVector);
}

void SgFunctionModifier::setDeleted(bool deleted) {
  ROSE_ASSERT(deleted || !isMarkedDelete());
  p_modifierVector[e_cxx_deleted] = deleted;
}

bool SgFunctionModifier::hasSpecialMemberProperties() const {
  const bool trivial = checkBit(e_cxx_trivial_special_member, p_modifierVector);
  const bool nontrivial =
      checkBit(e_cxx_nontrivial_special_member, p_modifierVector);
  ROSE_ASSERT(!(trivial && nontrivial));
  return trivial || nontrivial;
}

bool SgFunctionModifier::isDefaultConstructor() const {
  ROSE_ASSERT(hasSpecialMemberProperties());
  return checkBit(e_cxx_default_constructor, p_modifierVector);
}

bool SgFunctionModifier::isTrivialSpecialMember() const {
  ROSE_ASSERT(hasSpecialMemberProperties());
  return checkBit(e_cxx_trivial_special_member, p_modifierVector);
}

bool SgFunctionModifier::isIneligibleSpecialMember() const {
  ROSE_ASSERT(hasSpecialMemberProperties());
  return checkBit(e_cxx_ineligible_special_member, p_modifierVector);
}

void SgFunctionModifier::setSpecialMemberProperties(bool is_default,
                                                  bool is_trivial,
                                                  bool is_ineligible) {
  p_modifierVector[e_cxx_default_constructor] = is_default;
  p_modifierVector[e_cxx_trivial_special_member] = is_trivial;
  p_modifierVector[e_cxx_nontrivial_special_member] = !is_trivial;
  p_modifierVector[e_cxx_ineligible_special_member] = is_ineligible;
}

SgFunctionModifier::copy_move_kind_enum
SgFunctionModifier::getCopyMoveKind() const {
  copy_move_kind_enum result = e_copy_move_none;
  for (auto entry :
       {std::make_pair(e_cxx_copy_constructor, e_copy_constructor),
        std::make_pair(e_cxx_move_constructor, e_move_constructor),
        std::make_pair(e_cxx_copy_assignment, e_copy_assignment),
        std::make_pair(e_cxx_move_assignment, e_move_assignment)}) {
    if (checkBit(entry.first, p_modifierVector)) {
      ROSE_ASSERT(result == e_copy_move_none);
      result = entry.second;
    }
  }
  return result;
}

void SgFunctionModifier::setCopyMoveKind(copy_move_kind_enum kind) {
  ROSE_ASSERT(kind >= e_copy_move_none && kind <= e_move_assignment);
  ROSE_ASSERT(getCopyMoveKind() == e_copy_move_none ||
              getCopyMoveKind() == kind);
  p_modifierVector[e_cxx_copy_constructor] = kind == e_copy_constructor;
  p_modifierVector[e_cxx_move_constructor] = kind == e_move_constructor;
  p_modifierVector[e_cxx_copy_assignment] = kind == e_copy_assignment;
  p_modifierVector[e_cxx_move_assignment] = kind == e_move_assignment;
}

SgFunctionModifier::destructor_properties_enum
SgFunctionModifier::getDestructorProperties() const {
  destructor_properties_enum result = e_destructor_unclassified;
  for (auto entry :
       {std::make_pair(e_cxx_dependent_destructor, e_destructor_dependent),
        std::make_pair(e_cxx_unselected_destructor, e_destructor_unselected),
        std::make_pair(e_cxx_trivial_destructor, e_destructor_selected_trivial),
        std::make_pair(e_cxx_nontrivial_destructor,
                       e_destructor_selected_nontrivial)}) {
    if (checkBit(entry.first, p_modifierVector)) {
      ROSE_ASSERT(result == e_destructor_unclassified);
      result = entry.second;
    }
  }
  return result;
}

void SgFunctionModifier::setDestructorProperties(
    destructor_properties_enum properties) {
  ROSE_ASSERT(properties >= e_destructor_dependent &&
              properties <= e_destructor_selected_nontrivial);
  ROSE_ASSERT(getDestructorProperties() == e_destructor_unclassified ||
              getDestructorProperties() == properties);
  p_modifierVector[e_cxx_dependent_destructor] =
      properties == e_destructor_dependent;
  p_modifierVector[e_cxx_unselected_destructor] =
      properties == e_destructor_unselected;
  p_modifierVector[e_cxx_trivial_destructor] =
      properties == e_destructor_selected_trivial;
  p_modifierVector[e_cxx_nontrivial_destructor] =
      properties == e_destructor_selected_nontrivial;
}

string SgFunctionModifier::displayString() const {
  std::string s = "SgFunctionModifier(";
  s += std::string("isUnknown() = ") +
       std::string(isUnknown() ? "true " : "false ");
  s += std::string("isDefault() = ") +
       std::string(isDefault() ? "true " : "false ");
  s += std::string("isInline() = ") +
       std::string(isInline() ? "true " : "false ");
  s += std::string("isVirtual() = ") +
       std::string(isVirtual() ? "true " : "false ");
  s += std::string("isPureVirtual() = ") +
       std::string(isPureVirtual() ? "true " : "false ");
  s += std::string("isExplicit() = ") +
       std::string(isExplicit() ? "true " : "false ");
  // s += std::string("isBind() = ")             + std::string(isBind() ? "true
  // " : "false ");
  s += std::string("isPure() = ") + std::string(isPure() ? "true " : "false ");

  // DQ (2/26/2013): Bug report noticed that a set of these attributes were not
  // properly support.
  s += std::string("isElemental() = ") +
       std::string(isElemental() ? "true " : "false ");
  s += std::string("isRecursive() = ") +
       std::string(isRecursive() ? "true " : "false ");
  s += std::string("isGnuAttributeConstructor() = ") +
       std::string(isGnuAttributeConstructor() ? "true " : "false ");
  s += std::string("isGnuAttributeDestructor() = ") +
       std::string(isGnuAttributeDestructor() ? "true " : "false ");
  s += std::string("isGnuAttributePure() = ") +
       std::string(isGnuAttributePure() ? "true " : "false ");
  s += std::string("isGnuAttributeWeak() = ") +
       std::string(isGnuAttributeWeak() ? "true " : "false ");
  s += std::string("isGnuAttributeUnused() = ") +
       std::string(isGnuAttributeUnused() ? "true " : "false ");
  s += std::string("isGnuAttributeUsed() = ") +
       std::string(isGnuAttributeUsed() ? "true " : "false ");
  s += std::string("isGnuAttributeDeprecated() = ") +
       std::string(isGnuAttributeDeprecated() ? "true " : "false ");
  s += std::string("isGnuAttributeMalloc() = ") +
       std::string(isGnuAttributeMalloc() ? "true " : "false ");
  s += std::string("isGnuAttributeNaked() = ") +
       std::string(isGnuAttributeNaked() ? "true " : "false ");
  s += std::string("isGnuAttributeNoInstrumentFunction() = ") +
       std::string(isGnuAttributeNoInstrumentFunction() ? "true " : "false ");
  s += std::string("isGnuAttributeNoCheckMemoryUsage() = ") +
       std::string(isGnuAttributeNoCheckMemoryUsage() ? "true " : "false ");
  s += std::string("isGnuAttributeNoInline() = ") +
       std::string(isGnuAttributeNoInline() ? "true " : "false ");
  s += std::string("isGnuAttributeAlwaysInline() = ") +
       std::string(isGnuAttributeAlwaysInline() ? "true " : "false ");
  s += std::string("isGnuAttributeNoThrow() = ") +
       std::string(isGnuAttributeNoThrow() ? "true " : "false ");
  s += std::string("isGnuAttributeWeakReference() = ") +
       std::string(isGnuAttributeWeakReference() ? "true " : "false ");
  s += std::string("gnuAttributeNonnullArgumentSetCount() = ") +
       Rose::StringUtility::numberToString(
           get_gnu_attribute_nonnull_parameter_index_lists().size()) +
       " ";

  s += ")";
  return s;
}

void SgFunctionModifier::display(std::string label) const {
  // DQ (6/25/2020): If we call display, then we mean for it to be displayed,
  // not hidden.
  printf("In $CLASSNAME::display(%s) \n", label.c_str());
  printf("%s \n", displayString().c_str());
}

std::ostream &operator<<(std::ostream &os, const SgFunctionModifier &m) {
  os << m.get_modifierVector();
  return os;
}

std::ostream &operator<<(std::ostream &os, const std::vector<bool> &bv) {
  for (bool bit : bv)
    os << (bit ? 'T' : 'F');
  return os;
}

bool operator==(const $CLASSNAME &lhs, const $CLASSNAME &rhs) {
  const bool sameOpenclVecType =
      lhs.p_opencl_vec_type == rhs.p_opencl_vec_type ||
      (lhs.p_opencl_vec_type != nullptr && rhs.p_opencl_vec_type != nullptr &&
       SageInterface::isEquivalentType(lhs.p_opencl_vec_type,
                                       rhs.p_opencl_vec_type));
  return lhs.p_modifierVector == rhs.p_modifierVector &&
         lhs.p_gnu_attribute_constructor_destructor_priority ==
             rhs.p_gnu_attribute_constructor_destructor_priority &&
         lhs.p_gnu_attribute_named_alias == rhs.p_gnu_attribute_named_alias &&
         lhs.p_gnu_attribute_nonnull_parameter_index_lists ==
             rhs.p_gnu_attribute_nonnull_parameter_index_lists &&
         sameOpenclVecType &&
         lhs.p_opencl_work_group_size.x == rhs.p_opencl_work_group_size.x &&
         lhs.p_opencl_work_group_size.y == rhs.p_opencl_work_group_size.y &&
         lhs.p_opencl_work_group_size.z == rhs.p_opencl_work_group_size.z;
}

void SgFunctionModifier::reset() { *this = SgFunctionModifier(); }

