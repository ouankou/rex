}

bool SgLocatedNode::isShared() const {
  ROSE_ASSERT(get_startOfConstruct() != NULL);

  bool result = get_startOfConstruct()->isShared();

  if (get_endOfConstruct() == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[located-node-file-info]: node=%p type=%s has "
            "no end-of-construct while querying shared state\n",
            static_cast<const void *>(this), this->class_name().c_str());
    ROSE_ABORT();
  }
  ROSE_ASSERT(result == get_endOfConstruct()->isShared());

  const SgExpression *expression = isSgExpression(this);
  if (expression != NULL && expression->get_operatorPosition() != NULL) {
    if (result != expression->get_operatorPosition()->isShared()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[located-node-shared-state]: expression=%p "
              "type=%s has inconsistent operator-position state\n",
              static_cast<const void *>(this), this->class_name().c_str());
      ROSE_ABORT();
    }
  }

  return result;
}

