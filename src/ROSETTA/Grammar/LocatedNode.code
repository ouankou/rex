int SgLocatedNode::get_physical_file_id() const {
  ROSE_ASSERT(get_startOfConstruct() != NULL);
  ROSE_ASSERT(get_endOfConstruct() != NULL);
  ROSE_ASSERT(get_startOfConstruct()->get_physical_file_id() ==
              get_endOfConstruct()->get_physical_file_id());

  const SgExpression *expression = isSgExpression(this);
  if (expression != NULL && expression->get_operatorPosition() != NULL) {
    ROSE_ASSERT(expression->get_operatorPosition()->get_physical_file_id() ==
                get_endOfConstruct()->get_physical_file_id());
  }

  return get_startOfConstruct()->get_physical_file_id();
}

// [MK] Member function to attach PreprocessingInfo object to the node
namespace {
bool isValidAttachedPreprocessingPosition(
    PreprocessingInfo::RelativePositionType position) {
  return position == PreprocessingInfo::before ||
         position == PreprocessingInfo::after ||
         position == PreprocessingInfo::inside ||
         position == PreprocessingInfo::before_syntax ||
         position == PreprocessingInfo::after_syntax;
}

void requireValidPreprocessingInsertion(
    SgLocatedNode::PreprocessingInfoInsertion insertion) {
  if (insertion != SgLocatedNode::PreprocessingInfoInsertion::front &&
      insertion != SgLocatedNode::PreprocessingInfoInsertion::back) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attachment-order]: invalid "
            "insertion order=%d\n",
            static_cast<int>(insertion));
    ROSE_ABORT();
  }
}

void requirePublishablePreprocessingRecord(
    PreprocessingInfo *record,
    PreprocessingInfo::RelativePositionType position) {
  if (record == nullptr || !record->has_file_info() ||
      record->get_file_info()->isShared() ||
      record->getTypeOfDirective() <=
          PreprocessingInfo::CpreprocessorUnknownDeclaration ||
      record->getTypeOfDirective() >= PreprocessingInfo::LastDirectiveType ||
      !isValidAttachedPreprocessingPosition(position)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attachment-record]: record=%p "
            "position=%d is not a complete uniquely publishable record\n",
            static_cast<void *>(record), static_cast<int>(position));
    ROSE_ABORT();
  }
}
} // namespace

void SgLocatedNode::validateAttachedPreprocessingInfoOwnership() const {
  if (p_attachedPreprocessingInfoPtr == nullptr) {
    return;
  }
  // Validate a complete list only at an explicit AST contract boundary.
  // Typed mutations below establish ownership before publishing a record and
  // therefore require only the record-local owner check.  Rescanning the
  // complete list before every append made comment collection quadratic for
  // nodes that legitimately own many preprocessing records.
  std::unordered_set<const PreprocessingInfo *> records;
  records.reserve(p_attachedPreprocessingInfoPtr->size());
  for (size_t index = 0; index < p_attachedPreprocessingInfoPtr->size();
       ++index) {
    PreprocessingInfo *record = (*p_attachedPreprocessingInfoPtr)[index];
    if (record == nullptr || !records.insert(record).second ||
        record->getAttachedOwner() != this ||
        record->get_file_info()->get_parent() != this ||
        !isValidAttachedPreprocessingPosition(record->getRelativePosition())) {
      fprintf(stderr,
              "REX_AST_INVARIANT[preprocessing-attachment-list]: owner list "
              "contains a record without exact owner identity at index=%zu\n",
              index);
      ROSE_ABORT();
    }
  }
}

void SgLocatedNode::attachPreprocessingInfo(
    PreprocessingInfo *record, PreprocessingInfo::RelativePositionType position,
    PreprocessingInfoInsertion insertion) {
  requirePublishablePreprocessingRecord(record, position);
  requireValidPreprocessingInsertion(insertion);
  if (record->getAttachedOwner() != nullptr ||
      record->get_file_info()->get_parent() != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attachment-owner]: record is "
            "not uniquely detached\n");
    ROSE_ABORT();
  }
  if (p_attachedPreprocessingInfoPtr == nullptr) {
    p_attachedPreprocessingInfoPtr = new AttachedPreprocessingInfoType;
  }
  if (insertion == PreprocessingInfoInsertion::front) {
    p_attachedPreprocessingInfoPtr->insert(
        p_attachedPreprocessingInfoPtr->begin(), record);
  } else {
    p_attachedPreprocessingInfoPtr->push_back(record);
  }
  record->setRelativePosition(position);
  record->claimAttachedOwner(this);
}

void SgLocatedNode::attachPreprocessingInfoRelative(
    PreprocessingInfo *record, PreprocessingInfo::RelativePositionType position,
    PreprocessingInfo *anchor, bool insertAfter) {
  requirePublishablePreprocessingRecord(record, position);
  if (anchor == nullptr || p_attachedPreprocessingInfoPtr == nullptr ||
      anchor->getAttachedOwner() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attachment-anchor]: owner=%p "
            "record=%p anchor=%p is not exactly owned\n",
            static_cast<void *>(this), static_cast<void *>(record),
            static_cast<void *>(anchor));
    ROSE_ABORT();
  }
  auto anchorPosition =
      std::find(p_attachedPreprocessingInfoPtr->begin(),
                p_attachedPreprocessingInfoPtr->end(), anchor);
  if (anchorPosition == p_attachedPreprocessingInfoPtr->end()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attachment-anchor]: owner=%p "
            "record=%p anchor=%p is absent\n",
            static_cast<void *>(this), static_cast<void *>(record),
            static_cast<void *>(anchor));
    ROSE_ABORT();
  }
  if (record->getAttachedOwner() != nullptr ||
      record->get_file_info()->get_parent() != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attachment-owner]: record is "
            "not uniquely detached\n");
    ROSE_ABORT();
  }
  p_attachedPreprocessingInfoPtr->insert(
      insertAfter ? anchorPosition + 1 : anchorPosition, record);
  record->setRelativePosition(position);
  record->claimAttachedOwner(this);
}

PreprocessingInfo *
SgLocatedNode::detachPreprocessingInfo(PreprocessingInfo *record) {
  if (record == nullptr || p_attachedPreprocessingInfoPtr == nullptr ||
      record->getAttachedOwner() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-detachment-owner]: owner=%p "
            "record=%p recorded-owner=%p is not attached here\n",
            static_cast<void *>(this), static_cast<void *>(record),
            record != nullptr ? static_cast<void *>(record->getAttachedOwner())
                              : nullptr);
    ROSE_ABORT();
  }
  auto position = std::find(p_attachedPreprocessingInfoPtr->begin(),
                            p_attachedPreprocessingInfoPtr->end(), record);
  if (position == p_attachedPreprocessingInfoPtr->end()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-detachment-owner]: owner=%p "
            "record=%p is absent from its recorded owner\n",
            static_cast<void *>(this), static_cast<void *>(record));
    ROSE_ABORT();
  }
  p_attachedPreprocessingInfoPtr->erase(position);
  record->releaseAttachedOwner(this);
  if (p_attachedPreprocessingInfoPtr->empty()) {
    delete p_attachedPreprocessingInfoPtr;
    p_attachedPreprocessingInfoPtr = nullptr;
  }
  return record;
}

void SgLocatedNode::transferPreprocessingInfo(
    PreprocessingInfo *record, SgLocatedNode *destination,
    PreprocessingInfo::RelativePositionType destinationPosition,
    PreprocessingInfoInsertion insertion) {
  if (destination == nullptr || destination == this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-transfer-owner]: source=%p "
            "destination=%p record=%p has no distinct destination\n",
            static_cast<void *>(this), static_cast<void *>(destination),
            static_cast<void *>(record));
    ROSE_ABORT();
  }
  requirePublishablePreprocessingRecord(record, destinationPosition);
  requireValidPreprocessingInsertion(insertion);
  if (record->getAttachedOwner() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-transfer-owner]: source=%p "
            "destination=%p record=%p recorded-owner=%p is misowned\n",
            static_cast<void *>(this), static_cast<void *>(destination),
            static_cast<void *>(record),
            static_cast<void *>(record->getAttachedOwner()));
    ROSE_ABORT();
  }
  PreprocessingInfo::OutputPlacementType destinationPlacement =
      record->getOutputPlacement();
  if (destinationPlacement == PreprocessingInfo::source_position ||
      (destinationPlacement ==
           PreprocessingInfo::attached_output_trailing_line &&
       destinationPosition != PreprocessingInfo::after &&
       destinationPosition != PreprocessingInfo::after_syntax)) {
    destinationPlacement = PreprocessingInfo::attached_output_boundary;
  }
  if (destination->p_attachedPreprocessingInfoPtr == nullptr)
    destination->p_attachedPreprocessingInfoPtr =
        new AttachedPreprocessingInfoType;
  auto &destinationRecords = *destination->p_attachedPreprocessingInfoPtr;
  if (destinationRecords.size() == destinationRecords.capacity()) {
    ROSE_ASSERT(destinationRecords.size() < destinationRecords.max_size());
    const auto growth =
        std::min(destinationRecords.capacity() + 1,
                 destinationRecords.max_size() - destinationRecords.capacity());
    destinationRecords.reserve(destinationRecords.capacity() + growth);
  }
  record->changeAttachedOutputPlacement(this, destinationPlacement);
  detachPreprocessingInfo(record);
  destination->attachPreprocessingInfo(record, destinationPosition, insertion);
}

void SgLocatedNode::setAttachedPreprocessingInfoPosition(
    PreprocessingInfo *record,
    PreprocessingInfo::RelativePositionType position) {
  requirePublishablePreprocessingRecord(record, position);
  if (record->getAttachedOwner() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attached-position]: owner=%p "
            "record=%p recorded-owner=%p is misowned\n",
            static_cast<void *>(this), static_cast<void *>(record),
            static_cast<void *>(record->getAttachedOwner()));
    ROSE_ABORT();
  }
  record->changeAttachedPosition(this, position);
}

void SgLocatedNode::cloneAttachedPreprocessingInfoFrom(
    const SgLocatedNode *source, SgCopyHelp *help) {
  if (source == nullptr || source == this ||
      p_attachedPreprocessingInfoPtr != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-clone-owner]: source=%p "
            "destination=%p destination-list=%p is invalid\n",
            static_cast<const void *>(source), static_cast<void *>(this),
            static_cast<void *>(p_attachedPreprocessingInfoPtr));
    ROSE_ABORT();
  }
  source->validateAttachedPreprocessingInfoOwnership();
  if (source->p_attachedPreprocessingInfoPtr == nullptr) {
    return;
  }
  for (PreprocessingInfo *record : *source->p_attachedPreprocessingInfoPtr) {
    auto copy = std::make_unique<PreprocessingInfo>(*record);
    if (help == nullptr ||
        help->getProvenancePolicy() ==
            SgCopyHelp::ProvenancePolicy::TransformationOutput)
      copy->setOutputPlacement(PreprocessingInfo::attached_output_boundary);
    attachPreprocessingInfo(copy.get(), copy->getRelativePosition(),
                            PreprocessingInfoInsertion::back);
    auto *published = copy.release();
    if (help != nullptr)
      help->insertCopiedPreprocessingPair(record, published);
  }
}

void SgLocatedNode::clearAttachedPreprocessingInfo() {
  validateAttachedPreprocessingInfoOwnership();
  if (p_attachedPreprocessingInfoPtr == nullptr) {
    return;
  }
  for (PreprocessingInfo *record : *p_attachedPreprocessingInfoPtr) {
    record->releaseAttachedOwner(this);
    delete record;
  }
  delete p_attachedPreprocessingInfoPtr;
  p_attachedPreprocessingInfoPtr = nullptr;
}

void SgLocatedNode::addToAttachedPreprocessingInfo(
    PreprocessingInfo *prepInfoPtr,
    PreprocessingInfo::RelativePositionType locationInList) {
  ROSE_ASSERT(prepInfoPtr != nullptr);
  ROSE_ASSERT(dynamic_cast<SgCatchStatementSeq *>(this) == nullptr);
  ROSE_ASSERT(dynamic_cast<SgCtorInitializerList *>(this) == nullptr);

  SgFunctionParameterList *functionParameterList =
      isSgFunctionParameterList(this);
  if (functionParameterList != nullptr) {
    ROSE_ASSERT(get_startOfConstruct() != nullptr);
    ROSE_ASSERT(get_endOfConstruct() != nullptr);
  }

  // Preserve the historical front/back ordering entry point while routing all
  // ownership publication through the exact typed contract.
  switch (locationInList) {
  case PreprocessingInfo::before:
    attachPreprocessingInfo(prepInfoPtr, prepInfoPtr->getRelativePosition(),
                            PreprocessingInfoInsertion::front);
    return;

  case PreprocessingInfo::after:
    attachPreprocessingInfo(prepInfoPtr, prepInfoPtr->getRelativePosition(),
                            PreprocessingInfoInsertion::back);
    return;

  default:
    ROSE_ASSERT(false);
  }
}

// Insert prepInfo right after (or before) an existing anchor info in the
// preprocessing info list
void SgLocatedNode::insertToAttachedPreprocessingInfo(
    PreprocessingInfo *prepInfoPtr, PreprocessingInfo *anchorInfoPtr,
    bool insertAfter /*= true*/
) {
  ROSE_ASSERT(prepInfoPtr != nullptr);
  attachPreprocessingInfoRelative(prepInfoPtr,
                                  prepInfoPtr->getRelativePosition(),
                                  anchorInfoPtr, insertAfter);
}

// [MK] Member function to return attached PreprocessingInfo objects
AttachedPreprocessingInfoType *&
SgLocatedNode::getAttachedPreprocessingInfo(void) {
  return p_attachedPreprocessingInfoPtr;
}

Sg_File_Info *SgLocatedNode::generateMatchingFileInfo() {
  ROSE_ASSERT(get_startOfConstruct() != nullptr);
  Sg_File_Info *returnFileInfo = new Sg_File_Info(*(get_startOfConstruct()));
  return returnFileInfo;
}

SOURCE_END

SOURCE_RENAME_PAIR_START

bool SgRenamePair::isRename() const {
  // This a treated as a valid renaming if the names are different.
  return (p_local_name != p_use_name);
}

SOURCE_RENAME_PAIR_END

SOURCE_AUXILIARY_DECLARATION_LIST_START
void SgAuxiliaryDeclarationList::post_construction_initialization() {
  SgLocatedNode::post_construction_initialization();

  Sg_File_Info *start = get_startOfConstruct();
  Sg_File_Info *end = get_endOfConstruct();
  if (start == NULL) {
    if (end != NULL) {
      fprintf(stderr,
              "REX_AST_INVARIANT[auxiliary-container-provenance]: "
              "container=%p has an end position without a start position\n",
              static_cast<void *>(this));
      ROSE_ABORT();
    }
    start = Sg_File_Info::generateDefaultFileInfoForCompilerGeneratedNode();
    start->unsetOutputInCodeGeneration();
    p_startOfConstruct = start;
    start->set_parent(this);
  }
  if (end == NULL) {
    end = new Sg_File_Info(*start);
    p_endOfConstruct = end;
    end->set_parent(this);
  }

  validate_semantic_non_output_role();
}

void SgAuxiliaryDeclarationList::validate_semantic_non_output_role() const {
  const Sg_File_Info *start = get_startOfConstruct();
  const Sg_File_Info *end = get_endOfConstruct();
  auto is_exact_semantic_position = [this](const Sg_File_Info *position) {
    return position != NULL && position->get_parent() == this &&
           position->isCompilerGenerated() && !position->isTransformation() &&
           !position->isOutputInCodeGeneration() &&
           !position->isSourcePositionUnavailableInFrontend() &&
           position->get_file_id() == Sg_File_Info::COMPILER_GENERATED_FILE_ID;
  };
  const AttachedPreprocessingInfoType *preprocessing =
      get_attachedPreprocessingInfoPtr();
  if (!is_exact_semantic_position(start) || !is_exact_semantic_position(end) ||
      get_file_info() != start ||
      (preprocessing != NULL && !preprocessing->empty())) {
    fprintf(stderr,
            "REX_AST_INVARIANT[auxiliary-container-provenance]: "
            "container=%p start=%p start-parent=%p start-file=%d "
            "start-compiler=%d start-transform=%d start-output=%d "
            "start-unavailable=%d end=%p end-parent=%p end-file=%d "
            "end-compiler=%d end-transform=%d end-output=%d "
            "end-unavailable=%d file-info=%p preprocessing=%zu is not exact "
            "compiler-generated, non-output semantic infrastructure\n",
            static_cast<const void *>(this), static_cast<const void *>(start),
            start != NULL ? static_cast<void *>(start->get_parent()) : NULL,
            start != NULL ? start->get_file_id() : 0,
            start != NULL && start->isCompilerGenerated(),
            start != NULL && start->isTransformation(),
            start != NULL && start->isOutputInCodeGeneration(),
            start != NULL && start->isSourcePositionUnavailableInFrontend(),
            static_cast<const void *>(end),
            end != NULL ? static_cast<void *>(end->get_parent()) : NULL,
            end != NULL ? end->get_file_id() : 0,
            end != NULL && end->isCompilerGenerated(),
            end != NULL && end->isTransformation(),
            end != NULL && end->isOutputInCodeGeneration(),
            end != NULL && end->isSourcePositionUnavailableInFrontend(),
            static_cast<const void *>(get_file_info()),
            preprocessing != NULL ? preprocessing->size() : 0);
    ROSE_ABORT();
  }
}
SOURCE_AUXILIARY_DECLARATION_LIST_END

SOURCE_OMP_CLAUSE_LIST_START
void SgOmpClauseList::post_construction_initialization() {
  SgLocatedNode::post_construction_initialization();

  Sg_File_Info *start = get_startOfConstruct();
  Sg_File_Info *end = get_endOfConstruct();
  if (start == NULL) {
    if (end != NULL) {
      fprintf(stderr,
              "REX_AST_INVARIANT[openmp-clause-list-location]: list=%p has "
              "an end location without a start location\n",
              static_cast<void *>(this));
      ROSE_ABORT();
    }
    start = Sg_File_Info::generateDefaultFileInfoForTransformationNode();
    set_startOfConstruct(start);
    start->set_parent(this);
  }
  if (end == NULL) {
    end = new Sg_File_Info(*start);
    set_endOfConstruct(end);
    end->set_parent(this);
  }
}

const SgOmpClausePtrList &SgOmpClauseList::get_clauses() const {
  for (SgOmpClause *clause : p_clauses) {
    if (clause == NULL || clause->get_parent() != this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[openmp-clause-list]: list=%p contains a "
              "null clause or a clause with the wrong structural owner\n",
              static_cast<const void *>(this));
      ROSE_ABORT();
    }
  }
  return p_clauses;
}

void SgOmpClauseList::append_clause(SgOmpClause *clause) {
  if (clause == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-clause-list]: list=%p cannot append a "
            "null clause\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  if (std::find(p_clauses.begin(), p_clauses.end(), clause) !=
      p_clauses.end()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-clause-list]: list=%p cannot append the "
            "same clause twice\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  if (clause->get_parent() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-clause-list]: list=%p cannot take a "
            "clause owned by %p\n",
            static_cast<void *>(this),
            static_cast<void *>(clause->get_parent()));
    ROSE_ABORT();
  }
  p_clauses.push_back(clause);
  clause->set_parent(this);
}

void SgOmpClauseList::remove_clause(SgOmpClause *clause) {
  SgOmpClausePtrList::iterator found =
      std::find(p_clauses.begin(), p_clauses.end(), clause);
  if (clause == NULL || found == p_clauses.end() ||
      clause->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-clause-list]: list=%p cannot remove a "
            "clause it does not exclusively own\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  p_clauses.erase(found);
  clause->set_parent(NULL);
}
SOURCE_OMP_CLAUSE_LIST_END

HEADER_NAMESPACE_SOURCE_FRAGMENT_START
public:
enum namespace_source_fragment_kind_enum {
  e_namespace_source_fragment_unknown,
  e_namespace_source_fragment_opening_introducer,
  e_namespace_source_fragment_opening,
  e_namespace_source_fragment_closing,
  e_last_namespace_source_fragment_kind
};

enum namespace_source_fragment_form_enum {
  e_namespace_source_fragment_form_unclassified,
  e_namespace_source_fragment_source_spelled,
  e_namespace_source_fragment_canonical_generated,
  e_last_namespace_source_fragment_form
};

namespace_source_fragment_kind_enum get_kind() const;
namespace_source_fragment_form_enum get_source_form() const;
void validate() const;
HEADER_NAMESPACE_SOURCE_FRAGMENT_END

SOURCE_NAMESPACE_SOURCE_FRAGMENT_START
SgNamespaceSourceFragment::namespace_source_fragment_kind_enum
$CLASSNAME::get_kind() const {
  validate();
  return p_kind;
}

SgNamespaceSourceFragment::namespace_source_fragment_form_enum
$CLASSNAME::get_source_form() const {
  validate();
  return p_source_form;
}

void $CLASSNAME::validate() const {
  if (p_kind != e_namespace_source_fragment_opening_introducer &&
      p_kind != e_namespace_source_fragment_opening &&
      p_kind != e_namespace_source_fragment_closing) {
    fprintf(stderr,
            "REX_AST_INVARIANT[namespace-source-fragment-kind]: fragment=%p "
            "kind=%d is invalid\n",
            static_cast<const void *>(this), static_cast<int>(p_kind));
    ROSE_ABORT();
  }

  if (p_contains_namespace_name &&
      p_kind != e_namespace_source_fragment_opening_introducer) {
    fprintf(stderr,
            "REX_AST_INVARIANT[namespace-source-fragment-kind]: fragment=%p "
            "kind=%d cannot own the namespace name\n",
            static_cast<const void *>(this), static_cast<int>(p_kind));
    ROSE_ABORT();
  }

  if (p_source_form != e_namespace_source_fragment_source_spelled &&
      p_source_form != e_namespace_source_fragment_canonical_generated) {
    fprintf(stderr,
            "REX_AST_INVARIANT[namespace-source-fragment-form]: fragment=%p "
            "kind=%d form=%d is invalid\n",
            static_cast<const void *>(this), static_cast<int>(p_kind),
            static_cast<int>(p_source_form));
    ROSE_ABORT();
  }

  const Sg_File_Info *start = get_startOfConstruct();
  const Sg_File_Info *end = get_endOfConstruct();
  if (start == NULL || end == NULL ||
      start->isCompilerGenerated() != end->isCompilerGenerated() ||
      start->isTransformation() != end->isTransformation()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[namespace-source-fragment-range]: fragment=%p "
            "kind=%d has an incomplete or inconsistent source range\n",
            static_cast<const void *>(this), static_cast<int>(p_kind));
    ROSE_ABORT();
  }

  const bool generated =
      start->isCompilerGenerated() || start->isTransformation();
  const bool exact_physical_file = start->get_physical_file_id() >= 0 &&
                                   end->get_physical_file_id() >= 0 &&
                                   start->isSameFile(*end);
  const bool exact_source_range =
      start->get_line() > 0 && start->get_col() > 0 && end->get_line() > 0 &&
      end->get_col() > 0 && exact_physical_file && *start <= *end;
  const bool exact_published_generated_surface =
      generated &&
      !(start->isCompilerGenerated() && start->isTransformation()) &&
      exact_physical_file && start->get_raw_line() == 0 &&
      start->get_raw_col() == 0 && end->get_raw_line() == 0 &&
      end->get_raw_col() == 0 && start->isOutputInCodeGeneration() &&
      end->isOutputInCodeGeneration();
  const bool exact_detached_generated_surface =
      generated &&
      !(start->isCompilerGenerated() && start->isTransformation()) &&
      start->get_physical_file_id() < 0 && end->get_physical_file_id() < 0 &&
      start->get_raw_physical_file_id() == end->get_raw_physical_file_id() &&
      start->get_raw_line() == 0 && start->get_raw_col() == 0 &&
      end->get_raw_line() == 0 && end->get_raw_col() == 0;
  if ((p_source_form == e_namespace_source_fragment_source_spelled &&
       (generated || !exact_source_range)) ||
      (p_source_form == e_namespace_source_fragment_canonical_generated &&
       !exact_detached_generated_surface &&
       !exact_published_generated_surface)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[namespace-source-fragment-form]: fragment=%p "
            "kind=%d form=%d disagrees with its exact detached-generated, "
            "source-spelled, or published-generated provenance\n",
            static_cast<const void *>(this), static_cast<int>(p_kind),
            static_cast<int>(p_source_form));
    ROSE_ABORT();
  }
}
SOURCE_NAMESPACE_SOURCE_FRAGMENT_END

HEADER_CXX_LITERAL_TOKEN_START
/** Lexical spelling of a C++ literal operand. Numeric preprocessing tokens can
 * exceed every builtin numeric range; they have no fabricated Sage value/type.
 * The owning call holds the actual semantic arguments and template arguments. */
enum token_kind_enum { e_numeric_token, e_character_token, e_string_token };
void validate_literal_token() const {
  ROSE_ASSERT(p_token_kind == e_numeric_token ||
              p_token_kind == e_character_token || p_token_kind == e_string_token);
  ROSE_ASSERT(!p_spelling.empty());
}
HEADER_CXX_LITERAL_TOKEN_END

HEADER_FORTRAN_IMPLICIT_RANGE_START
enum type_spec_enum {
  e_intrinsic = 0,
  e_type = 1,
  e_class = 2,
  e_type_star = 3,
  e_class_star = 4
};
char get_first_letter() const { return p_first_letter; }
std::optional<char> get_last_letter() const { return p_last_letter; }
SgType *get_type() const { return p_type; }
type_spec_enum get_type_spec() const { return p_type_spec; }
SgSymbol *get_source_derived_type_symbol() const {
  return p_source_derived_type_symbol;
}
static bool is_valid_range(char first_letter, std::optional<char> last_letter,
                           SgType *type, type_spec_enum type_spec,
                           SgSymbol *source_derived_type_symbol);
void validate_range() const;
void post_construction_initialization() override;
HEADER_FORTRAN_IMPLICIT_RANGE_END

SOURCE_FORTRAN_IMPLICIT_RANGE_START
bool SgFortranImplicitRange::is_valid_range(
    char first_letter, std::optional<char> last_letter, SgType *type,
    type_spec_enum type_spec, SgSymbol *source_derived_type_symbol) {
  auto letter_index = [](char letter) {
    if (letter >= 'a' && letter <= 'z')
      return letter - 'a';
    if (letter >= 'A' && letter <= 'Z')
      return letter - 'A';
    return -1;
  };
  const int first = letter_index(first_letter);
  const int last = letter_index(last_letter.value_or(first_letter));
  if (first < 0 || last < first || type == nullptr)
    return false;
  if (type_spec == e_type || type_spec == e_class) {
    if (isSgClassType(type) == nullptr ||
        source_derived_type_symbol == nullptr ||
        source_derived_type_symbol->get_name().is_null())
      return false;
    SgSymbol *symbol = source_derived_type_symbol;
    std::set<SgAliasSymbol *> aliases;
    while (SgAliasSymbol *alias = isSgAliasSymbol(symbol)) {
      if (!aliases.insert(alias).second || alias->get_alias() == nullptr)
        return false;
      symbol = alias->get_alias();
    }
    SgClassSymbol *class_symbol = isSgClassSymbol(symbol);
    return class_symbol != nullptr &&
           class_symbol->get_declaration() != nullptr &&
           class_symbol->get_declaration()->get_type() == type;
  }
  if (source_derived_type_symbol != nullptr ||
      !type->get_fortran_source_syntax())
    return false;
  switch (type_spec) {
  case e_intrinsic:
    if (const auto *complex = isSgTypeComplex(type)) {
      const SgType *base = complex->get_base_type();
      return base != nullptr && base->get_fortran_source_syntax() &&
             (isSgTypeFloat(base) != nullptr || isSgTypeDouble(base) != nullptr);
    }
    return isSgTypeBool(type) != nullptr || isSgTypeChar(type) != nullptr ||
           isSgTypeString(type) != nullptr || isSgTypeInt(type) != nullptr ||
           isSgTypeUnsignedInt(type) != nullptr ||
           isSgTypeFloat(type) != nullptr || isSgTypeDouble(type) != nullptr;
  case e_type_star:
    return isSgTypeFortranAssumed(type) != nullptr;
  case e_class_star:
    return isSgTypeFortranUnlimitedPolymorphic(type) != nullptr;
  default:
    return false;
  }
}

void SgFortranImplicitRange::post_construction_initialization() {
  SgLocatedNode::post_construction_initialization();
  validate_range();
}

void SgFortranImplicitRange::validate_range() const {
  ROSE_ASSERT(is_valid_range(p_first_letter, p_last_letter, p_type, p_type_spec,
                             p_source_derived_type_symbol));
}
SOURCE_FORTRAN_IMPLICIT_RANGE_END
