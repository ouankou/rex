// DQ (9/3/2021): Adding for the interface defined at the SgLocatedNode level.
bool SgLocatedNode::isOutputInCodeGeneration() const {
  bool return_value = false;

  ROSE_ASSERT(get_startOfConstruct() != NULL);
  ROSE_ASSERT(get_endOfConstruct() != NULL);

  return_value =
      return_value || get_startOfConstruct()->isOutputInCodeGeneration();
  ROSE_ASSERT(return_value == get_endOfConstruct()->isOutputInCodeGeneration());

  const SgExpression *expression = isSgExpression(this);
  if (expression != NULL && expression->get_operatorPosition() != NULL) {
    ROSE_ASSERT(return_value ==
                expression->get_operatorPosition()->isOutputInCodeGeneration());
  }

  return return_value;
}

// DQ (10/25/20018): These function are part of a move to lift the interface for
// IR node classification from the Sg_File_Info object to the SgLocatedNode (at
// least).
int SgLocatedNode::get_physical_file_id() {
  ROSE_ASSERT(get_startOfConstruct() != NULL);
  ROSE_ASSERT(get_endOfConstruct() != NULL);
  ROSE_ASSERT(get_startOfConstruct()->get_physical_file_id() ==
              get_endOfConstruct()->get_physical_file_id());

  SgExpression *expression = isSgExpression(this);
  if (expression != NULL && expression->get_operatorPosition() != NULL) {
    expression->get_operatorPosition()->setOutputInCodeGeneration();
    ROSE_ASSERT(expression->get_operatorPosition()->get_physical_file_id() ==
                get_endOfConstruct()->get_physical_file_id());
  }

  // Return any one of these since they are all checked to be equal.
  return get_startOfConstruct()->get_physical_file_id();
}

// [MK] Member function to attach PreprocessingInfo object to the node
namespace {
bool isValidAttachedPreprocessingPosition(
    PreprocessingInfo::RelativePositionType position) {
  return position == PreprocessingInfo::before ||
         position == PreprocessingInfo::after ||
         position == PreprocessingInfo::inside ||
         position == PreprocessingInfo::before_syntax ||
         position == PreprocessingInfo::after_syntax;
}

void requirePublishablePreprocessingRecord(
    PreprocessingInfo *record,
    PreprocessingInfo::RelativePositionType position) {
  if (record == nullptr || !record->has_file_info() ||
      record->get_file_info()->isShared() ||
      record->getTypeOfDirective() <=
          PreprocessingInfo::CpreprocessorUnknownDeclaration ||
      record->getTypeOfDirective() >= PreprocessingInfo::LastDirectiveType ||
      !isValidAttachedPreprocessingPosition(position)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attachment-record]: record=%p "
            "position=%d is not a complete uniquely publishable record\n",
            static_cast<void *>(record), static_cast<int>(position));
    ROSE_ABORT();
  }
}
} // namespace

void SgLocatedNode::validateAttachedPreprocessingInfoOwnership() const {
  if (p_attachedPreprocessingInfoPtr == nullptr) {
    return;
  }
  // Validate a complete list only at an explicit AST contract boundary.
  // Typed mutations below establish ownership before publishing a record and
  // therefore require only the record-local owner check.  Rescanning the
  // complete list before every append made comment collection quadratic for
  // nodes that legitimately own many preprocessing records.
  std::unordered_set<const PreprocessingInfo *> records;
  records.reserve(p_attachedPreprocessingInfoPtr->size());
  for (size_t index = 0; index < p_attachedPreprocessingInfoPtr->size();
       ++index) {
    PreprocessingInfo *record = (*p_attachedPreprocessingInfoPtr)[index];
    if (record == nullptr || !records.insert(record).second ||
        record->getAttachedOwner() != this ||
        !isValidAttachedPreprocessingPosition(record->getRelativePosition())) {
      fprintf(stderr,
              "REX_AST_INVARIANT[preprocessing-attachment-list]: owner list "
              "contains a record without exact owner identity at index=%zu\n",
              index);
      ROSE_ABORT();
    }
  }
}

void SgLocatedNode::attachPreprocessingInfo(
    PreprocessingInfo *record, PreprocessingInfo::RelativePositionType position,
    PreprocessingInfoInsertion insertion) {
  requirePublishablePreprocessingRecord(record, position);
  if (record->getAttachedOwner() != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attachment-owner]: record is "
            "not uniquely detached\n");
    ROSE_ABORT();
  }
  if (p_attachedPreprocessingInfoPtr == nullptr) {
    p_attachedPreprocessingInfoPtr = new AttachedPreprocessingInfoType;
  }
  record->setRelativePosition(position);
  record->claimAttachedOwner(this);
  switch (insertion) {
  case PreprocessingInfoInsertion::front:
    p_attachedPreprocessingInfoPtr->insert(
        p_attachedPreprocessingInfoPtr->begin(), record);
    return;
  case PreprocessingInfoInsertion::back:
    p_attachedPreprocessingInfoPtr->push_back(record);
    return;
  }
  fprintf(stderr,
          "REX_AST_INVARIANT[preprocessing-attachment-order]: owner=%p "
          "record=%p has invalid insertion order=%d\n",
          static_cast<void *>(this), static_cast<void *>(record),
          static_cast<int>(insertion));
  ROSE_ABORT();
}

void SgLocatedNode::attachPreprocessingInfoRelative(
    PreprocessingInfo *record, PreprocessingInfo::RelativePositionType position,
    PreprocessingInfo *anchor, bool insertAfter) {
  requirePublishablePreprocessingRecord(record, position);
  if (anchor == nullptr || p_attachedPreprocessingInfoPtr == nullptr ||
      anchor->getAttachedOwner() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attachment-anchor]: owner=%p "
            "record=%p anchor=%p is not exactly owned\n",
            static_cast<void *>(this), static_cast<void *>(record),
            static_cast<void *>(anchor));
    ROSE_ABORT();
  }
  auto anchorPosition =
      std::find(p_attachedPreprocessingInfoPtr->begin(),
                p_attachedPreprocessingInfoPtr->end(), anchor);
  if (anchorPosition == p_attachedPreprocessingInfoPtr->end()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attachment-anchor]: owner=%p "
            "record=%p anchor=%p is absent\n",
            static_cast<void *>(this), static_cast<void *>(record),
            static_cast<void *>(anchor));
    ROSE_ABORT();
  }
  if (record->getAttachedOwner() != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attachment-owner]: record is "
            "not uniquely detached\n");
    ROSE_ABORT();
  }
  record->setRelativePosition(position);
  record->claimAttachedOwner(this);
  p_attachedPreprocessingInfoPtr->insert(
      insertAfter ? anchorPosition + 1 : anchorPosition, record);
}

PreprocessingInfo *
SgLocatedNode::detachPreprocessingInfo(PreprocessingInfo *record) {
  if (record == nullptr || p_attachedPreprocessingInfoPtr == nullptr ||
      record->getAttachedOwner() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-detachment-owner]: owner=%p "
            "record=%p recorded-owner=%p is not attached here\n",
            static_cast<void *>(this), static_cast<void *>(record),
            record != nullptr ? static_cast<void *>(record->getAttachedOwner())
                              : nullptr);
    ROSE_ABORT();
  }
  auto position = std::find(p_attachedPreprocessingInfoPtr->begin(),
                            p_attachedPreprocessingInfoPtr->end(), record);
  if (position == p_attachedPreprocessingInfoPtr->end()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-detachment-owner]: owner=%p "
            "record=%p is absent from its recorded owner\n",
            static_cast<void *>(this), static_cast<void *>(record));
    ROSE_ABORT();
  }
  p_attachedPreprocessingInfoPtr->erase(position);
  record->releaseAttachedOwner(this);
  if (p_attachedPreprocessingInfoPtr->empty()) {
    delete p_attachedPreprocessingInfoPtr;
    p_attachedPreprocessingInfoPtr = nullptr;
  }
  return record;
}

void SgLocatedNode::transferPreprocessingInfo(
    PreprocessingInfo *record, SgLocatedNode *destination,
    PreprocessingInfo::RelativePositionType destinationPosition,
    PreprocessingInfoInsertion insertion) {
  if (destination == nullptr || destination == this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-transfer-owner]: source=%p "
            "destination=%p record=%p has no distinct destination\n",
            static_cast<void *>(this), static_cast<void *>(destination),
            static_cast<void *>(record));
    ROSE_ABORT();
  }
  requirePublishablePreprocessingRecord(record, destinationPosition);
  if (record->getAttachedOwner() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-transfer-owner]: source=%p "
            "destination=%p record=%p recorded-owner=%p is misowned\n",
            static_cast<void *>(this), static_cast<void *>(destination),
            static_cast<void *>(record),
            static_cast<void *>(record->getAttachedOwner()));
    ROSE_ABORT();
  }
  PreprocessingInfo::OutputPlacementType destinationPlacement =
      record->getOutputPlacement();
  if (destinationPlacement == PreprocessingInfo::source_position ||
      (destinationPlacement ==
           PreprocessingInfo::attached_output_trailing_line &&
       destinationPosition != PreprocessingInfo::after &&
       destinationPosition != PreprocessingInfo::after_syntax)) {
    destinationPlacement = PreprocessingInfo::attached_output_boundary;
  }
  record->changeAttachedOutputPlacement(this, destinationPlacement);
  detachPreprocessingInfo(record);
  destination->attachPreprocessingInfo(record, destinationPosition, insertion);
}

void SgLocatedNode::setAttachedPreprocessingInfoPosition(
    PreprocessingInfo *record,
    PreprocessingInfo::RelativePositionType position) {
  requirePublishablePreprocessingRecord(record, position);
  if (record->getAttachedOwner() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-attached-position]: owner=%p "
            "record=%p recorded-owner=%p is misowned\n",
            static_cast<void *>(this), static_cast<void *>(record),
            static_cast<void *>(record->getAttachedOwner()));
    ROSE_ABORT();
  }
  record->changeAttachedPosition(this, position);
}

void SgLocatedNode::cloneAttachedPreprocessingInfoFrom(
    const SgLocatedNode *source) {
  if (source == nullptr || source == this ||
      p_attachedPreprocessingInfoPtr != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[preprocessing-clone-owner]: source=%p "
            "destination=%p destination-list=%p is invalid\n",
            static_cast<const void *>(source), static_cast<void *>(this),
            static_cast<void *>(p_attachedPreprocessingInfoPtr));
    ROSE_ABORT();
  }
  source->validateAttachedPreprocessingInfoOwnership();
  if (source->p_attachedPreprocessingInfoPtr == nullptr) {
    return;
  }
  for (PreprocessingInfo *record : *source->p_attachedPreprocessingInfoPtr) {
    PreprocessingInfo *copy = new PreprocessingInfo(*record);
    copy->setOutputPlacement(PreprocessingInfo::attached_output_boundary);
    attachPreprocessingInfo(copy, copy->getRelativePosition(),
                            PreprocessingInfoInsertion::back);
  }
}

void SgLocatedNode::clearAttachedPreprocessingInfo() {
  validateAttachedPreprocessingInfoOwnership();
  if (p_attachedPreprocessingInfoPtr == nullptr) {
    return;
  }
  for (PreprocessingInfo *record : *p_attachedPreprocessingInfoPtr) {
    record->releaseAttachedOwner(this);
    delete record;
  }
  delete p_attachedPreprocessingInfoPtr;
  p_attachedPreprocessingInfoPtr = nullptr;
}

void SgLocatedNode::addToAttachedPreprocessingInfo(
    PreprocessingInfo *prepInfoPtr,
    // PositionOfPreprocessingInfoInListType locationInList )
    PreprocessingInfo::RelativePositionType locationInList) {
  // DQ (11/23/2008): Is this comment still true?  Is there something to fix
  // here? There are places in ROSE where the comments is added before the
  // statement though most commonly the comment is added after the statement. So
  // I think that this interface is required adn that it need not be fixed.

  // DQ (9/19/2003)
  // This function takes a PreprocessingInfo::RelativePositionType type
  // parameter which makes no since because it is used only to determine if the
  // new comment/directive is added to the front or back of the current list of
  // comments/directives.  It does not change the value of the
  // PreprocessingInfo::RelativePositionType field in the PreprocessingInfo
  // object that it takes for the other parameter (nor should it). This function
  // was poorly desinged in the first place and needs to be fixed!!!

  ROSE_ASSERT(prepInfoPtr != NULL);

  // Nodes that should not have comments attached (since they are not unparsed)

  // DQ (1/28/2013): Now that we correctly handle the source position for
  // SgForInitStatement, I think we can allow CPP directives and comments to be
  // attached to this IR node (failed for Zsh: params.c).  Now tested using
  // test2013_48.C, though comments not output precisely.

  ROSE_ASSERT(dynamic_cast<SgTypedefSeq *>(this) == NULL);
  ROSE_ASSERT(dynamic_cast<SgCatchStatementSeq *>(this) == NULL);

  // These should not be used but are are least handled in the unparser (if not
  // debugged)
  ROSE_ASSERT(dynamic_cast<SgCtorInitializerList *>(this) == NULL);

  SgFunctionParameterList *functionParameterList =
      isSgFunctionParameterList(this);
  if (functionParameterList != NULL) {
    ROSE_ASSERT(get_startOfConstruct() != NULL);
    ROSE_ASSERT(get_endOfConstruct() != NULL);
  }

  // Preserve the historical front/back ordering entry point while routing all
  // ownership publication through the exact typed contract.
  switch (locationInList) {
  case PreprocessingInfo::defaultValue:
  case PreprocessingInfo::undef:
    printf("Error: defaultValue or undef value found in switch statement \n");
    ROSE_ASSERT(false);
    break;

  case PreprocessingInfo::before: {
    attachPreprocessingInfo(prepInfoPtr, prepInfoPtr->getRelativePosition(),
                            PreprocessingInfoInsertion::front);
    return;
  }

  case PreprocessingInfo::after: {
    // (9/10/2003) DQ: Force new comments to be attached closest to the target
    // statement
    attachPreprocessingInfo(prepInfoPtr, prepInfoPtr->getRelativePosition(),
                            PreprocessingInfoInsertion::back);
    return;
  }

  default:
    printf("Error: default found in switch statement \n");
    ROSE_ASSERT(false);
  }
}

// Liao 1/27/2015
// Insert prepInfo right after (or before) an existing anchor info in the
// preprocessing info list
void SgLocatedNode::insertToAttachedPreprocessingInfo(
    PreprocessingInfo *prepInfoPtr, PreprocessingInfo *anchorInfoPtr,
    bool insertAfter /*= true*/
) {
  attachPreprocessingInfoRelative(prepInfoPtr,
                                  prepInfoPtr->getRelativePosition(),
                                  anchorInfoPtr, insertAfter);
}

// [MK] Member function to return attached PreprocessingInfo objects
AttachedPreprocessingInfoType *&
SgLocatedNode::getAttachedPreprocessingInfo(void) {
  return p_attachedPreprocessingInfoPtr;
}

Sg_File_Info *SgLocatedNode::generateMatchingFileInfo() {
  // DQ (12/30/2009): Added this function to remove previous global function in
  // large ROSETTA generated file so that we could support smaller ROSETTA
  // generated files.

  // DQ (11/20/2004): Modified to provide more accurate information, use the
  // copy constructor instead of the constructor that takes a file name.

  ROSE_ASSERT(get_startOfConstruct() != NULL);
  Sg_File_Info *returnFileInfo = new Sg_File_Info(*(get_startOfConstruct()));
  ROSE_ASSERT(returnFileInfo != NULL);

  return returnFileInfo;
}

SOURCE_END

