const std::string &SgLocatedNode::getFileName() const {
  return getFilenameString();
}

const std::string &SgLocatedNode::getFilenameString() const {
  ROSE_ASSERT(get_startOfConstruct() != NULL);
  return get_startOfConstruct()->get_filenameString();
}

Sg_File_Info *SgLocatedNode::get_file_info() const {
  return get_startOfConstruct();
}

void SgLocatedNode::set_file_info(Sg_File_Info *fileInfo) {
  set_startOfConstruct(fileInfo);
}

void SgLocatedNode::post_construction_initialization() {
  preventConstructionOnStack(this);

  p_attachedPreprocessingInfoPtr = NULL;

  if (p_startOfConstruct != NULL) {
    p_startOfConstruct->set_parent(this);
  }

  if (p_endOfConstruct != NULL) {
    p_endOfConstruct->set_parent(this);
  }
}

void SgLocatedNode::setCompilerGenerated() {

  ROSE_ASSERT(get_startOfConstruct() != NULL);
  ROSE_ASSERT(get_endOfConstruct() != NULL);
  get_startOfConstruct()->setCompilerGenerated();
  get_endOfConstruct()->setCompilerGenerated();

  SgExpression *expression = isSgExpression(this);
  if (expression != NULL && expression->get_operatorPosition() != NULL) {
    expression->get_operatorPosition()->setCompilerGenerated();
  }
}

void SgLocatedNode::unsetCompilerGenerated() {

  ROSE_ASSERT(get_startOfConstruct() != NULL);
  ROSE_ASSERT(get_endOfConstruct() != NULL);
  get_startOfConstruct()->unsetCompilerGenerated();
  get_endOfConstruct()->unsetCompilerGenerated();

  SgExpression *expression = isSgExpression(this);
  if (expression != NULL && expression->get_operatorPosition() != NULL) {
    expression->get_operatorPosition()->unsetCompilerGenerated();
  }
}

bool SgLocatedNode::isCompilerGenerated() const {
  ROSE_ASSERT(get_startOfConstruct() != NULL);
  ROSE_ASSERT(get_endOfConstruct() != NULL);

  const bool result = get_startOfConstruct()->isCompilerGenerated();
  ROSE_ASSERT(result == get_endOfConstruct()->isCompilerGenerated());

  const SgExpression *expression = isSgExpression(this);
  if (expression != NULL && expression->get_operatorPosition() != NULL) {
    ROSE_ASSERT(result ==
                expression->get_operatorPosition()->isCompilerGenerated());
  }

  return result;
}

void SgLocatedNode::setTransformation() {

  ROSE_ASSERT(get_startOfConstruct() != NULL);
  ROSE_ASSERT(get_endOfConstruct() != NULL);
  get_startOfConstruct()->setTransformation();
  get_endOfConstruct()->setTransformation();

  SgExpression *expression = isSgExpression(this);
  if (expression != NULL && expression->get_operatorPosition() != NULL) {
    expression->get_operatorPosition()->setTransformation();
  }
}

void SgLocatedNode::unsetTransformation() {

  ROSE_ASSERT(get_startOfConstruct() != NULL);
  ROSE_ASSERT(get_endOfConstruct() != NULL);
  get_startOfConstruct()->unsetTransformation();
  get_endOfConstruct()->unsetTransformation();

  SgExpression *expression = isSgExpression(this);
  if (expression != NULL && expression->get_operatorPosition() != NULL) {
    expression->get_operatorPosition()->unsetTransformation();
  }
}

bool SgLocatedNode::isTransformation() const {
  ROSE_ASSERT(get_startOfConstruct() != NULL);

  bool result = get_startOfConstruct()->isTransformation();

  if (get_endOfConstruct() == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[located-node-file-info]: node=%p kind=%s has "
            "no end-of-construct file info\n",
            static_cast<const void *>(this), this->class_name().c_str());
    ROSE_ABORT();
  }
  if (result != get_endOfConstruct()->isTransformation()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[located-node-file-info]: node=%p kind=%s "
            "start=%s:%d:%d transformation=%d end=%s:%d:%d "
            "transformation=%d\n",
            static_cast<const void *>(this), this->class_name().c_str(),
            get_startOfConstruct()->get_filenameString().c_str(),
            get_startOfConstruct()->get_line(),
            get_startOfConstruct()->get_col(), static_cast<int>(result),
            get_endOfConstruct()->get_filenameString().c_str(),
            get_endOfConstruct()->get_line(), get_endOfConstruct()->get_col(),
            static_cast<int>(get_endOfConstruct()->isTransformation()));
    ROSE_ABORT();
  }

  const SgExpression *expression = isSgExpression(this);
  if (expression != NULL && expression->get_operatorPosition() != NULL) {
    if (result != expression->get_operatorPosition()->isTransformation()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[located-node-file-info]: expression=%p "
              "kind=%s start transformation=%d operator transformation=%d\n",
              static_cast<const void *>(this), this->class_name().c_str(),
              static_cast<int>(result),
              static_cast<int>(
                  expression->get_operatorPosition()->isTransformation()));
      ROSE_ABORT();
    }
  }

  return result;
}

