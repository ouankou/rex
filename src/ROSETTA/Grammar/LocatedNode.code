    {"abstract", SgToken::FORTRAN_ABSTRACT},
    {"access", SgToken::FORTRAN_ACCESS},
    {"action", SgToken::FORTRAN_ACTION},
    {"abstractinterface",
     SgToken::FORTRAN_INTERFACE}, /*   GFORTRAN/G95 equivalent is ST_INTERFACE
                                   */
    {"allocate",
     SgToken::FORTRAN_ALLOCATE}, /*   GFORTRAN/G95 equivalent is ST_ALLOCATE */
    {"allocatable", SgToken::FORTRAN_ALLOCATABLE}, /*   GFORTRAN/G95 equivalent
                                                      is ST_ALLOCATABLE     */
