public:
Sg_File_Info *get_startOfConstruct() const override { return p_startOfConstruct; }
void set_startOfConstruct(Sg_File_Info *position) {
  p_startOfConstruct = position;
  markSourceMetadataAsModified();
}
Sg_File_Info *get_endOfConstruct() const override { return p_endOfConstruct; }
void set_endOfConstruct(Sg_File_Info *position) {
  p_endOfConstruct = position;
  markSourceMetadataAsModified();
}
bool get_source_range_ends_in_macro_expansion() const {
  return p_source_range_ends_in_macro_expansion;
}
void set_source_range_ends_in_macro_expansion(bool value) {
  p_source_range_ends_in_macro_expansion = value;
  markSourceMetadataAsModified();
}
bool get_source_range_is_macro_expansion_fragment() const {
  return p_source_range_is_macro_expansion_fragment;
}
void set_source_range_is_macro_expansion_fragment(bool value) {
  p_source_range_is_macro_expansion_fragment = value;
  markSourceMetadataAsModified();
}
enum class PreprocessingInfoInsertion { front, back };

// Publish one detached preprocessing record on one exact AST owner.  The
// record's relative position is semantic; insertion controls only stable order
// within records at that position.
void attachPreprocessingInfo(
    PreprocessingInfo *record, PreprocessingInfo::RelativePositionType position,
    PreprocessingInfoInsertion insertion = PreprocessingInfoInsertion::back);
void attachPreprocessingInfoRelative(
    PreprocessingInfo *record, PreprocessingInfo::RelativePositionType position,
    PreprocessingInfo *anchor, bool insertAfter);
PreprocessingInfo *detachPreprocessingInfo(PreprocessingInfo *record);
void transferPreprocessingInfo(
    PreprocessingInfo *record, SgLocatedNode *destination,
    PreprocessingInfo::RelativePositionType destinationPosition,
    PreprocessingInfoInsertion insertion = PreprocessingInfoInsertion::back);
void setAttachedPreprocessingInfoPosition(
    PreprocessingInfo *record,
    PreprocessingInfo::RelativePositionType position);
void cloneAttachedPreprocessingInfoFrom(const SgLocatedNode *source,
                                        SgCopyHelp *help = nullptr);
void clearAttachedPreprocessingInfo();
void validateAttachedPreprocessingInfoOwnership() const;

const std::string &getFileName() const;
const std::string &getFilenameString() const;

protected:
void post_construction_initialization() override;

private:
$CLASSNAME(const $CLASSNAME &X);

public:
// Attach a record at the front or back of the list.
void addToAttachedPreprocessingInfo(
    PreprocessingInfo *prepInfoPtr,
    PreprocessingInfo::RelativePositionType locationInList =
        PreprocessingInfo::after);

// Insert a record next to an attached anchor.
void insertToAttachedPreprocessingInfo(PreprocessingInfo *prepInfoPtr,
                                       PreprocessingInfo *anchorInfoPtr,
                                       bool insertAfter = true);

// Compatibility access to the start position.
virtual Sg_File_Info *get_file_info() const override;

virtual void set_file_info(Sg_File_Info *X);

// These setters require start and end positions and update an expression's
// operator position when present. State readers check consistency where defined.
void setCompilerGenerated();
void unsetCompilerGenerated();
bool isCompilerGenerated() const;

void setTransformation();
void unsetTransformation();
bool isTransformation() const;

void setFrontendSpecific();
void unsetFrontendSpecific();
bool isFrontendSpecific() const;

void setShared();
void unsetShared();
bool isShared() const;

void setSourcePositionUnavailableInFrontend();
void unsetSourcePositionUnavailableInFrontend();

void setOutputInCodeGeneration();
void unsetOutputInCodeGeneration();
bool isOutputInCodeGeneration() const;

//! Return the physical file ID after checking all available source positions.
int get_physical_file_id() const;

virtual void fixupCopy_scopes(SgNode *copy, SgCopyHelp &help) const override;
virtual void fixupCopy_symbols(SgNode *copy, SgCopyHelp &help) const override;
virtual void fixupCopy_references(SgNode *copy,
                                  SgCopyHelp &help) const override;

public:
#ifndef SWIG
AttachedPreprocessingInfoType *&getAttachedPreprocessingInfo(void);
#endif

Sg_File_Info *generateMatchingFileInfo();

