
virtual $GRAMMAR_PREFIX_Node* $CLASSNAME::copy ( $GRAMMAR_PREFIX_CopyHelp& help) const
   {
     if (const SgIncludeFile* include = isSgIncludeFile(this))
        include->validateIncludeOwnership();
     requireClassDefinitionOwnerForCopy(this);
     SgCopyHelp::ConstructionScope construction(help, this);
     $CLASSNAME* result = NULL;
     help.incrementDepth();

     if (const SgFunctionDeclaration* source = isSgFunctionDeclaration(this))
        SageInterface::materializeTypeWithCopyMap(source->get_type(), help, true);

$DEPENDENCY_COPY

     if (const SgTemplateParameter* source = isSgTemplateParameter(this))
        SageInterface::prepareTemplateParameterTypeCopy(source, help);

     if (const SgTypedefDeclaration* source = isSgTypedefDeclaration(this))
        SageInterface::materializeTypeWithCopyMap(source->get_base_type(), help, true);
     if (const SgBaseClass* source = isSgBaseClass(this))
        {
        if (SgType* type = source->get_source_type())
           SageInterface::materializeTypeWithCopyMap(type, help, true);
        prepareConstructorReference(source->get_fortran_source_derived_type_symbol(), help);
        }
     if (const SgInitializedName* source = isSgInitializedName(this))
        SageInterface::materializeTypeWithCopyMap(source->get_type(), help, true);
     if (const SgFunctionParameterTypeList* source = isSgFunctionParameterTypeList(this))
        if (source->get_source_parameters() == nullptr)
           for (SgType* argument : source->get_arguments())
              SageInterface::materializeTypeWithCopyMap(argument, help, true);
     if (const SgExpression* source = isSgExpression(this))
        {
        if (source->has_semantic_value_type())
           SageInterface::materializeTypeWithCopyMap(source->get_type(), help, true);
        if (const SgCastExp* cast = isSgCastExp(source))
           if (SgType* type = cast->get_source_type())
              SageInterface::materializeTypeWithCopyMap(type, help, true);
        }
     if (const SgFunctionType* source = isSgFunctionType(this))
        if (SgFunctionType* semantic = source->get_semantic_signature())
           SageInterface::materializeTypeWithCopyMap(semantic, help, true);

     if (const SgTemplateVariableDeclaration* source = isSgTemplateVariableDeclaration(this))
        {
          for (const SgTemplateParameter* parameter : source->get_templateParameters())
             {
               ROSE_ASSERT(parameter != NULL && parameter->get_parent() == source);
               ROSE_ASSERT(help.copyOrLookupOwnedAst(parameter) != parameter);
             }
        }
     if (const SgTemplateArgument* source = isSgTemplateArgument(this))
        SageInterface::prepareTemplateArgumentCopy(source, help);
     if (const SgNonrealDecl* source = isSgNonrealDecl(this))
        prepareConstructorReference(source->get_templateDeclaration(), help);

$CONSTRUCT_ARG_COPY

  // A constructor dependency can complete this exact node through a
  // semantic cycle.
     const auto existing = help.get_copiedNodeMap().find(this);
     if (existing != help.get_copiedNodeMap().end() && existing->second != this)
        {
          result = dynamic_cast<$CLASSNAME*>(existing->second);
          ROSE_ASSERT(result != NULL && result->variantT() == variantT());
          completeNodeCopy(this, result, help);
          return result;
        }

     result = new $CLASSNAME( $CONSTRUCT_ARG_LIST );
     ROSE_ASSERT(result != NULL);

  // Publish the original-to-copy identity before recursively copying any data
  // members.  Semantic edges can form cycles, and every recursive encounter
  // must reuse this in-progress node instead of manufacturing a second,
  // detached provisional copy that would need late graph repair.
     help.insertCopiedNodePair(this,result);

$STATE_COPY

$REFERENCE_COPY

  // Signature types can require the specification scope before the function
  // declaration exists. Keep that region private until its typed owner adopts it.
     if (const SgFunctionParameterScope* source = isSgFunctionParameterScope(this))
        if (const SgFunctionDeclaration* owner = isSgFunctionDeclaration(source->get_parent()))
           {
             ROSE_ASSERT(owner->get_functionParameterScope() == source);
             SgScopeStatement* enclosing = nullptr;
             help.bindCopiedReference(enclosing, source->get_scope());
             ASSERT_not_null(enclosing);
             SageInterface::beginDetachedFunctionParameterScopeConstruction(
                 isSgFunctionParameterScope(result), enclosing, enclosing);
           }

     if (const SgNamespaceDefinitionStatement* source = isSgNamespaceDefinitionStatement(this))
        {
          SgNamespaceDeclarationStatement* owner = source->get_namespaceDeclaration();
          ROSE_ASSERT(owner != NULL && owner->get_definition() == source &&
                      source->get_parent() == owner);
          SgNamespaceDeclarationStatement* copiedOwner =
              isSgNamespaceDeclarationStatement(help.copyOrLookupAst(owner));
          SgNamespaceDefinitionStatement* copiedDefinition =
              isSgNamespaceDefinitionStatement(result);
          ROSE_ASSERT(copiedOwner != NULL && copiedOwner != owner &&
                      (copiedOwner->get_definition() == NULL ||
                       copiedOwner->get_definition() == copiedDefinition));
          copiedOwner->set_definition(copiedDefinition);
          copiedDefinition->set_namespaceDeclaration(copiedOwner);
          copiedDefinition->set_parent(copiedOwner);
          ROSE_ASSERT(copiedOwner->get_definition() == copiedDefinition &&
                      copiedDefinition->get_namespaceDeclaration() == copiedOwner &&
                      copiedDefinition->get_parent() == copiedOwner);
        }

     if (const SgClassDefinition* source = isSgClassDefinition(this))
        {
          SgClassDeclaration* owner = source->get_declaration();
          ROSE_ASSERT(owner != NULL && owner->get_definition() == source);
          SgClassDeclaration* copiedOwner =
              isSgClassDeclaration(help.copyOrLookupAst(owner));
          SgClassDefinition* copiedDefinition = isSgClassDefinition(result);
          ROSE_ASSERT(copiedOwner != NULL && copiedOwner != owner &&
                      (copiedOwner->get_definition() == NULL ||
                       copiedOwner->get_definition() == copiedDefinition));
          copiedDefinition->set_parent(copiedOwner);
          copiedOwner->set_definition(copiedDefinition);
          help.constructClassTypeCopy(owner);
        }
     if (const SgClassDeclaration* source = isSgClassDeclaration(this))
        {
          if (source->get_definingDeclaration() == NULL)
             help.constructClassTypeCopy(source);
        }
     if (const SgEnumDeclaration* source = isSgEnumDeclaration(this))
        {
          if (source->get_definingDeclaration() == source)
             help.constructEnumTypeCopy(source);
        }
     if (const SgTemplateParameter* source = isSgTemplateParameter(this))
        help.constructTemplateParameterTypeCopy(source);

     if (const SgFunctionDefinition* source = isSgFunctionDefinition(this))
        {
          SgFunctionDeclaration* owner = source->get_declaration();
          ROSE_ASSERT(owner != NULL && owner->get_definition() == source);
          SgFunctionDeclaration* copiedOwner =
              isSgFunctionDeclaration(help.copyOrLookupAst(owner));
          SgFunctionDefinition* copiedDefinition = isSgFunctionDefinition(result);
          ROSE_ASSERT(copiedOwner != NULL && copiedOwner != owner &&
                      (copiedOwner->get_definition() == NULL ||
                       copiedOwner->get_definition() == copiedDefinition));
          copiedDefinition->set_declaration(copiedOwner);
          copiedOwner->set_definition(copiedDefinition);
        }

  // The constructor and semantic back-reference must share one mapped type.
     if (SgTypedefDeclaration* declaration = isSgTypedefDeclaration(result))
        {
          const SgTypedefDeclaration* original = isSgTypedefDeclaration(this);
          SgTypedefType* originalType = original->get_type();
          SgTypedefType* copiedType = declaration->get_type();
          if (originalType == NULL || copiedType == NULL ||
              copiedType == originalType ||
              originalType->get_declaration() != original ||
              copiedType->get_declaration() != declaration ||
              help.get_copiedNodeMap().at(originalType) != copiedType)
             {
               fprintf(stderr, "REX_COPY_INVARIANT[typedef-type-construction]: "
                               "typedef copy has no exact private type\n");
               ROSE_ABORT();
             }
        }

$POST_CONSTRUCT_COPY

     if (SgInitializedName* parameter = isSgInitializedName(result))
        parameter->construct_source_prototype_copy_symbol(
            *isSgInitializedName(this), help);
     if (SgFunctionParameterTypeList* parameters = isSgFunctionParameterTypeList(result))
        parameters->validate_source_prototype();

  // Runtime source context is immutable provenance inherited by the exact
  // directive copy, not a string-keyed attribute reconstructed after outlining.
     if (SgOmpExecStatement* directive = isSgOmpExecStatement(result))
        {
          if (directive->get_runtime_source_origin() !=
              SgOmpExecStatement::e_runtime_source_unavailable)
             directive->mark_runtime_source_context_copied();
        }

     if (SgSymbolTable* symbolTable = isSgSymbolTable(result))
        {
       // Symbol tables are rebuilt structurally for copied scopes. Reusing the
       // original table storage aliases the original and copied ASTs, which
       // leaves detached symbols behind when either side mutates the table.
          rose_hash_multimap* fresh_table = new rose_hash_multimap();
          ROSE_ASSERT(fresh_table != NULL);
          fresh_table->set_case_insensitive_semantics(symbolTable->isCaseInsensitive());
          symbolTable->set_table(fresh_table);
          symbolTable->set_symbolSet(SgNodeSet());
          symbolTable->clear_symbol_indexes();
        }

     SgLocatedNode* locatedNode = isSgLocatedNode(result);
     if (locatedNode != NULL)
        {
          Sg_File_Info* start = locatedNode->get_startOfConstruct();
          ROSE_ASSERT(start != NULL);
          start->set_parent(locatedNode);
          ROSE_ASSERT(start->get_parent() != NULL);

          Sg_File_Info* end = locatedNode->get_endOfConstruct();

       // A located node without a complete source range is malformed.  Copying
       // it would preserve the broken producer state and fail later in an
       // unrelated consumer, so reject it at the copy boundary.
          if (end == NULL)
             {
               fprintf(stderr,
                       "REX_COPY_INVARIANT[located-end-position]: source=%p/%s has no endOfConstruct\n",
                       static_cast<const void*>(this), this->class_name().c_str());
               ROSE_ABORT();
             }
            else
             {
               end->set_parent(locatedNode);
               ROSE_ASSERT(end->get_parent() != NULL);
             }

          SgExpression* expression = isSgExpression(result);
          if (isSgExpression(this) != NULL)
             {
               Sg_File_Info* operatorPosition = expression->get_operatorPosition();

            // Not all SgExpression IR nodes have a valid operatorPosition (only applies to actual operators)
               if (operatorPosition != NULL)
                  {
                    operatorPosition->set_parent(expression);
                    ROSE_ASSERT(operatorPosition->get_parent() != NULL);
                  }
             }
        }

  // Files own their position independently of SgLocatedNode. Publish that
  // ownership before any source-file token associations become observable.
     if (SgFile* file = isSgFile(result))
        {
          Sg_File_Info* start = file->get_startOfConstruct();
          ROSE_ASSERT(start != NULL);
          start->set_parent(file);
        }

  // Frontend associations use the exact nodes, tokens and preprocessing records
  // constructed by this transaction.
     if (SgSourceFile* sourceFile = isSgSourceFile(result))
        sourceFile->copy_frontendAssociations(*isSgSourceFile(this), help);

  // Pragmas own positions independently of SgLocatedNode. Their copied
  // locations must identify the copied pragma before it leaves construction.
     if (SgPragma* pragma = isSgPragma(result))
        {
          Sg_File_Info* start = pragma->get_startOfConstruct();
          Sg_File_Info* end = pragma->get_endOfConstruct();
          ROSE_ASSERT(start != NULL && end != NULL);
          start->set_parent(pragma);
          end->set_parent(pragma);
        }

     SgInitializedName* initializedName = isSgInitializedName(result);
     if (initializedName != NULL)
        {
          Sg_File_Info* start = initializedName->get_startOfConstruct();
          ROSE_ASSERT(start != NULL);
          start->set_parent(initializedName);
          ROSE_ASSERT(start->get_parent() != NULL);

        }


     completeNodeCopy(this, result, help);

     return result;
   }
