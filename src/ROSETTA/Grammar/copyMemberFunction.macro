
virtual $GRAMMAR_PREFIX_Node* $CLASSNAME::copy ( $GRAMMAR_PREFIX_CopyHelp& help) const
   {
     $CLASSNAME* result = NULL;

  // printf ("Copy $CLASSNAME = %p = %s \n",this,SageInterface::get_name(this).c_str());

  // Record the depth of the copy so that we build an clear internal state (new feature)
  // used to associated old and new symbols in the original AST and the copy of the AST.
  // The default value of the depth is 0, so after this call the depth is 1!
     help.incrementDepth();


  // Copy data members from base classes
$CONSTRUCT_ARG_COPY

  // Build an empty copy of this object (will be filled in, but
  // the parent can't be set and must be set by the caller)
     result = new $CLASSNAME( $CONSTRUCT_ARG_LIST );
     ROSE_ASSERT(result != NULL);

  // Publish the original-to-copy identity before recursively copying any data
  // members.  Semantic edges can form cycles, and every recursive encounter
  // must reuse this in-progress node instead of manufacturing a second,
  // detached provisional copy that would need late graph repair.
     help.insertCopiedNodePair(this,result);

  // Copy data members of "this" class
$POST_CONSTRUCT_COPY

     if (SgSymbolTable* symbolTable = isSgSymbolTable(result))
        {
       // Symbol tables are rebuilt structurally for copied scopes. Reusing the
       // original table storage aliases the original and copied ASTs, which
       // leaves detached symbols behind when either side mutates the table.
          rose_hash_multimap* fresh_table = new rose_hash_multimap();
          ROSE_ASSERT(fresh_table != NULL);
          fresh_table->set_case_insensitive_semantics(symbolTable->isCaseInsensitive());
          symbolTable->set_table(fresh_table);
          symbolTable->set_symbolSet(SgNodeSet());
          symbolTable->clear_functionSymbolExactIndex();
        }

  // DQ (10/9/2007): comment out to test template problem ... This breaks test2004_76.C and test2004_142.C
  // DQ (10/5/2007): Add custom function to be called to fixup IR node specific details.
  // fixupCopy(result,help);

  // DQ (10/16/2007): The semantics of copy should include setting the parents of all
  // the Sg_File_Info objects that are built for the new IR nodes.
     SgLocatedNode* locatedNode = isSgLocatedNode(result);
     if (locatedNode != NULL)
        {
       // If this is a SgLocatedNode then check the parents of the Sg_File_Info objects
          Sg_File_Info* start = locatedNode->get_startOfConstruct();
          ROSE_ASSERT(start != NULL);
          start->set_parent(locatedNode);
          ROSE_ASSERT(start->get_parent() != NULL);

          Sg_File_Info* end = locatedNode->get_endOfConstruct();

       // A located node without a complete source range is malformed.  Copying
       // it would preserve the broken producer state and fail later in an
       // unrelated consumer, so reject it at the copy boundary.
          if (end == NULL)
             {
               fprintf(stderr,
                       "REX_COPY_INVARIANT[located-end-position]: source=%p/%s has no endOfConstruct\n",
                       static_cast<const void*>(this), this->class_name().c_str());
               ROSE_ABORT();
             }
            else
             {
               end->set_parent(locatedNode);
               ROSE_ASSERT(end->get_parent() != NULL);
             }

          SgExpression* expression = isSgExpression(result);
          if (isSgExpression(this) != NULL)
             {
               Sg_File_Info* operatorPosition = expression->get_operatorPosition();

            // Not all SgExpression IR nodes have a valid operatorPosition (only applies to actual operators)
               if (operatorPosition != NULL)
                  {
                    operatorPosition->set_parent(expression);
                    ROSE_ASSERT(operatorPosition->get_parent() != NULL);
                  }
             }
        }

  // DQ (10/16/2007): Also set the Sg_File_Info parents for the SgInitializedName
     SgInitializedName* initializedName = isSgInitializedName(result);
     if (initializedName != NULL)
        {
       // If this is a SgLocatedNode then check the parents of the Sg_File_Info objects
          Sg_File_Info* start = initializedName->get_startOfConstruct();
          ROSE_ASSERT(start != NULL);
          start->set_parent(initializedName);
          ROSE_ASSERT(start->get_parent() != NULL);

        }

  // printf ("End of copy $CLASSNAME = %p = %s \n",this,SageInterface::get_name(this).c_str());

  // A function definition is physically owned by its defining declaration,
  // even though the declaration is reached through the definition's parent
  // relation rather than a normal downward data-member edge.  When the
  // definition itself is the copy root, include that exact owner while this
  // copy transaction is still nested.  The already-published definition map
  // entry closes the declaration/definition cycle without manufacturing a
  // second definition or requiring late repair.
     if (help.get_depth() == 1)
        {
          const SgFunctionDefinition* rootDefinition = isSgFunctionDefinition(this);
          if (rootDefinition != NULL)
             {
               SgFunctionDeclaration* rootDeclaration = rootDefinition->get_declaration();
               if (rootDeclaration == NULL || rootDeclaration->get_definition() != rootDefinition)
                  {
                    fprintf(stderr,
                            "REX_COPY_INVARIANT[function-definition-root-owner]: "
                            "definition=%p declaration=%p has no exact physical owner\n",
                            static_cast<const void*>(rootDefinition),
                            static_cast<void*>(rootDeclaration));
                    ROSE_ABORT();
                  }
               SgNode* copiedRootDeclaration = help.copyOrLookupAst(rootDeclaration);
               SgFunctionDeclaration* copiedDeclaration =
                   isSgFunctionDeclaration(copiedRootDeclaration);
               if (copiedDeclaration == NULL ||
                   copiedRootDeclaration == rootDeclaration)
                  {
                    fprintf(stderr,
                            "REX_COPY_INVARIANT[function-definition-root-owner]: "
                            "definition=%p declaration=%p copy=%p is not one exact copied owner\n",
                            static_cast<const void*>(rootDefinition),
                            static_cast<void*>(rootDeclaration),
                            static_cast<void*>(copiedRootDeclaration));
                    ROSE_ABORT();
                  }
               SgFunctionDefinition* copiedDefinition =
                   isSgFunctionDefinition(result);
               if (copiedDefinition == NULL ||
                   copiedDefinition->get_declaration() != copiedDeclaration ||
                   copiedDeclaration->get_definition() != copiedDefinition)
                  {
                    fprintf(stderr,
                            "REX_COPY_INVARIANT[function-definition-root-owner]: "
                            "copied definition=%p declaration=%p does not preserve the exact ownership cycle\n",
                            static_cast<void*>(copiedDefinition),
                            static_cast<void*>(copiedDeclaration));
                    ROSE_ABORT();
                  }
             }
        }

  // Record the depth of the copy so that we build an clear internal state (new feature)
  // used to associated old and new symbols in the original AST and the copy of the AST.
     help.decrementDepth();

  // Test if this is the root of the copy!
     if (help.get_depth() == 0)
        {
       // This is the original calling node.

       // Canonicalize provisional copied-node associations that influence
       // fixup traversal before any scope/symbol/reference repair begins.
          help.prepareRootCopyForFixup();

       // Call the fixup mechanism to correct details of the AST copy mechanism.
       // printf ("Calling $CLASSNAME::fixupCopy() (from root of AST being copied) \n");
#if ALT_FIXUP_COPY
       // DQ (11/7/2007): These need to be called separately (see documentation)
          fixupCopy_scopes (result,help);
          fixupCopy_symbols (result,help);
          fixupCopy_references (result,help);
#else
          fixupCopy(result,help);
#endif
          help.finalizeRootCopy();
       // Allow this to be called recursively, so accumulate the state.
       // Also, clear the state in the SgCopyHelp object.
       // help.clearState();
        }

     return result;
   }
