SOURCE_CLASS_DEFINITION_STATEMENT_START

void SgClassDefinition::post_construction_initialization() {}

void SgClassDefinition::set_declaration(SgClassDeclaration *new_val) {
  ROSE_ASSERT(new_val != nullptr);
  set_parent(new_val);
}

SgClassDeclaration *SgClassDefinition::get_declaration() const {
  ROSE_ASSERT(get_parent() != NULL);
  SgClassDeclaration *decl = isSgClassDeclaration(get_parent());
  ROSE_ASSERT(decl != NULL);
  return decl;
}

SgClassDefinition::SgClassDefinition(Sg_File_Info *f, SgClassDeclaration *decl)
    : SgClassDefinition(f) {
  ROSE_ASSERT(decl != nullptr);
  set_declaration(decl);
  decl->set_definition(this);
}

SgClassDefinition::SgClassDefinition(SgClassDeclaration *decl)
    : SgClassDefinition() {
  ROSE_ASSERT(decl != nullptr);
  set_declaration(decl);
  decl->set_definition(this);
}

void SgClassDefinition::append_member(SgDeclarationStatement *what) {
  ROSE_ASSERT(what != nullptr && what->get_parent() == nullptr);
  get_members().push_back(what);
  what->set_parent(this);
}

void SgClassDefinition::prepend_member(SgDeclarationStatement *what) {
  ROSE_ASSERT(what != nullptr && what->get_parent() == nullptr);
  get_members().insert(get_members().begin(), what);
  what->set_parent(this);
}

void SgClassDefinition::append_inheritance(SgBaseClass *what) {
  ROSE_ASSERT(what != NULL && what->get_parent() == NULL);
  get_inheritances().push_back(what);
  what->set_parent(this);
}

void SgClassDefinition::prepend_inheritance(SgBaseClass *what) {
  ROSE_ASSERT(what != NULL && what->get_parent() == NULL);
  get_inheritances().insert(get_inheritances().begin(), what);
  what->set_parent(this);
}

SgName SgClassDefinition::get_qualified_name() const {
  SgClassDeclaration *classDeclaration = get_declaration();
  ROSE_ASSERT(classDeclaration != NULL);
  return classDeclaration->get_qualified_name();
}

SgName SgClassDefinition::get_mangled_name(void) const {
  SgClassDeclaration *classDeclaration = get_declaration();
  ROSE_ASSERT(classDeclaration != NULL);
  return classDeclaration->get_mangled_name();
}

bool SgClassDefinition::replace_child(SgStatement *target, SgStatement *newstmt,
                                      bool extractBasicBlock) {
  return StatementListInsertChild(this, get_members(), target, newstmt, true,
                                  extractBasicBlock, true);
}

bool SgClassDefinition::insert_child(SgStatement *target, SgStatement *newstmt,
                                     bool inFront, bool extractBasicBlock) {
  return StatementListInsertChild(this, get_members(), target, newstmt, inFront,
                                  extractBasicBlock, false);
}

SOURCE_CLASS_DEFINITION_STATEMENT_END

SOURCE_ENUM_DECLARATION_STATEMENT_START

void SgEnumDeclaration::post_construction_initialization() {
  ROSE_ASSERT(get_scope() != NULL);
  ROSE_ASSERT(SgNode::isLiveNode(get_scope()));
}

void
SgEnumDeclaration::append_enumerator(SgInitializedName *what) {
  const SgInitializedName::enum_constant_source_ownership_enum role =
      what != nullptr ? what->get_enum_constant_source_ownership()
                      : SgInitializedName::e_enum_constant_source_unclassified;
  if (what == nullptr ||
      (role != SgInitializedName::e_enum_constant_source_body &&
       role != SgInitializedName::e_enum_constant_source_external &&
       role != SgInitializedName::e_enum_constant_semantic_only) ||
      what->get_declptr() != this ||
      (what->get_parent() != nullptr && what->get_parent() != this)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[enum-source-ownership]: append requires an "
            "enumerator with one exact source role and semantic owner\n");
    ROSE_ABORT();
  }
  get_enumerators().push_back(what);
  what->set_parent(this);
}

void
SgEnumDeclaration::prepend_enumerator(SgInitializedName *what) {
  const SgInitializedName::enum_constant_source_ownership_enum role =
      what != nullptr ? what->get_enum_constant_source_ownership()
                      : SgInitializedName::e_enum_constant_source_unclassified;
  if (what == nullptr ||
      (role != SgInitializedName::e_enum_constant_source_body &&
       role != SgInitializedName::e_enum_constant_source_external &&
       role != SgInitializedName::e_enum_constant_semantic_only) ||
      what->get_declptr() != this ||
      (what->get_parent() != nullptr && what->get_parent() != this)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[enum-source-ownership]: prepend requires an "
            "enumerator with one exact source role and semantic owner\n");
    ROSE_ABORT();
  }
  get_enumerators().insert(get_enumerators().begin(), what);
  what->set_parent(this);
}

SgName SgEnumDeclaration::get_qualified_name() const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);
  return SgName::assembleQualifiedName(scope->get_qualified_name(), get_name());
}

SgName SgEnumDeclaration::get_mangled_name(void) const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);
  ROSE_ASSERT(SgNode::isLiveNode(scope));
  std::string mangledNameString = SageInterface::getMangledNameFromCache(
      const_cast<SgEnumDeclaration *>(this));
  if (mangledNameString.empty() == false) {
    return mangledNameString;
  }

  string mangleQualifiersString;
  if (isSgFunctionDefinition(scope) != NULL) {
    // Mangling the enclosing function here would recurse through its type.
    mangleQualifiersString = "_function_parameter_";
  } else {
    if (isSgGlobal(scope) == NULL) {
      ROSE_ASSERT(scope->get_scope() != NULL);
    }
    mangleQualifiersString = mangleQualifiers(scope);
  }

  SgName prefixed_name = "enum_" + get_name();
  SgName mangledName =
      joinMangledQualifiers(mangleQualifiersString, prefixed_name);
  return SageInterface::addMangledNameToCache(
      const_cast<SgEnumDeclaration *>(this), mangledName);
}

bool SgEnumDeclaration::hasExplicitScope() const { return true; }

SgSymbol *SgEnumDeclaration::get_symbol_from_symbol_table() const {
  SgEnumDeclaration *canonical =
      isSgEnumDeclaration(get_firstNondefiningDeclaration());
  if (canonical == nullptr ||
      canonical->get_firstNondefiningDeclaration() != canonical ||
      canonical->get_scope() == nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[enum-symbol-identity]: declaration=%p "
            "has no canonical first nondefining enum declaration\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  return canonical->get_scope()->find_symbol_from_declaration(canonical);
}

int SgEnumDeclaration::get_name_qualification_length() const {
  return p_name_qualification_length;
}

void SgEnumDeclaration::set_name_qualification_length(
    int name_qualification_length) {
  p_name_qualification_length = name_qualification_length;
}

bool SgEnumDeclaration::get_type_elaboration_required() const {
  return p_type_elaboration_required;
}

void SgEnumDeclaration::set_type_elaboration_required(
    bool type_elaboration_required) {
  p_type_elaboration_required = type_elaboration_required;
}

bool SgEnumDeclaration::get_global_qualification_required() const {
  return p_global_qualification_required;
}

void SgEnumDeclaration::set_global_qualification_required(
    bool global_qualification_required) {
  p_global_qualification_required = global_qualification_required;
}

void SgEnumDeclaration::validate_enumerator_source_ownership() const {
  const Sg_File_Info *owner_start = get_startOfConstruct();
  const Sg_File_Info *owner_end = get_endOfConstruct();
  const bool owner_has_physical_source =
      owner_start != nullptr && owner_end != nullptr &&
      owner_start->get_physical_file_id() >= 0 &&
      owner_end->get_physical_file_id() >= 0 &&
      owner_start->isSameFile(*owner_end);
  const SgAuxiliaryDeclarationList *auxiliary_owner =
      isSgAuxiliaryDeclarationList(get_parent());

  const bool is_definition = get_definingDeclaration() == this;
  if (get_underlying_type_source_spelled() &&
      (get_field_type() == nullptr ||
       isSgTypeUnknown(get_field_type()->findBaseType()) != nullptr)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
            "marks a source-spelled underlying type without an exact "
            "semantic type\n",
            static_cast<const void *>(this), get_name().getString().c_str());
    ROSE_ABORT();
  }

  const SgInitializedNamePtrList &enumerators = get_enumerators();
  if (!enumerators.empty() && !is_definition) {
    fprintf(stderr,
            "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
            "nondefining declaration owns semantic enumerators\n",
            static_cast<const void *>(this), get_name().getString().c_str());
    ROSE_ABORT();
  }
  for (size_t index = 0; index < enumerators.size(); ++index) {
    const SgInitializedName *enumerator = enumerators[index];
    if (enumerator == nullptr || enumerator->get_parent() != this ||
        enumerator->get_declptr() != this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
              "enumerator index=%zu has no exact semantic owner\n",
              static_cast<const void *>(this), get_name().getString().c_str(),
              index);
      ROSE_ABORT();
    }

    const SgInitializedName::enum_constant_source_ownership_enum role =
        enumerator->get_enum_constant_source_ownership();
    const Sg_File_Info *field_start = enumerator->get_startOfConstruct();
    const Sg_File_Info *field_end = enumerator->get_endOfConstruct();
    const bool field_has_physical_source =
        field_start != nullptr && field_end != nullptr &&
        field_start->get_physical_file_id() >= 0 &&
        field_end->get_physical_file_id() >= 0 &&
        field_start->isSameFile(*field_end);
    const bool generated_field =
        field_start != nullptr && field_end != nullptr &&
        field_start->isCompilerGenerated() && field_end->isCompilerGenerated();

    switch (role) {
    case SgInitializedName::e_enum_constant_source_body:
      // Transformations can explicitly add a generated constant to a source
      // enum body.  Source-backed constants must instead prove exact physical
      // identity with that body.
      if (!generated_field &&
          (!owner_has_physical_source || !field_has_physical_source ||
           !owner_start->isSameFile(*field_start))) {
        fprintf(stderr,
                "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
                "direct enumerator index=%zu is not owned by the enum's "
                "physical source body\n",
                static_cast<const void *>(this), get_name().getString().c_str(),
                index);
        ROSE_ABORT();
      }
      break;

    case SgInitializedName::e_enum_constant_source_external:
      if (!owner_has_physical_source || !field_has_physical_source ||
          owner_start->isSameFile(*field_start) || generated_field) {
        fprintf(stderr,
                "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
                "external enumerator index=%zu lacks a distinct exact "
                "physical source owner\n",
                static_cast<const void *>(this), get_name().getString().c_str(),
                index);
        ROSE_ABORT();
      }
      break;

    case SgInitializedName::e_enum_constant_semantic_only:
      if (auxiliary_owner == nullptr || !generated_field ||
          !field_start->isFrontendSpecific() ||
          !field_end->isFrontendSpecific()) {
        fprintf(stderr,
                "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
                "semantic-only enumerator index=%zu has a lexical source "
                "owner\n",
                static_cast<const void *>(this), get_name().getString().c_str(),
                index);
        ROSE_ABORT();
      }
      break;

    case SgInitializedName::e_enum_constant_source_unclassified:
    case SgInitializedName::e_last_enum_constant_source_ownership:
    default:
      fprintf(stderr,
              "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
              "enumerator index=%zu has no exact source role\n",
              static_cast<const void *>(this), get_name().getString().c_str(),
              index);
      ROSE_ABORT();
    }
  }
}

SOURCE_ENUM_DECLARATION_STATEMENT_END

SOURCE_EXPRESSION_STATEMENT_START
void SgExprStatement::post_construction_initialization() {
  if (get_expression() != NULL)
    get_expression()->set_parent(this);
