HEADER_EMPTY_DECLARATION_START

// An empty declaration has one of three explicit lexical roles.  A source
// empty declaration owns the `;` token.  A preprocessing anchor owns only
// attached comments/directives.  A zero-width source replacement preserves an
// exact lexical position after a transformation removes a source surface, but
// does not itself contribute spelling.  The role is a required construction
// parameter so an unclassified empty declaration cannot exist.
enum empty_declaration_role_enum {
  e_empty_declaration_source_semicolon = 0,
  e_empty_declaration_preprocessing_anchor,
  e_empty_declaration_zero_width_source_replacement
};

empty_declaration_role_enum get_lexical_role() const;
void validate_lexical_role() const;

virtual SgName get_mangled_name(void) const override;

virtual unsigned int cfgIndexForEnd() const override;
virtual std::vector<VirtualCFG::CFGEdge>
cfgOutEdges(unsigned int index) override;
virtual std::vector<VirtualCFG::CFGEdge>
cfgInEdges(unsigned int index) override;

virtual bool hasExplicitScope() const override;

HEADER_EMPTY_DECLARATION_END

