SOURCE_TEMPLATE_VARIABLE_DECLARATION_STATEMENT_START

void SgTemplateVariableDeclaration::post_construction_initialization() {}

SgTemplateVariableDeclaration::SgTemplateVariableDeclaration(
    const SgName &var_name, SgType *type, SgInitializer *initializer,
    const SgTemplateArgumentPtrList &semanticArguments)
    : SgVariableDeclaration(var_name, type, initializer) {
  p_templateParameters = SgTemplateParameterPtrList();
  p_templateSpecializationArguments = SgTemplateArgumentPtrList();
  p_semanticTemplateArguments = semanticArguments;
  for (SgTemplateArgument *argument : p_semanticTemplateArguments) {
    ASSERT_not_null(argument);
    ASSERT_require(argument->get_parent() == nullptr);
    argument->set_parent(this);
  }
  p_deducedTemplateArguments = SgTemplateArgumentPtrList();
  p_specializedTemplateDeclaration = nullptr;
  p_constraintSatisfactionEvaluated = false;
  p_constraintSatisfactionSatisfied = true;
  p_constraintSatisfactionContainsErrors = false;
  p_constraintSatisfactionSubstitutionFailure = false;
  p_constraintSatisfactionSummary = "";
  p_sfinaeEvaluated = false;
  p_sfinaeSubstitutionFailure = false;
  p_sfinaeSummary = "";
}

SOURCE_TEMPLATE_VARIABLE_DECLARATION_STATEMENT_END

