SOURCE_USING_DECLARATION_STATEMENT_START

void SgUsingDeclarationStatement::post_construction_initialization() {
  set_firstNondefiningDeclaration(this);
  set_definingDeclaration(this);
  ROSE_ASSERT(p_declaration == nullptr || p_initializedName == nullptr);
  if (p_initializedName != nullptr &&
      p_initializedName->get_parent() == nullptr &&
      p_initializedName->get_declptr() == nullptr) {
    p_initializedName->set_parent(this);
  }
}

SgName SgUsingDeclarationStatement::get_mangled_name(void) const {
  SgName returnName;

  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  SgName name;
  if (get_declaration() != NULL)
    name = get_declaration()->get_mangled_name();
  else {
    ROSE_ASSERT(get_initializedName() != NULL);
    name = get_initializedName()->get_mangled_name();
  }

  returnName = scope->get_mangled_name() + SgName("_using_declaration_") + name;

  return returnName;
}

// Qualification metadata must not mark source as transformed.
int SgUsingDeclarationStatement::get_name_qualification_length() const {
  return p_name_qualification_length;
}

void SgUsingDeclarationStatement::set_name_qualification_length(
    int name_qualification_length) {
