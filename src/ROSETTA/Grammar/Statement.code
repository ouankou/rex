size_t numberOfNamespaceDefinitions() const;

SgNamespaceDefinitionStatement *get_previousNamespaceDefinition() const;
void set_previousNamespaceDefinition(
    SgNamespaceDefinitionStatement *previousNamespaceDefinition);
SgNamespaceDefinitionStatement *get_nextNamespaceDefinition() const;
void set_nextNamespaceDefinition(
    SgNamespaceDefinitionStatement *nextNamespaceDefinition);

//! Changes whenever any reopening chain gains, loses, or reorders a
//! definition, or a definition is destroyed.  Indexes derived from the chains
//! are current only while this value is unchanged.
static uint64_t get_reopening_chain_revision();

protected:
virtual bool replace_child(SgStatement *, SgStatement *,
                           bool extractListFromBasicBlock = false) override;
virtual bool insert_child(SgStatement *, SgStatement *, bool inFront = true,
                          bool extractListFromBasicBlock = false) override;

private:
static std::atomic<uint64_t> &reopeningChainRevision();
static void advanceReopeningChainRevision();

