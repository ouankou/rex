    get_condition()->set_parent(this);
  if (get_body())
    get_body()->set_parent(this);
#endif
}

bool SgWhileStmt::replace_child(SgStatement *target, SgStatement *newstmt,
                                bool extractBasicBlock) {
  if (StatementReplace(this, p_condition, target, newstmt) == true)
    return true;
  else
    return (StatementReplace(this, p_body, target, newstmt) == true);
}

// CLANG FRONTEND FIX: Implement insert_child for SgWhileStmt
bool SgWhileStmt::insert_child(SgStatement *target, SgStatement *newstmt,
                               bool inFront, bool extractBasicBlock) {
  // SgWhileStmt has a loop body where statements can be inserted
  SgBasicBlock *loop_body = isSgBasicBlock(p_body);
  if (loop_body != NULL) {
    // Try inserting into loop body
    if (StatementListInsertChild(loop_body, loop_body->get_statements(), target,
                                 newstmt, inFront, extractBasicBlock, false)) {
      return true;
    }
  }

  // Target not found in loop body
  return false;
}

// DQ (2/22/2007): Added to provide uniform support of mangle names for all
// scopes
SgName SgWhileStmt::get_mangled_name(void) const { return SgName(""); }

