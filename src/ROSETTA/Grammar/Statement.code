SOURCE_NAMELIST_STATEMENT_START
void SgNamelistStatement::post_construction_initialization() {
  ROSE_ASSERT(!p_group_list.empty());
  for (size_t i = 0; i < p_group_list.size(); ++i) {
    SgNameGroup *group = p_group_list[i];
    ROSE_ASSERT(group != nullptr && group->get_parent() == nullptr);
    group->validate_group();
    for (size_t j = 0; j < i; ++j)
      ROSE_ASSERT(group != p_group_list[j]);
  }
  for (SgNameGroup *group : p_group_list)
    group->set_parent(this);
}

SgName SgNamelistStatement::get_mangled_name(void) const {
  return SgName("__namelist__");
}

