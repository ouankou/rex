SOURCE_CLINKAGE_DECLARATION_STATEMENT_START

SgName SgClinkageDeclarationStatement::get_mangled_name(void) const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  std::string language = get_languageSpecifier();
  if (language == "C++") {
    language = "CXX";
  } else {
    if (language.empty()) {
      language = "unknown";
    }
  }

  SgName returnName = scope->get_mangled_name() + SgName("_clinkage_") +
                      SgName(class_name()) + SgName("_") + SgName(language);
  return returnName;
}

