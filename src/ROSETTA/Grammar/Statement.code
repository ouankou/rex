SOURCE_OMP_THREADPRIVATE_STATEMENT_START
void SgOmpThreadprivateStatement::post_construction_initialization() {}

SgName SgOmpThreadprivateStatement::get_mangled_name(void) const {
  SgName returnName;

  // The semantics of get_scope is that it can never be NULL (SgGlobal returns
  // itself as its scope!)
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  SgName variableNames;
  SgExpressionPtrList::const_iterator p = get_variables().begin();
  while (p != get_variables().end()) {
    SgVarRefExp *vref = isSgVarRefExp(*p);
    ROSE_ASSERT(vref != NULL);
    ROSE_ASSERT(vref->get_symbol() != NULL);
    SgVariableSymbol *sym = isSgVariableSymbol(vref->get_symbol());
    ROSE_ASSERT(sym != NULL);
    ROSE_ASSERT(sym->get_declaration() != NULL);
    variableNames += SgName("_variable_type_") +
                     vref->get_symbol()->get_type()->get_mangled() +
                     SgName("_variable_name_") +
                     sym->get_declaration()->get_mangled_name();

    p++;
  }
  returnName = scope->get_mangled_name() +
               SgName("_omp_threadprivate_declaration_") + variableNames;

  return returnName;
}

SOURCE_OMP_THREADPRIVATE_STATEMENT_END

