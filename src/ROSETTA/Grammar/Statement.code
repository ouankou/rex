HEADER_DECLARATION_STATEMENT_POSTDECLARATION_START
// The following template function requires the definition of SgBasicBlock, so
// we put it in the POSTDECLARATION.
template <class Elemtype>
inline bool StatementListInsertChild(
    SgStatement *parent,
    Rose_STL_Container<Elemtype *> &statement_or_declaration_container,
    SgStatement *target, SgStatement *n, bool inFront,
    bool extractFromBasicBlock, bool removeCurrent) {
  ROSE_ASSERT(parent != NULL);
  ROSE_ASSERT(target != NULL);

  bool targetLocated = find(statement_or_declaration_container.begin(),
                            statement_or_declaration_container.end(),
                            target) != statement_or_declaration_container.end();
  if (targetLocated == false) {
    printf("Error: target statement = %p not found in list of statements "
           "provided. \n",
           target);
    printf("       parent scope = %p = %s\n", parent,
           parent->class_name().c_str());
    printf("       target class = %s target->get_parent() = %p = %s\n",
           target->class_name().c_str(), target->get_parent(),
           target->get_parent() != NULL
               ? target->get_parent()->class_name().c_str()
               : "null");
    if (Sg_File_Info *targetFileInfo = target->get_file_info()) {
      printf("       target location: %s:%d\n",
             targetFileInfo->get_filenameString().c_str(),
             targetFileInfo->get_line());
    }
    fflush(stdout);
    ROSE_ASSERT(false);
  }

  unsigned int size = statement_or_declaration_container.size();
  for (unsigned int p = 0; p < size; ++p) {
    if (statement_or_declaration_container[p] == target) {
      SgBasicBlock *bn = extractFromBasicBlock ? isSgBasicBlock(n) : NULL;
      if (bn == NULL)
        ROSE_ASSERT(n == 0 || dynamic_cast<Elemtype *>(n) != 0);
      if (n != NULL && bn == NULL) {
        ROSE_ASSERT(n != target || removeCurrent);
        ROSE_ASSERT(n == target || n->get_parent() == NULL ||
                    n->get_parent() == parent);
        ROSE_ASSERT(n == target ||
                    std::find(statement_or_declaration_container.begin(),
                              statement_or_declaration_container.end(),
                              n) == statement_or_declaration_container.end());
      }
      if (n != NULL) {
        SgScopeStatement *parentScope = isSgScopeStatement(parent);
        if (parentScope == NULL)
          parentScope = parent->get_scope();
        ROSE_ASSERT(parentScope != NULL);
      }

      Rose_STL_Container<Elemtype *> extracted;
      if (bn != NULL) {
        const SgStatementPtrList &nl = bn->get_statements();
        extracted.reserve(nl.size());
        for (SgStatement *stmt : nl) {
          if (stmt == NULL || dynamic_cast<Elemtype *>(stmt) == NULL ||
              stmt->get_parent() != bn) {
            fprintf(stderr,
                    "REX_AST_INVARIANT[basic-block-extraction]: source block "
                    "contains a child without exact structural ownership\n");
            ROSE_ABORT();
          }
          if (std::find(statement_or_declaration_container.begin(),
                        statement_or_declaration_container.end(),
                        stmt) != statement_or_declaration_container.end()) {
            fprintf(stderr,
                    "REX_AST_INVARIANT[basic-block-extraction]: source and "
                    "destination containers already share a child\n");
            ROSE_ABORT();
          }
          if (std::find(extracted.begin(), extracted.end(), stmt) !=
              extracted.end()) {
            fprintf(stderr,
                    "REX_AST_INVARIANT[basic-block-extraction]: source block "
                    "contains a duplicate child\n");
            ROSE_ABORT();
          }
          extracted.push_back(static_cast<Elemtype *>(stmt));
        }
      }

      if (removeCurrent) {
        statement_or_declaration_container.erase(
            statement_or_declaration_container.begin() + p);
        // Removing a statement from its owning container also removes its
        // structural ownership.  Leaving the old parent in place makes the
        // detached subtree appear project-owned and lets later semantic-edge
        // traversals visit both the removed subtree and its replacement.
        // Clear the old edge before installing the replacement; if target and
        // n are the same node, the insertion below restores the exact owner.
        target->set_parent(NULL);
      }

      if (!inFront)
        ++p;

      if (bn == NULL) {
        if (n != 0) {
          n->set_parent(parent);
          statement_or_declaration_container.insert(
              statement_or_declaration_container.begin() + p,
              static_cast<Elemtype *>(n));
        }
      } else { // extract statements from n ,which is a basic block
        // Transfer the structural edge atomically.  Reparenting while leaving
        // the same statements in the source block gives every child two
        // owners, and repeated insertion at one index reverses source order.
        bn->get_statements().clear();
        for (Elemtype *stmt : extracted)
          stmt->set_parent(parent);
        statement_or_declaration_container.insert(
            statement_or_declaration_container.begin() + p, extracted.begin(),
            extracted.end());
      }

      return true;
    }
  }

  return false;
}

HEADER_DECLARATION_STATEMENT_POSTDECLARATION_END

HEADER_IF_STATEMENT_START

public:
enum if_statement_kind_enum {
  e_if_ordinary = 0,
  e_if_constexpr = 1,
  e_if_consteval = 2,
  e_if_not_consteval = 3
};
bool get_is_if_constexpr_statement() const {
  return p_if_statement_kind == e_if_constexpr;
}
bool get_is_if_consteval_statement() const {
  return p_if_statement_kind == e_if_consteval ||
         p_if_statement_kind == e_if_not_consteval;
}
bool runtime_branch_is_known() const {
  ROSE_ASSERT(p_if_statement_kind >= e_if_ordinary &&
              p_if_statement_kind <= e_if_not_consteval);
  ROSE_ASSERT(!p_if_constexpr_value_known || get_is_if_constexpr_statement());
  ROSE_ASSERT(!p_if_constexpr_value || p_if_constexpr_value_known);
  ROSE_ASSERT((p_conditional == nullptr) == get_is_if_consteval_statement());
  return get_is_if_consteval_statement() ||
         (get_is_if_constexpr_statement() && p_if_constexpr_value_known);
}
bool runtime_branch_is_true() const {
  ROSE_ASSERT(runtime_branch_is_known());
  return get_is_if_consteval_statement()
             ? p_if_statement_kind == e_if_not_consteval
             : p_if_constexpr_value;
}

