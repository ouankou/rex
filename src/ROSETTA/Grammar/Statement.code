// DQ (6/5/2007): Since namespaces are re-entrant we define a simple function to
// test if two namespaces are the same (not the same
// SgNamespaceDeclarationStatement, but the same namespace).
//! Check if two namespaces are the same
bool isSameNamespace(const SgNamespaceDeclarationStatement *n) const;

//! Install the physical syntax fragments owned by this namespace.  A split
//! opening has one exact introducer fragment followed by the name/brace
//! fragment; ordinary openings have no separate introducer.
void attach_source_fragments(SgNamespaceSourceFragment *opening_introducer,
                             SgNamespaceSourceFragment *opening,
                             SgNamespaceSourceFragment *closing);

SgNamespaceSourceFragment *get_opening_introducer_source_fragment();
const SgNamespaceSourceFragment *get_opening_introducer_source_fragment() const;
//! Return the earliest typed fragment in the namespace opening transaction.
SgNamespaceSourceFragment *get_first_opening_source_fragment();
const SgNamespaceSourceFragment *get_first_opening_source_fragment() const;
SgNamespaceSourceFragment *get_opening_source_fragment();
const SgNamespaceSourceFragment *get_opening_source_fragment() const;
SgNamespaceSourceFragment *get_closing_source_fragment();
const SgNamespaceSourceFragment *get_closing_source_fragment() const;

//! True only when both typed syntax fragments have been installed.
