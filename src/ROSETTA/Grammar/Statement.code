SOURCE_RETURN_STATEMENT_START

SgExpression *SgReturnStmt::get_expression() const { return p_expression; }

void SgReturnStmt::set_expression(SgExpression *expression) {
  ROSE_ASSERT(is_valid_nrvo_binding(expression, p_nrvo_candidate));
  p_expression = expression;
  markAsModified();
}

SgReturnStmt::return_keyword_kind_enum
SgReturnStmt::get_return_keyword_kind() const {
  return p_return_keyword_kind;
}

void SgReturnStmt::set_return_keyword_kind(return_keyword_kind_enum kind) {
  ROSE_ASSERT(kind == e_return_keyword_return ||
              kind == e_return_keyword_co_return);
  ROSE_ASSERT(p_nrvo_candidate == nullptr || kind == e_return_keyword_return);
  p_return_keyword_kind = kind;
  markAsModified();
}

bool SgReturnStmt::is_valid_nrvo_binding(SgExpression *expression,
                                         SgInitializedName *candidate) {
  if (candidate == nullptr)
    return true;
  if (!SgNode::isLiveNode(candidate) || expression == nullptr ||
      !expression->has_semantic_value_type())
    return false;
  auto *declaration = isSgVariableDeclaration(candidate->get_parent());
  auto *scope = candidate->get_scope();
  if (declaration == nullptr || candidate->get_declptr() != declaration ||
      scope == nullptr || candidate->get_cxx_field_index().has_value() ||
      isSgGlobal(scope) || isSgNamespaceDefinitionStatement(scope) ||
      isSgClassDefinition(scope) || isSgFunctionParameterScope(scope) ||
      std::count(declaration->get_variables().begin(),
                 declaration->get_variables().end(), candidate) != 1)
    return false;
  const auto &storage =
      declaration->get_declarationModifier().get_storageModifier();
  if (storage.isStatic() || storage.isExtern() ||
      storage.get_thread_local_storage() ||
      declaration->get_is_thread_local() || candidate->get_type() == nullptr ||
      SageInterface::containsUnknownType(candidate->get_type()) ||
      SageInterface::isVolatileType(candidate->get_type()))
    return false;
  SgExpression *source = expression;
  if (auto *initializer = isSgConstructorInitializer(source)) {
    auto *arguments = initializer->get_args();
    if (arguments == nullptr ||
        !SgConstructorInitializer::is_valid_elision_arguments(
            initializer->get_declaration(), arguments->get_expressions()))
      return false;
    source = arguments->get_expressions().front();
  }
  std::unordered_set<SgExpression *> visited;
  while (auto *cast = isSgCastExp(source)) {
    if (!visited.insert(cast).second ||
        cast->get_cast_type() != SgCastExp::e_implicit_cast)
      return false;
    source = cast->get_operand();
  }
  auto *reference = isSgVarRefExp(source);
  if (reference == nullptr || reference->get_symbol() == nullptr ||
      reference->get_symbol()->get_declaration() != candidate)
    return false;
  auto *expression_type = expression->get_type();
  return expression_type != nullptr &&
         !SageInterface::containsUnknownType(expression_type) &&
         SageInterface::cxxSourceTypeMatchesSemanticType(
             candidate->get_type()->stripTypedefsAndModifiers(),
             expression_type->stripTypedefsAndModifiers());
}

void SgReturnStmt::post_construction_initialization() {
  ROSE_ASSERT(is_valid_nrvo_binding(p_expression, p_nrvo_candidate));
  if (p_expression != NULL) {
    ROSE_ASSERT(p_expression->get_parent() == NULL);
    p_expression->set_parent(this);
  }
}

int SgReturnStmt::replace_expression(SgExpression *original_expression,
                                     SgExpression *new_expression) {
  ROSE_ASSERT(original_expression != NULL);
  ROSE_ASSERT(new_expression != NULL);
  ROSE_ASSERT(original_expression == p_expression);
  ROSE_ASSERT(original_expression->get_parent() == this);

  SageInterface::replaceExpression(original_expression, new_expression, true);
  return 0;
}

SOURCE_RETURN_STATEMENT_END

