SOURCE_OMP_FLUSH_STATEMENT_START
void SgOmpFlushStatement::post_construction_initialization() {
  if (p_variable_list == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-flush-variable-list]: statement=%p has "
            "no structural variable-list wrapper\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  if (p_variable_list->get_startOfConstruct() != NULL ||
      p_variable_list->get_endOfConstruct() != NULL ||
      p_variable_list->get_operatorPosition() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-flush-variable-list-producer]: "
            "statement=%p received a default wrapper with preexisting "
            "provenance start=%p end=%p operator=%p\n",
            static_cast<void *>(this),
            static_cast<void *>(p_variable_list->get_startOfConstruct()),
            static_cast<void *>(p_variable_list->get_endOfConstruct()),
            static_cast<void *>(p_variable_list->get_operatorPosition()));
    ROSE_ABORT();
  }
  SageInterface::setOneSourcePositionForTransformation(p_variable_list);
  Sg_File_Info *start = p_variable_list->get_startOfConstruct();
  Sg_File_Info *end = p_variable_list->get_endOfConstruct();
  Sg_File_Info *operator_position = p_variable_list->get_operatorPosition();
  if (start == NULL || end == NULL || operator_position == NULL ||
      start == end || start == operator_position || end == operator_position ||
      start->get_parent() != p_variable_list ||
      end->get_parent() != p_variable_list ||
      operator_position->get_parent() != p_variable_list ||
      !start->isTransformation() || !end->isTransformation() ||
      !operator_position->isTransformation() ||
      !start->isOutputInCodeGeneration() || !end->isOutputInCodeGeneration() ||
      !operator_position->isOutputInCodeGeneration() || start->isShared() ||
      end->isShared() || operator_position->isShared()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-flush-variable-list-producer]: "
            "statement=%p did not construct one complete, exclusively owned "
            "transformation provenance tuple\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  if (p_variable_list->get_parent() != NULL &&
      p_variable_list->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-flush-variable-list]: statement=%p "
            "received a variable-list wrapper owned by %p\n",
            static_cast<void *>(this),
            static_cast<void *>(p_variable_list->get_parent()));
    ROSE_ABORT();
  }
  p_variable_list->set_parent(this);
}

SgExprListExp *SgOmpFlushStatement::get_variable_list() {
  if (p_variable_list == NULL || p_variable_list->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-flush-variable-list]: statement=%p has "
            "an invalid structural variable-list owner\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  return p_variable_list;
}

const SgExprListExp *SgOmpFlushStatement::get_variable_list() const {
  if (p_variable_list == NULL || p_variable_list->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-flush-variable-list]: statement=%p has "
            "an invalid structural variable-list owner\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  return p_variable_list;
}

void SgOmpFlushStatement::replace_variable_list(SgExprListExp *replacement) {
  if (p_variable_list == NULL || p_variable_list->get_parent() != this ||
      !p_variable_list->get_expressions().empty() || replacement == NULL ||
      replacement == p_variable_list || replacement->get_parent() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-flush-variable-list-replacement]: "
            "statement=%p requires an exclusively owned empty current "
            "wrapper and a distinct unowned replacement\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  for (SgExpression *variable : replacement->get_expressions()) {
    if (variable == NULL || variable->get_parent() != replacement) {
      fprintf(stderr,
              "REX_AST_INVARIANT[openmp-flush-variable-list-replacement]: "
              "replacement=%p contains a null variable or one with the "
              "wrong owner\n",
              static_cast<void *>(replacement));
      ROSE_ABORT();
    }
  }
  SgExprListExp *old_list = p_variable_list;
  old_list->set_parent(NULL);
  p_variable_list = replacement;
  replacement->set_parent(this);
  delete old_list;
}

const SgExpressionPtrList &SgOmpFlushStatement::get_variables() const {
  const SgExprListExp *variable_list = get_variable_list();
  const SgExpressionPtrList &variables = variable_list->get_expressions();
  for (SgExpression *variable : variables) {
    if (variable == NULL || variable->get_parent() != variable_list) {
      fprintf(stderr,
              "REX_AST_INVARIANT[openmp-flush-variable-list]: statement=%p "
              "contains a null variable or one with the wrong owner\n",
              static_cast<const void *>(this));
      ROSE_ABORT();
    }
  }
  return variables;
}

void SgOmpFlushStatement::append_variable(SgExpression *variable) {
  if (p_variable_list == NULL || p_variable_list->get_parent() != this ||
      variable == NULL || variable->get_parent() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-flush-variable-list]: statement=%p "
            "cannot append through an invalid wrapper or append a null or "
            "already-owned variable\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  p_variable_list->get_expressions().push_back(variable);
  variable->set_parent(p_variable_list);
}
SOURCE_OMP_FLUSH_STATEMENT_END

