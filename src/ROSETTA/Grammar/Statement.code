// SgName& n, const SgType* t) const;
SgMemberFunctionSymbol *lookup_nontemplate_member_function_symbol(
    const SgName &n, const SgType *t,
    SgTemplateArgumentPtrList *templateArgumentsList = NULL) const;

// DQ (1/23/2019): This function adds the support to find the SgAlias symbols of
// a given name. This is important in handling the viability of symbols through
