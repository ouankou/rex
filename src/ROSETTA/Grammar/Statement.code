SOURCE_CLINKAGE_DECLARATION_STATEMENT_START

SgName SgClinkageDeclarationStatement::get_mangled_name(void) const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  std::string language = get_languageSpecifier();
  if (language == "C++") {
    language = "CXX";
  } else {
    if (language.empty()) {
      language = "unknown";
    }
  }

  SgName returnName = scope->get_mangled_name() + SgName("_clinkage_") +
                      SgName(class_name()) + SgName("_") + SgName(language);
  return returnName;
}

SOURCE_CLINKAGE_DECLARATION_STATEMENT_END

HEADER_OMP_EXEC_STATEMENT_START
enum runtime_source_origin_enum {
  e_runtime_source_unavailable,
  e_runtime_source_directive,
  e_runtime_source_generated
};
void initialize_runtime_source_context(const std::string &function_name,
                                      int physical_file_id, int line,
                                      runtime_source_origin_enum origin);
void mark_runtime_source_context_copied();
void validate_runtime_source_context() const;
virtual void fixupCopy_scopes(SgNode *copy, SgCopyHelp &help) const override;
HEADER_OMP_EXEC_STATEMENT_END

SOURCE_OMP_EXEC_STATEMENT_START
void SgOmpExecStatement::post_construction_initialization() {}

void SgOmpExecStatement::initialize_runtime_source_context(
    const std::string &function_name, int physical_file_id, int line,
    runtime_source_origin_enum origin) {
  validate_runtime_source_context();
  ROSE_ASSERT(p_runtime_source_origin == e_runtime_source_unavailable);
  ROSE_ASSERT(!function_name.empty() && physical_file_id >= 0 && line > 0);
  ROSE_ASSERT(origin == e_runtime_source_directive ||
              origin == e_runtime_source_generated);
  p_runtime_source_function_name = function_name;
  p_runtime_source_physical_file_id = physical_file_id;
  p_runtime_source_line = line;
  p_runtime_source_is_copied = false;
  p_runtime_source_origin = origin;
}

void SgOmpExecStatement::mark_runtime_source_context_copied() {
  validate_runtime_source_context();
  ROSE_ASSERT(p_runtime_source_origin != e_runtime_source_unavailable);
  p_runtime_source_is_copied = true;
}

void SgOmpExecStatement::validate_runtime_source_context() const {
  if (p_runtime_source_origin == e_runtime_source_unavailable) {
    ROSE_ASSERT(p_runtime_source_function_name.empty());
    ROSE_ASSERT(p_runtime_source_physical_file_id == -1);
    ROSE_ASSERT(p_runtime_source_line == 0 && !p_runtime_source_is_copied);
    return;
  }
  ROSE_ASSERT(p_runtime_source_origin == e_runtime_source_directive ||
              p_runtime_source_origin == e_runtime_source_generated);
  ROSE_ASSERT(!p_runtime_source_function_name.empty());
  ROSE_ASSERT(p_runtime_source_physical_file_id >= 0 && p_runtime_source_line > 0);
}
SOURCE_OMP_EXEC_STATEMENT_END

