void append_declaration(SgDeclarationStatement *declaration);
// Consume a detached source-surface wrapper before replacing it atomically
// with standalone transformed declarations.  Calling this while the group is
// still attached is a malformed partial mutation and aborts.
SgDeclarationStatementPtrList release_declarations_after_surface_removal();
void validate() const;

protected:
virtual bool replace_child(SgStatement *target, SgStatement *replacement,
                           bool extractListFromBasicBlock = false) override;
virtual bool insert_child(SgStatement *target, SgStatement *inserted,
                          bool inFront = true,
