SOURCE_FUNCTION_DECLARATION_STATEMENT_END

SOURCE_FUNCTION_PARAMETER_LIST_START

void SgFunctionParameterList::post_construction_initialization() {
  ROSE_ASSERT(get_definingDeclaration() == nullptr);
  set_firstNondefiningDeclaration(this);

  if (get_file_info() != NULL) {
    Sg_File_Info *endingPosition = new Sg_File_Info(*(get_file_info()));
    ROSE_ASSERT(endingPosition != NULL);

    // DQ (12/18/2006): Fixup parents of Sg_File_Info objects.
    endingPosition->set_parent(this);

    set_endOfConstruct(endingPosition);
  }
}

void SgFunctionParameterList::append_arg(SgInitializedName *what) {
  get_args().push_back(what);
  what->set_parent(this);
}

void SgFunctionParameterList::prepend_arg(SgInitializedName *what) {
  get_args().insert(get_args().begin(), what);
  what->set_parent(this);
}

SgName SgFunctionParameterList::get_mangled_name(void) const {
  std::string mangledNameString = SageInterface::getMangledNameFromCache(
      const_cast<SgFunctionParameterList *>(this));
  if (mangledNameString.empty() == false) {
    return mangledNameString;
  } else {
    SgName variableNames = "_args_";
    SgInitializedNamePtrList::const_iterator p = get_args().begin();
    while (p != get_args().end()) {
      variableNames += SgName("_variable_type_") +
                       (*p)->get_type()->get_mangled() +
                       SgName("_variable_name_") + (*p)->get_mangled_name();

      p++;
    }

    SgName mangledName = get_scope()->get_mangled_name() +
                         SgName("_function_parameter_list_") + variableNames;
    mangledName = SageInterface::addMangledNameToCache(
        const_cast<SgFunctionParameterList *>(this), mangledName);
    return mangledName;
  }
}

SOURCE_FUNCTION_PARAMETER_LIST_END

SOURCE_FUNCTION_DEFINTION_STATEMENT_START

void SgFunctionDefinition::post_construction_initialization() {
  p_construction_physical_output_owner = NULL;
  p_fortran_construction_name = "";
  p_destructor_epilogue = nullptr;
  p_destructor_epilogue_dependent = false;
  if (p_body != nullptr) {
    if (p_body->get_parent() != nullptr) {
      fprintf(stderr,
              "REX_AST_INVARIANT[function-definition-construction]: body=%p "
              "already has parent=%p\n",
              static_cast<void *>(p_body),
              static_cast<void *>(p_body->get_parent()));
      ROSE_ABORT();
    }
    p_body->set_parent(this);
  }
}

SgFunctionDefinition::SgFunctionDefinition(Sg_File_Info *f,
                                           SgFunctionDeclaration *d,
                                           SgBasicBlock *body)
    : SgScopeStatement(f), p_body(body) {
  post_construction_initialization();
  set_declaration(d);
  if (d != NULL)
    d->set_definition(this);
}

SgFunctionDefinition::SgFunctionDefinition(SgFunctionDeclaration *d,
                                           SgBasicBlock *body)
    : SgScopeStatement(), p_body(body) {
  post_construction_initialization();
  set_declaration(d);
  if (d != NULL)
    d->set_definition(this);
}

void SgFunctionDefinition::adopt_destructor_epilogue(
    SgExprListExp *epilogue, const SgInitializedNamePtrList &members) {
  SgMemberFunctionDeclaration *declaration =
      isSgMemberFunctionDeclaration(get_declaration());
  ROSE_ASSERT(declaration != nullptr &&
              declaration->get_specialFunctionModifier().isDestructor());
  ROSE_ASSERT(!p_destructor_epilogue_dependent &&
              p_destructor_epilogue == nullptr && epilogue != nullptr &&
              epilogue->get_parent() == nullptr);
  auto *scope = isSgClassDefinition(declaration->get_scope());
  ROSE_ASSERT(scope != nullptr);
  std::map<SgClassDeclaration *, std::optional<size_t>> direct_order;
  std::map<SgClassDeclaration *, std::optional<size_t>> virtual_order;
  std::map<SgClassDefinition *, bool> complete;
  std::function<void(SgClassDefinition *)> visit =
      [&](SgClassDefinition *owner) {
        const auto [state, inserted] = complete.emplace(owner, false);
        if (!inserted) {
          ROSE_ASSERT(state->second);
          return;
        }
        for (auto *base : owner->get_inheritances()) {
          ROSE_ASSERT(base != nullptr && base->variantT() == V_SgBaseClass &&
                      base->get_parent() == owner);
          if (!base->get_isDirectBaseClass())
            continue;
          auto *target = base->get_base_class();
          ROSE_ASSERT(target != nullptr);
          auto *first =
              isSgClassDeclaration(target->get_firstNondefiningDeclaration());
          auto *defining =
              isSgClassDeclaration(target->get_definingDeclaration());
          ROSE_ASSERT(first != nullptr && defining != nullptr &&
                      defining->get_definition() != nullptr);
          visit(defining->get_definition());
          if (base->get_baseClassModifier()->isVirtual()) {
            const size_t ordinal = virtual_order.size();
            virtual_order.emplace(first, ordinal);
          } else if (owner == scope) {
            const size_t ordinal = direct_order.size();
            ROSE_ASSERT(direct_order.emplace(first, ordinal).second);
          }
        }
        complete.at(owner) = true;
      };
  visit(scope);
  size_t previous_base = direct_order.size();
  size_t previous_virtual = virtual_order.size();
  bool direct_bases = false, virtual_bases = false;
  std::optional<unsigned int> previous_member;
  for (SgExpression *expression : epilogue->get_expressions()) {
    SgCxxSubobjectDestruction *step = isSgCxxSubobjectDestruction(expression);
    ROSE_ASSERT(step != nullptr && step->get_parent() == epilogue);
    step->validate();
    switch (step->get_target_kind()) {
    case SgCxxSubobjectDestruction::e_member: {
      ROSE_ASSERT(!virtual_bases && !direct_bases);
      ROSE_ASSERT(step->get_member_target()->get_scope() ==
                  declaration->get_scope());
      const unsigned int index =
          *step->get_member_target()->get_cxx_field_index();
      ROSE_ASSERT(!previous_member || index < *previous_member);
      previous_member = index;
      break;
    }
    case SgCxxSubobjectDestruction::e_nonvirtual_base: {
      ROSE_ASSERT(!virtual_bases);
      auto position = direct_order.find(isSgClassDeclaration(
          step->get_base_target()->get_firstNondefiningDeclaration()));
      ROSE_ASSERT(position != direct_order.end() && position->second &&
                  *position->second < previous_base);
      previous_base = *position->second;
      position->second.reset();
      direct_bases = true;
      break;
    }
    case SgCxxSubobjectDestruction::e_virtual_base: {
      virtual_bases = true;
      auto position = virtual_order.find(isSgClassDeclaration(
          step->get_base_target()->get_firstNondefiningDeclaration()));
      ROSE_ASSERT(position != virtual_order.end() && position->second &&
                  *position->second < previous_virtual);
      previous_virtual = *position->second;
      position->second.reset();
      break;
    }
    default:
      ROSE_ABORT();
    }
  }
  const auto require_trivial = [](const auto &remaining) {
    for (const auto &[base, ordinal] : remaining) {
      if (!ordinal)
        continue;
      auto *destructor = SageInterface::getDefaultDestructor(base);
      ROSE_ASSERT(destructor != nullptr);
      ROSE_ASSERT(
          destructor->get_functionModifier().getDestructorProperties() ==
          SgFunctionModifier::e_destructor_selected_trivial);
    }
  };
  require_trivial(direct_order);
  require_trivial(virtual_order);
  std::set<unsigned int> field_indices;
  for (auto *member : members) {
    ROSE_ASSERT(member != nullptr && member->get_scope() == scope &&
                member->get_cxx_field_index());
    ROSE_ASSERT(field_indices.insert(*member->get_cxx_field_index()).second);
    auto *variable = isSgVariableDeclaration(member->get_parent());
    ROSE_ASSERT(
        variable != nullptr && member->get_declptr() == variable &&
        !variable->get_declarationModifier().get_storageModifier().isStatic() &&
        std::count(variable->get_variables().begin(),
                   variable->get_variables().end(), member) == 1);
  }
  ROSE_ASSERT(members.empty() || scope->get_declaration()->get_class_type() !=
                                     SgClassDeclaration::e_union);
  ROSE_ASSERT(
      has_complete_member_destruction(epilogue->get_expressions(), members));
  p_destructor_epilogue = epilogue;
  epilogue->set_parent(this);
}

bool SgFunctionDefinition::has_complete_member_destruction(
    const SgExpressionPtrList &steps, const SgInitializedNamePtrList &members) {
  std::set<SgInitializedName *> remaining(members.begin(), members.end());
  if (remaining.size() != members.size())
    return false;
  for (auto *expression : steps) {
    auto *step = isSgCxxSubobjectDestruction(expression);
    if (step == nullptr)
      return false;
    if (step->get_target_kind() == SgCxxSubobjectDestruction::e_member &&
        remaining.erase(step->get_member_target()) != 1)
      return false;
  }
  for (auto *member : remaining)
    if (auto *object = SgCxxSubobjectDestruction::get_member_class(member))
      if (!SageInterface::HasTrivialDestructor(object))
        return false;
  return true;
}

void SgFunctionDefinition::defer_destructor_epilogue() {
  SgMemberFunctionDeclaration *declaration =
      isSgMemberFunctionDeclaration(get_declaration());
  ROSE_ASSERT(declaration != nullptr &&
              declaration->get_specialFunctionModifier().isDestructor());
  ROSE_ASSERT(!p_destructor_epilogue_dependent &&
              p_destructor_epilogue == nullptr);
  ROSE_ASSERT(has_dependent_destructor_context());
  p_destructor_epilogue_dependent = true;
}

bool SgFunctionDefinition::has_dependent_destructor_context() const {
  SgFunctionDeclaration *declaration = get_declaration();
  if (declaration == nullptr)
    return false;
  std::set<SgScopeStatement *> visited;
  for (SgScopeStatement *scope = declaration->get_scope(); scope != nullptr;
       scope = scope->get_scope()) {
    if (!visited.insert(scope).second)
      return false;
    SgNode *owner = scope->get_parent();
    if (isSgTemplateClassDeclaration(owner) ||
        isSgTemplateFunctionDeclaration(owner) ||
        isSgTemplateMemberFunctionDeclaration(owner))
      return true;
    if (isSgGlobal(scope))
      break;
  }
  return false;
}

SgFunctionDeclaration *SgFunctionDefinition::get_declaration() const {
  SgNode *res = get_parent();
  SgFunctionDeclaration *res1 = isSgFunctionDeclaration(res);
  ROSE_ASSERT(res == 0 || res1 != 0);
  return res1;
}

void SgFunctionDefinition::set_declaration(SgFunctionDeclaration *new_val) {
  set_parent(new_val);
}

bool SgFunctionDefinition::replace_child(SgStatement *target,
                                         SgStatement *newstmt,
                                         bool extractBasicBlock) {
  return StatementReplace(this, p_body, target, newstmt);
}

bool SgFunctionDefinition::insert_child(SgStatement *target,
                                        SgStatement *newstmt, bool inFront,
                                        bool extractBasicBlock) {
  SgBasicBlock *body = get_body();
  if (body == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-definition-body]: definition=%p has "
            "no body while inserting child=%p\n",
            static_cast<void *>(this), static_cast<void *>(newstmt));
    ROSE_ABORT();
  }

  return StatementListInsertChild(body, body->get_statements(), target, newstmt,
                                  inFront, extractBasicBlock, false);
}

void SgFunctionDefinition::append_statement(SgStatement *what) {
  if (!get_body()) {
    SgBasicBlock *body = new SgBasicBlock(New_File_Info(this));
    body->set_parent(this);
    set_body(body);
  }
  get_body()->append_statement(what);

  ROSE_ASSERT(what->get_parent() != NULL);
}

void SgFunctionDefinition::prepend_statement(SgStatement *what) {
  if (!get_body()) {
    SgBasicBlock *body = new SgBasicBlock(New_File_Info(this));
    body->set_parent(this);
    set_body(body);
  }
  get_body()->prepend_statement(what);

  ROSE_ASSERT(what->get_parent() != NULL);
}

SgName SgFunctionDefinition::get_mangled_name(void) const {
  const SgFunctionDeclaration *decl = get_declaration();
  ROSE_ASSERT(decl);
  return decl->get_mangled_name();
}

std::map<SgNode *, int> &SgFunctionDefinition::get_scope_number_list() {
  return p_scope_number_list;
}

int SgFunctionDefinition::get_scope_number(const SgNode *scope) const {
  SgFunctionDefinition *modifiableThis =
      const_cast<SgFunctionDefinition *>(this);
  SgNode *modifiableScope = const_cast<SgNode *>(scope);
  if (p_scope_number_list.empty() == true) {
    // Build a local reference that can be modified (cast cost from this cost
    // function to get access).
    modifiableThis->resetScopeNumbers();
  }

  ROSE_ASSERT(p_scope_number_list.empty() == false);

  // Make sure that the required entry is in the map!
  std::map<SgNode *, int>::const_iterator iter =
      this->p_scope_number_list.find(modifiableScope);
  if (iter == this->p_scope_number_list.end()) {
    int n = (int)modifiableThis->p_scope_number_list.size() + 1;
    modifiableThis->p_scope_number_list[modifiableScope] = n;
    iter = this->p_scope_number_list.find(modifiableScope);
  }
  ROSE_ASSERT(iter != this->p_scope_number_list.end());

  int uniqueScopeNumber = iter->second;

  ROSE_ASSERT(uniqueScopeNumber > 0);

  return uniqueScopeNumber;
}

void SgFunctionDefinition::clearScopeNumbers() {
  SageInterface::clearScopeNumbers(this);
}

void SgFunctionDefinition::resetScopeNumbers() {
  SageInterface::resetScopeNumbers(this);
}

SgName SgFunctionDefinition::get_qualified_name() const {
  SgName returnName = "";
  return returnName;
}

// MD (09/20/2010): Accessor for preinitialization lists associated with
// this (constructor) definition. NULL if this has no such list.
SgCtorInitializerList *SgFunctionDefinition::get_CtorInitializerList() const {
  SgMemberFunctionDeclaration *memDecl = NULL;
  SgCtorInitializerList *ctorList = NULL;
  if ((memDecl = isSgMemberFunctionDeclaration(get_declaration())) != NULL &&
      (ctorList = memDecl->get_CtorInitializerList()) != NULL)
    return ctorList;
  else
    return NULL;
}

SOURCE_FUNCTION_DEFINTION_STATEMENT_END

SOURCE_MEMBER_FUNCTION_DECLARATION_STATEMENT_START

bool SgMemberFunctionDeclaration::isDefinedInClass() const {
  bool returnValue = false;

  // If the scopes are the same then the class is structurally defined in the
  // class scope
  bool isDefiningDeclaration = (get_definition() != NULL);
  bool isDeclaredInClassScope = (get_parent() == get_scope());
  if ((isDefiningDeclaration == true) && (isDeclaredInClassScope == true))
    returnValue = true;

  return returnValue;
}

void SgMemberFunctionDeclaration::post_construction_initialization() {
  // Every member-function node owns this structural support node, including
  // ordinary methods that cannot have a constructor-initializer list.  This
  // constructor does not yet know whether its owner is an exact source
  // declaration, a semantic auxiliary declaration, or a transformation.  Keep
  // the structural list unclassified until the typed function builder publishes
  // that ownership.  Classifying it here races the real producer: semantic
  // construction sees an already-classified node, while the Clang frontend can
  // no longer publish the exact constructor source surface.
  p_CtorInitializerList = new SgCtorInitializerList();
  ROSE_ASSERT(p_CtorInitializerList != NULL);
  if (p_CtorInitializerList->get_file_info() != NULL ||
      p_CtorInitializerList->get_startOfConstruct() != NULL ||
      p_CtorInitializerList->get_endOfConstruct() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[member-function-ctor-list-construction]: "
            "member=%p structural constructor-list=%p was classified before "
            "its typed producer\n",
            static_cast<void *>(this),
            static_cast<void *>(p_CtorInitializerList));
    ROSE_ABORT();
  }

  ROSE_ASSERT(p_CtorInitializerList->get_definingDeclaration() ==
              p_CtorInitializerList);
  ROSE_ASSERT(p_CtorInitializerList->get_firstNondefiningDeclaration() ==
              p_CtorInitializerList);

  p_CtorInitializerList->set_parent(this);
}

void SgMemberFunctionDeclaration::append_ctor_initializer(
    SgInitializedName *iName) {
  ROSE_ASSERT(p_CtorInitializerList != NULL);
  get_CtorInitializerList()->append_ctor_initializer(iName);
}

void SgMemberFunctionDeclaration::prepend_ctor_initializer(
    SgInitializedName *iName) {
  ROSE_ASSERT(p_CtorInitializerList != NULL);
  get_CtorInitializerList()->prepend_ctor_initializer(iName);
}

SgInitializedNamePtrList &SgMemberFunctionDeclaration::get_ctors() {
  ROSE_ASSERT(p_CtorInitializerList != NULL);
  return get_CtorInitializerList()->get_ctors();
}

const SgInitializedNamePtrList &SgMemberFunctionDeclaration::get_ctors() const {
  ROSE_ASSERT(get_CtorInitializerList() != NULL);
  return get_CtorInitializerList()->get_ctors();
}

SgName SgMemberFunctionDeclaration::get_qualified_name() const {
  // The semantics of get_scope is that it can never be NULL (SgGlobal returns
  // itself as its scope!)
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  SgName returnName =
      SgName::assembleQualifiedName(scope->get_qualified_name(), get_name());

  return returnName;
}

bool SgMemberFunctionDeclaration::replace_child(SgStatement *target,
                                                SgStatement *newstmt,
                                                bool extractBasicBlock) {
  if (SgFunctionDeclaration::replace_child(target, newstmt,
                                           extractBasicBlock) == true) {
    return true;
  } else {
    // Handle other possible replacements
    if (StatementReplace(this, p_scope, target, newstmt) == true) {
      return true;
    } else {
      return (StatementReplace(this, p_CtorInitializerList, target, newstmt) ==
              true);
    }
  }
}

SgDeclarationStatement *
SgMemberFunctionDeclaration::get_associatedClassDeclaration() const {
  if (isSgClassDeclaration(p_associatedClassDeclaration) == NULL &&
      isSgNonrealDecl(p_associatedClassDeclaration) == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[member-function-class]: declaration=%p "
            "name=%s has no typed associated class declaration\n",
            static_cast<const void *>(this), get_name().str());
    ROSE_ABORT();
  }
  return p_associatedClassDeclaration;
}

void SgMemberFunctionDeclaration::set_associatedClassDeclaration(
    SgDeclarationStatement *associatedClassDeclaration) {
  p_associatedClassDeclaration = associatedClassDeclaration;
  markAsModified();
}

SgScopeStatement *SgMemberFunctionDeclaration::get_class_scope(void) const {
  SgDeclarationStatement *decl =
      get_associatedClassDeclaration()->get_definingDeclaration();
  ROSE_ASSERT(decl != NULL);
  if (SgClassDeclaration *classDeclaration = isSgClassDeclaration(decl))
    return classDeclaration->get_definition();
  if (SgNonrealDecl *nonrealDeclaration = isSgNonrealDecl(decl))
    return nonrealDeclaration->get_nonreal_decl_scope();
  ROSE_ASSERT(false);
  ROSE_ABORT();
}

SOURCE_MEMBER_FUNCTION_DECLARATION_STATEMENT_END

SOURCE_CTOR_INITIALIZER_LIST_START

void SgCtorInitializerList::post_construction_initialization() {
  if (get_file_info() != NULL) {
    Sg_File_Info *endingPosition = new Sg_File_Info(*(get_file_info()));
    ROSE_ASSERT(endingPosition != NULL);

    // DQ (12/18/2006): Added to set all parents of Sg_File_Info objects.
    endingPosition->set_parent(this);

    set_endOfConstruct(endingPosition);
  }

  this->set_definingDeclaration(this);
  this->set_firstNondefiningDeclaration(this);
}

/* SgInitializedName tuple: (SgName, type, Initializer) */
void SgCtorInitializerList::append_ctor_initializer(SgInitializedName *iName) {
  ROSE_ASSERT(iName != NULL && iName->get_parent() == NULL);
  ROSE_ASSERT(std::find(get_ctors().begin(), get_ctors().end(), iName) ==
              get_ctors().end());
  get_ctors().push_back(iName);
  iName->set_parent(this);
}

void SgCtorInitializerList::prepend_ctor_initializer(SgInitializedName *iName) {
  ROSE_ASSERT(iName != NULL && iName->get_parent() == NULL);
  ROSE_ASSERT(std::find(get_ctors().begin(), get_ctors().end(), iName) ==
              get_ctors().end());
  get_ctors().insert(get_ctors().begin(), iName);
  iName->set_parent(this);
}

SgName SgCtorInitializerList::get_mangled_name(void) const {
  SgName returnName;

  // The semantics of get_scope is that it can never be NULL (SgGlobal returns
  // itself as its scope!)
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  SgName memberNames;
  SgInitializedNamePtrList::const_iterator p = get_ctors().begin();
  while (p != get_ctors().end()) {
    memberNames += SgName("_variable_type_") + (*p)->get_type()->get_mangled() +
                   SgName("_variable_name_") + (*p)->get_mangled_name();

    p++;
  }

  returnName = scope->get_mangled_name() +
               SgName("_constructor_initialization_list_") + memberNames;

  return returnName;
}

SOURCE_CTOR_INITIALIZER_LIST_END

SOURCE_VARIABLE_DECLARATION_STATEMENT_START

SgVariableDeclaration::SgVariableDeclaration(Sg_File_Info *info,
                                             const SgName &var_name,
                                             SgType *type,
                                             SgInitializer *initializer)
    : SgVariableDeclaration(info) {
  initializeData(info, var_name, type, initializer);
}

SgVariableDeclaration::SgVariableDeclaration(const SgName &var_name,
                                             SgType *type,
                                             SgInitializer *initializer)
    : SgVariableDeclaration() {
  initializeData(NULL, var_name, type, initializer);
}

SgVariableDeclaration::SgVariableDeclaration(Sg_File_Info *info,
                                             SgInitializedName *c_item)
    : SgVariableDeclaration(info) {
  initializeData(info, c_item);
}

SgVariableDeclaration::SgVariableDeclaration(SgInitializedName *c_item)
    : SgVariableDeclaration() {
  initializeData(NULL, c_item);
}

void SgVariableDeclaration::initializeData(Sg_File_Info *info,
                                           const SgName &var_name, SgType *type,
                                           SgInitializer *initializer) {

  SgInitializedName *c_item =
      SageBuilder::buildInitializedName_nfi(var_name, type, initializer, this);
  ROSE_ASSERT(c_item != NULL);

  initializeData(info, c_item);
}

void SgVariableDeclaration::initializeData(Sg_File_Info *info,
                                           SgInitializedName *c_item) {

  ROSE_ASSERT(c_item != NULL);

  SgInitializer *initializer = c_item->get_initptr();

  c_item->set_parent(this);

  if (initializer != NULL) {
    initializer->set_parent(c_item);
  }

  if (info != NULL) {
    Sg_File_Info *copyOfFileInfo = new Sg_File_Info(*info);
    ROSE_ASSERT(copyOfFileInfo != NULL);

    copyOfFileInfo->set_parent(c_item);

    c_item->set_startOfConstruct(copyOfFileInfo);
  }

  // append_variable constructs the definition using this same initializer.
  this->append_variable(c_item, initializer);

  this->setNameOnly();
}

void SgVariableDeclaration::post_construction_initialization() {}

SgVariableDefinition *
SgVariableDeclaration::get_definition(SgInitializedName *ditem) {
  const SgInitializedNamePtrList &names = get_variables();
  ROSE_ASSERT(!names.empty());
  SgInitializedName *selected = ditem != nullptr ? ditem : names.front();
  for (SgInitializedName *name : names) {
    ROSE_ASSERT(name != nullptr);
    if (name == selected) {
      return isSgVariableDefinition(name->get_definition());
    }
  }
  fprintf(stderr,
          "REX_AST_INVARIANT[variable-definition-item]: requested declarator "
          "is not owned by this declaration\n");
  ROSE_ABORT();
}

SgExpression *SgVariableDeclaration::get_bitfield() {
  SgVariableDefinition *definition = get_definition();
  return definition != nullptr ? definition->get_bitfield() : nullptr;
}

void SgVariableDeclaration::set_bitfield(SgExpression *bfield) {
  SgVariableDefinition *definition = get_definition();
  ROSE_ASSERT(definition != nullptr);
  definition->set_bitfield(bfield);
}

void SgVariableDeclaration::reset_initializer(SgInitializer *initializer) {
  ROSE_ASSERT(!get_variables().empty());
  SgInitializedName *name = get_variables().front();
  ROSE_ASSERT(name != nullptr);
  name->set_initializer(initializer);
}

void SgVariableDeclaration::append_variable(SgInitializedName *what,
                                            SgInitializer *initializer) {
  ROSE_ASSERT(what != NULL);

  get_variables().push_back(what);
  what->set_parent(this);

  SageBuilder::buildVariableDefinition_nfi(this, what, initializer);
}

SgInitializedName *SgVariableDeclaration::get_decl_item(const SgName &nm) {
  SgInitializedName *decl_item = NULL;

  SgInitializedNamePtrList::iterator p = get_variables().begin();
  while (p != get_variables().end()) {
    if (nm.is_null() || (*p)->get_name() == nm) {
      decl_item = *p;
      break;
    }
    p++;
  }
  return decl_item;
}

SgStatement *SgVariableDeclaration::get_next(int &n) const {
  if (isNameOnly())
    return 0;
  while (n < 2) {
    SgDeclarationStatement *next = n++ == 0
                                       ? get_baseTypeNondefiningDeclaration()
                                       : get_baseTypeDefiningDeclaration();
    if (next != NULL) {
      // Traversal follows only exact owned edges. Recovering declarations
      // through a shared SgNamedType can cross into another AST or silently
      // invent declarator ownership for an ordinary tag reference.
      return next;
    }
  }
  return 0;
}

SgName SgVariableDeclaration::get_mangled_name(void) const {
  SgName returnName;

  // The semantics of get_scope is that it can never be NULL (SgGlobal returns
  // itself as its scope!)
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  SgName variableNames;
  SgInitializedNamePtrList::const_iterator p = get_variables().begin();
  while (p != get_variables().end()) {
    variableNames += SgName("_variable_type_") +
                     (*p)->get_type()->get_mangled() +
                     SgName("_variable_name_") + (*p)->get_mangled_name();

    p++;
  }

  returnName = scope->get_mangled_name() + SgName("_variable_declaration_") +
               variableNames;

  return returnName;
}

// Return the explicitly owned inline base-type definition edge.
SgDeclarationStatement *
SgVariableDeclaration::compute_baseTypeDefiningDeclaration() const {
  return p_baseTypeDefiningDeclaration;
}

SgDeclarationStatement *
SgVariableDeclaration::get_baseTypeDefiningDeclaration() const {
  return compute_baseTypeDefiningDeclaration();
}

SgDeclarationStatement *
SgVariableDeclaration::get_baseTypeNondefiningDeclaration() const {
  return p_baseTypeNondefiningDeclaration;
}

static bool declaratorTypeNamesExactOwnedTag(
    SgType *declarator_type, SgDeclarationStatement *owned_tag,
    bool require_definition, SgDeclarationStatement **semantic_role) {
  SgType *base_type =
      declarator_type != NULL ? declarator_type->findBaseType() : NULL;
  SgNamedType *named_type = isSgNamedType(base_type);
  SgDeclarationStatement *type_declaration =
      named_type != NULL ? named_type->get_declaration() : NULL;
  SgDeclarationStatement *type_role = NULL;
  if (type_declaration != NULL) {
    type_role = require_definition
                    ? type_declaration->get_definingDeclaration()
                    : type_declaration->get_firstNondefiningDeclaration();
    if (type_role == NULL) {
      type_role = type_declaration;
    }
  }
  if (semantic_role != NULL) {
    *semantic_role = type_role;
  }
  return SageInterface::isExactTagTypeIdentity(declarator_type, owned_tag);
}

void SgVariableDeclaration::set_baseTypeNondefiningDeclaration(
    SgDeclarationStatement *d) {
  if (d == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[variable-inline-tag-introduction-owner]: null "
            "declaration is not a valid ownership publication\n");
    ROSE_ABORT();
  }
  if (p_baseTypeNondefiningDeclaration != NULL ||
      p_baseTypeDefiningDeclaration != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[variable-inline-tag-introduction-owner]: "
            "variable=%p already owns nondefining=%p defining=%p and cannot "
            "publish declaration=%p\n",
            static_cast<void *>(this),
            static_cast<void *>(p_baseTypeNondefiningDeclaration),
            static_cast<void *>(p_baseTypeDefiningDeclaration),
            static_cast<void *>(d));
    ROSE_ABORT();
  }

  SgClassDeclaration *class_declaration = isSgClassDeclaration(d);
  SgEnumDeclaration *enum_declaration = isSgEnumDeclaration(d);
  const bool exact_class_introduction =
      class_declaration != NULL && class_declaration->get_definition() == NULL;
  const bool exact_enum_introduction =
      enum_declaration != NULL && enum_declaration->isForward();
  if (d->get_parent() != this || d->get_firstNondefiningDeclaration() != d ||
      d->get_definingDeclaration() == d ||
      (!exact_class_introduction && !exact_enum_introduction) ||
      (class_declaration != NULL &&
       class_declaration->get_isAutonomousDeclaration()) ||
      (enum_declaration != NULL &&
       enum_declaration->get_isAutonomousDeclaration())) {
    fprintf(stderr,
            "REX_AST_INVARIANT[variable-inline-tag-introduction-owner]: "
            "variable=%p declaration=%p/%s parent=%p first=%p defining=%p "
            "is not one exact owned non-autonomous tag introduction\n",
            static_cast<void *>(this), static_cast<void *>(d),
            d->class_name().c_str(), static_cast<void *>(d->get_parent()),
            static_cast<void *>(d->get_firstNondefiningDeclaration()),
            static_cast<void *>(d->get_definingDeclaration()));
    ROSE_ABORT();
  }
  if (get_variables().empty()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[variable-inline-tag-introduction-owner]: "
            "variable=%p has no declarators for declaration=%p\n",
            static_cast<void *>(this), static_cast<void *>(d));
    ROSE_ABORT();
  }

  for (SgInitializedName *initialized_name : get_variables()) {
    SgType *declarator_type =
        initialized_name != NULL ? initialized_name->get_type() : NULL;
    SgDeclarationStatement *type_first = NULL;
    if (initialized_name == NULL ||
        !declaratorTypeNamesExactOwnedTag(declarator_type, d, false,
                                          &type_first)) {
      fprintf(stderr,
              "REX_AST_INVARIANT[variable-inline-tag-introduction-owner]: "
              "variable=%p declarator=%p type=%p names first=%p instead of "
              "exact owned introduction=%p\n",
              static_cast<void *>(this), static_cast<void *>(initialized_name),
              static_cast<void *>(declarator_type),
              static_cast<void *>(type_first), static_cast<void *>(d));
      ROSE_ABORT();
    }
  }

  p_baseTypeNondefiningDeclaration = d;
}

void SgVariableDeclaration::set_baseTypeDefiningDeclaration(
    SgDeclarationStatement *d) {
  // DQ (10/17/2007): This is a non ROSETTA generated function so that the
  // get_baseTypeDefiningDeclaration() version can be written to use the
  // compute_baseTypeDefiningDeclaration() member function.  However, we are
  // changing the compute_baseTypeDefiningDeclaration() member function to
  // return the explicitly stored defining declaration in a
  // SgVariableDeclaration (if such a thing is defined).  An example of where
  // this happens is in: "struct { int x; } y;", here the structure declaration
  // is in the variable declaration for "y".

  if (d == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[variable-inline-type-owner]: null definition "
            "is not a valid ownership publication\n");
    ROSE_ABORT();
  }
  if (p_baseTypeNondefiningDeclaration != NULL ||
      p_baseTypeDefiningDeclaration != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[variable-inline-type-owner]: variable=%p "
            "already owns nondefining=%p definition=%p and cannot republish "
            "definition=%p\n",
            static_cast<void *>(this),
            static_cast<void *>(p_baseTypeNondefiningDeclaration),
            static_cast<void *>(p_baseTypeDefiningDeclaration),
            static_cast<void *>(d));
    ROSE_ABORT();
  }
  SgClassDeclaration *class_declaration = isSgClassDeclaration(d);
  SgEnumDeclaration *enum_declaration = isSgEnumDeclaration(d);
  if (d->get_parent() != this || d->get_definingDeclaration() != d ||
      (class_declaration == NULL && enum_declaration == NULL) ||
      (class_declaration != NULL &&
       (class_declaration->get_definition() == NULL ||
        class_declaration->get_isAutonomousDeclaration())) ||
      (enum_declaration != NULL &&
       enum_declaration->get_isAutonomousDeclaration())) {
    fprintf(stderr,
            "REX_AST_INVARIANT[variable-inline-type-owner]: variable=%p "
            "declaration=%p type=%s parent=%p defining=%p is not an exact "
            "owned non-autonomous class/enum definition\n",
            static_cast<void *>(this), static_cast<void *>(d),
            d->class_name().c_str(), static_cast<void *>(d->get_parent()),
            static_cast<void *>(d->get_definingDeclaration()));
    ROSE_ABORT();
  }

  if (get_variables().empty()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[variable-inline-type-owner]: variable=%p has "
            "no declarators for inline definition=%p\n",
            static_cast<void *>(this), static_cast<void *>(d));
    ROSE_ABORT();
  }
  for (SgInitializedName *initialized_name : get_variables()) {
    SgType *declarator_type =
        initialized_name != NULL ? initialized_name->get_type() : NULL;
    SgDeclarationStatement *type_definition = NULL;
    if (initialized_name == NULL ||
        !declaratorTypeNamesExactOwnedTag(declarator_type, d, true,
                                          &type_definition)) {
      fprintf(stderr,
              "REX_AST_INVARIANT[variable-inline-type-owner]: variable=%p "
              "declarator=%p type=%p names definition=%p instead of exact "
              "owned definition=%p\n",
              static_cast<void *>(this), static_cast<void *>(initialized_name),
              static_cast<void *>(declarator_type),
              static_cast<void *>(type_definition), static_cast<void *>(d));
      ROSE_ABORT();
    }
  }
  p_baseTypeDefiningDeclaration = d;
}

// Qualification metadata must not mark source as transformed.
int SgVariableDeclaration::get_name_qualification_length() const {
  return p_name_qualification_length;
}

void SgVariableDeclaration::set_name_qualification_length(
    int name_qualification_length) {
  p_name_qualification_length = name_qualification_length;
}

bool SgVariableDeclaration::get_type_elaboration_required() const {
  return p_type_elaboration_required;
}

void SgVariableDeclaration::set_type_elaboration_required(
    bool type_elaboration_required) {
  p_type_elaboration_required = type_elaboration_required;
}

bool SgVariableDeclaration::get_global_qualification_required() const {
  return p_global_qualification_required;
}

void SgVariableDeclaration::set_global_qualification_required(
    bool global_qualification_required) {
  p_global_qualification_required = global_qualification_required;
}

bool SgVariableDeclaration::get_requiresGlobalNameQualificationOnType() const {
  return p_requiresGlobalNameQualificationOnType;
}

void SgVariableDeclaration::set_requiresGlobalNameQualificationOnType(
    bool requiresGlobalNameQualificationOnType) {
  p_requiresGlobalNameQualificationOnType =
      requiresGlobalNameQualificationOnType;
}

SOURCE_VARIABLE_DECLARATION_STATEMENT_END

SOURCE_VARIABLE_DEFINITION_STATEMENT_START
void SgVariableDefinition::post_construction_initialization() {
  if (p_bitfield != nullptr) {
    ROSE_ASSERT(p_bitfield->get_parent() == nullptr);
    p_bitfield->set_parent(this);
  }
}

SgExpression *SgVariableDefinition::get_bitfield() const { return p_bitfield; }

void SgVariableDefinition::set_bitfield(SgExpression *bitfield) {
  ROSE_ASSERT(p_bitfield == nullptr || p_bitfield->get_parent() == this);
  if (p_bitfield != bitfield) {
    ROSE_ASSERT(bitfield == nullptr || bitfield->get_parent() == nullptr);
    ROSE_ASSERT(bitfield == nullptr || !SageInterface::isAncestor(bitfield, this));
    if (p_bitfield != nullptr)
      p_bitfield->set_parent(nullptr);
    p_bitfield = bitfield;
    if (bitfield != nullptr)
      bitfield->set_parent(this);
  }
  markAsModified();
}

SgVariableDeclaration *SgVariableDefinition::get_declaration() {
  ROSE_ASSERT(get_vardefn() != NULL);

  SgVariableDeclaration *rdecl =
      isSgVariableDeclaration(get_vardefn()->get_declaration());
  return rdecl;
}

SgVariableDefinition::SgVariableDefinition(Sg_File_Info *info,
                                           SgInitializedName *decl_item,
                                           SgInitializer *initializer)
    : $BASECLASS(info), p_vardefn(decl_item), p_bitfield(0),
      p_is_zero_width_bitfield(false), p_has_no_unique_address(false) {
  ROSE_ASSERT(decl_item != NULL);
  set_parent(decl_item);
  get_vardefn()->set_initializer(initializer);
  get_vardefn()->set_definition(this);
}

SgVariableDefinition::SgVariableDefinition(SgInitializedName *decl_item,
                                           SgInitializer *initializer)
    : p_vardefn(decl_item), p_bitfield(0), p_is_zero_width_bitfield(false),
      p_has_no_unique_address(false) {
  ROSE_ASSERT(decl_item != NULL);

  set_parent(decl_item);
  get_vardefn()->set_initializer(initializer);
  get_vardefn()->set_definition(this);
}

SgType *SgVariableDefinition::get_type() { return get_vardefn()->get_type(); }

SgName SgVariableDefinition::get_mangled_name(void) const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);
  return scope->get_mangled_name() + SgName("_variable_definition_") +
         get_vardefn()->get_mangled_name();
}

SOURCE_VARIABLE_DEFINITION_STATEMENT_END

SOURCE_CLASS_DECLARATION_STATEMENT_START

void SgClassDeclaration::post_construction_initialization() {}

bool SgClassDeclaration::replace_child(SgStatement *target,
                                       SgStatement *newstmt,
                                       bool extractBasicBlock) {
  return false;
}

SgName SgClassDeclaration::get_qualified_name() const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);
  return SgName::assembleQualifiedName(scope->get_qualified_name(), get_name());
}

SgName SgClassDeclaration::get_mangled_name(void) const {
  std::string mangledNameString = SageInterface::getMangledNameFromCache(
      const_cast<SgClassDeclaration *>(this));
  if (mangledNameString.empty() == false) {
    return mangledNameString;
  } else {
    ROSE_ASSERT(get_scope() != NULL);
    SgName mangledScopeName = mangleQualifiers(get_scope());

    SgName prefixed_name = "class_" + get_name();
    SgName mangledName = joinMangledQualifiers(mangledScopeName, prefixed_name);
    if (mangledName.is_null()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[class-mangled-name]: declaration=%p name=%s "
              "scope=%p produced an empty mangled name\n",
              static_cast<const void *>(this), get_name().str(),
              static_cast<void *>(get_scope()));
      ROSE_ABORT();
    }

    mangledName = SageInterface::addMangledNameToCache(
        const_cast<SgClassDeclaration *>(this), mangledName);
    ROSE_ASSERT(mangledName.getString().find('<') == string::npos);

    return mangledName;
  }
}

bool SgClassDeclaration::hasExplicitScope() const {
  return true;
}

SgSymbol *SgClassDeclaration::get_symbol_from_symbol_table() const {
  SgClassDeclaration *canonical =
      isSgClassDeclaration(get_firstNondefiningDeclaration());
  if (canonical == nullptr ||
      canonical->get_firstNondefiningDeclaration() != canonical) {
    fprintf(stderr,
            "REX_AST_INVARIANT[class-symbol-identity]: declaration=%p/%s "
            "has no canonical first nondefining class declaration=%p\n",
            static_cast<const void *>(this), class_name().c_str(),
            static_cast<void *>(get_firstNondefiningDeclaration()));
    ROSE_ABORT();
  }
  SgScopeStatement *canonical_scope = canonical->get_scope();
  if (canonical_scope == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[class-symbol-identity]: canonical class "
            "declaration=%p/%s has no exact semantic scope\n",
            static_cast<void *>(canonical), canonical->class_name().c_str());
    ROSE_ABORT();
  }
  return canonical_scope->find_symbol_from_declaration(canonical);
}

SgClassDefinition *SgClassDeclaration::compute_classDefinition() const {
  if (isForward() || p_definition == NULL) {
    return NULL;
  }

  // Only the defining declaration owns traversal into the class body. Type
  // references can point at the same definition from within that body (for
  // example a local typedef naming the enclosing class), and traversing from
  // those nondefining declarations back into the shared definition creates a
  // structural AST cycle.
  SgClassDeclaration *owning_declaration = p_definition->get_declaration();
  if (owning_declaration != this) {
    return NULL;
  }

  return p_definition;
}

// Qualification updates must not set isModified: token unparsing treats that
// flag as a source transformation.
int SgClassDeclaration::get_name_qualification_length() const {
  return p_name_qualification_length;
}

void SgClassDeclaration::set_name_qualification_length(
    int name_qualification_length) {
  p_name_qualification_length = name_qualification_length;
}

bool SgClassDeclaration::get_type_elaboration_required() const {
  return p_type_elaboration_required;
}

void SgClassDeclaration::set_type_elaboration_required(
    bool type_elaboration_required) {
  p_type_elaboration_required = type_elaboration_required;
}

bool SgClassDeclaration::get_global_qualification_required() const {
  return p_global_qualification_required;
}

void SgClassDeclaration::set_global_qualification_required(
    bool global_qualification_required) {

  p_global_qualification_required = global_qualification_required;
}

SOURCE_CLASS_DECLARATION_STATEMENT_END

SOURCE_NONREAL_DECL_START

void SgNonrealDecl::post_construction_initialization() {}

SgName SgNonrealDecl::get_name(void) const { return p_name; }

void SgNonrealDecl::set_name(SgName name) { p_name = name; }

SgNonrealType *SgNonrealDecl::get_type(void) const { return p_type; }

void SgNonrealDecl::set_type(SgNonrealType *t) { p_type = t; }

bool SgNonrealDecl::hasExplicitScope() const {
  // Semantic nonreal declarations are published in an explicit
  // SgDeclarationScope.  A concept, however, is a source declaration and its
  // scope is the lexical owner derived from its structural parent.
  return !get_is_concept();
}

SgName SgNonrealDecl::get_mangled_name(void) const {
  ostringstream mangled_name;

  SgScopeStatement *scope = get_scope();
  if (scope == nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[nonreal-semantic-scope]: declaration=%p name=%s "
            "requires an explicit semantic scope before mangling\n",
            static_cast<const void *>(this), get_name().str());
    ROSE_ABORT();
  }
  SgNode *parent_decl = scope->get_parent();
  if (isSgClassDefinition(scope) != nullptr) {
    SgTemplateClassDeclaration *tplcdecl =
        isSgTemplateClassDeclaration(parent_decl);
    SgClassDeclaration *xdecl = isSgClassDeclaration(parent_decl);
    SgNonrealDecl *nrdecl = isSgNonrealDecl(parent_decl);
    if (tplcdecl != NULL) {
      SgDeclarationScope *nrscope = tplcdecl->get_nonreal_decl_scope();
      if (nrscope != scope) {
        mangled_name << tplcdecl->get_mangled_name().getString() << "___";
      }
    } else if (xdecl != NULL) {
      mangled_name << xdecl->get_mangled_name().getString() << "___";
    } else if (nrdecl != NULL) {
      mangled_name << nrdecl->get_mangled_name().getString() << "___";
    }
  }

  if (get_is_template_param()) {
    // Template parameters are alpha-equivalent by their depth and position.
    // Embedding the transient SgDeclarationScope address made independently
    // owned source and semantic copies of the same template parameter acquire
    // different identities.  It also made mangled names process-dependent.
    // The enclosing declaration's mangled identity already supplies the
    // lexical owner; the parameter contributes only its structural coordinate.
    mangled_name << "__templ_param_" << p_template_parameter_depth << "_"
                 << p_template_parameter_position << "__";
  } else {
    mangled_name << get_name().getString();
  }

  SgName mangled(mangled_name.str());

  if (get_tpl_params().size() > 0)
    mangled = mangleTemplate(mangled, get_tpl_params(), get_scope());

  if (get_nonreal_template_role() == e_nonreal_template_id ||
      !get_tpl_args().empty())
    mangled = mangleTemplate(mangled, get_tpl_args(), get_scope());

  return mangled;
}

SgSymbol *SgNonrealDecl::get_symbol_from_symbol_table() const {
  ROSE_ASSERT(get_parent() != nullptr);
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != nullptr);
  SgSymbol *symbol = scope->find_symbol_from_declaration(this);
  if (symbol == nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[nonreal-symbol-scope]: declaration=%p name=%s "
            "has no symbol in its recorded semantic scope=%p/%s\n",
            static_cast<const void *>(this), get_name().str(),
            static_cast<void *>(scope), scope->class_name().c_str());
    ROSE_ABORT();
  }
  return symbol;
}

SgName SgNonrealDecl::get_qualified_name() const {
  SgName returnName;
  SgClassDeclaration *xdecl = isSgClassDeclaration(get_templateDeclaration());
  SgFunctionDeclaration *fdecl =
      isSgFunctionDeclaration(get_templateDeclaration());
  if (xdecl != NULL) {
    returnName = xdecl->get_qualified_name();
  } else if (fdecl != NULL) {
    returnName = fdecl->get_qualified_name();
  } else {
    returnName = get_name();
  }

  // TODO template argument

  return returnName;
}

SOURCE_NONREAL_DECL_END

SOURCE_TEMPLATE_INSTANTIATION_DECLARATION_STATEMENT_START
void SgTemplateInstantiationDecl::post_construction_initialization() {
  auto publish_argument_surface = [&](SgTemplateArgumentPtrList &arguments,
                                      const char *surface) {
    for (SgTemplateArgument *argument : arguments) {
      if (argument == nullptr || argument->get_parent() != nullptr) {
        fprintf(stderr,
                "REX_AST_INVARIANT[template-argument-constructor-owner]: "
                "declaration=%p/%s surface=%s argument=%p parent=%p requires "
                "one distinct detached argument surface\n",
                static_cast<void *>(this), class_name().c_str(), surface,
                static_cast<void *>(argument),
                static_cast<void *>(argument != nullptr ? argument->get_parent()
                                                        : nullptr));
        ROSE_ABORT();
      }
      argument->set_parent(this);
    }
  };
  publish_argument_surface(p_templateArguments, "written");
  publish_argument_surface(p_semanticTemplateArguments, "identity");
  publish_argument_surface(p_deducedTemplateArguments, "semantic");
}

SgName SgTemplateInstantiationDecl::get_qualified_name() const {
  SgName returnName;

  // The semantics of get_scope is that it can never be NULL (SgGlobal returns
  // itself as its scope!)
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  returnName =
      SgName::assembleQualifiedName(scope->get_qualified_name(), get_name());

  return returnName;
}

SgName SgTemplateInstantiationDecl::get_mangled_name(void) const {
  std::string mangledNameString = SageInterface::getMangledNameFromCache(
      const_cast<SgTemplateInstantiationDecl *>(this));

  if (mangledNameString.empty() == false) {
    return mangledNameString;
  } else {
    SgName template_name = get_templateName();
    if (template_name.is_null() == true) {
      fprintf(stderr, "SgTemplateInstantiationDecl::get_mangled_name(): "
                      "missing template name\n");
      ROSE_ASSERT(false);
    }
    // Written arguments are a source surface, not specialization identity.
    // They can remain dependent (for example `sizeof...(Ints)`) while Clang
    // has instantiated distinct concrete specializations. Only the complete
    // semantic argument list may participate in class-type uniquing.
    SgName mangledName = mangleTemplate(
        template_name, get_semanticTemplateArguments(), get_scope());
    // Defining instantiations do not always have a separate forward
    // declaration. The mangled name depends on the template name, arguments,
    // and scope, not on a non-null first-nondefining link.
    ROSE_ASSERT(mangledName.is_null() == false);

    mangledName = SageInterface::addMangledNameToCache(
        const_cast<SgTemplateInstantiationDecl *>(this), mangledName);
    string mangled_name = mangledName;
    ROSE_ASSERT(mangled_name.find('<') == string::npos);

    return mangledName;
  }
}

void SgTemplateInstantiationDecl::set_definition(
    SgTemplateInstantiationDefn *definition) {
  // DQ (9/23/2004): Implement this function to hide the base class one so that
  // the interface to set_definition takes a SgTemplateInstantiationDefn instead
  // of a SgClassDefinition. Implement using explicit call to the base class
  // set_definition function.
  SgClassDeclaration::set_definition(definition);
}

void SgTemplateInstantiationDecl::set_definition(
    SgClassDefinition *definition) {
  // We need a way for the automatically generated code to set the
  // definition data member in the base class.

  // DQ (10/10/2014): Make sure that this is a SgTemplateInstantiationDefn (or
  // NULL).
  ROSE_ASSERT(definition == NULL ||
              isSgTemplateInstantiationDefn(definition) != NULL);

  SgClassDeclaration::set_definition(definition);
}

SOURCE_TEMPLATE_INSTANTIATION_DECLARATION_STATEMENT_END

SOURCE_TEMPLATE_INSTANTIATION_FUNCTION_DECLARATION_STATEMENT_START
void SgTemplateInstantiationFunctionDecl::post_construction_initialization() {
  for (auto *arguments : {&p_templateArguments, &p_deducedTemplateArguments}) {
    for (SgTemplateArgument *argument : *arguments) {
      ASSERT_not_null(argument);
      ROSE_ASSERT(argument->get_parent() == nullptr);
      argument->set_parent(this);
    }
  }
}

SgName SgTemplateInstantiationFunctionDecl::get_mangled_name(void) const {
  std::string mangledNameString = SageInterface::getMangledNameFromCache(
      const_cast<SgTemplateInstantiationFunctionDecl *>(this));
  if (mangledNameString.empty() == false) {
    return mangledNameString;
  } else {
    // DQ (5/31/2012): Check that this name is set.
    ROSE_ASSERT(get_templateName().is_null() == false);

    SgName mangledName = mangleTemplateFunction(get_templateName().getString(),
                                                get_deducedTemplateArguments(),
                                                get_type(), get_scope());
    const SgFunctionDeclaration *templatePattern =
        isSgFunctionDeclaration(get_templateDeclaration());
    const SgExpression *templateConstraint = NULL;
    if (const SgTemplateFunctionDeclaration *templateFunction =
            isSgTemplateFunctionDeclaration(templatePattern)) {
      templateConstraint = templateFunction->get_requiresClause();
    } else if (const SgTemplateMemberFunctionDeclaration *templateMember =
                   isSgTemplateMemberFunctionDeclaration(templatePattern)) {
      templateConstraint = templateMember->get_requiresClause();
    }
    if (templateConstraint != NULL) {
      mangledName +=
          "__template_requires_" + mangleExpression(templateConstraint);
    }
    const SgExpression *trailingConstraint = get_trailingRequiresClause();
    if (trailingConstraint == NULL && templatePattern != NULL) {
      trailingConstraint = templatePattern->get_trailingRequiresClause();
    }
    if (trailingConstraint != NULL) {
      mangledName += "__requires_" + mangleExpression(trailingConstraint);
    }
    mangledName = SageInterface::addMangledNameToCache(
        const_cast<SgTemplateInstantiationFunctionDecl *>(this), mangledName);
    ROSE_ASSERT(mangledName.getString().find('<') == string::npos);

    return mangledName;
  }
}

SgTemplateInstantiationFunctionDecl::SgTemplateInstantiationFunctionDecl(
    SgName name, SgFunctionType *type, SgFunctionDefinition *definition,
    SgFunctionType *declaredExceptionSignature)
    : SgTemplateInstantiationFunctionDecl(
          name, type, definition, declaredExceptionSignature, nullptr,
          SgTemplateArgumentPtrList(), SgTemplateArgumentPtrList()) {
  ROSE_ASSERT(TEMPLATE_INST_FUNCTION_DECL_STMT == variant());
  ASSERT_not_null(isSgTemplateInstantiationFunctionDecl(this));
}

SOURCE_TEMPLATE_INSTANTIATION_FUNCTION_DECLARATION_STATEMENT_END

SOURCE_TEMPLATE_INSTANTIATION_MEMBER_FUNCTION_DECLARATION_STATEMENT_START
void SgTemplateInstantiationMemberFunctionDecl::
    post_construction_initialization() {
  for (auto *arguments : {&p_templateArguments, &p_deducedTemplateArguments}) {
    for (SgTemplateArgument *argument : *arguments) {
      ASSERT_not_null(argument);
      ROSE_ASSERT(argument->get_parent() == nullptr);
      argument->set_parent(this);
    }
  }
}

SgName SgTemplateInstantiationMemberFunctionDecl::get_mangled_name(void) const {
  std::string mangledNameString = SageInterface::getMangledNameFromCache(
      const_cast<SgTemplateInstantiationMemberFunctionDecl *>(this));
  if (mangledNameString.empty() == false) {
    return mangledNameString;
  } else {
    SgName mangledName = mangleTemplateFunction(get_templateName().getString(),
                                                get_deducedTemplateArguments(),
                                                get_type(), get_scope());
    const SgFunctionDeclaration *templatePattern =
        isSgFunctionDeclaration(get_templateDeclaration());
    const SgExpression *templateConstraint = NULL;
    if (const SgTemplateFunctionDeclaration *templateFunction =
            isSgTemplateFunctionDeclaration(templatePattern)) {
      templateConstraint = templateFunction->get_requiresClause();
    } else if (const SgTemplateMemberFunctionDeclaration *templateMember =
                   isSgTemplateMemberFunctionDeclaration(templatePattern)) {
      templateConstraint = templateMember->get_requiresClause();
    }
    if (templateConstraint != NULL) {
      mangledName +=
          "__template_requires_" + mangleExpression(templateConstraint);
    }
    const SgExpression *trailingConstraint = get_trailingRequiresClause();
    if (trailingConstraint == NULL && templatePattern != NULL) {
      trailingConstraint = templatePattern->get_trailingRequiresClause();
    }
    if (trailingConstraint != NULL) {
      mangledName += "__requires_" + mangleExpression(trailingConstraint);
    }
    mangledName = SageInterface::addMangledNameToCache(
        const_cast<SgTemplateInstantiationMemberFunctionDecl *>(this),
        mangledName);
    ROSE_ASSERT(mangledName.getString().find('<') == string::npos);

    return mangledName;
  }
}

SgTemplateInstantiationMemberFunctionDecl::
    SgTemplateInstantiationMemberFunctionDecl(
        SgName name, SgFunctionType *type, SgFunctionDefinition *definition,
        SgFunctionType *declaredExceptionSignature)
    : SgTemplateInstantiationMemberFunctionDecl(
          name, type, definition, declaredExceptionSignature, nullptr,
          SgTemplateArgumentPtrList(), SgTemplateArgumentPtrList()) {
  ROSE_ASSERT(TEMPLATE_INST_MEMBER_FUNCTION_DECL_STMT == variant());
  ROSE_ASSERT(isSgTemplateInstantiationMemberFunctionDecl(this) != NULL);
}

SOURCE_TEMPLATE_INSTANTIATION_MEMBER_FUNCTION_DECLARATION_STATEMENT_END

SOURCE_TEMPLATE_INSTANTIATION_DEFINITION_STATEMENT_START

