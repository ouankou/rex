void SgScopeStatement::print_symboltable(const std::string &str) {
  printf("In SgScopeStatement::print_symboltable(label = %s): \n", str.c_str());
  ROSE_ASSERT(p_symbol_table != NULL);

  const SgNamespaceDefinitionStatement *namespaceDefinitionStatement =
      isSgNamespaceDefinitionStatement(this);

  if (namespaceDefinitionStatement != NULL) {
    const SgNamespaceDefinitionStatement *globalNamespaceDefinitionStatement =
        namespaceDefinitionStatement->get_global_definition();
    ROSE_ASSERT(globalNamespaceDefinitionStatement != NULL);
    ROSE_ASSERT(namespaceDefinitionStatement !=
                globalNamespaceDefinitionStatement);
    ROSE_ASSERT(globalNamespaceDefinitionStatement->get_symbol_table() != NULL);

    printf("In SgScopeStatement::print_symboltable(): \n");
    printf("   --- namespaceDefinitionStatement->get_symbol_table()->size()    "
           "                      = %d \n",
           namespaceDefinitionStatement->get_symbol_table()->size());
    printf("   --- "
           "namespaceDefinitionStatement->get_global_definition()->get_symbol_"
           "table()->size() = %d \n",
           globalNamespaceDefinitionStatement->get_symbol_table()->size());
    printf("Symbols: \n");

    globalNamespaceDefinitionStatement->get_symbol_table()->print(
        "Called from SgScopeStatement::print_symboltable", V_SgSymbol);
  } else {
    p_symbol_table->print("Called from SgScopeStatement::print_symboltable",
                          V_SgSymbol);
  }
}

bool SgScopeStatement::containsOnlyDeclarations() const {
  switch (variantT()) {
  case V_SgAssociateStatement:
  case V_SgBasicBlock:
  case V_SgCatchOptionStmt:
  case V_SgDoWhileStmt:
  case V_SgForStatement:
  case V_SgRangeBasedForStatement:
  case V_SgFunctionDefinition:
  case V_SgTemplateFunctionDefinition:
  case V_SgIfStmt:
  case V_SgSwitchStatement:
  case V_SgWhileStmt:
  case V_SgFortranDo:
  case V_SgForAllStatement:
    return false;

  case V_SgTemplateClassDefinition:
  case V_SgClassDefinition:
  case V_SgTemplateInstantiationDefn:
  case V_SgNamespaceDefinitionStatement:
  case V_SgGlobal:
  case V_SgFunctionParameterScope:
  case V_SgDeclarationScope:
    return true;

  default:
    printf(
        "ERROR: default reached in switch "
        "(SgScopeStatement::containsOnlyDeclarations() is called from a %s) \n",
        class_name().c_str());
    ROSE_ABORT();
  }
}

bool SgScopeStatement::supportsDefiningFunctionDeclaration() {
  return containsOnlyDeclarations();
}

bool SgScopeStatement::statementExistsInScope(SgStatement *statement) {
  ROSE_ASSERT(statement != NULL);

  if (containsOnlyDeclarations()) {
    SgDeclarationStatementPtrList &declarationList = getDeclarationList();
    SgDeclarationStatement *declarationStatement =
        isSgDeclarationStatement(statement);
    ROSE_ASSERT(declarationStatement != NULL);
    return find(declarationList.begin(), declarationList.end(),
                declarationStatement) != declarationList.end();
  }

  SgStatementPtrList &statementList = getStatementList();
  return find(statementList.begin(), statementList.end(), statement) !=
         statementList.end();
}

void SgScopeStatement::insertStatementInScope(
    SgStatement *newTransformationStatement, bool atTop) {
  ROSE_ASSERT(newTransformationStatement != NULL);

  if (containsOnlyDeclarations()) {
    SgDeclarationStatement *declaration =
        isSgDeclarationStatement(newTransformationStatement);
    ROSE_ASSERT(declaration != NULL);
    if (SgDeclarationScope *scope = isSgDeclarationScope(this)) {
      declaration->set_scope(scope);
    }

    SgDeclarationStatementPtrList &declarations = getDeclarationList();
    ROSE_ASSERT(find(declarations.begin(), declarations.end(), declaration) ==
                declarations.end());

    const auto oldSize = declarations.size();
    if (declarations.empty()) {
      declarations.push_back(declaration);
      declaration->set_parent(this);
    } else {
      SgDeclarationStatement *anchor =
          atTop ? declarations.front() : declarations.back();
      ROSE_ASSERT(anchor != NULL);
      insert_statement(anchor, declaration, atTop);
    }
    ROSE_ASSERT(declarations.size() == oldSize + 1);
  } else {
    SgStatementPtrList &statements = getStatementList();
    const auto existing =
        find(statements.begin(), statements.end(), newTransformationStatement);
    if (existing != statements.end()) {
      printf("ERROR: already present in scope: newTransformationStatement = "
             "%p = %s \n",
             newTransformationStatement,
             newTransformationStatement->class_name().c_str());
    }
    ROSE_ASSERT(existing == statements.end());

    if (statements.empty()) {
      statements.push_back(newTransformationStatement);
      newTransformationStatement->set_parent(this);
    } else {
      SgStatement *anchor = atTop ? statements.front() : statements.back();
      ASSERT_not_null(anchor);
      insert_statement(anchor, newTransformationStatement, atTop);
    }
  }

  ROSE_ASSERT(newTransformationStatement->get_parent() != NULL);
}

SgDeclarationStatementPtrList &SgScopeStatement::getDeclarationList() {
  switch (variantT()) {
  case V_SgTemplateClassDefinition:
  case V_SgClassDefinition: {
    SgClassDefinition *classDefinitionScope = isSgClassDefinition(this);
    ROSE_ASSERT(classDefinitionScope != NULL);
    return classDefinitionScope->get_members();
  }

  case V_SgTemplateInstantiationDefn: {
    SgTemplateInstantiationDefn *templateInstantiationDefinitionScope =
        isSgTemplateInstantiationDefn(this);
    ROSE_ASSERT(templateInstantiationDefinitionScope != NULL);
    return templateInstantiationDefinitionScope->get_members();
  }

  case V_SgGlobal: {
    SgGlobal *globalScope = isSgGlobal(this);
    ROSE_ASSERT(globalScope != NULL);
    return globalScope->get_declarations();
  }

  case V_SgFunctionParameterScope: {
    SgFunctionParameterScope *paramScope = isSgFunctionParameterScope(this);
    ROSE_ASSERT(paramScope != NULL);
    return paramScope->get_declarations();
  }

  case V_SgNamespaceDefinitionStatement: {
    SgNamespaceDefinitionStatement *namespaceScope =
        isSgNamespaceDefinitionStatement(this);
    ROSE_ASSERT(namespaceScope != NULL);
    return namespaceScope->get_declarations();
  }

  case V_SgDeclarationScope: {
    SgDeclarationScope *declScope = isSgDeclarationScope(this);
    ROSE_ASSERT(declScope != NULL);
    return declScope->get_declarations();
  }

  default:
    printf("ERROR: default reached in switch (getDeclarationList()) "
           "currentScope = %s \n",
           sage_class_name());
    ROSE_ABORT();
  }
}

const SgDeclarationStatementPtrList &
SgScopeStatement::getDeclarationList() const {
  switch (variantT()) {
  case V_SgTemplateClassDefinition:
  case V_SgClassDefinition: {
    const SgClassDefinition *classDefinitionScope = isSgClassDefinition(this);
    ROSE_ASSERT(classDefinitionScope != NULL);
    return classDefinitionScope->get_members();
  }

  case V_SgTemplateInstantiationDefn: {
    const SgTemplateInstantiationDefn *templateInstantiationDefinitionScope =
        isSgTemplateInstantiationDefn(this);
    ROSE_ASSERT(templateInstantiationDefinitionScope != NULL);
    return templateInstantiationDefinitionScope->get_members();
  }

  case V_SgGlobal: {
    const SgGlobal *globalScope = isSgGlobal(this);
    ROSE_ASSERT(globalScope != NULL);
    return globalScope->get_declarations();
  }

  case V_SgFunctionParameterScope: {
    const SgFunctionParameterScope *paramScope =
        isSgFunctionParameterScope(this);
    ROSE_ASSERT(paramScope != NULL);
    return paramScope->get_declarations();
  }

  case V_SgNamespaceDefinitionStatement: {
    const SgNamespaceDefinitionStatement *namespaceScope =
        isSgNamespaceDefinitionStatement(this);
    ROSE_ASSERT(namespaceScope != NULL);
    return namespaceScope->get_declarations();
  }

  case V_SgDeclarationScope: {
    const SgDeclarationScope *declScope = isSgDeclarationScope(this);
    ROSE_ASSERT(declScope != NULL);
    return declScope->get_declarations();
  }

  default:
    printf("ERROR: default reached in switch (getDeclarationList() const) "
           "currentScope = %s \n",
           sage_class_name());
    ROSE_ABORT();
  }
}

SgStatementPtrList &SgScopeStatement::getStatementList() {
  SgScopeStatement *currentScope = this;
  ROSE_ASSERT(currentScope != NULL);

  SgStatementPtrList *currentStatementList = NULL;
  switch (currentScope->variantT()) {
  case V_SgBasicBlock: {
    SgBasicBlock *basicBlock = isSgBasicBlock(currentScope);
    ROSE_ASSERT(basicBlock != NULL);
    currentStatementList = &(basicBlock->get_statements());
    break;
  }

  case V_SgCatchOptionStmt: {
    SgCatchOptionStmt *catchOptionScope = isSgCatchOptionStmt(currentScope);
    ROSE_ASSERT(catchOptionScope != NULL);
    ROSE_ASSERT(catchOptionScope->get_body() != NULL);
    currentStatementList =
        &(SageInterface::ensureBasicBlockAsBodyOfCatch(catchOptionScope)
              ->getStatementList());
    break;
  }

  case V_SgTemplateClassDefinition:
  case V_SgClassDefinition:
  case V_SgTemplateInstantiationDefn:
  case V_SgGlobal:
  case V_SgNamespaceDefinitionStatement:
    printf("SgScopeStatement::getStatementList(): %s requires "
           "getDeclarationList()\n",
           sage_class_name());
    ROSE_ABORT();

  case V_SgDoWhileStmt: {
    SgDoWhileStmt *doWhileScope = isSgDoWhileStmt(currentScope);
    ROSE_ASSERT(doWhileScope != NULL);
    ROSE_ASSERT(doWhileScope->get_body() != NULL);
    currentStatementList =
        &(SageInterface::ensureBasicBlockAsBodyOfDoWhile(doWhileScope)
              ->getStatementList());
    break;
  }

  case V_SgForStatement: {
    SgForStatement *forScope = isSgForStatement(currentScope);
    ROSE_ASSERT(forScope != NULL);
    currentStatementList =
        &(SageInterface::ensureBasicBlockAsBodyOfFor(forScope)
              ->getStatementList());
    break;
  }

  case V_SgTemplateFunctionDefinition:
  case V_SgFunctionDefinition: {
    SgFunctionDefinition *functionScope = isSgFunctionDefinition(currentScope);
    ROSE_ASSERT(functionScope != NULL);
    ROSE_ASSERT(functionScope->get_body() != NULL);
    currentStatementList = &(functionScope->get_body()->getStatementList());
    break;
  }

  case V_SgIfStmt: {
    SgIfStmt *ifStatement = isSgIfStmt(currentScope);
    ROSE_ASSERT(ifStatement != NULL);

    printf("getStatementList() return value not defined for SgIfStmt "
           "containing true and false bodies (use generateStatementList() to "
           "form copy of merges lists) \n");
    ROSE_ASSERT(false);
    break;
  }

  case V_SgSwitchStatement: {
    SgSwitchStatement *switchStatement = isSgSwitchStatement(currentScope);
    ROSE_ASSERT(switchStatement != NULL);
    ROSE_ASSERT(switchStatement->get_body() != NULL);
    currentStatementList =
        &(SageInterface::ensureBasicBlockAsBodyOfSwitch(switchStatement)
              ->getStatementList());
    break;
  }

  case V_SgWhileStmt: {
    SgWhileStmt *whileStatement = isSgWhileStmt(currentScope);
    ROSE_ASSERT(whileStatement != NULL);
    ROSE_ASSERT(whileStatement->get_body() != NULL);
    currentStatementList =
        &(SageInterface::ensureBasicBlockAsBodyOfWhile(whileStatement)
              ->getStatementList());
    break;
  }

  case V_SgFortranDo: {
    SgFortranDo *doStatement = isSgFortranDo(currentScope);
    ROSE_ASSERT(doStatement != NULL);
    ROSE_ASSERT(doStatement->get_body() != NULL);
    currentStatementList = &(doStatement->get_body()->getStatementList());
    break;
  }

  case V_SgAssociateStatement: {
    SgAssociateStatement *associateStatement =
        isSgAssociateStatement(currentScope);
    ROSE_ASSERT(associateStatement != NULL);
    ROSE_ASSERT(associateStatement->get_body() != NULL);
    currentStatementList =
        &(associateStatement->get_body()->getStatementList());
    break;
  }

  case V_SgForAllStatement: {
    SgForAllStatement *forAllScope = isSgForAllStatement(currentScope);
    ROSE_ASSERT(forAllScope != NULL);
    ROSE_ASSERT(forAllScope->get_body() != NULL);
    currentStatementList = &(forAllScope->get_body()->getStatementList());
    break;
  }

  case V_SgRangeBasedForStatement: {
    SgRangeBasedForStatement *forScope =
        isSgRangeBasedForStatement(currentScope);
    ROSE_ASSERT(forScope != NULL);
    SgBasicBlock *body = isSgBasicBlock(forScope->get_loop_body());
    ROSE_ASSERT(body != NULL);
    currentStatementList = &(body->getStatementList());
    break;
  }

  default:
    printf("ERROR: default reached in switch (getStatementList()) currentScope "
           "= %s \n",
           currentScope->sage_class_name());
    printf("Note: this function is not defined for all IR nodes derived from "
           "SgScopeStatement (use SgScopeStatement::containsOnlyDeclarations() "
           "to check)\n");
    ROSE_ASSERT(false);
    break;
  }

  return *currentStatementList;
}

const SgStatementPtrList &SgScopeStatement::getStatementList() const {
  const SgScopeStatement *currentScope = this;
  ROSE_ASSERT(currentScope != NULL);

  static const SgStatementPtrList emptyStatementList;

  switch (currentScope->variantT()) {
  case V_SgBasicBlock: {
    const SgBasicBlock *basicBlock = isSgBasicBlock(currentScope);
    ROSE_ASSERT(basicBlock != NULL);
    return basicBlock->get_statements();
  }

  case V_SgCatchOptionStmt: {
    const SgCatchOptionStmt *catchOptionScope =
        isSgCatchOptionStmt(currentScope);
    ROSE_ASSERT(catchOptionScope != NULL);
    ROSE_ASSERT(catchOptionScope->get_body() != NULL);
    return isSgBasicBlock(catchOptionScope->get_body())
               ? isSgBasicBlock(catchOptionScope->get_body())
                     ->getStatementList()
               : emptyStatementList;
  }

  case V_SgTemplateClassDefinition:
  case V_SgClassDefinition:
  case V_SgTemplateInstantiationDefn:
  case V_SgGlobal:
  case V_SgNamespaceDefinitionStatement:
    printf("SgScopeStatement::getStatementList() const: %s requires "
           "getDeclarationList()\n",
           sage_class_name());
    ROSE_ABORT();

  case V_SgDoWhileStmt: {
    const SgDoWhileStmt *doWhileScope = isSgDoWhileStmt(currentScope);
    ROSE_ASSERT(doWhileScope != NULL);
    ROSE_ASSERT(doWhileScope->get_body() != NULL);
    return isSgBasicBlock(doWhileScope->get_body())
               ? isSgBasicBlock(doWhileScope->get_body())->getStatementList()
               : emptyStatementList;
  }

  case V_SgForStatement: {
    const SgForStatement *forScope = isSgForStatement(currentScope);
    ROSE_ASSERT(forScope != NULL);
    ROSE_ASSERT(forScope->get_loop_body() != NULL);
    return isSgBasicBlock(forScope->get_loop_body())
               ? isSgBasicBlock(forScope->get_loop_body())->getStatementList()
               : emptyStatementList;
  }

  case V_SgRangeBasedForStatement: {
    const SgRangeBasedForStatement *forScope =
        isSgRangeBasedForStatement(currentScope);
    ROSE_ASSERT(forScope != NULL);
    ROSE_ASSERT(forScope->get_loop_body() != NULL);
    return isSgBasicBlock(forScope->get_loop_body())
               ? isSgBasicBlock(forScope->get_loop_body())->getStatementList()
               : emptyStatementList;
  }

  case V_SgTemplateFunctionDefinition:
  case V_SgFunctionDefinition: {
    const SgFunctionDefinition *functionScope =
        isSgFunctionDefinition(currentScope);
    ROSE_ASSERT(functionScope != NULL);
    ROSE_ASSERT(functionScope->get_body() != NULL);
    return functionScope->get_body()->getStatementList();
  }

  case V_SgIfStmt: {
    const SgIfStmt *ifStatement = isSgIfStmt(currentScope);
    ROSE_ASSERT(ifStatement != NULL);

    printf("getStatementList() const return value not defined for SgIfStmt "
           "containing true and false bodies (use generateStatementList() "
           "const to form copy of merges lists) \n");
    ROSE_ASSERT(false);
    break;
  }

  case V_SgSwitchStatement: {
    const SgSwitchStatement *switchStatement =
        isSgSwitchStatement(currentScope);
    ROSE_ASSERT(switchStatement != NULL);
    ROSE_ASSERT(switchStatement->get_body() != NULL);
    return (isSgBasicBlock(switchStatement->get_body()) != NULL)
               ? isSgBasicBlock(switchStatement->get_body())->getStatementList()
               : emptyStatementList;
  }

  case V_SgWhileStmt: {
    const SgWhileStmt *whileStatement = isSgWhileStmt(currentScope);
    ROSE_ASSERT(whileStatement != NULL);
    ROSE_ASSERT(whileStatement->get_body() != NULL);
    return (isSgBasicBlock(whileStatement->get_body()) != NULL)
               ? isSgBasicBlock(whileStatement->get_body())->getStatementList()
               : emptyStatementList;
  }

  case V_SgAssociateStatement: {
    const SgAssociateStatement *associateStatement =
        isSgAssociateStatement(currentScope);
    ROSE_ASSERT(associateStatement != NULL);
    ROSE_ASSERT(associateStatement->get_body() != NULL);
    return associateStatement->get_body()->getStatementList();
  }

  case V_SgFortranDo: {
    const SgFortranDo *doStatement = isSgFortranDo(currentScope);
    ROSE_ASSERT(doStatement != NULL);
    ROSE_ASSERT(doStatement->get_body() != NULL);
    return doStatement->get_body()->getStatementList();
  }

  case V_SgForAllStatement: {
    const SgForAllStatement *forAllScope = isSgForAllStatement(currentScope);
    ROSE_ASSERT(forAllScope != NULL);
    ROSE_ASSERT(forAllScope->get_body() != NULL);
    return forAllScope->get_body()->getStatementList();
  }

  default:
    printf("ERROR: default reached in switch (getStatementList() const) "
           "currentScope = %s \n",
           currentScope->sage_class_name());
    printf("Note: this function is not defined for all IR nodes derived from "
           "SgScopeStatement (use SgScopeStatement::containsOnlyDeclarations() "
           "to check)\n");
    ROSE_ASSERT(false);
    break;
  }

  ROSE_ABORT();
}

const SgStatementPtrList SgScopeStatement::generateStatementList() const {
  // This function permits access to the statements or declarations as a list of
  // statements since declarations are derived from statements.  This function
  // generates a copy of the list in both cases (symmetrically for both types).

  SgStatementPtrList returnList;
  if (containsOnlyDeclarations() == true) {
    const SgDeclarationStatementPtrList &declarationList = getDeclarationList();
    SgDeclarationStatementPtrList::const_iterator i = declarationList.begin();
    for (i = declarationList.begin(); i != declarationList.end(); i++)
      returnList.push_back(*i);

    ROSE_ASSERT(returnList.size() == declarationList.size());

  } else {
    // Handle special case of two lists in a single statement (just append the
    // 2nd list to the 1st list)
    const SgIfStmt *ifStatement = isSgIfStmt(this);
    if (ifStatement != NULL) {
      if (isSgScopeStatement(ifStatement->get_true_body())) {
        returnList = isSgScopeStatement(ifStatement->get_true_body())
                         ->getStatementList();
      }
      if (isSgScopeStatement(ifStatement->get_false_body())) {
        const SgStatementPtrList &falseList =
            isSgScopeStatement(ifStatement->get_false_body())
                ->getStatementList();
        returnList.insert(returnList.end(), falseList.begin(), falseList.end());
      }
    } else {
      returnList = getStatementList();
    }
  }

  return returnList;
}

SgStatement *SgScopeStatement::firstStatement() const {
  SgStatement *first = NULL;

  if (containsOnlyDeclarations() == true) {
    const SgDeclarationStatementPtrList &declarationList = getDeclarationList();
    if (declarationList.empty() == false)
      first = *(declarationList.begin());
  } else {
    const SgStatementPtrList &statementList = getStatementList();

    if (statementList.empty() == false)
      first = *(statementList.begin());
  }

  return first;
}

SgStatement *SgScopeStatement::lastStatement() const {
  SgStatement *last = NULL;

  if (containsOnlyDeclarations() == true) {
    const SgDeclarationStatementPtrList &declarationList = getDeclarationList();
    if (declarationList.empty() == false)
      last = *(declarationList.rbegin());
  } else {
    const SgIfStmt *ifStatement = isSgIfStmt(this);
    if (ifStatement != NULL) {
      SgScopeStatement *ifScopeFalseBody =
          isSgScopeStatement(ifStatement->get_false_body());
      if (ifScopeFalseBody != NULL &&
          ifScopeFalseBody->getStatementList().empty() == false) {
        const SgStatementPtrList &statementList =
            ifScopeFalseBody->getStatementList();
        ROSE_ASSERT(statementList.empty() == false);
        last = *(statementList.rbegin());
      } else {
        SgStatement *falseStatement = ifStatement->get_false_body();
        if (falseStatement != NULL) {
          last = falseStatement;
        } else {
          // If there is no false body then we have to look at the bottom of the
          // true body. Both the true and false bodies can be either a
          // SgBasicBlock or any SgStatement.
          if (isSgScopeStatement(ifStatement->get_true_body()) != NULL) {
            const SgStatementPtrList &statementList =
                isSgScopeStatement(ifStatement->get_true_body())
                    ->getStatementList();
            if (statementList.empty() == false) {
              last = *(statementList.rbegin());
            } else {
              printf("ERROR: true branch statementList.empty() == true \n");
              ROSE_ASSERT(false);
            }
          } else {
            SgStatement *trueStatement = ifStatement->get_true_body();
            last = trueStatement;
          }

          ROSE_ASSERT(last != NULL);
        }

        ROSE_ASSERT(last != NULL);
      }

      ROSE_ASSERT(last != NULL);
    } else {
      const SgStatementPtrList &statementList = getStatementList();
      if (statementList.empty() == false)
        last = *(statementList.rbegin());
    }
  }

  return last;
}

bool SgScopeStatement::isCaseInsensitive() const {
  // Case sensitive scopes are for C/C++ and case insensitive scopes are for
  // Fortran. The case sensitive behavior is property of the symbol table only,
  // but it represented in the scope API to be consistatn with the symbol table
  // handling API being presented at the scope level (SgScopeStatment).

  ROSE_ASSERT(p_symbol_table != NULL);
  return p_symbol_table->isCaseInsensitive();
}

void SgScopeStatement::setCaseInsensitive(bool b) {
  ROSE_ASSERT(p_symbol_table != NULL);
  p_symbol_table->setCaseInsensitive(b);
}

bool SgScopeStatement::isNamedScope() {
  // DQ (5/11/2011): Added support for new name qualification.  If this is
  // associated with a scope that has a name then return true, else false. This
  // is used to support the name qualification.

  bool result = false;
  switch (this->variantT()) {
    // Though it might seem incorrect, since functions have names, the
    // SgFunctionDefinition is not a named scope for purposes of name
    // qualification.
  case V_SgFunctionDefinition:
  case V_SgGlobal: {
    result = false;
    break;
  }

  case V_SgBasicBlock: {
    // A SgBasicBlock is used inside of a few declarations to define a new
    // scope. This for this case, the enum can't nest other scopes. But field
    // values can be qualified, so this is a named scope when it is used in an
    // SgEnumDeclaration.
    SgEnumDeclaration *enumDeclaration =
        isSgEnumDeclaration(this->get_parent());
    if (enumDeclaration != NULL) {
      result = true;
    }
    break;
  }

  case V_SgTemplateClassDefinition:

  case V_SgClassDefinition:
  case V_SgTemplateInstantiationDefn:
  case V_SgNamespaceDefinitionStatement: {
    result = true;
    break;
  }

  case V_SgDeclarationScope: {
    result = isSgDeclarationStatement(this->get_parent()) != NULL;
    break;
  }

  default: {
  }
  }

  return result;
}

//! Some scopes have associated names for purposed of name qualification. This
//! generates the associated name.
SgName SgScopeStatement::associatedScopeName() {
  SgName name;
  if (isNamedScope() == true) {
    SgDeclarationStatement *declaration =
        isSgDeclarationStatement(this->get_parent());
    ROSE_ASSERT(declaration != NULL);
    switch (declaration->variantT()) {
    case V_SgTemplateClassDeclaration: {
      // DQ (6/11/2011): Since we don't handle the case of
      // SgTemplateDeclaration, I don't think we have to handle this case.
      printf("ERROR: I think this should be an error for now at least...\n");
      ROSE_ASSERT(false);
      break;
    }

    case V_SgClassDeclaration: {
      SgClassDeclaration *namedDeclaration = isSgClassDeclaration(declaration);
      name = namedDeclaration->get_name();
      break;
    }

      // The name stored in a SgTemplateInstantiationDecl is different from that
      // in the SgClassDeclaration base class, as I recall.
    case V_SgTemplateInstantiationDecl: {
      SgTemplateInstantiationDecl *namedDeclaration =
          isSgTemplateInstantiationDecl(declaration);
      name = namedDeclaration->get_name();
      break;
    }

    case V_SgNamespaceDeclarationStatement: {
      SgNamespaceDeclarationStatement *namedDeclaration =
          isSgNamespaceDeclarationStatement(declaration);
      if (namedDeclaration->get_isUnnamedNamespace() == false) {
        name = namedDeclaration->get_name();
      }
      break;
    }

    case V_SgEnumDeclaration: {
      SgEnumDeclaration *namedDeclaration = isSgEnumDeclaration(declaration);
      name = namedDeclaration->get_name();
      break;
    }
    default: {
      printf("Default reached in SgScopeStatement::associatedScopeName(): "
             "scope = %s \n",
             this->class_name().c_str());
      ROSE_ASSERT(false);
    }
    }
  }

  return name;
}

bool SgScopeStatement::isEquivalentScope(SgScopeStatement *scope1,
                                         SgScopeStatement *scope2) {
  // DQ (1/21/2013): Test for equivcalant scopes.  The only example I can think
  // of for equivalent scopes when the pointers are not equal is a
  // SgNamespaceDefinition.  Since namespaces can be reintrant, a declaration
  // can be in two more more scope that would have different pointers, yet still
  // be considered to be in the same namespace.  This test is used in the name
  // qualification generation.

  if (scope1 == NULL || scope2 == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[equivalent-scope-input]: scope1=%p scope2=%p "
            "cannot compare a missing semantic scope\n",
            static_cast<void *>(scope1), static_cast<void *>(scope2));
    ROSE_ABORT();
  }
  if (scope1 == scope2) {
    return true;
  }

  // DQ (1/21/2013): If these are both namespace scopes then do a more
  // sophisticated test for equivalent namespace. Note that over qualification
  // of generated code can be an error.
  SgNamespaceDefinitionStatement *scope1_NamespaceDefinition =
      isSgNamespaceDefinitionStatement(scope1);
  SgNamespaceDefinitionStatement *scope2_NamespaceDefinition =
      isSgNamespaceDefinitionStatement(scope2);
  bool isSameNamespace = false;
  if (scope1_NamespaceDefinition != NULL &&
      scope2_NamespaceDefinition != NULL) {
    SgNamespaceDeclarationStatement *scope1_NamespaceDeclaration =
        isSgNamespaceDeclarationStatement(
            scope1_NamespaceDefinition->get_namespaceDeclaration());
    SgNamespaceDeclarationStatement *scope2_NamespaceDeclaration =
        isSgNamespaceDeclarationStatement(
            scope2_NamespaceDefinition->get_namespaceDeclaration());

    ROSE_ASSERT(scope1_NamespaceDeclaration != NULL);
    ROSE_ASSERT(scope2_NamespaceDeclaration != NULL);

    // Test for equivalent namespaces.
    if (scope1_NamespaceDeclaration->get_firstNondefiningDeclaration() ==
        scope2_NamespaceDeclaration->get_firstNondefiningDeclaration()) {
      isSameNamespace = true;
    }
  }

  return isSameNamespace;
}

SOURCE_SCOPE_STATEMENT_END

SOURCE_FUNCTION_TYPE_TABLE_STATEMENT_START

SgFunctionTypeTable::SgFunctionTypeTable()
    : SgStatement(
          Sg_File_Info::generateDefaultFileInfoForCompilerGeneratedNode()) {
  ROSE_ASSERT(get_startOfConstruct() != nullptr);
  get_startOfConstruct()->set_parent(this);
  ROSE_ASSERT(get_endOfConstruct() == nullptr);
  set_endOfConstruct(
      Sg_File_Info::generateDefaultFileInfoForCompilerGeneratedNode());
  get_endOfConstruct()->set_parent(this);
}

void SgFunctionTypeTable::post_construction_initialization() {}

static int
compareFunctionTypeSignaturePrefix(const SgFunctionTypeTable::Signature &key,
                                   SgType *returnType, SgType *classType,
                                   unsigned int memberSpecifier,
                                   bool hasPrototype,
                                   const SgTypePtrList &arguments) {
  const std::less<SgType *> less;
  if (key.return_type != returnType)
    return less(key.return_type, returnType) ? -1 : 1;
  if (key.class_type != classType)
    return less(key.class_type, classType) ? -1 : 1;
  if (key.member_specifier != memberSpecifier)
    return key.member_specifier < memberSpecifier ? -1 : 1;
  if (key.has_prototype != hasPrototype)
    return key.has_prototype ? 1 : -1;
  if (key.arguments != arguments)
    return std::lexicographical_compare(key.arguments.begin(),
                                        key.arguments.end(), arguments.begin(),
                                        arguments.end(), less)
               ? -1
               : 1;
  return 0;
}

static int compareFunctionExceptionSignature(
    const SgFunctionTypeTable::Signature &key, unsigned int kind,
    const SgTypePtrList *types, const std::vector<bool> *pack_expansions,
    SgFunctionDeclaration *source, SgFunctionDeclaration *pattern) {
  if (key.exception_kind != kind)
    return key.exception_kind < kind ? -1 : 1;
  if (types == nullptr) {
    ROSE_ASSERT(kind == SgFunctionType::e_exception_none);
    ROSE_ASSERT(key.exception_types.empty());
  } else if (key.exception_types != *types)
    return std::lexicographical_compare(
               key.exception_types.begin(), key.exception_types.end(),
               types->begin(), types->end(), std::less<SgType *>())
               ? -1
               : 1;
  if (pack_expansions == nullptr) {
    ROSE_ASSERT(kind == SgFunctionType::e_exception_none);
    ROSE_ASSERT(key.exception_type_pack_expansions.empty());
  } else if (key.exception_type_pack_expansions != *pack_expansions)
    return key.exception_type_pack_expansions < *pack_expansions ? -1 : 1;
  const std::less<SgFunctionDeclaration *> less;
  if (key.exception_source != source)
    return less(key.exception_source, source) ? -1 : 1;
  if (key.exception_pattern != pattern)
    return less(key.exception_pattern, pattern) ? -1 : 1;
  return 0;
}

bool SgFunctionTypeTable::Signature::operator<(const Signature &other) const {
  const int prefix = compareFunctionTypeSignaturePrefix(
      *this, other.return_type, other.class_type, other.member_specifier,
      other.has_prototype, other.arguments);
  if (prefix != 0)
    return prefix < 0;
  if (argument_pack_expansions != other.argument_pack_expansions)
    return argument_pack_expansions < other.argument_pack_expansions;
  const int exceptions = compareFunctionExceptionSignature(
      *this, other.exception_kind, &other.exception_types,
      &other.exception_type_pack_expansions, other.exception_source,
      other.exception_pattern);
  if (exceptions != 0)
    return exceptions < 0;
  // Lookup compares operands structurally before indexing a representative.
  return std::less<SgExpression *>()(exception_expression,
                                     other.exception_expression);
}

static SgFunctionTypeTable::SignatureView
functionTypeSignature(SgType *returnType,
                      const SgFunctionParameterTypeList *arguments,
                      SgType *classType, unsigned int memberSpecifier,
                      bool hasPrototype) {
  ROSE_ASSERT(returnType != nullptr && arguments != nullptr);
  arguments->validate_argument_qualification_use_sites(
      "function-type-signature");
  return {returnType,
          classType,
          memberSpecifier,
          hasPrototype,
          arguments,
          SgFunctionType::e_exception_none,
          nullptr,
          nullptr,
          nullptr,
          nullptr,
          nullptr};
}

static SgFunctionTypeTable::SignatureView
functionTypeSignature(const SgFunctionType *type) {
  ROSE_ASSERT(type != nullptr);
  ROSE_ASSERT(type->get_semantic_signature() == nullptr);
  ROSE_ASSERT(!type->get_exception_specification_source_is_self());
  ROSE_ASSERT(!type->get_exception_specification_is_written());
  ROSE_ASSERT(type->get_argument_list() != nullptr);
  ROSE_ASSERT(type->get_argument_list()->get_parent() == type);
  const auto *member = isSgMemberFunctionType(type);
  // Qualified function prototypes are valid without a bound class. A plain
  // function uses SgFunctionType, so an unbound member representation must
  // carry cv/ref qualifiers and cannot collide with that plain signature.
  ROSE_ASSERT(member == nullptr || member->get_class_type() != nullptr ||
              member->get_mfunc_specifier() != 0);
  auto signature = functionTypeSignature(
      type->get_return_type(), type->get_argument_list(),
      member != nullptr ? member->get_class_type() : nullptr,
      member != nullptr ? member->get_mfunc_specifier() : 0,
      type->get_has_prototype());
  signature.exception_kind = type->get_exception_specification_kind();
  signature.exception_expression =
      type->get_exception_specification_expression();
  signature.exception_types = &type->get_exception_specification_types();
  signature.exception_type_pack_expansions =
      &type->get_exception_specification_type_pack_expansions();
  signature.exception_source = type->get_exception_specification_source();
  signature.exception_pattern = type->get_exception_specification_pattern();
  return signature;
}

static int
compareFunctionTypeSignature(const SgFunctionTypeTable::Signature &key,
                             const SgFunctionTypeTable::SignatureView &view) {
  const int prefix = compareFunctionTypeSignaturePrefix(
      key, view.return_type, view.class_type, view.member_specifier,
      view.has_prototype, view.parameters->get_arguments());
  if (prefix != 0)
    return prefix;
  const auto &positions =
      view.parameters->get_argument_qualification_use_sites();
  ROSE_ASSERT(key.argument_pack_expansions.size() == positions.size());
  for (size_t index = 0; index < positions.size(); ++index) {
    const bool pack = positions[index]->get_is_pack_expansion();
    if (key.argument_pack_expansions[index] != pack)
      return key.argument_pack_expansions[index] ? 1 : -1;
  }
  return compareFunctionExceptionSignature(
      key, view.exception_kind, view.exception_types,
      view.exception_type_pack_expansions, view.exception_source,
      view.exception_pattern);
}

bool SgFunctionTypeTable::SignatureLess::operator()(
    const Signature &left, const Signature &right) const {
  return left < right;
}

bool SgFunctionTypeTable::SignatureLess::operator()(
    const Signature &key, const SignatureView &view) const {
  return compareFunctionTypeSignature(key, view) < 0;
}

bool SgFunctionTypeTable::SignatureLess::operator()(
    const SignatureView &view, const Signature &key) const {
  return compareFunctionTypeSignature(key, view) > 0;
}

SgFunctionType *SgFunctionTypeTable::lookup_exact_function_type(
    SgType *returnType, SgFunctionParameterTypeList *arguments,
    SgType *classType, unsigned int memberSpecifier, bool hasPrototype) const {
  const SignatureView key =
      functionTypeSignature(returnType, arguments, classType, memberSpecifier,
                            hasPrototype);
  return findExactFunctionType(key);
}

SgFunctionType *SgFunctionTypeTable::lookup_exact_function_type(
    const SgFunctionType *type) const {
  return findExactFunctionType(functionTypeSignature(type));
}

SgFunctionType *
SgFunctionTypeTable::findExactFunctionType(const SignatureView &key) const {
  const auto range = p_types.equal_range(key);
  for (auto entry = range.first; entry != range.second; ++entry) {
    const SignatureView actual = functionTypeSignature(entry->second);
    ROSE_ASSERT(compareFunctionTypeSignature(entry->first, actual) == 0);
    ROSE_ASSERT(entry->first.exception_expression ==
                actual.exception_expression);
    if (SageInterface::constraintExpressionEquivalence(
            actual.exception_expression, key.exception_expression))
      return entry->second;
  }
  return nullptr;
}

void SgFunctionTypeTable::insert_function_type(SgFunctionType *type) {
  const SignatureView view = functionTypeSignature(type);
  if (type->p_function_type_table != nullptr) {
    ROSE_ASSERT(type->p_function_type_table == this);
    const auto entry = p_entries.find(type);
    ROSE_ASSERT(entry != p_entries.end());
    const auto indexed = p_types.find(*entry->second);
    ROSE_ASSERT(indexed != p_types.end() && indexed->second == type);
    ROSE_ASSERT(compareFunctionTypeSignature(indexed->first, view) == 0);
    ROSE_ASSERT(indexed->first.exception_expression ==
                view.exception_expression);
    return;
  }
  ROSE_ASSERT(findExactFunctionType(view) == nullptr);
  Signature key{view.return_type,
                view.class_type,
                view.member_specifier,
                view.has_prototype,
                view.parameters->get_arguments(),
                {},
                view.exception_kind,
                view.exception_expression,
                *view.exception_types,
                *view.exception_type_pack_expansions,
                view.exception_source,
                view.exception_pattern};
  for (const SgFunctionTypeArgument *argument :
       view.parameters->get_argument_qualification_use_sites())
    key.argument_pack_expansions.push_back(argument->get_is_pack_expansion());
  const auto inserted = p_types.emplace(std::move(key), type);
  ROSE_ASSERT(inserted.second);
  try {
    const auto entry = p_entries.emplace(type, &inserted.first->first);
    ROSE_ASSERT(entry.second);
  } catch (...) {
    p_types.erase(inserted.first);
    throw;
  }
  type->p_function_type_table = this;
}

void SgFunctionTypeTable::remove_function_type(SgFunctionType *type) {
  // Derived fields have already been destroyed when the base retires its entry.
  ROSE_ASSERT(type != nullptr && type->p_function_type_table == this);
  const auto entry = p_entries.find(type);
  ROSE_ASSERT(entry != p_entries.end());
  const auto indexed = p_types.find(*entry->second);
  ROSE_ASSERT(indexed != p_types.end() && indexed->second == type);
  p_types.erase(indexed);
  p_entries.erase(entry);
  type->p_function_type_table = nullptr;
}

void SgFunctionTypeTable::clear() {
  ROSE_ASSERT(p_entries.size() == p_types.size());
  for (const auto &entry : p_entries) {
    SgFunctionType *type = entry.first;
    ROSE_ASSERT(SgNode::isLiveNode(type));
    ROSE_ASSERT(type->p_function_type_table == this);
    const auto indexed = p_types.find(*entry.second);
    ROSE_ASSERT(indexed != p_types.end() && indexed->second == type);
    type->p_function_type_table = nullptr;
  }
  p_entries.clear();
  p_types.clear();
}
size_t SgFunctionTypeTable::size() const { return p_types.size(); }
const SgFunctionTypeTable::TypeIndex &SgFunctionTypeTable::get_types() const {
  return p_types;
}

std::ostream &operator<<(std::ostream &os,
                         const SgFunctionTypeTable::Signature &key) {
  os << "return=" << key.return_type << " class=" << key.class_type
     << " specifier=" << key.member_specifier
     << " prototype=" << key.has_prototype
     << " exception-kind=" << key.exception_kind
     << " exception-expression=" << key.exception_expression
     << " exception-source=" << key.exception_source
     << " exception-pattern=" << key.exception_pattern << " exceptions=[";
  for (SgType *type : key.exception_types)
    os << type << ' ';
  os << "] exception-packs=[";
  for (bool pack : key.exception_type_pack_expansions)
    os << pack << ' ';
  os << "] arguments=[";
  for (SgType *argument : key.arguments)
    os << argument << ' ';
  os << "] packs=[";
  for (bool pack : key.argument_pack_expansions)
    os << pack << ' ';
  return os << ']';
}

void SgFunctionTypeTable::print_functypetable(std::ostream &os) {
  os << "Function types (" << size() << ")\n";
  for (const auto &entry : p_types)
    os << entry.second << ' ' << entry.first << '\n';
}

SOURCE_FUNCTION_TYPE_TABLE_STATEMENT_END

SOURCE_GLOBAL_STATEMENT_START

SgName SgGlobal::get_qualified_name() const { return SgName("::"); }

SgName SgGlobal::get_mangled_name(void) const { return SgName("__global__"); }

void SgGlobal::post_construction_initialization() {}

void SgGlobal::append_declaration(SgDeclarationStatement *what) {
  get_declarations().push_back(what);
  what->set_parent(this);
  ROSE_ASSERT(what->get_parent() != NULL);
}

void SgGlobal::prepend_declaration(SgDeclarationStatement *what) {
  get_declarations().insert(get_declarations().begin(), what);
  what->set_parent(this);
  ROSE_ASSERT(what->get_parent() != NULL);
}

bool SgGlobal::insert_child(SgStatement *target, SgStatement *newstmt,
                            bool inFront, bool extractBasicBlock) {
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  inFront, extractBasicBlock, false);
}

bool SgGlobal::replace_child(SgStatement *target, SgStatement *newstmt,
                             bool extractBasicBlock) {
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  true, extractBasicBlock, true);
}

SOURCE_GLOBAL_STATEMENT_END


SOURCE_DECLARATION_STATEMENT_START

void SgDeclarationStatement::initialize_ast_json_external_provenance(
    ast_json_external_role_enum role, const std::string &source_file) {
  const bool valid_role =
      (role == e_ast_json_external_function && isSgFunctionDeclaration(this)) ||
      (role == e_ast_json_external_module && isSgModuleStatement(this)) ||
      (role == e_ast_json_external_class && isSgClassDeclaration(this));
  if (!valid_role || source_file.empty() ||
      source_file.find('\0') != std::string::npos ||
      p_ast_json_external_role != e_ast_json_local ||
      !p_ast_json_external_source_file.empty()) {
    fprintf(stderr, "REX_AST_INVARIANT[external-provenance]: invalid or repeated "
                    "external declaration initialization\n");
    ROSE_ABORT();
  }
  // Serialization provenance does not change the declaration's source syntax.
  p_ast_json_external_role = role;
  p_ast_json_external_source_file = source_file;
}

const std::optional<unsigned int> &
SgDeclarationStatement::get_translation_unit_source_order() const {
  return p_translation_unit_source_order;
}

void SgDeclarationStatement::initialize_translation_unit_source_order(
    unsigned int source_order) {
  if (source_order == 0) {
    fprintf(stderr,
            "REX_AST_INVARIANT[translation-unit-source-order]: "
            "declaration=%p type=%s requires a positive source order\n",
            static_cast<void *>(this), class_name().c_str());
    ROSE_ABORT();
  }
  if (p_translation_unit_source_order.has_value()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[translation-unit-source-order]: "
            "declaration=%p type=%s cannot initialize source_order=%u from "
            "current_order=%u\n",
            static_cast<void *>(this), class_name().c_str(), source_order,
            *p_translation_unit_source_order);
    ROSE_ABORT();
  }
  p_translation_unit_source_order = source_order;
}

void SgDeclarationStatement::
    clear_translation_unit_source_order_for_transformation() {
  p_translation_unit_source_order.reset();
  // The start-position sequence number is a compatibility mirror of the typed
  // declaration field, not an independent ordering channel.  Semantic copies
  // and transformations end their source-token ownership atomically; leaving
  // a copied occurrence in any owned file-info record makes downstream code
  // see contradictory lexical and semantic producers.
  std::set<Sg_File_Info *> positions = {get_file_info(), get_startOfConstruct(),
                                        get_endOfConstruct()};
  for (Sg_File_Info *position : positions) {
    if (position != NULL) {
      position->set_source_sequence_number(0);
    }
  }
}

void SgDeclarationStatement::post_construction_initialization() {}

bool SgDeclarationStatement::isForward() const { return get_forward(); }

void SgDeclarationStatement::setForward() { set_forward(true); }

void SgDeclarationStatement::unsetForward() { set_forward(false); }

bool SgDeclarationStatement::isNameOnly() const { return get_nameOnly(); }

void SgDeclarationStatement::setNameOnly() { set_nameOnly(true); }

void SgDeclarationStatement::unsetNameOnly() { set_nameOnly(false); }

bool SgDeclarationStatement::isExternBrace() const { return get_externBrace(); }

void SgDeclarationStatement::setExternBrace() { set_externBrace(true); }

void SgDeclarationStatement::unsetExternBrace() { set_externBrace(false); }

bool SgDeclarationStatement::skipElaborateType() const {
  return get_skipElaborateType();
}

void SgDeclarationStatement::setSkipElaborateType() {
  set_skipElaborateType(true);
}

void SgDeclarationStatement::unsetSkipElaborateType() {
  set_skipElaborateType(false);
}

bool SgDeclarationStatement::has_semantic_mangled_name() const {
  return isSgDeclarationGroupStatement(this) == nullptr;
}

SgName SgDeclarationStatement::get_mangled_name(void) const {
  fprintf(stderr,
          "REX_AST_INVARIANT[declaration-mangle]: %s has no typed mangling "
          "implementation\n",
          class_name().c_str());
  ROSE_ABORT();
}

SgSymbol *SgDeclarationStatement::get_symbol_from_symbol_table() const {
  // This is an optional query: declarations such as a multi-declarator
  // SgVariableDeclaration are represented by symbols for their individual
  // SgInitializedName children, not by a declaration-level symbol.
  SgScopeStatement *scope = get_scope();
  if (scope == NULL)
    return NULL;

  return scope->find_symbol_from_declaration(this);
}

SgSymbol *SgDeclarationStatement::search_for_symbol_from_symbol_table() const {
  SgDeclarationStatement *first = get_firstNondefiningDeclaration();
  if (first != NULL) {
    if (SgSymbol *symbol = first->get_symbol_from_symbol_table()) {
      return symbol;
    }
  }

  SgDeclarationStatement *defining = get_definingDeclaration();
  if (defining != NULL) {
    if (SgSymbol *symbol = defining->get_symbol_from_symbol_table()) {
      return symbol;
    }
  }

  return get_symbol_from_symbol_table();
}

SgDeclarationStatement *
SgDeclarationStatement::get_definingDeclaration() const {
  return p_definingDeclaration;
}

void SgDeclarationStatement::set_definingDeclaration(
    SgDeclarationStatement *definingDeclaration) {
  ROSE_ASSERT(definingDeclaration == NULL ||
              this->variantT() == definingDeclaration->variantT());
  p_definingDeclaration = definingDeclaration;
  markAsModified();
}

SgDeclarationStatement *
SgDeclarationStatement::get_firstNondefiningDeclaration() const {
  return p_firstNondefiningDeclaration;
}

void SgDeclarationStatement::set_firstNondefiningDeclaration(
    SgDeclarationStatement *firstNondefiningDeclaration) {
  ROSE_ASSERT(firstNondefiningDeclaration == NULL ||
              this->variantT() == firstNondefiningDeclaration->variantT());
  p_firstNondefiningDeclaration = firstNondefiningDeclaration;
  markAsModified();
}

SgType *SgDeclarationStatement::get_type() const {
  fprintf(stderr,
          "REX_AST_INVARIANT[declaration-base-get-type]: non-virtual base "
          "SgDeclarationStatement::get_type() called for %s\n",
          class_name().c_str());
  ROSE_ABORT();
}

SOURCE_DECLARATION_STATEMENT_END

SOURCE_TEMPLATE_SPECIALIZATION_SUPPORT_START

bool $CLASSNAME::isSpecialization() const {
  bool returnValue = false;
  returnValue = (p_specialization == SgDeclarationStatement::e_specialization);
  return returnValue;
}

bool $CLASSNAME::isPartialSpecialization() const {
  bool returnValue = false;
  returnValue =
      (p_specialization == SgDeclarationStatement::e_partial_specialization);
  return returnValue;
}

