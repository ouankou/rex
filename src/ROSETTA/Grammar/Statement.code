SOURCE_ATTRIBUTED_STATEMENT_START
void SgAttributedStatement::post_construction_initialization() {
  if (p_attribute_list == NULL || p_statement == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement]: statement=%p requires a "
            "structural attribute list and wrapped statement\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  if ((p_attribute_list->get_parent() != NULL &&
       p_attribute_list->get_parent() != this) ||
      (p_statement->get_parent() != NULL &&
       p_statement->get_parent() != this)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement-owner]: statement=%p "
            "received attribute-list owner=%p or wrapped-statement owner=%p\n",
            static_cast<void *>(this),
            static_cast<void *>(p_attribute_list->get_parent()),
            static_cast<void *>(p_statement->get_parent()));
    ROSE_ABORT();
  }
  p_attribute_list->set_parent(this);
  p_statement->set_parent(this);
}

SgStatementAttributeList *SgAttributedStatement::get_attribute_list() {
  if (p_attribute_list == NULL || p_attribute_list->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement-owner]: statement=%p has "
            "invalid attribute-list=%p owner=%p\n",
            static_cast<void *>(this), static_cast<void *>(p_attribute_list),
            static_cast<void *>(p_attribute_list != NULL
                                    ? p_attribute_list->get_parent()
                                    : NULL));
    ROSE_ABORT();
  }
  return p_attribute_list;
}

const SgStatementAttributeList *
SgAttributedStatement::get_attribute_list() const {
  if (p_attribute_list == NULL || p_attribute_list->get_parent() != this) {
    fprintf(
        stderr,
        "REX_AST_INVARIANT[attributed-statement-owner]: statement=%p has "
        "invalid attribute-list=%p owner=%p\n",
        static_cast<const void *>(this), static_cast<void *>(p_attribute_list),
        static_cast<void *>(
            p_attribute_list != NULL ? p_attribute_list->get_parent() : NULL));
    ROSE_ABORT();
  }
  return p_attribute_list;
}

void SgAttributedStatement::replace_attribute_list(
    SgStatementAttributeList *replacement) {
  if (p_attribute_list == NULL || p_attribute_list->get_parent() != this ||
      !p_attribute_list->get_attributes().empty() || replacement == NULL ||
      replacement == p_attribute_list || replacement->get_parent() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement-list-replacement]: "
            "statement=%p requires an owned empty current list and distinct "
            "unowned replacement=%p\n",
            static_cast<void *>(this), static_cast<void *>(replacement));
    ROSE_ABORT();
  }
  replacement->validate();
  SgStatementAttributeList *old_list = p_attribute_list;
  old_list->set_parent(NULL);
  p_attribute_list = replacement;
  replacement->set_parent(this);
  delete old_list;
}

const SgStatementAttributePtrList &
SgAttributedStatement::get_attributes() const {
  return get_attribute_list()->get_attributes();
}

void SgAttributedStatement::append_attribute(SgStatementAttribute *attribute) {
  get_attribute_list()->append_attribute(attribute);
}

SgStatement *SgAttributedStatement::get_statement() const {
  if (p_statement == NULL || p_statement->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement-owner]: statement=%p has "
            "invalid wrapped statement=%p owner=%p\n",
            static_cast<const void *>(this), static_cast<void *>(p_statement),
            static_cast<void *>(p_statement != NULL ? p_statement->get_parent()
                                                    : NULL));
    ROSE_ABORT();
  }
  return p_statement;
}

SgStatement *
SgAttributedStatement::replace_statement(SgStatement *replacement) {
  if (p_statement == NULL || p_statement->get_parent() != this ||
      replacement == NULL || replacement == p_statement ||
      replacement->get_parent() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement-replacement]: statement=%p "
            "cannot replace wrapped=%p with replacement=%p owner=%p\n",
            static_cast<void *>(this), static_cast<void *>(p_statement),
            static_cast<void *>(replacement),
            static_cast<void *>(replacement != NULL ? replacement->get_parent()
                                                    : NULL));
    ROSE_ABORT();
  }
  SgStatement *old_statement = p_statement;
  old_statement->set_parent(NULL);
  p_statement = replacement;
  replacement->set_parent(this);
  return old_statement;
}

void SgAttributedStatement::validate() const {
  const SgStatementAttributeList *attribute_list = get_attribute_list();
  attribute_list->validate();
  if (attribute_list->get_attributes().empty()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement]: statement=%p has no "
            "explicit attributes\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  (void)get_statement();
}
SOURCE_ATTRIBUTED_STATEMENT_END

