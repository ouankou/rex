HEADER_OMP_DECLARE_MAPPER_STATEMENT_START
//! Required for any declaration statement
virtual SgName get_mangled_name(void) const override;
virtual void fixupCopy_scopes(SgNode *copy, SgCopyHelp &help) const override;
virtual void fixupCopy_symbols(SgNode *copy, SgCopyHelp &help) const override;
virtual void fixupCopy_references(SgNode *copy,
                                  SgCopyHelp &help) const override;
HEADER_OMP_DECLARE_MAPPER_STATEMENT_END

SOURCE_OMP_DECLARE_MAPPER_STATEMENT_START
void SgOmpDeclareMapperStatement::post_construction_initialization() {}

SgName SgOmpDeclareMapperStatement::get_mangled_name(void) const {
  auto failIdentity = [](const char *reason) -> void {
    fprintf(stderr, "REX_AST_INVARIANT[declare-mapper-identity]: %s\n", reason);
    ROSE_ABORT();
  };

  // Hexadecimal byte encoding is injective for arbitrary exact spellings and
  // produces only mangled-name-safe characters.  The byte count makes each
  // component boundary explicit rather than relying on separator characters
  // that can also occur in a type or scope mangling.
  auto encodeIdentityComponent = [](const std::string &value) {
    static const char hex[] = "0123456789abcdef";
    std::string encoded =
        Rose::StringUtility::numberToString(value.size()) + "_";
    encoded.reserve(encoded.size() + value.size() * 2);
    for (unsigned char byte : value) {
      encoded += hex[(byte >> 4) & 0x0f];
      encoded += hex[byte & 0x0f];
    }
    return encoded;
  };

  SgScopeStatement *scope = get_scope();
  if (scope == NULL) {
    failIdentity("mapper has no lexical semantic scope");
  }
  const SgName scopeMangled = scope->get_mangled_name();
  if (scopeMangled.is_null() || scopeMangled.getString().empty()) {
    failIdentity("mapper lexical scope has no mangled identity");
  }

  std::string identifierComponent;
  switch (get_identifier()) {
  case SgOmpClause::e_omp_declare_mapper_identifier_default:
    if (get_user_defined_identifier() != NULL) {
      failIdentity("default mapper has a user identifier expression");
    }
    identifierComponent = "default";
    break;

  case SgOmpClause::e_omp_declare_mapper_identifier_user: {
    SgExpression *rawIdentifier = get_user_defined_identifier();
    if (rawIdentifier == NULL) {
      failIdentity("user mapper has no identifier expression");
    }
    SgOmpNameExpression *identifier = isSgOmpNameExpression(rawIdentifier);
    if (identifier == NULL) {
      failIdentity("user mapper identifier is not SgOmpNameExpression");
    }
    if (identifier->get_parent() != this) {
      failIdentity("user mapper identifier has wrong structural owner");
    }
    const std::string &spelling = identifier->get_spelling();
    if (spelling.empty()) {
      failIdentity("user mapper identifier spelling is empty");
    }
    identifierComponent =
        "user_" + encodeIdentityComponent(identifier->get_spelling());
    break;
  }

  case SgOmpClause::e_omp_declare_mapper_identifier_unspecified:
  default:
    failIdentity("mapper identifier kind is unspecified or invalid");
  }

  SgExpression *rawMapperType = get_mapper_type();
  if (rawMapperType == NULL) {
    failIdentity("mapper has no type expression");
  }
  SgTypeExpression *mapperTypeExpression = isSgTypeExpression(rawMapperType);
  if (mapperTypeExpression == NULL) {
    failIdentity("mapper type is not SgTypeExpression");
  }
  if (mapperTypeExpression->get_parent() != this) {
    failIdentity("mapper type expression has wrong structural owner");
  }
  SgType *mapperSemanticType = mapperTypeExpression->get_represented_type();
  if (mapperSemanticType == NULL ||
      isSgTypeUnknown(mapperSemanticType) != NULL) {
    failIdentity("mapper type expression has no exact semantic type");
  }
  const SgName typeMangled = mapperSemanticType->get_mangled();
  if (typeMangled.is_null() || typeMangled.getString().empty()) {
    failIdentity("mapper semantic type has no mangled identity");
  }

  SgDeclarationScope *mapperLocalScope = get_nonreal_decl_scope();
  if (mapperLocalScope == NULL || mapperLocalScope->get_parent() != this) {
    failIdentity("mapper has no exact directive-local declaration scope");
  }

  SgExpression *rawMapperVariable = get_mapper_variable();
  if (rawMapperVariable == NULL) {
    failIdentity("mapper has no variable expression");
  }
  SgVarRefExp *mapperVariable = isSgVarRefExp(rawMapperVariable);
  if (mapperVariable == NULL) {
    failIdentity("mapper variable is not SgVarRefExp");
  }
  if (mapperVariable->get_parent() != this) {
    failIdentity("mapper variable has wrong structural owner");
  }
  SgVariableSymbol *mapperVariableSymbol =
      isSgVariableSymbol(mapperVariable->get_symbol());
  SgInitializedName *mapperVariableDeclaration =
      mapperVariableSymbol != NULL ? mapperVariableSymbol->get_declaration()
                                   : NULL;
  if (mapperVariableSymbol == NULL || mapperVariableDeclaration == NULL) {
    failIdentity("mapper variable has no exact variable symbol");
  }
  SgVariableDeclaration *mapperVariableStatement =
      isSgVariableDeclaration(mapperVariableDeclaration->get_parent());
  SgAuxiliaryDeclarationList *mapperVariableOwner =
      mapperVariableStatement != NULL
          ? isSgAuxiliaryDeclarationList(mapperVariableStatement->get_parent())
          : NULL;
  SgType *mapperVariableType = mapperVariableDeclaration->get_type();
  if (mapperVariableStatement == NULL || mapperVariableOwner == NULL ||
      mapperVariableOwner != mapperLocalScope->get_auxiliary_declarations() ||
      mapperVariableOwner->get_parent() != mapperLocalScope ||
      std::count(mapperVariableOwner->get_declarations().begin(),
                 mapperVariableOwner->get_declarations().end(),
                 mapperVariableStatement) != 1 ||
      mapperLocalScope->statementExistsInScope(mapperVariableStatement) ||
      mapperVariableDeclaration->get_scope() != mapperLocalScope ||
      mapperLocalScope->find_symbol_from_declaration(
          mapperVariableDeclaration) != mapperVariableSymbol ||
      mapperVariableType == NULL ||
      isSgTypeUnknown(mapperVariableType) != NULL ||
      mapperVariable->get_type() != mapperVariableType) {
    failIdentity(
        "mapper variable is not exactly declared in its directive-local scope");
  }
  if (mapperVariableType != mapperSemanticType) {
    failIdentity(
        "mapper variable semantic type does not match mapper type expression");
  }

  const std::string identity = "__rex_omp_mapper_scope_" +
                               encodeIdentityComponent(scopeMangled.str()) +
                               "_identifier_" + identifierComponent + "_type_" +
                               encodeIdentityComponent(typeMangled.str());
  return SgName(identity);
}

SOURCE_OMP_DECLARE_MAPPER_STATEMENT_END

