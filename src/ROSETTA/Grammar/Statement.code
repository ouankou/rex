bool SgProgramHeaderStatement::replace_child(SgStatement *target,
                                             SgStatement *newstmt,
                                             bool extractBasicBlock) {
  if (StatementReplace(this, p_definition, target, newstmt))
    return true;
  else
    return (StatementReplace(this, p_parameterList, target, newstmt));
}

