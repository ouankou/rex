namespace {
template <class T>
SgSymbol *findSymbolFromDeclaration(const SgScopeStatement *scope,
                                    const T *node) {
  ROSE_ASSERT(scope != nullptr);
  ROSE_ASSERT(node != nullptr);
  SgSymbolTable *symbolTable = scope->get_symbol_table();
  ROSE_ASSERT(symbolTable != nullptr);

  SgSymbol *symbol = symbolTable->find(node);

  const SgNamespaceDefinitionStatement *namespaceDefinitionStatement =
      isSgNamespaceDefinitionStatement(scope);
  if (symbol == NULL && namespaceDefinitionStatement != NULL) {
    const SgNamespaceDefinitionStatement *globalNamespaceDefinitionStatement =
        namespaceDefinitionStatement->get_global_definition();
    ROSE_ASSERT(globalNamespaceDefinitionStatement != nullptr);
    if (SgSymbolTable *table =
            globalNamespaceDefinitionStatement->get_symbol_table()) {
      symbol = table->find(node);
    }
  }

  const SgGlobal *global_scope = isSgGlobal(scope);
  if (symbol == NULL && global_scope != NULL) {
    SgProject *project = SageInterface::getProject(global_scope);
    if (project != NULL) {
      SgGlobal *globalScopeAcrossFiles = project->get_globalScopeAcrossFiles();
      ROSE_ASSERT(globalScopeAcrossFiles != NULL);
      if (SgSymbolTable *table = globalScopeAcrossFiles->get_symbol_table()) {
        symbol = table->find(node);
      }
    }
  }

  if (auto *alias = isSgAliasSymbol(symbol))
    symbol = alias->get_base();

  return symbol;
}
} // namespace

SgSymbol *SgScopeStatement::find_symbol_from_declaration(
    const SgInitializedName *node) const {
  return findSymbolFromDeclaration(this, node);
}

SgSymbol *SgScopeStatement::find_symbol_from_declaration(
    const SgFunctionType *node) const {
  return findSymbolFromDeclaration(this, node);
}

SgSymbol *
SgScopeStatement::find_symbol_from_declaration(const SgStatement *node) const {
  return findSymbolFromDeclaration(this, node);
}

