void SgOmpAllocateStatement::post_construction_initialization() {
  if (p_variable_list == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-allocate-variable-list]: statement=%p "
            "has no structural variable-list wrapper\n",
            static_cast<void *>(this));
