HEADER_FUNCTION_TYPE_TABLE_START

// Canonical semantic identity does not depend on declaration spelling or on
// mangling an enclosing scope while the frontend is constructing it.
struct Signature {
  SgType *return_type;
  SgType *class_type;
  unsigned int member_specifier;
  bool has_prototype;
  SgTypePtrList arguments;
  std::vector<bool> argument_pack_expansions;
  unsigned int exception_kind;
  SgExpression *exception_expression;
  SgTypePtrList exception_types;
  std::vector<bool> exception_type_pack_expansions;
  SgFunctionDeclaration *exception_source;
  SgFunctionDeclaration *exception_pattern;
  bool operator<(const Signature &) const;
  friend std::ostream &operator<<(std::ostream &, const Signature &);
};
struct SignatureView {
  SgType *return_type;
  SgType *class_type;
  unsigned int member_specifier;
  bool has_prototype;
  const SgFunctionParameterTypeList *parameters;
  unsigned int exception_kind;
  SgExpression *exception_expression;
  const SgTypePtrList *exception_types;
  const std::vector<bool> *exception_type_pack_expansions;
  SgFunctionDeclaration *exception_source;
  SgFunctionDeclaration *exception_pattern;
};
struct SignatureLess {
  using is_transparent = void;
  bool operator()(const Signature &, const Signature &) const;
  bool operator()(const Signature &, const SignatureView &) const;
  bool operator()(const SignatureView &, const Signature &) const;
};
using TypeIndex = std::map<Signature, SgFunctionType *, SignatureLess>;
using EntryIndex = std::map<SgFunctionType *, const Signature *>;

SgFunctionTypeTable();
void insert_function_type(SgFunctionType *);
SgFunctionType *lookup_exact_function_type(SgType *,
                                           SgFunctionParameterTypeList *,
                                           SgType *, unsigned int,
                                           bool has_prototype = true) const;
SgFunctionType *lookup_exact_function_type(const SgFunctionType *) const;
void remove_function_type(SgFunctionType *);
void clear();
size_t size() const;
const TypeIndex &get_types() const;
void print_functypetable(std::ostream &os = std::cout);

private:
SgFunctionType *findExactFunctionType(const SignatureView &) const;

public:
HEADER_FUNCTION_TYPE_TABLE_END

