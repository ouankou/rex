bool $CLASSNAME::isSpecialization() const {
  bool returnValue = false;
  returnValue = (p_specialization == SgDeclarationStatement::e_specialization);
  return returnValue;
}

bool $CLASSNAME::isPartialSpecialization() const {
  bool returnValue = false;
  returnValue =
      (p_specialization == SgDeclarationStatement::e_partial_specialization);
  return returnValue;
}

SOURCE_TEMPLATE_SPECIALIZATION_SUPPORT_END

SOURCE_BASIC_BLOCK_STATEMENT_START

SgBasicBlock::SgBasicBlock(Sg_File_Info *info, SgStatement *stmt)
    : $BASECLASS(info) {
  /* now a call to the user defined initialization function */
  post_construction_initialization();
  if (stmt != NULL) {
    append_statement(stmt);

    // DQ (6/24/2006): This should be set by the lower level insert_statement
    // member function, verify this!
    ROSE_ASSERT(stmt->get_parent() != NULL);
  }
}

SgBasicBlock::SgBasicBlock(SgStatement *stmt) : $BASECLASS() {
  /* now a call to the user defined initialization function */
  post_construction_initialization();
  if (stmt != NULL) {
    append_statement(stmt);

    // DQ (6/24/2006): This should be set by the lower level insert_statement
    // member function, verify this!
    ROSE_ASSERT(stmt->get_parent() != NULL);
  }
}

// DQ (9/8/2004): Added to support qualified name generation
SgName SgBasicBlock::get_qualified_name() const {
  // DQ (8/28/2005): This is where we might name blocks if we select to do so at
  // some point as a way of building unique names for qualified named
  // declarations.

  // Note that this will still evaluate so that "returnName.is_null()" will be
  // true
  SgName returnName = "";
  return returnName;
}

// DQ (2/22/2007): Added to provide uniform support of mangle names for all
// scopes
SgName SgBasicBlock::get_mangled_name(void) const { return SgName(""); }

SgScopeStatement *
SgBasicBlock::get_statement_expression_construction_scope() const {
  return p_statement_expression_construction_scope;
}

void SgBasicBlock::begin_statement_expression_construction(
    SgScopeStatement *semanticScope) {
  if (semanticScope == NULL || semanticScope == this || get_parent() != NULL ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[statement-expression-construction-begin]: "
            "block=%p parent=%p requested-scope=%p active-scope=%p "
            "semantic-scope=%p does not form one fresh detached construction "
            "transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(semanticScope),
            static_cast<void *>(p_statement_expression_construction_scope),
            static_cast<void *>(get_statement_expression_semantic_scope()));
    ROSE_ABORT();
  }
  p_statement_expression_construction_scope = semanticScope;
}

void SgBasicBlock::consume_statement_expression_construction(
    SgStatementExpression *expressionOwner,
    SgScopeStatement *expectedSemanticScope) {
  if (expressionOwner == NULL || expectedSemanticScope == NULL ||
      p_statement_expression_construction_scope != expectedSemanticScope ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != NULL || get_parent() != expressionOwner ||
      expressionOwner->get_statement() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[statement-expression-construction-consume]: "
            "block=%p parent=%p expression-owner=%p expected-scope=%p "
            "active-scope=%p semantic-scope=%p does not form one exact typed "
            "owner transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(expressionOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(p_statement_expression_construction_scope),
            static_cast<void *>(get_statement_expression_semantic_scope()));
    ROSE_ABORT();
  }
  set_statement_expression_semantic_scope(expectedSemanticScope);
  p_statement_expression_construction_scope = NULL;
  if (get_statement_expression_semantic_scope() != expectedSemanticScope ||
      get_scope() != expectedSemanticScope) {
    fprintf(stderr,
            "REX_AST_INVARIANT[statement-expression-construction-publish]: "
            "block=%p expression-owner=%p expected-scope=%p published=%p "
            "resolved=%p\n",
            static_cast<void *>(this), static_cast<void *>(expressionOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(get_statement_expression_semantic_scope()),
            static_cast<void *>(get_scope()));
    ROSE_ABORT();
  }
}

SgScopeStatement *SgBasicBlock::get_implied_do_construction_scope() const {
  return p_implied_do_construction_scope;
}

void SgBasicBlock::begin_implied_do_construction(
    SgImpliedDo *expressionOwner, SgScopeStatement *semanticScope) {
  if (expressionOwner == NULL || semanticScope == NULL ||
      semanticScope == this || get_parent() != NULL ||
      expressionOwner->get_parent() != NULL ||
      expressionOwner->get_implied_do_scope() != this ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[implied-do-construction-begin]: block=%p "
            "parent=%p expression-owner=%p expression-parent=%p "
            "requested-scope=%p statement-expression-construction-scope=%p "
            "statement-expression-semantic-scope=%p active-scope=%p does not "
            "form one fresh typed construction transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(expressionOwner),
            expressionOwner != NULL
                ? static_cast<void *>(expressionOwner->get_parent())
                : NULL,
            static_cast<void *>(semanticScope),
            static_cast<void *>(p_statement_expression_construction_scope),
            static_cast<void *>(get_statement_expression_semantic_scope()),
            static_cast<void *>(p_implied_do_construction_scope));
    ROSE_ABORT();
  }
  p_implied_do_construction_scope = semanticScope;
}

void SgBasicBlock::consume_implied_do_construction(
    SgImpliedDo *expressionOwner, SgScopeStatement *expectedSemanticScope) {
  if (expressionOwner == NULL || expectedSemanticScope == NULL ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != expectedSemanticScope ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != NULL || get_parent() != expressionOwner ||
      expressionOwner->get_parent() != NULL ||
      expressionOwner->get_implied_do_scope() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[implied-do-construction-consume]: block=%p "
            "parent=%p expression-owner=%p expression-parent=%p "
            "expected-scope=%p statement-expression-construction-scope=%p "
            "statement-expression-semantic-scope=%p active-scope=%p does not "
            "form one exact typed owner transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(expressionOwner),
            expressionOwner != NULL
                ? static_cast<void *>(expressionOwner->get_parent())
                : NULL,
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(p_statement_expression_construction_scope),
            static_cast<void *>(get_statement_expression_semantic_scope()),
            static_cast<void *>(p_implied_do_construction_scope));
    ROSE_ABORT();
  }
  set_implied_do_semantic_scope(expectedSemanticScope);
  p_implied_do_construction_scope = NULL;
  if (get_implied_do_semantic_scope() != expectedSemanticScope ||
      get_scope() != expectedSemanticScope) {
    fprintf(stderr,
            "REX_AST_INVARIANT[implied-do-construction-publish]: block=%p "
            "expression-owner=%p expected-scope=%p published=%p resolved=%p\n",
            static_cast<void *>(this), static_cast<void *>(expressionOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(get_implied_do_semantic_scope()),
            static_cast<void *>(get_scope()));
    ROSE_ABORT();
  }
}

SgScopeStatement *SgBasicBlock::get_function_body_construction_scope() const {
  return p_function_body_construction_scope;
}

void SgBasicBlock::begin_function_body_construction(
    SgScopeStatement *semanticScope) {
  if (semanticScope == NULL || semanticScope == this || get_parent() != NULL ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-body-construction-begin]: block=%p "
            "parent=%p requested-scope=%p statement-expression-construction="
            "%p statement-expression-semantic=%p implied-do-construction=%p "
            "implied-do-semantic=%p function-body-construction=%p "
            "forall-construction=%p does not form one fresh detached "
            "function-body transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(semanticScope),
            static_cast<void *>(p_statement_expression_construction_scope),
            static_cast<void *>(get_statement_expression_semantic_scope()),
            static_cast<void *>(p_implied_do_construction_scope),
            static_cast<void *>(get_implied_do_semantic_scope()),
            static_cast<void *>(p_function_body_construction_scope),
            static_cast<void *>(p_forall_construction_scope));
    ROSE_ABORT();
  }
  p_function_body_construction_scope = semanticScope;
  if (get_scope() != semanticScope) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-body-construction-publish]: block=%p "
            "requested-scope=%p resolved=%p\n",
            static_cast<void *>(this), static_cast<void *>(semanticScope),
            static_cast<void *>(get_scope()));
    ROSE_ABORT();
  }
}

void SgBasicBlock::consume_function_body_construction(
    SgFunctionDefinition *functionOwner,
    SgScopeStatement *expectedSemanticScope) {
  if (functionOwner == NULL || expectedSemanticScope == NULL ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != expectedSemanticScope ||
      p_forall_construction_scope != NULL || get_parent() != functionOwner ||
      functionOwner->get_body() != this ||
      functionOwner->get_scope() != expectedSemanticScope) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-body-construction-consume]: block=%p "
            "parent=%p function-owner=%p expected-scope=%p active-scope=%p "
            "does not form one exact typed function-body owner transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(functionOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(p_function_body_construction_scope));
    ROSE_ABORT();
  }
  p_function_body_construction_scope = NULL;
  if (get_scope() != functionOwner) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-body-construction-complete]: block=%p "
            "function-owner=%p expected-outer-scope=%p resolved=%p\n",
            static_cast<void *>(this), static_cast<void *>(functionOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(get_scope()));
    ROSE_ABORT();
  }
}

SgScopeStatement *SgBasicBlock::get_forall_construction_scope() const {
  return p_forall_construction_scope;
}

void SgBasicBlock::begin_forall_construction(SgScopeStatement *semanticScope) {
  if (semanticScope == NULL || semanticScope == this || get_parent() != NULL ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[forall-construction-begin]: block=%p "
            "parent=%p requested-scope=%p statement-expression-construction="
            "%p statement-expression-semantic=%p implied-do-construction=%p "
            "implied-do-semantic=%p active-scope=%p does not form one fresh "
            "typed FORALL construction transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(semanticScope),
            static_cast<void *>(p_statement_expression_construction_scope),
            static_cast<void *>(get_statement_expression_semantic_scope()),
            static_cast<void *>(p_implied_do_construction_scope),
            static_cast<void *>(get_implied_do_semantic_scope()),
            static_cast<void *>(p_forall_construction_scope));
    ROSE_ABORT();
  }
  p_forall_construction_scope = semanticScope;
}

void SgBasicBlock::consume_forall_construction(
    SgForAllStatement *statementOwner,
    SgScopeStatement *expectedSemanticScope) {
  if (statementOwner == NULL || expectedSemanticScope == NULL ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != expectedSemanticScope ||
      get_parent() != statementOwner || statementOwner->get_body() != this ||
      statementOwner->get_scope() != expectedSemanticScope) {
    fprintf(stderr,
            "REX_AST_INVARIANT[forall-construction-consume]: block=%p "
            "parent=%p statement-owner=%p expected-scope=%p active-scope=%p "
            "does not form one exact typed FORALL owner transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(statementOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(p_forall_construction_scope));
    ROSE_ABORT();
  }
  p_forall_construction_scope = NULL;
  if (get_scope() != statementOwner) {
    fprintf(stderr,
            "REX_AST_INVARIANT[forall-construction-publish]: block=%p "
            "statement-owner=%p expected-outer-scope=%p resolved=%p\n",
            static_cast<void *>(this), static_cast<void *>(statementOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(get_scope()));
    ROSE_ABORT();
  }
}

SgScopeStatement *SgBasicBlock::get_scope(void) const {
  SgScopeStatement *statement_expression_construction_scope =
      get_statement_expression_construction_scope();
  SgScopeStatement *statement_expression_semantic_scope =
      get_statement_expression_semantic_scope();
  SgScopeStatement *implied_do_scope = get_implied_do_construction_scope();
  SgScopeStatement *implied_do_semantic_scope = get_implied_do_semantic_scope();
  SgScopeStatement *function_body_construction_scope =
      get_function_body_construction_scope();
  SgScopeStatement *forall_construction_scope = get_forall_construction_scope();
  const unsigned int special_scope_count =
      (statement_expression_construction_scope != NULL ? 1U : 0U) +
      (statement_expression_semantic_scope != NULL ? 1U : 0U) +
      (implied_do_scope != NULL ? 1U : 0U) +
      (implied_do_semantic_scope != NULL ? 1U : 0U) +
      (function_body_construction_scope != NULL ? 1U : 0U) +
      (forall_construction_scope != NULL ? 1U : 0U);
  if (special_scope_count > 1) {
    fprintf(stderr,
            "REX_AST_INVARIANT[basic-block-construction-scope]: block=%p "
            "has simultaneous statement-expression-construction-scope=%p, "
            "statement-expression-semantic-scope=%p, and implied-do-scope=%p "
            "implied-do-semantic-scope=%p, function-body-construction-scope=%p,"
            " and forall-construction-scope=%p roles\n",
            static_cast<const void *>(this),
            static_cast<void *>(statement_expression_construction_scope),
            static_cast<void *>(statement_expression_semantic_scope),
            static_cast<void *>(implied_do_scope),
            static_cast<void *>(implied_do_semantic_scope),
            static_cast<void *>(function_body_construction_scope),
            static_cast<void *>(forall_construction_scope));
    ROSE_ABORT();
  }
  if (statement_expression_construction_scope != NULL) {
    if (get_parent() != NULL ||
        statement_expression_construction_scope == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[statement-expression-construction-scope]: "
              "block=%p has construction-scope=%p while parent=%p\n",
              static_cast<const void *>(this),
              static_cast<void *>(statement_expression_construction_scope),
              static_cast<void *>(get_parent()));
      ROSE_ABORT();
    }
    return statement_expression_construction_scope;
  }
  if (statement_expression_semantic_scope != NULL) {
    SgStatementExpression *expressionOwner =
        isSgStatementExpression(get_parent());
    if (expressionOwner == NULL || expressionOwner->get_statement() != this ||
        statement_expression_semantic_scope == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[statement-expression-semantic-scope]: "
              "block=%p parent=%p semantic-scope=%p does not form one exact "
              "typed statement-expression owner\n",
              static_cast<const void *>(this),
              static_cast<void *>(get_parent()),
              static_cast<void *>(statement_expression_semantic_scope));
      ROSE_ABORT();
    }
    return statement_expression_semantic_scope;
  }
  if (implied_do_scope != NULL) {
    SgImpliedDo *expressionOwner = isSgImpliedDo(get_parent());
    if (expressionOwner == NULL || expressionOwner->get_parent() != NULL ||
        expressionOwner->get_implied_do_scope() != this ||
        implied_do_scope == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[implied-do-construction-scope]: block=%p "
              "parent=%p construction-scope=%p does not form one detached "
              "typed implied-DO owner transaction\n",
              static_cast<const void *>(this),
              static_cast<void *>(get_parent()),
              static_cast<void *>(implied_do_scope));
      ROSE_ABORT();
    }
    return implied_do_scope;
  }
  if (implied_do_semantic_scope != NULL) {
    SgImpliedDo *expressionOwner = isSgImpliedDo(get_parent());
    if (expressionOwner == NULL ||
        expressionOwner->get_implied_do_scope() != this ||
        implied_do_semantic_scope == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[implied-do-semantic-scope]: block=%p "
              "parent=%p semantic-scope=%p does not form one exact typed "
              "implied-DO owner\n",
              static_cast<const void *>(this),
              static_cast<void *>(get_parent()),
              static_cast<void *>(implied_do_semantic_scope));
      ROSE_ABORT();
    }
    return implied_do_semantic_scope;
  }
  if (function_body_construction_scope != NULL) {
    if (get_parent() != NULL || function_body_construction_scope == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[function-body-construction-scope]: block=%p "
              "parent=%p construction-scope=%p does not form one detached "
              "typed function-body transaction\n",
              static_cast<const void *>(this),
              static_cast<void *>(get_parent()),
              static_cast<void *>(function_body_construction_scope));
      ROSE_ABORT();
    }
    return function_body_construction_scope;
  }
  if (forall_construction_scope != NULL) {
    if (get_parent() != NULL || forall_construction_scope == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[forall-construction-scope]: block=%p "
              "parent=%p construction-scope=%p does not form one detached "
              "typed FORALL construction transaction\n",
              static_cast<const void *>(this),
              static_cast<void *>(get_parent()),
              static_cast<void *>(forall_construction_scope));
      ROSE_ABORT();
    }
    return forall_construction_scope;
  }

  return SgStatement::get_scope();
}

void SgBasicBlock::post_construction_initialization() {
  p_is_implicit_control_flow_scope = false;
  p_statement_expression_construction_scope = NULL;
  set_statement_expression_semantic_scope(NULL);
  p_implied_do_construction_scope = NULL;
  set_implied_do_semantic_scope(NULL);
  p_function_body_construction_scope = NULL;
  p_forall_construction_scope = NULL;
  p_is_fortran_block_construct = false;
  p_fortran_block_construct_name.clear();
  p_fortran_block_end_numeric_label = NULL;
}

void SgBasicBlock::set_end_numeric_label(SgLabelRefExp *endNumericLabel) {
  if (!p_is_fortran_block_construct ||
      (p_fortran_block_end_numeric_label != NULL &&
       p_fortran_block_end_numeric_label != endNumericLabel)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[fortran-block-end-label]: block=%p role=%d "
            "old-label=%p new-label=%p cannot accept END BLOCK label\n",
            static_cast<void *>(this), p_is_fortran_block_construct ? 1 : 0,
            static_cast<void *>(p_fortran_block_end_numeric_label),
            static_cast<void *>(endNumericLabel));
    ROSE_ABORT();
  }
  p_fortran_block_end_numeric_label = endNumericLabel;
  markAsModified();
}

bool SgBasicBlock::has_end_numeric_label() const {
  return p_is_fortran_block_construct;
}

void SgBasicBlock::append_statement(SgStatement *what) {
  //   printf ("In $CLASSNAME::append_statement(): Call to insert_statement()
  //   commented out \n"); ROSE_ASSERT(false);

  if (SgAuxiliaryDeclarationList *container = isSgAuxiliaryDeclarationList(
          what != NULL ? what->get_parent() : NULL)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[basic-block-append-auxiliary-owner]: "
            "statement=%p type=%s remains owned by auxiliary container=%p "
            "owner=%p; detach it through the typed ownership transaction "
            "before lexical adoption\n",
            static_cast<void *>(what),
            what != NULL ? what->class_name().c_str() : "<null>",
            static_cast<void *>(container),
            static_cast<void *>(container->get_parent()));
    ROSE_ABORT();
  }

  get_statements().push_back(what);
  what->set_parent(this);

  // DQ (6/24/2006): This should be set by the lower level insert_statement
  // member function, verify this!
  ROSE_ASSERT(what->get_parent() != NULL);
}

void SgBasicBlock::prepend_statement(SgStatement *what) {
  get_statements().insert(get_statements().begin(), what);
  what->set_parent(this);

  // DQ (6/24/2006): This should be set by the lower level insert_statement
  // member function, verify this!
  ROSE_ASSERT(what->get_parent() != NULL);
}

bool SgBasicBlock::replace_child(SgStatement *target, SgStatement *newstmt,
                                 bool extractBasicBlock) {
  return StatementListInsertChild(this, p_statements, target, newstmt, true,
                                  extractBasicBlock, true);
}
//! insert newstmt before or after target. If extractBasicBlock is true AND
//! newstmt is a basic
// block, insert statements from newstmt instead of inserting newstmt.
// target should be a child statement within this SgBasicBlock.
bool SgBasicBlock::insert_child(SgStatement *target, SgStatement *newstmt,
                                bool inFront, bool extractBasicBlock) {
  return StatementListInsertChild(this, p_statements, target, newstmt, inFront,
                                  extractBasicBlock, false);
}

SOURCE_BASIC_BLOCK_STATEMENT_END

SOURCE_IF_STATEMENT_START
void SgIfStmt::post_construction_initialization() {
  // DQ (12/17/2006): This function should have the semantics that it will
  // represent a structural change to the AST, thus it is free to set the parent
  // of the new expression.

  // printf ("Note: modified SgIfStmt::post_construction_initialization() to set
  // parents of conditional, true_body, and false_body \n");

  // #ifndef REMOVE_SET_PARENT_FUNCTION
  if (get_conditional() != NULL)
    get_conditional()->set_parent(this);
  if (get_true_body() != NULL)
    get_true_body()->set_parent(this);
  if (get_false_body() != NULL)
    get_false_body()->set_parent(this);
  // #endif
}

bool SgIfStmt::replace_child(SgStatement *target, SgStatement *newstmt,
                             bool extractBasicBlock) {
  if (StatementReplace(this, p_conditional, target, newstmt) == true) {
    return true;
  } else {
    if (StatementReplace(this, p_true_body, target, newstmt) == true) {
      return true;
    } else {
      if (StatementReplace(this, p_false_body, target, newstmt) == true) {
        return true;
      } else {
        return false;
      }
    }
  }
}

// CLANG FRONTEND FIX: Implement insert_child for SgIfStmt
bool SgIfStmt::insert_child(SgStatement *target, SgStatement *newstmt,
                            bool inFront, bool extractBasicBlock) {
  // SgIfStmt has a true body and optionally a false body
  // Try inserting into true body first
  SgBasicBlock *true_body = isSgBasicBlock(p_true_body);
  if (true_body != NULL) {
    // Check if target is in true_body by attempting insertion
    if (StatementListInsertChild(true_body, true_body->get_statements(), target,
                                 newstmt, inFront, extractBasicBlock, false)) {
      return true;
    }
  }

  // Try inserting into false body if it exists
  SgBasicBlock *false_body = isSgBasicBlock(p_false_body);
  if (false_body != NULL) {
    if (StatementListInsertChild(false_body, false_body->get_statements(),
                                 target, newstmt, inFront, extractBasicBlock,
                                 false)) {
      return true;
    }
  }

  // Target not found in either body
  return false;
}

// DQ (2/22/2007): Added to provide uniform support of mangle names for all
// scopes
SgName SgIfStmt::get_mangled_name(void) const { return SgName(""); }

SOURCE_IF_STATEMENT_END

SOURCE_FOR_INIT_STATEMENT_START

void SgForInitStatement::post_construction_initialization() {}

void SgForInitStatement::append_init_stmt(SgStatement *what) {
  if (what == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[for-init-append]: cannot append a null "
                    "initializer statement\n");
    ROSE_ABORT();
  }
  if (get_init_stmt().size() == 1 &&
      isSgNullStatement(get_init_stmt().front()) != NULL &&
      isSgNullStatement(what) == NULL) {
    get_init_stmt().front()->set_parent(NULL);
    get_init_stmt().clear();
  }
  get_init_stmt().push_back(what);
  what->set_parent(this);
}

void SgForInitStatement::prepend_init_stmt(SgStatement *what) {
  if (what == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[for-init-prepend]: cannot prepend a null "
            "initializer statement\n");
    ROSE_ABORT();
  }
  if (get_init_stmt().size() == 1 &&
      isSgNullStatement(get_init_stmt().front()) != NULL &&
      isSgNullStatement(what) == NULL) {
    get_init_stmt().front()->set_parent(NULL);
    get_init_stmt().clear();
  }
  get_init_stmt().insert(get_init_stmt().begin(), what);
  what->set_parent(this);
}

bool SgForInitStatement::replace_child(SgStatement *target,
                                       SgStatement *newstmt,
                                       bool extractBasicBlock) {
  if (newstmt == NULL && p_init_stmt.size() == 1 &&
      p_init_stmt.front() == target) {
    // Removing the sole initializer changes the loop to the source form
    // `for (; ...; ...)`. Keep that syntactic absence as a typed child at the
    // mutation boundary instead of leaving a malformed empty owner list for a
    // later unparser repair.
    newstmt = new SgNullStatement(TRANS_FILE);
  }
  return StatementListInsertChild(this, p_init_stmt, target, newstmt, true,
                                  extractBasicBlock, true);
}

bool SgForInitStatement::insert_child(SgStatement *target, SgStatement *newstmt,
                                      bool inFront, bool extractBasicBlock) {
  return StatementListInsertChild(this, p_init_stmt, target, newstmt, inFront,
                                  extractBasicBlock, false);
}

SOURCE_FOR_INIT_STATEMENT_END

SOURCE_FOR_STATEMENT_START

$CLASSNAME::$CLASSNAME(SgForInitStatement *init_stmt, SgStatement *test,
                       SgExpression *increment, SgStatement *loop_body)
    : $BASECLASS(), p_for_init_stmt(init_stmt), p_test(test),
      p_increment(increment), p_loop_body(loop_body) {
  post_construction_initialization();
}

void SgForStatement::post_construction_initialization() {
  // DQ (6/24/2006): Refactored this code to build the SgForInitStatement
  // for all SgForStatement as part of constructor.
  if (p_for_init_stmt == NULL) {
    // SgForInitStatement* forInitStatement = new
    // SgForInitStatement(New_File_Info(this));
    SgForInitStatement *forInitStatement = NULL;
    if (get_startOfConstruct() != NULL) {
      forInitStatement = new SgForInitStatement(New_File_Info(this));

      // DQ (10/27/2006): This will have to be updated after construction,
      // since we don't know the ending position at this point!
      forInitStatement->set_endOfConstruct(New_File_Info(this));

      // DQ (12/17/2006): Fixup the parents of Sg_File_Info objects
      forInitStatement->get_startOfConstruct()->set_parent(forInitStatement);
      forInitStatement->get_endOfConstruct()->set_parent(forInitStatement);
    } else {
      Sg_File_Info *start_fi =
          Sg_File_Info::generateDefaultFileInfoForCompilerGeneratedNode();
      Sg_File_Info *end_fi =
          Sg_File_Info::generateDefaultFileInfoForCompilerGeneratedNode();
      start_fi->setCompilerGenerated();
      end_fi->setCompilerGenerated();
      forInitStatement = new SgForInitStatement(start_fi);
      forInitStatement->set_endOfConstruct(end_fi);
      start_fi->set_parent(forInitStatement);
      end_fi->set_parent(forInitStatement);
    }

    ROSE_ASSERT(forInitStatement != NULL);

    // All SgForStatement IR nodes should have a valid SgForInitStatement (even
    // if it is an empty list!).
    set_for_init_stmt(forInitStatement);
  }

  p_for_init_stmt->set_parent(this);

  // DQ (12/17/2006): If these are available, then set their parents as well
  // (ok, since this is a structural issue).
  if (p_test != NULL) {
    p_test->set_parent(this);
  }

  // DQ (12/17/2006): If these are available, then set their parents as well
  // (ok, since this is a structural issue).
  if (p_increment != NULL) {
    p_increment->set_parent(this);
  }

  // DQ (12/17/2006): If these are available, then set their parents as well
  // (ok, since this is a structural issue).
  if (p_loop_body != NULL) {
    p_loop_body->set_parent(this);
  }
}

// MS: moved StatementPtrList to ForInitStatement. Therefore the call is simply
// forwarded and the same interface
SgStatementPtrList &SgForStatement::get_init_stmt() {
  // DQ (6/24/2006): If this is always true then we can simplify this function.
  ROSE_ASSERT(p_for_init_stmt != NULL);
  return get_for_init_stmt()->get_init_stmt();
}

const SgStatementPtrList &SgForStatement::get_init_stmt() const {
  // DQ (6/24/2006): When we later simplify the append, prepend, insert
  // functions this will be important.
  ROSE_ASSERT(p_for_init_stmt != NULL);

  return get_for_init_stmt()->get_init_stmt();
}

void SgForStatement::append_init_stmt(SgStatement *what) {
  // DQ (6/24/2006): If this is always true then we can simplify this function.
  ROSE_ASSERT(p_for_init_stmt != NULL);
  get_for_init_stmt()->append_init_stmt(what);
}

void SgForStatement::prepend_init_stmt(SgStatement *what) {
  // DQ (6/24/2006): If this is always true then we can simplify this function.
  ROSE_ASSERT(p_for_init_stmt != NULL);
  get_for_init_stmt()->prepend_init_stmt(what);
}

bool SgForStatement::replace_child(SgStatement *target, SgStatement *newstmt,
                                   bool extractBasicBlock) {
  if (StatementReplace(this, p_loop_body, target, newstmt) == true)
    return true;
  else if (StatementReplace(this, p_for_init_stmt, target, newstmt) == true)
    return true;
  else if (StatementReplace(this, p_test, target, newstmt) == true)
    return true;
  else
    return false;
}

// CLANG FRONTEND FIX: Implement insert_child for SgForStatement
bool SgForStatement::insert_child(SgStatement *target, SgStatement *newstmt,
                                  bool inFront, bool extractBasicBlock) {
  // SgForStatement has a loop body where statements can be inserted
  SgBasicBlock *loop_body = isSgBasicBlock(p_loop_body);
  if (loop_body != NULL) {
    // Try inserting into loop body
    if (StatementListInsertChild(loop_body, loop_body->get_statements(), target,
                                 newstmt, inFront, extractBasicBlock, false)) {
      return true;
    }
  }

  // Target not found in loop body
  return false;
}

// DQ (11/25/2005): preserve the previous interface so that
// the most common case of where a test is an expression can
// be handled as before.  We can deprecate this function later.
// Currently the test has been modified to allow it to be a SgStatement
// and in the case of an expression, it is just a SgExprStatement.
// This is required for C and C++ which allows declarations to be
// placed where the test is evaluated in a for loop (note that this
// is part of uniform changes to the IR to fixup such details).
SgExpression *SgForStatement::get_test_expr() const {
  ROSE_ASSERT(this != NULL);
  ROSE_ASSERT(p_test != NULL);
  ROSE_ASSERT(isSgStatement(p_test) != NULL);

  SgExpression *testExpression = NULL;
  SgExprStatement *exprStatement = isSgExprStatement(p_test);
  if (exprStatement != NULL) {
    // testExpression = exprStatement->get_the_expr();
    testExpression = exprStatement->get_expression();
    ROSE_ASSERT(testExpression != NULL);
  } else {
    printf("test in SgForStatement is a %s \n", p_test->class_name().c_str());
    ROSE_ASSERT(false);
  }

  ROSE_ASSERT(testExpression != NULL);
  return testExpression;
}

void SgForStatement::set_test_expr(SgExpression *expr) {
  // DQ (11/25/2005): preserve the previous interface. This function
  // sets the SgStatement using a SgExpressionRoot IR node.
  ROSE_ASSERT(this != NULL);
  ROSE_ASSERT(expr != NULL);

  Sg_File_Info *fileInfo = New_File_Info(expr);
  SgExprStatement *expressionStatement = new SgExprStatement(fileInfo, expr);
  ROSE_ASSERT(expressionStatement != NULL);

  // DQ (10/27/2006): This might have to be reset later,
  // since at this point we might not know the exact size.
  expressionStatement->set_endOfConstruct(New_File_Info(expr));

  expressionStatement->get_startOfConstruct()->set_parent(expressionStatement);
  expressionStatement->get_endOfConstruct()->set_parent(expressionStatement);

  if (get_test() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[for-test-replacement]: for-statement=%p "
            "already has test=%p; use the replacement API\n",
            static_cast<void *>(this), static_cast<void *>(get_test()));
    ROSE_ABORT();
  }
  set_test(expressionStatement);

  // DQ (4/7/2006): Set the parents
  expressionStatement->set_parent(this);

  ROSE_ASSERT(isSgStatement(p_test) != NULL);
}

// DQ (12/6/2006): We need this sort of function now that we have removed the
// expression root node! The requirement of not being able to do operations
// uniformly on expressions may be the disadvantage of not having used the
// SgExpressionRoot IR node as a concept.
int SgForStatement::replace_expression(SgExpression *original_expression,
                                       SgExpression *new_expression) {
  // DQ (12/17/2006): This function should have the semantics that it will
  // represent a structural change to the AST, thus it is free to set the parent
  // of the new expression.

  ROSE_ASSERT(original_expression != NULL);
  ROSE_ASSERT(new_expression != NULL);

  ROSE_ASSERT(original_expression == p_increment);

  set_increment(new_expression);

  new_expression->set_parent(this);

  // DQ: Let this be a memory leak for now to avoid initial problems.
  ROSE_ASSERT(original_expression != NULL);
  // delete original_expression;

  return 0;
}

// DQ (2/22/2007): Added to provide uniform support of mangle names for all
// scopes
SgName SgForStatement::get_mangled_name(void) const { return SgName(""); }

SOURCE_FOR_STATEMENT_END

