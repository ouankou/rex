HEADER_OMP_TASK_STATEMENT_START
void initialize_semantic_data_environment(
    const SgInitializedNamePtrList &firstprivate,
    const SgInitializedNamePtrList &private_variables);
void validate_semantic_data_environment() const;
bool has_semantic_data_environment() const;
HEADER_OMP_TASK_STATEMENT_END

SOURCE_OMP_TASK_STATEMENT_START
void SgOmpTaskStatement::post_construction_initialization() {}

bool SgOmpTaskStatement::has_semantic_data_environment() const {
  return p_semantic_data_environment_is_available;
}

void SgOmpTaskStatement::initialize_semantic_data_environment(
    const SgInitializedNamePtrList &firstprivate,
    const SgInitializedNamePtrList &private_variables) {
  ROSE_ASSERT(!p_semantic_data_environment_is_available &&
              p_semantic_firstprivate_variables.empty() &&
              p_semantic_private_variables.empty());
  p_semantic_firstprivate_variables = firstprivate;
  p_semantic_private_variables = private_variables;
  p_semantic_data_environment_is_available = true;
  validate_semantic_data_environment();
}

void SgOmpTaskStatement::validate_semantic_data_environment() const {
  ROSE_ASSERT(p_semantic_data_environment_is_available);
  std::set<const SgInitializedName *> variables;
  for (const auto *list : {&p_semantic_firstprivate_variables,
                           &p_semantic_private_variables}) {
    for (const SgInitializedName *variable : *list) {
      ROSE_ASSERT(variable != nullptr && SgNode::isLiveNode(variable));
      ROSE_ASSERT(variables.insert(variable).second);
      ROSE_ASSERT(variable->get_type() != nullptr &&
                  !SageInterface::containsUnknownType(variable->get_type()));
    }
  }
}
SOURCE_OMP_TASK_STATEMENT_END

