SOURCE_EMPTY_DECLARATION_START
void SgEmptyDeclaration::post_construction_initialization() {
  validate_lexical_role();
}

SgEmptyDeclaration::empty_declaration_role_enum
SgEmptyDeclaration::get_lexical_role() const {
  return p_lexical_role;
}

void SgEmptyDeclaration::validate_lexical_role() const {
  switch (get_lexical_role()) {
  case e_empty_declaration_source_semicolon:
  case e_empty_declaration_preprocessing_anchor:
  case e_empty_declaration_zero_width_source_replacement:
    return;
  }

  fprintf(
      stderr,
      "REX_AST_INVARIANT[empty-declaration-role]: invalid lexical role=%d\n",
      static_cast<int>(get_lexical_role()));
  ROSE_ABORT();
}

SgName SgEmptyDeclaration::get_mangled_name(void) const {
  SgName returnName;

  returnName = "empty_declaration";

  return returnName;
}

bool SgEmptyDeclaration::hasExplicitScope() const {
  return false;
}

SOURCE_EMPTY_DECLARATION_END

SOURCE_ACCESS_LABEL_STATEMENT_START

void SgAccessLabelStatement::post_construction_initialization() {
  // SgAccessModifier initializes ordinary declarations to e_default.  An
  // access-label statement carries that source meaning exclusively in its
  // typed label_kind field, so its inherited declaration modifier must start
  // in the canonical absent state before the node first becomes observable.
  SgAccessModifier &legacy_access =
      get_declarationModifier().get_accessModifier();
  legacy_access.setUnknown();
  legacy_access.set_is_explicit(false);
  validate();
}

void SgAccessLabelStatement::validate() const {
  const bool valid_label = get_label_kind() == e_access_label_private ||
                           get_label_kind() == e_access_label_protected ||
                           get_label_kind() == e_access_label_public;
  const SgAccessModifier &legacy_access =
      get_declarationModifier().get_accessModifier();
  if (!valid_label || !legacy_access.isUnknown() ||
      legacy_access.get_is_explicit() || get_definingDeclaration() != NULL ||
      get_firstNondefiningDeclaration() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[access-label-shape]: label=%p kind=%d "
            "legacy-access=%d explicit=%d defining=%p first=%p\n",
            static_cast<const void *>(this), static_cast<int>(get_label_kind()),
            static_cast<int>(legacy_access.get_modifier()),
            legacy_access.get_is_explicit() ? 1 : 0,
            static_cast<void *>(get_definingDeclaration()),
            static_cast<void *>(get_firstNondefiningDeclaration()));
    ROSE_ABORT();
  }
}

SgName SgAccessLabelStatement::get_mangled_name() const {
  validate();
  return "access_label";
}

bool SgAccessLabelStatement::hasExplicitScope() const { return false; }

SOURCE_ACCESS_LABEL_STATEMENT_END

SOURCE_DECLARATION_GROUP_STATEMENT_START

void SgDeclarationGroupStatement::post_construction_initialization() {
  for (SgDeclarationStatement *declaration : p_declarations) {
    if (declaration == NULL || (declaration->get_parent() != NULL &&
                                declaration->get_parent() != this)) {
      fprintf(stderr,
              "REX_AST_INVARIANT[declaration-group-owner]: group=%p "
              "contains null or multiply-owned declaration=%p\n",
              static_cast<void *>(this), static_cast<void *>(declaration));
      ROSE_ABORT();
    }
    declaration->set_parent(this);
  }
}

const SgDeclarationStatementPtrList &
SgDeclarationGroupStatement::get_declarations() const {
  return p_declarations;
}

void SgDeclarationGroupStatement::append_declaration(
    SgDeclarationStatement *declaration) {
  SgScopeStatement *group_scope = get_scope();
  SgVariableDeclaration *variable = isSgVariableDeclaration(declaration);
  const bool exact_variable_contract =
      variable == NULL ||
      (variable->get_variables().size() == 1 &&
       variable->get_variables().front() != NULL &&
       variable->get_variables().front()->get_parent() == variable &&
       variable->get_variables().front()->get_scope() != NULL);
  if (declaration == NULL || declaration == this ||
      isSgDeclarationGroupStatement(declaration) != NULL ||
      declaration->get_parent() != NULL || group_scope == NULL ||
      !exact_variable_contract ||
      std::find(p_declarations.begin(), p_declarations.end(), declaration) !=
          p_declarations.end()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[declaration-group-owner]: group=%p "
            "cannot append declaration=%p type=%s parent=%p\n",
            static_cast<void *>(this), static_cast<void *>(declaration),
            declaration != NULL ? declaration->class_name().c_str() : "<null>",
            declaration != NULL ? static_cast<void *>(declaration->get_parent())
                                : NULL);
    ROSE_ABORT();
  }

  p_declarations.push_back(declaration);
  declaration->set_parent(this);
}

SgDeclarationStatementPtrList
SgDeclarationGroupStatement::release_declarations_after_surface_removal() {
  validate();
  if (get_parent() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[declaration-group-atomic-replacement]: "
            "group=%p remains attached to parent=%p while releasing its "
            "members\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()));
    ROSE_ABORT();
  }

  SgDeclarationStatementPtrList declarations = p_declarations;
  p_declarations.clear();
  for (SgDeclarationStatement *declaration : declarations) {
    if (declaration == NULL || declaration->get_parent() != this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[declaration-group-atomic-replacement]: "
              "group=%p cannot release malformed member=%p parent=%p\n",
              static_cast<void *>(this), static_cast<void *>(declaration),
              declaration != NULL
                  ? static_cast<void *>(declaration->get_parent())
                  : NULL);
      ROSE_ABORT();
    }
    declaration->set_parent(NULL);
  }
  set_scope(NULL);
  return declarations;
}

bool SgDeclarationGroupStatement::replace_child(
    SgStatement *target, SgStatement *replacement,
    bool extractListFromBasicBlock) {
  (void)target;
  (void)replacement;
  (void)extractListFromBasicBlock;
  fprintf(stderr,
          "REX_AST_INVARIANT[declaration-group-mutation]: replace_child "
          "cannot preserve an exact-source declaration group\n");
  ROSE_ABORT();
}

bool SgDeclarationGroupStatement::insert_child(SgStatement *target,
                                               SgStatement *inserted,
                                               bool inFront,
                                               bool extractListFromBasicBlock) {
  (void)target;
  (void)inserted;
  (void)inFront;
  (void)extractListFromBasicBlock;
  fprintf(stderr, "REX_AST_INVARIANT[declaration-group-mutation]: insert_child "
                  "cannot preserve an exact-source declaration group\n");
  ROSE_ABORT();
}

void SgDeclarationGroupStatement::validate() const {
  SgScopeStatement *structural_scope = NULL;
  std::set<const SgNode *> ancestors;
  for (SgNode *ancestor = get_parent();
       ancestor != NULL && structural_scope == NULL;
       ancestor = ancestor->get_parent()) {
    if (!ancestors.insert(ancestor).second) {
      fprintf(stderr,
              "REX_AST_INVARIANT[declaration-group-shape]: group=%p has a "
              "cycle in its structural owner chain at node=%p/%s\n",
              static_cast<const void *>(this), static_cast<void *>(ancestor),
              ancestor->class_name().c_str());
      ROSE_ABORT();
    }
    structural_scope = isSgScopeStatement(ancestor);
  }
  auto has_inactive_declarator_tail = [](SgLocatedNode *owner) {
    if (owner == NULL) {
      return false;
    }
    AttachedPreprocessingInfoType *records =
        owner->getAttachedPreprocessingInfo();
    if (records == NULL) {
      return false;
    }
    for (PreprocessingInfo *record : *records) {
      if (record != NULL && record->getAttachedOwner() == owner &&
          record->getRelativePosition() == PreprocessingInfo::after &&
          record->getTypeOfDirective() == PreprocessingInfo::CSkippedToken) {
        return true;
      }
    }
    return false;
  };
  bool singleton_has_inactive_declarator_tail = false;
  if (p_declarations.size() == 1 && p_declarations.front() != NULL) {
    SgDeclarationStatement *member = p_declarations.front();
    SgLocatedNode *boundary = member;
    if (SgVariableDeclaration *variable = isSgVariableDeclaration(member)) {
      if (variable->get_variables().size() == 1 &&
          variable->get_variables().front() != NULL) {
        boundary = variable->get_variables().front();
      }
    }
    singleton_has_inactive_declarator_tail =
        has_inactive_declarator_tail(boundary);
  }
  if (p_declarations.empty() ||
      (p_declarations.size() == 1 && !singleton_has_inactive_declarator_tail) ||
      get_scope() == NULL ||
      (get_parent() != NULL && structural_scope != get_scope()) ||
      (get_source_terminator() != e_source_terminator_file_semicolon &&
       get_source_terminator() != e_source_terminator_macro_semicolon) ||
      get_definingDeclaration() != NULL ||
      get_firstNondefiningDeclaration() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[declaration-group-shape]: group=%p "
            "members=%zu parent=%p scope=%p structural-scope=%p "
            "terminator=%d defining=%p first=%p\n",
            static_cast<const void *>(this), p_declarations.size(),
            static_cast<void *>(get_parent()), static_cast<void *>(get_scope()),
            static_cast<void *>(structural_scope),
            static_cast<int>(get_source_terminator()),
            static_cast<void *>(get_definingDeclaration()),
            static_cast<void *>(get_firstNondefiningDeclaration()));
    ROSE_ABORT();
  }

  std::set<const SgDeclarationStatement *> seen;
  for (size_t index = 0; index < p_declarations.size(); ++index) {
    SgDeclarationStatement *declaration = p_declarations[index];
    SgVariableDeclaration *variable = isSgVariableDeclaration(declaration);
    SgFunctionDeclaration *function = isSgFunctionDeclaration(declaration);
    SgTypedefDeclaration *typedef_declaration =
        isSgTypedefDeclaration(declaration);

    const bool supported =
        variable != NULL || function != NULL || typedef_declaration != NULL;
    const bool valid_variable =
        variable == NULL ||
        (variable->get_variables().size() == 1 &&
         variable->get_variables().front() != NULL &&
         variable->get_variables().front()->get_parent() == variable &&
         variable->get_variables().front()->get_scope() != NULL);
    const bool valid_function =
        function == NULL ||
        (function->get_definition() == NULL && function->isForward());
    if (declaration == NULL || declaration->get_parent() != this ||
        !seen.insert(declaration).second || !supported || !valid_variable ||
        !valid_function || declaration->get_scope() == NULL) {
      fprintf(
          stderr,
          "REX_AST_INVARIANT[declaration-group-member]: "
          "group=%p index=%zu declaration=%p type=%s parent=%p "
          "scope=%p supported=%d\n",
          static_cast<const void *>(this), index,
          static_cast<void *>(declaration),
          declaration != NULL ? declaration->class_name().c_str() : "<null>",
          declaration != NULL ? static_cast<void *>(declaration->get_parent())
                              : NULL,
          declaration != NULL ? static_cast<void *>(declaration->get_scope())
                              : NULL,
          supported ? 1 : 0);
      ROSE_ABORT();
    }
  }
}

bool SgDeclarationGroupStatement::hasExplicitScope() const { return true; }

SOURCE_DECLARATION_GROUP_STATEMENT_END

SOURCE_POST_CONSTRUCTION_INITIALIZATION_STATEMENT_START
void $CLASSNAME::post_construction_initialization() {}

SOURCE_POST_CONSTRUCTION_INITIALIZATION_STATEMENT_END

SOURCE_NAMESPACE_DECLARATION_STATEMENT_START

void SgNamespaceDeclarationStatement::post_construction_initialization() {
  if (p_definition == nullptr)
    return;
  if (p_definition->get_parent() != nullptr ||
      p_definition->get_namespaceDeclaration() != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[namespace-declaration-construction]: "
            "declaration=%p definition=%p already has an owner\n",
            static_cast<void *>(this), static_cast<void *>(p_definition));
    ROSE_ABORT();
  }
  p_definition->set_parent(this);
  p_definition->set_namespaceDeclaration(this);
}

bool SgNamespaceDeclarationStatement::isSameNamespace(
    const SgNamespaceDeclarationStatement *n) const {
  // DQ (6/5/2007): Since namespaces are re-entrant we define a simple function
  // to test if two namespaces are the same (not the same
  // SgNamespaceDeclarationStatement, but the same namespace).
  ROSE_ASSERT(get_firstNondefiningDeclaration() != NULL);
  ROSE_ASSERT(n != NULL);
  ROSE_ASSERT(n->get_firstNondefiningDeclaration() != NULL);

  return (get_firstNondefiningDeclaration() ==
          n->get_firstNondefiningDeclaration());
}

void SgNamespaceDeclarationStatement::attach_source_fragments(
    SgNamespaceSourceFragment *opening_introducer,
    SgNamespaceSourceFragment *opening, SgNamespaceSourceFragment *closing) {
  if (opening == NULL || closing == NULL ||
      p_opening_introducer_source_fragment != NULL ||
      p_opening_source_fragment != NULL || p_closing_source_fragment != NULL ||
      opening->get_parent() != NULL || closing->get_parent() != NULL ||
      opening == closing ||
      (opening_introducer != NULL &&
       (opening_introducer->get_parent() != NULL ||
        opening_introducer == opening || opening_introducer == closing ||
        opening_introducer->get_kind() !=
            SgNamespaceSourceFragment::
                e_namespace_source_fragment_opening_introducer)) ||
      opening->get_kind() !=
          SgNamespaceSourceFragment::e_namespace_source_fragment_opening ||
      closing->get_kind() !=
          SgNamespaceSourceFragment::e_namespace_source_fragment_closing) {
    fprintf(
        stderr,
        "REX_AST_INVARIANT[namespace-source-fragment-owner]: declaration=%p "
        "cannot adopt introducer=%p(owner=%p) opening=%p(owner=%p) "
        "closing=%p(owner=%p)\n",
        static_cast<void *>(this), static_cast<void *>(opening_introducer),
        static_cast<void *>(opening_introducer != NULL
                                ? opening_introducer->get_parent()
                                : NULL),
        static_cast<void *>(opening),
        static_cast<void *>(opening != NULL ? opening->get_parent() : NULL),
        static_cast<void *>(closing),
        static_cast<void *>(closing != NULL ? closing->get_parent() : NULL));
    ROSE_ABORT();
  }

  if (opening_introducer != NULL) {
    opening_introducer->validate();
  }
  opening->validate();
  closing->validate();
  p_opening_introducer_source_fragment = opening_introducer;
  p_opening_source_fragment = opening;
  p_closing_source_fragment = closing;
  if (opening_introducer != NULL) {
    opening_introducer->set_parent(this);
  }
  opening->set_parent(this);
  closing->set_parent(this);
  validate_source_fragments();
}

bool SgNamespaceDeclarationStatement::has_source_fragments() const {
  validate_source_fragments();
  return p_opening_source_fragment != NULL;
}

SgNamespaceSourceFragment *
SgNamespaceDeclarationStatement::get_opening_introducer_source_fragment() {
  validate_source_fragments();
  return p_opening_introducer_source_fragment;
}

const SgNamespaceSourceFragment *
SgNamespaceDeclarationStatement::get_opening_introducer_source_fragment()
    const {
  validate_source_fragments();
  return p_opening_introducer_source_fragment;
}

SgNamespaceSourceFragment *
SgNamespaceDeclarationStatement::get_first_opening_source_fragment() {
  validate_source_fragments();
  return p_opening_introducer_source_fragment != NULL
             ? p_opening_introducer_source_fragment
             : p_opening_source_fragment;
}

const SgNamespaceSourceFragment *
SgNamespaceDeclarationStatement::get_first_opening_source_fragment() const {
  validate_source_fragments();
  return p_opening_introducer_source_fragment != NULL
             ? p_opening_introducer_source_fragment
             : p_opening_source_fragment;
}

SgNamespaceSourceFragment *
SgNamespaceDeclarationStatement::get_opening_source_fragment() {
  validate_source_fragments();
  return p_opening_source_fragment;
}

const SgNamespaceSourceFragment *
SgNamespaceDeclarationStatement::get_opening_source_fragment() const {
  validate_source_fragments();
  return p_opening_source_fragment;
}

SgNamespaceSourceFragment *
SgNamespaceDeclarationStatement::get_closing_source_fragment() {
  validate_source_fragments();
  return p_closing_source_fragment;
}

const SgNamespaceSourceFragment *
SgNamespaceDeclarationStatement::get_closing_source_fragment() const {
  validate_source_fragments();
  return p_closing_source_fragment;
}

void SgNamespaceDeclarationStatement::validate_source_fragments() const {
  const bool has_opening = p_opening_source_fragment != NULL;
  const bool has_closing = p_closing_source_fragment != NULL;
  if (has_opening != has_closing) {
    fprintf(stderr,
            "REX_AST_INVARIANT[namespace-source-fragment-pair]: declaration=%p "
            "opening=%p closing=%p must form one complete typed pair\n",
            static_cast<const void *>(this),
            static_cast<void *>(p_opening_source_fragment),
            static_cast<void *>(p_closing_source_fragment));
    ROSE_ABORT();
  }
  if (!has_opening) {
    if (p_opening_introducer_source_fragment != NULL) {
      fprintf(stderr,
              "REX_AST_INVARIANT[namespace-source-fragment-pair]: "
              "declaration=%p has an introducer without an opening/closing "
              "pair\n",
              static_cast<const void *>(this));
      ROSE_ABORT();
    }
    if (get_translation_unit_source_order().has_value()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[namespace-source-order]: declaration=%p "
              "has source_order=%u without a source-fragment pair\n",
              static_cast<const void *>(this),
              *get_translation_unit_source_order());
      ROSE_ABORT();
    }
    return;
  }

  if ((p_opening_introducer_source_fragment != NULL &&
       (p_opening_introducer_source_fragment->get_parent() != this ||
        p_opening_introducer_source_fragment->get_kind() !=
            SgNamespaceSourceFragment::
                e_namespace_source_fragment_opening_introducer ||
        p_opening_introducer_source_fragment == p_opening_source_fragment ||
        p_opening_introducer_source_fragment == p_closing_source_fragment)) ||
      p_opening_source_fragment == p_closing_source_fragment ||
      p_opening_source_fragment->get_parent() != this ||
      p_closing_source_fragment->get_parent() != this ||
      p_opening_source_fragment->get_kind() !=
          SgNamespaceSourceFragment::e_namespace_source_fragment_opening ||
      p_closing_source_fragment->get_kind() !=
          SgNamespaceSourceFragment::e_namespace_source_fragment_closing) {
    fprintf(
        stderr,
        "REX_AST_INVARIANT[namespace-source-fragment-owner]: "
        "declaration=%p has malformed introducer=%p(owner=%p kind=%d) "
        "opening=%p(owner=%p kind=%d) "
        "closing=%p(owner=%p kind=%d)\n",
        static_cast<const void *>(this),
        static_cast<void *>(p_opening_introducer_source_fragment),
        static_cast<void *>(
            p_opening_introducer_source_fragment != NULL
                ? p_opening_introducer_source_fragment->get_parent()
                : NULL),
        static_cast<int>(p_opening_introducer_source_fragment != NULL
                             ? p_opening_introducer_source_fragment->get_kind()
                             : SgNamespaceSourceFragment::
                                   e_namespace_source_fragment_unknown),
        static_cast<void *>(p_opening_source_fragment),
        static_cast<void *>(p_opening_source_fragment->get_parent()),
        static_cast<int>(p_opening_source_fragment->get_kind()),
        static_cast<void *>(p_closing_source_fragment),
        static_cast<void *>(p_closing_source_fragment->get_parent()),
        static_cast<int>(p_closing_source_fragment->get_kind()));
    ROSE_ABORT();
  }

  if (p_opening_introducer_source_fragment != NULL) {
    p_opening_introducer_source_fragment->validate();
    if (get_isUnnamedNamespace() &&
        p_opening_introducer_source_fragment->get_contains_namespace_name()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[namespace-source-fragment-kind]: "
              "anonymous namespace declaration=%p cannot own a named "
              "introducer fragment\n",
              static_cast<const void *>(this));
      ROSE_ABORT();
    }
  }
  p_opening_source_fragment->validate();
  p_closing_source_fragment->validate();
  const SgNamespaceSourceFragment::namespace_source_fragment_form_enum
      source_form = p_opening_source_fragment->get_source_form();
  if (p_opening_introducer_source_fragment != NULL &&
      (source_form != SgNamespaceSourceFragment::
                          e_namespace_source_fragment_source_spelled ||
       p_opening_introducer_source_fragment->get_source_form() !=
           source_form)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[namespace-source-fragment-pair]: "
            "declaration=%p split introducer has inconsistent typed source "
            "form\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  if ((source_form == SgNamespaceSourceFragment::
                          e_namespace_source_fragment_source_spelled &&
       !get_translation_unit_source_order().has_value()) ||
      (source_form == SgNamespaceSourceFragment::
                          e_namespace_source_fragment_canonical_generated &&
       get_translation_unit_source_order().has_value())) {
    fprintf(stderr,
            "REX_AST_INVARIANT[namespace-source-order]: declaration=%p "
            "source_form=%d has_source_order=%d\n",
            static_cast<const void *>(this), static_cast<int>(source_form),
            get_translation_unit_source_order().has_value());
    ROSE_ABORT();
  }
  const Sg_File_Info *opening_start =
      p_opening_source_fragment->get_startOfConstruct();
  const Sg_File_Info *opening_end =
      p_opening_source_fragment->get_endOfConstruct();
  const Sg_File_Info *closing_start =
      p_closing_source_fragment->get_startOfConstruct();
  const Sg_File_Info *closing_end =
      p_closing_source_fragment->get_endOfConstruct();
  if (opening_start->isCompilerGenerated() !=
          closing_start->isCompilerGenerated() ||
      opening_start->isTransformation() != closing_start->isTransformation() ||
      p_opening_source_fragment->get_source_form() !=
          p_closing_source_fragment->get_source_form()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[namespace-source-fragment-pair]: declaration=%p "
            "opening and closing fragments have inconsistent typed "
            "provenance\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }

  if (source_form ==
      SgNamespaceSourceFragment::e_namespace_source_fragment_source_spelled) {
    const Sg_File_Info *introducer_start =
        p_opening_introducer_source_fragment != NULL
            ? p_opening_introducer_source_fragment->get_startOfConstruct()
            : NULL;
    const Sg_File_Info *introducer_end =
        p_opening_introducer_source_fragment != NULL
            ? p_opening_introducer_source_fragment->get_endOfConstruct()
            : NULL;
    const unsigned int opening_occurrence =
        introducer_start != NULL
            ? introducer_start->get_source_sequence_number()
            : opening_start->get_source_sequence_number();
    const unsigned int introducer_end_occurrence =
        introducer_end != NULL ? introducer_end->get_source_sequence_number()
                               : opening_occurrence;
    const unsigned int opening_suffix_occurrence =
        opening_start->get_source_sequence_number();
    const unsigned int opening_brace_occurrence =
        opening_end->get_source_sequence_number();
    const unsigned int closing_brace_occurrence =
        closing_start->get_source_sequence_number();
    const unsigned int closing_end_occurrence =
        closing_end->get_source_sequence_number();
    if (introducer_start != NULL &&
        (introducer_start->get_physical_file_id() ==
             opening_start->get_physical_file_id() ||
         introducer_start->get_physical_file_id() !=
             introducer_end->get_physical_file_id())) {
      fprintf(stderr,
              "REX_AST_INVARIANT[namespace-source-fragment-owner]: "
              "declaration=%p split introducer and opening suffix do not "
              "identify two distinct exact physical owners\n",
              static_cast<const void *>(this));
      ROSE_ABORT();
    }
    if (opening_occurrence != *get_translation_unit_source_order()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[namespace-source-order]: declaration=%p "
              "source_order=%u disagrees with opening occurrence=%u\n",
              static_cast<const void *>(this),
              *get_translation_unit_source_order(), opening_occurrence);
      ROSE_ABORT();
    }
    if ((introducer_start != NULL &&
         (introducer_end_occurrence < opening_occurrence ||
          opening_suffix_occurrence <= introducer_end_occurrence)) ||
        opening_brace_occurrence < opening_suffix_occurrence ||
        closing_brace_occurrence <= opening_brace_occurrence ||
        closing_end_occurrence != closing_brace_occurrence) {
      fprintf(stderr,
              "REX_AST_INVARIANT[namespace-source-fragment-order]: "
              "declaration=%p expanded-token occurrences=%u/%u/%u/%u do not "
              "form one exact namespace interval\n",
              static_cast<const void *>(this), opening_occurrence,
              opening_suffix_occurrence, opening_brace_occurrence,
              closing_brace_occurrence);
      ROSE_ABORT();
    }
  }
}

SgName SgNamespaceDeclarationStatement::get_qualified_name() const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  if (get_isUnnamedNamespace() == true || get_name().is_null() == true) {
    if (isSgGlobal(scope) != NULL) {
      return SgName("");
    }
    return scope->get_qualified_name();
  }

  return SgName::assembleQualifiedName(scope->get_qualified_name(),
                                       get_name());
}

SgName SgNamespaceDeclarationStatement::get_mangled_name(void) const {
  std::string mangledNameString = SageInterface::getMangledNameFromCache(
      const_cast<SgNamespaceDeclarationStatement *>(this));
  if (mangledNameString.empty() == false) {
    return mangledNameString;
  } else {
    SgName mangledName =
        joinMangledQualifiers(mangleQualifiers(get_scope()), get_name());
    mangledName = SageInterface::addMangledNameToCache(
        const_cast<SgNamespaceDeclarationStatement *>(this), mangledName);
    return mangledName;
  }
}

SgSymbol *
SgNamespaceDeclarationStatement::get_symbol_from_symbol_table() const {
  ROSE_ASSERT(get_scope() != NULL);
  return get_scope()->find_symbol_from_declaration(this);
}

SOURCE_NAMESPACE_DECLARATION_STATEMENT_END

SOURCE_NAMESPACE_ALIAS_DECLARATION_STATEMENT_START

SgName SgNamespaceAliasDeclarationStatement::get_mangled_name(void) const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  return scope->get_mangled_name() + SgName("_namespace_alias_") + get_name();
}

SgSymbol *
SgNamespaceAliasDeclarationStatement::get_symbol_from_symbol_table() const {
  ROSE_ASSERT(get_scope() != NULL);
  return get_scope()->find_symbol_from_declaration(this);
}

// Qualification metadata must not mark source as transformed.
int SgNamespaceAliasDeclarationStatement::get_name_qualification_length()
    const {
  return p_name_qualification_length;
}

void SgNamespaceAliasDeclarationStatement::set_name_qualification_length(
    int name_qualification_length) {
  p_name_qualification_length = name_qualification_length;
}

bool SgNamespaceAliasDeclarationStatement::get_type_elaboration_required()
    const {
  return p_type_elaboration_required;
}

void SgNamespaceAliasDeclarationStatement::set_type_elaboration_required(
    bool type_elaboration_required) {
  p_type_elaboration_required = type_elaboration_required;
}

bool SgNamespaceAliasDeclarationStatement::get_global_qualification_required()
    const {
  return p_global_qualification_required;
}

void SgNamespaceAliasDeclarationStatement::set_global_qualification_required(
    bool global_qualification_required) {
  p_global_qualification_required = global_qualification_required;
}

SOURCE_NAMESPACE_ALIAS_DECLARATION_STATEMENT_END

SOURCE_NAMESPACE_DEFINITION_STATEMENT_START

bool SgNamespaceDefinitionStatement::isSameNamespace(
    const SgNamespaceDefinitionStatement *n) const {
  ROSE_ASSERT(n != NULL);
  ROSE_ASSERT(this->get_namespaceDeclaration() != NULL);
  ROSE_ASSERT(n->get_namespaceDeclaration() != NULL);

  return this->get_namespaceDeclaration()->isSameNamespace(
      n->get_namespaceDeclaration());
}

void SgNamespaceDefinitionStatement::append_declaration(
    SgDeclarationStatement *what) {
  get_declarations().push_back(what);
  what->set_parent(this);
}

void SgNamespaceDefinitionStatement::prepend_declaration(
    SgDeclarationStatement *what) {
  get_declarations().insert(get_declarations().begin(), what);
  what->set_parent(this);
}

bool SgNamespaceDefinitionStatement::insert_child(SgStatement *target,
                                                  SgStatement *newstmt,
                                                  bool inFront,
                                                  bool extractBasicBlock) {
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  inFront, extractBasicBlock, false);
}

bool SgNamespaceDefinitionStatement::replace_child(SgStatement *target,
                                                   SgStatement *newstmt,
                                                   bool extractBasicBlock) {
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  true, extractBasicBlock, true);
}

SgName SgNamespaceDefinitionStatement::get_qualified_name() const {
  ROSE_ASSERT(get_namespaceDeclaration() != NULL);
  return get_namespaceDeclaration()->get_qualified_name();
}

SgName SgNamespaceDefinitionStatement::get_mangled_name(void) const {
  ROSE_ASSERT(get_namespaceDeclaration() != NULL);
  return get_namespaceDeclaration()->get_mangled_name();
}

void SgNamespaceDefinitionStatement::post_construction_initialization() {
  if (p_namespaceDeclaration == nullptr)
    return;
  if (get_parent() != nullptr ||
      p_namespaceDeclaration->get_definition() != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[namespace-definition-construction]: "
            "definition=%p declaration=%p has a prior owner or definition\n",
            static_cast<void *>(this),
            static_cast<void *>(p_namespaceDeclaration));
    ROSE_ABORT();
  }
  set_parent(p_namespaceDeclaration);
  p_namespaceDeclaration->set_definition(this);
}

SgNamespaceDefinitionStatement *
SgNamespaceDefinitionStatement::get_previousNamespaceDefinition() const {
  return p_previousNamespaceDefinition;
}

void SgNamespaceDefinitionStatement::set_previousNamespaceDefinition(
    SgNamespaceDefinitionStatement *previousNamespaceDefinition) {
  p_previousNamespaceDefinition = previousNamespaceDefinition;
  advanceReopeningChainRevision();
  markAsModified();
}

SgNamespaceDefinitionStatement *
SgNamespaceDefinitionStatement::get_nextNamespaceDefinition() const {
  return p_nextNamespaceDefinition;
}

void SgNamespaceDefinitionStatement::set_nextNamespaceDefinition(
    SgNamespaceDefinitionStatement *nextNamespaceDefinition) {
  p_nextNamespaceDefinition = nextNamespaceDefinition;
  advanceReopeningChainRevision();
  markAsModified();
}

std::atomic<uint64_t> &
SgNamespaceDefinitionStatement::reopeningChainRevision() {
  static std::atomic<uint64_t> revision(0);
  return revision;
}

void SgNamespaceDefinitionStatement::advanceReopeningChainRevision() {
  reopeningChainRevision().fetch_add(1, std::memory_order_relaxed);
}

uint64_t SgNamespaceDefinitionStatement::get_reopening_chain_revision() {
  return reopeningChainRevision().load(std::memory_order_relaxed);
}

size_t SgNamespaceDefinitionStatement::namespaceIndex() const {
  size_t result = 0;
  std::set<const SgNamespaceDefinitionStatement *> seen;
  for (const SgNamespaceDefinitionStatement *i = this;
       i->get_previousNamespaceDefinition() != NULL;
       i = i->get_previousNamespaceDefinition()) {
    if (!seen.insert(i).second) {
      fprintf(stderr, "Namespace definition previous chain cycles\n");
      ROSE_ABORT();
    }
    result++;
  }

  return result;
}

size_t SgNamespaceDefinitionStatement::numberOfNamespaceDefinitions() const {
  const SgNamespaceDefinitionStatement *first = this;
  std::set<const SgNamespaceDefinitionStatement *> visited;
  while (first->get_previousNamespaceDefinition() != NULL) {
    if (!visited.insert(first).second) {
      fprintf(stderr, "Namespace definition previous chain cycles\n");
      ROSE_ABORT();
    }
    first = first->get_previousNamespaceDefinition();
  }

  size_t result = 0;
  visited.clear();
  for (const SgNamespaceDefinitionStatement *current = first; current != NULL;
       current = current->get_nextNamespaceDefinition()) {
    if (!visited.insert(current).second) {
      fprintf(stderr, "Namespace definition next chain cycles\n");
      ROSE_ABORT();
    }
    ++result;
  }
  return result;
}

SOURCE_NAMESPACE_DEFINITION_STATEMENT_END

