  return p_clause_list;
}

const SgOmpClauseList *SgOmpClauseBodyStatement::get_clause_list() const {
  if (p_clause_list == NULL || p_clause_list->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-clause-list]: statement=%p type=%s has "
            "an invalid structural clause-list owner\n",
            static_cast<const void *>(this), class_name().c_str());
    ROSE_ABORT();
  }
  return p_clause_list;
}

void SgOmpClauseBodyStatement::replace_clause_list(
    SgOmpClauseList *replacement) {
  if (p_clause_list == NULL || p_clause_list->get_parent() != this ||
      !p_clause_list->get_clauses().empty() || replacement == NULL ||
      replacement == p_clause_list || replacement->get_parent() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-clause-list-replacement]: statement=%p "
            "type=%s requires an exclusively owned empty current wrapper and "
            "a distinct unowned replacement\n",
            static_cast<void *>(this), class_name().c_str());
    ROSE_ABORT();
  }
  (void)replacement->get_clauses();
  SgOmpClauseList *old_list = p_clause_list;
  old_list->set_parent(NULL);
  p_clause_list = replacement;
  replacement->set_parent(this);
  delete old_list;
}

const SgOmpClausePtrList &SgOmpClauseBodyStatement::get_clauses() const {
  return get_clause_list()->get_clauses();
}

SOURCE_OMP_CLAUSEBODY_STATEMENT_END

