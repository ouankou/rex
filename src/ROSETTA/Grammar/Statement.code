//! Exact producer-wide lexical order when published by the frontend. Absence
//! means this declaration has no ordered token producer.
const std::optional<unsigned int> &get_translation_unit_source_order() const;

//! Initialize the exact translation-unit order once. Reinitialization is a
//! malformed producer contract, including attempts to publish the same value.
void initialize_translation_unit_source_order(unsigned int source_order);

//! End source-token ownership when this declaration becomes a transformation.
//! A transformed declaration is ordered by its new structural owner, not by the
//! frontend occurrence from which it may have been copied.
void clear_translation_unit_source_order_for_transformation();

// DQ (5/9/2005): Added support for template specialization!
/*! \brief Template Specialization Support

    different forms of template specialization for - classes, functions, and
   variable declarations
 */
enum template_specialization_enum {
  e_unknown = 0,                /*!< unknown value (error value) */
  e_no_specialization = 1,      /*!< not a specialization (default value) */
  e_partial_specialization = 2, /*!< partial specialization */
  e_specialization = 3,         /*!< specialization */
  e_template_specialization_last = 4 /*!< last value (unused) */
};

