SOURCE_LABEL_STATEMENT_START

bool SgLabelStatement::hasExplicitScope() const {
  return true;
}

void SgLabelStatement::post_construction_initialization() {
  if (p_statement != nullptr)
    p_statement->set_parent(this);
}

SgSymbol *SgLabelStatement::get_symbol_from_symbol_table() const {
  SgScopeStatement *tempScope = get_scope();
  ASSERT_not_null(tempScope);
  while (tempScope != nullptr && isSgFunctionDefinition(tempScope) == nullptr) {
    tempScope = tempScope->get_scope();
  }

  SgFunctionDefinition *functionDefinition = isSgFunctionDefinition(tempScope);
  if (functionDefinition == nullptr) {
    std::cerr
        << "[WARN]: Labels are stored in the SgFunctionDefinition (function "
           "scope), could not locate associated function scope\n";
  }
  ASSERT_not_null(functionDefinition);
  return functionDefinition->find_symbol_from_declaration(this);
}

SgType *SgLabelStatement::get_type() const {
  return NULL;
}

bool SgLabelStatement::replace_child(SgStatement *target, SgStatement *newstmt,
                                     bool extractBasicBlock) {
  return (StatementReplace(this, p_statement, target, newstmt) == true);
}

SOURCE_LABEL_STATEMENT_END

SOURCE_WHILE_STATEMENT_START
void SgWhileStmt::post_construction_initialization() {
  if (p_condition != nullptr)
    p_condition->set_parent(this);
  if (p_body != nullptr)
    p_body->set_parent(this);
}

bool SgWhileStmt::replace_child(SgStatement *target, SgStatement *newstmt,
                                bool extractBasicBlock) {
  if (StatementReplace(this, p_condition, target, newstmt) == true)
    return true;
  else
    return (StatementReplace(this, p_body, target, newstmt) == true);
}

bool SgWhileStmt::insert_child(SgStatement *target, SgStatement *newstmt,
                               bool inFront, bool extractBasicBlock) {
  // SgWhileStmt has a loop body where statements can be inserted
  SgBasicBlock *loop_body = isSgBasicBlock(p_body);
  if (loop_body != NULL) {
    // Try inserting into loop body
    if (StatementListInsertChild(loop_body, loop_body->get_statements(), target,
                                 newstmt, inFront, extractBasicBlock, false)) {
      return true;
    }
  }

  // Target not found in loop body
  return false;
}

SgName SgWhileStmt::get_mangled_name(void) const { return SgName(""); }

SOURCE_WHILE_STATEMENT_END

