SOURCE_IMPLICIT_STATEMENT_START
bool SgImplicitStatement::is_valid_implicit_statement(
    implicit_spec_enum spec, const SgFortranImplicitRangePtrList &ranges) {
  if (spec == e_none || spec == e_none_external || spec == e_none_type ||
      spec == e_none_external_and_type)
    return ranges.empty();
  if (spec != e_has_implicit_spec_list || ranges.empty())
    return false;
  bool assigned[26] = {};
  for (const SgFortranImplicitRange *range : ranges) {
    if (range == nullptr ||
        !SgFortranImplicitRange::is_valid_range(
            range->get_first_letter(), range->get_last_letter(),
            range->get_type(), range->get_type_spec(),
            range->get_source_derived_type_symbol()))
      return false;
    auto index = [](char letter) {
      return letter >= 'a' && letter <= 'z' ? letter - 'a' : letter - 'A';
    };
    const int first = index(range->get_first_letter());
    const int last =
        index(range->get_last_letter().value_or(range->get_first_letter()));
    for (int letter = first; letter <= last; ++letter) {
      if (assigned[letter])
        return false;
      assigned[letter] = true;
    }
  }
  return true;
}

void SgImplicitStatement::post_construction_initialization() {
  ROSE_ASSERT(is_valid_implicit_statement(p_implicit_spec, p_ranges));
  for (SgFortranImplicitRange *range : p_ranges)
    ROSE_ASSERT(range->get_parent() == nullptr);
  for (SgFortranImplicitRange *range : p_ranges)
    range->set_parent(this);
}

void SgImplicitStatement::validate_implicit_statement() const {
  ROSE_ASSERT(is_valid_implicit_statement(p_implicit_spec, p_ranges));
  for (const SgFortranImplicitRange *range : p_ranges)
    ROSE_ASSERT(range->get_parent() == this);
}

SgName SgImplicitStatement::get_mangled_name() const {
  return SgName("");
}
SOURCE_IMPLICIT_STATEMENT_END

