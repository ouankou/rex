SOURCE_TEMPLATE_DECLARATION_STATEMENT_START
void SgTemplateDeclaration::post_construction_initialization() {}

SgName SgTemplateDeclaration::get_qualified_name() const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);
  return SgName::assembleQualifiedName(scope->get_qualified_name(), get_name());
}

bool SgTemplateDeclaration::hasExplicitScope() const { return true; }

SgName SgTemplateDeclaration::get_mangled_name(void) const {
  std::string mangledNameString = SageInterface::getMangledNameFromCache(
      const_cast<SgTemplateDeclaration *>(this));
  if (mangledNameString.empty() == false) {
    return mangledNameString;
  } else {
    SgScopeStatement *scope = get_scope();
    if (scope == NULL || get_name().is_null()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[template-declaration-mangled-name]: "
              "declaration=%p has no exact semantic scope or name\n",
              static_cast<const void *>(this));
      ROSE_ABORT();
    }

    std::string exactIdentity = mangleTemplateToString(
        get_name().getString(), get_templateParameters(), scope);
    exactIdentity += "__template_kind_" +
                     Rose::StringUtility::numberToString(get_template_kind());
    if (const SgExpression *requiresClause = get_requiresClause()) {
      exactIdentity += "__requires_" + mangleExpression(requiresClause);
    }

    SgName mangledName(exactIdentity);
    mangledName = SageInterface::addMangledNameToCache(
        const_cast<SgTemplateDeclaration *>(this), mangledName);
    return mangledName;
  }
}

SgSymbol *SgTemplateDeclaration::get_symbol_from_symbol_table() const {
  ROSE_ASSERT(get_scope() != NULL);
  return get_scope()->find_symbol_from_declaration(this);
}

SOURCE_TEMPLATE_DECLARATION_STATEMENT_END

SOURCE_TEMPLATE_CLASS_DECLARATION_STATEMENT_START
void SgTemplateClassDeclaration::post_construction_initialization() {}

SgName SgTemplateClassDeclaration::get_mangled_name(void) const {
  std::string mangledNameString = SageInterface::getMangledNameFromCache(
      const_cast<SgTemplateClassDeclaration *>(this));
  if (mangledNameString.empty() == false) {
    return mangledNameString;
  } else {
    ROSE_ASSERT(get_scope() != NULL);
    SgName mangledScopeName = mangleQualifiers(get_scope());
    SgName mangledName =
        joinMangledQualifiers(mangledScopeName, get_templateName());
    if (mangledName.is_null()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[template-class-mangled-name]: declaration=%p "
              "name=%s scope=%p produced an empty mangled name\n",
              static_cast<const void *>(this), get_name().str(),
              static_cast<void *>(get_scope()));
      ROSE_ABORT();
    }

    // A primary class template and an empty-argument instantiation are
    // different semantic entities.  Mangling every SgTemplateClassDeclaration
    // from templateSpecializationArguments aliases, for example,
    // `template<class...> struct Tuple` with `Tuple<>`, because both argument
    // lists are empty.  Use the template-parameter mangling domain as a stable
    // primary-template marker.  The marker deliberately does not depend on
    // the parameter payload because a recursive frontend transaction must
    // publish the template shell before translating its parameters.
    if (get_specialization() == SgDeclarationStatement::e_no_specialization) {
      const SgTemplateParameterPtrList primary_template_identity_marker;
      mangledName = mangleTemplate(
          mangledName, primary_template_identity_marker, get_scope());
    } else {
      if (get_templateSpecializationArguments().empty()) {
        fprintf(stderr,
                "REX_AST_INVARIANT[template-class-mangled-name]: specialized "
                "template declaration=%p name=%s has no specialization "
                "arguments\n",
                static_cast<const void *>(this), get_name().str());
        ROSE_ABORT();
      }
      mangledName = mangleTemplate(
          mangledName, get_templateSpecializationArguments(), get_scope());
    }

    mangledName = SageInterface::addMangledNameToCache(
        const_cast<SgTemplateClassDeclaration *>(this), mangledName);
    ROSE_ASSERT(mangledName.getString().find('<') == string::npos);
    return mangledName;
  }
}

SOURCE_TEMPLATE_CLASS_DECLARATION_STATEMENT_END

SOURCE_TEMPLATE_FUNCTION_DECLARATION_STATEMENT_START
void SgTemplateFunctionDeclaration::post_construction_initialization() {
  ROSE_ASSERT(get_parameterList() != NULL);
  ROSE_ASSERT(get_parameterList()->get_parent() == this);
}

