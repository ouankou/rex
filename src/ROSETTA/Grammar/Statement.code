SOURCE_PRAGMA_STATEMENT_START
void SgPragmaDeclaration::post_construction_initialization() {
  ROSE_ASSERT(p_fortran_directive_family >= e_fortran_directive_none &&
              p_fortran_directive_family <= e_fortran_directive_compiler);
  if (SgPragma *pragma = get_pragma()) {
    ROSE_ASSERT(pragma->get_parent() == nullptr);
    const bool has_start = pragma->get_startOfConstruct() != nullptr;
    const bool has_end = pragma->get_endOfConstruct() != nullptr;
    ROSE_ASSERT(has_start == has_end);
    pragma->set_parent(this);
  }
}

SgName SgPragmaDeclaration::get_mangled_name(void) const {
  SgName returnName;

  returnName = "pragma_statement";

  return returnName;
}

