SOURCE_IMAGE_CONTROL_STATEMENT_START

static void
adoptImageControlOperands(SgImageControlStatement *owner,
                          std::initializer_list<SgExpression *> operands) {
  for (auto current = operands.begin(); current != operands.end(); ++current) {
    if (*current == nullptr)
      continue;
    ROSE_ASSERT((*current)->get_parent() == nullptr);
    for (auto previous = operands.begin(); previous != current; ++previous)
      ROSE_ASSERT(*previous != *current);
  }
  for (SgExpression *operand : operands) {
    if (operand != nullptr)
      operand->set_parent(owner);
  }
}

void SgImageControlStatement::post_construction_initialization() {}

SOURCE_IMAGE_CONTROL_STATEMENT_END

