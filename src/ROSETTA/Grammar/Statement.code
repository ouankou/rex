SOURCE_OMP_CLAUSE_STATEMENT_START
void SgOmpClauseStatement::post_construction_initialization() {
  if (p_clause_list == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-clause-list]: statement=%p type=%s has "
            "no structural clause-list wrapper\n",
            static_cast<void *>(this), class_name().c_str());
    ROSE_ABORT();
  }
  if (p_clause_list->get_parent() != NULL &&
      p_clause_list->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-clause-list]: statement=%p type=%s "
            "received a clause-list wrapper owned by %p\n",
            static_cast<void *>(this), class_name().c_str(),
            static_cast<void *>(p_clause_list->get_parent()));
    ROSE_ABORT();
  }
  p_clause_list->set_parent(this);
}

SgOmpClauseList *SgOmpClauseStatement::get_clause_list() {
  if (p_clause_list == NULL || p_clause_list->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-clause-list]: statement=%p type=%s has "
            "an invalid structural clause-list owner\n",
            static_cast<void *>(this), class_name().c_str());
    ROSE_ABORT();
  }
  return p_clause_list;
}

const SgOmpClauseList *SgOmpClauseStatement::get_clause_list() const {
  if (p_clause_list == NULL || p_clause_list->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-clause-list]: statement=%p type=%s has "
            "an invalid structural clause-list owner\n",
            static_cast<const void *>(this), class_name().c_str());
    ROSE_ABORT();
  }
  return p_clause_list;
}

void SgOmpClauseStatement::replace_clause_list(SgOmpClauseList *replacement) {
  if (p_clause_list == NULL || p_clause_list->get_parent() != this ||
      !p_clause_list->get_clauses().empty() || replacement == NULL ||
      replacement == p_clause_list || replacement->get_parent() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[openmp-clause-list-replacement]: statement=%p "
            "type=%s requires an exclusively owned empty current wrapper and "
            "a distinct unowned replacement\n",
            static_cast<void *>(this), class_name().c_str());
    ROSE_ABORT();
  }
  (void)replacement->get_clauses();
  SgOmpClauseList *old_list = p_clause_list;
  old_list->set_parent(NULL);
  p_clause_list = replacement;
  replacement->set_parent(this);
  delete old_list;
}

const SgOmpClausePtrList &SgOmpClauseStatement::get_clauses() const {
  return get_clause_list()->get_clauses();
}

SOURCE_OMP_CLAUSE_STATEMENT_END

