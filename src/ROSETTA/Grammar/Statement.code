SOURCE_FUNCTION_DEFINITION_STATEMENT_START

// CLANG FRONTEND FIX: Implement insert_child for SgFunctionDefinition
// WHY: Clang frontend creates AST structures where insertStatementBefore may be
// called with an SgFunctionDefinition as the parent. This delegates to the body
// BasicBlock.
bool SgFunctionDefinition::insert_child(SgStatement *target,
                                        SgStatement *newstmt, bool inFront,
                                        bool extractBasicBlock) {
  // SgFunctionDefinition contains a single SgBasicBlock as its body
  // Use StatementListInsertChild to insert into the body's statement list
  SgBasicBlock *body = get_body();
  if (body == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-definition-body]: definition=%p has "
            "no body while inserting child=%p\n",
            static_cast<void *>(this), static_cast<void *>(newstmt));
    ROSE_ABORT();
  }

  // Use the public StatementListInsertChild template function
  return StatementListInsertChild(body, body->get_statements(), target, newstmt,
                                  inFront, extractBasicBlock, false);
}

SOURCE_FUNCTION_DEFINITION_STATEMENT_END

SOURCE_TEMPLATE_FUNCTION_DEFINITION_STATEMENT_START
void SgTemplateFunctionDefinition::post_construction_initialization() {}

// DQ (12/1/2011): Added support for template declarations in the AST.
SgTemplateFunctionDefinition::SgTemplateFunctionDefinition(
    Sg_File_Info *f, SgTemplateFunctionDeclaration *d, SgBasicBlock *body)
    // : SgScopeStatement(f), p_body(body)
    : SgFunctionDefinition(f, NULL, body) {
  set_declaration(d);
  if (d != NULL) // Liao, 4/14/2009. Support bottom-up AST building: definition
                 // is built first, declaration may be still NULL
    d->set_definition(this);
}

// DQ (12/1/2011): Added support for template declarations in the AST.
SgTemplateFunctionDefinition::SgTemplateFunctionDefinition(
    SgTemplateFunctionDeclaration *d, SgBasicBlock *body)
    // : SgScopeStatement(), p_body(body)
    : SgFunctionDefinition((SgFunctionDeclaration *)NULL, body) {
  set_declaration(d);
  if (d != NULL)
    d->set_definition(this);
}

SgTemplateFunctionDeclaration *
SgTemplateFunctionDefinition::get_declaration() const {
  // This is copied and modified from the similar function for
  // SgFunctionDefinition::get_declaration()
  SgNode *res = get_parent();
  SgTemplateFunctionDeclaration *res1 = isSgTemplateFunctionDeclaration(res);

  assert(res == 0 || res1 != 0);

  return res1;
}

