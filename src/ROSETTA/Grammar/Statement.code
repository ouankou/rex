SOURCE_DERIVED_TYPE_STATEMENT_START

void SgDerivedTypeStatement::post_construction_initialization() {}

SgName SgDerivedTypeStatement::get_mangled_name() const {
  // A derived type has nominal identity through its canonical declaration.
  // Its containing procedure may return that very type, so a procedure's
  // function signature is not a construction dependency of this identity.
  SgClassType *type = get_type();
  ROSE_ASSERT(type != nullptr);
  auto *owner = isSgDerivedTypeStatement(type->get_declaration());
  ROSE_ASSERT(owner != nullptr);
  ROSE_ASSERT(owner->get_firstNondefiningDeclaration() == owner);
  ROSE_ASSERT(owner->get_type() == type);
  SgName result;
  result << "__fortran_derived_type_"
         << Rose::StringUtility::numberToString(owner);
  return result;
}

SOURCE_DERIVED_TYPE_STATEMENT_END

SOURCE_ATTRIBUTE_SPECIFICATION_STATEMENT_START
bool SgAttributeSpecificationStatement::is_valid_data_groups(
    attribute_spec_enum kind, const SgDataStatementGroupPtrList &groups) {
  if (kind != e_dataStatement)
    return groups.empty();
  if (groups.empty())
    return false;
  std::set<SgDataStatementGroup *> seen;
  for (auto *group : groups)
    if (group == nullptr || !seen.insert(group).second ||
        !SgDataStatementGroup::is_valid_group(group->get_object_list(),
                                              group->get_value_list()))
      return false;
  return true;
}

void SgAttributeSpecificationStatement::post_construction_initialization() {
  SgDeclarationStatement::post_construction_initialization();
  ROSE_ASSERT(
      is_valid_data_groups(p_attribute_kind, p_data_statement_group_list));
  for (auto *group : p_data_statement_group_list)
    ROSE_ASSERT(group->get_parent() == nullptr);
  for (auto *group : p_data_statement_group_list)
    group->set_parent(this);
}

void SgAttributeSpecificationStatement::validate_data_groups() const {
  ROSE_ASSERT(
      is_valid_data_groups(p_attribute_kind, p_data_statement_group_list));
  for (auto *group : p_data_statement_group_list) {
    ROSE_ASSERT(group->get_parent() == this);
    group->validate_group();
  }
}

SgName SgAttributeSpecificationStatement::get_mangled_name(void) const {
  return SgName("__attribute_specification_statement__");
}

const SgStringList &SgAttributeSpecificationStatement::get_name_list() const {
  return p_name_list;
