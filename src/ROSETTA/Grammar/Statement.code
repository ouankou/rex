void SgFunctionTypeTable::insert_function_type(const SgName &n, SgType *t) {
  ROSE_ASSERT(p_function_type_table != NULL);
  ROSE_ASSERT(t != NULL);

  SgFunctionTypeSymbol *newSymbol = new SgFunctionTypeSymbol(n, t);
  ROSE_ASSERT(newSymbol != NULL);
  // printf ("Is the qualified name being used! \n");
  // ROSE_ASSERT(false);

  p_function_type_table->insert(n, newSymbol);
  // p_function_type_table->insert(n, new SgFunctionTypeSymbol(n,t));
}

// DQ (1/31/2007): Added support for removing function type symbols (used in AST
// merge)
void SgFunctionTypeTable::remove_function_type(const SgName &n) {
  ROSE_ASSERT(p_function_type_table != NULL);
  p_function_type_table->remove_function_type(n);
}

SgType *SgFunctionTypeTable::lookup_exact_function_type(
    const SgName &name, SgType *returnType,
    SgFunctionParameterTypeList *argumentTypes, SgType *classType,
    unsigned int memberFunctionSpecifier) {
  if (p_function_type_table == NULL ||
      p_function_type_table->get_table() == NULL || returnType == NULL ||
      argumentTypes == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-type-table-lookup]: name=%s table=%p "
            "entries=%p return=%p arguments=%p has no exact lookup key\n",
            name.str(), static_cast<void *>(p_function_type_table),
            static_cast<void *>(p_function_type_table != NULL
                                    ? p_function_type_table->get_table()
                                    : NULL),
            static_cast<void *>(returnType),
            static_cast<void *>(argumentTypes));
    ROSE_ABORT();
  }

  const SgTypePtrList &requestedArguments = argumentTypes->get_arguments();
  SgType *result = NULL;
  rose_hash_multimap *entries = p_function_type_table->get_table();
  const std::pair<rose_hash_multimap::iterator, rose_hash_multimap::iterator>
      range = entries->equal_range(name);
  for (rose_hash_multimap::iterator entry = range.first; entry != range.second;
       ++entry) {
    SgFunctionTypeSymbol *symbol = isSgFunctionTypeSymbol(entry->second);
    SgFunctionType *candidate =
        symbol != NULL ? isSgFunctionType(symbol->get_type()) : NULL;
    SgFunctionParameterTypeList *candidateArgumentList =
        candidate != NULL ? candidate->get_argument_list() : NULL;
    SgMemberFunctionType *candidateMember = isSgMemberFunctionType(candidate);
    const bool exactMemberRole =
        classType == NULL
            ? candidateMember == NULL && memberFunctionSpecifier == 0
            : candidateMember != NULL &&
                  candidateMember->get_class_type() == classType &&
                  candidateMember->get_mfunc_specifier() ==
                      memberFunctionSpecifier;
    bool exactArguments = candidateArgumentList != NULL &&
                          candidateArgumentList->get_parent() == candidate &&
                          candidateArgumentList->get_arguments().size() ==
                              requestedArguments.size();
    if (exactArguments) {
      const SgTypePtrList &candidateArguments =
          candidateArgumentList->get_arguments();
      for (size_t index = 0; index < requestedArguments.size(); ++index) {
        if (requestedArguments[index] == NULL ||
            candidateArguments[index] != requestedArguments[index]) {
          exactArguments = false;
          break;
        }
      }
    }
    if (symbol == NULL || candidate == NULL ||
        symbol->get_parent() != p_function_type_table ||
        !p_function_type_table->exists(symbol) ||
        candidate->get_return_type() != returnType || !exactMemberRole ||
        !exactArguments) {
      continue;
    }
    if (result != NULL && result != candidate) {
      fprintf(stderr,
              "REX_AST_INVARIANT[function-type-table-identity]: name=%s "
              "first=%p second=%p return=%p class=%p specifier=%u has two "
              "exact semantic entries\n",
              name.str(), static_cast<void *>(result),
              static_cast<void *>(candidate), static_cast<void *>(returnType),
              static_cast<void *>(classType), memberFunctionSpecifier);
      ROSE_ABORT();
    }
    result = candidate;
  }
  return result;
}

SOURCE_FUNCTION_TYPE_TABLE_STATEMENT_END

SOURCE_GLOBAL_STATEMENT_START

// DQ (9/8/2004): Added to support qualified name generation
SgName SgGlobal::get_qualified_name() const {
  // DQ (8/25/2005): This is the case where we previously names the global scope
  // as "::" within name qualification.  This was done to handle test2005_144.C
  // but it broke test2004_80.C So we have moved to an explicit marking of IR
  // nodes using global scope qualification (since it clearly seems to be
  // required). DQ (8/22/2005): Added global scope qualifier (see
  // test2005_144.C) it is sometimes required to prevent base class types from
  // being used instead of globally defined types. Note that this will still
  // evaluate so that "returnName.is_null()" will be true

  // DQ (10/11/2006): Under the new name qualification, we must traverse all the
  // way to global scope, and include global scope to get test2006_157.C
  // correct. return SgName ("");

  std::string globalScopeDelimiter;
  globalScopeDelimiter = "::";
  return SgName(globalScopeDelimiter);
}

SgName SgGlobal::get_mangled_name(void) const {
  // DQ (2/22/2007): This function is added to prevent "::" substrings in
  // mangled names of other declarations. DQ (3/12/2007): This is likely faster
  // than using the mangled name map
  return SgName("__global__");
}

void SgGlobal::post_construction_initialization() {}

void SgGlobal::append_declaration(SgDeclarationStatement *what) {
  // DQ (3/10/2007): Make sure that the statement does not already exist in the
  // scope It may be OK if is is marked explicitly as shared. Note that this is
  // a linear time test.

  get_declarations().push_back(what);
  what->set_parent(this);

  // DQ (6/24/2006): This should be set by the lower level insert_statement
  // member function, verify this!
  ROSE_ASSERT(what->get_parent() != NULL);
}

void SgGlobal::prepend_declaration(SgDeclarationStatement *what) {
  get_declarations().insert(get_declarations().begin(), what);
  what->set_parent(this);

  // DQ (6/24/2006): This should be set by the lower level insert_statement
  // member function, verify this!
  ROSE_ASSERT(what->get_parent() != NULL);
}

bool SgGlobal::insert_child(SgStatement *target, SgStatement *newstmt,
                            bool inFront, bool extractBasicBlock) {
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  inFront, extractBasicBlock, false);
}

bool SgGlobal::replace_child(SgStatement *target, SgStatement *newstmt,
                             bool extractBasicBlock) {
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  true, extractBasicBlock, true);
}

