SOURCE_BASIC_BLOCK_STATEMENT_START

SgBasicBlock::SgBasicBlock(Sg_File_Info *info, SgStatement *stmt)
    : $BASECLASS(info) {
  post_construction_initialization();
  if (stmt != NULL) {
    append_statement(stmt);

    ROSE_ASSERT(stmt->get_parent() != NULL);
  }
}

SgBasicBlock::SgBasicBlock(SgStatement *stmt) : $BASECLASS() {
  post_construction_initialization();
  if (stmt != NULL) {
    append_statement(stmt);

    ROSE_ASSERT(stmt->get_parent() != NULL);
  }
}

SgName SgBasicBlock::get_qualified_name() const {
  SgName returnName = "";
  return returnName;
}

SgName SgBasicBlock::get_mangled_name(void) const { return SgName(""); }

SgScopeStatement *
SgBasicBlock::get_statement_expression_construction_scope() const {
  return p_statement_expression_construction_scope;
}

void SgBasicBlock::begin_statement_expression_construction(
    SgScopeStatement *semanticScope) {
  if (semanticScope == NULL || semanticScope == this || get_parent() != NULL ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[statement-expression-construction-begin]: "
            "block=%p parent=%p requested-scope=%p active-scope=%p "
            "semantic-scope=%p does not form one fresh detached construction "
            "transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(semanticScope),
            static_cast<void *>(p_statement_expression_construction_scope),
            static_cast<void *>(get_statement_expression_semantic_scope()));
    ROSE_ABORT();
  }
  p_statement_expression_construction_scope = semanticScope;
}

void SgBasicBlock::consume_statement_expression_construction(
    SgStatementExpression *expressionOwner,
    SgScopeStatement *expectedSemanticScope) {
  if (expressionOwner == NULL || expectedSemanticScope == NULL ||
      p_statement_expression_construction_scope != expectedSemanticScope ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != NULL || get_parent() != expressionOwner ||
      expressionOwner->get_statement() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[statement-expression-construction-consume]: "
            "block=%p parent=%p expression-owner=%p expected-scope=%p "
            "active-scope=%p semantic-scope=%p does not form one exact typed "
            "owner transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(expressionOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(p_statement_expression_construction_scope),
            static_cast<void *>(get_statement_expression_semantic_scope()));
    ROSE_ABORT();
  }
  set_statement_expression_semantic_scope(expectedSemanticScope);
  p_statement_expression_construction_scope = NULL;
  if (get_statement_expression_semantic_scope() != expectedSemanticScope ||
      get_scope() != expectedSemanticScope) {
    fprintf(stderr,
            "REX_AST_INVARIANT[statement-expression-construction-publish]: "
            "block=%p expression-owner=%p expected-scope=%p published=%p "
            "resolved=%p\n",
            static_cast<void *>(this), static_cast<void *>(expressionOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(get_statement_expression_semantic_scope()),
            static_cast<void *>(get_scope()));
    ROSE_ABORT();
  }
}

SgScopeStatement *SgBasicBlock::get_implied_do_construction_scope() const {
  return p_implied_do_construction_scope;
}

void SgBasicBlock::begin_implied_do_construction(
    SgImpliedDo *expressionOwner, SgScopeStatement *semanticScope) {
  if (expressionOwner == NULL || semanticScope == NULL ||
      semanticScope == this || get_parent() != NULL ||
      expressionOwner->get_parent() != NULL ||
      expressionOwner->get_implied_do_scope() != this ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[implied-do-construction-begin]: block=%p "
            "parent=%p expression-owner=%p expression-parent=%p "
            "requested-scope=%p statement-expression-construction-scope=%p "
            "statement-expression-semantic-scope=%p active-scope=%p does not "
            "form one fresh typed construction transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(expressionOwner),
            expressionOwner != NULL
                ? static_cast<void *>(expressionOwner->get_parent())
                : NULL,
            static_cast<void *>(semanticScope),
            static_cast<void *>(p_statement_expression_construction_scope),
            static_cast<void *>(get_statement_expression_semantic_scope()),
            static_cast<void *>(p_implied_do_construction_scope));
    ROSE_ABORT();
  }
  p_implied_do_construction_scope = semanticScope;
}

void SgBasicBlock::consume_implied_do_construction(
    SgImpliedDo *expressionOwner, SgScopeStatement *expectedSemanticScope) {
  if (expressionOwner == NULL || expectedSemanticScope == NULL ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != expectedSemanticScope ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != NULL || get_parent() != expressionOwner ||
      expressionOwner->get_parent() != NULL ||
      expressionOwner->get_implied_do_scope() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[implied-do-construction-consume]: block=%p "
            "parent=%p expression-owner=%p expression-parent=%p "
            "expected-scope=%p statement-expression-construction-scope=%p "
            "statement-expression-semantic-scope=%p active-scope=%p does not "
            "form one exact typed owner transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(expressionOwner),
            expressionOwner != NULL
                ? static_cast<void *>(expressionOwner->get_parent())
                : NULL,
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(p_statement_expression_construction_scope),
            static_cast<void *>(get_statement_expression_semantic_scope()),
            static_cast<void *>(p_implied_do_construction_scope));
    ROSE_ABORT();
  }
  set_implied_do_semantic_scope(expectedSemanticScope);
  p_implied_do_construction_scope = NULL;
  if (get_implied_do_semantic_scope() != expectedSemanticScope ||
      get_scope() != expectedSemanticScope) {
    fprintf(stderr,
            "REX_AST_INVARIANT[implied-do-construction-publish]: block=%p "
            "expression-owner=%p expected-scope=%p published=%p resolved=%p\n",
            static_cast<void *>(this), static_cast<void *>(expressionOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(get_implied_do_semantic_scope()),
            static_cast<void *>(get_scope()));
    ROSE_ABORT();
  }
}

SgScopeStatement *SgBasicBlock::get_function_body_construction_scope() const {
  return p_function_body_construction_scope;
}

void SgBasicBlock::begin_function_body_construction(
    SgScopeStatement *semanticScope) {
  if (semanticScope == NULL || semanticScope == this || get_parent() != NULL ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-body-construction-begin]: block=%p "
            "parent=%p requested-scope=%p statement-expression-construction="
            "%p statement-expression-semantic=%p implied-do-construction=%p "
            "implied-do-semantic=%p function-body-construction=%p "
            "forall-construction=%p does not form one fresh detached "
            "function-body transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(semanticScope),
            static_cast<void *>(p_statement_expression_construction_scope),
            static_cast<void *>(get_statement_expression_semantic_scope()),
            static_cast<void *>(p_implied_do_construction_scope),
            static_cast<void *>(get_implied_do_semantic_scope()),
            static_cast<void *>(p_function_body_construction_scope),
            static_cast<void *>(p_forall_construction_scope));
    ROSE_ABORT();
  }
  p_function_body_construction_scope = semanticScope;
  if (get_scope() != semanticScope) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-body-construction-publish]: block=%p "
            "requested-scope=%p resolved=%p\n",
            static_cast<void *>(this), static_cast<void *>(semanticScope),
            static_cast<void *>(get_scope()));
    ROSE_ABORT();
  }
}

void SgBasicBlock::consume_function_body_construction(
    SgFunctionDefinition *functionOwner,
    SgScopeStatement *expectedSemanticScope) {
  if (functionOwner == NULL || expectedSemanticScope == NULL ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != expectedSemanticScope ||
      p_forall_construction_scope != NULL || get_parent() != functionOwner ||
      functionOwner->get_body() != this ||
      functionOwner->get_scope() != expectedSemanticScope) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-body-construction-consume]: block=%p "
            "parent=%p function-owner=%p expected-scope=%p active-scope=%p "
            "does not form one exact typed function-body owner transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(functionOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(p_function_body_construction_scope));
    ROSE_ABORT();
  }
  p_function_body_construction_scope = NULL;
  if (get_scope() != functionOwner) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-body-construction-complete]: block=%p "
            "function-owner=%p expected-outer-scope=%p resolved=%p\n",
            static_cast<void *>(this), static_cast<void *>(functionOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(get_scope()));
    ROSE_ABORT();
  }
}

SgScopeStatement *SgBasicBlock::get_forall_construction_scope() const {
  return p_forall_construction_scope;
}

void SgBasicBlock::begin_forall_construction(SgScopeStatement *semanticScope) {
  if (semanticScope == NULL || semanticScope == this || get_parent() != NULL ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[forall-construction-begin]: block=%p "
            "parent=%p requested-scope=%p statement-expression-construction="
            "%p statement-expression-semantic=%p implied-do-construction=%p "
            "implied-do-semantic=%p active-scope=%p does not form one fresh "
            "typed FORALL construction transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(semanticScope),
            static_cast<void *>(p_statement_expression_construction_scope),
            static_cast<void *>(get_statement_expression_semantic_scope()),
            static_cast<void *>(p_implied_do_construction_scope),
            static_cast<void *>(get_implied_do_semantic_scope()),
            static_cast<void *>(p_forall_construction_scope));
    ROSE_ABORT();
  }
  p_forall_construction_scope = semanticScope;
}

void SgBasicBlock::consume_forall_construction(
    SgForAllStatement *statementOwner,
    SgScopeStatement *expectedSemanticScope) {
  if (statementOwner == NULL || expectedSemanticScope == NULL ||
      p_statement_expression_construction_scope != NULL ||
      get_statement_expression_semantic_scope() != NULL ||
      p_implied_do_construction_scope != NULL ||
      get_implied_do_semantic_scope() != NULL ||
      p_function_body_construction_scope != NULL ||
      p_forall_construction_scope != expectedSemanticScope ||
      get_parent() != statementOwner || statementOwner->get_body() != this ||
      statementOwner->get_scope() != expectedSemanticScope) {
    fprintf(stderr,
            "REX_AST_INVARIANT[forall-construction-consume]: block=%p "
            "parent=%p statement-owner=%p expected-scope=%p active-scope=%p "
            "does not form one exact typed FORALL owner transaction\n",
            static_cast<void *>(this), static_cast<void *>(get_parent()),
            static_cast<void *>(statementOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(p_forall_construction_scope));
    ROSE_ABORT();
  }
  p_forall_construction_scope = NULL;
  if (get_scope() != statementOwner) {
    fprintf(stderr,
            "REX_AST_INVARIANT[forall-construction-publish]: block=%p "
            "statement-owner=%p expected-outer-scope=%p resolved=%p\n",
            static_cast<void *>(this), static_cast<void *>(statementOwner),
            static_cast<void *>(expectedSemanticScope),
            static_cast<void *>(get_scope()));
    ROSE_ABORT();
  }
}

SgScopeStatement *SgBasicBlock::get_scope(void) const {
  SgScopeStatement *statement_expression_construction_scope =
      get_statement_expression_construction_scope();
  SgScopeStatement *statement_expression_semantic_scope =
      get_statement_expression_semantic_scope();
  SgScopeStatement *implied_do_scope = get_implied_do_construction_scope();
  SgScopeStatement *implied_do_semantic_scope = get_implied_do_semantic_scope();
  SgScopeStatement *function_body_construction_scope =
      get_function_body_construction_scope();
  SgScopeStatement *forall_construction_scope = get_forall_construction_scope();
  const unsigned int special_scope_count =
      (statement_expression_construction_scope != NULL ? 1U : 0U) +
      (statement_expression_semantic_scope != NULL ? 1U : 0U) +
      (implied_do_scope != NULL ? 1U : 0U) +
      (implied_do_semantic_scope != NULL ? 1U : 0U) +
      (function_body_construction_scope != NULL ? 1U : 0U) +
      (forall_construction_scope != NULL ? 1U : 0U);
  if (special_scope_count > 1) {
    fprintf(stderr,
            "REX_AST_INVARIANT[basic-block-construction-scope]: block=%p "
            "has simultaneous statement-expression-construction-scope=%p, "
            "statement-expression-semantic-scope=%p, and implied-do-scope=%p "
            "implied-do-semantic-scope=%p, function-body-construction-scope=%p,"
            " and forall-construction-scope=%p roles\n",
            static_cast<const void *>(this),
            static_cast<void *>(statement_expression_construction_scope),
            static_cast<void *>(statement_expression_semantic_scope),
            static_cast<void *>(implied_do_scope),
            static_cast<void *>(implied_do_semantic_scope),
            static_cast<void *>(function_body_construction_scope),
            static_cast<void *>(forall_construction_scope));
    ROSE_ABORT();
  }
  if (statement_expression_construction_scope != NULL) {
    if (get_parent() != NULL ||
        statement_expression_construction_scope == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[statement-expression-construction-scope]: "
              "block=%p has construction-scope=%p while parent=%p\n",
              static_cast<const void *>(this),
              static_cast<void *>(statement_expression_construction_scope),
              static_cast<void *>(get_parent()));
      ROSE_ABORT();
    }
    return statement_expression_construction_scope;
  }
  if (statement_expression_semantic_scope != NULL) {
    SgStatementExpression *expressionOwner =
        isSgStatementExpression(get_parent());
    if (expressionOwner == NULL || expressionOwner->get_statement() != this ||
        statement_expression_semantic_scope == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[statement-expression-semantic-scope]: "
              "block=%p parent=%p semantic-scope=%p does not form one exact "
              "typed statement-expression owner\n",
              static_cast<const void *>(this),
              static_cast<void *>(get_parent()),
              static_cast<void *>(statement_expression_semantic_scope));
      ROSE_ABORT();
    }
    return statement_expression_semantic_scope;
  }
  if (implied_do_scope != NULL) {
    SgImpliedDo *expressionOwner = isSgImpliedDo(get_parent());
    if (expressionOwner == NULL || expressionOwner->get_parent() != NULL ||
        expressionOwner->get_implied_do_scope() != this ||
        implied_do_scope == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[implied-do-construction-scope]: block=%p "
              "parent=%p construction-scope=%p does not form one detached "
              "typed implied-DO owner transaction\n",
              static_cast<const void *>(this),
              static_cast<void *>(get_parent()),
              static_cast<void *>(implied_do_scope));
      ROSE_ABORT();
    }
    return implied_do_scope;
  }
  if (implied_do_semantic_scope != NULL) {
    SgImpliedDo *expressionOwner = isSgImpliedDo(get_parent());
    if (expressionOwner == NULL ||
        expressionOwner->get_implied_do_scope() != this ||
        implied_do_semantic_scope == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[implied-do-semantic-scope]: block=%p "
              "parent=%p semantic-scope=%p does not form one exact typed "
              "implied-DO owner\n",
              static_cast<const void *>(this),
              static_cast<void *>(get_parent()),
              static_cast<void *>(implied_do_semantic_scope));
      ROSE_ABORT();
    }
    return implied_do_semantic_scope;
  }
  if (function_body_construction_scope != NULL) {
    if (get_parent() != NULL || function_body_construction_scope == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[function-body-construction-scope]: block=%p "
              "parent=%p construction-scope=%p does not form one detached "
              "typed function-body transaction\n",
              static_cast<const void *>(this),
              static_cast<void *>(get_parent()),
              static_cast<void *>(function_body_construction_scope));
      ROSE_ABORT();
    }
    return function_body_construction_scope;
  }
  if (forall_construction_scope != NULL) {
    if (get_parent() != NULL || forall_construction_scope == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[forall-construction-scope]: block=%p "
              "parent=%p construction-scope=%p does not form one detached "
              "typed FORALL construction transaction\n",
              static_cast<const void *>(this),
              static_cast<void *>(get_parent()),
              static_cast<void *>(forall_construction_scope));
      ROSE_ABORT();
    }
    return forall_construction_scope;
  }

  return SgStatement::get_scope();
}

void SgBasicBlock::post_construction_initialization() {
  p_is_implicit_control_flow_scope = false;
  p_statement_expression_construction_scope = NULL;
  set_statement_expression_semantic_scope(NULL);
  p_implied_do_construction_scope = NULL;
  set_implied_do_semantic_scope(NULL);
  p_function_body_construction_scope = NULL;
  p_forall_construction_scope = NULL;
  p_is_fortran_block_construct = false;
  p_fortran_block_construct_name.clear();
  p_fortran_block_end_numeric_label = NULL;
}

void SgBasicBlock::set_end_numeric_label(SgLabelRefExp *endNumericLabel) {
  if (!p_is_fortran_block_construct ||
      (p_fortran_block_end_numeric_label != NULL &&
       p_fortran_block_end_numeric_label != endNumericLabel)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[fortran-block-end-label]: block=%p role=%d "
            "old-label=%p new-label=%p cannot accept END BLOCK label\n",
            static_cast<void *>(this), p_is_fortran_block_construct ? 1 : 0,
            static_cast<void *>(p_fortran_block_end_numeric_label),
            static_cast<void *>(endNumericLabel));
    ROSE_ABORT();
  }
  p_fortran_block_end_numeric_label = endNumericLabel;
  markAsModified();
}

SgLabelRefExp *SgBasicBlock::get_end_numeric_label() const {
  if (!p_is_fortran_block_construct) {
    fprintf(stderr,
            "REX_AST_INVARIANT[fortran-block-end-label]: block=%p is not a "
            "Fortran BLOCK construct\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  return p_fortran_block_end_numeric_label;
}

bool SgBasicBlock::has_end_numeric_label() const {
  return p_is_fortran_block_construct;
}

void SgBasicBlock::append_statement(SgStatement *what) {
  ROSE_ASSERT(what != nullptr);
  if (SgAuxiliaryDeclarationList *container =
          isSgAuxiliaryDeclarationList(what->get_parent())) {
    fprintf(stderr,
            "REX_AST_INVARIANT[basic-block-append-auxiliary-owner]: "
            "statement=%p type=%s remains owned by auxiliary container=%p "
            "owner=%p; detach it through the typed ownership transaction "
            "before lexical adoption\n",
            static_cast<void *>(what), what->class_name().c_str(),
            static_cast<void *>(container),
            static_cast<void *>(container->get_parent()));
    ROSE_ABORT();
  }

  get_statements().push_back(what);
  what->set_parent(this);

  ROSE_ASSERT(what->get_parent() != NULL);
}

void SgBasicBlock::prepend_statement(SgStatement *what) {
  ROSE_ASSERT(what != nullptr);
  get_statements().insert(get_statements().begin(), what);
  what->set_parent(this);

  ROSE_ASSERT(what->get_parent() != NULL);
}

bool SgBasicBlock::replace_child(SgStatement *target, SgStatement *newstmt,
                                 bool extractBasicBlock) {
  return StatementListInsertChild(this, p_statements, target, newstmt, true,
                                  extractBasicBlock, true);
}
//! insert newstmt before or after target. If extractBasicBlock is true AND
//! newstmt is a basic
// block, insert statements from newstmt instead of inserting newstmt.
// target should be a child statement within this SgBasicBlock.
bool SgBasicBlock::insert_child(SgStatement *target, SgStatement *newstmt,
                                bool inFront, bool extractBasicBlock) {
  return StatementListInsertChild(this, p_statements, target, newstmt, inFront,
                                  extractBasicBlock, false);
}

SOURCE_BASIC_BLOCK_STATEMENT_END

SOURCE_IF_STATEMENT_START
void SgIfStmt::post_construction_initialization() {
  if (get_conditional() != NULL)
    get_conditional()->set_parent(this);
  if (get_true_body() != NULL)
    get_true_body()->set_parent(this);
  if (get_false_body() != NULL)
    get_false_body()->set_parent(this);
}

bool SgIfStmt::replace_child(SgStatement *target, SgStatement *newstmt,
                             bool extractBasicBlock) {
  if (StatementReplace(this, p_conditional, target, newstmt) == true) {
    return true;
  } else {
    if (StatementReplace(this, p_true_body, target, newstmt) == true) {
      return true;
    } else {
      if (StatementReplace(this, p_false_body, target, newstmt) == true) {
        return true;
      } else {
        return false;
      }
    }
  }
}

bool SgIfStmt::insert_child(SgStatement *target, SgStatement *newstmt,
                            bool inFront, bool extractBasicBlock) {
  // SgIfStmt has a true body and optionally a false body
  // Try inserting into true body first
  SgBasicBlock *true_body = isSgBasicBlock(p_true_body);
  if (true_body != NULL) {
    // Check if target is in true_body by attempting insertion
    if (StatementListInsertChild(true_body, true_body->get_statements(), target,
                                 newstmt, inFront, extractBasicBlock, false)) {
      return true;
    }
  }

  // Try inserting into false body if it exists
  SgBasicBlock *false_body = isSgBasicBlock(p_false_body);
  if (false_body != NULL) {
    if (StatementListInsertChild(false_body, false_body->get_statements(),
                                 target, newstmt, inFront, extractBasicBlock,
                                 false)) {
      return true;
    }
  }

  // Target not found in either body
  return false;
}

SgName SgIfStmt::get_mangled_name(void) const { return SgName(""); }

SOURCE_IF_STATEMENT_END

SOURCE_FOR_INIT_STATEMENT_START

void SgForInitStatement::post_construction_initialization() {}

void SgForInitStatement::append_init_stmt(SgStatement *what) {
  if (what == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[for-init-append]: cannot append a null "
                    "initializer statement\n");
    ROSE_ABORT();
  }
  if (get_init_stmt().size() == 1 &&
      isSgNullStatement(get_init_stmt().front()) != NULL &&
      isSgNullStatement(what) == NULL) {
    SgStatement *absent = get_init_stmt().front();
    ROSE_ASSERT(absent->get_parent() == this);
    get_init_stmt().clear();
    SageInterface::deleteAST(absent,
                             SageInterface::DeleteAstMode::kRequireIsolated);
  }
  get_init_stmt().push_back(what);
  what->set_parent(this);
}

void SgForInitStatement::prepend_init_stmt(SgStatement *what) {
  if (what == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[for-init-prepend]: cannot prepend a null "
            "initializer statement\n");
    ROSE_ABORT();
  }
  if (get_init_stmt().size() == 1 &&
      isSgNullStatement(get_init_stmt().front()) != NULL &&
      isSgNullStatement(what) == NULL) {
    SgStatement *absent = get_init_stmt().front();
    ROSE_ASSERT(absent->get_parent() == this);
    get_init_stmt().clear();
    SageInterface::deleteAST(absent,
                             SageInterface::DeleteAstMode::kRequireIsolated);
  }
  get_init_stmt().insert(get_init_stmt().begin(), what);
  what->set_parent(this);
}

bool SgForInitStatement::replace_child(SgStatement *target,
                                       SgStatement *newstmt,
                                       bool extractBasicBlock) {
  if (newstmt == NULL && p_init_stmt.size() == 1 &&
      p_init_stmt.front() == target) {
    // Removing the sole initializer changes the loop to the source form
    // `for (; ...; ...)`. Keep that syntactic absence as a typed child at the
    // mutation boundary instead of leaving a malformed empty owner list for a
    // later unparser repair.
    newstmt = SageBuilder::buildNullStatement();
    SageInterface::publishGeneratedSubtreeOutputOwner(newstmt, this);
  }
  return StatementListInsertChild(this, p_init_stmt, target, newstmt, true,
                                  extractBasicBlock, true);
}

bool SgForInitStatement::insert_child(SgStatement *target, SgStatement *newstmt,
                                      bool inFront, bool extractBasicBlock) {
  return StatementListInsertChild(this, p_init_stmt, target, newstmt, inFront,
                                  extractBasicBlock, false);
}

SOURCE_FOR_INIT_STATEMENT_END

SOURCE_FOR_STATEMENT_START

$CLASSNAME::$CLASSNAME(SgForInitStatement *init_stmt, SgStatement *test,
                       SgExpression *increment, SgStatement *loop_body)
    : $BASECLASS(), p_for_init_stmt(init_stmt),
      p_construction_physical_output_owner(nullptr), p_test(test),
      p_condition_value(nullptr), p_increment(increment),
      p_loop_body(loop_body) {
  post_construction_initialization();
}

void SgForStatement::post_construction_initialization() {
  if (p_for_init_stmt == NULL) {
    SgForInitStatement *forInitStatement = NULL;
    if (get_startOfConstruct() != NULL) {
      forInitStatement = new SgForInitStatement(New_File_Info(this));

      forInitStatement->set_endOfConstruct(New_File_Info(this));

      forInitStatement->get_startOfConstruct()->set_parent(forInitStatement);
      forInitStatement->get_endOfConstruct()->set_parent(forInitStatement);
    } else {
      Sg_File_Info *start_fi =
          Sg_File_Info::generateDefaultFileInfoForCompilerGeneratedNode();
      Sg_File_Info *end_fi =
          Sg_File_Info::generateDefaultFileInfoForCompilerGeneratedNode();
      start_fi->setCompilerGenerated();
      end_fi->setCompilerGenerated();
      forInitStatement = new SgForInitStatement(start_fi);
      forInitStatement->set_endOfConstruct(end_fi);
      start_fi->set_parent(forInitStatement);
      end_fi->set_parent(forInitStatement);
    }

    ROSE_ASSERT(forInitStatement != NULL);

    set_for_init_stmt(forInitStatement);
  }

  p_for_init_stmt->set_parent(this);

  if (p_test != NULL) {
    p_test->set_parent(this);
  }

  if (p_increment != NULL) {
    p_increment->set_parent(this);
  }

  if (p_loop_body != NULL) {
    p_loop_body->set_parent(this);
  }
}

SgStatementPtrList &SgForStatement::get_init_stmt() {
  ROSE_ASSERT(p_for_init_stmt != NULL);
  return get_for_init_stmt()->get_init_stmt();
}

const SgStatementPtrList &SgForStatement::get_init_stmt() const {
  ROSE_ASSERT(p_for_init_stmt != NULL);

  return get_for_init_stmt()->get_init_stmt();
}

void SgForStatement::append_init_stmt(SgStatement *what) {
  ROSE_ASSERT(p_for_init_stmt != NULL);
  get_for_init_stmt()->append_init_stmt(what);
}

void SgForStatement::prepend_init_stmt(SgStatement *what) {
  ROSE_ASSERT(p_for_init_stmt != NULL);
  get_for_init_stmt()->prepend_init_stmt(what);
}

bool SgForStatement::replace_child(SgStatement *target, SgStatement *newstmt,
                                   bool extractBasicBlock) {
  if (StatementReplace(this, p_loop_body, target, newstmt) == true)
    return true;
  else if (StatementReplace(this, p_for_init_stmt, target, newstmt) == true)
    return true;
  else if (StatementReplace(this, p_test, target, newstmt) == true)
    return true;
  else
    return false;
}

bool SgForStatement::insert_child(SgStatement *target, SgStatement *newstmt,
                                  bool inFront, bool extractBasicBlock) {
  SgBasicBlock *loop_body = isSgBasicBlock(p_loop_body);
  if (loop_body != NULL) {
    if (StatementListInsertChild(loop_body, loop_body->get_statements(), target,
                                 newstmt, inFront, extractBasicBlock, false)) {
      return true;
    }
  }

  return false;
}

SgExpression *SgForStatement::get_test_expr() const {
  if (isSgNullStatement(p_test) != nullptr ||
      isSgVariableDeclaration(p_test) != nullptr)
    return nullptr;

  SgExprStatement *exprStatement = isSgExprStatement(p_test);
  if (exprStatement == nullptr || exprStatement->get_expression() == nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[for-test-expression]: test=%p/%s is not an "
            "expression statement with a typed expression\n",
            static_cast<void *>(p_test),
            p_test != nullptr ? p_test->class_name().c_str() : "<null>");
    ROSE_ABORT();
  }
  return exprStatement->get_expression();
}

int SgForStatement::replace_expression(SgExpression *original_expression,
                                       SgExpression *new_expression) {
  ROSE_ASSERT(original_expression != NULL);
  ROSE_ASSERT(new_expression != NULL);
  ROSE_ASSERT(original_expression == p_increment);
  ROSE_ASSERT(original_expression->get_parent() == this);

  SageInterface::replaceExpression(original_expression, new_expression, true);
  return 0;
}

SgName SgForStatement::get_mangled_name(void) const { return SgName(""); }

SOURCE_FOR_STATEMENT_END

SOURCE_FORALL_STATEMENT_START

void SgForAllStatement::post_construction_initialization() {
  ROSE_ASSERT(p_forall_header != nullptr && p_body != nullptr);
  ROSE_ASSERT(p_forall_header->get_parent() == nullptr);
  ROSE_ASSERT(p_body->get_parent() == nullptr);
  p_forall_header->set_parent(this);
  p_body->set_parent(this);
}

SOURCE_FORALL_STATEMENT_END

SOURCE_RANGE_BASED_FOR_STATEMENT_START

SgRangeBasedForStatement::SgRangeBasedForStatement(
    SgVariableDeclaration *iterator_declaration,
    SgVariableDeclaration *range_declaration,
    SgVariableDeclaration *begin_declaration,
    SgVariableDeclaration *end_declaration, SgExpression *not_equal_expression,
    SgExpression *increment_expression, SgStatement *loop_body)
    : SgRangeBasedForStatement(nullptr, iterator_declaration, range_declaration,
                               begin_declaration, end_declaration,
                               not_equal_expression, increment_expression,
                               loop_body) {}

SgRangeBasedForStatement::SgRangeBasedForStatement(
    Sg_File_Info *startOfConstruct, SgVariableDeclaration *iterator_declaration,
    SgVariableDeclaration *range_declaration,
    SgVariableDeclaration *begin_declaration,
    SgVariableDeclaration *end_declaration, SgExpression *not_equal_expression,
    SgExpression *increment_expression, SgStatement *loop_body)
    : SgRangeBasedForStatement(startOfConstruct) {
  p_iterator_declaration = iterator_declaration;
  p_range_declaration = range_declaration;
  p_begin_declaration = begin_declaration;
  p_end_declaration = end_declaration;
  p_not_equal_expression = not_equal_expression;
  p_increment_expression = increment_expression;
  p_loop_body = loop_body;
  post_construction_initialization();
}

void SgRangeBasedForStatement::post_construction_initialization() {
  if (p_iterator_declaration != NULL) {
    p_iterator_declaration->set_parent(this);
  }

  if (p_range_declaration != NULL) {
    p_range_declaration->set_parent(this);
  }

  if (p_begin_declaration != NULL) {
    p_begin_declaration->set_parent(this);
  }

  if (p_end_declaration != NULL) {
    p_end_declaration->set_parent(this);
  }

  if (p_not_equal_expression != NULL) {
    p_not_equal_expression->set_parent(this);
  }

  if (p_increment_expression != NULL) {
    p_increment_expression->set_parent(this);
  }

  if (p_loop_body != NULL) {
    p_loop_body->set_parent(this);
  }
}

bool SgRangeBasedForStatement::replace_child(SgStatement *target,
                                             SgStatement *newstmt,
                                             bool extractBasicBlock) {
  if (StatementReplace(this, p_loop_body, target, newstmt) == true)
    return true;
  else if (StatementReplace(this, p_iterator_declaration, target, newstmt) ==
           true)
    return true;
  else if (StatementReplace(this, p_range_declaration, target, newstmt) == true)
    return true;
  else if (StatementReplace(this, p_begin_declaration, target, newstmt) == true)
    return true;
  else if (StatementReplace(this, p_end_declaration, target, newstmt) == true)
    return true;
  else
    return false;
}

int SgRangeBasedForStatement::replace_expression(
    SgExpression *original_expression, SgExpression *new_expression) {
  ROSE_ASSERT(original_expression != NULL);
  ROSE_ASSERT(new_expression != NULL);
  ROSE_ASSERT(original_expression->get_parent() == this);
  ROSE_ASSERT((original_expression == p_not_equal_expression) !=
              (original_expression == p_increment_expression));

  if (original_expression == new_expression)
    return 0;
  SageInterface::replaceExpression(original_expression, new_expression, true);
  markAsModified();
  return 0;
}

SgName SgRangeBasedForStatement::get_mangled_name(void) const {
  return SgName("");
}

SgExpression *SgRangeBasedForStatement::range_expression() {
  // DQ (3/28/2018): Get the range variable (target container, name used for
  // unparser).

  // Note: The container being iterated upon by the range-based for loop is
  // reference through the initializer to the range_declaration.

  SgVariableDeclaration *local_range_declaration = get_range_declaration();
  ROSE_ASSERT(local_range_declaration != NULL);

  SgInitializedName *local_range_variable =
      SageInterface::getFirstInitializedName(local_range_declaration);
  ROSE_ASSERT(local_range_variable != NULL);

  SgInitializer *initializer = local_range_variable->get_initializer();
  ROSE_ASSERT(initializer != NULL);

  // It would be general to support just returning the initializer, since there
  // can be different kinds of initializers used (see test2018_61.C,
  // test2018_63.C, and test2018_64.C).
  return initializer;
}

SOURCE_RANGE_BASED_FOR_STATEMENT_END

SOURCE_STATIC_ASSERTION_DECLARATION_START

void SgStaticAssertionDeclaration::post_construction_initialization() {
  if (p_condition == nullptr || p_condition->get_parent() != nullptr ||
      (p_message != nullptr &&
       (p_message == p_condition || p_message->get_parent() != nullptr))) {
    fprintf(stderr, "REX_AST_INVARIANT[static-assert-construction]: "
                    "condition and optional message require exclusive typed "
                    "ownership\n");
    ROSE_ABORT();
  }
  p_condition->set_parent(this);
  if (p_message != nullptr)
    p_message->set_parent(this);
  validate_static_assertion();
}

void SgStaticAssertionDeclaration::validate_static_assertion() const {
  SgExpression *condition = get_condition();
  if (condition == nullptr || condition->get_parent() != this ||
      condition->get_type() == nullptr ||
      isSgTypeUnknown(condition->get_type()) != nullptr ||
      isSgTypeDefault(condition->get_type()) != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[static-assert-condition]: declaration=%p has "
            "no exactly owned typed condition\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }

  SgExpression *message = get_message();
  if (message != nullptr) {
    SgStringVal *unevaluatedString = isSgStringVal(message);
    const bool syntaxMessage = unevaluatedString != nullptr &&
                               unevaluatedString->get_cxx_unevaluated();
    const bool validSyntaxMessage =
        syntaxMessage && unevaluatedString->get_literal_type() == nullptr;
    const bool validSemanticMessage =
        !syntaxMessage && message->has_semantic_value_type() &&
        message->get_type() != nullptr &&
        isSgTypeUnknown(message->get_type()) == nullptr &&
        isSgTypeDefault(message->get_type()) == nullptr;
    if (message->get_parent() != this ||
        (!validSyntaxMessage && !validSemanticMessage)) {
      fprintf(stderr,
              "REX_AST_INVARIANT[static-assert-message]: declaration has "
              "neither exact unevaluated-string syntax nor an exactly owned "
              "semantic message\n");
      fprintf(stderr,
              "REX_AST_INVARIANT[static-assert-message-detail]: "
              "declaration=%p message=%p parent=%p\n",
              static_cast<const void *>(this), static_cast<void *>(message),
              static_cast<void *>(message->get_parent()));
      ROSE_ABORT();
    }
    if (validSyntaxMessage) {
      unevaluatedString->validate_cxx_literal_state();
    }
  }
}

SgName SgStaticAssertionDeclaration::get_mangled_name() const {
  return "static_assertion";
}

bool SgStaticAssertionDeclaration::hasExplicitScope() const { return false; }

SOURCE_STATIC_ASSERTION_DECLARATION_END

SOURCE_FRIEND_TYPE_DECLARATION_START

void SgFriendTypeDeclaration::post_construction_initialization() {}

SgName SgFriendTypeDeclaration::get_mangled_name() const {
  return "friend_type_declaration";
}

bool SgFriendTypeDeclaration::hasExplicitScope() const { return false; }

SOURCE_FRIEND_TYPE_DECLARATION_END

SOURCE_FUNCTION_PARAMETER_SCOPE_START

void SgFunctionParameterScope::post_construction_initialization() {
  p_construction_physical_output_owner = NULL;
  p_construction_semantic_scope = NULL;
  p_completed_semantic_scope = NULL;
}

SgName SgFunctionParameterScope::get_mangled_name(void) const {
  // PP (06/01/20) - just return some name
  // (or should the name be composed form the parent declaration?)
  return SgName("__function_parameter_scope__");
}

SgScopeStatement *SgFunctionParameterScope::get_scope(void) const {
  SgScopeStatement *physicalOwner = get_construction_physical_output_owner();
  SgScopeStatement *semanticScope = get_construction_semantic_scope();
  SgScopeStatement *completedSemanticScope = get_completed_semantic_scope();
  if (get_parent() == NULL) {
    if (physicalOwner == NULL || semanticScope == NULL ||
        physicalOwner == this || semanticScope == this ||
        completedSemanticScope != NULL) {
      fprintf(stderr,
              "REX_AST_INVARIANT[detached-parameter-semantic-scope]: "
              "scope=%p physical-owner=%p semantic-scope=%p does not form "
              "one exact detached construction transaction\n",
              static_cast<const void *>(this),
              static_cast<void *>(physicalOwner),
              static_cast<void *>(semanticScope));
      ROSE_ABORT();
    }
    return semanticScope;
  }

  SgFunctionDeclaration *declaration = isSgFunctionDeclaration(get_parent());
  SgRequiresExpr *requiresExpression = isSgRequiresExpr(get_parent());
  SgFunctionParameterTypeList *prototype =
      isSgFunctionParameterTypeList(get_parent());
  if (prototype != nullptr) {
    ROSE_ASSERT(prototype->get_source_parameter_scope() == this);
    ROSE_ASSERT(prototype->get_source_parameters() != nullptr);
    ROSE_ASSERT(prototype->get_source_parameters()->get_parent() == prototype);
    ROSE_ASSERT(physicalOwner == nullptr && semanticScope == nullptr);
    ROSE_ASSERT(completedSemanticScope != nullptr && completedSemanticScope != this);
    return completedSemanticScope;
  }
  const bool completedFunctionOwner =
      declaration != NULL && declaration->get_functionParameterScope() == this;
  const bool completedRequiresOwner =
      requiresExpression != NULL &&
      requiresExpression->get_local_parameter_scope() == this &&
      requiresExpression->get_local_parameter_list() != NULL &&
      requiresExpression->get_local_parameter_list()->get_parent() ==
          requiresExpression;
  if (physicalOwner != NULL || semanticScope != NULL ||
      completedFunctionOwner == completedRequiresOwner) {
    fprintf(
        stderr,
        "REX_AST_INVARIANT[attached-parameter-semantic-scope]: scope=%p "
        "parent=%p/%s physical-owner=%p semantic-scope=%p completed-scope=%p "
        "function-owner=%d requires-owner=%d is not exactly owned by "
        "one completed declarative region\n",
        static_cast<const void *>(this), static_cast<void *>(get_parent()),
        get_parent() != NULL ? get_parent()->class_name().c_str() : "<null>",
        static_cast<void *>(physicalOwner), static_cast<void *>(semanticScope),
        static_cast<void *>(completedSemanticScope),
        completedFunctionOwner ? 1 : 0, completedRequiresOwner ? 1 : 0);
    ROSE_ABORT();
  }
  if (completedFunctionOwner) {
    if (completedSemanticScope != NULL || declaration->get_scope() == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[attached-parameter-semantic-scope]: "
              "scope=%p function=%p has completed-scope=%p or recursively "
              "owns itself\n",
              static_cast<const void *>(this), static_cast<void *>(declaration),
              static_cast<void *>(completedSemanticScope));
      ROSE_ABORT();
    }
    return declaration->get_scope();
  }
  if (completedSemanticScope == NULL || completedSemanticScope == this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attached-parameter-semantic-scope]: "
            "requires-parameter scope=%p has invalid completed-scope=%p\n",
            static_cast<const void *>(this),
            static_cast<void *>(completedSemanticScope));
    ROSE_ABORT();
  }
  return completedSemanticScope;
}

void SgFunctionParameterScope::append_declaration(
    SgDeclarationStatement *what) {
  get_declarations().push_back(what);
  what->set_parent(this);
}

void SgFunctionParameterScope::prepend_declaration(
    SgDeclarationStatement *what) {
  get_declarations().insert(get_declarations().begin(), what);
  what->set_parent(this);
}

bool SgFunctionParameterScope::insert_child(SgStatement *target,
                                            SgStatement *newstmt, bool inFront,
                                            bool extractBasicBlock) {
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  inFront, extractBasicBlock, false);
}

bool SgFunctionParameterScope::replace_child(SgStatement *target,
                                             SgStatement *newstmt,
                                             bool extractBasicBlock) {
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  true, extractBasicBlock, true);
}

SOURCE_FUNCTION_PARAMETER_SCOPE_END

SOURCE_DECLARATION_SCOPE_START

void SgDeclarationScope::post_construction_initialization() {
  ROSE_ASSERT(p_semantic_outer_scope == nullptr ||
              (p_semantic_outer_scope != this &&
               SgNode::isLiveNode(p_semantic_outer_scope)));
}

SgScopeStatement *SgDeclarationScope::get_scope() const {
  if (p_semantic_outer_scope != nullptr)
    return p_semantic_outer_scope;
  if (auto *owner = isSgInitializedName(get_parent())) {
    ROSE_ASSERT(owner->get_structured_binding_scope() == this &&
                owner->get_scope() != this);
    return owner->get_scope();
  }
  return SgStatement::get_scope();
}

SgName SgDeclarationScope::get_mangled_name(void) const {
  if (p_semantic_outer_scope != nullptr)
    return p_semantic_outer_scope->get_mangled_name() +
           SgName("__declaration_scope__");
  if (auto *owner = isSgInitializedName(get_parent())) {
    ROSE_ASSERT(owner->get_structured_binding_scope() == this);
    return owner->get_mangled_name() + SgName("__declaration_scope__");
  }
  // Use the owning declaration's mangled name when available so that
  // declaration scopes are stable and distinguishable in name mangling.
  if (SgDeclarationStatement *decl = isSgDeclarationStatement(get_parent())) {
    return decl->get_mangled_name() + SgName("__declaration_scope__");
  }
  if (const SgScopeStatement *scope = isSgScopeStatement(get_parent())) {
    return scope->get_mangled_name() + SgName("__declaration_scope__");
  }

  return SgName("__declaration_scope__");
}

SgName SgDeclarationScope::get_qualified_name() const {
  if (p_semantic_outer_scope != nullptr)
    return p_semantic_outer_scope->get_qualified_name();
  if (auto *owner = isSgInitializedName(get_parent())) {
    ROSE_ASSERT(owner->get_structured_binding_scope() == this &&
                owner->get_scope() != nullptr);
    return owner->get_scope()->get_qualified_name();
  }
  SgNode *p = get_parent();
  if (SgTemplateFunctionDeclaration *tplfn =
          isSgTemplateFunctionDeclaration(p)) {
    return tplfn->get_qualified_name();
  } else if (SgTemplateClassDeclaration *tplclass =
                 isSgTemplateClassDeclaration(p)) {
    return tplclass->get_qualified_name();
  } else if (SgTemplateTypedefDeclaration *tpltypedef =
                 isSgTemplateTypedefDeclaration(p)) {
    return tpltypedef->get_qualified_name();
  } else if (SgTemplateDeclaration *tpldecl = isSgTemplateDeclaration(p)) {
    return tpldecl->get_qualified_name();
  } else if (SgNonrealDecl *nrdecl = isSgNonrealDecl(p)) {
    return nrdecl->get_qualified_name();
  } else if (SgClassDeclaration *cdecl = isSgClassDeclaration(p)) {
    return cdecl->get_qualified_name();
  } else if (SgMemberFunctionDeclaration *mfdecl =
                 isSgMemberFunctionDeclaration(p)) {
    return mfdecl->get_qualified_name();
  } else if (SgFunctionDeclaration *fdecl = isSgFunctionDeclaration(p)) {
    return fdecl->get_qualified_name();
  } else if (SgTypedefDeclaration *tdef = isSgTypedefDeclaration(p)) {
    return tdef->get_qualified_name();
  } else if (SgEnumDeclaration *edecl = isSgEnumDeclaration(p)) {
    return edecl->get_qualified_name();
  } else if (SgNamespaceDeclarationStatement *ndecl =
                 isSgNamespaceDeclarationStatement(p)) {
    return ndecl->get_qualified_name();
  } else if (SgScopeStatement *scope = isSgScopeStatement(p)) {
    return scope->get_qualified_name();
  }

  std::string globalScopeDelimiter = "";
  return SgName(globalScopeDelimiter);
}

void SgDeclarationScope::append_declaration(SgDeclarationStatement *what) {
  if (what == NULL)
    return;

  get_declarations().push_back(what);
  what->set_scope(this);
  what->set_parent(this);
}

void SgDeclarationScope::prepend_declaration(SgDeclarationStatement *what) {
  if (what == NULL)
    return;

  get_declarations().insert(get_declarations().begin(), what);
  what->set_scope(this);
  what->set_parent(this);
}

void SgDeclarationScope::setChildScope(SgStatement *newstmt,
                                       bool extractBasicBlock) {
  if (SgDeclarationStatement *decl = isSgDeclarationStatement(newstmt)) {
    decl->set_scope(this);
    return;
  }

  if (!extractBasicBlock) {
    return;
  }

  if (SgBasicBlock *bb = isSgBasicBlock(newstmt)) {
    const SgStatementPtrList &stmts = bb->get_statements();
    for (SgStatementPtrList::const_iterator it = stmts.begin();
         it != stmts.end(); ++it) {
      if (SgDeclarationStatement *decl_in_bb = isSgDeclarationStatement(*it)) {
        decl_in_bb->set_scope(this);
      }
    }
  }
}

bool SgDeclarationScope::insert_child(SgStatement *target, SgStatement *newstmt,
                                      bool inFront, bool extractBasicBlock) {
  setChildScope(newstmt, extractBasicBlock);
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  inFront, extractBasicBlock, false);
}

bool SgDeclarationScope::replace_child(SgStatement *target,
                                       SgStatement *newstmt,
                                       bool extractBasicBlock) {
  setChildScope(newstmt, extractBasicBlock);
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  true, extractBasicBlock, true);
}

SOURCE_DECLARATION_SCOPE_END

SOURCE_FUNCTION_DECLARATION_STATEMENT_START

SgFunctionDeclaration::frontend_source_ownership_enum
SgFunctionDeclaration::get_frontend_source_ownership() const {
  return p_frontend_source_ownership;
}

SgFunctionDeclaration::frontend_declaration_origin_enum
SgFunctionDeclaration::get_frontend_declaration_origin() const {
  return p_frontend_declaration_origin;
}

void SgFunctionDeclaration::initialize_frontend_source_ownership(
    frontend_source_ownership_enum ownership) {
  if (ownership <= e_frontend_source_unclassified ||
      ownership > e_frontend_source_implicit) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-frontend-source-ownership]: "
            "function=%p type=%s name=%s cannot publish invalid ownership=%d\n",
            static_cast<void *>(this), class_name().c_str(),
            get_name().getString().c_str(), static_cast<int>(ownership));
    ROSE_ABORT();
  }
  if (p_frontend_source_ownership != e_frontend_source_unclassified) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-frontend-source-ownership]: "
            "function=%p type=%s name=%s cannot replace ownership=%d with %d\n",
            static_cast<void *>(this), class_name().c_str(),
            get_name().getString().c_str(),
            static_cast<int>(p_frontend_source_ownership),
            static_cast<int>(ownership));
    ROSE_ABORT();
  }
  p_frontend_source_ownership = ownership;
}

void SgFunctionDeclaration::initialize_frontend_declaration_origin(
    frontend_declaration_origin_enum origin) {
  if (origin <= e_frontend_declaration_unclassified ||
      origin > e_frontend_declaration_implicit) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-frontend-declaration-origin]: "
            "function=%p type=%s name=%s cannot publish invalid origin=%d\n",
            static_cast<void *>(this), class_name().c_str(),
            get_name().getString().c_str(), static_cast<int>(origin));
    ROSE_ABORT();
  }
  if (p_frontend_declaration_origin != e_frontend_declaration_unclassified) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-frontend-declaration-origin]: "
            "function=%p type=%s name=%s cannot replace origin=%d with %d\n",
            static_cast<void *>(this), class_name().c_str(),
            get_name().getString().c_str(),
            static_cast<int>(p_frontend_declaration_origin),
            static_cast<int>(origin));
    ROSE_ABORT();
  }
  p_frontend_declaration_origin = origin;
}

const SgName &
SgFunctionDeclaration::get_fortran_anonymous_program_unit_symbol_key() const {
  return p_fortran_anonymous_program_unit_symbol_key;
}

void SgFunctionDeclaration::
    initialize_fortran_anonymous_program_unit_symbol_key(const SgName &key) {
  const SgProgramHeaderStatement *program = isSgProgramHeaderStatement(this);
  const bool anonymous_program =
      program != nullptr &&
      program->get_program_statement_kind() ==
          SgProgramHeaderStatement::e_implicit_program_statement;
  const SgProcedureHeaderStatement *procedure =
      isSgProcedureHeaderStatement(this);
  const bool unnamed_block_data =
      procedure != nullptr && procedure->isBlockData() &&
      procedure->get_block_data_name_kind() ==
          SgProcedureHeaderStatement::e_unnamed_block_data;
  const std::string key_string = key.getString();
  const std::string required_prefix =
      anonymous_program ? "__rex_internal_implicit_program_"
                        : "__rex_internal_unnamed_block_data_";
  if ((!anonymous_program && !unnamed_block_data) || key.is_null() ||
      !get_name().is_null() || key_string.rfind(required_prefix, 0) != 0) {
    fprintf(stderr,
            "REX_AST_INVARIANT[anonymous-program-unit-symbol-key]: "
            "declaration=%p type=%s cannot initialize key='%s' for its "
            "typed source identity\n",
            static_cast<void *>(this), class_name().c_str(),
            key_string.c_str());
    ROSE_ABORT();
  }
  if (!p_fortran_anonymous_program_unit_symbol_key.is_null()) {
    const std::string current_key =
        p_fortran_anonymous_program_unit_symbol_key.getString();
    fprintf(stderr,
            "REX_AST_INVARIANT[anonymous-program-unit-symbol-key]: "
            "declaration=%p type=%s cannot replace key='%s' with '%s'\n",
            static_cast<void *>(this), class_name().c_str(),
            current_key.c_str(), key_string.c_str());
    ROSE_ABORT();
  }
  p_fortran_anonymous_program_unit_symbol_key = key;
}

void SgFunctionDeclaration::post_construction_initialization() {

  ROSE_ASSERT(p_type == nullptr || p_declared_exception_signature != nullptr ||
              p_type->get_exception_specification_kind() ==
                  SgFunctionType::e_exception_none);
  if (p_declared_exception_signature != nullptr) {
    ASSERT_not_null(p_type);
    ROSE_ASSERT(p_declared_exception_signature->get_semantic_signature() ==
                p_type);
    ROSE_ASSERT(p_declared_exception_signature != p_type);
    ROSE_ASSERT(p_declared_exception_signature->get_parent() == nullptr);
    ROSE_ASSERT(p_declared_exception_signature->get_return_type() ==
                p_type->get_return_type());
    ROSE_ASSERT(p_declared_exception_signature->get_arguments() ==
                p_type->get_arguments());
    ROSE_ASSERT(p_declared_exception_signature->variantT() ==
                p_type->variantT());
    if (auto *member = isSgMemberFunctionType(p_type)) {
      auto *declared = isSgMemberFunctionType(p_declared_exception_signature);
      ASSERT_not_null(declared);
      ROSE_ASSERT(declared->get_class_type() == member->get_class_type());
      ROSE_ASSERT(declared->get_mfunc_specifier() ==
                  member->get_mfunc_specifier());
    }
    p_declared_exception_signature->set_parent(this);
    // Preserve the public isThrow() query; emission uses the typed signature.
    switch (
        p_declared_exception_signature->get_exception_specification_kind()) {
    case SgFunctionType::e_exception_dynamic_none:
    case SgFunctionType::e_exception_dynamic:
    case SgFunctionType::e_exception_ms_any:
      get_declarationModifier().setThrow();
      break;
    default:
      break;
    }
    if (p_declared_exception_signature
            ->get_exception_specification_source_is_self())
      ROSE_ASSERT(p_declared_exception_signature
                      ->get_exception_specification_source() == this);
  }

  // Every function owns a canonical parameter list, including empty lists.
  // Copy source positions independently when the constructor supplies them.
  SgFunctionParameterList *args = NULL;
  if (get_startOfConstruct() != NULL) {
    args = new SgFunctionParameterList(New_File_Info(this));
    args->get_startOfConstruct()->set_parent(args);
  } else {
    args = new SgFunctionParameterList();
  }
  ROSE_ASSERT(args != NULL);
  set_parameterList(args);

  get_parameterList()->set_parent(this);

  ROSE_ASSERT(args->get_firstNondefiningDeclaration() == args);

  p_sourceSpelledTemplateHeaders.clear();

  p_name_qualification_length = 0;
  p_type_elaboration_required = false;
  p_global_qualification_required = false;

  p_name_qualification_length_for_return_type = 0;
  p_type_elaboration_required_for_return_type = false;
  p_global_qualification_required_for_return_type = false;
}

SgType *SgFunctionDeclaration::get_orig_return_type() const {
  // PP (9/16/25): store the original return type with type_syntax.
  //               if nullptr, take it from type.
  SgFunctionType *fntype = this->get_type_syntax();

  if (fntype == nullptr)
    fntype = this->get_type();

  ASSERT_not_null(fntype);
  return fntype->get_return_type();
}

void SgFunctionDeclaration::validate_source_declarator_form() const {
  if (!get_source_declarator_uses_wrapped_function_type()) {
    return;
  }

  SgFunctionType *syntax_type = get_type_syntax();
  SgType *source_type =
      syntax_type != nullptr ? syntax_type->get_return_type() : nullptr;
  SgTypedefType *source_typedef = isSgTypedefType(source_type);
  const bool exact_wrapped_function_type =
      isSgTypeOfType(source_type) != nullptr ||
      (source_typedef != nullptr &&
       isSgFunctionType(source_typedef->get_base_type()) != nullptr);
  if (!get_type_syntax_is_available() || syntax_type == nullptr ||
      syntax_type == get_type() || syntax_type->get_parent() != this ||
      !exact_wrapped_function_type || get_parameterList_syntax() != nullptr ||
      get_oldStyleDefinition() || get_prototypeIsWithoutParameters()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-declarator-source-form]: "
            "function=%p name=%s claims a wrapped function declarator "
            "without one exact source syntax (syntax=%p source-type=%p "
            "parameter-syntax=%p old-style=%d parameterless-prototype=%d)\n",
            static_cast<const void *>(this), get_name().str(),
            static_cast<void *>(syntax_type), static_cast<void *>(source_type),
            static_cast<void *>(get_parameterList_syntax()),
            get_oldStyleDefinition() ? 1 : 0,
            get_prototypeIsWithoutParameters() ? 1 : 0);
    ROSE_ABORT();
  }
}

void SgFunctionDeclaration::validate_explicit_specifier() const {
  SgExpression *condition = get_explicit_specifier_expression();
  if (condition == nullptr && !get_functionModifier().isExplicit())
    return;
  ROSE_ASSERT(get_specialFunctionModifier().isConstructor() ||
              get_specialFunctionModifier().isConversion() ||
              get_is_deduction_guide());
  ROSE_ASSERT(condition == nullptr || condition->get_parent() == this);
}

bool SgFunctionDeclaration::cuda_launch_bounds_operands_are_valid(
    SgExpression *expression) {
  auto valid_operand = [](SgExpression *operand) {
    return operand != nullptr && isSgExprListExp(operand) == nullptr &&
           !SageInterface::containsUnknownType(operand->get_type());
  };
  if (auto *arguments = isSgExprListExp(expression)) {
    const auto &operands = arguments->get_expressions();
    if (operands.empty() || operands.size() > 3)
      return false;
    for (auto *operand : operands)
      if (!valid_operand(operand) || operand->get_parent() != arguments ||
          std::count(operands.begin(), operands.end(), operand) != 1)
        return false;
    return true;
  }
  return expression == nullptr || valid_operand(expression);
}

void SgFunctionDeclaration::validate_cuda_launch_bounds_expression() const {
  SgExpression *expression = get_cuda_launch_bounds_expression();
  if (expression == nullptr) {
    return;
  }
  if (expression->get_parent() != this ||
      !cuda_launch_bounds_operands_are_valid(expression)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[cuda-launch-bounds]: function=%p has a launch "
            "bounds expression without exact ownership and semantic type\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
}

void SgFunctionDeclaration::append_arg(SgInitializedName *what) {
  ROSE_ASSERT(get_parameterList() != NULL);

  get_parameterList()->append_arg(what);
}

void SgFunctionDeclaration::prepend_arg(SgInitializedName *what) {
  ROSE_ASSERT(get_parameterList() != NULL);

  get_parameterList()->prepend_arg(what);
}

SgInitializedNamePtrList &SgFunctionDeclaration::get_args() {
  ROSE_ASSERT(get_parameterList() != NULL);

  return get_parameterList()->get_args();
}

const SgInitializedNamePtrList &SgFunctionDeclaration::get_args() const {
  ROSE_ASSERT(get_parameterList() != NULL);
  return get_parameterList()->get_args();
}

bool SgFunctionDeclaration::isTemplateFunction() const {
  if (const auto *templateFunction =
          isSgTemplateInstantiationFunctionDecl(this)) {
    ROSE_ASSERT(templateFunction->get_templateDeclaration() != NULL);
    return true;
  }

  if (const auto *memberFunction =
          isSgTemplateInstantiationMemberFunctionDecl(this)) {
    // A member of a class-template instantiation is not necessarily a template.
    const auto *primary = memberFunction->get_templateDeclaration();
    return primary != nullptr && !primary->get_templateParameters().empty();
  }

  return false;
}

SgName SgFunctionDeclaration::get_mangled_name() const {
  std::string mangledNameString = SageInterface::getMangledNameFromCache(
      const_cast<SgFunctionDeclaration *>(this));
  if (mangledNameString.empty() == false) {
    return mangledNameString;
  } else {
    SgName mangledName;

    // Compute a mangled name from this function's type
    SgName type_name;
    SgName ret_type_name;
    SgFunctionType const *func_type = get_type();
    ASSERT_not_null(func_type);
    SgType *ret_type = this->get_orig_return_type();
    ASSERT_not_null(ret_type);
    ret_type_name = ret_type->get_mangled();
    type_name =
        SgFunctionType::get_mangled(ret_type, func_type->get_argument_list());

    // This function's name, transformed.
    SgName func_name = mangleFunctionName(get_name(), ret_type_name);
    // Compute the name qualification, if any.
    const SgScopeStatement *par_scope = get_scope();
    SgName scope_name = mangleQualifiers(par_scope);

    // Compute the translation unit qualification, if any.
    string xlation_unit_qual = mangleTranslationUnitQualifiers(this);

    // Compute the final mangled name.
    mangledName = joinMangledQualifiers(
        scope_name, xlation_unit_qual + func_name + "__" + type_name);
    const SgExpression *templateConstraint = NULL;
    if (const SgTemplateFunctionDeclaration *templateFunction =
            isSgTemplateFunctionDeclaration(this)) {
      templateConstraint = templateFunction->get_requiresClause();
    } else if (const SgTemplateMemberFunctionDeclaration *templateMember =
                   isSgTemplateMemberFunctionDeclaration(this)) {
      templateConstraint = templateMember->get_requiresClause();
    }
    if (templateConstraint != NULL) {
      mangledName +=
          "__template_requires_" + mangleExpression(templateConstraint);
    }
    const SgExpression *constraint = get_trailingRequiresClause();
    if (constraint == NULL) {
      SgFunctionDeclaration *templatePattern = NULL;
      if (const SgTemplateInstantiationFunctionDecl *instantiation =
              isSgTemplateInstantiationFunctionDecl(this)) {
        templatePattern =
            isSgFunctionDeclaration(instantiation->get_templateDeclaration());
      } else if (const SgTemplateInstantiationMemberFunctionDecl
                     *instantiation =
                         isSgTemplateInstantiationMemberFunctionDecl(this)) {
        templatePattern =
            isSgFunctionDeclaration(instantiation->get_templateDeclaration());
      }
      if (templatePattern != NULL) {
        constraint = templatePattern->get_trailingRequiresClause();
      }
    }
    if (constraint != NULL) {
      mangledName += "__requires_" + mangleExpression(constraint);
    }

    mangledName = SageInterface::addMangledNameToCache(
        const_cast<SgFunctionDeclaration *>(this), mangledName);
    ROSE_ASSERT(mangledName.getString().find('<') == string::npos);

    return mangledName;
  }
}

bool SgFunctionDeclaration::replace_child(SgStatement *target,
                                          SgStatement *newstmt,
                                          bool extractBasicBlock) {
  if (StatementReplace(this, p_definition, target, newstmt) == true)
    return true;
  else
    return (StatementReplace(this, p_parameterList, target, newstmt) == true);
}

SgName SgFunctionDeclaration::get_qualified_name() const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  SgName returnName =
      SgName::assembleQualifiedName(scope->get_qualified_name(), get_name());
  return returnName;
}

bool SgFunctionDeclaration::hasExplicitScope() const {
  return true;
}

SgName SgFunctionDeclaration::get_symbol_table_key() const {
  return isSgProgramHeaderStatement(this) != nullptr ||
                 isSgProcedureHeaderStatement(this) != nullptr
             ? SageInterface::getFortranProgramUnitSymbolTableKey(this)
             : get_name();
}

SgSymbol *SgFunctionDeclaration::get_symbol_from_symbol_table() const {
  SgFunctionDeclaration *canonical =
      isSgFunctionDeclaration(get_firstNondefiningDeclaration());
  // A semantic-only definition has no separate first declaration.
  if (get_firstNondefiningDeclaration() == nullptr &&
      get_definingDeclaration() == this && get_definition() != nullptr) {
    canonical = const_cast<SgFunctionDeclaration *>(this);
  }
  SgScopeStatement *scope =
      canonical != nullptr ? canonical->get_scope() : nullptr;
  if (canonical == nullptr ||
      (canonical != this &&
       canonical->get_firstNondefiningDeclaration() != canonical) ||
      scope == nullptr || !SgNode::isLiveNode(scope)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-symbol-identity]: declaration=%p "
            "has no live canonical first nondefining function declaration\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  return scope->find_symbol_from_declaration(canonical);
}

