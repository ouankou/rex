enum constexpr_specifier_enum {
  e_constexpr_unspecified = 0,
  e_constexpr = 1,
  e_consteval = 2
};

bool get_is_constexpr() const {
  ROSE_ASSERT(p_constexpr_specifier >= e_constexpr_unspecified &&
              p_constexpr_specifier <= e_consteval);
  return p_constexpr_specifier != e_constexpr_unspecified;
}

// Exact frontend producer ownership for a function declaration.  This is
// intentionally independent of Sg_File_Info: semantic-only declarations have
// no lexical/output source position, but analyses still need to distinguish a
// callable originating in user source from a system, module, or frontend
// support declaration.
enum frontend_source_ownership_enum {
  e_frontend_source_unclassified = 0,
  e_frontend_source_main_file,
  e_frontend_source_application_header,
  e_frontend_source_system_header,
  e_frontend_source_external,
  e_frontend_source_support,
  e_frontend_source_pseudo_file,
  e_frontend_source_implicit
};

enum frontend_declaration_origin_enum {
  e_frontend_declaration_unclassified = 0,
  e_frontend_declaration_explicit,
  e_frontend_declaration_implicit
};

// Exact elaboration keyword written at this declaration's return-type use
// site.  A boolean cannot distinguish `typename`, `class`, `struct`, `union`,
// and `enum`, and the shared semantic SgType cannot own declaration-local
// source spelling.
enum source_return_type_elaboration_kind_enum {
  e_source_return_type_elaboration_unspecified = 0,
  e_source_return_type_elaboration_none,
  e_source_return_type_elaboration_typename,
  e_source_return_type_elaboration_class,
  e_source_return_type_elaboration_struct,
  e_source_return_type_elaboration_union,
  e_source_return_type_elaboration_enum
};

frontend_source_ownership_enum get_frontend_source_ownership() const;
void initialize_frontend_source_ownership(
    frontend_source_ownership_enum ownership);
frontend_declaration_origin_enum get_frontend_declaration_origin() const;
