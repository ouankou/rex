SOURCE_MAIN_STATEMENT_START

SgSymbol *SgStatement::get_symbol_from_symbol_table() const {
  printf("Error: virtual function SgStatement::get_symbol_from_symbol_table() "
         "called on base class SgStatement = %p = %s \n",
         this, this->class_name().c_str());
  ROSE_ABORT();
}

void SgStatement::remove_statement(SgStatement *target) {
  bool r = replace_child(target, 0);
  ROSE_ASSERT(r);
}

//! Insert newstmt before or after the target statement, which should be a child
//! statement of this statement
void SgStatement::insert_statement(SgStatement *target, SgStatement *newstmt,
                                   bool inFront) {

  bool r = insert_child(target, newstmt, inFront, false);
  ROSE_ASSERT(r);
}

void SgStatement::insert_statement(SgStatement *target,
                                   const SgStatementPtrList &newstmtList,
                                   bool inFront) {

  SgBasicBlock *tmp = new SgBasicBlock();
  std::set<SgStatement *> adopted;
  for (SgStatement *statement : newstmtList) {
    if (statement == NULL || statement->get_parent() != NULL ||
        !adopted.insert(statement).second) {
      fprintf(stderr,
              "REX_AST_INVARIANT[basic-block-extraction-producer]: insert "
              "list must contain unique unowned statements\n");
      ROSE_ABORT();
    }
    tmp->get_statements().push_back(statement);
    statement->set_parent(tmp);
  }
  bool r = insert_child(target, tmp, inFront, true);
  ROSE_ASSERT(r);
}

void SgStatement::replace_statement(SgStatement *target, SgStatement *newstmt) {
  ROSE_ASSERT(newstmt != NULL);
  ROSE_ASSERT(target != NULL);
  ROSE_ASSERT(target->get_parent() != NULL);
  bool r = replace_child(target, newstmt, false);
  ROSE_ASSERT(r);
}

void SgStatement::replace_statement(SgStatement *target,
                                    const SgStatementPtrList &newstmtList) {
  SgBasicBlock *tmp = new SgBasicBlock();
  std::set<SgStatement *> adopted;
  for (SgStatement *statement : newstmtList) {
    if (statement == NULL || statement->get_parent() != NULL ||
        !adopted.insert(statement).second) {
      fprintf(stderr,
              "REX_AST_INVARIANT[basic-block-extraction-producer]: replace "
              "list must contain unique unowned statements\n");
      ROSE_ABORT();
    }
    tmp->get_statements().push_back(statement);
    statement->set_parent(tmp);
  }
  bool r = replace_child(target, tmp, true);
  ROSE_ASSERT(r);
}

// if newstmt is a basicBlock, statements inside newstmt are extracted and then
// inserted
void SgStatement::insert_statement_from_basicBlock(SgStatement *target,
                                                   SgStatement *newstmt,
                                                   bool inFront) {

  bool r = insert_child(target, newstmt, inFront, true);
  ROSE_ASSERT(r);
}

void SgStatement::post_construction_initialization() {}

// DQ (12/5/2004): Support for setting scopes (only meaningful on IR statements
// that store the scope explicitly)
void SgStatement::set_scope(SgScopeStatement *newScope) {
  if (!hasExplicitScope()) {
    SgScopeStatement *structural_scope = get_scope();
    if (newScope == NULL || structural_scope != newScope) {
      fprintf(stderr,
              "REX_AST_INVARIANT[statement-scope-update]: statement=%p "
              "type=%s cannot change its derived structural scope from %p "
              "to %p\n",
              static_cast<void *>(this), class_name().c_str(),
              static_cast<void *>(structural_scope),
              static_cast<void *>(newScope));
      ROSE_ABORT();
    }
    return;
  }

  fprintf(stderr,
          "REX_AST_INVARIANT[statement-scope-dispatch]: statement=%p "
          "type=%s claims an explicit scope but dispatched its update to the "
          "non-storing base setter\n",
          static_cast<void *>(this), class_name().c_str());
  ROSE_ABORT();
}

bool SgStatement::hasExplicitScope() const {
  return false;
}

SgScopeStatement *SgDeclarationStatement::get_scope(void) const {

  if (SgDeclarationGroupStatement *group =
          isSgDeclarationGroupStatement(get_parent())) {
    const SgDeclarationStatementPtrList &members = group->get_declarations();
    if (std::count(members.begin(), members.end(), this) != 1 ||
        group->get_scope() == NULL) {
      fprintf(stderr,
              "REX_AST_INVARIANT[declaration-group-member-scope]: group=%p "
              "does not own declaration=%p exactly once with a scope\n",
              static_cast<void *>(group), static_cast<const void *>(this));
      ROSE_ABORT();
    }
    return group->get_scope();
  }

  if (SgAuxiliaryDeclarationList *container =
          isSgAuxiliaryDeclarationList(get_parent())) {
    SgScopeStatement *owner = isSgScopeStatement(container->get_parent());
    const SgDeclarationStatementPtrList &declarations =
        container->get_declarations();
    if (owner == NULL || owner->get_auxiliary_declarations() != container ||
        std::count(declarations.begin(), declarations.end(), this) != 1) {
      fprintf(stderr,
              "REX_AST_INVARIANT[auxiliary-declaration-scope]: "
              "declaration=%p type=%s has malformed auxiliary ownership\n",
              static_cast<const void *>(this), class_name().c_str());
      ROSE_ABORT();
    }
    return owner;
  }

  if (SgDeclarationScope *declScope = get_declarationScope()) {
    return declScope;
  }

  return SgStatement::get_scope();
}

void SgDeclarationStatement::set_scope(SgScopeStatement *newScope) {

  if (!hasExplicitScope()) {
    if (get_declarationScope() != NULL) {
      fprintf(stderr,
              "REX_AST_INVARIANT[declaration-structural-scope-state]: "
              "declaration=%p type=%s claims structural scope but stores "
              "declaration-scope=%p\n",
              static_cast<void *>(this), class_name().c_str(),
              static_cast<void *>(get_declarationScope()));
      ROSE_ABORT();
    }
    // A structurally scoped declaration must never acquire hidden semantic
    // state merely because its exact structural owner also happens to be an
    // SgDeclarationScope. Validate the already-published parent edge only.
    SgStatement::set_scope(newScope);
    return;
  }

  if (SgDeclarationScope *declScope = isSgDeclarationScope(newScope)) {
    set_declarationScope(declScope);
    return;
  }

  fprintf(stderr,
          "REX_AST_INVARIANT[declaration-explicit-scope-kind]: declaration=%p "
          "type=%s requires an explicit SgDeclarationScope, got %p/%s\n",
          static_cast<void *>(this), class_name().c_str(),
          static_cast<void *>(newScope),
          newScope != NULL ? newScope->class_name().c_str() : "<null>");
  ROSE_ABORT();
}

bool SgStatement::replace_child(SgStatement *target, SgStatement *newstmt,
                                bool extractListFromBasicBlock) {
  fprintf(stderr,
          "REX_AST_INVARIANT[statement-replace-child]: %s has no typed "
          "replacement for target=%p new=%p extract-list=%d\n",
          class_name().c_str(), static_cast<void *>(target),
          static_cast<void *>(newstmt), extractListFromBasicBlock ? 1 : 0);
  ROSE_ABORT();
}

bool SgStatement::insert_child(SgStatement *target, SgStatement *newstmt,
                               bool inFront, bool extractListFromBasicBlock) {
  fprintf(
      stderr,
      "REX_AST_INVARIANT[statement-insert-child]: %s has no typed insertion "
      "for target=%p new=%p before=%d extract-list=%d\n",
      class_name().c_str(), static_cast<void *>(target),
      static_cast<void *>(newstmt), inFront ? 1 : 0,
      extractListFromBasicBlock ? 1 : 0);
  ROSE_ABORT();
}

int SgStatement::replace_expression(SgExpression *original_expression,
                                    SgExpression *new_expression) {
  fprintf(stderr,
          "REX_AST_INVARIANT[statement-replace-expression]: %s has no typed "
          "replacement for original=%p new=%p\n",
          class_name().c_str(), static_cast<void *>(original_expression),
          static_cast<void *>(new_expression));
  ROSE_ABORT();
}

SgScopeStatement *SgStatement::get_scope(void) const {
  SgStatement *stmt = const_cast<SgStatement *>(this);

  SgScopeStatement *returnScope = NULL;
  switch (variantT()) {
  case V_SgGlobal: {
    returnScope = isSgScopeStatement(stmt);
    ROSE_ASSERT(returnScope != NULL);
    break;
  }

  case V_SgCtorInitializerList:
  case V_SgFunctionParameterList: {
    if (stmt->get_parent() == NULL) {
      fprintf(stderr,
              "REX_AST_INVARIANT[statement-scope-parent]: statement=%p "
              "type=%s has no parent\n",
              static_cast<void *>(stmt), stmt->class_name().c_str());
      ROSE_ABORT();
    }

    SgFunctionDeclaration *functionDeclaration =
        isSgFunctionDeclaration(stmt->get_parent());
    if (functionDeclaration != NULL) {
      returnScope = functionDeclaration->get_scope();
    } else if (SgRequiresExpr *requiresExpression =
                   isSgRequiresExpr(stmt->get_parent())) {
      // Requires-expression local parameters have their own declarative
      // region.  Returning the surrounding function or namespace scope would
      // make those names visible outside the requires-expression.
      SgFunctionParameterScope *parameterScope =
          requiresExpression->get_local_parameter_scope();
      if (parameterScope == NULL ||
          parameterScope->get_parent() != requiresExpression) {
        fprintf(stderr,
                "REX_AST_INVARIANT[requires-local-parameter-scope]: "
                "parameter-list=%p requires-expression=%p has no exact "
                "local parameter scope\n",
                static_cast<void *>(stmt),
                static_cast<void *>(requiresExpression));
        ROSE_ABORT();
      }
      returnScope = parameterScope;
    } else if (auto *prototype =
                   isSgFunctionParameterTypeList(stmt->get_parent())) {
      ROSE_ASSERT(isSgFunctionParameterList(stmt) != nullptr);
      ROSE_ASSERT(prototype->get_source_parameters() == stmt);
      returnScope = prototype->get_source_parameter_scope();
      ROSE_ASSERT(returnScope != nullptr &&
                  returnScope->get_parent() == prototype);
    } else {
      SgTemplateFunctionDeclaration *templateFunctionDeclaration =
          isSgTemplateFunctionDeclaration(stmt->get_parent());
      ROSE_ASSERT(templateFunctionDeclaration != NULL);
      returnScope = templateFunctionDeclaration->get_scope();
    }

    ROSE_ASSERT(returnScope != NULL);
    break;
  }

  default: {
    auto abortScopeCycle = [this](const SgNode *owner) {
      fprintf(stderr,
              "REX_AST_INVARIANT[statement-scope-cycle]: statement=%p "
              "type=%s repeats owner=%p/%s\n",
              static_cast<const void *>(this), class_name().c_str(),
              static_cast<const void *>(owner), owner->class_name().c_str());
      ROSE_ABORT();
    };
    if (isSgScopeStatement(stmt) != NULL) {
      if (stmt->get_parent() == NULL) {
        fprintf(stderr,
                "REX_AST_INVARIANT[statement-scope-parent]: statement=%p "
                "type=%s has no parent\n",
                static_cast<void *>(stmt), stmt->class_name().c_str());
        ROSE_ABORT();
      }

      SgNode *stmtTemp = stmt->get_parent();
      std::unordered_set<const SgNode *> seenOwners{stmt};
      while ((stmtTemp != NULL) && (isSgStatement(stmtTemp) == NULL) &&
             (isSgArrayType(stmtTemp) == NULL) &&
             (isSgTypeOfType(stmtTemp) == NULL)) {
        if (!seenOwners.insert(stmtTemp).second)
          abortScopeCycle(stmtTemp);
        stmtTemp = stmtTemp->get_parent();
      }

      if (stmtTemp == NULL) {
        fprintf(stderr,
                "REX_AST_INVARIANT[statement-scope-parent]: statement=%p "
                "type=%s has no statement, array-type, or typeof-type owner\n",
                static_cast<void *>(stmt), stmt->class_name().c_str());
        ROSE_ABORT();
      }
      if (!seenOwners.insert(stmtTemp).second)
        abortScopeCycle(stmtTemp);
      stmt = isSgStatement(stmtTemp);

      if (stmt != NULL) {
        // A declaration's explicit scope takes precedence over its parent.
        if (stmt->hasExplicitScope() == true) {
          ROSE_ASSERT(isSgScopeStatement(stmt) == NULL);
          return stmt->get_scope();
        }
      } else {
        SgArrayType *arrayType = isSgArrayType(stmtTemp);
        SgTypeOfType *typeOfType = isSgTypeOfType(stmtTemp);
        ROSE_ASSERT(arrayType != NULL || typeOfType != NULL);
        return NULL;
      }
    }

    std::unordered_set<const SgStatement *> seenStatements;
    while (!(returnScope = isSgScopeStatement(stmt))) {
      if (!seenStatements.insert(stmt).second)
        abortScopeCycle(stmt);

      if (isSgNonrealDecl(stmt) != NULL &&
          isSgStatement(stmt->get_parent()) == NULL) {
        fprintf(stderr,
                "REX_AST_INVARIANT[nonreal-declaration-scope]: declaration=%p "
                "has non-statement parent=%p type=%s\n",
                static_cast<void *>(stmt),
                static_cast<void *>(stmt->get_parent()),
                stmt->get_parent() != NULL
                    ? stmt->get_parent()->class_name().c_str()
                    : "<null>");
        ROSE_ABORT();
      }

      if (stmt->get_parent() == NULL) {
        fprintf(stderr,
                "REX_AST_INVARIANT[statement-scope-parent]: statement=%p "
                "type=%s has null parent\n",
                static_cast<void *>(stmt), stmt->class_name().c_str());
        ROSE_ABORT();
      }

      if (SgAuxiliaryDeclarationList *container =
              isSgAuxiliaryDeclarationList(stmt->get_parent())) {
        SgDeclarationStatement *declaration = isSgDeclarationStatement(stmt);
        SgScopeStatement *owner = isSgScopeStatement(container->get_parent());
        const SgDeclarationStatementPtrList &declarations =
            container->get_declarations();
        if (declaration == NULL || owner == NULL ||
            owner->get_auxiliary_declarations() != container ||
            std::count(declarations.begin(), declarations.end(), declaration) !=
                1) {
          fprintf(stderr,
                  "REX_AST_INVARIANT[auxiliary-declaration-scope]: "
                  "statement=%p type=%s has malformed auxiliary ownership\n",
                  static_cast<void *>(stmt), stmt->class_name().c_str());
          ROSE_ABORT();
        }
        return owner;
      }

      // Statements may be exact children of typed structural carriers rather
      // than direct children of another statement.  OpenMP metadirective
      // variants, for example, are owned by a clause or context selector.
      // Derive their enclosing statement through the published AST edges and
      // reject any missing, duplicate, or disconnected ownership.
      SgNode *scopeChild = stmt;
      SgNode *scopeOwner = stmt->get_parent();
      std::unordered_set<const SgNode *> seenOwners;
      while (scopeOwner != NULL && isSgStatement(scopeOwner) == NULL) {
        if (!seenOwners.insert(scopeOwner).second)
          abortScopeCycle(scopeOwner);
        if (isSgArrayType(scopeOwner) != NULL ||
            isSgTypeOfType(scopeOwner) != NULL) {
          return NULL;
        }
        const SgNodePtrList successors =
            scopeOwner->get_traversalSuccessorContainer();
        if (std::count(successors.begin(), successors.end(), scopeChild) != 1) {
          fprintf(stderr,
                  "REX_AST_INVARIANT[statement-scope-owner]: statement=%p "
                  "type=%s has a non-statement owner=%p/%s without one exact "
                  "structural edge\n",
                  static_cast<void *>(stmt), stmt->class_name().c_str(),
                  static_cast<void *>(scopeOwner),
                  scopeOwner->class_name().c_str());
          ROSE_ABORT();
        }
        scopeChild = scopeOwner;
        scopeOwner = scopeOwner->get_parent();
      }
      if (scopeOwner == NULL) {
        fprintf(stderr,
                "REX_AST_INVARIANT[statement-scope-owner]: statement=%p "
                "type=%s has no enclosing statement through its exact "
                "structural owner chain\n",
                static_cast<void *>(stmt), stmt->class_name().c_str());
        ROSE_ABORT();
      }
      stmt = isSgStatement(scopeOwner);
      ROSE_ASSERT(stmt != NULL);
      if (seenStatements.count(stmt) != 0)
        abortScopeCycle(stmt);
    }
    break;
  }
  }

  ROSE_ASSERT(returnScope != NULL);

  return returnScope;
}

void SgStatement::set_end_numeric_label(SgLabelRefExp *end_numeric_label) {
  fprintf(stderr,
          "REX_AST_INVARIANT[end-numeric-label]: statement=%p type=%s "
          "cannot own end label=%p\n",
          static_cast<void *>(this), class_name().c_str(),
          static_cast<void *>(end_numeric_label));
  ROSE_ABORT();
}

SgLabelRefExp *SgStatement::get_end_numeric_label() const {
  fprintf(stderr,
          "REX_AST_INVARIANT[end-numeric-label]: statement=%p type=%s "
          "cannot provide an end label\n",
          static_cast<const void *>(this), class_name().c_str());
  ROSE_ABORT();
}

// Report if a construct has a concept of end_numeric_label
bool SgStatement::has_end_numeric_label() const {
  switch (variantT()) {
  case V_SgIfStmt:
  case V_SgWhileStmt:
  case V_SgSwitchStatement:
  case V_SgProgramHeaderStatement:
  case V_SgProcedureHeaderStatement:
  case V_SgInterfaceStatement:
  case V_SgModuleStatement:
  case V_SgFortranDo:
  case V_SgForAllStatement:
  case V_SgAssociateStatement:
  case V_SgWhereStatement:
  case V_SgDerivedTypeStatement:
  case V_SgEnumDeclaration:
    return true;
  default:
    return false;
  }
}

bool SgStatement::hasExplicitType() {
  return isSgTypedefDeclaration(this) != NULL;
}

SOURCE_MAIN_STATEMENT_END

SOURCE_SCOPE_STATEMENT_START

void SgScopeStatement::prepend_statement(SgStatement *stmt) {
  ROSE_ASSERT(stmt != NULL);
  const bool declarations_only = containsOnlyDeclarations();
  SgDeclarationStatement *declaration = isSgDeclarationStatement(stmt);
  if (declarations_only) {
    if (declaration == NULL) {
      printf("Error: SgScopeStatement::prepend in a scope such as %s must "
             "provide a SgDeclarationStatement = %s \n",
             class_name().c_str(), stmt->class_name().c_str());
    }
    ROSE_ASSERT(declaration != NULL);
  }
  Sg_File_Info *position = stmt->get_file_info();
  if (position != nullptr && position->isTransformation() &&
      position->get_physical_file_id() == Sg_File_Info::NULL_FILE_ID)
    SageInterface::publishGeneratedSubtreeOutputOwner(stmt, this);
  if (declarations_only) {
    getDeclarationList().insert(getDeclarationList().begin(), declaration);
  } else {
    getStatementList().insert(getStatementList().begin(), stmt);
  }
  stmt->set_parent(this);
  ROSE_ASSERT(stmt->get_parent() != NULL);
}

void SgScopeStatement::append_statement(SgStatement *stmt) {
  ROSE_ASSERT(stmt != NULL);
  const bool declarations_only = containsOnlyDeclarations();
  SgDeclarationStatement *declaration = isSgDeclarationStatement(stmt);
  if (declarations_only) {
    if (declaration == NULL) {
      printf("Error: SgScopeStatement::append in a scope such as %s must "
             "provide a SgDeclarationStatement = %s \n",
             class_name().c_str(), stmt->class_name().c_str());
    }
    ROSE_ASSERT(declaration != NULL);
  }
  Sg_File_Info *position = stmt->get_file_info();
  if (position != nullptr && position->isTransformation() &&
      position->get_physical_file_id() == Sg_File_Info::NULL_FILE_ID)
    SageInterface::publishGeneratedSubtreeOutputOwner(stmt, this);
  if (declarations_only) {
    getDeclarationList().insert(getDeclarationList().end(), declaration);
  } else {
    getStatementList().insert(getStatementList().end(), stmt);
  }
  stmt->set_parent(this);
  ROSE_ASSERT(stmt->get_parent() != NULL);
}

SgScopeStatement::SgScopeStatement(Sg_File_Info *file_info)
    : $BASECLASS(file_info) {
  // Make the global scope hash multimap larger since it typically supports more
  // symbols. Use a prime number (better!)
  if (variantT() == V_SgGlobal ||
      variantT() == V_SgNamespaceDefinitionStatement) {
    p_symbol_table = new SgSymbolTable(101);
  } else {
    if (variantT() == V_SgClassDefinition ||
        variantT() == V_SgTemplateInstantiationDefn) {
      p_symbol_table = new SgSymbolTable(51);
    } else {
      // Use the default size of hash_multimap
      p_symbol_table = new SgSymbolTable();
    }
  }

  ROSE_ASSERT(p_symbol_table != NULL);

  p_symbol_table->set_parent(this);

  p_type_table = new SgTypeTable();
  p_type_table->set_parent(this);

  // These traversal fields are generated from SgScopeStatement's ROSETTA
  // data members, but this class uses a hand-written constructor.  Initialize
  // them here so every freshly constructed scope has a valid traversal state.
  p_auxiliary_declaration_scopes = NULL;
  p_auxiliary_declarations = NULL;

  p_pragma = NULL;
}

void SgScopeStatement::post_construction_initialization() {}

SgName SgScopeStatement::get_qualified_name() const {
  // Compute name of this scope -- by default, an unnamed (or empty) string.
  SgName local_qual_name;

  // Compute parent scope's qualified name
  SgName par_qual_name;
  const SgScopeStatement *parent_scope = get_scope();
  if (parent_scope)
    par_qual_name = parent_scope->get_qualified_name();

  return SgName::assembleQualifiedName(par_qual_name, local_qual_name);
}

SgName SgScopeStatement::get_mangled_name(void) const {
  printf("Error: this is a virtual function call on a base class "
         "implementation! scope = %p = %s \n",
         this, this->class_name().c_str());
  ROSE_ASSERT(false);

  return SgName("__error__");
}

size_t SgScopeStatement::count_symbol(const SgName &n) {
  // DQ (2/10/2007): Added function to count entries in symbol table with same
  // name! This can be more than 1, e.g. "typedef struct X{} X;"
  ROSE_ASSERT(p_symbol_table != NULL);
  return p_symbol_table->count(n);
}

size_t SgScopeStatement::count_alias_symbol(const SgName &n) {
  ROSE_ASSERT(p_symbol_table != NULL);
  return p_symbol_table->count_aliases(n);
}

//! Return the size of the symbol table.
size_t SgScopeStatement::symbol_table_size() {
  ROSE_ASSERT(p_symbol_table != NULL);
  return p_symbol_table->size();
}

bool SgScopeStatement::symbol_exists(const SgName &nm, SgSymbol *sp) const {
  ROSE_ASSERT(p_symbol_table != NULL);
  return p_symbol_table->exists(nm, sp);
}

bool SgScopeStatement::symbol_exists(const SgName &nm) const {
  ROSE_ASSERT(p_symbol_table != NULL);
  return p_symbol_table->exists(nm);
}

bool SgScopeStatement::symbol_exists(const SgSymbol *sp) const {
  ROSE_ASSERT(p_symbol_table != NULL);
  return p_symbol_table->exists(sp);
}

SgSymbolTable *SgScopeStatement::get_symbol_table() const {
  return p_symbol_table;
}

void SgScopeStatement::set_symbol_table(SgSymbolTable *symbol_table) {
  p_symbol_table = symbol_table;
  markAsModified();
}

void SgScopeStatement::insert_symbol(const SgName &n, SgSymbol *s) {
  ROSE_ASSERT(p_symbol_table != NULL);
  ROSE_ASSERT(s != NULL);
  if (s->get_parent() != NULL || p_symbol_table->exists(s)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[symbol-duplicate-insertion]: scope=%p "
            "name=%s symbol=%p is already published\n",
            static_cast<void *>(this), n.str(), static_cast<void *>(s));
    ROSE_ABORT();
  }

  SgNode *symbol_basis = s->get_symbol_basis();
  ROSE_ASSERT(symbol_basis != NULL);
  SgDeclarationStatement *declstmt = isSgDeclarationStatement(symbol_basis);
  SgInitializedName *iname = isSgInitializedName(symbol_basis);
  if (iname != NULL) {
    declstmt = isSgVariableDeclaration(iname->get_declaration());
  }
  bool is_static_decl = false;
  if (declstmt != NULL) {
    const SgDeclarationModifier &decl_mod = declstmt->get_declarationModifier();
    const SgStorageModifier &storage_mod = decl_mod.get_storageModifier();
    is_static_decl = storage_mod.isStatic();
  }

  const SgNamespaceDefinitionStatement *namespaceDefinitionStatement =
      isSgNamespaceDefinitionStatement(this);
  if (namespaceDefinitionStatement != NULL && !is_static_decl) {
    SgNamespaceDefinitionStatement *gnds =
        namespaceDefinitionStatement->get_global_definition();
    if (gnds != NULL && namespaceDefinitionStatement != gnds) {
      SgAliasSymbol *aliasSymbol = new SgAliasSymbol(s);
      aliasSymbol->get_causal_nodes().push_back(gnds);
      gnds->get_symbol_table()->insert(n, aliasSymbol);
      aliasSymbol->set_parent(gnds->get_symbol_table());
    }
  }

  SgGlobal *global_scope = isSgGlobal(this);
  if (global_scope != NULL && !is_static_decl) {
    SgProject *project = SageInterface::getProject(global_scope);
    if (project != NULL) {
      SgGlobal *globalScopeAcrossFiles = project->get_globalScopeAcrossFiles();
      ROSE_ASSERT(globalScopeAcrossFiles != NULL);

      // DQ (2/28/2015): They can be the same for snippet injection and some
      // tooling.
      if (global_scope != globalScopeAcrossFiles) {
        SgSymbolTable *symtab = globalScopeAcrossFiles->get_symbol_table();
        ROSE_ASSERT(symtab != NULL);
        SgAliasSymbol *asym = symtab->find_aliased_symbol(n, s);
        if (asym == NULL) {
          asym = isSgAliasSymbol(s);
          if (asym != NULL) {
            asym = new SgAliasSymbol(*asym);
            if (asym->get_causal_nodes().empty()) {
              fprintf(stderr,
                      "REX_AST_INVARIANT[alias-provenance]: copied alias=%p "
                      "name=%s has no causal node\n",
                      static_cast<void *>(asym), n.str());
              ROSE_ABORT();
            }
          } else {
            asym = new SgAliasSymbol(s);
            asym->get_causal_nodes().push_back(global_scope);
          }
          ROSE_ASSERT(asym != NULL);
          globalScopeAcrossFiles->get_symbol_table()->insert(n, asym);
          asym->set_parent(symtab);
        }
      } else {
        MLOG_WARN_C("ROSETTA", "Warning: In SgScopeStatement::insert_symbol(): "
                               "global_scope == globalScopeAcrossFiles: skip "
                               "insertion of redundant SgAliasSymbol \n");
      }
    } else {
      fprintf(stderr,
              "REX_AST_INVARIANT[global-symbol-project]: global-scope=%p "
              "symbol=%p name=%s has no owning project\n",
              static_cast<void *>(global_scope), static_cast<void *>(s),
              n.str());
      ROSE_ABORT();
    }
  }

  SgClassSymbol *class_symbol = isSgClassSymbol(s);
  if (class_symbol != NULL) {
    SgClassDeclaration *class_declaration =
        isSgClassDeclaration(class_symbol->get_declaration());
    ROSE_ASSERT(class_declaration != NULL);

    SgScopeStatement *classScope = class_declaration->get_scope();
    SgScopeStatement *thisScope = this;

    SgNamespaceDefinitionStatement *namespaceDefinition_class =
        isSgNamespaceDefinitionStatement(classScope);
    SgNamespaceDefinitionStatement *namespaceDefinition_this =
        isSgNamespaceDefinitionStatement(this);
    if (namespaceDefinition_class != NULL && namespaceDefinition_this != NULL) {
      classScope = namespaceDefinition_class->get_global_definition();
      thisScope = namespaceDefinition_this->get_global_definition();
    }

    SgGlobal *globalScope_class = isSgGlobal(classScope);
    SgGlobal *globalScope_this = isSgGlobal(this);
    if (globalScope_class != NULL && globalScope_this != NULL) {
      classScope = globalScope_this;
    }

    if (classScope != thisScope) {
      MLOG_WARN_C("ROSETTA", "Warning: SgScopeStatement::insert_symbol(): "
                             "class_declaration->get_scope() != this \n");
      MLOG_WARN_MORE_C("   --- scope = %p = %s \n", this,
                       this->class_name().c_str());
      MLOG_WARN_MORE_C("   --- class_declaration = %p = %s \n",
                       class_declaration,
                       class_declaration->class_name().c_str());
      MLOG_WARN_MORE_C("   --- class_declaration->get_scope() = %p = %s \n",
                       class_declaration->get_scope(),
                       class_declaration->get_scope()->class_name().c_str());
    }
  }

  p_symbol_table->insert(n, s);
}

void SgScopeStatement::remove_symbol(SgSymbol *s) {
  ROSE_ASSERT(p_symbol_table != NULL);
  const SgName stored_name = p_symbol_table->stored_name_of(s);

  const SgNamespaceDefinitionStatement *namespaceDefinitionStatement =
      isSgNamespaceDefinitionStatement(this);
  if (namespaceDefinitionStatement != NULL) {
    ROSE_ASSERT(namespaceDefinitionStatement->get_global_definition() != NULL);
    const SgNamespaceDefinitionStatement *globalNamespaceDefinitionStatement =
        namespaceDefinitionStatement->get_global_definition();
    ROSE_ASSERT(globalNamespaceDefinitionStatement != NULL);
    if (namespaceDefinitionStatement != globalNamespaceDefinitionStatement) {
      SgSymbol *aliasSymbol =
          globalNamespaceDefinitionStatement->get_symbol_table()
              ->find_aliased_symbol(stored_name, s);
      if (aliasSymbol != NULL) {
        globalNamespaceDefinitionStatement->get_symbol_table()->remove(
            aliasSymbol);
        delete aliasSymbol;
      }
    }
  }

  const SgGlobal *global_scope = isSgGlobal(this);
  if (global_scope != NULL) {
    SgProject *project = SageInterface::getProject(global_scope);
    if (project != NULL) {
      SgGlobal *globalScopeAcrossFiles = project->get_globalScopeAcrossFiles();
      ROSE_ASSERT(globalScopeAcrossFiles != NULL);

      SgSymbol *aliasSymbol =
          globalScopeAcrossFiles->get_symbol_table()->find_aliased_symbol(
              stored_name, s);
      if (aliasSymbol != NULL) {
        globalScopeAcrossFiles->get_symbol_table()->remove(aliasSymbol);
        delete aliasSymbol;
      }
    }
  }

  p_symbol_table->remove(s);
  s->set_parent(NULL);
}

SgSymbol *SgScopeStatement::lookup_symbol(
    const SgName &n, SgTemplateParameterPtrList *templateParameterList,
    SgTemplateArgumentPtrList *templateArgumentList) const {
  ROSE_ASSERT(p_symbol_table != NULL);

  SgSymbol *symbol =
      p_symbol_table->find_any(n, templateParameterList, templateArgumentList);

  const SgNamespaceDefinitionStatement *namespaceDefinitionStatement =
      isSgNamespaceDefinitionStatement(this);
  if (symbol == NULL && namespaceDefinitionStatement != NULL) {
    ROSE_ASSERT(namespaceDefinitionStatement->get_global_definition() != NULL);
    const SgNamespaceDefinitionStatement *globalNamespaceDefinitionStatement =
        namespaceDefinitionStatement->get_global_definition();
    symbol = globalNamespaceDefinitionStatement->get_symbol_table()->find_any(
        n, templateParameterList, templateArgumentList);
  }

  const SgGlobal *global_scope = isSgGlobal(this);
  if (symbol == NULL && global_scope != NULL) {
    SgProject *project = SageInterface::getProject(global_scope);
    if (project != NULL) {
      SgGlobal *globalScopeAcrossFiles = project->get_globalScopeAcrossFiles();
      ROSE_ASSERT(globalScopeAcrossFiles != NULL);
      symbol = globalScopeAcrossFiles->get_symbol_table()->find_any(
          n, templateParameterList, templateArgumentList);
    }
  }

  return symbol;
}

SgSymbol *SgScopeStatement::lookup_symbol_for_name_qualification(
    const SgName &n, VariantT requestedSymbolKind, const SgType *type,
    SgTemplateParameterPtrList *templateParameterList,
    SgTemplateArgumentPtrList *templateArgumentList,
    const SgUnorderedNodeSet &visibleAliasCausalNodes) const {
  ROSE_ASSERT(p_symbol_table != NULL);

  SgSymbol *symbol = p_symbol_table->find_for_name_qualification(
      n, requestedSymbolKind, type, templateParameterList, templateArgumentList,
      visibleAliasCausalNodes, true);

  const SgNamespaceDefinitionStatement *namespaceDefinitionStatement =
      isSgNamespaceDefinitionStatement(this);
  if (symbol == NULL && namespaceDefinitionStatement != NULL) {
    ROSE_ASSERT(namespaceDefinitionStatement->get_global_definition() != NULL);
    const SgNamespaceDefinitionStatement *globalNamespaceDefinitionStatement =
        namespaceDefinitionStatement->get_global_definition();
    symbol = globalNamespaceDefinitionStatement->get_symbol_table()
                 ->find_for_name_qualification(
                     n, requestedSymbolKind, type, templateParameterList,
                     templateArgumentList, visibleAliasCausalNodes, true);
  }

  const SgGlobal *global_scope = isSgGlobal(this);
  if (symbol == NULL && global_scope != NULL) {
    SgProject *project = SageInterface::getProject(global_scope);
    if (project != NULL) {
      SgGlobal *globalScopeAcrossFiles = project->get_globalScopeAcrossFiles();
      ROSE_ASSERT(globalScopeAcrossFiles != NULL);
      symbol = globalScopeAcrossFiles->get_symbol_table()
                   ->find_for_name_qualification(
                       n, requestedSymbolKind, type, templateParameterList,
                       templateArgumentList, visibleAliasCausalNodes, true);
    }
  }

  return symbol;
}

