  if (p_selector_expression != nullptr) {
    ROSE_ASSERT(p_label == nullptr && p_label_expression == nullptr);
    ROSE_ASSERT(p_selector_expression->get_parent() == nullptr);
    p_selector_expression->set_parent(this);
  }
}

bool SgGotoStatement::replace_child(SgStatement *target, SgStatement *newstmt,
