// 1102, Fortran 2003 Standard 04-007). SgInitializedNamePtrList & get_args() ;
// const SgInitializedNamePtrList & get_args() const;

protected:
virtual bool replace_child($GRAMMAR_PREFIX_Statement *,
                           $GRAMMAR_PREFIX_Statement *,
                           bool extractListFromBasicBlock = false) override;

