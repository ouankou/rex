virtual std::vector<VirtualCFG::CFGEdge>
cfgOutEdges(unsigned int index) override;
virtual std::vector<VirtualCFG::CFGEdge>
cfgInEdges(unsigned int index) override;

// An access label is a lexical class-member surface whose scope is derived
// exclusively from its structural SgClassDefinition owner.  It stores no
// independent semantic scope edge.
virtual bool hasExplicitScope() const override;

HEADER_ACCESS_LABEL_STATEMENT_END

