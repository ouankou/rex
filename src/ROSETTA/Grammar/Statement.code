HEADER_PROGRAM_HEADER_STATEMENT_END

HEADER_PROCEDURE_HEADER_STATEMENT_START

// DQ (3/20/2007): These should be generated automatically from ROSETTA.
// SgName get_name() const;
// void set_name(SgName);
// SgFunctionType* get_type () const;
// void set_type ( SgFunctionType* type );
// SgType* get_orig_return_type() const;
// void set_parameterList ( SgFunctionParameterList* );

/*! \brief Classification for different types of Fortran subprograms.
 */
enum subprogram_kind_enum {
  e_unknown_kind,               /*!< error value */
  e_function_subprogram_kind,   /*!< Fortran function value */
  e_subroutine_subprogram_kind, /*!< Fortran subroutine value */
  e_block_data_subprogram_kind, /*!< Fortran data block value */
  e_last_subprogram_kind /*!< last value (upper bound on range of values, used
                            in error checking) */
};

/*! \brief Source-level naming of a BLOCK DATA program unit. */
enum block_data_name_kind_enum {
  e_unknown_block_data_name_kind,
  e_unnamed_block_data,
  e_named_block_data
};

/*! \brief Exact Fortran source surface represented by this procedure.

    A semantic-only declaration is not emitted.  The other values identify
    the lexical syntax that owns the declaration and must be preserved by the
    unparser; in particular a typed procedure declaration is not a variable
    declaration and must retain its canonical function symbol.
 */
enum fortran_procedure_source_form_enum {
  e_fortran_procedure_source_form_unknown,
  e_fortran_procedure_source_form_semantic_only,
  e_fortran_procedure_source_form_header,
  e_fortran_procedure_source_form_compiler_module_header,
  e_fortran_procedure_source_form_type_declaration,
  e_fortran_procedure_source_form_type_external
};

/*! \brief Exact source type-spec spelling for a Fortran function result.

    Function prefixes and typed procedure entities do not own an
    SgInitializedName for their leading type-spec, so intrinsic versus TYPE
    versus CLASS identity must live on the lexical procedure declaration
    itself. UNKNOWN is valid only when that declaration has no leading typed
    result surface.
 */
enum fortran_result_type_spec_enum {
  e_fortran_result_type_spec_unknown,
  e_fortran_result_type_spec_intrinsic,
  e_fortran_result_type_spec_type,
  e_fortran_result_type_spec_class,
  e_fortran_result_type_spec_type_star,
  e_fortran_result_type_spec_class_star
};

SgName get_mangled_name() const override;

