void SgEnumDeclaration::validate_enumerator_source_ownership() const {
  const Sg_File_Info *owner_start = get_startOfConstruct();
  const Sg_File_Info *owner_end = get_endOfConstruct();
  const bool owner_has_physical_source =
      owner_start != nullptr && owner_end != nullptr &&
      owner_start->get_physical_file_id() >= 0 &&
      owner_end->get_physical_file_id() >= 0 &&
      owner_start->isSameFile(*owner_end);
  const SgAuxiliaryDeclarationList *auxiliary_owner =
      isSgAuxiliaryDeclarationList(get_parent());

  const bool is_definition = get_definingDeclaration() == this;
  if (get_underlying_type_source_spelled() &&
      (get_field_type() == nullptr ||
       isSgTypeUnknown(get_field_type()->findBaseType()) != nullptr)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
            "marks a source-spelled underlying type without an exact "
            "semantic type\n",
            static_cast<const void *>(this), get_name().getString().c_str());
    ROSE_ABORT();
  }

  const SgInitializedNamePtrList &enumerators = get_enumerators();
  if (!enumerators.empty() && !is_definition) {
    fprintf(stderr,
            "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
            "nondefining declaration owns semantic enumerators\n",
            static_cast<const void *>(this), get_name().getString().c_str());
    ROSE_ABORT();
  }
  for (size_t index = 0; index < enumerators.size(); ++index) {
    const SgInitializedName *enumerator = enumerators[index];
    if (enumerator == nullptr || enumerator->get_parent() != this ||
        enumerator->get_declptr() != this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
              "enumerator index=%zu has no exact semantic owner\n",
              static_cast<const void *>(this), get_name().getString().c_str(),
              index);
      ROSE_ABORT();
    }

    const SgInitializedName::enum_constant_source_ownership_enum role =
        enumerator->get_enum_constant_source_ownership();
    const Sg_File_Info *field_start = enumerator->get_startOfConstruct();
    const Sg_File_Info *field_end = enumerator->get_endOfConstruct();
    const bool field_has_physical_source =
        field_start != nullptr && field_end != nullptr &&
        field_start->get_physical_file_id() >= 0 &&
        field_end->get_physical_file_id() >= 0 &&
        field_start->isSameFile(*field_end);
    const bool generated_field =
        field_start != nullptr && field_end != nullptr &&
        field_start->isCompilerGenerated() && field_end->isCompilerGenerated();

    switch (role) {
    case SgInitializedName::e_enum_constant_source_body:
      // Transformations can explicitly add a generated constant to a source
      // enum body.  Source-backed constants must instead prove exact physical
      // identity with that body.
      if (!generated_field &&
          (!owner_has_physical_source || !field_has_physical_source ||
           !owner_start->isSameFile(*field_start))) {
        fprintf(stderr,
                "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
                "direct enumerator index=%zu is not owned by the enum's "
                "physical source body\n",
                static_cast<const void *>(this), get_name().getString().c_str(),
                index);
        ROSE_ABORT();
      }
      break;

    case SgInitializedName::e_enum_constant_source_external:
      if (!owner_has_physical_source || !field_has_physical_source ||
          owner_start->isSameFile(*field_start) || generated_field) {
        fprintf(stderr,
                "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
                "external enumerator index=%zu lacks a distinct exact "
                "physical source owner\n",
                static_cast<const void *>(this), get_name().getString().c_str(),
                index);
        ROSE_ABORT();
      }
      break;

    case SgInitializedName::e_enum_constant_semantic_only:
      if (auxiliary_owner == nullptr || !generated_field ||
          !field_start->isFrontendSpecific() ||
          !field_end->isFrontendSpecific()) {
        fprintf(stderr,
                "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
                "semantic-only enumerator index=%zu has a lexical source "
                "owner\n",
                static_cast<const void *>(this), get_name().getString().c_str(),
                index);
        ROSE_ABORT();
      }
      break;

    case SgInitializedName::e_enum_constant_source_unclassified:
    case SgInitializedName::e_last_enum_constant_source_ownership:
    default:
      fprintf(stderr,
              "REX_AST_INVARIANT[enum-source-ownership]: enum=%p name=%s "
              "enumerator index=%zu has no exact source role\n",
              static_cast<const void *>(this), get_name().getString().c_str(),
              index);
      ROSE_ABORT();
    }
  }
}

SOURCE_ENUM_DECLARATION_STATEMENT_END

SOURCE_EXPRESSION_STATEMENT_START
// QY: 9/30/2004   removed the expr_i pointer in exprStatement. Use exprRoot
// directly as constructor parameter
void SgExprStatement::post_construction_initialization() {
  // DQ (11/7/2006): removed use of expression root
  // if (get_expression_root() != NULL)
  //      get_expression_root()->set_statement(this);

  // DQ (12/17/2006): This function should have the semantics that it will
  // represent a structural change to the AST, thus it is free to set the parent
  // of the new expression.
  if (get_expression() != NULL)
    get_expression()->set_parent(this);
}

// DQ (12/6/2006): We need this sort of function now that we have removed the
// expression root node! The requirement of not being able to do operations
// uniformly on expressions may be the disadvantage of not having used the
// SgExpressionRoot IR node as a concept.
int SgExprStatement::replace_expression(SgExpression *original_expression,
                                        SgExpression *new_expression) {
  // DQ (12/17/2006): This function should have the semantics that it will
  // represent a structural change to the AST, thus it is free to set the parent
  // of the new expression.

  ROSE_ASSERT(original_expression != NULL);
  ROSE_ASSERT(new_expression != NULL);

  ROSE_ASSERT(original_expression == p_expression);

  set_expression(new_expression);

  new_expression->set_parent(this);

  // DQ: Let this be a memory leak for now to avoid initial problems.
  ROSE_ASSERT(original_expression != NULL);
  // delete original_expression;

  return 0;
}

SOURCE_EXPRESSION_STATEMENT_END

SOURCE_LABEL_STATEMENT_START

bool SgLabelStatement::hasExplicitScope() const {
  // This function reports that this IR node stores its scope explicitly.

  return true;
}

void SgLabelStatement::post_construction_initialization() {}

SgName SgLabelStatement::get_name() const { return get_label(); }

SgSymbol *SgLabelStatement::get_symbol_from_symbol_table() const {
  SgScopeStatement *tempScope = get_scope();
  ASSERT_not_null(tempScope);
  while (tempScope != nullptr && isSgFunctionDefinition(tempScope) == nullptr) {
    tempScope = tempScope->get_scope();
  }

  SgFunctionDefinition *functionDefinition = isSgFunctionDefinition(tempScope);
  if (functionDefinition == nullptr) {
    std::cerr
        << "[WARN]: Labels are stored in the SgFunctionDefinition (function "
           "scope), could not locate associated function scope\n";
  }
  ASSERT_not_null(functionDefinition);
  return functionDefinition->find_symbol_from_declaration(this);
}

SgType *SgLabelStatement::get_type() const {
  // DQ (8/21/2013): Added function to support calling get_type() from a
  // SgDeclarationStatement so that the template low-level symbol table support
  // function would compile cleanly.  Note that it is an error to call this
  // function and it is not a virtual function that will cause derived class
  // versions to be called where appropriate (and it is not always appropriate,
  // e.g a SgNamespaceDeclaration has no assocated SgType).
  return NULL;
}

bool SgLabelStatement::replace_child(SgStatement *target, SgStatement *newstmt,
                                     bool extractBasicBlock) {
  // DQ (1/15/2018): Added support for the statement of the label to be
  // traversed.
  return (StatementReplace(this, p_statement, target, newstmt) == true);
}

