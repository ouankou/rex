  return p_group_list;
}

SOURCE_NAMELIST_STATEMENT_END

SOURCE_IMPORT_STATEMENT_START
void SgImportStatement::post_construction_initialization() {}

bool SgImportStatement::is_valid_import_state(
    const SgName &module_name, bool is_cxx_module_import,
    bool is_cxx_header_unit_import, const SgStringList &import_list,
    fortran_import_kind_enum fortran_import_kind) {
  if (is_cxx_module_import)
    return !module_name.getString().empty() && import_list.empty() &&
           fortran_import_kind == e_fortran_import_default;
  if (!module_name.getString().empty() || is_cxx_header_unit_import)
    return false;
  switch (fortran_import_kind) {
  case e_fortran_import_default:
    break;
  case e_fortran_import_only:
    if (import_list.empty())
      return false;
    break;
  case e_fortran_import_none:
  case e_fortran_import_all:
    if (!import_list.empty())
      return false;
    break;
  default:
    return false;
  }
  for (const std::string &name : import_list)
    if (name.empty())
      return false;
  return true;
}

void SgImportStatement::validate_import_state() const {
  ROSE_ASSERT(is_valid_import_state(p_module_name, p_is_cxx_module_import,
                                    p_is_cxx_header_unit_import, p_import_list,
                                    p_fortran_import_kind));
}

SgName SgImportStatement::get_mangled_name(void) const {
  return SgName("__import__");
}

SOURCE_IMPORT_STATEMENT_END

