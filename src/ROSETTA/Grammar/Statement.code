SOURCE_OMP_DECLARE_SIMD_STATEMENT_START
static SgSymbol *
getOmpFunctionDirectiveReferenceSymbol(const SgExpression *reference) {
  if (const SgTemplateMemberFunctionRefExp *ref =
          isSgTemplateMemberFunctionRefExp(reference)) {
    return ref->get_symbol();
  }
  if (const SgTemplateFunctionRefExp *ref =
          isSgTemplateFunctionRefExp(reference)) {
    return ref->get_symbol();
  }
  if (const SgMemberFunctionRefExp *ref = isSgMemberFunctionRefExp(reference)) {
    return ref->get_symbol();
  }
  if (const SgFunctionRefExp *ref = isSgFunctionRefExp(reference)) {
    return ref->get_symbol();
  }
  return NULL;
}

static SgDeclarationStatement *
getOmpFunctionDirectiveSymbolDeclaration(SgSymbol *symbol) {
  if (SgTemplateMemberFunctionSymbol *typed =
          isSgTemplateMemberFunctionSymbol(symbol)) {
    return typed->get_declaration();
  }
  if (SgTemplateFunctionSymbol *typed = isSgTemplateFunctionSymbol(symbol)) {
    return typed->get_declaration();
  }
  if (SgMemberFunctionSymbol *typed = isSgMemberFunctionSymbol(symbol)) {
    return typed->get_declaration();
  }
  if (SgFunctionSymbol *typed = isSgFunctionSymbol(symbol)) {
    return typed->get_declaration();
  }
  return NULL;
}

SgExpression *SgOmpDeclareSimdStatement::get_function_ref() const {
  return p_function_ref;
}

bool SgOmpDeclareSimdStatement::get_function_ref_is_explicit() const {
  return p_function_ref_is_explicit;
}

std::size_t SgOmpDeclareSimdStatement::get_semantic_variant_ordinal() const {
  return p_semantic_variant_ordinal;
}

void SgOmpDeclareSimdStatement::post_construction_initialization() {
  SgSymbol *targetSymbol =
      getOmpFunctionDirectiveReferenceSymbol(p_function_ref);
  if (p_function_ref == NULL || p_function_ref->get_parent() != NULL ||
      targetSymbol == NULL ||
      getOmpFunctionDirectiveSymbolDeclaration(targetSymbol) == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[declare-simd-construction]: statement=%p "
            "requires one unowned exact function reference\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  p_function_ref->set_parent(this);
}

SgName SgOmpDeclareSimdStatement::get_mangled_name(void) const {
  SgScopeStatement *scope = get_scope();
  SgExpression *functionRef = get_function_ref();
  SgSymbol *targetSymbol = getOmpFunctionDirectiveReferenceSymbol(functionRef);
  SgDeclarationStatement *targetDeclaration =
      getOmpFunctionDirectiveSymbolDeclaration(targetSymbol);
  if (scope == NULL || functionRef == NULL ||
      functionRef->get_parent() != this || targetSymbol == NULL ||
      targetDeclaration == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[declare-simd-target]: statement=%p has no "
            "coherent exact function target and nonnegative producer ordinal\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }

  for (SgNode *child : scope->get_traversalSuccessorContainer()) {
    const SgOmpDeclareSimdStatement *other = isSgOmpDeclareSimdStatement(child);
    if (other == NULL || other == this || other->get_scope() != scope) {
      continue;
    }
    if (getOmpFunctionDirectiveReferenceSymbol(other->get_function_ref()) ==
            targetSymbol &&
        other->get_semantic_variant_ordinal() ==
            get_semantic_variant_ordinal()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[declare-simd-ordinal]: target=%p ordinal=%zu "
              "is duplicated in one exact scope\n",
              static_cast<void *>(targetSymbol),
              get_semantic_variant_ordinal());
      ROSE_ABORT();
    }
  }

  const std::string targetName =
      targetDeclaration->get_mangled_name().getString();
  if (targetName.empty()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[declare-simd-target]: exact target has no "
            "mangled declaration identity\n");
    ROSE_ABORT();
  }
  return scope->get_mangled_name() + SgName("_omp_declaration_simd_t") +
         SgName(Rose::StringUtility::numberToString(targetName.size())) +
         SgName("_") + SgName(targetName) + SgName("_o") +
         SgName(Rose::StringUtility::numberToString(
             get_semantic_variant_ordinal()));
}

SOURCE_OMP_DECLARE_SIMD_STATEMENT_END

SOURCE_OMP_DECLARE_VARIANT_STATEMENT_START
SgExpression *SgOmpDeclareVariantStatement::get_variant_function_ref() const {
  return p_variant_function_ref;
}

SgExpression *SgOmpDeclareVariantStatement::get_base_function_ref() const {
  return p_base_function_ref;
}

bool SgOmpDeclareVariantStatement::get_base_function_ref_is_explicit() const {
  return p_base_function_ref_is_explicit;
}

std::size_t SgOmpDeclareVariantStatement::get_semantic_variant_ordinal() const {
  return p_semantic_variant_ordinal;
}

void SgOmpDeclareVariantStatement::post_construction_initialization() {
  SgSymbol *baseSymbol =
      getOmpFunctionDirectiveReferenceSymbol(p_base_function_ref);
  SgSymbol *variantSymbol =
      getOmpFunctionDirectiveReferenceSymbol(p_variant_function_ref);
  if (p_base_function_ref == NULL || p_variant_function_ref == NULL ||
      p_base_function_ref == p_variant_function_ref ||
      p_base_function_ref->get_parent() != NULL ||
      p_variant_function_ref->get_parent() != NULL || baseSymbol == NULL ||
      variantSymbol == NULL ||
      getOmpFunctionDirectiveSymbolDeclaration(baseSymbol) == NULL ||
      getOmpFunctionDirectiveSymbolDeclaration(variantSymbol) == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[declare-variant-construction]: statement=%p "
            "requires distinct unowned exact base and variant function "
            "references\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  p_base_function_ref->set_parent(this);
  p_variant_function_ref->set_parent(this);
}

SgName SgOmpDeclareVariantStatement::get_mangled_name(void) const {
  SgScopeStatement *scope = get_scope();
  SgExpression *baseFunctionRef = get_base_function_ref();
  SgExpression *variantFunctionRef = get_variant_function_ref();
  SgSymbol *baseSymbol =
      getOmpFunctionDirectiveReferenceSymbol(baseFunctionRef);
  SgSymbol *variantSymbol =
      getOmpFunctionDirectiveReferenceSymbol(variantFunctionRef);
  SgDeclarationStatement *baseDeclaration =
      getOmpFunctionDirectiveSymbolDeclaration(baseSymbol);
  SgDeclarationStatement *variantDeclaration =
      getOmpFunctionDirectiveSymbolDeclaration(variantSymbol);
  if (scope == NULL || baseFunctionRef == NULL || variantFunctionRef == NULL ||
      baseFunctionRef->get_parent() != this ||
      variantFunctionRef->get_parent() != this || baseSymbol == NULL ||
      variantSymbol == NULL || baseDeclaration == NULL ||
      variantDeclaration == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[declare-variant-target]: statement=%p has no "
            "coherent exact base function, variant function, and nonnegative "
            "producer ordinal\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }

  for (SgNode *child : scope->get_traversalSuccessorContainer()) {
    const SgOmpDeclareVariantStatement *other =
        isSgOmpDeclareVariantStatement(child);
    if (other == NULL || other == this || other->get_scope() != scope) {
      continue;
    }
    if (getOmpFunctionDirectiveReferenceSymbol(
            other->get_base_function_ref()) == baseSymbol &&
        other->get_semantic_variant_ordinal() ==
            get_semantic_variant_ordinal()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[declare-variant-ordinal]: target=%p "
              "ordinal=%zu is duplicated in one exact scope\n",
              static_cast<void *>(baseSymbol), get_semantic_variant_ordinal());
      ROSE_ABORT();
    }
  }

  const std::string baseName = baseDeclaration->get_mangled_name().getString();
  const std::string variantName =
      variantDeclaration->get_mangled_name().getString();
  if (baseName.empty() || variantName.empty()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[declare-variant-target]: exact base or variant "
            "function has no mangled declaration identity\n");
    ROSE_ABORT();
  }
  return scope->get_mangled_name() + SgName("_omp_declaration_variant_b") +
         SgName(Rose::StringUtility::numberToString(baseName.size())) +
         SgName("_") + SgName(baseName) + SgName("_v") +
         SgName(Rose::StringUtility::numberToString(variantName.size())) +
         SgName("_") + SgName(variantName) + SgName("_o") +
         SgName(Rose::StringUtility::numberToString(
             get_semantic_variant_ordinal()));
}

SOURCE_OMP_DECLARE_VARIANT_STATEMENT_END

SOURCE_OMP_BEGIN_DECLARE_VARIANT_STATEMENT_START
void SgOmpBeginDeclareVariantStatement::post_construction_initialization() {}

SgName SgOmpBeginDeclareVariantStatement::get_mangled_name(void) const {
  fprintf(stderr,
          "REX_AST_INVARIANT[openmp-nonentity-identity]: statement=%p "
          "type=%s directive=begin declare variant does not declare an "
          "independently named semantic entity\n",
          static_cast<const void *>(this), class_name().c_str());
  ROSE_ABORT();
}

SOURCE_OMP_BEGIN_DECLARE_VARIANT_STATEMENT_END

