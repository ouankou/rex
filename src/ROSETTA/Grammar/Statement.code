SOURCE_ATTRIBUTED_STATEMENT_START
SgAttributedStatement::SgAttributedStatement(
    SgStatement *statement, SgStatementAttributeList *attributes)
    : p_attribute_list(attributes), p_statement(statement) {
  post_construction_initialization();
  validate();
}

void SgAttributedStatement::post_construction_initialization() {
  if (p_attribute_list == NULL || p_statement == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement]: statement=%p requires a "
            "structural attribute list and wrapped statement\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  if ((p_attribute_list->get_parent() != NULL &&
       p_attribute_list->get_parent() != this) ||
      (p_statement->get_parent() != NULL &&
       p_statement->get_parent() != this)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement-owner]: statement=%p "
            "received attribute-list owner=%p or wrapped-statement owner=%p\n",
            static_cast<void *>(this),
            static_cast<void *>(p_attribute_list->get_parent()),
            static_cast<void *>(p_statement->get_parent()));
    ROSE_ABORT();
  }
  p_attribute_list->set_parent(this);
  p_statement->set_parent(this);
}

SgStatementAttributeList *SgAttributedStatement::get_attribute_list() {
  if (p_attribute_list == NULL || p_attribute_list->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement-owner]: statement=%p has "
            "invalid attribute-list=%p owner=%p\n",
            static_cast<void *>(this), static_cast<void *>(p_attribute_list),
            static_cast<void *>(p_attribute_list != NULL
                                    ? p_attribute_list->get_parent()
                                    : NULL));
    ROSE_ABORT();
  }
  return p_attribute_list;
}

const SgStatementAttributeList *
SgAttributedStatement::get_attribute_list() const {
  if (p_attribute_list == NULL || p_attribute_list->get_parent() != this) {
    fprintf(
        stderr,
        "REX_AST_INVARIANT[attributed-statement-owner]: statement=%p has "
        "invalid attribute-list=%p owner=%p\n",
        static_cast<const void *>(this), static_cast<void *>(p_attribute_list),
        static_cast<void *>(
            p_attribute_list != NULL ? p_attribute_list->get_parent() : NULL));
    ROSE_ABORT();
  }
  return p_attribute_list;
}

const SgStatementAttributePtrList &
SgAttributedStatement::get_attributes() const {
  return get_attribute_list()->get_attributes();
}

void SgAttributedStatement::append_attribute(SgStatementAttribute *attribute) {
  get_attribute_list()->append_attribute(attribute);
}

SgStatement *SgAttributedStatement::get_statement() const {
  if (p_statement == NULL || p_statement->get_parent() != this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement-owner]: statement=%p has "
            "invalid wrapped statement=%p owner=%p\n",
            static_cast<const void *>(this), static_cast<void *>(p_statement),
            static_cast<void *>(p_statement != NULL ? p_statement->get_parent()
                                                    : NULL));
    ROSE_ABORT();
  }
  return p_statement;
}

SgStatement *
SgAttributedStatement::replace_statement(SgStatement *replacement) {
  if (p_statement == NULL || p_statement->get_parent() != this ||
      replacement == NULL || replacement == p_statement ||
      replacement->get_parent() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement-replacement]: statement=%p "
            "cannot replace wrapped=%p with replacement=%p owner=%p\n",
            static_cast<void *>(this), static_cast<void *>(p_statement),
            static_cast<void *>(replacement),
            static_cast<void *>(replacement != NULL ? replacement->get_parent()
                                                    : NULL));
    ROSE_ABORT();
  }
  SgStatement *old_statement = p_statement;
  old_statement->set_parent(NULL);
  p_statement = replacement;
  replacement->set_parent(this);
  return old_statement;
}

void SgAttributedStatement::validate() const {
  const SgStatementAttributeList *attribute_list = get_attribute_list();
  attribute_list->validate();
  if (attribute_list->get_attributes().empty()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attributed-statement]: statement=%p has no "
            "explicit attributes\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  (void)get_statement();
}
SOURCE_ATTRIBUTED_STATEMENT_END

SOURCE_TYPEDEF_DECLARATION_STATEMENT_START

void SgTypedefDeclaration::post_construction_initialization() {
  ROSE_ASSERT(get_base_type() != NULL);
  if (get_base_type()->has_source_prototype()) {
    ROSE_ASSERT(get_base_type()->get_parent() == nullptr);
    get_base_type()->set_parent(this);
  }
}


bool SgTypedefDeclaration::replace_child(SgStatement *target,
                                         SgStatement *newstmt,
                                         bool extractBasicBlock) {
  return (StatementReplace(this, p_declaration, target, newstmt) == true);
}

SgName SgTypedefDeclaration::get_qualified_name() const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);
  return SgName::assembleQualifiedName(scope->get_qualified_name(), get_name());
}

SgName SgTypedefDeclaration::get_mangled_name(void) const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);
  std::string mangledNameString = SageInterface::getMangledNameFromCache(
      const_cast<SgTypedefDeclaration *>(this));
  if (mangledNameString.empty() == false) {
    return mangledNameString;
  } else {
    SgName mangledName;
    SgType *baseType = get_base_type();

    ROSE_ASSERT(baseType != NULL);

    const SgName mangleQualifiersString = mangleQualifiers(scope);

    // DQ (9/6/2016): We require a prefix to the name to avoid name collisions
    // (see test2005_199.C and simplified test (but non-failing) in
    // test2016_60.C).
    SgName prefixed_name = "typedef_" + get_name();

    mangledName = joinMangledQualifiers(mangleQualifiersString, prefixed_name);
    // DQ (1/29/2007): We need to make this more specific to this IR nodes so
    // that a typedef of an unnamed struct does not be mangled to be the same
    // name
    mangledName += "__typedef_declaration";
    ROSE_ASSERT(mangledName.get_length() > 0);

    mangledName = SageInterface::addMangledNameToCache(
        const_cast<SgTypedefDeclaration *>(this), mangledName);
    return mangledName;
  }
}

bool SgTypedefDeclaration::hasExplicitScope() const {
  return true;
}

SgSymbol *SgTypedefDeclaration::get_symbol_from_symbol_table() const {
  ROSE_ASSERT(get_scope() != NULL);
  return get_scope()->find_symbol_from_declaration(this);
}

// Return only a structurally owned base tag.  p_declaration also records the
// declaration referenced by an ordinary named base type, so pointer identity
// alone is not an ownership edge.  Exact parentage distinguishes the two and
// lets traversal include source-spelled nondefining tag introductions without
// crossing through shared type declarations.
SgDeclarationStatement *
SgTypedefDeclaration::compute_baseTypeDefiningDeclaration() const {
  return p_declaration != NULL && p_declaration->get_parent() == this
             ? p_declaration
             : NULL;
}

SgDeclarationStatement *
SgTypedefDeclaration::get_baseTypeDefiningDeclaration() const {
  if (!p_typedefBaseTypeContainsDefiningDeclaration) {
    return NULL;
  }

  SgDeclarationStatement *declaration = compute_baseTypeDefiningDeclaration();
  SgClassDeclaration *class_declaration = isSgClassDeclaration(declaration);
  SgEnumDeclaration *enum_declaration = isSgEnumDeclaration(declaration);
  SgScopeStatement *semantic_scope =
      declaration != NULL ? declaration->get_scope() : NULL;
  SgDeclarationStatement *canonical =
      declaration != NULL ? declaration->get_firstNondefiningDeclaration()
                          : NULL;
  const bool exact_qualified_semantic_owner =
      declaration != NULL && semantic_scope != NULL && canonical != NULL &&
      canonical != declaration &&
      canonical->get_firstNondefiningDeclaration() == canonical &&
      canonical->get_definingDeclaration() == declaration &&
      canonical->get_scope() == semantic_scope &&
      semantic_scope->find_symbol_from_declaration(canonical) != NULL &&
      declaration->get_source_name_qualification_present() &&
      (declaration->get_source_name_global_qualification() ||
       !declaration->get_source_name_qualification_tokens().empty());
  if (declaration == NULL ||
      (semantic_scope != get_scope() && !exact_qualified_semantic_owner) ||
      declaration->get_definingDeclaration() != declaration ||
      (class_declaration == NULL && enum_declaration == NULL) ||
      (class_declaration != NULL &&
       (class_declaration->get_definition() == NULL ||
        class_declaration->get_isAutonomousDeclaration())) ||
      (enum_declaration != NULL &&
       enum_declaration->get_isAutonomousDeclaration())) {
    fprintf(stderr,
            "REX_AST_INVARIANT[typedef-inline-tag-definition-owner]: "
            "typedef=%p declaration=%p is not one exact owned "
            "non-autonomous class/enum definition\n",
            static_cast<const void *>(this), static_cast<void *>(declaration));
    ROSE_ABORT();
  }

  return declaration;
}

SgDeclarationStatement *
SgTypedefDeclaration::get_baseTypeNondefiningDeclaration() const {
  if (p_typedefBaseTypeContainsDefiningDeclaration) {
    return NULL;
  }

  SgDeclarationStatement *declaration = compute_baseTypeDefiningDeclaration();
  if (declaration == NULL) {
    return NULL;
  }

  SgClassDeclaration *class_declaration = isSgClassDeclaration(declaration);
  SgEnumDeclaration *enum_declaration = isSgEnumDeclaration(declaration);
  const bool exact_class_introduction =
      class_declaration != NULL && class_declaration->get_definition() == NULL;
  const bool exact_enum_introduction =
      enum_declaration != NULL && enum_declaration->isForward();
  SgScopeStatement *semantic_scope = declaration->get_scope();
  const bool exact_distinct_semantic_owner =
      semantic_scope != NULL && semantic_scope != get_scope() &&
      semantic_scope->find_symbol_from_declaration(declaration) != NULL;
  if ((semantic_scope != get_scope() && !exact_distinct_semantic_owner) ||
      declaration->get_firstNondefiningDeclaration() != declaration ||
      declaration->get_definingDeclaration() == declaration ||
      (!exact_class_introduction && !exact_enum_introduction) ||
      (class_declaration != NULL &&
       class_declaration->get_isAutonomousDeclaration()) ||
      (enum_declaration != NULL &&
       enum_declaration->get_isAutonomousDeclaration())) {
    fprintf(stderr,
            "REX_AST_INVARIANT[typedef-inline-tag-introduction-owner]: "
            "typedef=%p declaration=%p/%s parent=%p scope=%p expected-scope=%p "
            "first=%p defining=%p autonomous=%d class-definition=%p "
            "is not one exact owned non-autonomous tag introduction\n",
            static_cast<const void *>(this), static_cast<void *>(declaration),
            declaration->class_name().c_str(),
            static_cast<void *>(declaration->get_parent()),
            static_cast<void *>(declaration->get_scope()),
            static_cast<void *>(get_scope()),
            static_cast<void *>(declaration->get_firstNondefiningDeclaration()),
            static_cast<void *>(declaration->get_definingDeclaration()),
            class_declaration != NULL &&
                    class_declaration->get_isAutonomousDeclaration()
                ? 1
                : 0,
            static_cast<void *>(class_declaration != NULL
                                    ? class_declaration->get_definition()
                                    : NULL));
    ROSE_ABORT();
  }

  return declaration;
}

