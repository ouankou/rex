SOURCE_CASE_OPTION_STATEMENT_START

void SgCaseOptionStmt::post_construction_initialization() {
  if (p_key != nullptr)
    p_key->set_parent(this);
  if (p_body != nullptr)
    p_body->set_parent(this);
}

bool SgCaseOptionStmt::replace_child(SgStatement *target, SgStatement *newstmt,
                                     bool extractBasicBlock) {
  return (StatementReplace(this, p_body, target, newstmt) == true);
}

bool SgCaseOptionStmt::insert_child(SgStatement *target, SgStatement *newstmt,
                                    bool inFront, bool extractBasicBlock) {
  if (p_body == NULL || target == NULL) {
    return false;
  }

  // SgCaseOptionStmt has a body where statements can be inserted
  SgBasicBlock *case_body = isSgBasicBlock(p_body);
  if (case_body == NULL) {
    if (p_body != target) {
      return false;
    }

    case_body = SageBuilder::buildBasicBlock(p_body);
    case_body->set_parent(this);
    set_body(case_body);
  }

  // Try inserting into case body
  return StatementListInsertChild(case_body, case_body->get_statements(),
                                  target, newstmt, inFront, extractBasicBlock,
                                  false);
}

SOURCE_CASE_OPTION_STATEMENT_END

SOURCE_TRY_STATEMENT_START

void SgTryStmt::post_construction_initialization() {
  if (get_catch_statement_seq_root() == NULL) {
    Sg_File_Info *fileInfo = NULL;
    if (this->get_file_info() != NULL) {
      fileInfo = new Sg_File_Info(*(this->get_file_info()));
    }
    SgCatchStatementSeq *catchStatement = NULL;
    if (fileInfo != NULL) {
      catchStatement = new SgCatchStatementSeq(fileInfo);
      fileInfo->set_parent(catchStatement);
      catchStatement->set_endOfConstruct(New_File_Info(catchStatement));
      catchStatement->get_endOfConstruct()->set_parent(catchStatement);
    } else {
      catchStatement = new SgCatchStatementSeq();
    }

    set_catch_statement_seq_root(catchStatement);
    catchStatement->set_parent(this);
  }
}

bool SgTryStmt::replace_child(SgStatement *target, SgStatement *newstmt,
                              bool extractBasicBlock) {
  if (StatementReplace(this, p_body, target, newstmt) == true)
    return true;
  else
    return (StatementReplace(this, p_catch_statement_seq_root, target,
                             newstmt) == true);
}

SgStatementPtrList &SgTryStmt::get_catch_statement_seq() {
  return get_catch_statement_seq_root()->get_catch_statement_seq();
}

const SgStatementPtrList &SgTryStmt::get_catch_statement_seq() const {
  return get_catch_statement_seq_root()->get_catch_statement_seq();
}

void SgTryStmt::append_catch_statement(SgStatement *what) {
  SgCatchStatementSeq *catchStatementList = get_catch_statement_seq_root();
  ROSE_ASSERT(catchStatementList != NULL);
  catchStatementList->append_catch_statement(what);
}

void SgTryStmt::prepend_catch_statement(SgStatement *what) {
  SgCatchStatementSeq *catchStatementList = get_catch_statement_seq_root();
  ROSE_ASSERT(catchStatementList != NULL);
  catchStatementList->prepend_catch_statement(what);
}

SOURCE_TRY_STATEMENT_END

SOURCE_CATCH_STATEMENT_SEQ_START

void SgCatchStatementSeq::post_construction_initialization() {
  ROSE_ASSERT(get_catch_statement_seq().empty());
}

void SgCatchStatementSeq::append_catch_statement(SgStatement *what) {
  ROSE_ASSERT(isSgCatchOptionStmt(what) != nullptr &&
              what->get_parent() == nullptr);
  ROSE_ASSERT(std::find(get_catch_statement_seq().begin(),
                        get_catch_statement_seq().end(), what) ==
              get_catch_statement_seq().end());
  get_catch_statement_seq().push_back(what);
  what->set_parent(this);
}

void SgCatchStatementSeq::prepend_catch_statement(SgStatement *what) {
  ROSE_ASSERT(isSgCatchOptionStmt(what) != nullptr &&
              what->get_parent() == nullptr);
  ROSE_ASSERT(std::find(get_catch_statement_seq().begin(),
                        get_catch_statement_seq().end(), what) ==
              get_catch_statement_seq().end());
  get_catch_statement_seq().insert(get_catch_statement_seq().begin(), what);
  what->set_parent(this);
}

SOURCE_CATCH_STATEMENT_SEQ_END

SOURCE_CATCH_OPTION_STATEMENT_START

void SgCatchOptionStmt::post_construction_initialization() {
}


bool SgCatchOptionStmt::replace_child(SgStatement *target, SgStatement *newstmt,
                                      bool extractBasicBlock) {
  if (StatementReplace(this, p_condition, target, newstmt) == true)
    return true;
  else if (StatementReplace(this, p_body, target, newstmt) == true)
    return true;
  else
    return false;
}

SgName SgCatchOptionStmt::get_mangled_name(void) const {
  // DQ (2/22/2007): This function is added to prevent "::" substrings in
  // mangled names of other declarations.
  return SgName("");
}

