SOURCE_FUNCTION_PARAMETER_SCOPE_START

void SgFunctionParameterScope::post_construction_initialization() {
  p_construction_physical_output_owner = NULL;
  p_construction_semantic_scope = NULL;
  p_completed_semantic_scope = NULL;
}

SgName SgFunctionParameterScope::get_mangled_name(void) const {
  // PP (06/01/20) - just return some name
  // (or should the name be composed form the parent declaration?)
  return SgName("__function_parameter_scope__");
}

SgScopeStatement *SgFunctionParameterScope::get_scope(void) const {
  SgScopeStatement *physicalOwner = get_construction_physical_output_owner();
  SgScopeStatement *semanticScope = get_construction_semantic_scope();
  SgScopeStatement *completedSemanticScope = get_completed_semantic_scope();
  if (get_parent() == NULL) {
    if (physicalOwner == NULL || semanticScope == NULL ||
        physicalOwner == this || semanticScope == this ||
        completedSemanticScope != NULL) {
      fprintf(stderr,
              "REX_AST_INVARIANT[detached-parameter-semantic-scope]: "
              "scope=%p physical-owner=%p semantic-scope=%p does not form "
              "one exact detached construction transaction\n",
              static_cast<const void *>(this),
              static_cast<void *>(physicalOwner),
              static_cast<void *>(semanticScope));
      ROSE_ABORT();
    }
    return semanticScope;
  }

  SgFunctionDeclaration *declaration = isSgFunctionDeclaration(get_parent());
  SgRequiresExpr *requiresExpression = isSgRequiresExpr(get_parent());
  const bool completedFunctionOwner =
      declaration != NULL && declaration->get_functionParameterScope() == this;
  const bool completedRequiresOwner =
      requiresExpression != NULL &&
      requiresExpression->get_local_parameter_scope() == this &&
      requiresExpression->get_local_parameter_list() != NULL &&
      requiresExpression->get_local_parameter_list()->get_parent() ==
          requiresExpression;
  if (physicalOwner != NULL || semanticScope != NULL ||
      completedFunctionOwner == completedRequiresOwner) {
    fprintf(
        stderr,
        "REX_AST_INVARIANT[attached-parameter-semantic-scope]: scope=%p "
        "parent=%p/%s physical-owner=%p semantic-scope=%p completed-scope=%p "
        "function-owner=%d requires-owner=%d is not exactly owned by "
        "one completed declarative region\n",
        static_cast<const void *>(this), static_cast<void *>(get_parent()),
        get_parent() != NULL ? get_parent()->class_name().c_str() : "<null>",
        static_cast<void *>(physicalOwner), static_cast<void *>(semanticScope),
        static_cast<void *>(completedSemanticScope),
        completedFunctionOwner ? 1 : 0, completedRequiresOwner ? 1 : 0);
    ROSE_ABORT();
  }
  if (completedFunctionOwner) {
    if (completedSemanticScope != NULL || declaration->get_scope() == this) {
      fprintf(stderr,
              "REX_AST_INVARIANT[attached-parameter-semantic-scope]: "
              "scope=%p function=%p has completed-scope=%p or recursively "
              "owns itself\n",
              static_cast<const void *>(this), static_cast<void *>(declaration),
              static_cast<void *>(completedSemanticScope));
      ROSE_ABORT();
    }
    return declaration->get_scope();
  }
  if (completedSemanticScope == NULL || completedSemanticScope == this) {
    fprintf(stderr,
            "REX_AST_INVARIANT[attached-parameter-semantic-scope]: "
            "requires-parameter scope=%p has invalid completed-scope=%p\n",
            static_cast<const void *>(this),
            static_cast<void *>(completedSemanticScope));
    ROSE_ABORT();
  }
  return completedSemanticScope;
}

void SgFunctionParameterScope::append_declaration(
    SgDeclarationStatement *what) {
  get_declarations().push_back(what);
  what->set_parent(this);
}

void SgFunctionParameterScope::prepend_declaration(
    SgDeclarationStatement *what) {
  get_declarations().insert(get_declarations().begin(), what);
  what->set_parent(this);
}

bool SgFunctionParameterScope::insert_child(SgStatement *target,
                                            SgStatement *newstmt, bool inFront,
                                            bool extractBasicBlock) {
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  inFront, extractBasicBlock, false);
}

bool SgFunctionParameterScope::replace_child(SgStatement *target,
                                             SgStatement *newstmt,
                                             bool extractBasicBlock) {
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  true, extractBasicBlock, true);
}

SOURCE_FUNCTION_PARAMETER_SCOPE_END

SOURCE_DECLARATION_SCOPE_START

void SgDeclarationScope::post_construction_initialization() {
  // Nothing to do here, but we need this function to be defined.
}

// DQ (7/20/2017): I think that the mangled name support requires the definition
// of this function.
SgName SgDeclarationScope::get_mangled_name(void) const {
  // Use the owning declaration's mangled name when available so that
  // declaration scopes are stable and distinguishable in name mangling.
  if (SgDeclarationStatement *decl = isSgDeclarationStatement(get_parent())) {
    return decl->get_mangled_name() + SgName("__declaration_scope__");
  }
  if (const SgScopeStatement *scope = isSgScopeStatement(get_parent())) {
    return scope->get_mangled_name() + SgName("__declaration_scope__");
  }

  return SgName("__declaration_scope__");
}

// DQ (7/19/2017): Added to support qualified name generation
SgName SgDeclarationScope::get_qualified_name() const {
  SgNode *p = get_parent();
  if (SgTemplateFunctionDeclaration *tplfn =
          isSgTemplateFunctionDeclaration(p)) {
    return tplfn->get_qualified_name();
  } else if (SgTemplateClassDeclaration *tplclass =
                 isSgTemplateClassDeclaration(p)) {
    return tplclass->get_qualified_name();
  } else if (SgTemplateTypedefDeclaration *tpltypedef =
                 isSgTemplateTypedefDeclaration(p)) {
    return tpltypedef->get_qualified_name();
  } else if (SgTemplateDeclaration *tpldecl = isSgTemplateDeclaration(p)) {
    return tpldecl->get_qualified_name();
  } else if (SgNonrealDecl *nrdecl = isSgNonrealDecl(p)) {
    return nrdecl->get_qualified_name();
  } else if (SgClassDeclaration *cdecl = isSgClassDeclaration(p)) {
    return cdecl->get_qualified_name();
  } else if (SgMemberFunctionDeclaration *mfdecl =
                 isSgMemberFunctionDeclaration(p)) {
    return mfdecl->get_qualified_name();
  } else if (SgFunctionDeclaration *fdecl = isSgFunctionDeclaration(p)) {
    return fdecl->get_qualified_name();
  } else if (SgTypedefDeclaration *tdef = isSgTypedefDeclaration(p)) {
    return tdef->get_qualified_name();
  } else if (SgEnumDeclaration *edecl = isSgEnumDeclaration(p)) {
    return edecl->get_qualified_name();
  } else if (SgNamespaceDeclarationStatement *ndecl =
                 isSgNamespaceDeclarationStatement(p)) {
    return ndecl->get_qualified_name();
  } else if (SgScopeStatement *scope = isSgScopeStatement(p)) {
    return scope->get_qualified_name();
  }

  std::string globalScopeDelimiter = "";
  return SgName(globalScopeDelimiter);
}

void SgDeclarationScope::append_declaration(SgDeclarationStatement *what) {
  if (what == NULL)
    return;

  get_declarations().push_back(what);
  what->set_scope(this);
  what->set_parent(this);
}

void SgDeclarationScope::prepend_declaration(SgDeclarationStatement *what) {
  if (what == NULL)
    return;

  get_declarations().insert(get_declarations().begin(), what);
  what->set_scope(this);
  what->set_parent(this);
}

void SgDeclarationScope::setChildScope(SgStatement *newstmt,
                                       bool extractBasicBlock) {
  if (SgDeclarationStatement *decl = isSgDeclarationStatement(newstmt)) {
    decl->set_scope(this);
    decl->set_parent(this);
    return;
  }

  if (!extractBasicBlock) {
    return;
  }

  if (SgBasicBlock *bb = isSgBasicBlock(newstmt)) {
    const SgStatementPtrList &stmts = bb->get_statements();
    for (SgStatementPtrList::const_iterator it = stmts.begin();
         it != stmts.end(); ++it) {
      if (SgDeclarationStatement *decl_in_bb = isSgDeclarationStatement(*it)) {
        decl_in_bb->set_scope(this);
      }
    }
  }
}

bool SgDeclarationScope::insert_child(SgStatement *target, SgStatement *newstmt,
                                      bool inFront, bool extractBasicBlock) {
  setChildScope(newstmt, extractBasicBlock);
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  inFront, extractBasicBlock, false);
}

bool SgDeclarationScope::replace_child(SgStatement *target,
                                       SgStatement *newstmt,
                                       bool extractBasicBlock) {
  setChildScope(newstmt, extractBasicBlock);
  return StatementListInsertChild(this, get_declarations(), target, newstmt,
                                  true, extractBasicBlock, true);
}

SOURCE_DECLARATION_SCOPE_END

SOURCE_FUNCTION_DECLARATION_STATEMENT_START

SgFunctionDeclaration::frontend_source_ownership_enum
SgFunctionDeclaration::get_frontend_source_ownership() const {
  return p_frontend_source_ownership;
}

SgFunctionDeclaration::frontend_declaration_origin_enum
SgFunctionDeclaration::get_frontend_declaration_origin() const {
  return p_frontend_declaration_origin;
}

void SgFunctionDeclaration::initialize_frontend_source_ownership(
    frontend_source_ownership_enum ownership) {
  if (ownership <= e_frontend_source_unclassified ||
      ownership > e_frontend_source_implicit) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-frontend-source-ownership]: "
            "function=%p type=%s name=%s cannot publish invalid ownership=%d\n",
            static_cast<void *>(this), class_name().c_str(),
            get_name().getString().c_str(), static_cast<int>(ownership));
    ROSE_ABORT();
  }
  if (p_frontend_source_ownership != e_frontend_source_unclassified) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-frontend-source-ownership]: "
            "function=%p type=%s name=%s cannot replace ownership=%d with %d\n",
            static_cast<void *>(this), class_name().c_str(),
            get_name().getString().c_str(),
            static_cast<int>(p_frontend_source_ownership),
            static_cast<int>(ownership));
    ROSE_ABORT();
  }
  p_frontend_source_ownership = ownership;
}

void SgFunctionDeclaration::initialize_frontend_declaration_origin(
    frontend_declaration_origin_enum origin) {
  if (origin <= e_frontend_declaration_unclassified ||
      origin > e_frontend_declaration_implicit) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-frontend-declaration-origin]: "
            "function=%p type=%s name=%s cannot publish invalid origin=%d\n",
            static_cast<void *>(this), class_name().c_str(),
            get_name().getString().c_str(), static_cast<int>(origin));
    ROSE_ABORT();
  }
  if (p_frontend_declaration_origin != e_frontend_declaration_unclassified) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-frontend-declaration-origin]: "
            "function=%p type=%s name=%s cannot replace origin=%d with %d\n",
            static_cast<void *>(this), class_name().c_str(),
            get_name().getString().c_str(),
            static_cast<int>(p_frontend_declaration_origin),
            static_cast<int>(origin));
    ROSE_ABORT();
  }
  p_frontend_declaration_origin = origin;
}

const SgName &
SgFunctionDeclaration::get_fortran_anonymous_program_unit_symbol_key() const {
  return p_fortran_anonymous_program_unit_symbol_key;
}

void SgFunctionDeclaration::
    initialize_fortran_anonymous_program_unit_symbol_key(const SgName &key) {
  const SgProgramHeaderStatement *program = isSgProgramHeaderStatement(this);
  const bool anonymous_program =
      program != nullptr &&
      program->get_program_statement_kind() ==
          SgProgramHeaderStatement::e_implicit_program_statement;
  const SgProcedureHeaderStatement *procedure =
      isSgProcedureHeaderStatement(this);
  const bool unnamed_block_data =
      procedure != nullptr && procedure->isBlockData() &&
      procedure->get_block_data_name_kind() ==
          SgProcedureHeaderStatement::e_unnamed_block_data;
  const std::string key_string = key.getString();
  const std::string required_prefix =
      anonymous_program ? "__rex_internal_implicit_program_"
                        : "__rex_internal_unnamed_block_data_";
  if ((!anonymous_program && !unnamed_block_data) || key.is_null() ||
      !get_name().is_null() || key_string.rfind(required_prefix, 0) != 0) {
    fprintf(stderr,
            "REX_AST_INVARIANT[anonymous-program-unit-symbol-key]: "
            "declaration=%p type=%s cannot initialize key='%s' for its "
            "typed source identity\n",
            static_cast<void *>(this), class_name().c_str(),
            key_string.c_str());
    ROSE_ABORT();
  }
  if (!p_fortran_anonymous_program_unit_symbol_key.is_null()) {
    const std::string current_key =
        p_fortran_anonymous_program_unit_symbol_key.getString();
    fprintf(stderr,
            "REX_AST_INVARIANT[anonymous-program-unit-symbol-key]: "
            "declaration=%p type=%s cannot replace key='%s' with '%s'\n",
            static_cast<void *>(this), class_name().c_str(),
            current_key.c_str(), key_string.c_str());
    ROSE_ABORT();
  }
  p_fortran_anonymous_program_unit_symbol_key = key;
}

void SgFunctionDeclaration::post_construction_initialization() {
  // Sg_File_Info* thisFileInfo = get_file_info();
  // ROSE_ASSERT (thisFileInfo != NULL);

  // DQ (10/25/2004): Force generation of new file info object (all such objects
  // should be unique) initialize the FunctionParameterList as an object that is
  // referred to from FunctionDeclaration Sg_File_Info* fileInfo = new
  // Sg_File_Info(*thisFileInfo); ROSE_ASSERT (fileInfo != NULL);

  // DQ (11/12/2006): Modified to permit being called by constructor without
  // Sg_File_Info objects. DQ (7/19/2005): set parameter list on a single
  // location (and independently of existence of function parameters) p_args =
  // new SgFunctionParameterList(fileInfo);
  SgFunctionParameterList *args = NULL;
  if (get_startOfConstruct() != NULL) {
    args = new SgFunctionParameterList(New_File_Info(this));
    args->get_startOfConstruct()->set_parent(args);
  } else {
    // DQ (11/12/2006): Use the new constructor.
    args = new SgFunctionParameterList();
  }
  ROSE_ASSERT(args != NULL);
  set_parameterList(args);

  // DQ (7/19/2005): set the parent explicitly
  get_parameterList()->set_parent(this);

  // DQ (3/6/2007): Set the firstNondefiningDeclaration of args to itself (this
  // is now required for the AST consistency tests after the AST merge).  Likely
  // because one where a member function is referenced before being declared in
  // a class the member function was not previously visited by the AST traversal
  // and so one of its defining or non-defining declarations was not set and
  // after the merge this declaration is used (shared) and thus accessed where
  // before it had been hidden. DQ (3/15/2006): Let this be NULL so that it will
  // be fixed by the fixupDeclarations function within the post processing
  // phase. DQ (9/6/2005): Since a SgFunctionParameterList is a
  // SgDeclarationStatement we should set either its defining or non-defining
  // declaration (I choose the non-defining declaration).
  // args->set_definingDeclaration(args);
  // args->set_firstNondefiningDeclaration(args);
  args->set_firstNondefiningDeclaration(args);

  // DQ (10/25/2004): Add a ending file info object for completeness (though
  // this is not yet initialized to the correct position, yet).  Initially let's
  // get them in place then we can work on the accuracy afterward! Sg_File_Info*
  // endingPosition = new Sg_File_Info(*thisFileInfo); ROSE_ASSERT
  // (endingPosition != NULL); p_args->set_endOfConstruct(endingPosition);

  // DQ (7/31/2006): Explicit initialization of this data member is required!
  // JJW (8/6/2008): It probably isn't now that p_exceptionSpecification is a
  // vector
  p_exceptionSpecification.clear();
  p_sourceSpelledTemplateHeaders.clear();

  // DQ (5/14/2011): Added to support name qualification on types referenced by
  // template arguments.
  p_name_qualification_length = 0;
  p_type_elaboration_required = false;
  p_global_qualification_required = false;

  // DQ (5/14/2011): Added to support name qualification on types referenced by
  // template arguments.
  p_name_qualification_length_for_return_type = 0;
  p_type_elaboration_required_for_return_type = false;
  p_global_qualification_required_for_return_type = false;
}

SgType *SgFunctionDeclaration::get_orig_return_type() const {
  // PP (9/16/25): store the original return type with type_syntax.
  //               if nullptr, take it from type.
  SgFunctionType *fntype = this->get_type_syntax();

  if (fntype == nullptr)
    fntype = this->get_type();

  ASSERT_not_null(fntype);
  return fntype->get_return_type();
}

void SgFunctionDeclaration::validate_source_declarator_form() const {
  if (!get_source_declarator_uses_wrapped_function_type()) {
    return;
  }

  SgFunctionType *syntax_type = get_type_syntax();
  SgType *source_type =
      syntax_type != nullptr ? syntax_type->get_return_type() : nullptr;
  SgTypedefType *source_typedef = isSgTypedefType(source_type);
  const bool exact_wrapped_function_type =
      isSgTypeOfType(source_type) != nullptr ||
      (source_typedef != nullptr &&
       isSgFunctionType(source_typedef->get_base_type()) != nullptr);
  if (!get_type_syntax_is_available() || syntax_type == nullptr ||
      syntax_type == get_type() || syntax_type->get_parent() != this ||
      !exact_wrapped_function_type || get_parameterList_syntax() != nullptr ||
      get_oldStyleDefinition() || get_prototypeIsWithoutParameters()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[function-declarator-source-form]: "
            "function=%p name=%s claims a wrapped function declarator "
            "without one exact source syntax (syntax=%p source-type=%p "
            "parameter-syntax=%p old-style=%d parameterless-prototype=%d)\n",
            static_cast<const void *>(this), get_name().str(),
            static_cast<void *>(syntax_type), static_cast<void *>(source_type),
            static_cast<void *>(get_parameterList_syntax()),
            get_oldStyleDefinition() ? 1 : 0,
            get_prototypeIsWithoutParameters() ? 1 : 0);
    ROSE_ABORT();
  }
}

void SgFunctionDeclaration::validate_cuda_launch_bounds_expression() const {
  SgExpression *expression = get_cuda_launch_bounds_expression();
  if (expression == nullptr) {
    return;
  }
  SgType *type = expression->get_type();
  if (expression->get_parent() != this || type == nullptr ||
      isSgTypeUnknown(type) != nullptr || isSgTypeDefault(type) != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[cuda-launch-bounds]: function=%p has a launch "
            "bounds expression without exact ownership and semantic type\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
}

void SgFunctionDeclaration::hasEllipses() {
  // Record as true!
  get_type()->set_has_ellipses(1);
}

void SgFunctionDeclaration::append_arg(SgInitializedName *what) {
  // DQ (7/19/2005): This is now set in the post_construction_initialization()
  ROSE_ASSERT(get_parameterList() != NULL);

  get_parameterList()->append_arg(what);
}

void SgFunctionDeclaration::prepend_arg(SgInitializedName *what) {
  // DQ (7/19/2005): This is now set in the post_construction_initialization()
  ROSE_ASSERT(get_parameterList() != NULL);

  get_parameterList()->prepend_arg(what);
}

SgInitializedNamePtrList &SgFunctionDeclaration::get_args() {
  // DQ (7/19/2005): This is now set in the post_construction_initialization()
  ROSE_ASSERT(get_parameterList() != NULL);

  return get_parameterList()->get_args();
}

const SgInitializedNamePtrList &SgFunctionDeclaration::get_args() const {
  // QY:11/2/04 should make sure get_parameterList() != 0
  assert(get_parameterList() != NULL);
  return get_parameterList()->get_args();
}

// QY:11/2/04: Removed p_mangled_name member because it is always obtained from
// p_type anyway void $CLASSNAME::set_mangled_name()
//   {
//     SgUnparse_Info info;
//     info.set_decl_stmt((SgDeclarationStatement *)this);
//     info.set_name(p_name);
//     info.set_PrintName();
//     if(p_type)
//          p_mangled_name=p_type->get_mangled(info);
//   }

bool SgFunctionDeclaration::isTemplateFunction() const {
  // DQ (4/28/2005): This function tests for a template function. It is
  // non-trivial because we combine both non-template member functions in
  // templated classes (or nested classes of templated classes) with member
  // functions that are templated.

  bool returnValue = false;

  const SgTemplateInstantiationFunctionDecl *templateFunction =
      isSgTemplateInstantiationFunctionDecl(this);
  if (templateFunction != NULL) {
    returnValue = true;

    // Error checking
    ROSE_ASSERT(templateFunction->get_templateDeclaration() != NULL);

    // DQ (12/23/2011): With the new design we no long have this data member.
    // ROSE_ASSERT(templateFunction->get_templateDeclaration()->get_template_kind()
    // == SgTemplateDeclaration::e_template_function /* 3 */);
  } else {
    const SgTemplateInstantiationMemberFunctionDecl *templateMemberFunction =
        isSgTemplateInstantiationMemberFunctionDecl(this);
    if (templateMemberFunction != NULL) {
      // ROSE_ASSERT(templateMemberFunction->get_templateArguments() != NULL);
      int numberOfTemplateArguments =
          templateMemberFunction->get_templateArguments().size();

      // printf ("Number of template arguments  = %d
      // \n",numberOfTemplateArguments);

      if (numberOfTemplateArguments == 0) {
        // This is the case of a non-template member function in a templated
        // class or nested class of a templated class! printf ("This is the case
        // of a non-template member function in a templated class or nested
        // class of a templated class \n");
        returnValue = false;

        // Error checking
        // DQ (4/17/2016): We have to allow this in some more complex template
        // instantiations (I think). It might be work some discussion and at
        // some point.  The case where this happens is in the instatiation of
        // nexted template inside of outer templates and we only have a record
        // of the outer template from the instantiation (in legacy frontend).
        if (templateMemberFunction->get_templateDeclaration() == NULL) {
        }
        // ROSE_ASSERT(templateMemberFunction->get_templateDeclaration() !=
        // NULL);
      } else {
        // printf ("This is a valid templated member function!
        // numberOfTemplateArguments = %d \n",numberOfTemplateArguments);
        returnValue = true;
      }

      // printf ("type of template declaration = %d returnValue = %s
      // \n",templateDeclaration->get_template_kind(),returnValue ? "true" :
      // "false");
    }
  }

  return returnValue;
}

// DQ (2/7/2006): New version added by Rich Vuduc
SgName SgFunctionDeclaration::get_mangled_name() const {
  // RV (1/31/2006): Changed this routine to include the name
  // qualification in the mangled name, to guarantee the returned
  // string identifies a function uniquely. Moreover, the
  // SgMemberFunctionDeclaration child class then automatically
  // inherits the correct behavior.
  //! \todo Update ROSE manual to document the revised mangling scheme.

  // DQ (4/27/2005): I have considered making this the qualified
  // name, but decided against it. See notes in the ROSE manual
  // appendix about mangled names and qualified names.

  ROSE_ASSERT(this != NULL);

#define DEBUG_FUNCDECL_MANGLED_NAMES 0

#if DEBUG_FUNCDECL_MANGLED_NAMES
  printf("In SgFunctionDeclaration::get_mangled_name() for this = %p = %s \n",
         this, this->class_name().c_str());
#endif

  // DQ (3/12/2007): Experiment with mangled name map (caching for performance
  // improvement) SgFunctionDeclaration* function =
  // const_cast<SgFunctionDeclaration*>(this);
  // std::map<SgNode*,std::string>::iterator i =
  // p_globalMangledNameMap.find(function); if (i !=
  // p_globalMangledNameMap.end())
  std::string mangledNameString = SageInterface::getMangledNameFromCache(
      const_cast<SgFunctionDeclaration *>(this));

#if DEBUG_FUNCDECL_MANGLED_NAMES
  printf("Inside of SgFunctionDeclaration::get_mangled_name(): "
         "mangledNameString.empty() = %s \n",
         mangledNameString.empty() ? "true" : "false");
#endif

  if (mangledNameString.empty() == false) {
    // return i->second.c_str();
#if DEBUG_FUNCDECL_MANGLED_NAMES
    printf(
        "RETURN FROM CACHE: Inside of "
        "SgFunctionDeclaration::get_mangled_name(): mangledNameString = %s \n",
        mangledNameString.c_str());
#endif
    return mangledNameString;
  } else {
    SgName mangledName;

    // DQ (6/23/2010): Added support to maintain separate "main()" functions as
    // unique (to avoid them being merged).
    if (this->get_name() == "main") {
      // Append the pointer to the name to make this unique to avoid multiple
      // function "main()" from being merged.
      mangledName = "main_";
      mangledName += Rose::StringUtility::numberToString(
          const_cast<SgFunctionDeclaration *>(this));
      // printf ("RETURN FROM DETECTED MAIN: Inside of
      // SgFunctionDeclaration::get_mangled_name(): mangledName = %s
      // \n",mangledName.str());
      return mangledName;
    }

    // Compute a mangled name from this function's type
    SgName type_name;
    SgName ret_type_name;
    SgFunctionType const *func_type = get_type();
    if (func_type != NULL) {
      // PP (09/16/2025): use return type from specified by type_syntax if
      // available
      //                  and the return type specified by type otherwise.
      SgType *ret_type = this->get_orig_return_type();
      ASSERT_not_null(ret_type);
      ret_type_name = ret_type->get_mangled();
      type_name =
          SgFunctionType::get_mangled(ret_type, func_type->get_argument_list());
    } else {
      type_name = "defaultFunctionTypeName";
    }

#if DEBUG_FUNCDECL_MANGLED_NAMES
    printf("Inside of SgFunctionDeclaration::get_mangled_name(): type_name     "
           "= %s \n",
           type_name.str());
    printf("Inside of SgFunctionDeclaration::get_mangled_name(): ret_type_name "
           "= %s \n",
           ret_type_name.str());
#endif
    // This function's name, transformed.
    SgName func_name = mangleFunctionName(get_name(), ret_type_name);
#if DEBUG_FUNCDECL_MANGLED_NAMES
    printf("Inside of SgFunctionDeclaration::get_mangled_name(): func_name = "
           "%s \n",
           func_name.str());
#endif
    // Compute the name qualification, if any.
    const SgScopeStatement *par_scope = get_scope();
    SgName scope_name = mangleQualifiers(par_scope);

#if DEBUG_FUNCDECL_MANGLED_NAMES
    printf("Inside of SgFunctionDeclaration::get_mangled_name(): scope_name = "
           "%s \n",
           scope_name.str());
#endif
    // Compute the translation unit qualification, if any.
    string xlation_unit_qual = mangleTranslationUnitQualifiers(this);

#if DEBUG_FUNCDECL_MANGLED_NAMES
    printf("Inside of SgFunctionDeclaration::get_mangled_name(): "
           "xlation_unit_qual = %s \n",
           xlation_unit_qual.c_str());
#endif
    // Compute the final mangled name.
    mangledName = joinMangledQualifiers(
        scope_name, xlation_unit_qual + func_name + "__" + type_name);
    const SgExpression *templateConstraint = NULL;
    if (const SgTemplateFunctionDeclaration *templateFunction =
            isSgTemplateFunctionDeclaration(this)) {
      templateConstraint = templateFunction->get_requiresClause();
    } else if (const SgTemplateMemberFunctionDeclaration *templateMember =
                   isSgTemplateMemberFunctionDeclaration(this)) {
      templateConstraint = templateMember->get_requiresClause();
    }
    if (templateConstraint != NULL) {
      mangledName +=
          "__template_requires_" + mangleExpression(templateConstraint);
    }
    const SgExpression *constraint = get_trailingRequiresClause();
    if (constraint == NULL) {
      SgFunctionDeclaration *templatePattern = NULL;
      if (const SgTemplateInstantiationFunctionDecl *instantiation =
              isSgTemplateInstantiationFunctionDecl(this)) {
        templatePattern =
            isSgFunctionDeclaration(instantiation->get_templateDeclaration());
      } else if (const SgTemplateInstantiationMemberFunctionDecl
                     *instantiation =
                         isSgTemplateInstantiationMemberFunctionDecl(this)) {
        templatePattern =
            isSgFunctionDeclaration(instantiation->get_templateDeclaration());
      }
      if (templatePattern != NULL) {
        constraint = templatePattern->get_trailingRequiresClause();
      }
    }
    if (constraint != NULL) {
      mangledName += "__requires_" + mangleExpression(constraint);
    }

    // DQ (6/22/2010): Better to use the function name with the paraleter list
    // in the mangled name.  This helps disambiguate code such as:
    //    typedef struct Domain_s { } Domain_t;
    //    int foo ( Domain_s *domain);
    //    int foo ( Domain_t *domain);
#if DEBUG_FUNCDECL_MANGLED_NAMES
    printf("Inside of SgFunctionDeclaration::get_mangled_name(): mangledName = "
           "%s \n",
           mangledName.str());
#endif
    // DQ (6/22/2022): Leave this call to
    // SageInterface::addMangledNameToCache(), but remove the addition of the
    // parameter list's mangled name as a suffix since it is redundant, and the
    // resetting of the updated mangled name in the globalMangledNameMap. #if 1
    // printf ("TEMP: Inside of SgFunctionDeclaration::get_mangled_name():
    // mangledName = %s \n",mangledName.str());
    mangledName = SageInterface::addMangledNameToCache(
        const_cast<SgFunctionDeclaration *>(this), mangledName);
    // printf ("TEMP RETURN: Inside of
    // SgFunctionDeclaration::get_mangled_name(): mangledName = %s
    // \n",mangledName.str());

#if DISABLED_1
    // DQ (6/21/2022): This redundantly appends the mangled name for the
    // parameter to the end and results in a compressed version of the string
    // that is not translation unit independent.

    // This results in infinite recursion in the evaluation.
    SgFunctionParameterList *parameterList = this->get_parameterList();
    ROSE_ASSERT(parameterList != NULL);
    SgName mangledParameterList = parameterList->get_mangled_name();
    mangledName += "__" + mangledParameterList;
    // printf ("Inside of SgFunctionDeclaration::get_mangled_name(): after
    // adding parameter list mangledName = %s \n",mangledName.str());

    // Reset the mangled name in the map.
    // p_globalMangledNameMap[function] = mangledName;
    SgNode::get_globalMangledNameMap()[const_cast<SgFunctionDeclaration *>(
        this)] = mangledName;
#endif /* DISABLED_1 */

#if DEBUG_FUNCDECL_MANGLED_NAMES
    printf("Inside of SgFunctionDeclaration::get_mangled_name(): after "
           "resetting mangledName = %s \n",
           mangledName.str());
#endif
    // DQ (7/24/2012): Added test for template brackets that are caught later in
    // AstConsistencyTests. Make sure that there is no template specific syntax
    // included in the mangled name
    // if ( mangledName.getString().find('<') != string::npos )
    //   {
    //     printf ("In get_mangled_name(): this = %p = %s check mangled class
    //     name = %s
    //     \n",this,this->class_name().c_str(),mangledName.getString().c_str());
    //   }
    ROSE_ASSERT(mangledName.getString().find('<') == string::npos);

#if DEBUG_FUNCDECL_MANGLED_NAMES
    // DQ (7/24/2012): Output the mangled name being generated for debugging.
    printf(">>>>>>>>>> SgFunctionDeclaration::get_mangled_name(): returning "
           "mangledName = %s \n",
           mangledName.str());
#endif

    return mangledName;
  }
}

// SgStatement* get_next(int&) const;

bool SgFunctionDeclaration::replace_child(SgStatement *target,
                                          SgStatement *newstmt,
                                          bool extractBasicBlock) {
  if (StatementReplace(this, p_definition, target, newstmt) == true)
    return true;
  else
    return (StatementReplace(this, p_parameterList, target, newstmt) == true);
}

// DQ (10/20/2004): Since constructor names don't require their template
// arguments this has a far simpler solution! for example: "template <typename
// T> class X { X(); }; X<int>::X() {}"

// DQ (10/20/2004): This function should be different from those that are
// automatically generated via ROSETTA.  In the case of a constructor or
// destructor the class name should be used.  This is particularly important in
// the case of constructors and destructors of templated classes since the
// mangled form or the template class should not be used since it will not allow
// the generated code to compile.  Instead of names of the form "ABC____L8" we
// want names of the form "ABC<int>". These functions are now implemented
// explicitly instead of being automatically generated via ROSETTA. SgName
// get_name() const
//    {
//      SgName returnName = p_name;
//      if ( get_specialFunctionModifier().isConstructor() ||
//           get_specialFunctionModifier().isDestructor()  ||
//           get_specialFunctionModifier().isConversion() )
//         {
//            printf ("In $CLASSNAME::get_name: case of a constructor,
//            destructor or conversion operator \n"); returnName = "Use the
//            class Name";
//         }
//
//      return returnName;
//    }

// SgName SgFunctionDeclaration::get_qualified_name();
SgName SgFunctionDeclaration::get_qualified_name() const {
  // DQ (10/15/2004): This function is similar to the one for
  // SgClassDeclaration. This function calls get_scope() which uses the parent
  // pointers, thus it should not be called before the parent pointers are set
  // (within the AST fixup after the Sage III AST is fully constructed).

  // The semantics of get_scope is that it can never be NULL (SgGlobal returns
  // itself as its scope!)
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  SgName returnName =
      SgName::assembleQualifiedName(scope->get_qualified_name(), get_name());
  return returnName;
}

bool SgFunctionDeclaration::hasExplicitScope() const {
  // This function reports that this IR node stores its scope explicitly.

  return true;
}

SgName SgFunctionDeclaration::get_symbol_table_key() const {
  return isSgProgramHeaderStatement(this) != nullptr ||
                 isSgProcedureHeaderStatement(this) != nullptr
             ? SageInterface::getFortranProgramUnitSymbolTableKey(this)
             : get_name();
}

// DQ (2/6/2007): Get the associated symbol from the symbol table in the stored
// scope
SgSymbol *SgFunctionDeclaration::get_symbol_from_symbol_table() const {
  SgScopeStatement *scope = get_scope();
  ROSE_ASSERT(scope != NULL);

  // DQ (3/1/2014): This could be a scope from a deleted AST and if we would
  // like to think that the SgFunctionDeclaration would have been deleted, but
  // it could have been the first non-defining declaration constructed to
  // support the symbol), and thus not strictly in the AST. In this case so we
  // would like return NULL. The test for if this is a deletec IR node is if the
  // variant is V_SgNode.
  if (scope->variantT() == V_SgNode) {
    printf("SgFunctionDeclaration::get_symbol_from_symbol_table(): This is a "
           "deleted IR node (returning NULL) \n");
    return NULL;
  }
  ROSE_ASSERT(scope->variantT() != V_SgNode);

  // ROSE_ASSERT(get_scope()->get_symbol_table() != NULL);
  // return scope->get_symbol_table()->find(this);
  return scope->find_symbol_from_declaration(this);
}

