void
$CLASSNAME::traverseMemoryPoolNodes(ROSE_VisitTraversal & traversal)
   {
  // This function traverses the memory pool for only a specific IR node
  // and calls the visit function of the input class execute a traversal
  // similar to the style of the attribute based traversals within ROSE.
  // This traversal will visit ALL nodes of the AST where as the other
  // attribute based traversals visit only the embedded tree within the AST.

     if ($CLASSNAME::pools.empty() == false)
        {
          ROSE_ASSERT($CLASSNAME::pool_live_flags.size() == $CLASSNAME::pools.size());
          unsigned char** pool_bases = $CLASSNAME::pools.data();
       // Save live slots before invoking visitors that may change the pools.

          struct NodeEntry {
            $CLASSNAME* node;
            size_t pool_index;
            size_t slot_index;
          };
          std::vector<NodeEntry> nodeList;

       // Iterate over the memory pools to build the saved list of IR nodes for this type.
          for (unsigned int i=0; i < $CLASSNAME::pools.size(); i++)
             {
               unsigned char* base = pool_bases[i];
               for (unsigned j=0; j < $CLASSNAME::pool_size; j++)
                  {
                    if ($CLASSNAME::pool_live_flags[i][j])
                       {
                         $CLASSNAME* current =
                           reinterpret_cast<$CLASSNAME*>(base + j * sizeof($CLASSNAME));
                         nodeList.push_back(NodeEntry{current, i, j});
                       }
                  }
             }

          // Iterate over the saved list
          size_t nodeListSize = nodeList.size();
          for (size_t i=0; i < nodeListSize; i++)
             {
               ROSE_ASSERT(nodeList[i].node != NULL);
               if ($CLASSNAME::pool_live_flags[nodeList[i].pool_index][nodeList[i].slot_index])
                  {
                    $CLASSNAME* current = nodeList[i].node;
                    traversal.visit(current);
                  }
             }
        }

   }


void
$CLASSNAME::traverseMemoryPoolVisitorPattern ( ROSE_VisitorPattern & visitor )
   {
     class VisitorTraversal : public ROSE_VisitTraversal {
       ROSE_VisitorPattern &visitor;

     public:
       explicit VisitorTraversal(ROSE_VisitorPattern &visitor) : visitor(visitor) {}
       void visit(SgNode *node) override { node->accept(visitor); }
     } traversal(visitor);

     traverseMemoryPoolNodes(traversal);
   }

void
$CLASSNAME::visitRepresentativeNode(ROSE_VisitTraversal & traversal)
   {
     ROSE_ASSERT($CLASSNAME::pool_live_flags.size() == $CLASSNAME::pools.size());
     for (size_t i = 0; i < $CLASSNAME::pools.size(); ++i)
        {
          for (size_t j = 0; j < $CLASSNAME::pool_size; ++j)
             {
               if ($CLASSNAME::pool_live_flags[i][j])
                  {
                    unsigned char* base = $CLASSNAME::pools[i];
                    $CLASSNAME* current =
                      reinterpret_cast<$CLASSNAME*>(base + j * sizeof($CLASSNAME));
                    traversal.visit(current);
                    return;
                  }
             }
        }
   }


size_t
$CLASSNAME::numberOfNodes()
   {
  // This function traverses the memory pool for an IR node and
  // counts the number of IR nodes of a particular Sage III IR
  // nodes type.

     size_t count = 0;
     if ($CLASSNAME::pools.empty() == false)
        {
          ROSE_ASSERT($CLASSNAME::pool_live_flags.size() == $CLASSNAME::pools.size());
          for (unsigned int i=0; i < $CLASSNAME::pools.size(); i++)
             {
               for (unsigned j=0; j < $CLASSNAME::pool_size; j++)
                  {
                    if ($CLASSNAME::pool_live_flags[i][j])
                       {
                         count++;
                       }
                  }
             }
        }

     return count;
   }

size_t
$CLASSNAME::memoryUsage()
   {
     return numberOfNodes() * sizeof($CLASSNAME);
   }
