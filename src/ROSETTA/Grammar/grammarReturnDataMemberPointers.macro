
std::vector<std::pair<SgNode*,std::string> >
$CLASSNAME::returnDataMemberPointers() const
   {

  // ------------ checking pointers of $CLASSNAME -------------------
     if (p_freepointer != ASTMemoryPool::validNodeMarker() )
        {
          printf ("Error: In node = %s at %p p_freepointer = %p \n",class_name().c_str(),this,p_freepointer);
        }
     ROSE_ASSERT ( p_freepointer == ASTMemoryPool::validNodeMarker() );

     $CODE_STRING

   }
