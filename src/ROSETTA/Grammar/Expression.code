SOURCE_CXX_DECOMPOSITION_REFERENCE_START
bool SgCxxDecompositionRefExp::is_valid_target(SgInitializedName *owner,
                                               SgType *type) {
  if (owner == nullptr || !SgNode::isLiveNode(owner) ||
      !owner->get_name().is_null() || owner->get_type() == nullptr ||
      owner->get_structured_binding_kind() !=
          SgInitializedName::e_not_structured_binding ||
      (owner->get_structured_binding_pattern() == nullptr &&
       !owner->isUnderConstruction()) ||
      type == nullptr || SageInterface::containsUnknownType(type))
    return false;
  constexpr auto wrappers =
      SgType::STRIP_TYPEDEF_TYPE | SgType::STRIP_MODIFIER_TYPE |
      SgType::STRIP_REFERENCE_TYPE | SgType::STRIP_RVALUE_REFERENCE_TYPE;
  return owner->get_type()->stripType(wrappers) == type->stripType(wrappers);
}

void SgCxxDecompositionRefExp::post_construction_initialization() {
  SgExpression::post_construction_initialization();
  ROSE_ASSERT(is_valid_target(p_decomposition, p_expression_type));
}

void SgCxxDecompositionRefExp::validate() const {
  ROSE_ASSERT(is_valid_target(p_decomposition, p_expression_type));
  auto *pattern = p_decomposition->get_structured_binding_pattern();
  ROSE_ASSERT(pattern != nullptr && pattern->get_parent() == p_decomposition);
}
SOURCE_CXX_DECOMPOSITION_REFERENCE_END

