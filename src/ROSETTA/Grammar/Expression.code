SOURCE_EXTENDED_FLOAT_LITERAL_START
Rose::FloatingValue $CLASSNAME::get_value() const { return p_value; }
void $CLASSNAME::set_value(Rose::FloatingValue value) {
  // Typed edits retain the target format established during construction.
  p_value = value.converted(p_value.format());
  p_valueString.clear();
  p_literal_spelling_form = SgValueExp::e_literal_canonical_generated;
  markAsModified();
}
