SOURCE_FORTRAN_DATA_INITIALIZER_START
bool SgFortranDataInitializer::is_valid_initializer(
    const SgDataStatementValuePtrList &values, SgType *type) {
  return type != nullptr && !SageInterface::containsUnknownType(type) &&
         SgDataStatementValue::is_valid_values(values);
}

void SgFortranDataInitializer::post_construction_initialization() {
  SgInitializer::post_construction_initialization();
  ROSE_ASSERT(is_valid_initializer(p_values, p_expression_type));
  for (auto *value : p_values)
    ROSE_ASSERT(value->get_parent() == nullptr);
  for (auto *value : p_values)
    value->set_parent(this);
}

SgType *SgFortranDataInitializer::get_type() const {
  ROSE_ASSERT(p_expression_type != nullptr);
  return p_expression_type;
}

void SgFortranDataInitializer::validate_initializer() const {
  ROSE_ASSERT(is_valid_initializer(p_values, p_expression_type));
  for (auto *value : p_values) {
    ROSE_ASSERT(value->get_parent() == this);
    value->validate_value();
  }
}
SOURCE_FORTRAN_DATA_INITIALIZER_END

