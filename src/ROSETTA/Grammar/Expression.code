SOURCE_POINTER_ARRAY_REFERENCE_POST_CONSTRUCTION_START
void $CLASSNAME::post_construction_initialization() {
  ROSE_ASSERT(!p_result_storage_size_bytes ||
              *p_result_storage_size_bytes >= 0);
  if (!p_subscript_stride_bits.empty()) {
    ASSERT_not_null(get_rhs_operand());
    const auto *indices = isSgExprListExp(get_rhs_operand());
    ROSE_ASSERT(p_subscript_stride_bits.size() ==
                (indices ? indices->get_expressions().size() : 1));
  }
}
SOURCE_POINTER_ARRAY_REFERENCE_POST_CONSTRUCTION_END

