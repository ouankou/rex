SOURCE_UNARY_TYPE_TRAIT_POST_CONSTRUCTION_START
void $CLASSNAME::post_construction_initialization() {
  ROSE_ASSERT(variantT() == V_SgSizeOfOp
                  ? (p_operator_kind == e_sizeof ||
                     p_operator_kind == e_sizeof_pack ||
                     p_operator_kind == e_datasizeof)
                  : (p_operator_kind == e_alignof ||
                     p_operator_kind == e_preferred_alignof));
  ROSE_ASSERT(!p_evaluated_value || p_evaluated_value->isUnsigned());
  ROSE_ASSERT(variantT() == V_SgSizeOfOp || !p_evaluated_value ||
              p_evaluated_value->words() != Rose::Integer128Value::Words{});
}
SgExpression *$CLASSNAME::get_operand_expr() const { return p_operand_expr; }
void $CLASSNAME::set_operand_expr(SgExpression *value) {
  if (p_operand_expr != value && !SgCopyHelp::isConstructingCopy(this))
    p_evaluated_value.reset();
  p_operand_expr = value;
  markAsModified();
}
SgType *$CLASSNAME::get_operand_type() const { return p_operand_type; }
void $CLASSNAME::set_operand_type(SgType *value) {
  if (p_operand_type != value && !SgCopyHelp::isConstructingCopy(this))
    p_evaluated_value.reset();
  p_operand_type = value;
  markAsModified();
}
SgType *$CLASSNAME::get_expression_type() const { return p_expression_type; }
void $CLASSNAME::set_expression_type(SgType *value) {
  if (p_expression_type != value && !SgCopyHelp::isConstructingCopy(this))
    p_evaluated_value.reset();
  p_expression_type = value;
  markAsModified();
}
SgExpression::unary_type_trait_kind_enum $CLASSNAME::get_operator_kind() const {
  return p_operator_kind;
}
void $CLASSNAME::set_operator_kind(
    SgExpression::unary_type_trait_kind_enum value) {
  if (p_operator_kind != value && !SgCopyHelp::isConstructingCopy(this))
    p_evaluated_value.reset();
  p_operator_kind = value;
  markAsModified();
}
std::optional<Rose::Integer128Value> $CLASSNAME::get_evaluated_value() const {
  return p_evaluated_value;
}
SOURCE_UNARY_TYPE_TRAIT_POST_CONSTRUCTION_END

