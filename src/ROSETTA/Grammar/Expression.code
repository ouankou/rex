virtual std::vector<VirtualCFG::CFGEdge>
cfgOutEdges(unsigned int index) override;
virtual std::vector<VirtualCFG::CFGEdge>
cfgInEdges(unsigned int index) override;
#endif

/** Returns the associated function declaration, if it can be resolved
 * statically. In some cases, such as function pointers and virtual functions,
 * the function called cannot be resolved statically; for those cases this
 * function returns NULL. The actual function expression is available through
 * get_function(). */
SgFunctionDeclaration *getAssociatedFunctionDeclaration() const;

/** Returns the associated function symbol, if it can be resolved statically. In
 * some cases, such as function pointers and virtual functions, the function
 * called cannot be resolved statically; for those cases this function returns
 * NULL. The actual function expression is available through get_function(). */
SgFunctionSymbol *getAssociatedFunctionSymbol() const;

// get lvalue
virtual bool isLValue() const override;
virtual bool isChildUsedAsLValue(const SgExpression *child) const
    override; // INTERNAL Recursively call up the chain to answer the child
HEADER_FUNCTION_CALL_EXPRESSION_END

