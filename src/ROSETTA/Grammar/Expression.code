HEADER_INTEGER128_LITERAL_START
public:
Rose::Integer128Value get_value() const;
void set_value(Rose::Integer128Value value);
HEADER_INTEGER128_LITERAL_END

SOURCE_INTEGER128_LITERAL_START
Rose::Integer128Value $CLASSNAME::get_value() const { return p_value; }
void $CLASSNAME::set_value(Rose::Integer128Value value) {
  ROSE_ASSERT(value.isUnsigned() == p_value.isUnsigned());
  p_value = value;
  p_literal_spelling_form = SgValueExp::e_literal_canonical_generated;
  markAsModified();
}
SgType *$CLASSNAME::get_type() const {
  if (get_literal_type() != nullptr) {
    ROSE_ASSERT(isSgTypeUnknown(get_literal_type()) == nullptr);
    ROSE_ASSERT(isSgTypeDefault(get_literal_type()) == nullptr);
    return get_literal_type();
  }
  if (p_value.isUnsigned())
    return SgTypeUnsigned128bitInteger::createType();
  return SgTypeSigned128bitInteger::createType();
}
SOURCE_INTEGER128_LITERAL_END

HEADER_FORTRAN_BOZ_LITERAL_START
public:
Rose::Integer128Value get_bits() const;
void set_bits(Rose::Integer128Value bits);
HEADER_FORTRAN_BOZ_LITERAL_END

SOURCE_FORTRAN_BOZ_LITERAL_START
void $CLASSNAME::post_construction_initialization() {
  ROSE_ASSERT(p_bits.isUnsigned());
}
Rose::Integer128Value $CLASSNAME::get_bits() const {
  ROSE_ASSERT(p_bits.isUnsigned());
  return p_bits;
}
void $CLASSNAME::set_bits(Rose::Integer128Value bits) {
  ROSE_ASSERT(bits.isUnsigned());
  p_bits = bits;
  p_literal_spelling_form = SgValueExp::e_literal_canonical_generated;
  markAsModified();
}
SgType *$CLASSNAME::get_type() const {
  ROSE_ASSERT(p_bits.isUnsigned());
  ROSE_ASSERT(get_literal_type() == nullptr ||
              get_literal_type() == SgTypeFortranBOZ::createType());
  return SgTypeFortranBOZ::createType();
}
SOURCE_FORTRAN_BOZ_LITERAL_END
