HEADER_LAMBDA_EXPRESSION_START
SgDeclarationScope *get_closure_scope() const { return p_closure_scope; }
HEADER_LAMBDA_EXPRESSION_END

SOURCE_LAMBDA_EXPRESSION_POST_CONSTRUCTION_INITIALIZATION_START
void SgLambdaExp::post_construction_initialization() {
  if (p_lambda_capture_list == nullptr ||
      p_lambda_capture_list->get_parent() != nullptr ||
      p_lambda_closure_class == nullptr || p_lambda_function == nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[lambda-construction]: lambda requires a "
            "detached capture list, closure, and call operator\n");
    ROSE_ABORT();
  }
  SgClassDefinition *closure_definition =
      p_lambda_closure_class->get_definition();
  SgClassDeclaration *first = isSgClassDeclaration(
      p_lambda_closure_class->get_firstNondefiningDeclaration());
  SgFunctionDefinition *function_definition =
      p_lambda_function->get_definition();
  SgAuxiliaryDeclarationList *closure_owner =
      isSgAuxiliaryDeclarationList(p_lambda_closure_class->get_parent());
  SgAuxiliaryDeclarationList *function_owner =
      isSgAuxiliaryDeclarationList(p_lambda_function->get_parent());
  auto *scope = isSgDeclarationScope(p_lambda_closure_class->get_scope());
  ROSE_ASSERT(scope != nullptr && scope->get_semantic_outer_scope() != nullptr);
  if (p_closure_scope != nullptr) {
    ROSE_ASSERT(p_closure_scope == scope && scope->get_parent() == nullptr);
    ROSE_ASSERT(p_lambda_closure_class->get_lambda_expression() == nullptr);
    scope->set_parent(this);
  } else {
    auto *owner = isSgLambdaExp(scope->get_parent());
    ROSE_ASSERT(owner != nullptr && owner->get_closure_scope() == scope &&
                owner->get_lambda_closure_class() == p_lambda_closure_class);
  }
  ROSE_ASSERT(closure_definition != nullptr &&
              p_lambda_closure_class->get_class_type() ==
                  SgClassDeclaration::e_lambda_closure &&
              p_lambda_closure_class->get_definingDeclaration() ==
                  p_lambda_closure_class &&
              closure_definition->get_declaration() == p_lambda_closure_class &&
              closure_definition->get_parent() == p_lambda_closure_class &&
              closure_definition->get_construction_physical_output_owner() ==
                  nullptr);
  ROSE_ASSERT(first != nullptr && first != p_lambda_closure_class &&
              first->get_firstNondefiningDeclaration() == first &&
              first->get_definingDeclaration() == p_lambda_closure_class &&
              first->get_scope() == p_lambda_closure_class->get_scope() &&
              first->get_type() != nullptr &&
              first->get_type() == p_lambda_closure_class->get_type());
  ROSE_ASSERT(
      closure_owner != nullptr &&
      closure_owner->get_parent() == p_lambda_closure_class->get_scope() &&
      p_lambda_closure_class->get_scope()->get_auxiliary_declarations() ==
          closure_owner &&
      first->get_parent() == closure_owner &&
      std::count(closure_owner->get_declarations().begin(),
                 closure_owner->get_declarations().end(), first) == 1 &&
      std::count(closure_owner->get_declarations().begin(),
                 closure_owner->get_declarations().end(),
                 p_lambda_closure_class) == 1);
  ROSE_ASSERT(function_owner != nullptr &&
              function_owner->get_parent() == closure_definition &&
              closure_definition->get_auxiliary_declarations() ==
                  function_owner &&
              p_lambda_function->get_scope() == closure_definition &&
              std::count(function_owner->get_declarations().begin(),
                         function_owner->get_declarations().end(),
                         p_lambda_function) == 1);
  ROSE_ASSERT(
      p_lambda_function->get_definingDeclaration() == p_lambda_function &&
      function_definition != nullptr &&
      function_definition->get_declaration() == p_lambda_function &&
      function_definition->get_parent() == p_lambda_function &&
      function_definition->get_body() != nullptr &&
      function_definition->get_body()->get_parent() == function_definition);
  closure_owner->validate_semantic_non_output_role();
  function_owner->validate_semantic_non_output_role();
  if (p_closure_scope != nullptr)
    p_lambda_closure_class->set_lambda_expression(this);
  p_lambda_capture_list->set_parent(this);
}
SOURCE_LAMBDA_EXPRESSION_POST_CONSTRUCTION_INITIALIZATION_END

