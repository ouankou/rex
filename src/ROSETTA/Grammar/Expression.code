SOURCE_COMPLEX_VALUE_POST_CONSTRUCTION_INITIALIZATION_START
void SgComplexVal::post_construction_initialization() {
  ROSE_ASSERT(p_imaginary_value != nullptr && p_precisionType != nullptr);
  ROSE_ASSERT(!SageInterface::containsUnknownType(p_precisionType));
  ROSE_ASSERT(p_imaginary_value->get_parent() == nullptr);
  ROSE_ASSERT(p_real_value == nullptr ||
              (p_real_value != p_imaginary_value &&
               p_real_value->get_parent() == nullptr));
  if (p_real_value != nullptr)
    p_real_value->set_parent(this);
  p_imaginary_value->set_parent(this);
}
SOURCE_COMPLEX_VALUE_POST_CONSTRUCTION_INITIALIZATION_END

SOURCE_AWAIT_EXPRESSION_POST_CONSTRUCTION_INITIALIZATION_START
void SgAwaitExpression::post_construction_initialization() {
  if (p_value == nullptr || p_value->get_parent() != nullptr) {
    fprintf(stderr, "REX_AST_INVARIANT[coroutine-operand]: await expression "
                    "requires one detached operand\n");
    ROSE_ABORT();
  }
  ROSE_ASSERT(!SageInterface::containsUnknownType(get_type()));
  if (p_coroutine_keyword_kind != e_coroutine_keyword_co_await &&
      p_coroutine_keyword_kind != e_coroutine_keyword_co_yield) {
    fprintf(stderr, "REX_AST_INVARIANT[coroutine-keyword]: await expression "
                    "has invalid typed source kind=%d\n",
            static_cast<int>(p_coroutine_keyword_kind));
    ROSE_ABORT();
  }
  p_value->set_parent(this);
}
SOURCE_AWAIT_EXPRESSION_POST_CONSTRUCTION_INITIALIZATION_END

