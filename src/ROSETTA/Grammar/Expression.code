SOURCE_DEFAULT_GET_TYPE_START
// SgExprListExp
SgType *

$CLASSNAME::get_type() const {
  ROSE_ASSERT(this != NULL);

  SgType *returnType = SgTypeDefault::createType();
  return returnType;
}
SOURCE_DEFAULT_GET_TYPE_END

SOURCE_CHOOSE_EXPRESSION_GET_TYPE_START
SgType *$CLASSNAME::get_type() const {
  if (p_expression_type == nullptr ||
      isSgTypeUnknown(p_expression_type) != nullptr ||
      isSgTypeDefault(p_expression_type) != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[choose-expression-type]: expression=%p has "
            "no exact semantic result type\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  return p_expression_type;
}
SOURCE_CHOOSE_EXPRESSION_GET_TYPE_END

SOURCE_SYNTAX_ONLY_GET_TYPE_START
SgType *$CLASSNAME::get_type() const {
  fprintf(stderr,
          "REX_AST_INVARIANT[syntax-expression-type]: node=$CLASSNAME has no "
          "standalone semantic value type\n");
  ROSE_ABORT();
}
SOURCE_SYNTAX_ONLY_GET_TYPE_END

SOURCE_GET_TYPE_FROM_SYMBOL_START
SgType *$CLASSNAME::get_type() const {
  ROSE_ASSERT(this != NULL);

  SgSymbol *symbol = this->get_symbol();
  if (symbol == NULL) {
    printf("Error: In $CLASSNAME::get_type(): symbol == NULL this = %p = %s \n",
           this, this->class_name().c_str());
  }
  ROSE_ASSERT(symbol != NULL);

  SgType *type = symbol->get_type();
  if (type == NULL) {
    printf("Error: In $CLASSNAME::get_type(): type == NULL symbol = %p = %s \n",
           symbol, symbol->class_name().c_str());
  }
  ROSE_ASSERT(type != NULL);

  return type;
}
SOURCE_GET_TYPE_FROM_SYMBOL_END

SOURCE_TEMPLATE_FUNCTION_REFERENCE_GET_TYPE_START
SgType *$CLASSNAME::get_type() const {
  ROSE_ASSERT(this != NULL);

  SgFunctionDeclaration *semanticFunction = getAssociatedFunctionDeclaration();
  SgType *type = semanticFunction->get_type();
  if (type == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[template-function-reference-type]: "
            "reference=%p semantic-function=%p has no exact callable type\n",
            static_cast<const void *>(this),
            static_cast<void *>(semanticFunction));
    ROSE_ABORT();
  }
  return type;
}
SOURCE_TEMPLATE_FUNCTION_REFERENCE_GET_TYPE_END

SOURCE_TEMPLATE_MEMBER_FUNCTION_REFERENCE_GET_TYPE_START
SgType *$CLASSNAME::get_type() const {
  ROSE_ASSERT(this != NULL);

  SgMemberFunctionDeclaration *semanticFunction =
      getAssociatedMemberFunctionDeclaration();
  SgType *type = semanticFunction->get_type();
  if (type == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[template-member-function-reference-type]: "
            "reference=%p semantic-function=%p has no exact callable type\n",
            static_cast<const void *>(this),
            static_cast<void *>(semanticFunction));
    ROSE_ABORT();
  }
  return type;
}
SOURCE_TEMPLATE_MEMBER_FUNCTION_REFERENCE_GET_TYPE_END

SOURCE_NONREAL_REFERENCE_GET_TYPE_START
SgType *$CLASSNAME::get_type() const {
  if (p_resolved_function_declaration != nullptr &&
      p_resolved_variable_declaration != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[nonreal-reference-identity]: reference=%p "
            "resolves to both function=%p and variable=%p\n",
            static_cast<const void *>(this),
            static_cast<void *>(p_resolved_function_declaration),
            static_cast<void *>(p_resolved_variable_declaration));
    ROSE_ABORT();
  }

  if (p_resolved_function_declaration != nullptr) {
    return SageInterface::requireResolvedFunctionTemplateReference(
               this, "SgNonrealRefExp::get_type")
        ->get_type();
  }

  if (p_resolved_variable_declaration != nullptr) {
    return SageInterface::requireResolvedVariableTemplateReference(
               this, "SgNonrealRefExp::get_type")
        ->get_type();
  }

  SgNonrealSymbol *symbol = p_symbol;
  if (symbol == nullptr || symbol->get_type() == nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[nonreal-reference-type]: reference=%p has no "
            "exact symbol type\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  return symbol->get_type();
}
SOURCE_NONREAL_REFERENCE_GET_TYPE_END

SOURCE_GET_TYPE_GENERIC_START
SgType *$CLASSNAME::get_type(void) const { return GENERIC_TYPE::createType(); }
SOURCE_GET_TYPE_GENERIC_END

SOURCE_GET_TYPE_VALUE_START
SgType *$CLASSNAME::get_type(void) const {
  if (get_literal_type() != nullptr) {
    if (isSgTypeUnknown(get_literal_type()) != nullptr ||
        isSgTypeDefault(get_literal_type()) != nullptr) {
      fprintf(stderr,
              "REX_AST_INVARIANT[literal-semantic-type]: node=$CLASSNAME "
              "has an invalid explicit semantic type\n");
      ROSE_ABORT();
    }
    return get_literal_type();
  }
  return GENERIC_TYPE::createType();
}
SOURCE_GET_TYPE_VALUE_END

SOURCE_GET_TYPE_CLASS_DECL_START
// SgConstructorInitializer (DQ (8/1/2006): This code fragment is no longer
// used!)

// DQ (7/19/2006): Function suggested by Jeremiah Willcock and fixed up for
// general use by DQ A better fix (later) will allow us to save the SgType and
// not use a SgDefaultType for the special case below.
SgType *$CLASSNAME::get_type(void) const {
  if (p_expression_type == nullptr ||
      isSgTypeUnknown(p_expression_type) != nullptr ||
      isSgTypeDefault(p_expression_type) != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[exact-expression-type]: node=$CLASSNAME has "
            "no exact semantic result type\n");
    ROSE_ABORT();
  }
  return p_expression_type;
}
SOURCE_GET_TYPE_CLASS_DECL_END

