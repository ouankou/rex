HEADER_FUNCTION_CALL_EXPRESSION_START
/** Records the exact source role represented by a call node.  An
 * implicit conversion is a semantic wrapper around its object operand,
 * not a source-written function-call surface. */
enum source_syntax_enum {
  e_source_function_call = 0,
  e_implicit_conversion = 1,
  // Analysis records automatic cleanup; native C++ already performs it.
  e_implicit_destruction = 2
};

/** Identifies the exact operator surface written in the source.  The
 * unparser must not recover this distinction from a declaration name or
 * parameter count: those describe the selected function, not whether
 * the source used unary, binary, postfix, call, subscript, arrow, or
 * literal syntax. */
enum source_operator_surface_enum {
  e_no_operator_surface = 0,
  e_prefix_plus,
  e_prefix_minus,
  e_dereference,
  e_address_of,
  e_logical_not,
  e_bitwise_not,
  e_prefix_increment,
  e_prefix_decrement,
  e_postfix_increment,
  e_postfix_decrement,
  e_co_await,
  e_binary_plus,
  e_binary_minus,
  e_binary_multiply,
  e_binary_divide,
  e_binary_remainder,
  e_binary_xor,
  e_binary_and,
  e_binary_or,
  e_binary_assign,
  e_binary_less,
  e_binary_greater,
  e_binary_plus_assign,
  e_binary_minus_assign,
  e_binary_multiply_assign,
  e_binary_divide_assign,
  e_binary_remainder_assign,
  e_binary_xor_assign,
  e_binary_and_assign,
  e_binary_or_assign,
  e_binary_left_shift,
  e_binary_right_shift,
  e_binary_left_shift_assign,
  e_binary_right_shift_assign,
  e_binary_equal,
  e_binary_not_equal,
  e_binary_less_equal,
  e_binary_greater_equal,
  e_binary_spaceship,
  e_binary_logical_and,
  e_binary_logical_or,
  e_binary_comma,
  e_binary_arrow_star,
  e_call_operator_surface,
  e_subscript_operator_surface,
  e_arrow_operator_surface,
  e_user_defined_literal_surface
};

/** Records how the selected operator declaration owns its source
 * object.  Member syntax stores the source object in the call's callee;
 * nonmember syntax stores every source operand in the argument list. */
enum source_operator_callee_form_enum {
  e_no_operator_callee_form = 0,
  e_member_operator_callee,
  e_nonmember_operator_callee
};

/** Values stored in source_operator_operand_roles, one for every Sage
 * argument.  Semantic-only arguments include the postfix dummy integer
 * and extra cooked-literal arguments and must be validated but never
 * emitted as source operands. */
enum source_operator_operand_role_enum {
  e_source_operator_operand = 1,
  e_semantic_operator_operand = 2
};

/** Records whether an exact lexical token of a user-defined string literal
 * carries the common ud-suffix.  C++ permits a concatenated string literal to
 * repeat the same suffix on more than one token, so suffix ownership cannot be
 * reduced to one trailing string on the call. */
enum source_user_defined_literal_suffix_role_enum {
  e_user_defined_literal_token_without_suffix = 0,
  e_user_defined_literal_token_with_suffix = 1
};

bool get_uses_operator_syntax() const;
void set_uses_operator_syntax(bool value);
source_syntax_enum get_source_syntax() const;
void set_source_syntax(source_syntax_enum value);
source_operator_surface_enum get_source_operator_surface() const;
void set_source_operator_surface(source_operator_surface_enum value);
source_operator_callee_form_enum get_source_operator_callee_form() const;
void set_source_operator_callee_form(source_operator_callee_form_enum value);
SgName get_source_user_defined_literal_suffix() const;
void set_source_user_defined_literal_suffix(SgName value);
SgCxxLiteralTokenList *get_source_user_defined_literal_operands() const;
void set_source_user_defined_literal_operands(SgCxxLiteralTokenList *tokens);
bool get_source_user_defined_literal_is_modified() const;

const SgUnsignedCharList &get_source_operator_operand_roles() const;
void set_source_operator_operand_roles(const SgUnsignedCharList &roles);
const SgUnsignedCharList &get_source_user_defined_literal_suffix_roles() const;
void set_source_user_defined_literal_suffix_roles(
    const SgUnsignedCharList &roles);

