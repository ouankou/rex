SOURCE_CAF_IMAGE_SELECTOR_POST_CONSTRUCTION_INITIALIZATION_END

SOURCE_REQUIRES_EXPRESSION_POST_CONSTRUCTION_INITIALIZATION_START
void SgRequiresExpr::post_construction_initialization() {
  if (p_requirements == nullptr || p_requirements->get_expressions().empty() ||
      p_requirements->get_parent() != nullptr ||
      (p_local_parameter_list == nullptr) !=
          (p_local_parameter_scope == nullptr) ||
      (p_local_parameter_list != nullptr &&
       p_local_parameter_list->get_parent() != nullptr) ||
      (p_local_parameter_scope != nullptr &&
       p_local_parameter_scope->get_parent() != nullptr) ||
      (p_local_parameter_list_syntax != nullptr &&
       (p_local_parameter_list == nullptr ||
        p_local_parameter_list_syntax == p_local_parameter_list ||
        p_local_parameter_list_syntax->get_parent() != nullptr ||
        p_local_parameter_list_syntax->get_args().size() !=
            p_local_parameter_list->get_args().size()))) {
    fprintf(stderr, "REX_AST_INVARIANT[requires-construction]: requires "
                    "expression needs a nonempty detached requirement list "
                    "and a paired detached parameter list and scope\n");
    ROSE_ABORT();
  }
  if (p_local_parameter_list != nullptr) {
    for (size_t index = 0; index < p_local_parameter_list->get_args().size();
         ++index) {
      auto *parameter = p_local_parameter_list->get_args()[index];
      ROSE_ASSERT(parameter != nullptr && parameter->get_type() != nullptr &&
                  !SageInterface::containsUnknownType(parameter->get_type()) &&
                  parameter->get_parent() == p_local_parameter_list &&
                  parameter->get_scope() == p_local_parameter_scope &&
                  parameter->get_initializer() == nullptr);
      auto *object_type = parameter->get_type()->stripType(
          SgType::STRIP_TYPEDEF_TYPE | SgType::STRIP_MODIFIER_TYPE |
          SgType::STRIP_DECLTYPE_TYPE);
      ROSE_ASSERT(isSgArrayType(object_type) == nullptr &&
                  isSgFunctionType(object_type) == nullptr);
      if (p_local_parameter_list_syntax != nullptr) {
        auto *written = p_local_parameter_list_syntax->get_args()[index];
        ROSE_ASSERT(written != nullptr && written != parameter &&
                    written->get_type() != nullptr &&
                    !SageInterface::containsUnknownType(written->get_type()) &&
                    SageInterface::cxxParameterTypeMatchesSemanticType(
                        written->get_type(), parameter->get_type()) &&
                    written->get_parent() == p_local_parameter_list_syntax &&
                    written->get_scope() == p_local_parameter_scope &&
                    written->get_name() == parameter->get_name() &&
                    written->get_is_parameter_pack() ==
                        parameter->get_is_parameter_pack() &&
                    written->get_initializer() == nullptr &&
                    p_local_parameter_scope->find_symbol_from_declaration(
                        written) == nullptr);
      }
    }
  }
  for (SgExpression *requirement : p_requirements->get_expressions()) {
    if (requirement == nullptr || requirement->get_parent() != p_requirements ||
        (isSgSimpleRequirement(requirement) == nullptr &&
         isSgTypeRequirement(requirement) == nullptr &&
         isSgCompoundRequirement(requirement) == nullptr &&
         isSgNestedRequirement(requirement) == nullptr &&
         isSgRequirementSubstitutionFailure(requirement) == nullptr)) {
      fprintf(stderr, "REX_AST_INVARIANT[requires-construction]: "
                      "requirement list contains an invalid owned child\n");
      ROSE_ABORT();
    }
  }
  if (p_local_parameter_list != nullptr)
    p_local_parameter_list->set_parent(this);
  if (p_local_parameter_list_syntax != nullptr)
    p_local_parameter_list_syntax->set_parent(this);
  if (p_local_parameter_scope != nullptr)
    p_local_parameter_scope->set_parent(this);
  p_requirements->set_parent(this);
  if (p_local_parameter_scope != nullptr) {
    if (p_local_parameter_scope->get_completed_semantic_scope() == nullptr)
      SageInterface::completeDetachedRequiresParameterScopeConstruction(
          this, p_local_parameter_scope);
    else {
      ROSE_ASSERT(
          p_local_parameter_scope->get_construction_physical_output_owner() ==
          nullptr);
      ROSE_ASSERT(p_local_parameter_scope->get_construction_semantic_scope() ==
                  nullptr);
      ROSE_ASSERT(p_local_parameter_scope->get_completed_semantic_scope() !=
                  p_local_parameter_scope);
    }
  }
}
SOURCE_REQUIRES_EXPRESSION_POST_CONSTRUCTION_INITIALIZATION_END

SOURCE_RANGE_EXP_POST_CONSTRUCTION_INITIALIZATION_START
void SgRangeExp::post_construction_initialization() {
  if (p_start == nullptr || p_end == nullptr || p_stride == nullptr ||
      p_start == p_end || p_start == p_stride || p_end == p_stride) {
    fprintf(stderr, "REX_AST_INVARIANT[range-construction]: range requires "
                    "three distinct typed expressions\n");
    ROSE_ABORT();
  }
}
SOURCE_RANGE_EXP_POST_CONSTRUCTION_INITIALIZATION_END

SOURCE_CHOOSE_EXPRESSION_GET_TYPE_START
SgType *$CLASSNAME::get_type() const {
  if (p_expression_type == nullptr ||
      isSgTypeUnknown(p_expression_type) != nullptr ||
      isSgTypeDefault(p_expression_type) != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[choose-expression-type]: expression=%p has "
            "no exact semantic result type\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  return p_expression_type;
}
SOURCE_CHOOSE_EXPRESSION_GET_TYPE_END

SOURCE_SYNTAX_ONLY_GET_TYPE_START
SgType *$CLASSNAME::get_type() const {
  fprintf(stderr,
          "REX_AST_INVARIANT[syntax-expression-type]: node=$CLASSNAME has no "
          "standalone semantic value type\n");
  ROSE_ABORT();
}
SOURCE_SYNTAX_ONLY_GET_TYPE_END

SOURCE_GET_TYPE_FROM_SYMBOL_START
SgType *$CLASSNAME::get_type() const {

  SgSymbol *symbol = this->get_symbol();
  if (symbol == NULL) {
    printf("Error: In $CLASSNAME::get_type(): symbol == NULL this = %p = %s \n",
           this, this->class_name().c_str());
  }
  ROSE_ASSERT(symbol != NULL);

  SgType *type = symbol->get_type();
  if (type == NULL) {
    printf("Error: In $CLASSNAME::get_type(): type == NULL symbol = %p = %s \n",
           symbol, symbol->class_name().c_str());
  }
  ROSE_ASSERT(type != NULL);

  return type;
}
SOURCE_GET_TYPE_FROM_SYMBOL_END

SOURCE_TEMPLATE_FUNCTION_REFERENCE_GET_TYPE_START
SgType *$CLASSNAME::get_type() const {

  SgFunctionDeclaration *semanticFunction = getAssociatedFunctionDeclaration();
  SgType *type = semanticFunction->get_type();
  if (type == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[template-function-reference-type]: "
            "reference=%p semantic-function=%p has no exact callable type\n",
            static_cast<const void *>(this),
            static_cast<void *>(semanticFunction));
    ROSE_ABORT();
  }
  return type;
}
SOURCE_TEMPLATE_FUNCTION_REFERENCE_GET_TYPE_END

SOURCE_TEMPLATE_MEMBER_FUNCTION_REFERENCE_GET_TYPE_START
SgType *$CLASSNAME::get_type() const {

  SgMemberFunctionDeclaration *semanticFunction =
      getAssociatedMemberFunctionDeclaration();
  SgType *type = semanticFunction->get_type();
  if (type == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[template-member-function-reference-type]: "
            "reference=%p semantic-function=%p has no exact callable type\n",
            static_cast<const void *>(this),
            static_cast<void *>(semanticFunction));
    ROSE_ABORT();
  }
  return type;
}
SOURCE_TEMPLATE_MEMBER_FUNCTION_REFERENCE_GET_TYPE_END

SOURCE_NONREAL_REFERENCE_GET_TYPE_START
SgType *$CLASSNAME::get_type() const {
  if (p_is_non_odr_use && p_resolved_variable_declaration == nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[nonreal-reference-storage-use]: reference=%p "
            "has non-ODR-use state without an exact variable template\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  if (p_resolved_function_declaration != nullptr &&
      p_resolved_variable_declaration != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[nonreal-reference-identity]: reference=%p "
            "resolves to both function=%p and variable=%p\n",
            static_cast<const void *>(this),
            static_cast<void *>(p_resolved_function_declaration),
            static_cast<void *>(p_resolved_variable_declaration));
    ROSE_ABORT();
  }

  if (p_resolved_function_declaration != nullptr) {
    return SageInterface::requireResolvedFunctionTemplateReference(
               this, "SgNonrealRefExp::get_type")
        ->get_type();
  }

  if (p_resolved_variable_declaration != nullptr) {
    const auto &variables = p_resolved_variable_declaration->get_variables();
    ROSE_ASSERT(variables.size() == 1 && variables.front() != nullptr);
    SgInitializedName *name = variables.front();
    ROSE_ASSERT(name->get_parent() == p_resolved_variable_declaration &&
                name->get_declptr() == p_resolved_variable_declaration &&
                name->get_scope() != nullptr && name->get_type() != nullptr);
    ROSE_ASSERT(p_explicit_template_argument_list && p_symbol != nullptr &&
                p_symbol->get_declaration() != nullptr &&
                p_symbol->get_declaration()->get_templateDeclaration() ==
                    p_resolved_variable_declaration);
    SageInterface::requireCanonicalVariableTemplatePrimary(
        p_resolved_variable_declaration, "SgNonrealRefExp::get_type");
    return name->get_type();
  }

  SgNonrealSymbol *symbol = p_symbol;
  if (symbol == nullptr || symbol->get_type() == nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[nonreal-reference-type]: reference=%p has no "
            "exact symbol type\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  return symbol->get_type();
}
SOURCE_NONREAL_REFERENCE_GET_TYPE_END

SOURCE_GET_TYPE_GENERIC_START
SgType *$CLASSNAME::get_type(void) const { return GENERIC_TYPE::createType(); }
SOURCE_GET_TYPE_GENERIC_END

SOURCE_GET_TYPE_VALUE_START
SgType *$CLASSNAME::get_type(void) const {
  if (get_literal_type() != nullptr) {
    if (isSgTypeUnknown(get_literal_type()) != nullptr ||
        isSgTypeDefault(get_literal_type()) != nullptr) {
      fprintf(stderr,
              "REX_AST_INVARIANT[literal-semantic-type]: node=$CLASSNAME "
              "has an invalid explicit semantic type\n");
      ROSE_ABORT();
    }
    return get_literal_type();
  }
  return GENERIC_TYPE::createType();
}
SOURCE_GET_TYPE_VALUE_END

SOURCE_EXACT_EXPRESSION_GET_TYPE_START
SgType *$CLASSNAME::get_type(void) const {
  if (p_expression_type == nullptr ||
      isSgTypeUnknown(p_expression_type) != nullptr ||
      isSgTypeDefault(p_expression_type) != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[exact-expression-type]: node=$CLASSNAME has "
            "no exact semantic result type\n");
    ROSE_ABORT();
  }
  return p_expression_type;
}
SOURCE_EXACT_EXPRESSION_GET_TYPE_END

