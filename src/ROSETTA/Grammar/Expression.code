HEADER_CAST_EXPRESSION_START
// DQ (6/14/2005): Modified to make enum name consistant with elsewhere in ROSE
// (Sage III) enum Sg_e_cast_type
/*! \brief Classification of Casts

    Must be either C style cast or C++ style const_cast<>, static_cast<>,
    dynamic_cast<>, or reinterpret_cast<>.

    \internal Only a single value is permited.
 */
enum cast_type_enum {
  e_unknown = 0,          /*!< Invalid/uninitialized source surface. */
  e_C_style_cast,         /*!< C-style `(T)expr` source surface. */
  e_const_cast,           /*!< C++ `const_cast<T>(expr)`. */
  e_static_cast,          /*!< C++ `static_cast<T>(expr)`. */
  e_dynamic_cast,         /*!< C++ `dynamic_cast<T>(expr)`. */
  e_reinterpret_cast,     /*!< C++ `reinterpret_cast<T>(expr)`. */
  e_implicit_cast,        /*!< No source cast syntax. */
  e_builtin_bit_cast,     /*!< `__builtin_bit_cast(T, expr)`. */
  e_functional_cast,      /*!< C++ `T(expr)`. */
  e_functional_list_cast, /*!< C++ `T{expr}`. */
  e_last_cast             /*!< Exclusive upper bound. */
};

/*! \brief Exact semantic classification of a cast expression.

    `cast_type_enum` records the source surface and this enum records the
    language conversion selected by semantic analysis.  They are independent:
    explicit and implicit casts can select the same conversion.  Consumers must
    not reconstruct this value from operand and result types because several
    conversions have identical type shapes.  Every valid SgCastExp carries
    exactly one value from this closed LLVM 22 vocabulary.
 */
enum semantic_conversion_kind_enum {
  e_semantic_conversion_unclassified = 0,
  e_semantic_conversion_Dependent,
  e_semantic_conversion_BitCast,
  e_semantic_conversion_LValueBitCast,
  e_semantic_conversion_LValueToRValueBitCast,
  e_semantic_conversion_LValueToRValue,
  e_semantic_conversion_NoOp,
  e_semantic_conversion_BaseToDerived,
  e_semantic_conversion_DerivedToBase,
  e_semantic_conversion_UncheckedDerivedToBase,
  e_semantic_conversion_Dynamic,
  e_semantic_conversion_ToUnion,
  e_semantic_conversion_ArrayToPointerDecay,
  e_semantic_conversion_FunctionToPointerDecay,
  e_semantic_conversion_NullToPointer,
  e_semantic_conversion_NullToMemberPointer,
  e_semantic_conversion_BaseToDerivedMemberPointer,
  e_semantic_conversion_DerivedToBaseMemberPointer,
  e_semantic_conversion_MemberPointerToBoolean,
  e_semantic_conversion_ReinterpretMemberPointer,
  e_semantic_conversion_UserDefinedConversion,
  e_semantic_conversion_ConstructorConversion,
  e_semantic_conversion_IntegralToPointer,
  e_semantic_conversion_PointerToIntegral,
  e_semantic_conversion_PointerToBoolean,
  e_semantic_conversion_ToVoid,
  e_semantic_conversion_MatrixCast,
  e_semantic_conversion_VectorSplat,
  e_semantic_conversion_IntegralCast,
  e_semantic_conversion_IntegralToBoolean,
  e_semantic_conversion_IntegralToFloating,
  e_semantic_conversion_FloatingToFixedPoint,
  e_semantic_conversion_FixedPointToFloating,
  e_semantic_conversion_FixedPointCast,
  e_semantic_conversion_FixedPointToIntegral,
  e_semantic_conversion_IntegralToFixedPoint,
  e_semantic_conversion_FixedPointToBoolean,
  e_semantic_conversion_FloatingToIntegral,
  e_semantic_conversion_FloatingToBoolean,
  e_semantic_conversion_BooleanToSignedIntegral,
  e_semantic_conversion_FloatingCast,
  e_semantic_conversion_CPointerToObjCPointerCast,
  e_semantic_conversion_BlockPointerToObjCPointerCast,
  e_semantic_conversion_AnyPointerToBlockPointerCast,
  e_semantic_conversion_ObjCObjectLValueCast,
  e_semantic_conversion_FloatingRealToComplex,
  e_semantic_conversion_FloatingComplexToReal,
  e_semantic_conversion_FloatingComplexToBoolean,
  e_semantic_conversion_FloatingComplexCast,
  e_semantic_conversion_FloatingComplexToIntegralComplex,
  e_semantic_conversion_IntegralRealToComplex,
  e_semantic_conversion_IntegralComplexToReal,
  e_semantic_conversion_IntegralComplexToBoolean,
  e_semantic_conversion_IntegralComplexCast,
  e_semantic_conversion_IntegralComplexToFloatingComplex,
  e_semantic_conversion_ARCProduceObject,
  e_semantic_conversion_ARCConsumeObject,
  e_semantic_conversion_ARCReclaimReturnedObject,
  e_semantic_conversion_ARCExtendBlockObject,
  e_semantic_conversion_AtomicToNonAtomic,
  e_semantic_conversion_NonAtomicToAtomic,
  e_semantic_conversion_CopyAndAutoreleaseBlockObject,
  e_semantic_conversion_BuiltinFnToFnPtr,
  e_semantic_conversion_ZeroToOCLOpaqueType,
  e_semantic_conversion_AddressSpaceConversion,
  e_semantic_conversion_IntToOCLSampler,
  e_semantic_conversion_HLSLVectorTruncation,
  e_semantic_conversion_HLSLMatrixTruncation,
  e_semantic_conversion_HLSLArrayRValue,
  e_semantic_conversion_HLSLElementwiseCast,
  e_semantic_conversion_HLSLAggregateSplatCast,
  e_semantic_conversion_last
};

/*! \brief Exact C/C++ value category of the cast expression. */
enum value_category_enum {
  e_value_category_unclassified = 0,
  e_value_category_lvalue,
  e_value_category_xvalue,
  e_value_category_prvalue,
  e_value_category_last
};

