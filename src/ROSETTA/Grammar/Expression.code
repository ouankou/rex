SOURCE_NOEXCEPT_OPERATOR_POST_CONSTRUCTION_INITIALIZATION_START
void SgNoexceptOp::post_construction_initialization() {
  if (p_operand_expr == nullptr || p_operand_expr->get_parent() != nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[noexcept-constructor-operand]: operand=%p "
            "requires one detached typed expression\n",
            static_cast<void *>(p_operand_expr));
    ROSE_ABORT();
  }
  p_operand_expr->set_parent(this);
}
SOURCE_NOEXCEPT_OPERATOR_POST_CONSTRUCTION_INITIALIZATION_END

SOURCE_TYPE_ID_OPERATOR_POST_CONSTRUCTION_INITIALIZATION_START
void SgTypeIdOp::post_construction_initialization() {
  if ((p_operand_expr == nullptr) == (p_operand_type == nullptr) ||
      (p_operand_is_evaluated && p_operand_expr == nullptr) ||
      (p_operand_expr != nullptr && p_operand_expr->get_parent() != nullptr)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[typeid-constructor-operand]: exactly one "
            "detached operand and its evaluation role are required\n");
    ROSE_ABORT();
  }
  if (p_operand_expr != nullptr)
    p_operand_expr->set_parent(this);
  (void)get_type();
}
SOURCE_TYPE_ID_OPERATOR_POST_CONSTRUCTION_INITIALIZATION_END

