HEADER_CHOOSE_EXPRESSION_END

SOURCE_CHOOSE_EXPRESSION_POST_CONSTRUCTION_INITIALIZATION_START
void SgChooseExpression::post_construction_initialization() {
  ROSE_ASSERT(p_selection_kind >= e_choose_selection_dependent &&
              p_selection_kind <= e_choose_selection_false);
  (void)get_type();
  ROSE_ASSERT(p_condition != nullptr && p_true_expression != nullptr &&
              p_false_expression != nullptr && p_expression_type != nullptr);
  ROSE_ASSERT(p_condition != p_true_expression &&
              p_condition != p_false_expression &&
              p_true_expression != p_false_expression);
  ROSE_ASSERT(p_condition->get_parent() == nullptr &&
              p_true_expression->get_parent() == nullptr &&
              p_false_expression->get_parent() == nullptr);
  p_condition->set_parent(this);
  p_true_expression->set_parent(this);
  p_false_expression->set_parent(this);
}
void SgChooseExpression::validate() const {
  (void)get_type();
  ROSE_ASSERT(p_selection_kind >= e_choose_selection_dependent &&
              p_selection_kind <= e_choose_selection_false);
  ROSE_ASSERT(p_condition != nullptr && p_true_expression != nullptr &&
              p_false_expression != nullptr &&
              p_condition != p_true_expression &&
              p_condition != p_false_expression &&
              p_true_expression != p_false_expression);
  ROSE_ASSERT(p_condition->get_parent() == this &&
              p_true_expression->get_parent() == this &&
              p_false_expression->get_parent() == this);
}
SOURCE_CHOOSE_EXPRESSION_POST_CONSTRUCTION_INITIALIZATION_END

