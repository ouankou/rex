SOURCE_MACRO_EXPANSION_POST_CONSTRUCTION_INITIALIZATION_START
void $CLASSNAME::post_construction_initialization() {
  if (p_spelling.empty() || p_expanded_expression == nullptr ||
      p_expanded_expression->get_parent() != nullptr) {
    fprintf(stderr, "REX_AST_INVARIANT[macro-expansion-construction]: "
                    "macro requires exact spelling and an unowned expanded "
                    "expression\n");
    ROSE_ABORT();
  }
  p_expanded_expression->set_parent(this);
  p_expansion_source_sequence = SgNode::get_globalAstModificationSequence();
}
SOURCE_MACRO_EXPANSION_POST_CONSTRUCTION_INITIALIZATION_END

