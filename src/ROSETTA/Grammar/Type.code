SOURCE_ARRAY_TYPE_START

// DQ (3/22/2017): I would like to remove this function if possible (it is not
// sufficiently general). Note that this is used within ROSE (which might be
// worth checking out in more detail later).
SgName SgArrayType::get_name(void) const {
  string dimensions = "[]";
  SgType *type = p_base_type;

  for (SgArrayType *array_type = isSgArrayType(type); array_type;
       array_type = isSgArrayType(type)) {
    dimensions += "[]";
    type = array_type->get_base_type();
  }

  string name;
  if (isSgTypeBool(type)) {
    name = "boolean";
  } else if (isSgTypeSignedChar(type)) {
    name = "byte";
  } else if (isSgTypeWchar(type)) {
    name = "char";
  } else if (isSgTypeChar8(type)) {
    name = "char8";
  }
  // DQ (2/16/2018): Adding support for char16_t and char32_t (C99 and C++11
  // specific types).
  else if (isSgTypeChar16(type)) {
    name = "char16";
  }
  // DQ (2/16/2018): Adding support for char16_t and char32_t (C99 and C++11
  // specific types).
  else if (isSgTypeChar32(type)) {
    name = "char32";
  } else if (isSgTypeInt(type)) {
    name = "int";
  } else if (isSgTypeShort(type)) {
    name = "short";
  } else if (isSgTypeFloat(type)) {
    name = "float";
  } else if (isSgTypeLong(type)) {
    name = "long";
  } else if (isSgTypeDouble(type)) {
    name = "double";
  } else if (isSgTypeVoid(type)) {
    name = "void";
  } else if (isSgTypeString(type)) {
    name = "String";
  } else {
    // DQ (3/19/2016): Klocworks reports this as an issue because the result of
    // the 2nd call to isSgNamedType() is not clearly the same result as the
    // first call.  The fix is to just make a single call and save the result.
    // if (isSgNamedType(type))
    SgNamedType *namedType = isSgNamedType(type);
    if (namedType != NULL) {
      // name = isSgNamedType(type) -> get_name().getString();
      name = namedType->get_name().getString();
    }
  }

  name += dimensions;

  return SgName(name);
}

SgName SgArrayType::get_qualified_name(void) const {
  string dimensions = "[]";
  SgType *type = p_base_type;

  for (SgArrayType *array_type = isSgArrayType(type); array_type;
       array_type = isSgArrayType(type)) {
    dimensions += "[]";
    type = array_type->get_base_type();
  }

  string name;
  if (isSgTypeBool(type)) {
    name = "boolean";
  } else if (isSgTypeSignedChar(type)) {
    name = "byte";
  } else if (isSgTypeWchar(type)) {
    name = "char";
  } else if (isSgTypeChar8(type)) {
    name = "char8";
  }
  // DQ (2/16/2018): Adding support for char16_t and char32_t (C99 and C++11
  // specific types).
  else if (isSgTypeChar16(type)) {
    name = "char16";
  }
  // DQ (2/16/2018): Adding support for char16_t and char32_t (C99 and C++11
  // specific types).
  else if (isSgTypeChar32(type)) {
    name = "char32";
  } else if (isSgTypeInt(type)) {
    name = "int";
  } else if (isSgTypeShort(type)) {
    name = "short";
  } else if (isSgTypeFloat(type)) {
    name = "float";
  } else if (isSgTypeLong(type)) {
    name = "long";
  } else if (isSgTypeDouble(type)) {
    name = "double";
  } else if (isSgTypeVoid(type)) {
    name = "void";
  } else if (isSgTypeString(type)) {
    name = "String";
  } else {
    // DQ (3/19/2016): Klocworks reports this as an issue because the result of
    // the 2nd call to isSgNamedType() is not clearly the same result as the
    // first call.  The fix is to just make a single call and save the result.
    // if (isSgNamedType(type))
    SgNamedType *namedType = isSgNamedType(type);
    if (namedType != NULL) {
      // name = isSgNamedType(type) -> get_qualified_name().getString();
      name = namedType->get_qualified_name().getString();
    }
  }

  name += dimensions;

  return SgName(name);
}

// RV (1/31/2006): Changed the form of the mangled name to include begin/end
// tags.
SgName SgArrayType::get_mangled(void) const {
  const SgType *base_type = get_base_type();
  if (base_type == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[array-type-mangle]: array type has no "
                    "base type\n");
    ROSE_ABORT();
  }

  const SgName base_name = base_type->get_mangled();
  if (base_name.is_null()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[array-type-mangle]: base type %s has no "
            "mangled name\n",
            base_type->class_name().c_str());
    ROSE_ABORT();
  }

  const SgExpression *index_exp = get_index();
  const SgExprListExp *dimensions = get_dim_info();
  const std::string bound_kind =
      get_is_variable_length_array() ? "vla" : "fixed";
  std::string shape_name;
  if (dimensions != NULL) {
    const SgExpressionPtrList &shape = dimensions->get_expressions();
    if (index_exp != NULL || dimensions->get_parent() != this ||
        get_rank() <= 0 || shape.size() != static_cast<size_t>(get_rank())) {
      fprintf(stderr,
              "REX_AST_INVARIANT[array-type-mangle]: array=%p has crossed or "
              "malformed index/dimension ownership (index=%p dimensions=%p "
              "parent=%p rank=%d size=%zu)\n",
              static_cast<const void *>(this),
              static_cast<const void *>(index_exp),
              static_cast<const void *>(dimensions),
              static_cast<const void *>(dimensions->get_parent()), get_rank(),
              shape.size());
      ROSE_ABORT();
    }
    const std::string dimensions_name = mangleExpression(dimensions);
    if (dimensions_name.empty()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[array-type-mangle]: structural dimension "
              "mangling produced an empty name\n");
      ROSE_ABORT();
    }
    shape_name = bound_kind + "_rank_" + std::to_string(get_rank()) +
                 "_dimensions_" + dimensions_name;
  } else {
    if (get_rank() != 0) {
      fprintf(stderr,
              "REX_AST_INVARIANT[array-type-mangle]: array=%p has rank=%d "
              "without an exact dimension-list owner\n",
              static_cast<const void *>(this), get_rank());
      ROSE_ABORT();
    }
    shape_name = index_exp == NULL
                     ? bound_kind + "_unsized"
                     : bound_kind + "_index_" + mangleExpression(index_exp);
  }
  if (shape_name.empty()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[array-type-mangle]: structural shape mangling "
            "produced an empty name\n");
    ROSE_ABORT();
  }

  SgName mangled_name;
  mangled_name << "_Ab_" << base_name.str() << "_shape_" << shape_name
               << (get_isCoArray() ? "_coarray_" : "_ordinary_array_")
               << "_Ae_";
  return mangled_name;
}

SOURCE_ARRAY_TYPE_END

