SOURCE_GET_NAME_START
//! Return the name of the type
SgName $CLASSNAME::get_name() const {
  if (get_declaration())
    return isSgClassDeclaration(get_declaration())->get_name();
  else
    return SgName((char *)0L);
}
SOURCE_GET_NAME_END

SOURCE_TYPEDEF_GET_BASE_TYPE_START
SgType *$CLASSNAME::get_base_type() const {
  return (get_declaration())
             ? isSgTypedefDeclaration(get_declaration())->get_base_type()
             : (SgType *)0L;
}
SOURCE_TYPEDEF_GET_BASE_TYPE_END

