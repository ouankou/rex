SOURCE_COMMON_CREATE_TYPE_START

// DQ (1/31/2006): Modified to build all types in the memory pools
// $CLASSNAME $CLASSNAME::builtin_type;
// $CLASSNAME* $CLASSNAME::builtin_type = new $CLASSNAME();
$CLASSNAME *$CLASSNAME::p_builtin_type = NULL;

// DQ (10/4/2010): Added support for optional Fotran type_kind specification.
// $CLASSNAME* $CLASSNAME::createType(void)
$CLASSNAME *$CLASSNAME::createType(SgExpression *optional_fortran_type_kind) {
  // DQ (12/22/2005): Jochen thinks that we need this because the SgNode
  // constructor is not called (likely because static initialization is compiler
  // dependent). DQ (1/31/2006): Modified to build all types in the memory pools
  // builtin_type.p_freepointer = AST_FileIO::IS_VALID_POINTER();
  // return &builtin_type;

  // DQ (10/4/2010): New version of code to support multiple kinds of bool as
  // required for the Fortran type_kind support within ROSE. Note that this
  // implementation does not use p_builtin_type, since with the global type
  // table it is not required.

  if (optional_fortran_type_kind != NULL &&
      optional_fortran_type_kind->get_parent() != NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[primitive-type-kind-owner]: "
                    "candidate KIND expression already has an owner\n");
    ROSE_ABORT();
  }

  const bool has_fortran_type_kind = optional_fortran_type_kind != NULL;
  $CLASSNAME *temp_type = new $CLASSNAME();

  // DQ (10/31/2016): Added assertion.
  ROSE_ASSERT(temp_type != NULL);

  if (optional_fortran_type_kind != NULL && isSgTypeBool(temp_type) == NULL &&
      isSgTypeInt(temp_type) == NULL &&
      isSgTypeUnsignedInt(temp_type) == NULL &&
      isSgTypeFloat(temp_type) == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[primitive-type-kind-category]: "
            "KIND selector was passed to an ineligible semantic type\n");
    ROSE_ABORT();
  }

  if (optional_fortran_type_kind != NULL) {
    // DQ (10/31/2016): Added assertion.
    ROSE_ASSERT(temp_type != NULL);

    temp_type->set_type_kind(optional_fortran_type_kind);
    optional_fortran_type_kind->set_parent(temp_type);
  }

  SgName name = temp_type->get_mangled();

  // DQ (10/31/2016): Added assertion.
  ASSERT_not_null(get_globalTypeTable());

  SgType *t = get_globalTypeTable()->lookup_type(name);

  if (t == NULL) {
    get_globalTypeTable()->insert_type(name, temp_type);
  } else {
    $CLASSNAME *canonical_type = is$CLASSNAME(t);
    if (canonical_type == NULL || canonical_type == temp_type ||
        canonical_type->get_fortran_source_syntax() ||
        canonical_type->get_hasTypeKindStar() ||
        canonical_type->get_fortran_fixed_kind_value_is_available() ||
        canonical_type->get_fortran_fixed_kind_value() != 0 ||
        (canonical_type->get_type_kind() != NULL) != has_fortran_type_kind ||
        (canonical_type->get_type_kind() != NULL &&
         canonical_type->get_type_kind()->get_parent() != canonical_type)) {
      fprintf(stderr, "REX_AST_INVARIANT[primitive-type-interning]: "
                      "cached semantic primitive has contradictory "
                      "identity or KIND ownership\n");
      ROSE_ABORT();
    }

    SgExpression *discarded_kind = temp_type->get_type_kind();
    temp_type->set_type_kind(NULL);
    if (discarded_kind != NULL) {
      if (discarded_kind->get_parent() != temp_type) {
        fprintf(stderr, "REX_AST_INVARIANT[primitive-type-kind-owner]: "
                        "exploratory KIND expression has a different owner\n");
        ROSE_ABORT();
      }
      discarded_kind->set_parent(NULL);
      SageInterface::deleteAST(
          discarded_kind,
          SageInterface::DeleteAstMode::kSkipExternalReferences);
    }
    SageInterface::deleteAST(
        temp_type, SageInterface::DeleteAstMode::kSkipExternalReferences);
    temp_type = canonical_type;
  }

  ASSERT_not_null(temp_type);
  return temp_type;
}

SOURCE_COMMON_CREATE_TYPE_END

// DQ (8/17/2010): removed SOURCE_CREATE_TYPE_WITH_PARAMETER (not used).

SOURCE_CREATE_TYPE_FOR_PARTIAL_FUNCTION_TYPE_START
// $CLASSNAME* $CLASSNAME::createType(SgType* rtype)
$CLASSNAME *$CLASSNAME::createType(SgType *rtype,
                                   SgExpression *optional_fortran_type_kind) {
  // return new $CLASSNAME(rtype);

  // DQ (10/4/2010): I don't think this type can have a fortran type kind
  // parameter.
  ROSE_ASSERT(optional_fortran_type_kind == NULL);

  $CLASSNAME *returnType = new $CLASSNAME(rtype);
  ROSE_ASSERT(returnType != NULL);

  return returnType;
}

SOURCE_CREATE_TYPE_FOR_PARTIAL_FUNCTION_TYPE_END

SOURCE_CREATE_TYPE_FOR_TYPEDEF_TYPE_START
// SgTypedefType* SgTypedefType::createType(SgTypedefDeclaration *decl)
SgTypedefType *
SgTypedefType::createType(SgTypedefDeclaration *decl,
                          SgExpression *optional_fortran_type_kind) {
  // printf ("Inside of SgTypedefType::createType() \n");
  ASSERT_not_null(decl);

  // DQ (10/4/2010): I don't think this type can have a fortran type kind
  // parameter.
  ROSE_ASSERT(optional_fortran_type_kind == nullptr);

  // if (!decl->get_type())
  if (decl->get_type() == NULL) {
    ASSERT_not_null(decl->get_base_type());
    ASSERT_not_null(decl->get_base_type()->p_typedefs);
    // printf ("Before loop over typedef chain:
    // (decl->get_base_type()->p_typedefs)->get_typedefs().size() = %d \n",
    //      (decl->get_base_type()->p_typedefs)->get_typedefs().size());

    SgTypePtrList::iterator i =
        ((decl->get_base_type()->p_typedefs)->get_typedefs().begin());
    while (i != ((decl->get_base_type()->p_typedefs)->get_typedefs().end())) {
      // printf ("In loop over typedef chain \n");

      // SgName dname = decl->get_name();
      // SgTypedefType *tptr= isSgTypedefType((*i).irep());
      ROSE_ASSERT((*i) != NULL);
      SgTypedefType *tptr = isSgTypedefType(*i);
      ROSE_ASSERT(tptr != NULL);

      // DQ (3/21/2012): No, test2004_48.C fails this test.
      // DQ (3/3/2012): I think this is always NULL pointer to a SgSymbol.
      // ROSE_ASSERT(decl->get_parent_scope() == NULL);

      // DQ (3/21/2012): No, test2003_08.C fails this test.
      // DQ (3/3/2012): I think this is always NULL pointer to a SgSymbol.
      // ROSE_ASSERT(tptr->get_parent_scope() == NULL);

      SgTypedefDeclaration *existing_declaration =
          isSgTypedefDeclaration(tptr->get_declaration());
      if (existing_declaration == nullptr || decl->get_scope() == nullptr ||
          existing_declaration->get_scope() == nullptr) {
        fprintf(stderr,
                "REX_AST_INVARIANT[typedef-type-identity]: typedef=%p or "
                "existing typedef=%p has no exact semantic declaration "
                "scope\n",
                static_cast<void *>(decl),
                static_cast<void *>(existing_declaration));
        ROSE_ABORT();
      }
      // A typedef type names one exact typedef declaration.  Repeating the
      // same typedef spelling in one scope is legal, but those source
      // declarations are not interchangeable structural owners.  Sharing a
      // SgTypedefType here made the later declaration point back to the first
      // and hid the malformed identity until type translation or unparsing.
      if (existing_declaration == decl) {
        return tptr;
      }
      i++;
    }

    // decl->set_type(new SgTypedefType(decl, decl->get_parent_scope()));

    // debugging code
    // decl->get_file_info()->display("declration used in
    // $CLASSNAME::createType()");

    // Parent scope is NULL for declarations in global scope
    // ROSE_ASSERT (decl->get_parent_scope() != NULL);
    // DQ (7/22/2010): Use the global type table to get the type.

    // We have to build the type before we can generate a mangle name for it.
    SgTypedefType *tempType = new SgTypedefType(decl, decl->get_parent_scope());
    SgName name = tempType->get_mangled();
    ASSERT_require(name.is_null() == false);

    // Typedef types are owned by declarations, not by the current builder
    // stack.  On-demand frontend translation frequently constructs a typedef
    // while another lexical scope is active, so consulting getCurrentScope()
    // publishes the type in an unrelated table.  The exact declaration scope
    // is the only valid owner.
    SgScopeStatement *currentScope = decl->get_scope();
    ASSERT_not_null(currentScope);

    // A scope can contain multiple legal declarations of the same typedef
    // name.  The type table therefore records each declaration-owned type even
    // when its semantic mangling matches an earlier declaration; lookup by
    // semantic name may select a representative, while the declaration's
    // get_type() remains exact.
    currentScope->get_type_table()->insert_type(name, tempType);
    ASSERT_not_null(tempType);
    decl->set_type(tempType);

    ASSERT_not_null(decl->get_type());
    ASSERT_not_null(decl->get_base_type());
    ASSERT_not_null(decl->get_base_type()->p_typedefs);

    // printf ("Before updating list:
    // (decl->get_base_type()->p_typedefs)->get_typedefs().size() = %d \n",
    //      (decl->get_base_type()->p_typedefs)->get_typedefs().size());

    (decl->get_base_type()->p_typedefs)
        ->get_typedefs()
        .push_back(decl->get_type());
  }

  // printf ("Leaving SgTypedefType::createType() \n");

  ASSERT_not_null(decl);
  ASSERT_not_null(decl->get_type()); // I think we can assert this!
  ASSERT_require((decl->get_base_type()->p_typedefs)->get_typedefs().size() >
                 0);

  return decl->get_type();
}

SOURCE_CREATE_TYPE_FOR_TYPEDEF_TYPE_END

SOURCE_CREATE_TYPE_FOR_FUNCTION_TYPE_START
// SgFunctionType* SgFunctionType::createType(SgPartialFunctionType* ft)
SgFunctionType *
SgFunctionType::createType(SgPartialFunctionType *ft,
                           SgExpression *optional_fortran_type_kind) {
  // The problem with this function is that I have not added the name mangling
  // into SAGE 3 yet!

  ROSE_ASSERT(ft != NULL);

  // DQ (10/4/2010): I don't think this type can have a fortran type kind
  // parameter.
  ROSE_ASSERT(optional_fortran_type_kind == NULL);

  // DQ (3/29/2006):
  // Simplify this function to not use the function type table, thus
  // SgFunctionType nodes are not shared. During function creation.  As a result
  // we don't have to call the functions to mangle the names of things (which
  // traverse parents to compute scopes and can be a problem if called before
  // the parents are set, done in post processing of AST).  However, this design
  // requires that the funtion type symbol table be constructed after the AST is
  // built (and parent pointers are set).  If functions are created then the
  // function type table must also be updated.
  SgFunctionType *theType = new SgFunctionType(ft);

  // DQ (6/21/2006): Since we mangle the return type into the mangled function
  // as part of building the symbol table we don't have to worry about sharing
  // function types that would have different return types.  Here we set the
  // orig_return_type stored explicitly (it seems it is always the same as the
  // return_type.
  ROSE_ASSERT(ft->get_return_type() != NULL);

  ROSE_ASSERT(theType != NULL);
  return theType;
}

SOURCE_CREATE_TYPE_FOR_FUNCTION_TYPE_END

SOURCE_CREATE_TYPE_FOR_MEMBER_FUNCTION_TYPE_START
// SgMemberFunctionType* SgMemberFunctionType::createType(SgPartialFunctionType*
// ft)
SgMemberFunctionType *
SgMemberFunctionType::createType(SgPartialFunctionType *ft,
                                 SgExpression *optional_fortran_type_kind) {
  ROSE_ASSERT(ft != NULL);
  // printf ("In $CLASSNAME::createType(SgPartialFunctionType* ft): calling
  // ft->get_mangled_type \n"); SgName nname = ft->get_mangled_type();

  // DQ (10/4/2010): I don't think this type can have a fortran type kind
  // parameter.
  ROSE_ASSERT(optional_fortran_type_kind == NULL);

  // DQ (3/29/2006):
  // Simplify this function to not use the function type table, thus
  // SgFunctionType nodes are not shared. During function creation.  As a result
  // we don't have to call the functions to mangle the names of things (which
  // traverse parents to compute scopes and can be a problem if called before
  // the parents are set, done in post processing of AST).  However, this design
  // requires that the funtion type symbol table be constructed after the AST is
  // build (and parent pointers are set).  If functions are created then the
  // function type table must also be updated.
  SgMemberFunctionType *theType = new SgMemberFunctionType(ft);

  // DQ (6/22/2006): Since we mangle the return type into the mangled function
  // as part of building the symbol table we don't have to worry about sharing
  // function types that would have different return types.  Here we set the
  // orig_return_type stored explicitly (it seems it is always the same as the
  // return_type.
  ROSE_ASSERT(ft->get_return_type() != NULL);

  ROSE_ASSERT(theType != NULL);
  return theType;
}

SOURCE_CREATE_TYPE_FOR_MEMBER_FUNCTION_TYPE_END

SOURCE_CREATE_TYPE_FOR_POINTER_MEMBER_TYPE_START
namespace {

using PointerMemberSemanticKey = std::pair<SgType *, SgType *>;

std::map<PointerMemberSemanticKey, SgPointerMemberType *> &
pointerMemberSemanticTypeCache() {
  static std::map<PointerMemberSemanticKey, SgPointerMemberType *> cache;
  return cache;
}

void requireExactPointerMemberSemanticIdentity(
    const SgPointerMemberType *type, const PointerMemberSemanticKey &key,
    const char *context) {
  if (type == nullptr || type->get_base_type() != key.first ||
      type->get_class_type() != key.second ||
      type->get_source_class_type_is_unqualified_injected_name() ||
      type->get_source_base_type_qualification_present() ||
      type->get_source_base_type_global_qualification() ||
      !type->get_source_base_type_qualification_tokens().empty()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[pointer-member-semantic-identity]: "
            "context=%s type=%p does not represent exactly base=%p "
            "class=%p without source-only spelling or qualification\n",
            context, static_cast<const void *>(type),
            static_cast<void *>(key.first), static_cast<void *>(key.second));
    ROSE_ABORT();
  }
}

} // namespace

// $CLASSNAME* $CLASSNAME::createType ( SgType* base_type, SgType *class_type )
$CLASSNAME *$CLASSNAME::createType(SgType *base_type, SgType *class_type,
                                   SgExpression *optional_fortran_type_kind) {
  if (base_type == NULL || class_type == NULL ||
      optional_fortran_type_kind != NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[pointer-member-semantic-identity]: "
                    "semantic pointer-member construction requires exact "
                    "base/class types and no Fortran kind\n");
    ROSE_ABORT();
  }

  const PointerMemberSemanticKey key(base_type, class_type);
  std::map<PointerMemberSemanticKey, SgPointerMemberType *> &cache =
      pointerMemberSemanticTypeCache();
  std::map<PointerMemberSemanticKey, SgPointerMemberType *>::iterator found =
      cache.find(key);
  if (found != cache.end()) {
    requireExactPointerMemberSemanticIdentity(found->second, key, "cache-hit");
    return found->second;
  }

  $CLASSNAME *returnType = new $CLASSNAME(base_type, class_type);
  if (returnType == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[pointer-member-semantic-identity]: "
                    "semantic pointer-member allocation failed\n");
    ROSE_ABORT();
  }
  requireExactPointerMemberSemanticIdentity(returnType, key, "new-type");

  std::pair<std::map<PointerMemberSemanticKey, SgPointerMemberType *>::iterator,
            bool>
      inserted = cache.insert(std::make_pair(key, returnType));
  if (!inserted.second || inserted.first->second != returnType) {
    fprintf(stderr, "REX_AST_INVARIANT[pointer-member-semantic-identity]: "
                    "exact semantic pair was published concurrently or with "
                    "a conflicting identity\n");
    ROSE_ABORT();
  }
  return returnType;
}

bool $CLASSNAME::isCanonicalSemanticType(const SgPointerMemberType *type) {
  if (type == NULL) {
    return false;
  }
  if (type->get_base_type() == NULL || type->get_class_type() == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[pointer-member-semantic-identity]: "
                    "queried pointer-member type has no exact base/class "
                    "identity\n");
    ROSE_ABORT();
  }

  const PointerMemberSemanticKey key(type->get_base_type(),
                                     type->get_class_type());
  std::map<PointerMemberSemanticKey, SgPointerMemberType *> &cache =
      pointerMemberSemanticTypeCache();
  std::map<PointerMemberSemanticKey, SgPointerMemberType *>::iterator found =
      cache.find(key);
  if (found == cache.end()) {
    return false;
  }
  requireExactPointerMemberSemanticIdentity(found->second, key,
                                            "canonical-query");
  return found->second == type;
}

SOURCE_CREATE_TYPE_FOR_POINTER_MEMBER_TYPE_END

SOURCE_CREATE_TYPE_FOR_TYPE_INT_TYPE_START
const int SgTypeInt::maxBitLength = ROSE_INTEGER_TYPE_MAX_BIT_LENGTH;
// DQ (1/31/2006): Modified to build all types in the memory pools
// SgTypeInt SgTypeInt::builtin_type[maxBitLength];
// DQ (1/31/2006): Convert to a single builtin pointer rather than an array of
// them. I don't think we really need an array of these internally.
SgTypeInt *SgTypeInt::p_builtin_type = NULL;

// DQ (10/4/2010): Added support for fortran type kind expressions.
// $CLASSNAME* $CLASSNAME::createType(int bitLength)
SgTypeInt *SgTypeInt::createType(int /*bitLength*/,
                                 SgExpression *optional_fortran_type_kind) {

  // DQ (10/5/2010): New version of code to support multiple kinds of SgTypeInt
  // as required for the Fortran type_kind support within ROSE. Note that this
  // implementation does not use p_builtin_type, since with the global type
  // table it is not required.

  if (optional_fortran_type_kind != NULL &&
      optional_fortran_type_kind->get_parent() != NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[primitive-type-kind-owner]: "
                    "candidate INTEGER KIND expression already has an owner\n");
    ROSE_ABORT();
  }

  const bool has_fortran_type_kind = optional_fortran_type_kind != NULL;
  $CLASSNAME *temp_type = new $CLASSNAME();
  if (optional_fortran_type_kind != NULL) {
    temp_type->set_type_kind(optional_fortran_type_kind);
    optional_fortran_type_kind->set_parent(temp_type);
  }

  SgName name = temp_type->get_mangled();

  SgType *t = get_globalTypeTable()->lookup_type(name);
  if (t == NULL) {
    get_globalTypeTable()->insert_type(name, temp_type);
  } else {
    $CLASSNAME *canonical_type = is$CLASSNAME(t);
    if (canonical_type == NULL || canonical_type == temp_type ||
        canonical_type->get_fortran_source_syntax() ||
        canonical_type->get_hasTypeKindStar() ||
        canonical_type->get_fortran_fixed_kind_value_is_available() ||
        canonical_type->get_fortran_fixed_kind_value() != 0 ||
        (canonical_type->get_type_kind() != NULL) != has_fortran_type_kind ||
        (canonical_type->get_type_kind() != NULL &&
         canonical_type->get_type_kind()->get_parent() != canonical_type)) {
      fprintf(stderr, "REX_AST_INVARIANT[primitive-type-interning]: "
                      "cached semantic INTEGER has contradictory "
                      "identity or KIND ownership\n");
      ROSE_ABORT();
    }

    SgExpression *discarded_kind = temp_type->get_type_kind();
    temp_type->set_type_kind(NULL);
    if (discarded_kind != NULL) {
      if (discarded_kind->get_parent() != temp_type) {
        fprintf(stderr,
                "REX_AST_INVARIANT[primitive-type-kind-owner]: "
                "exploratory INTEGER KIND expression has a different owner\n");
        ROSE_ABORT();
      }
      discarded_kind->set_parent(NULL);
      SageInterface::deleteAST(
          discarded_kind,
          SageInterface::DeleteAstMode::kSkipExternalReferences);
    }
    SageInterface::deleteAST(
        temp_type, SageInterface::DeleteAstMode::kSkipExternalReferences);
    temp_type = canonical_type;
  }

  return temp_type;
}

SOURCE_CREATE_TYPE_FOR_TYPE_INT_TYPE_END

SOURCE_CREATE_TYPE_FOR_ENUM_TYPE_START
// SgEnumType* SgEnumType::createType(SgEnumDeclaration* cd)
SgEnumType *SgEnumType::createType(SgEnumDeclaration *cd,
                                   SgExpression *optional_fortran_type_kind) {
  // DQ (10/4/2010): I think that pointer types can't have a kind parameter, so
  // this should be NULL.
  ROSE_ASSERT(optional_fortran_type_kind == NULL);

  SgEnumType *returnType = NULL;
  // return cd->get_type() ? cd->get_type() : new $CLASSNAME(cd);

  if (cd == NULL || cd->get_scope() == NULL ||
      cd->get_scope()->get_type_table() == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[enum-type-canonical-owner]: createType "
            "requires an enum declaration with one exact semantic scope and "
            "type table\n");
    ROSE_ABORT();
  }

  returnType = cd->get_type();
  if (returnType != NULL) {
    SgEnumDeclaration *typeDeclaration =
        isSgEnumDeclaration(returnType->get_declaration());
    if (typeDeclaration == NULL ||
        (typeDeclaration != cd &&
         !enumDeclarationsHaveSameCanonicalFamily(cd, typeDeclaration) &&
         !SageInterface::isExactTagTypeIdentity(returnType, cd))) {
      fprintf(stderr,
              "REX_AST_INVARIANT[enum-type-canonical-owner]: declaration=%p "
              "name=%s carries type=%p owned by unrelated declaration=%p\n",
              static_cast<void *>(cd), cd->get_name().getString().c_str(),
              static_cast<void *>(returnType),
              static_cast<void *>(typeDeclaration));
      ROSE_ABORT();
    }
  }
  if (returnType == NULL) {
    returnType = new SgEnumType(cd);
    ROSE_ASSERT(returnType != NULL);
    SgName name = returnType->get_mangled();
    if (name.is_null()) {
      name = SageInterface::generateUniqueName(
          returnType,
          /* ignoreDifferenceBetweenDefiningAndNondefiningDeclarations = */
          true);
    }
    if (name.is_null()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[enum-type-canonical-owner]: enum=%p has no "
              "internable identity\n",
              static_cast<void *>(cd));
      ROSE_ABORT();
    }
    SgScopeStatement *semanticScope = cd->get_scope();
    SgType *t = semanticScope->get_type_table()->lookup_type(name);
    if (t == NULL) {
      semanticScope->get_type_table()->insert_type(name, returnType);
    } else {
      // If it is already present in the exact declaration scope then reuse
      // that identity.  A different type kind under the same key is malformed.
      ROSE_ASSERT(t != returnType);

#if ALLOW_DELETE_OF_EXPLORATORY_NODE
      delete returnType;
#endif
      returnType = isSgEnumType(t);
      SgEnumDeclaration *internedDeclaration =
          returnType != NULL
              ? isSgEnumDeclaration(returnType->get_declaration())
              : NULL;
      if (returnType == NULL || internedDeclaration == NULL ||
          !enumDeclarationsHaveSameCanonicalFamily(cd, internedDeclaration)) {
        fprintf(stderr,
                "REX_AST_INVARIANT[enum-type-canonical-owner]: scope=%p "
                "identity=%s collides with unrelated type=%p/%s owner=%p\n",
                static_cast<void *>(semanticScope), name.str(),
                static_cast<void *>(t), t->class_name().c_str(),
                static_cast<void *>(internedDeclaration));
        ROSE_ABORT();
      }
    }
    cd->set_type(returnType);
  }

  ROSE_ASSERT(returnType != NULL);

  return returnType;
}

SOURCE_CREATE_TYPE_FOR_ENUM_TYPE_END

SOURCE_CREATE_TYPE_FOR_CLASS_TYPE_START

namespace {

bool enumDeclarationsHaveSameCanonicalFamily(SgEnumDeclaration *left,
                                             SgEnumDeclaration *right) {
  if (left == NULL || right == NULL) {
    return false;
  }
  if (left == right) {
    return true;
  }

  SgEnumDeclaration *leftFirst =
      isSgEnumDeclaration(left->get_firstNondefiningDeclaration());
  SgEnumDeclaration *rightFirst =
      isSgEnumDeclaration(right->get_firstNondefiningDeclaration());
  if (leftFirst == NULL || rightFirst == NULL || leftFirst != rightFirst ||
      leftFirst->get_firstNondefiningDeclaration() != leftFirst) {
    return false;
  }

  SgEnumDeclaration *familyDefinition =
      isSgEnumDeclaration(leftFirst->get_definingDeclaration());
  if (familyDefinition != NULL &&
      (familyDefinition->get_definingDeclaration() != familyDefinition ||
       familyDefinition->get_firstNondefiningDeclaration() != leftFirst)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[enum-type-canonical-owner]: enum declaration "
            "family has a contradictory defining-declaration chain\n");
    ROSE_ABORT();
  }

  SgEnumDeclaration *rightFamilyDefinition =
      isSgEnumDeclaration(rightFirst->get_definingDeclaration());
  if (rightFamilyDefinition != familyDefinition) {
    return false;
  }

  return true;
}

} // namespace

// SgClassType* SgClassType::createType(SgClassDeclaration * cd)
// SgClassType* SgClassType::createType(SgClassDeclaration * cd, SgExpression*
// optional_fortran_type_kind)
SgClassType *SgClassType::createType(SgDeclarationStatement *cd,
                                     SgExpression *optional_fortran_type_kind) {
  if (cd == NULL || isSgClassDeclaration(cd) == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: createType "
                    "requires a non-null SgClassDeclaration\n");
    ROSE_ABORT();
  }
  if (optional_fortran_type_kind != NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: "
                    "SgClassType cannot carry a Fortran kind expression\n");
    ROSE_ABORT();
  }

  SgClassDeclaration *classDeclaration = isSgClassDeclaration(cd);
  SgClassDeclaration *firstNondefining =
      isSgClassDeclaration(classDeclaration->get_firstNondefiningDeclaration());
  if (firstNondefining == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: class "
                    "declaration has no typed first nondefining declaration\n");
    ROSE_ABORT();
  }
  if (classDeclaration != firstNondefining) {
    fprintf(stderr,
            "REX_AST_INVARIANT[class-type-canonical-owner]: createType must be "
            "called with the canonical first nondefining declaration\n");
    ROSE_ABORT();
  }
  if (firstNondefining->get_firstNondefiningDeclaration() != firstNondefining) {
    fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: first "
                    "nondefining declaration is not self-canonical\n");
    ROSE_ABORT();
  }

  SgScopeStatement *canonicalScope = firstNondefining->get_scope();
  if (canonicalScope == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: canonical "
                    "first nondefining declaration has no semantic scope\n");
    ROSE_ABORT();
  }
  if (canonicalScope->get_type_table() == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: canonical "
                    "declaration scope has no type table\n");
    ROSE_ABORT();
  }

  SgClassDeclaration *definingDeclaration = NULL;
  if (firstNondefining->get_definingDeclaration() != NULL) {
    definingDeclaration =
        isSgClassDeclaration(firstNondefining->get_definingDeclaration());
    if (definingDeclaration == NULL) {
      fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: defining "
                      "declaration has the wrong AST kind\n");
      ROSE_ABORT();
    }
    if (definingDeclaration->get_definingDeclaration() != definingDeclaration ||
        definingDeclaration->get_firstNondefiningDeclaration() !=
            firstNondefining ||
        (definingDeclaration->get_scope() != canonicalScope &&
         !SgScopeStatement::isEquivalentScope(definingDeclaration->get_scope(),
                                              canonicalScope)) ||
        definingDeclaration->get_definition() == NULL) {
      fprintf(
          stderr,
          "REX_AST_INVARIANT[class-type-canonical-owner]: canonical=%p/%s "
          "scope=%p defining=%p first=%p self=%p scope=%p definition=%p "
          "chain or scope disagrees with its canonical owner\n",
          static_cast<void *>(firstNondefining),
          firstNondefining->get_name().getString().c_str(),
          static_cast<void *>(canonicalScope),
          static_cast<void *>(definingDeclaration),
          static_cast<void *>(
              definingDeclaration->get_firstNondefiningDeclaration()),
          static_cast<void *>(definingDeclaration->get_definingDeclaration()),
          static_cast<void *>(definingDeclaration->get_scope()),
          static_cast<void *>(definingDeclaration->get_definition()));
      ROSE_ABORT();
    }
  }

  if (firstNondefining->get_definition() != NULL &&
      definingDeclaration != firstNondefining) {
    fprintf(
        stderr,
        "REX_AST_INVARIANT[class-type-canonical-owner]: canonical declaration "
        "owns a definition but is not the defining declaration\n");
    ROSE_ABORT();
  }

  SgType *declarationType = firstNondefining->get_type();
  if (declarationType != NULL) {
    $CLASSNAME *canonicalType = is$CLASSNAME(declarationType);
    SgClassDeclaration *typeDeclaration =
        canonicalType != NULL
            ? isSgClassDeclaration(canonicalType->get_declaration())
            : NULL;
    const bool exactSharedProjectType =
        typeDeclaration != NULL &&
        SageInterface::isExactTagTypeIdentity(canonicalType, firstNondefining);
    if (canonicalType == NULL ||
        (typeDeclaration != firstNondefining && !exactSharedProjectType)) {
      fprintf(stderr,
              "REX_AST_INVARIANT[class-type-canonical-owner]: canonical "
              "declaration carries a noncanonical class type\n");
      ROSE_ABORT();
    }
    if (definingDeclaration != NULL &&
        definingDeclaration->get_type() != canonicalType) {
      fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: defining "
                      "declaration does not share its canonical class type\n");
      ROSE_ABORT();
    }
    return canonicalType;
  }

  if (definingDeclaration != NULL && definingDeclaration->get_type() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[class-type-canonical-owner]: defining "
            "declaration published a type before its canonical owner\n");
    ROSE_ABORT();
  }

  $CLASSNAME *newType = new $CLASSNAME(firstNondefining);
  ROSE_ASSERT(newType != NULL);

  SgName name = newType->get_mangled();
  if (name.is_null() == true) {
    name = SageInterface::generateUniqueName(
        newType,
        /* ignoreDifferenceBetweenDefiningAndNondefiningDeclarations = */
        true);
  }
  if (name.is_null() == true) {
    fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: canonical "
                    "class type has no internable identity\n");
    ROSE_ABORT();
  }

  SgType *internedType = canonicalScope->get_type_table()->lookup_type(name);
  if (internedType != NULL) {
    SgClassType *internedClassType = isSgClassType(internedType);
    SgClassDeclaration *internedDeclaration =
        internedClassType != NULL
            ? isSgClassDeclaration(internedClassType->get_declaration())
            : NULL;
    fprintf(
        stderr,
        "REX_AST_INVARIANT[class-type-canonical-owner]: canonical declaration "
        "%p/%s source-name='%s' mangled-name='%s' has no type but scope=%p "
        "already contains type=%p/%s owned by declaration=%p/%s/%s\n",
        static_cast<void *>(firstNondefining),
        firstNondefining->class_name().c_str(),
        firstNondefining->get_name().getString().c_str(),
        name.getString().c_str(), static_cast<void *>(canonicalScope),
        static_cast<void *>(internedType), internedType->class_name().c_str(),
        static_cast<void *>(internedDeclaration),
        internedDeclaration != NULL ? internedDeclaration->class_name().c_str()
                                    : "<null>",
        internedDeclaration != NULL
            ? internedDeclaration->get_name().getString().c_str()
            : "<null>");
    ROSE_ABORT();
  }

  canonicalScope->get_type_table()->insert_type(name, newType);
  firstNondefining->set_type(newType);
  if (definingDeclaration != NULL && definingDeclaration != firstNondefining) {
    definingDeclaration->set_type(newType);
  }

  ROSE_ASSERT(newType->get_declaration() == firstNondefining);
  ROSE_ASSERT(firstNondefining->get_type() == newType);
  ROSE_ASSERT(definingDeclaration == NULL ||
              definingDeclaration->get_type() == newType);
  return newType;
}

SOURCE_CREATE_TYPE_FOR_CLASS_TYPE_END

SOURCE_CREATE_TYPE_FOR_TEMPLATE_TYPE_START

