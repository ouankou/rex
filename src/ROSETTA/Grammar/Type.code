SOURCE_GET_MANGLED_START
SgName $CLASSNAME::get_mangled(void) const {

  SgName name = "MANGLED_ID_STRING";
  if (SgExpression *kind = get_type_kind()) {
    if (!SageInterface::Detail::isValidFortranKindSelector(kind)) {
      fprintf(stderr, "REX_AST_INVARIANT[type-kind-identity]: KIND selector "
                      "is not a positive integer constant\n");
      ROSE_ABORT();
    }
    name += string("_kind") +
            SageInterface::Detail::fortranIntegerSelectorValue(kind)->decimal();
  }

  return name;
}
SOURCE_GET_MANGLED_END

SOURCE_GET_MANGLED_BASE_TYPE_START

/*! Returns a mangled name representation of types with base types
 *  (e.g., pointer, reference).
 */
SgName $CLASSNAME::get_mangled(void) const {

  const SgType *base_type = get_base_type();
  ROSE_ASSERT(base_type != NULL);

  const SgName base_name = base_type->get_mangled();
  ROSE_ASSERT(!base_name.is_null());

  SgName mangled_name;
  mangled_name << "__" << "MANGLED_ID_STRING" << "b__"  // start tag
               << base_name.str()                       // base type
               << "__" << "MANGLED_ID_STRING" << "e__"; // end tag

  return mangled_name;
}

SOURCE_GET_MANGLED_BASE_TYPE_END

SOURCE_POINTER_MEMBER_GET_MANGLED_START
SgName $CLASSNAME::get_mangled(void) const {

  // Generate a pointer type _without_ the class name in it
  string base_str = SgPointerType::get_mangled().getString();

  // Mangle the class name
  const SgType *cls_type = get_class_type();
  ROSE_ASSERT(cls_type);
  string cls_name = cls_type->get_mangled().getString();

  // Now embed the fully qualified class name in it
  string mangled_name(base_str);
  const string ptr_begin_tag("__Pb__");
  string::size_type pos_begin = mangled_name.find(ptr_begin_tag);
  mangled_name.replace(pos_begin, ptr_begin_tag.size(), "__PMb__" + cls_name);

  return SgName(mangled_name.c_str());
}

SOURCE_POINTER_MEMBER_GET_MANGLED_END

SOURCE_GET_MANGLED_STRING_TYPE_START

/*! Returns a mangled name representation of strings types with the size of the
 * string (e.g., literal, *, or integer expression).
 */
SgName SgTypeString::get_mangled(void) const {

  SgName mangled_name;
  if (p_fortran_dynamic_length_pending) {
    fprintf(stderr,
            "REX_AST_INVARIANT[dynamic-character-object-type]: unresolved "
            "dynamic object length reached type identity mangling\n");
    ROSE_ABORT();
  }
  if (p_fortran_dynamic_result_length &&
      (p_fortran_source_syntax || p_fortran_dynamic_length_pending ||
       p_lengthExpression != NULL)) {
    fprintf(
        stderr,
        "REX_AST_INVARIANT[dynamic-character-result-type]: "
        "dynamic result length has contradictory source or selector state\n");
    ROSE_ABORT();
  }
  SgName mangled_length_name;
  if (p_fortran_dynamic_result_length) {
    mangled_length_name = "dynamic_result";
  } else if (p_lengthExpression == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[string-type-length]: CHARACTER string type "
            "has no exact length selector\n");
    ROSE_ABORT();
  } else if (!SageInterface::Detail::isValidFortranLengthSelector(
                 p_lengthExpression)) {
    fprintf(stderr, "REX_AST_INVARIANT[string-type-length]: CHARACTER LEN "
                    "selector is not an integer or length shape\n");
    ROSE_ABORT();
  } else if (isSgAsteriskShapeExp(p_lengthExpression) != NULL) {
    mangled_length_name = "assumed_length";
  } else if (isSgColonShapeExp(p_lengthExpression) != NULL) {
    mangled_length_name = "deferred_length";
  } else if (const auto value =
                 SageInterface::Detail::fortranIntegerSelectorValue(
                     p_lengthExpression)) {
    mangled_length_name = "value_" + value->decimal();
  } else {
    const std::string structural_name = mangleExpression(p_lengthExpression);
    if (structural_name.empty()) {
      fprintf(stderr, "REX_AST_INVARIANT[string-type-length]: CHARACTER length "
                      "expression has no exact structural identity\n");
      ROSE_ABORT();
    }
    mangled_length_name = "expression_" + structural_name;
  }
  if (p_type_kind) {
    if (!SageInterface::Detail::isValidFortranKindSelector(p_type_kind)) {
      fprintf(stderr, "REX_AST_INVARIANT[string-type-kind]: CHARACTER KIND "
                      "selector is not a positive integer constant\n");
      ROSE_ABORT();
    }
    const SgName mangled_kind_name =
        "value_" + SageInterface::Detail::fortranIntegerSelectorValue(p_type_kind)
                       ->decimal();
    mangled_name << "__" << "MANGLED_ID_STRING" << "b__"  // start tag
                 << mangled_length_name.str()             // length
                 << "__" << mangled_kind_name.str()       // kind
                 << "__" << "MANGLED_ID_STRING" << "e__"; // end tag
  } else {
    mangled_name << "__" << "MANGLED_ID_STRING" << "b__"  // start tag
                 << mangled_length_name.str()             // length
                 << "__" << "MANGLED_ID_STRING" << "e__"; // end tag
  }

  return mangled_name;
}

SOURCE_GET_MANGLED_STRING_TYPE_END

// ########################################################
// ########################################################
//           TYPE SPECIFIC FUNCTION DEFINITIONS
// ########################################################
// ########################################################

SOURCE_MAIN_TYPE_START

namespace {
SgType *sourcePrototypeBase(const SgType *type) {
  SgType *base = nullptr;
  if (auto *pointer = isSgPointerType(type))
    base = pointer->get_base_type();
  else if (auto *reference = isSgReferenceType(type))
    base = reference->get_base_type();
  else if (auto *reference = isSgRvalueReferenceType(type))
    base = reference->get_base_type();
  else if (auto *modifier = isSgModifierType(type))
    base = modifier->get_base_type();
  else if (auto *array = isSgArrayType(type))
    base = array->get_base_type();
  else
    return nullptr;
  ASSERT_not_null(base);
  return base;
}
} // namespace

bool SgType::has_source_prototype() const {
  const SgType *type = this;
  const SgType *fast = this;
  while (type != nullptr) {
    if (auto *function = isSgFunctionType(type)) {
      ASSERT_not_null(function->get_argument_list());
      return function->get_argument_list()->get_source_parameters() != nullptr;
    }
    type = sourcePrototypeBase(type);
    if (fast != nullptr)
      fast = sourcePrototypeBase(fast);
    if (fast != nullptr)
      fast = sourcePrototypeBase(fast);
    ROSE_ASSERT(type == nullptr || type != fast);
  }
  return false;
}

void SgType::post_construction_initialization() {
  SgType *base = sourcePrototypeBase(this);
  if (base == nullptr || !base->has_source_prototype())
    return;
  ROSE_ASSERT(base != this);
  ROSE_ASSERT(base->get_parent() == nullptr || base->get_parent() == this);
  base->set_parent(this);
}

#include "FortranIntegerSelector.h"

namespace {
bool equivalentFortranSelector(const SgExpression *left,
                               const SgExpression *right) {
  if (left == nullptr || right == nullptr)
    return left == right;
  if (isSgAsteriskShapeExp(left) || isSgColonShapeExp(left) ||
      isSgAsteriskShapeExp(right) || isSgColonShapeExp(right))
    return left->variantT() == right->variantT();
  const auto left_value =
      SageInterface::Detail::fortranIntegerSelectorValue(left);
  const auto right_value =
      SageInterface::Detail::fortranIntegerSelectorValue(right);
  if (left_value || right_value)
    return left_value && right_value &&
           left_value->words() == right_value->words() &&
           left_value->isNegative() == right_value->isNegative();
  return SageInterface::constraintExpressionEquivalence(left, right);
}

template <class Primitive> Primitive *createPrimitiveType(SgExpression *kind) {
  if (kind != nullptr && kind->get_parent() != nullptr) {
    fprintf(stderr, "REX_AST_INVARIANT[primitive-type-kind-owner]: "
                    "candidate KIND expression already has an owner\n");
    ROSE_ABORT();
  }
  if (kind != nullptr &&
      !SageInterface::Detail::isValidFortranKindSelector(kind)) {
    fprintf(stderr, "REX_AST_INVARIANT[primitive-type-kind]: KIND selector "
                    "is not a positive integer constant\n");
    ROSE_ABORT();
  }
  auto restore_kind = [](Primitive *type) {
    if (SgExpression *selector = type->get_type_kind()) {
      ROSE_ASSERT(selector->get_parent() == type);
      selector->set_parent(nullptr);
      type->set_type_kind(nullptr);
    }
    delete type;
  };
  std::unique_ptr<Primitive, decltype(restore_kind)> candidate(new Primitive(),
                                                               restore_kind);
  if (kind != nullptr && isSgTypeBool(candidate.get()) == nullptr &&
      isSgTypeInt(candidate.get()) == nullptr &&
      isSgTypeUnsignedInt(candidate.get()) == nullptr &&
      isSgTypeFloat(candidate.get()) == nullptr) {
    fprintf(stderr,
            "REX_AST_INVARIANT[primitive-type-kind-category]: "
            "KIND selector was passed to an ineligible semantic type\n");
    ROSE_ABORT();
  }
  candidate->set_type_kind(kind);
  if (kind != nullptr)
    kind->set_parent(candidate.get());

  const SgName name = candidate->get_mangled();
  auto *table = SgNode::get_globalTypeTable();
  ASSERT_not_null(table);
  SgType *existing = table->lookup_type(name);
  if (existing == nullptr) {
    table->insert_type(name, candidate.get());
    return candidate.release();
  }
  if (existing->variantT() != candidate->variantT() ||
      existing == candidate.get() || existing->get_fortran_source_syntax() ||
      existing->get_hasTypeKindStar() ||
      existing->get_fortran_fixed_kind_value_is_available() ||
      existing->get_fortran_fixed_kind_value() != 0 ||
      (existing->get_type_kind() != nullptr) != (kind != nullptr) ||
      (existing->get_type_kind() != nullptr &&
       existing->get_type_kind()->get_parent() != existing)) {
    fprintf(stderr, "REX_AST_INVARIANT[primitive-type-interning]: "
                    "cached semantic primitive has contradictory "
                    "identity or KIND ownership\n");
    ROSE_ABORT();
  }
  if (kind != nullptr) {
    ROSE_ASSERT(kind->get_parent() == candidate.get());
    kind->set_parent(nullptr);
    candidate->set_type_kind(nullptr);
    SageInterface::deleteAST(
        kind, SageInterface::DeleteAstMode::kSkipExternalReferences);
  }
  return static_cast<Primitive *>(existing);
}
} // namespace

SgType::SgType()
    : p_ref_to(NULL), p_ptr_to(NULL), p_modifiers(NULL), p_rvalue_ref_to(NULL),
      p_type_kind(NULL), p_hasTypeKindStar(false),
      p_fortran_fixed_kind_value_is_available(false),
      p_fortran_fixed_kind_value(0), p_fortran_source_syntax(false),
      p_ast_json_type_identity(0), p_attributeMechanism(NULL) {
  ROSE_ASSERT(p_ref_to == NULL);
  ROSE_ASSERT(p_ptr_to == NULL);
  ROSE_ASSERT(p_modifiers == NULL);

  ROSE_ASSERT(p_rvalue_ref_to == NULL);

  p_isCoArray = false;
}

SgType::SgType(const SgType &X)
    : SgNode(), p_isCoArray(X.p_isCoArray),
      p_ref_to(nullptr), p_ptr_to(nullptr), p_modifiers(nullptr),
      p_rvalue_ref_to(nullptr), p_type_kind(nullptr),
      p_hasTypeKindStar(X.p_hasTypeKindStar),
      p_fortran_fixed_kind_value_is_available(
          X.p_fortran_fixed_kind_value_is_available),
      p_fortran_fixed_kind_value(X.p_fortran_fixed_kind_value),
      p_fortran_source_syntax(X.p_fortran_source_syntax),
      p_ast_json_type_identity(0), p_attributeMechanism(nullptr) {
  // A distinct type has independent owned syntax and attributes, and no reverse
  // cache or serialization identity inherited from its source.
  std::unique_ptr<AstAttributeMechanism> attributes(
      X.p_attributeMechanism != nullptr
          ? new AstAttributeMechanism(*X.p_attributeMechanism)
          : nullptr);
  std::unique_ptr<SgExpression> kind;
  if (X.p_type_kind != nullptr) {
    SgTreeCopy copy;
    kind.reset(isSgExpression(X.p_type_kind->copy(copy)));
    ROSE_ASSERT(kind != nullptr);
    kind->set_parent(this);
  }
  p_type_kind = kind.release();
  p_attributeMechanism = attributes.release();
}

SgName SgType::get_mangled(void) const {
  // This should be an error, I think!
  printf("ERROR: base calss get_mangled functions should not be called! \n");
  ROSE_ABORT();

  return "";
}

bool SgType::isIntegerType() const {
  const SgType *t = stripTypedefsAndModifiers();
  ROSE_ASSERT(t != NULL);

  return isSgIntegralType(t);
}

bool SgType::isFloatType() const {
  const SgType *t = stripTypedefsAndModifiers();
  ROSE_ASSERT(t != NULL);

  return isSgFloatingPointType(t);
}

bool SgType::isUnsignedType() const {
  const SgType *t =
      stripType(STRIP_TYPEDEF_TYPE | STRIP_MODIFIER_TYPE | STRIP_DECLTYPE_TYPE);
  ROSE_ASSERT(t != NULL);

  return isSgUnsignedIntegralType(t);
}

bool SgType::isPrimativeType() const {
  if (isSgFloatingPointType(this) || isSgIntegralType(this)) {
    return true; // 1
  } else {
    switch (variant()) {
      // Other kinds of float types.
    case T_COMPLEX:
    case T_IMAGINARY:

      // Other types
    case T_VOID:
    case T_LABEL:
    case T_NULLPTR:
    case T_DECLTYPE:
    case T_STRING:

      return true; // 1

    default:
      return false; // 0
    }
  }
}

SgType *SgType::dereference() {
  // This function does not recursively decend into types, so it should not use
  // the lower level SgType::stripType() member function.

  SgType *t = this;
  ROSE_ASSERT(t != NULL);
  while (t->variant() == T_TYPEDEF)
    t = ((SgTypedefType *)t)->get_base_type();

  if (t->variant() == T_POINTER)
    return ((SgPointerType *)t)->get_base_type();
  else if (t->variant() == T_REFERENCE)
    return ((SgReferenceType *)t)->get_base_type();
  else if (t->variant() == T_ARRAY)
    return ((SgArrayType *)t)->get_base_type();
  else
    return (SgType *)t;
}

SgType *SgType::stripTypedefsAndModifiers() const {
  return stripType(STRIP_MODIFIER_TYPE | STRIP_TYPEDEF_TYPE);
}

SgType *SgType::findBaseType() const {
  return stripType();
}


SgType *SgType::stripType(unsigned char bit_array) const {
  // This function forms the low level support for both SgType::findBaseType()
  // and SgType::stripTypedefsAndModifiers().  It takes a default valued
  // bit_array == (STRIP_MODIFIER_TYPE | STRIP_REFERENCE_TYPE |
  // STRIP_RVALUE_REFERENCE_TYPE | STRIP_POINTER_TYPE | STRIP_ARRAY_TYPE |
  // STRIP_TYPEDEF_TYPE | STRIP_POINTER_MEMBER_TYPE | STRIP_DECLTYPE_TYPE)
  // Alternatively any of these values may be ORed together for other
  // combinations.

  // Cast away const of "this" pointer
  SgType *currentType = (SgType *)this;


  SgModifierType *modType = NULL;
  SgPointerType *pointType = NULL;
  SgReferenceType *refType = NULL;
  SgRvalueReferenceType *rRefType = NULL;
  SgArrayType *arrayType = NULL;
  SgTypedefType *typedefType = NULL;
  SgType *aliasedType = nullptr;
  SgDeclType *declType = NULL;

  SgPointerMemberType *pointerMemberType = NULL;

  size_t counter = 0;
  static const size_t shallowCycleCheckLimit = 20;
  SgType *shallowSeenTypes[shallowCycleCheckLimit];
  size_t shallowSeenCount = 0;
  shallowSeenTypes[shallowSeenCount++] = currentType;
  std::set<SgType *> *deepSeenTypes = NULL;
  while (true) {
    if ((bit_array & STRIP_MODIFIER_TYPE) &&
        (modType = isSgModifierType(currentType))) {
      currentType = modType->get_base_type();
    } else if ((bit_array & STRIP_REFERENCE_TYPE) &&
               (refType = isSgReferenceType(currentType))) {
      currentType = refType->get_base_type();
    } else if ((bit_array & STRIP_RVALUE_REFERENCE_TYPE) &&
               (rRefType = isSgRvalueReferenceType(currentType))) {
      currentType = rRefType->get_base_type();
    } else if ((bit_array & STRIP_POINTER_TYPE) &&
               ((pointType = isSgPointerType(currentType)) &&
                (isSgPointerMemberType(currentType) == NULL))) {
      ROSE_ASSERT(pointType != NULL);

      currentType = pointType->get_base_type();
    } else if ((bit_array & STRIP_POINTER_MEMBER_TYPE) &&
               (pointerMemberType = isSgPointerMemberType(currentType))) {
      currentType = pointerMemberType->get_base_type();
    } else if ((bit_array & STRIP_ARRAY_TYPE) &&
               (arrayType = isSgArrayType(currentType))) {
      currentType = arrayType->get_base_type();
    } else if ((bit_array & STRIP_TYPEDEF_TYPE) &&
               (typedefType = isSgTypedefType(currentType))) {
      currentType = typedefType->get_base_type();
    } else if ((bit_array & STRIP_TYPEDEF_TYPE) &&
               isSgNonrealType(currentType) != nullptr &&
               (aliasedType =
                    isSgNonrealType(currentType)->get_aliased_type()) !=
                   nullptr) {
      currentType = aliasedType;
    } else if ((bit_array & STRIP_DECLTYPE_TYPE) &&
               (declType = isSgDeclType(currentType))) {
      currentType = declType->get_base_type();
    } else {
      // Exit the while(true){} loop!
      ROSE_ASSERT(currentType != NULL);
      break;
    }

    ROSE_ASSERT(currentType != NULL);

    bool seenType = false;
    if (deepSeenTypes != NULL) {
      seenType = deepSeenTypes->find(currentType) != deepSeenTypes->end();
      if (seenType == false) {
        deepSeenTypes->insert(currentType);
      }
    } else {
      for (size_t i = 0; i < shallowSeenCount; ++i) {
        if (shallowSeenTypes[i] == currentType) {
          seenType = true;
          break;
        }
      }

      if (seenType == false) {
        if (shallowSeenCount < shallowCycleCheckLimit) {
          shallowSeenTypes[shallowSeenCount++] = currentType;
        } else {
          deepSeenTypes = new std::set<SgType *>();
          for (size_t i = 0; i < shallowSeenCount; ++i) {
            deepSeenTypes->insert(shallowSeenTypes[i]);
          }
          deepSeenTypes->insert(currentType);
        }
      }
    }

    if (seenType == true) {
      MLOG_FATAL_C("ROSETTA",
                   "SgType::stripType detected a cycle "
                   "(counter=%" PRIuPTR ", bit_array=%u, currentType=%p %s).\n",
                   counter, bit_array, currentType,
                   currentType ? currentType->class_name().c_str() : "<null>");
      ROSE_ABORT();
    }

    counter++;
  }

  ROSE_ASSERT(currentType != NULL);

  delete deepSeenTypes;

  return currentType;
}

SgDeclarationStatement *SgType::getAssociatedDeclaration() const {
  SgDeclarationStatement *declaration = NULL;

  // Resolve to the base type (but not past typedef types).  Note that a subtle
  // point is that we want to avoid expressing typedefs that are private in
  // functions that are public.
  SgType *strippedType = this->stripType(
      SgType::STRIP_MODIFIER_TYPE | SgType::STRIP_REFERENCE_TYPE |
      SgType::STRIP_RVALUE_REFERENCE_TYPE | SgType::STRIP_POINTER_TYPE |
      SgType::STRIP_ARRAY_TYPE);
  ROSE_ASSERT(strippedType != NULL);

  // Check if this is a named type (either SgClassType, SgEnumType, or
  // SgTypedefType).
  SgNamedType *namedType = isSgNamedType(strippedType);
  if (namedType != NULL) {
    // Look for the declaration and evaluate if it required qualification.
    declaration = namedType->get_declaration();
    ROSE_ASSERT(SgNode::isLiveNode(declaration));
  }

  SgFunctionType *functionType = isSgFunctionType(strippedType);
  if (functionType != NULL) {
    SgType *returnType = functionType->get_return_type();
    ROSE_ASSERT(returnType != NULL);

    declaration = returnType->getAssociatedDeclaration();
  }

  return declaration;
}

bool SgType::hasExplicitType() {
  bool returnValue = false;

  if (isSgPointerType(this) != NULL || isSgArrayType(this) != NULL ||
      isSgReferenceType(this) != NULL || isSgPointerMemberType(this) != NULL ||
      isSgMemberFunctionType(this) != NULL || isSgTypeComplex(this) != NULL ||
      isSgTypeImaginary(this) != NULL || isSgFunctionType(this) != NULL ||
      isSgModifierType(this) != NULL) {
    returnValue = true;
  }

  return returnValue;
}

bool SgType::containsInternalTypes() {
  bool returnValue = false;

  if (isSgPointerType(this) != NULL || isSgArrayType(this) != NULL ||
      isSgReferenceType(this) != NULL || isSgTypedefType(this) != NULL ||
      isSgFunctionType(this) != NULL || isSgModifierType(this) != NULL) {
    returnValue = true;
  }

  return returnValue;
}

Rose_STL_Container<SgType *> SgType::getInternalTypes() const {
  Rose_STL_Container<SgType *> internalTypes;
  std::set<SgType *> visited;
  auto append = [&](SgType *type) {
    ASSERT_not_null(type);
    if (visited.insert(type).second)
      internalTypes.push_back(type);
  };
  append(const_cast<SgType *>(this));
  for (size_t index = 0; index < internalTypes.size(); ++index) {
    SgType *type = internalTypes[index];
    if (auto *modifier = isSgModifierType(type)) {
      append(modifier->get_base_type());
    } else if (auto *member = isSgPointerMemberType(type)) {
      append(member->get_base_type());
      append(member->get_class_type());
    } else if (auto *pointer = isSgPointerType(type)) {
      append(pointer->get_base_type());
    } else if (auto *reference = isSgReferenceType(type)) {
      append(reference->get_base_type());
    } else if (auto *reference = isSgRvalueReferenceType(type)) {
      append(reference->get_base_type());
    } else if (auto *array = isSgArrayType(type)) {
      append(array->get_base_type());
    } else if (auto *alias = isSgTypedefType(type)) {
      auto *declaration = isSgTypedefDeclaration(alias->get_declaration());
      ASSERT_not_null(declaration);
      append(declaration->get_base_type());
    } else if (auto *nonreal = isSgNonrealType(type)) {
      if (auto *aliased = nonreal->get_aliased_type())
        append(aliased);
    } else if (auto *function = isSgFunctionType(type)) {
      append(function->get_return_type());
      if (auto *semantic = function->get_semantic_signature())
        append(semantic);
      ASSERT_not_null(function->get_argument_list());
      for (SgType *argument : function->get_arguments())
        append(argument);
      for (SgType *exception : function->get_exception_specification_types())
        append(exception);
      if (auto *member = isSgMemberFunctionType(function)) {
        if (SgType *classType = member->get_class_type())
          append(classType);
      }
    } else if (auto *decltypeType = isSgDeclType(type)) {
      append(decltypeType->get_base_type());
    } else if (auto *typeofType = isSgTypeOfType(type)) {
      append(typeofType->get_base_type());
    } else if (auto *transform = isSgUnaryTransformType(type)) {
      append(transform->get_operand_type());
    } else if (auto *complex = isSgTypeComplex(type)) {
      append(complex->get_base_type());
    } else if (auto *imaginary = isSgTypeImaginary(type)) {
      append(imaginary->get_base_type());
    }

    const SgTemplateArgumentPtrList *arguments = nullptr;
    if (auto *parameter = isSgTemplateType(type)) {
      arguments = &parameter->get_tpl_args();
    } else if (auto *named = isSgNamedType(type)) {
      SgDeclarationStatement *declaration = named->get_declaration();
      ASSERT_not_null(declaration);
      if (auto *nonreal = isSgNonrealDecl(declaration))
        arguments = &nonreal->get_tpl_args();
      else if (auto *instantiation = isSgTemplateInstantiationDecl(declaration))
        arguments = &instantiation->get_semanticTemplateArguments();
      else if (auto *instantiation =
                   isSgTemplateInstantiationTypedefDeclaration(declaration))
        arguments = &instantiation->get_templateArguments();
    }
    if (arguments != nullptr) {
      for (SgTemplateArgument *argument : *arguments) {
        ASSERT_not_null(argument);
        if (argument->get_argumentType() == SgTemplateArgument::type_argument) {
          append(argument->get_type());
          if (SgType *written = argument->get_sourceSpelledType())
            append(written);
        }
      }
    }
  }
  return internalTypes;
}

SgExpression *SgType::get_type_kind() const { return p_type_kind; }

void SgType::set_type_kind(SgExpression *type_kind) { p_type_kind = type_kind; }

bool SgType::isEquivalentType(const SgType *other_type) const {
  return SageInterface::isEquivalentType(this, other_type);
}

SOURCE_MAIN_TYPE_END

SOURCE_TYPE_DEFAULT_TYPE_START

SgName SgTypeDefault::get_mangled(void) const {
  return SgName("__MANGLED_ID_DEFAULT_TYPEb____MANGLED_ID_DEFAULT_TYPEe__");
}

SOURCE_TYPE_DEFAULT_TYPE_END

SOURCE_TYPE_TARGET_BUILTIN_TYPE_START

SgName SgTypeTargetBuiltin::get_mangled(void) const {
  if (p_spelling.is_null() || p_target_family < e_target_builtin_aarch64 ||
      p_target_family > e_target_builtin_hlsl) {
    fprintf(stderr,
            "REX_AST_INVARIANT[target-builtin-type]: type=%p has invalid "
            "spelling or target family=%d\n",
            static_cast<const void *>(this), static_cast<int>(p_target_family));
    ROSE_ABORT();
  }

  const std::string spelling = p_spelling.getString();
  SgName mangled_name;
  mangled_name << "__target_builtin_" << static_cast<int>(p_target_family)
               << "_" << spelling.size() << "_" << spelling;
  return mangled_name;
}

SgTypeTargetBuiltin *SgTypeTargetBuiltin::createType(
    const SgName &spelling, target_family_enum targetFamily) {
  if (spelling.is_null() || targetFamily < e_target_builtin_aarch64 ||
      targetFamily > e_target_builtin_hlsl) {
    fprintf(stderr,
            "REX_AST_INVARIANT[target-builtin-type]: cannot intern empty "
            "spelling or invalid target family=%d\n",
            static_cast<int>(targetFamily));
    ROSE_ABORT();
  }

  auto candidate = std::make_unique<SgTypeTargetBuiltin>();
  candidate->set_spelling(spelling);
  candidate->set_target_family(targetFamily);
  const SgName mangled = candidate->get_mangled();
  SgType *existing = get_globalTypeTable()->lookup_type(mangled);
  if (existing == nullptr) {
    get_globalTypeTable()->insert_type(mangled, candidate.get());
    return candidate.release();
  }

  SgTypeTargetBuiltin *result = isSgTypeTargetBuiltin(existing);
  if (result == nullptr || result->get_spelling() != spelling ||
      result->get_target_family() != targetFamily) {
    fprintf(stderr,
            "REX_AST_INVARIANT[target-builtin-type]: mangled identity "
            "collision for spelling=%s family=%d\n",
            spelling.getString().c_str(), static_cast<int>(targetFamily));
    ROSE_ABORT();
  }
  return result;
}

SOURCE_TYPE_TARGET_BUILTIN_TYPE_END

SOURCE_UNARY_TRANSFORM_TYPE_START

const char *SgUnaryTransformType::get_operator_name() const {
  static const char *const names[] = {
      "__add_lvalue_reference", "__add_pointer", "__add_rvalue_reference",
      "__decay", "__make_signed", "__make_unsigned", "__remove_all_extents",
      "__remove_const", "__remove_cv", "__remove_cvref", "__remove_extent",
      "__remove_pointer", "__remove_reference_t", "__remove_restrict",
      "__remove_volatile", "__underlying_type"};
  ROSE_ASSERT(p_operation >= e_add_lvalue_reference &&
              p_operation <= e_enum_underlying_type);
  return names[static_cast<unsigned>(p_operation)];
}

SgName SgUnaryTransformType::get_mangled() const {
  ROSE_ASSERT(p_operand_type != nullptr);
  const std::string operand = p_operand_type->get_mangled().getString();
  SgName result;
  result << get_operator_name() << "_" << operand.size() << "_" << operand;
  return result;
}

SgUnaryTransformType *SgUnaryTransformType::findCanonicalSemanticType(
    SgType *operand, operation_enum operation) {
  ROSE_ASSERT(operand != nullptr);
  ROSE_ASSERT(SgNode::isLiveNode(operand));
  ROSE_ASSERT(operation >= e_add_lvalue_reference &&
              operation <= e_enum_underlying_type);
  const auto &types = operand->p_unary_transform_types;
  for (SgUnaryTransformType *type : types) {
    ROSE_ASSERT(SgNode::isLiveNode(type));
    ROSE_ASSERT(type != nullptr && type->get_operand_type() == operand);
    if (type->get_operation() == operation)
      return type;
  }
  return nullptr;
}

SgUnaryTransformType *SgUnaryTransformType::createType(
    SgType *operand, operation_enum operation) {
  if (auto *existing = findCanonicalSemanticType(operand, operation))
    return existing;
  auto type = std::make_unique<SgUnaryTransformType>(operand, operation);
  operand->p_unary_transform_types.push_back(type.get());
  return type.release();
}

SOURCE_UNARY_TRANSFORM_TYPE_END

SOURCE_TYPE_LABEL_TYPE_START

SgName SgTypeLabel::get_mangled(void) const {

  SgName mangled_name;
  mangled_name << "__" << "MANGLED_ID_LABEL_TYPE" << "b__" // start tag
               << p_name.str() // name of default type
               << "__" << "MANGLED_ID_LABEL_TYPE" << "e__"; // end tag

  return mangled_name;
}

SgTypeLabel *SgTypeLabel::createType(const SgName &nameOfType) {
  auto candidate = std::make_unique<SgTypeLabel>();
  if (nameOfType.is_null() == false) {
    candidate->set_name(nameOfType);
  }
  ROSE_ASSERT(candidate != nullptr);
  SgName name = candidate->get_mangled();
  SgType *t = get_globalTypeTable()->lookup_type(name);
  if (t == NULL) {
    get_globalTypeTable()->insert_type(name, candidate.get());
    return candidate.release();
  }
  ROSE_ASSERT(t != candidate.get());
  auto *result = isSgTypeLabel(t);
  ROSE_ASSERT(result != nullptr);
  return result;
}

SOURCE_TYPE_LABEL_TYPE_END

SOURCE_POINTER_MEMBER_TYPE_START

SgDeclarationStatement *SgPointerMemberType::get_class_declaration_of() const {
  SgDeclarationStatement *result = NULL;

  if (get_class_type() != NULL) {
    SgType *type = get_class_type()->stripTypedefsAndModifiers();
    SgClassType *clsType = isSgClassType(type);

    if (clsType != NULL) {
      SgClassDeclaration *clsDecl =
          isSgClassDeclaration(clsType->get_declaration());
      result = clsDecl;
    } else {
      SgNonrealType *nonrealType = isSgNonrealType(type);
      ROSE_ASSERT(nonrealType != NULL);
      SgNonrealDecl *nonrealDecl =
          isSgNonrealDecl(nonrealType->get_declaration());
      ROSE_ASSERT(nonrealDecl != NULL);

      SgClassDeclaration *classDecl =
          isSgClassDeclaration(nonrealDecl->get_templateDeclaration());
      if (classDecl != NULL) {
        SgClassDeclaration *firstNondefining =
            isSgClassDeclaration(classDecl->get_firstNondefiningDeclaration());
        if (firstNondefining != NULL) {
          classDecl = firstNondefining;
        }

        result = classDecl;
      } else {
        result = nonrealDecl;
      }
    }

    ROSE_ASSERT(result != NULL);
  }

  ROSE_ASSERT(result != NULL);

  return result;
}

SOURCE_POINTER_MEMBER_TYPE_END

SOURCE_DECL_TYPE_START

bool SgDeclType::get_is_gnu_decltype() const { return p_is_gnu_decltype; }

void SgDeclType::post_construction_initialization() {
  if (p_base_expression == nullptr ||
      p_base_expression->get_parent() != nullptr ||
      SageInterface::containsUnknownType(p_base_type)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[decltype-construction]: requires a detached "
            "operand and exact semantic result type\n");
    ROSE_ABORT();
  }
  p_base_expression->set_parent(this);
}

SgType *SgDeclType::get_base_type() const {
  ROSE_ASSERT(p_base_expression != NULL);
  if (p_base_type == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[decltype-base-type]: SgDeclType=%p "
            "expression=%p/%s has no exact semantic base type\n",
            static_cast<const void *>(this),
            static_cast<void *>(p_base_expression),
            p_base_expression->class_name().c_str());
    ROSE_ABORT();
  }
  return p_base_type;
}

SgName SgDeclType::get_mangled(void) const {

  ROSE_ASSERT(p_base_expression != NULL);

  SgName mangled_name;
  mangled_name << "__bdecltype__" << mangleExpression(p_base_expression)
               << "__edecltype__";

  return mangled_name;
}

SOURCE_DECL_TYPE_END

SOURCE_TYPEOF_TYPE_START

void SgTypeOfType::post_construction_initialization() {
  if ((p_base_expression == nullptr) == (p_base_type == nullptr) ||
      (p_base_expression != nullptr &&
       (p_base_expression->get_parent() != nullptr ||
        SageInterface::containsUnknownType(p_base_expression->get_type()))) ||
      (p_base_type != nullptr &&
       SageInterface::containsUnknownType(p_base_type))) {
    fprintf(stderr,
            "REX_AST_INVARIANT[typeof-construction]: requires one exact "
            "typed operand with detached expression ownership\n");
    ROSE_ABORT();
  }
  if (p_base_expression != nullptr) {
    static std::atomic<uint64_t> next_occurrence_id{1};
    p_expression_occurrence_id =
        next_occurrence_id.fetch_add(1, std::memory_order_relaxed);
    if (p_expression_occurrence_id == 0) {
      fprintf(stderr,
              "REX_AST_INVARIANT[typeof-occurrence]: exhausted typed "
              "expression occurrence identities\n");
      ROSE_ABORT();
    }
    p_base_expression->set_parent(this);
  }
}

SgType *SgTypeOfType::get_base_type() const {
  SgType *type = p_base_expression != nullptr ? p_base_expression->get_type()
                                              : p_base_type;
  ROSE_ASSERT(type != nullptr);
  return type;
}

SgName SgTypeOfType::get_mangled(void) const {
  const SgType *base_type = get_base_type();
  ROSE_ASSERT(base_type != nullptr);
  SgName base_name = base_type->get_mangled();
  ROSE_ASSERT(!base_name.is_null());
  if (get_base_expression() != nullptr) {
    ROSE_ASSERT(get_base_expression()->get_parent() == this);
    ROSE_ASSERT(p_expression_occurrence_id != 0);
    base_name += "_base_expr_" + std::to_string(p_expression_occurrence_id);
  }
  SgName mangled_name;
  mangled_name << "__" << "MANGLED_ID_STRING" << "b__" << base_name.str()
               << "__"
               << "MANGLED_ID_STRING" << "e__";
  return mangled_name;
}
SOURCE_TYPEOF_TYPE_END

SOURCE_NAMED_TYPE_START
SgNamedType::SgNamedType(const SgNamedType &X) : SgType() {
  p_declaration = X.p_declaration;

  ROSE_ASSERT(p_declaration != NULL);
}

SgName SgNamedType::get_name() const {
  printf("Error: base class $CLASSNAME::get_name() called! \n");
  ROSE_ABORT();

  return SgName();
}

SgName SgNamedType::get_qualified_name() const {
  ROSE_ASSERT(get_declaration() != NULL);

  // The semantics of get_scope is that it can never be NULL (SgGlobal returns
  // itself as its scope!)
  SgScopeStatement *scope = get_declaration()->get_scope();
  ROSE_ASSERT(scope != NULL);

  SgName returnName =
      SgName::assembleQualifiedName(scope->get_qualified_name(), get_name());

  return returnName;
}

SOURCE_NAMED_TYPE_END

SOURCE_CLASS_TYPE_START
SgClassType::SgClassType(const SgClassType &X) : SgNamedType(X) {}

SgName SgClassType::get_name() const {
  SgClassDeclaration *declaration = isSgClassDeclaration(get_declaration());
  ROSE_ASSERT(declaration != nullptr);
  return declaration->get_name();
}

/*! Returns a mangled name (with embedded, mangled qualifiers).
 *  \note If the class is anonymous, e.g.,
 *    typedef struct { int a; char b; } tag_t;
 *  then this routine returns an empty name.
 */
SgName SgClassType::get_mangled(void) const {
  SgName mangled_name;
  if (get_name().is_null() == false) // not anonymous
  {
    const SgClassDeclaration *class_decl =
        isSgClassDeclaration(get_declaration());
    ROSE_ASSERT(class_decl != NULL && class_decl->get_scope() != NULL);

    const SgTemplateInstantiationDecl *template_class_inst =
        isSgTemplateInstantiationDecl(class_decl);
    const SgTemplateClassDeclaration *template_class_decl =
        isSgTemplateClassDeclaration(class_decl);
    if (template_class_inst != NULL) {
      mangled_name = template_class_inst->get_mangled_name();
    } else if (template_class_decl != NULL) {
      mangled_name = template_class_decl->get_mangled_name();
    } else {
      mangled_name = class_decl->get_mangled_name();
    }
  }

  return mangled_name;
}

SOURCE_CLASS_TYPE_END

SOURCE_NONREAL_TYPE_START

SgNonrealType::SgNonrealType(const SgNonrealType &X)
    : SgNamedType(X), p_aliased_type(X.p_aliased_type) {
  post_construction_initialization();
}

void SgNonrealType::post_construction_initialization() {
  validate_aliased_type();
  ROSE_ASSERT(p_owned_aliased_types.empty());
  if (p_aliased_type == nullptr)
    return;
  SgTypePtrList pending{p_aliased_type};
  std::set<SgType *> visited;
  auto append = [&](SgType *type) {
    ASSERT_not_null(type);
    pending.push_back(type);
  };
  while (!pending.empty()) {
    SgType *type = pending.back();
    pending.pop_back();
    if (!visited.insert(type).second || isSgNamedType(type) != nullptr)
      continue;
    auto *member = isSgPointerMemberType(type);
    if (isSgDeclType(type) != nullptr || isSgTypeOfType(type) != nullptr ||
        type->has_source_prototype() ||
        (member != nullptr &&
         !SgPointerMemberType::isCanonicalSemanticType(member))) {
      if (type->get_parent() == nullptr) {
        type->set_parent(this);
        p_owned_aliased_types.push_back(type);
      }
      // A private occurrence borrows its semantic result type.
      continue;
    }
    if (auto *modifier = isSgModifierType(type)) {
      append(modifier->get_base_type());
    } else if (member != nullptr) {
      append(member->get_base_type());
      append(member->get_class_type());
    } else if (auto *pointer = isSgPointerType(type)) {
      append(pointer->get_base_type());
    } else if (auto *reference = isSgReferenceType(type)) {
      append(reference->get_base_type());
    } else if (auto *reference = isSgRvalueReferenceType(type)) {
      append(reference->get_base_type());
    } else if (auto *array = isSgArrayType(type)) {
      append(array->get_base_type());
    } else if (auto *function = isSgFunctionType(type)) {
      append(function->get_return_type());
      if (auto *semantic = function->get_semantic_signature())
        append(semantic);
      for (SgType *argument : function->get_arguments())
        append(argument);
      for (SgType *exception : function->get_exception_specification_types())
        append(exception);
      if (auto *member = isSgMemberFunctionType(function))
        if (SgType *class_type = member->get_class_type())
          append(class_type);
    } else if (auto *transform = isSgUnaryTransformType(type)) {
      append(transform->get_operand_type());
    } else if (auto *complex = isSgTypeComplex(type)) {
      append(complex->get_base_type());
    } else if (auto *imaginary = isSgTypeImaginary(type)) {
      append(imaginary->get_base_type());
    }
  }
  validate_aliased_type();
}

void SgNonrealType::validate_aliased_type() const {
  const auto *declaration = isSgNonrealDecl(get_declaration());
  ASSERT_not_null(declaration);
  auto *target = declaration->get_templateDeclaration();
  std::set<const SgDeclarationStatement *> using_declarations;
  while (const auto *using_declaration =
             isSgUsingDeclarationStatement(target)) {
    ROSE_ASSERT(using_declarations.insert(using_declaration).second);
    target = using_declaration->get_declaration();
    ASSERT_not_null(target);
  }
  const bool alias_use = declaration->get_nonreal_template_role() ==
                             SgNonrealDecl::e_nonreal_template_id &&
                         isSgTemplateTypedefDeclaration(target) != nullptr;
  if (alias_use != (p_aliased_type != nullptr)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[nonreal-alias-type]: type=%p declaration=%p "
            "alias-use=%d aliased-type=%p\n",
            static_cast<const void *>(this),
            static_cast<const void *>(declaration), alias_use ? 1 : 0,
            static_cast<void *>(p_aliased_type));
    ROSE_ABORT();
  }
  if (p_aliased_type == nullptr) {
    ROSE_ASSERT(p_owned_aliased_types.empty());
    return;
  }
  std::set<const SgType *> owned_types;
  for (SgType *owned : p_owned_aliased_types) {
    ROSE_ASSERT(owned != nullptr && SgNode::isLiveNode(owned));
    ROSE_ASSERT(owned->get_parent() == this);
    ROSE_ASSERT(owned_types.insert(owned).second);
    auto *member = isSgPointerMemberType(owned);
    ROSE_ASSERT(isSgDeclType(owned) != nullptr ||
                isSgTypeOfType(owned) != nullptr ||
                owned->has_source_prototype() ||
                (member != nullptr &&
                 !SgPointerMemberType::isCanonicalSemanticType(member)));
  }
  const auto internal_types = p_aliased_type->getInternalTypes();
  for (SgType *owned : p_owned_aliased_types)
    ROSE_ASSERT(std::find(internal_types.begin(), internal_types.end(),
                          owned) != internal_types.end());
  if (std::find(internal_types.begin(), internal_types.end(), this) !=
      internal_types.end()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[nonreal-alias-type]: type=%p occurs in its "
            "alias projection\n",
            static_cast<const void *>(this));
    ROSE_ABORT();
  }
  std::set<const SgType *> visited;
  const SgType *type = this;
  while (type != nullptr) {
    if (!visited.insert(type).second) {
      fprintf(stderr,
              "REX_AST_INVARIANT[nonreal-alias-type]: type=%p has a cyclic "
              "alias projection\n",
              static_cast<const void *>(this));
      ROSE_ABORT();
    }
    if (const auto *nonreal = isSgNonrealType(type))
      type = nonreal->p_aliased_type;
    else if (const auto *alias = isSgTypedefType(type))
      type = alias->get_base_type();
    else
      break;
  }
}

SgType *SgNonrealType::get_aliased_type() const { return p_aliased_type; }

SgName SgNonrealType::get_mangled(void) const {
  SgNonrealDecl *nrdecl = isSgNonrealDecl(get_declaration());
  ROSE_ASSERT(nrdecl != NULL);
  return nrdecl->get_mangled_name();
}

SgName SgNonrealType::get_name() const {
  SgDeclarationStatement *decl_stmt = get_declaration();
  ROSE_ASSERT(decl_stmt != NULL);
  SgNonrealDecl *nonreal_decl = isSgNonrealDecl(decl_stmt);
  ROSE_ASSERT(nonreal_decl != NULL);
  return nonreal_decl->get_name();
}

SOURCE_NONREAL_TYPE_END

SOURCE_AUTO_TYPE_START

void SgAutoType::post_construction_initialization() {
  ROSE_ASSERT(p_is_constrained == (p_type_constraint != nullptr));
  if (p_type_constraint != nullptr) {
    ROSE_ASSERT(p_type_constraint->get_parent() == nullptr);
    ROSE_ASSERT(p_type_constraint->get_symbol() != nullptr);
    ROSE_ASSERT(p_type_constraint->get_symbol()->get_declaration() != nullptr);
    ROSE_ASSERT(
        p_type_constraint->get_symbol()->get_declaration()->get_is_concept());
    p_type_constraint->set_parent(this);
  }
}

SgName SgAutoType::get_mangled(void) const {
  std::ostringstream oss;
  oss << "auto_" << std::hex << this;
  return SgName(oss.str());
}

SOURCE_AUTO_TYPE_END

SOURCE_TEMPLATE_TYPE_START

const std::optional<SgTemplateType::canonical_source_identity> &
SgTemplateType::get_canonical_source_identity() const {
  return p_canonical_source_identity;
}

void SgTemplateType::initialize_canonical_source_identity(
    const canonical_source_identity &identity) {
  if (identity.expansion_file_id < 0 || identity.spelling_file_id < 0) {
    fprintf(stderr,
            "REX_AST_INVARIANT[template-type-source-identity]: type=%p "
            "requires nonnegative expansion and spelling file identities\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  if (p_canonical_source_identity.has_value()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[template-type-source-identity]: type=%p cannot "
            "initialize its canonical source identity more than once\n",
            static_cast<void *>(this));
    ROSE_ABORT();
  }
  p_canonical_source_identity = identity;
}

SgName SgTemplateType::get_mangled(void) const {
  std::string mangled_name;
  const int depth = get_template_parameter_depth();
  const int position = get_template_parameter_position();
  if ((depth < 0) != (position < 0)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[template-type-mangled-identity]: type=%p "
            "name=%s has partial template coordinate depth=%d position=%d\n",
            static_cast<const void *>(this), get_name().str(), depth, position);
    ROSE_ABORT();
  }
  if (depth >= 0) {
    const std::optional<canonical_source_identity> source_identity =
        get_canonical_source_identity();
    if (!source_identity.has_value()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[template-type-mangled-identity]: type=%p "
              "name=%s depth=%d position=%d "
              "has no exact canonical template-parameter source identity\n",
              static_cast<const void *>(this), get_name().str(), depth,
              position);
      ROSE_ABORT();
    }

    // Coordinates alone collapse parameters belonging to unrelated templates.
    // Use the canonical source identity across redeclarations and checkpoints.
    mangled_name =
        "__template_parameter_source_" +
        Rose::StringUtility::numberToString(
            source_identity->expansion_file_id) +
        "_" +
        Rose::StringUtility::numberToString(
            source_identity->expansion_file_offset) +
        "_" +
        Rose::StringUtility::numberToString(source_identity->spelling_file_id) +
        "_" +
        Rose::StringUtility::numberToString(
            source_identity->spelling_file_offset) +
        "_" + Rose::StringUtility::numberToString(depth) + "_" +
        Rose::StringUtility::numberToString(position) + "__";
  } else {
    if (get_name().is_null()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[template-type-mangled-identity]: type=%p has "
              "neither a template coordinate nor a dependent type name\n",
              static_cast<const void *>(this));
      ROSE_ABORT();
    }
    mangled_name = "__dependent_template_type_" +
                   replaceNonAlphaNum(get_name().getString()) + "__";
  }
  if (get_packed())
    mangled_name += "__pack_expansion__";
  ROSE_ASSERT(get_is_pack_substitution() || get_tpl_args().empty());
  if (get_is_pack_substitution()) {
    ROSE_ASSERT(!get_packed() && depth >= 0);
    mangled_name += "__substitution__" +
                    mangleTemplateArgsToString(get_tpl_args().begin(),
                                               get_tpl_args().end()) +
                    "__end_substitution__";
  }
  return SgName(mangled_name);
}

SOURCE_TEMPLATE_TYPE_END

SOURCE_ENUM_TYPE_START

SgEnumType::SgEnumType(const SgEnumType &X) : SgNamedType(X) {}

SgName SgEnumType::get_name() const {
  SgDeclarationStatement *type_declaration = get_declaration();
  ROSE_ASSERT(SgNode::isLiveNode(type_declaration));
  SgEnumDeclaration *declaration = isSgEnumDeclaration(type_declaration);
  ROSE_ASSERT(declaration != nullptr);
  return declaration->get_name();
}

SgName SgEnumType::get_mangled(void) const {
  SgDeclarationStatement *declaration = get_declaration();
  ROSE_ASSERT(SgNode::isLiveNode(declaration));
  const SgEnumDeclaration *decl = isSgEnumDeclaration(declaration);
  ROSE_ASSERT(decl != NULL);
  SgScopeStatement *scope = decl->get_scope();
  ROSE_ASSERT(scope == NULL || SgNode::isLiveNode(scope));

  return decl->get_mangled_name();
}

SOURCE_ENUM_TYPE_END

SOURCE_TYPEDEF_TYPE_START

SgTypedefType::SgTypedefType(const SgTypedefType &X) : SgNamedType(X) {
  ROSE_ASSERT(X.get_declaration() != nullptr);
}

SgName SgTypedefType::get_name() const {
  SgTypedefDeclaration *declaration =
      isSgTypedefDeclaration(get_declaration());
  if (declaration == nullptr) {
    fprintf(stderr, "REX_AST_INVARIANT[typedef-type-declaration]: typedef type "
                    "has no exact typedef declaration\n");
    ROSE_ABORT();
  }
  return declaration->get_name();
}

SgType *SgTypedefType::get_base_type() const {
  SgTypedefDeclaration *declaration = isSgTypedefDeclaration(get_declaration());
  ROSE_ASSERT(declaration != nullptr);
  SgType *base = declaration->get_base_type();
  ROSE_ASSERT(base != nullptr);
  if (auto *decltype_type = isSgDeclType(base))
    return decltype_type->get_base_type();
  if (auto *typeof_type = isSgTypeOfType(base))
    return typeof_type->get_base_type();
  return base;
}

SgName SgTypedefType::get_mangled(void) const {

  const SgTypedefDeclaration *decl = isSgTypedefDeclaration(get_declaration());
  ROSE_ASSERT(decl != NULL);

  return decl->get_mangled_name();
}

SOURCE_TYPEDEF_TYPE_END

SOURCE_MODIFIER_TYPE_START

SgTypeModifier &SgModifierType::get_typeModifier() {
  return p_typeModifier;
}

const SgTypeModifier &SgModifierType::get_typeModifier(void) const {
  return p_typeModifier;
}

SgName SgModifierType::get_mangled(void) const {

  SgName mangled_name;

  const SgTypeModifier &type_mod = get_typeModifier();
  const SgConstVolatileModifier &cv_mod = type_mod.get_constVolatileModifier();

  if (cv_mod.isConst())
    mangled_name << "C";
  if (cv_mod.isVolatile())
    mangled_name << "V";
  if (type_mod.isAtomic())
    mangled_name << "ATOMIC";

  if (type_mod.isRestrict())
    mangled_name << "RST";
  if (type_mod.isVectorType()) {
    ROSE_ASSERT(type_mod.get_vector_size() != 0);
    mangled_name << (type_mod.isExtendedVectorType() ? "EXTVECTOR" : "VECTOR");
    mangled_name << std::to_string(type_mod.get_vector_size()) << "_";
  }
  if (type_mod.haveAddressSpace())
    mangled_name << "ADDRESS_SPACE_" << type_mod.get_address_space_value()
                 << "_";
  if (type_mod.isOpenclGlobal())
    mangled_name << "OPENCL_GLOBAL_";
  if (type_mod.isOpenclLocal())
    mangled_name << "OPENCL_LOCAL_";
  if (type_mod.isOpenclConstant())
    mangled_name << "OPENCL_CONSTANT_";

  mangled_name << get_base_type()->get_mangled().str();

  return mangled_name;
}

void SgModifierType::post_construction_initialization() {
  ROSE_ASSERT(p_base_type != NULL);
  ROSE_ASSERT(p_base_type != this);
  SgType::post_construction_initialization();
}

SOURCE_MODIFIER_TYPE_END

SOURCE_FUNCTION_TYPE_START

void SgFunctionType::validate_exception_specification(
    exception_specification_kind_enum kind, SgExpression *expression,
    const SgTypePtrList &types, const std::vector<bool> &pack_expansions,
    SgFunctionDeclaration *source, SgFunctionDeclaration *pattern,
    bool source_is_self, bool is_written) {
  bool computed = false;
  bool delayed = false;
  switch (kind) {
  case e_exception_none:
  case e_exception_dynamic_none:
  case e_exception_dynamic:
  case e_exception_ms_any:
  case e_exception_nothrow:
  case e_exception_noexcept:
    break;
  case e_exception_noexcept_dependent:
  case e_exception_noexcept_false:
  case e_exception_noexcept_true:
    computed = true;
    break;
  case e_exception_unevaluated:
  case e_exception_uninstantiated:
    delayed = true;
    break;
  default:
    ROSE_ABORT();
  }
  ROSE_ASSERT(computed == (expression != nullptr));
  ROSE_ASSERT(delayed == (source != nullptr || source_is_self));
  ROSE_ASSERT(!source_is_self || source == nullptr);
  ROSE_ASSERT(!is_written || kind != e_exception_none);
  ROSE_ASSERT((kind == e_exception_uninstantiated) == (pattern != nullptr));
  ROSE_ASSERT((kind == e_exception_dynamic) == !types.empty());
  ROSE_ASSERT(types.size() == pack_expansions.size());
  if (expression != nullptr)
    ROSE_ASSERT(!SageInterface::containsUnknownType(expression->get_type()));
  for (SgType *type : types) {
    ROSE_ASSERT(type != nullptr);
    ROSE_ASSERT(!SageInterface::containsUnknownType(type));
    ROSE_ASSERT(isSgTypeEllipse(type) == nullptr);
  }
}

SgFunctionDeclaration *
SgFunctionType::get_exception_specification_source() const {
  if (!p_exception_specification_source_is_self)
    return p_exception_specification_source;
  auto *owner = isSgFunctionDeclaration(get_parent());
  ASSERT_not_null(owner);
  ROSE_ASSERT(owner->get_declared_exception_signature() == this ||
              owner->get_type_syntax() == this);
  return owner;
}

void SgFunctionType::post_construction_initialization() {
  ROSE_ASSERT(p_return_type != NULL);
  ROSE_ASSERT(p_argument_list != NULL);
  ROSE_ASSERT(p_argument_list->get_parent() == NULL);
  ROSE_ASSERT(!SageInterface::containsUnknownType(p_return_type));
  validate_exception_specification(
      p_exception_specification_kind, p_exception_specification_expression,
      p_exception_specification_types,
      p_exception_specification_type_pack_expansions,
      p_exception_specification_source, p_exception_specification_pattern,
      p_exception_specification_source_is_self,
      p_exception_specification_is_written);
  ROSE_ASSERT(!p_exception_specification_is_written ||
              p_semantic_signature != nullptr);
  ROSE_ASSERT(!p_exception_specification_source_is_self ||
              p_semantic_signature != nullptr);
  if (p_semantic_signature != nullptr) {
    ROSE_ASSERT(p_semantic_signature != this);
    ROSE_ASSERT(p_semantic_signature->get_semantic_signature() == nullptr);
    ROSE_ASSERT(!p_semantic_signature->has_source_prototype());
    ROSE_ASSERT(!p_semantic_signature->get_fortran_source_syntax());
    ROSE_ASSERT(!p_semantic_signature->get_source_trailing_return());
    ROSE_ASSERT(
        !p_semantic_signature->get_exception_specification_is_written());
    ROSE_ASSERT(
        !p_semantic_signature->get_exception_specification_source_is_self());
    ROSE_ASSERT(p_semantic_signature->get_has_ellipses() == p_has_ellipses);
    ROSE_ASSERT(p_semantic_signature->get_has_prototype() == p_has_prototype);
    ROSE_ASSERT(p_semantic_signature->get_arguments().size() ==
                p_argument_list->get_arguments().size());
    auto *table = SgNode::get_globalFunctionTypeTable();
    ASSERT_not_null(table);
    ROSE_ASSERT(table->lookup_exact_function_type(p_semantic_signature) ==
                p_semantic_signature);
  }
  if (p_exception_specification_expression != nullptr) {
    ROSE_ASSERT(p_exception_specification_expression->get_parent() == nullptr);
    p_exception_specification_expression->set_parent(this);
  }
  for (SgType *type : p_exception_specification_types) {
    if (type->has_source_prototype()) {
      ROSE_ASSERT(type->get_parent() == nullptr);
      type->set_parent(this);
    }
  }
  p_argument_list->validate_argument_qualification_use_sites(
      "function-type-construction");
  p_argument_list->validate_source_prototype();
  bool has_ellipses = false;
  for (SgType *argument : p_argument_list->get_arguments()) {
    ROSE_ASSERT(!SageInterface::containsUnknownType(argument));
    ROSE_ASSERT(!has_ellipses);
    has_ellipses = isSgTypeEllipse(argument) != NULL;
  }
  ROSE_ASSERT(p_has_ellipses == has_ellipses);
  ROSE_ASSERT(p_has_prototype ||
              (p_argument_list->get_arguments().empty() &&
               p_exception_specification_kind == e_exception_none));
  if (p_return_type->has_source_prototype() ||
      (p_argument_list->get_source_parameters() != nullptr &&
       (isSgDeclType(p_return_type) || isSgTypeOfType(p_return_type)))) {
    ROSE_ASSERT(p_return_type->get_parent() == nullptr);
    p_return_type->set_parent(this);
  }
  p_argument_list->set_parent(this);
}

const SgTypePtrList &SgFunctionType::get_arguments() const {
  return p_argument_list->get_arguments();
}

SgName SgFunctionType::get_mangled(SgType *ret_type,
                                   SgFunctionParameterTypeList *typeList) {
  ROSE_ASSERT(ret_type != NULL);
  ROSE_ASSERT(typeList != NULL);

  const SgTypePtrList &args = typeList->get_arguments();
  SgName arg_names = mangleTypes(args.begin(), args.end());
  SgName ret_name = ret_type->get_mangled();

  // Build complete mangled name
  SgName mangled_name;
  mangled_name << "_Fb_"          // begin function signature
               << ret_name.str()  // return type
               << "_Gb_"          // argument list begin
               << arg_names.str() // argument types
               << "_Fe_";         // end function signature

  return mangled_name;
}

SgName SgFunctionType::get_mangled(void) const {
  SgName name = get_mangled(get_return_type(), get_argument_list());
  if (!p_has_prototype)
    name << "_no_prototype_";
  name << get_mangled_exception_specification().str();
  return name;
}

SgName SgFunctionType::get_mangled_exception_specification() const {
  SgName name;
  if (p_exception_specification_kind == e_exception_none)
    return name;
  name << "_Xb_" << std::to_string(p_exception_specification_kind);
  if (p_exception_specification_expression != nullptr)
    name << "_expression_"
         << mangleExpression(p_exception_specification_expression);
  for (size_t index = 0; index < p_exception_specification_types.size();
       ++index) {
    name << "_type_"
         << p_exception_specification_types[index]->get_mangled().str()
         << "_pack_"
         << (p_exception_specification_type_pack_expansions[index] ? "1" : "0");
  }
  if (SgFunctionDeclaration *source = get_exception_specification_source())
    name << "_source_" << source->get_mangled_name().str();
  if (p_exception_specification_pattern != nullptr)
    name << "_pattern_"
         << p_exception_specification_pattern->get_mangled_name().str();
  name << "_Xe_";
  return name;
}

SOURCE_FUNCTION_TYPE_END

SOURCE_MEMBER_FUNCTION_TYPE_START

SgMemberFunctionType::SgMemberFunctionType(
    SgType *returnType, bool ellipses, SgFunctionParameterTypeList *arguments,
    SgType *classType, unsigned int specifier)
    : SgMemberFunctionType(returnType, ellipses, arguments, e_exception_none,
                           nullptr, {}, {}, nullptr, nullptr, false, false,
                           nullptr, true, classType, specifier) {}

unsigned int SgMemberFunctionType::get_mfunc_specifier() const {
  return p_mfunc_specifier;
}

void SgMemberFunctionType::post_construction_initialization() {
  ROSE_ASSERT(p_has_prototype);
  if (p_semantic_signature != nullptr) {
    auto *semantic = isSgMemberFunctionType(p_semantic_signature);
    ASSERT_not_null(semantic);
    ROSE_ASSERT(semantic->get_class_type() == p_class_type);
    ROSE_ASSERT(semantic->get_mfunc_specifier() == p_mfunc_specifier);
  }
  ROSE_ASSERT(p_class_type == NULL ||
              !SageInterface::containsUnknownType(p_class_type));
  constexpr unsigned int allowed = e_const | e_volatile | e_restrict |
                                   e_ref_qualifier_lvalue |
                                   e_ref_qualifier_rvalue;
  ROSE_ASSERT((p_mfunc_specifier & ~allowed) == 0);
  ROSE_ASSERT(
      (p_mfunc_specifier & (e_ref_qualifier_lvalue | e_ref_qualifier_rvalue)) !=
      (e_ref_qualifier_lvalue | e_ref_qualifier_rvalue));
}

bool SgMemberFunctionType::isConstFunc() const {
  return (p_mfunc_specifier & e_const);
}

void SgMemberFunctionType::setConstFunc() { p_mfunc_specifier |= e_const; }

void SgMemberFunctionType::unsetConstFunc() { p_mfunc_specifier &= ~e_const; }

bool SgMemberFunctionType::isVolatileFunc() const {
  return (p_mfunc_specifier & e_volatile);
}

void SgMemberFunctionType::setVolatileFunc() {
  p_mfunc_specifier |= e_volatile;
}

void SgMemberFunctionType::unsetVolatileFunc() {
  p_mfunc_specifier &= ~e_volatile;
}

bool SgMemberFunctionType::isRestrictFunc() const {
  return (p_mfunc_specifier & e_restrict);
}

void SgMemberFunctionType::setRestrictFunc() {
  p_mfunc_specifier |= e_restrict;
}

void SgMemberFunctionType::unsetRestrictFunc() {
  p_mfunc_specifier &= ~e_restrict;
}

bool SgMemberFunctionType::isLvalueReferenceFunc() const {
  return (p_mfunc_specifier & e_ref_qualifier_lvalue);
}

void SgMemberFunctionType::setLvalueReferenceFunc() {
  ROSE_ASSERT((p_mfunc_specifier & e_ref_qualifier_rvalue) == 0);
  p_mfunc_specifier |= e_ref_qualifier_lvalue;
}

void SgMemberFunctionType::unsetLvalueReferenceFunc() {
  p_mfunc_specifier &= ~e_ref_qualifier_lvalue;
}

bool SgMemberFunctionType::isRvalueReferenceFunc() const {
  return (p_mfunc_specifier & e_ref_qualifier_rvalue);
}

void SgMemberFunctionType::setRvalueReferenceFunc() {
  ROSE_ASSERT((p_mfunc_specifier & e_ref_qualifier_lvalue) == 0);
  p_mfunc_specifier |= e_ref_qualifier_rvalue;
}

void SgMemberFunctionType::unsetRvalueReferenceFunc() {
  p_mfunc_specifier &= ~e_ref_qualifier_rvalue;
}

SgName SgMemberFunctionType::get_mangled_name(void) const {
  return get_mangled();
}

SgName SgMemberFunctionType::get_mangled(SgType *ret_type,
                                         SgFunctionParameterTypeList *typeList,
                                         SgType *classType,
                                         unsigned int mfunc_specifier) {
  SgName mangled_cls_tag;

  const SgType *cls_type = classType;
  if (cls_type != NULL) {
    SgName class_scope = cls_type->get_mangled();
    mangled_cls_tag += class_scope;
  }

  SgName mangled_name;

  if (mfunc_specifier & SgMemberFunctionType::e_const) {
    mangled_cls_tag << "_cf";
  }

  if (mfunc_specifier & SgMemberFunctionType::e_volatile) {
    mangled_cls_tag << "_vf";
  }

  if (mfunc_specifier & SgMemberFunctionType::e_restrict) {
    mangled_cls_tag << "_rf";
  }

  if ((mfunc_specifier & SgMemberFunctionType::e_ref_qualifier_lvalue) &&
      (mfunc_specifier & SgMemberFunctionType::e_ref_qualifier_rvalue)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[member-function-type-ref-qualifier]: "
            "static mangling received both lvalue and rvalue qualifiers\n");
    ROSE_ABORT();
  }
  if (mfunc_specifier & SgMemberFunctionType::e_ref_qualifier_lvalue) {
    mangled_cls_tag << "_lvf";
  }

  if (mfunc_specifier & SgMemberFunctionType::e_ref_qualifier_rvalue) {
    mangled_cls_tag << "_rvf";
  }

  // Mangle the function type without qualifiers
  SgName basic_func_type = SgFunctionType::get_mangled(ret_type, typeList);

  // Compute mangled member function pointer type
  if (mangled_cls_tag.get_length() > 0)
    mangled_name << "__MFb_"
                 << mangled_cls_tag.str(); // really is a member function

  mangled_name << "_"
               << basic_func_type.str(); // Append standard argument signature.

  return mangled_name;
}

SgName SgMemberFunctionType::get_mangled(void) const {
  SgName name = get_mangled(get_return_type(), get_argument_list(),
                            get_class_type(), get_mfunc_specifier());
  name << get_mangled_exception_specification().str();
  return name;
}

SOURCE_MEMBER_FUNCTION_TYPE_END

SOURCE_ARRAY_TYPE_START

SgName SgArrayType::get_mangled(void) const {
  const SgType *base_type = get_base_type();
  if (base_type == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[array-type-mangle]: array type has no "
                    "base type\n");
    ROSE_ABORT();
  }

  const SgName base_name = base_type->get_mangled();
  if (base_name.is_null()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[array-type-mangle]: base type %s has no "
            "mangled name\n",
            base_type->class_name().c_str());
    ROSE_ABORT();
  }

  const SgExpression *index_exp = get_index();
  const SgExprListExp *dimensions = get_dim_info();
  const std::string bound_kind =
      get_is_variable_length_array() ? "vla" : "fixed";
  std::string shape_name;
  if (dimensions != NULL) {
    const SgExpressionPtrList &shape = dimensions->get_expressions();
    if (index_exp != NULL || dimensions->get_parent() != this ||
        get_rank() <= 0 || shape.size() != static_cast<size_t>(get_rank())) {
      fprintf(stderr,
              "REX_AST_INVARIANT[array-type-mangle]: array=%p has crossed or "
              "malformed index/dimension ownership (index=%p dimensions=%p "
              "parent=%p rank=%d size=%zu)\n",
              static_cast<const void *>(this),
              static_cast<const void *>(index_exp),
              static_cast<const void *>(dimensions),
              static_cast<const void *>(dimensions->get_parent()), get_rank(),
              shape.size());
      ROSE_ABORT();
    }
    const std::string dimensions_name = mangleExpression(dimensions);
    if (dimensions_name.empty()) {
      fprintf(stderr,
              "REX_AST_INVARIANT[array-type-mangle]: structural dimension "
              "mangling produced an empty name\n");
      ROSE_ABORT();
    }
    shape_name = bound_kind + "_rank_" + std::to_string(get_rank()) +
                 "_dimensions_" + dimensions_name;
  } else {
    if (get_rank() != 0) {
      fprintf(stderr,
              "REX_AST_INVARIANT[array-type-mangle]: array=%p has rank=%d "
              "without an exact dimension-list owner\n",
              static_cast<const void *>(this), get_rank());
      ROSE_ABORT();
    }
    shape_name = index_exp == NULL
                     ? bound_kind + "_unsized"
                     : bound_kind + "_index_" + mangleExpression(index_exp);
  }
  if (shape_name.empty()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[array-type-mangle]: structural shape mangling "
            "produced an empty name\n");
    ROSE_ABORT();
  }

  SgName mangled_name;
  mangled_name << "_Ab_" << base_name.str() << "_shape_" << shape_name
               << (get_isCoArray() ? "_coarray_" : "_ordinary_array_")
               << "_Ae_";
  return mangled_name;
}

SOURCE_ARRAY_TYPE_END

SOURCE_COMMON_CREATE_TYPE_START

$CLASSNAME *$CLASSNAME::createType(SgExpression *optional_fortran_type_kind) {
  return createPrimitiveType<$CLASSNAME>(optional_fortran_type_kind);
}

SOURCE_COMMON_CREATE_TYPE_END

SOURCE_CREATE_TYPE_FOR_TYPEDEF_TYPE_START
SgTypedefType *
SgTypedefType::createType(SgTypedefDeclaration *decl,
                          SgExpression *optional_fortran_type_kind) {
  ASSERT_not_null(decl);
  ROSE_ASSERT(optional_fortran_type_kind == nullptr);
  ASSERT_not_null(decl->get_base_type());
  ASSERT_not_null(decl->get_scope());
  if (SgTypedefType *type = decl->get_type()) {
    ASSERT_require(type->get_declaration() == decl);
    return type;
  }

  // The declaration is the canonical identity. Searching a reverse list on
  // its base type or a mangled-name scope index duplicates that identity and
  // retains types after their declarations are retired.
  auto *type = new SgTypedefType(decl);
  decl->set_type(type);
  return type;
}

SOURCE_CREATE_TYPE_FOR_TYPEDEF_TYPE_END


SOURCE_CREATE_TYPE_FOR_POINTER_MEMBER_TYPE_START
namespace {

using PointerMemberSemanticKey = std::pair<SgType *, SgType *>;

void requireExactPointerMemberSemanticIdentity(
    const SgPointerMemberType *type, const PointerMemberSemanticKey &key,
    const char *context) {
  if (type == nullptr || type->get_base_type() != key.first ||
      type->get_class_type() != key.second ||
      type->get_source_class_type_is_unqualified_injected_name() ||
      type->get_source_base_type_qualification_present() ||
      type->get_source_base_type_global_qualification() ||
      !type->get_source_base_type_qualification_tokens().empty()) {
    fprintf(stderr,
            "REX_AST_INVARIANT[pointer-member-semantic-identity]: "
            "context=%s type=%p does not represent exactly base=%p "
            "class=%p without source-only spelling or qualification\n",
            context, static_cast<const void *>(type),
            static_cast<void *>(key.first), static_cast<void *>(key.second));
    ROSE_ABORT();
  }
}

} // namespace

std::map<PointerMemberSemanticKey, SgPointerMemberType *> &
$CLASSNAME::canonicalSemanticTypeCache() {
  static std::map<PointerMemberSemanticKey, SgPointerMemberType *> cache;
  return cache;
}

$CLASSNAME *$CLASSNAME::findCanonicalSemanticType(SgType *base_type,
                                                  SgType *class_type) {
  ROSE_ASSERT(base_type != nullptr && class_type != nullptr);
  const PointerMemberSemanticKey key(base_type, class_type);
  const auto &cache = canonicalSemanticTypeCache();
  const auto found = cache.find(key);
  if (found == cache.end())
    return nullptr;
  ROSE_ASSERT(SgNode::isLiveNode(found->second));
  requireExactPointerMemberSemanticIdentity(found->second, key, "cache-query");
  return found->second;
}

$CLASSNAME *$CLASSNAME::createType(SgType *base_type, SgType *class_type,
                                   SgExpression *optional_fortran_type_kind) {
  if (base_type == NULL || class_type == NULL ||
      optional_fortran_type_kind != NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[pointer-member-semantic-identity]: "
                    "semantic pointer-member construction requires exact "
                    "base/class types and no Fortran kind\n");
    ROSE_ABORT();
  }

  const PointerMemberSemanticKey key(base_type, class_type);
  ROSE_ASSERT(!base_type->has_source_prototype());
  auto &cache = canonicalSemanticTypeCache();
  if (auto *type = findCanonicalSemanticType(base_type, class_type))
    return type;

  auto candidate = std::make_unique<$CLASSNAME>(base_type, class_type);
  requireExactPointerMemberSemanticIdentity(candidate.get(), key, "new-type");
  const auto inserted = cache.emplace(key, candidate.get());
  if (!inserted.second || inserted.first->second != candidate.get()) {
    fprintf(stderr, "REX_AST_INVARIANT[pointer-member-semantic-identity]: "
                    "exact semantic pair was published concurrently or with "
                    "a conflicting identity\n");
    ROSE_ABORT();
  }
  return candidate.release();
}

bool $CLASSNAME::isCanonicalSemanticType(const SgPointerMemberType *type) {
  if (type == NULL) {
    return false;
  }
  if (type->get_base_type() == NULL || type->get_class_type() == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[pointer-member-semantic-identity]: "
                    "queried pointer-member type has no exact base/class "
                    "identity\n");
    ROSE_ABORT();
  }

  return findCanonicalSemanticType(type->get_base_type(),
                                   type->get_class_type()) == type;
}

std::vector<SgPointerMemberType *> $CLASSNAME::canonicalSemanticTypes() {
  std::vector<SgPointerMemberType *> types;
  auto &cache = canonicalSemanticTypeCache();
  types.reserve(cache.size());
  for (const auto &entry : cache) {
    if (!SgNode::isLiveNode(entry.second)) {
      fprintf(stderr, "REX_AST_INVARIANT[pointer-member-semantic-identity]: "
                      "cache contains a deleted type\n");
      ROSE_ABORT();
    }
    requireExactPointerMemberSemanticIdentity(entry.second, entry.first,
                                              "cache-snapshot");
    types.push_back(entry.second);
  }
  return types;
}

void $CLASSNAME::forgetCanonicalSemanticType(SgPointerMemberType *type) {
  const PointerMemberSemanticKey key(type->get_base_type(),
                                     type->get_class_type());
  auto &cache = canonicalSemanticTypeCache();
  const auto found = cache.find(key);
  if (found != cache.end() && found->second == type) {
    requireExactPointerMemberSemanticIdentity(type, key, "retirement");
    cache.erase(found);
  }
}

SOURCE_CREATE_TYPE_FOR_POINTER_MEMBER_TYPE_END

SOURCE_CREATE_TYPE_FOR_TYPE_INT_TYPE_START
const int SgTypeInt::maxBitLength = ROSE_INTEGER_TYPE_MAX_BIT_LENGTH;
SgTypeInt *SgTypeInt::createType(int /*bitLength*/,
                                 SgExpression *optional_fortran_type_kind) {
  return createPrimitiveType<SgTypeInt>(optional_fortran_type_kind);
}

SOURCE_CREATE_TYPE_FOR_TYPE_INT_TYPE_END

SOURCE_CREATE_TYPE_FOR_ENUM_TYPE_START
SgEnumType *SgEnumType::createType(SgEnumDeclaration *cd,
                                   SgExpression *optional_fortran_type_kind) {
  ROSE_ASSERT(optional_fortran_type_kind == NULL);
  if (cd == NULL || cd->get_scope() == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[enum-type-canonical-owner]: createType "
            "requires an enum declaration with an exact semantic scope\n");
    ROSE_ABORT();
  }
  SgEnumDeclaration *first =
      isSgEnumDeclaration(cd->get_firstNondefiningDeclaration());
  if (first == NULL || first->get_firstNondefiningDeclaration() != first ||
      first->get_scope() == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[enum-type-canonical-owner]: declaration=%p "
            "has no exact first nondefining enum declaration\n",
            static_cast<void *>(cd));
    ROSE_ABORT();
  }
  SgEnumType *type = first->get_type();
  if (type == NULL) {
    if (cd != first && cd->get_type() != NULL) {
      fprintf(stderr,
              "REX_AST_INVARIANT[enum-type-canonical-owner]: declaration=%p "
              "has a type before its canonical declaration=%p\n",
              static_cast<void *>(cd), static_cast<void *>(first));
      ROSE_ABORT();
    }
    type = new SgEnumType(first);
    first->set_type(type);
  }
  SgEnumDeclaration *owner = isSgEnumDeclaration(type->get_declaration());
  if (owner == NULL || owner->get_firstNondefiningDeclaration() != owner ||
      owner->get_type() != type ||
      (cd->get_type() != NULL && cd->get_type() != type)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[enum-type-canonical-owner]: declaration=%p "
            "first=%p type=%p owner=%p has contradictory typed identity\n",
            static_cast<void *>(cd), static_cast<void *>(first),
            static_cast<void *>(type), static_cast<void *>(owner));
    ROSE_ABORT();
  }
  cd->set_type(type);
  return type;
}

SOURCE_CREATE_TYPE_FOR_ENUM_TYPE_END

SOURCE_CREATE_TYPE_FOR_CLASS_TYPE_START

SgClassType *SgClassType::createType(SgDeclarationStatement *cd,
                                     SgExpression *optional_fortran_type_kind) {
  if (cd == NULL || isSgClassDeclaration(cd) == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: createType "
                    "requires a non-null SgClassDeclaration\n");
    ROSE_ABORT();
  }
  if (optional_fortran_type_kind != NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: "
                    "SgClassType cannot carry a Fortran kind expression\n");
    ROSE_ABORT();
  }

  SgClassDeclaration *classDeclaration = isSgClassDeclaration(cd);
  SgClassDeclaration *firstNondefining =
      isSgClassDeclaration(classDeclaration->get_firstNondefiningDeclaration());
  if (firstNondefining == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: class "
                    "declaration has no typed first nondefining declaration\n");
    ROSE_ABORT();
  }
  if (classDeclaration != firstNondefining) {
    fprintf(stderr,
            "REX_AST_INVARIANT[class-type-canonical-owner]: createType must be "
            "called with the canonical first nondefining declaration\n");
    ROSE_ABORT();
  }
  if (firstNondefining->get_firstNondefiningDeclaration() != firstNondefining) {
    fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: first "
                    "nondefining declaration is not self-canonical\n");
    ROSE_ABORT();
  }

  SgScopeStatement *canonicalScope = firstNondefining->get_scope();
  if (canonicalScope == NULL) {
    fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: canonical "
                    "first nondefining declaration has no semantic scope\n");
    ROSE_ABORT();
  }

  SgClassDeclaration *definingDeclaration = NULL;
  if (firstNondefining->get_definingDeclaration() != NULL) {
    definingDeclaration =
        isSgClassDeclaration(firstNondefining->get_definingDeclaration());
    if (definingDeclaration == NULL) {
      fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: defining "
                      "declaration has the wrong AST kind\n");
      ROSE_ABORT();
    }
    if (definingDeclaration->get_definingDeclaration() != definingDeclaration ||
        definingDeclaration->get_firstNondefiningDeclaration() !=
            firstNondefining ||
        (definingDeclaration->get_scope() != canonicalScope &&
         !SgScopeStatement::isEquivalentScope(definingDeclaration->get_scope(),
                                              canonicalScope)) ||
        definingDeclaration->get_definition() == NULL) {
      fprintf(
          stderr,
          "REX_AST_INVARIANT[class-type-canonical-owner]: canonical=%p/%s "
          "scope=%p defining=%p first=%p self=%p scope=%p definition=%p "
          "chain or scope disagrees with its canonical owner\n",
          static_cast<void *>(firstNondefining),
          firstNondefining->get_name().getString().c_str(),
          static_cast<void *>(canonicalScope),
          static_cast<void *>(definingDeclaration),
          static_cast<void *>(
              definingDeclaration->get_firstNondefiningDeclaration()),
          static_cast<void *>(definingDeclaration->get_definingDeclaration()),
          static_cast<void *>(definingDeclaration->get_scope()),
          static_cast<void *>(definingDeclaration->get_definition()));
      ROSE_ABORT();
    }
  }

  if (firstNondefining->get_definition() != NULL &&
      definingDeclaration != firstNondefining) {
    fprintf(
        stderr,
        "REX_AST_INVARIANT[class-type-canonical-owner]: canonical declaration "
        "owns a definition but is not the defining declaration\n");
    ROSE_ABORT();
  }

  SgType *declarationType = firstNondefining->get_type();
  if (declarationType != NULL) {
    $CLASSNAME *canonicalType = is$CLASSNAME(declarationType);
    SgClassDeclaration *typeDeclaration =
        canonicalType != NULL
            ? isSgClassDeclaration(canonicalType->get_declaration())
            : NULL;
    const bool exactSharedProjectType =
        typeDeclaration != NULL &&
        SageInterface::isExactTagTypeIdentity(canonicalType, firstNondefining);
    if (canonicalType == NULL ||
        (typeDeclaration != firstNondefining && !exactSharedProjectType)) {
      fprintf(stderr,
              "REX_AST_INVARIANT[class-type-canonical-owner]: canonical "
              "declaration carries a noncanonical class type\n");
      ROSE_ABORT();
    }
    if (definingDeclaration != NULL &&
        definingDeclaration->get_type() != canonicalType) {
      fprintf(stderr, "REX_AST_INVARIANT[class-type-canonical-owner]: defining "
                      "declaration does not share its canonical class type\n");
      ROSE_ABORT();
    }
    return canonicalType;
  }

  if (definingDeclaration != NULL && definingDeclaration->get_type() != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[class-type-canonical-owner]: defining "
            "declaration published a type before its canonical owner\n");
    ROSE_ABORT();
  }

  $CLASSNAME *newType = new $CLASSNAME(firstNondefining);
  ROSE_ASSERT(newType != NULL);

  // The canonical declaration is the type's identity and owns its publication.
  // A second index keyed by a mangled scope name is redundant and cannot be
  // formed while an enclosing function is still constructing its signature.
  firstNondefining->set_type(newType);
  if (definingDeclaration != NULL && definingDeclaration != firstNondefining) {
    definingDeclaration->set_type(newType);
  }

  ROSE_ASSERT(newType->get_declaration() == firstNondefining);
  ROSE_ASSERT(firstNondefining->get_type() == newType);
  ROSE_ASSERT(definingDeclaration == NULL ||
              definingDeclaration->get_type() == newType);
  return newType;
}

SOURCE_CREATE_TYPE_FOR_CLASS_TYPE_END

SOURCE_CREATE_TYPE_FOR_POINTER_TYPE_START
SgPointerType *
SgPointerType::createType(SgType *base_type,
                          SgExpression *optional_fortran_type_kind) {
  ROSE_ASSERT(base_type != NULL && SgNode::isLiveNode(base_type));
  ROSE_ASSERT(!base_type->has_source_prototype());

  ROSE_ASSERT(optional_fortran_type_kind == NULL);

  if (base_type->p_ptr_to != NULL) {
    ROSE_ASSERT(SgNode::isLiveNode(base_type->p_ptr_to));
    ROSE_ASSERT(base_type->p_ptr_to->variantT() == V_SgPointerType);
    ROSE_ASSERT(base_type->p_ptr_to->get_base_type() == base_type);
    return base_type->p_ptr_to;
  }
  base_type->p_ptr_to = new SgPointerType(base_type);
  return base_type->p_ptr_to;
}

SOURCE_CREATE_TYPE_FOR_POINTER_TYPE_END

SOURCE_CREATE_TYPE_FOR_REFERENCE_TYPE_START
SgReferenceType *
SgReferenceType::createType(SgType *base_type,
                            SgExpression *optional_fortran_type_kind) {
  ROSE_ASSERT(base_type != NULL && SgNode::isLiveNode(base_type));
  ROSE_ASSERT(!base_type->has_source_prototype());

  ROSE_ASSERT(optional_fortran_type_kind == NULL);

  if (base_type->p_ref_to) {
    ROSE_ASSERT(SgNode::isLiveNode(base_type->p_ref_to));
    ROSE_ASSERT(base_type->p_ref_to->get_base_type() == base_type);
    return base_type->p_ref_to;
  }
  base_type->p_ref_to = new SgReferenceType(base_type);
  return base_type->p_ref_to;
}

SOURCE_CREATE_TYPE_FOR_REFERENCE_TYPE_END

SOURCE_CREATE_TYPE_FOR_RVALUE_REFERENCE_TYPE_START
SgRvalueReferenceType *
SgRvalueReferenceType::createType(SgType *base_type,
                                  SgExpression *optional_fortran_type_kind) {
  ROSE_ASSERT(base_type != NULL && SgNode::isLiveNode(base_type));
  ROSE_ASSERT(!base_type->has_source_prototype());

  ROSE_ASSERT(optional_fortran_type_kind == NULL);

  if (base_type->p_rvalue_ref_to) {
    ROSE_ASSERT(SgNode::isLiveNode(base_type->p_rvalue_ref_to));
    ROSE_ASSERT(base_type->p_rvalue_ref_to->get_base_type() == base_type);
    return base_type->p_rvalue_ref_to;
  }
  base_type->p_rvalue_ref_to = new SgRvalueReferenceType(base_type);
  return base_type->p_rvalue_ref_to;
}

SOURCE_CREATE_TYPE_FOR_RVALUE_REFERENCE_TYPE_END

SOURCE_CREATE_TYPE_FOR_DECL_TYPE_START

SgDeclType *SgDeclType::createType(SgExpression *base_expression,
                                   SgType *base_type,
                                   SgExpression *optional_fortran_type_kind) {
  ROSE_ASSERT(optional_fortran_type_kind == nullptr);
  return SageBuilder::buildDeclType(base_expression, base_type);
}

SOURCE_CREATE_TYPE_FOR_DECL_TYPE_END

SOURCE_CREATE_TYPE_FOR_TYPEOF_TYPE_START

SgTypeOfType *
SgTypeOfType::createType(SgExpression *base_expression,
                         SgExpression *optional_fortran_type_kind) {
  ROSE_ASSERT(optional_fortran_type_kind == nullptr);
  return SageBuilder::buildTypeOfType(base_expression, nullptr);
}

SgTypeOfType *
SgTypeOfType::createType(SgType *base_type,
                         SgExpression *optional_fortran_type_kind) {
  ROSE_ASSERT(optional_fortran_type_kind == nullptr);
  return SageBuilder::buildTypeOfType(nullptr, base_type);
}
SOURCE_CREATE_TYPE_FOR_TYPEOF_TYPE_END

SOURCE_CREATE_TYPE_FOR_STRING_TYPE_START

SgTypeString *
SgTypeString::createType(SgExpression *lengthExpression,
                         SgExpression *optional_fortran_type_kind) {
  if ((lengthExpression != NULL && lengthExpression->get_parent() != NULL) ||
      (optional_fortran_type_kind != NULL &&
       optional_fortran_type_kind->get_parent() != NULL) ||
      (lengthExpression != NULL &&
       lengthExpression == optional_fortran_type_kind)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[string-type-selector-owner]: "
            "candidate CHARACTER selector is already owned or aliased\n");
    ROSE_ABORT();
  }
  if (!SageInterface::Detail::isValidFortranLengthSelector(lengthExpression)) {
    fprintf(stderr, "REX_AST_INVARIANT[string-type-length]: CHARACTER LEN "
                    "selector is not an integer or length shape\n");
    ROSE_ABORT();
  }
  if (optional_fortran_type_kind != nullptr &&
      !SageInterface::Detail::isValidFortranKindSelector(
          optional_fortran_type_kind)) {
    fprintf(stderr, "REX_AST_INVARIANT[string-type-kind]: CHARACTER KIND "
                    "selector is not a positive integer constant\n");
    ROSE_ABORT();
  }

  auto restore_selectors = [](SgTypeString *type) {
    for (SgExpression *selector :
         {type->get_lengthExpression(), type->get_type_kind()}) {
      if (selector != nullptr) {
        ROSE_ASSERT(selector->get_parent() == type);
        selector->set_parent(nullptr);
      }
    }
    type->set_lengthExpression(nullptr);
    type->set_type_kind(nullptr);
    delete type;
  };
  std::unique_ptr<SgTypeString, decltype(restore_selectors)> candidate(
      new SgTypeString(lengthExpression), restore_selectors);
  SgTypeString *returnType = candidate.get();
  if (lengthExpression != NULL) {
    lengthExpression->set_parent(returnType);
  }
  if (optional_fortran_type_kind != NULL) {
    returnType->set_type_kind(optional_fortran_type_kind);
    optional_fortran_type_kind->set_parent(returnType);
  }
  ROSE_ASSERT(returnType != NULL);

  auto *table = get_globalTypeTable();
  std::vector<SgTypeString *> strings;
  for (const auto &entry : *table->get_type_table()->get_table()) {
    auto *symbol = isSgFunctionTypeSymbol(entry.second);
    ROSE_ASSERT(symbol != nullptr && symbol->get_type() != nullptr);
    if (auto *type = isSgTypeString(symbol->get_type()))
      strings.push_back(type);
  }
  // Comparing expressions can query other canonical types. Keep those queries
  // outside the symbol-table traversal so an insertion cannot invalidate it.
  for (SgTypeString *canonical_type : strings) {
    if (canonical_type == returnType ||
        canonical_type->get_fortran_source_syntax() ||
        canonical_type->get_hasTypeKindStar() ||
        canonical_type->get_fortran_dynamic_length_pending() ||
        canonical_type->get_fortran_dynamic_result_length() ||
        canonical_type->get_fortran_fixed_kind_value_is_available() ||
        canonical_type->get_fortran_fixed_kind_value() != 0 ||
        canonical_type->get_lengthExpression() == nullptr ||
        canonical_type->get_lengthExpression()->get_parent() != canonical_type ||
        (canonical_type->get_type_kind() != NULL &&
         canonical_type->get_type_kind()->get_parent() != canonical_type)) {
      fprintf(stderr, "REX_AST_INVARIANT[string-type-interning]: "
                      "cached semantic CHARACTER has contradictory "
                      "identity or selector ownership\n");
      ROSE_ABORT();
    }
    if (!equivalentFortranSelector(canonical_type->get_lengthExpression(),
                                   lengthExpression) ||
        !equivalentFortranSelector(canonical_type->get_type_kind(),
                                   optional_fortran_type_kind))
      continue;

    SgExpression *discarded_length = returnType->get_lengthExpression();
    SgExpression *discarded_kind = returnType->get_type_kind();
    returnType->set_lengthExpression(NULL);
    returnType->set_type_kind(NULL);
    for (SgExpression *selector : {discarded_length, discarded_kind})
      if (selector != nullptr) {
        ROSE_ASSERT(selector->get_parent() == returnType);
        selector->set_parent(nullptr);
      }
    SageInterface::deleteAST(
        {discarded_length, discarded_kind},
        SageInterface::DeleteAstMode::kSkipExternalReferences);
    return canonical_type;
  }

  table->insert_type(returnType->get_mangled(), returnType);
  return candidate.release();
}

SOURCE_CREATE_TYPE_FOR_STRING_TYPE_END

SOURCE_MODIFIER_TYPE_INTERNING_START

SgModifierType *
SgModifierType::insertModifierTypeIntoTypeTable(SgModifierType *result) {
  ROSE_ASSERT(result == nullptr || SgNode::isLiveNode(result));
  if (result == NULL || result->get_base_type() == NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[modifier-type-canonical-owner]: modifier=%p "
            "has no exact base type\n",
            static_cast<void *>(result));
    ROSE_ABORT();
  }
  ROSE_ASSERT(result->get_parent() == nullptr);
  ROSE_ASSERT(SgNode::isLiveNode(result->get_base_type()));
  ROSE_ASSERT(!result->get_base_type()->has_source_prototype());

  // A KIND expression is an owned syntax/semantic child of this exact
  // modifier type.  It cannot be shared with another type node, and the legacy
  // mangled key did not encode it.  Preserve that unique ownership rather than
  // silently aliasing two distinct expression trees.
  if (result->get_type_kind() != NULL) {
    if (result->get_type_kind()->get_parent() != result) {
      fprintf(stderr,
              "REX_AST_INVARIANT[modifier-type-canonical-owner]: modifier=%p "
              "KIND expression=%p has owner=%p\n",
              static_cast<void *>(result),
              static_cast<void *>(result->get_type_kind()),
              static_cast<void *>(result->get_type_kind()->get_parent()));
      ROSE_ABORT();
    }
    return result;
  }

  SgType *base_type = result->get_base_type();
  SgModifierNodes *bucket = base_type->get_modifiers();

  SgModifierType *canonical = NULL;
  SgModifierNodes *insertion_bucket = NULL;
  size_t insertion_index = 0;
  SgModifierNodes *tail = NULL;
  SgNode *owner = base_type;
  for (SgModifierNodes *current = bucket; current != NULL;
       current = current->get_next()) {
    ROSE_ASSERT(SgNode::isLiveNode(current));
    const auto &nodes = current->p_nodes;
    if (current->get_parent() != owner || nodes.size() != 4) {
      fprintf(stderr,
              "REX_AST_INVARIANT[modifier-type-canonical-owner]: base=%p/%s "
              "has a cyclic or malformed modifier cache bucket=%p size=%zu\n",
              static_cast<void *>(base_type), base_type->class_name().c_str(),
              static_cast<void *>(current), nodes.size());
      ROSE_ABORT();
    }
    for (size_t i = 0; i < nodes.size(); ++i) {
      SgModifierType *candidate = nodes[i];
      if (candidate == NULL) {
        if (insertion_bucket == NULL) {
          insertion_bucket = current;
          insertion_index = i;
        }
        continue;
      }
      ROSE_ASSERT(SgNode::isLiveNode(candidate));
      if (candidate->get_base_type() != base_type ||
          candidate->get_type_kind() != NULL) {
        fprintf(stderr,
                "REX_AST_INVARIANT[modifier-type-canonical-owner]: base=%p/%s "
                "cache contains incompatible modifier=%p base=%p kind=%p\n",
                static_cast<void *>(base_type), base_type->class_name().c_str(),
                static_cast<void *>(candidate),
                static_cast<void *>(candidate->get_base_type()),
                static_cast<void *>(candidate->get_type_kind()));
        ROSE_ABORT();
      }
      if (candidate->get_typeModifier() == result->get_typeModifier()) {
        if (canonical != NULL && canonical != candidate) {
          fprintf(
              stderr,
              "REX_AST_INVARIANT[modifier-type-canonical-owner]: "
              "base=%p/%s has duplicate exact modifiers=%p/%p\n",
              static_cast<void *>(base_type), base_type->class_name().c_str(),
              static_cast<void *>(canonical), static_cast<void *>(candidate));
          ROSE_ABORT();
        }
        canonical = candidate;
      }
    }
    tail = current;
    owner = current;
  }

  if (canonical != NULL) {
    if (canonical != result) {
      delete result;
    }
    return canonical;
  }
  if (insertion_bucket == NULL) {
    auto pending = std::make_unique<SgModifierNodes>();
    pending->set_parent(owner);
    if (tail != nullptr)
      tail->set_next(pending.get());
    else
      base_type->set_modifiers(pending.get());
    insertion_bucket = pending.release();
    insertion_index = 0;
  }
  auto &insertion_nodes = insertion_bucket->p_nodes;
  if (insertion_nodes.size() != 4 || insertion_nodes[insertion_index] != NULL) {
    fprintf(stderr,
            "REX_AST_INVARIANT[modifier-type-canonical-owner]: base=%p/%s "
            "has no exact insertion slot\n",
            static_cast<void *>(base_type), base_type->class_name().c_str());
    ROSE_ABORT();
  }
  insertion_nodes[insertion_index] = result;
  return result;
}

SOURCE_MODIFIER_TYPE_INTERNING_END

SOURCE_CREATE_TYPE_FOR_COMPLEX_TYPE_START

std::map<SgType *, $CLASSNAME *> &$CLASSNAME::canonicalSemanticTypeCache() {
  static std::map<SgType *, $CLASSNAME *> cache;
  return cache;
}

$CLASSNAME *$CLASSNAME::findCanonicalSemanticType(SgType *t) {

  if (t == NULL || t->get_fortran_source_syntax() ||
      (t->get_type_kind() != NULL && t->get_type_kind()->get_parent() != t)) {
    fprintf(stderr,
            "REX_AST_INVARIANT[complex-type-interning]: "
            "semantic component has contradictory source or KIND ownership\n");
    ROSE_ABORT();
  }

  const auto &cache = canonicalSemanticTypeCache();
  const auto found = cache.find(t);
  if (found == cache.end())
    return nullptr;
  $CLASSNAME *returnType = found->second;
  ROSE_ASSERT(SgNode::isLiveNode(returnType));
  if (returnType == NULL || returnType->get_base_type() != t ||
      returnType->get_fortran_source_syntax() ||
      returnType->get_hasTypeKindStar() ||
      returnType->get_fortran_fixed_kind_value_is_available() ||
      returnType->get_fortran_fixed_kind_value() != 0) {
    fprintf(stderr,
            "REX_AST_INVARIANT[complex-type-interning]: "
            "cached semantic COMPLEX/IMAGINARY has contradictory identity\n");
    ROSE_ABORT();
  }

  return returnType;
}

$CLASSNAME *$CLASSNAME::createType(SgType *t) {
  if (auto *type = findCanonicalSemanticType(t))
    return type;
  auto candidate = std::make_unique<$CLASSNAME>(t);
  const auto inserted = canonicalSemanticTypeCache().emplace(t, candidate.get());
  ROSE_ASSERT(inserted.second);
  candidate.release();
  return findCanonicalSemanticType(t);
}

void $CLASSNAME::forgetCanonicalSemanticType($CLASSNAME *type) {
  auto &cache = canonicalSemanticTypeCache();
  const auto found = cache.find(type->get_base_type());
  if (found != cache.end() && found->second == type)
    cache.erase(found);
}

SgExpression *$CLASSNAME::get_type_kind() const {
  return this->get_base_type()->get_type_kind();
}

void $CLASSNAME::set_type_kind(SgExpression *type_kind) {
  this->get_base_type()->set_type_kind(type_kind);
}

SOURCE_CREATE_TYPE_FOR_COMPLEX_TYPE_END
