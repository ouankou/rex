HEADER_TEMPLATE_TYPE_START

public:
//! Stable identity of the canonical source token that declares the represented
//! template parameter. Expansion and spelling locations are both required:
//! the former distinguishes macro invocations, while the latter distinguishes
//! multiple parameter tokens produced by one invocation.
struct canonical_source_identity {
  int expansion_file_id = Sg_File_Info::BAD_FILE_ID;
  unsigned int expansion_file_offset = 0;
  int spelling_file_id = Sg_File_Info::BAD_FILE_ID;
  unsigned int spelling_file_offset = 0;

  friend bool operator==(const canonical_source_identity &lhs,
                         const canonical_source_identity &rhs) {
    return lhs.expansion_file_id == rhs.expansion_file_id &&
           lhs.expansion_file_offset == rhs.expansion_file_offset &&
           lhs.spelling_file_id == rhs.spelling_file_id &&
           lhs.spelling_file_offset == rhs.spelling_file_offset;
  }

  friend std::ostream &operator<<(std::ostream &out,
                                  const canonical_source_identity &identity) {
    out << identity.expansion_file_id << ":" << identity.expansion_file_offset
        << ":" << identity.spelling_file_id << ":"
        << identity.spelling_file_offset;
    return out;
  }
};

const std::optional<canonical_source_identity> &
get_canonical_source_identity() const;
void initialize_canonical_source_identity(
    const canonical_source_identity &identity);

HEADER_TEMPLATE_TYPE_END

