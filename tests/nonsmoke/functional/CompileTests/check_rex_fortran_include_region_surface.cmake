cmake_minimum_required(VERSION 3.19)

foreach(_required IN ITEMS INPUT SOURCE_DIRECTORY FAMILY LAYOUT)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "Missing include-region surface argument: ${_required}")
  endif()
endforeach()
if(FAMILY STREQUAL "omp")
  set(_language openmp)
elseif(FAMILY STREQUAL "acc")
  set(_language openacc)
else()
  message(FATAL_ERROR "Unknown include-region surface family: ${FAMILY}")
endif()
get_filename_component(_source_root "${SOURCE_DIRECTORY}" REALPATH)
get_filename_component(_output_root "${INPUT}" DIRECTORY)
get_filename_component(_output_root "${_output_root}" REALPATH)
set(_include_names
  rex_fortran_${_language}_include_begin.inc
  rex_fortran_${_language}_include_comments.inc
  rex_fortran_${_language}_include_turnover.inc)

# These specimens have only literal native Fortran INCLUDE edges. Expand the
# actual generated compiler input, preserving either a retained INCLUDE or an
# already inlined output policy. Other include syntax or ownership is an error.
function(rex_expand_fixture_source input active result)
  if(NOT EXISTS "${input}")
    message(FATAL_ERROR "Unresolved include-region source: ${input}")
  endif()
  get_filename_component(_physical "${input}" REALPATH)
  list(FIND active "${_physical}" _recursive)
  if(NOT _recursive EQUAL -1)
    message(FATAL_ERROR "Recursive include-region source: ${_physical}")
  endif()
  list(APPEND active "${_physical}")
  get_filename_component(_directory "${_physical}" DIRECTORY)
  if(NOT _directory STREQUAL _source_root AND
     NOT _directory STREQUAL _output_root)
    message(FATAL_ERROR "Foreign include-region source root: ${_physical}")
  endif()
  file(STRINGS "${_physical}" _lines)
  set(_expanded)
  foreach(_line IN LISTS _lines)
    string(TOLOWER "${_line}" _lower)
    if(_lower MATCHES "^[ \t]*include([ \t]|$)")
      if(NOT _line MATCHES "^[ \t]*[Ii][Nn][Cc][Ll][Uu][Dd][Ee][ \t]+[\"']([^\"']+)[\"'][ \t]*(!.*)?$")
        message(FATAL_ERROR "Nonliteral fixture INCLUDE: ${_line}")
      endif()
      set(_literal "${CMAKE_MATCH_1}")
      set(_include_comment "${CMAKE_MATCH_2}")
      get_filename_component(_name "${_literal}" NAME)
      if(NOT _name IN_LIST _include_names)
        message(FATAL_ERROR "Unknown fixture INCLUDE: ${_literal}")
      endif()
      if(IS_ABSOLUTE "${_literal}")
        set(_included "${_literal}")
      elseif(EXISTS "${_directory}/${_literal}")
        set(_included "${_directory}/${_literal}")
      else()
        set(_included "${_source_root}/${_literal}")
      endif()
      if(NOT _include_comment STREQUAL "")
        string(APPEND _expanded "${_include_comment}\n")
      endif()
      rex_expand_fixture_source("${_included}" "${active}" _nested)
      string(APPEND _expanded "${_nested}")
    elseif(_lower MATCHES "^[ \t]*#[ \t]*include")
      message(FATAL_ERROR "Unexpected CPP include in native INCLUDE fixture")
    else()
      string(APPEND _expanded "${_line}\n")
    endif()
  endforeach()
  set(${result} "${_expanded}" PARENT_SCOPE)
endfunction()

rex_expand_fixture_source("${INPUT}" "" _expanded)
string(REPLACE "\n" ";" _lines "${_expanded}")
set(_actual_events)
foreach(_line IN LISTS _lines)
  string(TOLOWER "${_line}" _lower)
  if(_lower MATCHES "^[ \t]*![$]${FAMILY}[ \t]+parallel([ \t]|$)")
    list(APPEND _actual_events BEGIN)
  elseif(_lower MATCHES "^[ \t]*![$]${FAMILY}[ \t]+end[ \t]+parallel([ \t]|$)")
    list(APPEND _actual_events END)
  endif()
  string(REGEX MATCHALL "REX_INCLUDE_[A-Z_]+" _markers "${_line}")
  foreach(_marker IN LISTS _markers)
    if(NOT _line MATCHES "! ${_marker}$")
      message(FATAL_ERROR "Changed fixture comment spelling: ${_line}")
    endif()
    list(APPEND _actual_events "${_marker}")
  endforeach()
endforeach()
if(LAYOUT STREQUAL "empty" OR LAYOUT STREQUAL "nonempty")
  set(_expected_events
    REX_INCLUDE_BEFORE BEGIN REX_INCLUDE_BEGIN_INLINE
    REX_INCLUDE_FROM_INCLUDE REX_INCLUDE_BODY_MAIN)
  if(LAYOUT STREQUAL "empty")
    list(APPEND _expected_events
      REX_INCLUDE_T REX_INCLUDE_COMMENT_CHILD_FIRST REX_INCLUDE_COMMENT_CHILD_LAST)
  endif()
  list(APPEND _expected_events
    REX_INCLUDE_END_BEFORE END REX_INCLUDE_END_INLINE REX_INCLUDE_AFTER)
elseif(LAYOUT STREQUAL "repeat")
  set(_expected_events
    REX_INCLUDE_BEFORE BEGIN REX_INCLUDE_OUTER_BEGIN REX_INCLUDE_FIRST
    END REX_INCLUDE_REPEAT_END REX_INCLUDE_REPEAT_OUTSIDE
    BEGIN REX_INCLUDE_REPEAT_BEGIN REX_INCLUDE_MIDDLE
    END REX_INCLUDE_REPEAT_END REX_INCLUDE_REPEAT_OUTSIDE
    BEGIN REX_INCLUDE_REPEAT_BEGIN REX_INCLUDE_LAST
    END REX_INCLUDE_OUTER_END REX_INCLUDE_AFTER)
else()
  message(FATAL_ERROR "Unknown include-region surface layout: ${LAYOUT}")
endif()
if(NOT _actual_events STREQUAL _expected_events)
  message(FATAL_ERROR
    "Changed directive/comment ownership, duplication, or source order\n"
    "Expected: ${_expected_events}\nActual: ${_actual_events}")
endif()
