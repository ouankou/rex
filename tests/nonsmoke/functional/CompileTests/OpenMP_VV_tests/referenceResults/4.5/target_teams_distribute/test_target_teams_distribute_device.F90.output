!$omp target enter data map(to:a(1:N),b(1:N),c(1:N,dev:dev),num_teams(dev:dev)) device(dev-1)
!$omp target teams distribute map(alloc:a(1:N),b(1:N),c(1:N,dev:dev),num_teams(dev:dev)) device(dev-1)
!$omp target exit data map(from:c(1:N,dev:dev),num_teams(dev:dev)) map(delete:a(1:N),b(1:N)) device(dev-1)
