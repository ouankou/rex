include(CheckLinkerFlag)

function(rex_configure_rpath library_directory)
  if(NOT DEFINED CMAKE_BUILD_RPATH_USE_ORIGIN)
    set(CMAKE_BUILD_RPATH_USE_ORIGIN TRUE PARENT_SCOPE)
  endif()
  if(NOT DEFINED CMAKE_INSTALL_RPATH)
    set(_rpath "$ORIGIN/../${library_directory}" "$ORIGIN")
    list(APPEND _rpath ${LLVM_LIBRARY_DIRS} ${CLANG_LIBRARY_DIRS})
    list(REMOVE_DUPLICATES _rpath)
    set(CMAKE_INSTALL_RPATH "${_rpath}" PARENT_SCOPE)
  endif()
  if(NOT DEFINED CMAKE_INSTALL_RPATH_USE_LINK_PATH)
    set(CMAKE_INSTALL_RPATH_USE_LINK_PATH FALSE PARENT_SCOPE)
  endif()
endfunction()

function(rex_check_linker_flag language option result)
  set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
  # try_compile does not inherit directory link options. Test the driver with
  # the same selected linker and options that production targets will receive.
  get_directory_property(_directory_options LINK_OPTIONS)
  # CheckLinkerFlag replaces CMAKE_REQUIRED_LINK_OPTIONS internally, so pass
  # the complete option list through its flag argument.
  set(_options ${CMAKE_REQUIRED_LINK_OPTIONS} ${_directory_options} "${option}")
  unset(_rex_option_supported CACHE)
  unset(_rex_option_supported)
  check_linker_flag(${language} "${_options}" _rex_option_supported)
  set(${result} "${_rex_option_supported}" PARENT_SCOPE)
  unset(_rex_option_supported CACHE)
endfunction()

function(rex_require_linker_option option)
  get_property(_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
  foreach(_language IN LISTS _languages)
    rex_check_linker_flag(${_language} "${option}" _supported)
    if(NOT _supported)
      message(FATAL_ERROR "Required linker option '${option}' is unsupported by ${_language} with REX_LINKER=${REX_SELECTED_LINKER}")
    endif()
  endforeach()
  add_link_options("${option}")
endfunction()

# REX_LINKER selects the compiler driver's linker. CMAKE_LINKER keeps CMake's
# native toolchain meaning; executable basenames do not determine driver flags.
function(rex_configure_linker)
  set(REX_LINKER "auto" CACHE STRING "REX linker policy: auto, lld, mold, bfd, or system")
  set(_choices auto lld mold bfd system)
  set_property(CACHE REX_LINKER PROPERTY STRINGS ${_choices})
  if(NOT REX_LINKER IN_LIST _choices)
    message(FATAL_ERROR "REX_LINKER must be auto, lld, mold, bfd, or system; got '${REX_LINKER}'")
  endif()

  if(EMSCRIPTEN)
    if(NOT REX_LINKER STREQUAL "auto" AND NOT REX_LINKER STREQUAL "system")
      message(FATAL_ERROR "Emscripten owns its linker; use REX_LINKER=auto or system")
    endif()
    set(_candidates system)
  elseif(REX_LINKER STREQUAL "auto")
    # These are preferences, tested with every enabled compiler driver. The
    # system choice delegates entirely to the configured toolchain.
    set(_candidates lld mold bfd system)
  else()
    set(_candidates "${REX_LINKER}")
  endif()

  get_property(_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
  foreach(_candidate IN LISTS _candidates)
    if(_candidate STREQUAL "system")
      set(REX_SELECTED_LINKER system PARENT_SCOPE)
      message(STATUS "REX linker: configured toolchain")
      return()
    endif()
    set(_supported TRUE)
    foreach(_language IN LISTS _languages)
      if(_language STREQUAL "NONE")
        message(FATAL_ERROR "REX linker selection requires an enabled compiler driver")
      endif()
      # Recheck on reconfiguration: PATH, toolchain files and driver options
      # can change while the build directory remains the same.
      rex_check_linker_flag(${_language} "-fuse-ld=${_candidate}" _rex_linker_works)
      if(NOT _rex_linker_works)
        set(_supported FALSE)
      endif()
    endforeach()
    if(_supported)
      add_link_options("-fuse-ld=${_candidate}")
      set(REX_SELECTED_LINKER "${_candidate}" PARENT_SCOPE)
      message(STATUS "REX linker: ${_candidate} (validated compiler-driver option)")
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Requested REX_LINKER=${REX_LINKER} is not supported by every enabled compiler driver")
endfunction()
