#!/bin/bash
set -euo pipefail

arg0="${0##*/}"
dir0="${0%/*}"
DEFAULT_CONFIG="docs/mrdocs.yml"

####################################################################################################################################
help() {
    ######--------------------------------------------------------------------------------##### 80 columns
    echo "$arg0"
    echo
    echo "Name"
    echo "        $arg0 - generate ROSE API documentation with MrDocs"
    echo
    echo "Synopsis"
    echo "        $arg0 [MRDOCS_CONFIG]"
    echo
    echo "Description"
    echo "        This command runs MrDocs to generate HTML API documentation."
    echo "        The optional argument, MRDOCS_CONFIG, is the path to a mrdocs.yml"
    echo "        configuration file. If not provided, docs/mrdocs.yml is used."
    echo
    echo "        This command can be run from any directory, but the command must either"
    echo "        be located inside the ROSE source directory hierarchy, or the"
    echo "        ROSE_SOURCE environment variable must point to the ROSE source"
    echo "        directory."
    echo
    echo "        The build tree must provide a compile_commands.json file. The default"
    echo "        configuration expects it at ./build/compile_commands.json."
    echo
    echo "        To override the output directory without editing the config, set"
    echo "        MRDOCS_OUTPUT_DIR to a path under the project root."
    echo
    echo "        The following command-line switches are understood:"
    echo
    echo "        --help | -h"
    echo "                Show this documentation."
    echo
    echo "        --version | -V"
    echo "                Print the tool version on standard output and exit success."
    ######--------------------------------------------------------------------------------##### 80 columns
}

####################################################################################################################################
die() {
    echo "$arg0: error:" "$@" >&2
    exit 1
}

####################################################################################################################################
# Find top of ROSE source code
cached_rose_source=
rose-source() {
    if [ "$cached_rose_source" = "" ]; then
        local rose_src=
        for rose_src in "${ROSE_SOURCE-}" "${RG_SRC-}" "$dir0/.." "${ROSE-}"; do
            if [ -n "$rose_src" ] && [ -d "$rose_src/." ] && [ -f "$rose_src/ROSE_VERSION" ]; then
                cached_rose_source="$(cd "$rose_src"; pwd)"
                break
            fi
        done
    fi
    [ -n "$cached_rose_source" ] || die "cannot find the top of the ROSE source tree"
    echo "$cached_rose_source"
}

####################################################################################################################################
rose-version-short() {
    cat "$(rose-source)/ROSE_VERSION"
}

rose-version-long() {
    rose-version-short

    local branch="$(git branch --show-current 2>/dev/null)"
    if [ -n "$branch" ]; then
        echo "$branch"
    fi

    local commit="$(git rev-parse --short HEAD 2>/dev/null)"
    if [ -n "$commit" ]; then
        echo "$commit"
    fi
}

####################################################################################################################################
resolve-mrdocs() {
    if [ -n "${MRDOCS_BIN-}" ]; then
        if [ -x "$MRDOCS_BIN" ]; then
            echo "$MRDOCS_BIN"
            return 0
        fi
        die "MRDOCS_BIN is set but not executable: $MRDOCS_BIN"
    fi

    if type -t mrdocs >/dev/null; then
        echo "mrdocs"
        return 0
    fi

    die "mrdocs command is required (set MRDOCS_BIN or add mrdocs to PATH)"
}

resolve-python() {
    if [ -n "${PYTHON_BIN-}" ]; then
        if [ -x "$PYTHON_BIN" ]; then
            echo "$PYTHON_BIN"
            return 0
        fi
        die "PYTHON_BIN is set but not executable: $PYTHON_BIN"
    fi

    if [ -n "${DOCS_VENV_DIR-}" ] && [ -x "$DOCS_VENV_DIR/bin/python" ]; then
        echo "$DOCS_VENV_DIR/bin/python"
        return 0
    fi

    local root
    root="$(rose-source)"
    if [ -x "$root/.venv-docs/bin/python" ]; then
        echo "$root/.venv-docs/bin/python"
        return 0
    fi

    if command -v python3 >/dev/null 2>&1; then
        echo "python3"
        return 0
    fi

    die "python3 is required to run this script"
}

mrdocs-root() {
    local cmd="${MRDOCS_CMD-}"
    local path=""
    if [ -n "$cmd" ] && [ -x "$cmd" ]; then
        path="$cmd"
    else
        path="$(command -v "$cmd" 2>/dev/null || true)"
    fi
    if [ -z "$path" ]; then
        die "unable to resolve mrdocs binary path"
    fi
    echo "$(cd "$(dirname "$path")/.." && pwd)"
}

check-prerequisites() {
    MRDOCS_CMD="$(resolve-mrdocs)"
    "$MRDOCS_CMD" --version >/dev/null 2>&1 || true
    PYTHON_BIN="$(resolve-python)"
}

####################################################################################################################################
config-file() {
    local name="${1-}"
    for config in "$name" "$(rose-source)/$name" "$(rose-source)/docs/$name" "$(rose-source)/docs/$name.yml"; do
        if [ -f "$config" ]; then
            echo "$config"
            return 0
        fi
    done
    die "cannot find MrDocs config file for \"$name\""
}

####################################################################################################################################
compilation-db-from-config() {
    local config="$1"
    local value
    value="$(sed -n 's/^[[:space:]]*compilation-database:[[:space:]]*//p' "$config" | head -n 1)"
    value="${value%%#*}"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    if [ -z "$value" ]; then
        return 0
    fi
    if [[ "$value" = /* ]]; then
        echo "$value"
    else
        echo "$(cd "$(dirname "$config")" && pwd)/$value"
    fi
}

####################################################################################################################################
output-dir-from-config() {
    local config="$1"
    local value
    value="$("$PYTHON_BIN" - "$config" <<'PY'
import sys

try:
    import yaml
except ImportError:
    print("generate-api-documentation: error: PyYAML is required to parse mrdocs.yml", file=sys.stderr)
    raise SystemExit(1)

path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as fh:
        data = yaml.safe_load(fh) or {}
except FileNotFoundError:
    raise SystemExit(0)
except yaml.YAMLError as exc:
    print(f"generate-api-documentation: error: failed to parse {path}: {exc}", file=sys.stderr)
    raise SystemExit(1)

if not isinstance(data, dict):
    print(f"generate-api-documentation: error: {path} root is not a dictionary", file=sys.stderr)
    raise SystemExit(1)

value = data.get("output")
if value is None:
    raise SystemExit(0)
if not isinstance(value, str):
    print("generate-api-documentation: error: output must be a string", file=sys.stderr)
    raise SystemExit(1)
print(value)
PY
)"
    if [ -z "$value" ]; then
        return 0
    fi
    if [[ "$value" = /* ]]; then
        echo "$value"
    else
        echo "$(cd "$(dirname "$config")" && pwd)/$value"
    fi
}

####################################################################################################################################
generate-reference-sections() {
    local out_dir="$1"
    local nav_config="$2"
    "$PYTHON_BIN" - "$out_dir" "$nav_config" <<'PY'
from pathlib import Path
import shutil
import sys

try:
    import yaml
except ImportError:
    print("generate-api-documentation: error: PyYAML is required to parse mkdocs-reference.yml", file=sys.stderr)
    raise SystemExit(1)

out_dir = Path(sys.argv[1]).resolve()
nav_config = Path(sys.argv[2]).resolve()
index_path = out_dir / "index.adoc"
if not index_path.is_file():
    raise SystemExit(f"reference index not found: {index_path}")
if not nav_config.is_file():
    raise SystemExit(f"mkdocs reference config not found: {nav_config}")

nav_data = yaml.safe_load(nav_config.read_text(encoding="utf-8")) or {}
nav_items = nav_data.get("nav")
if not isinstance(nav_items, list):
    raise SystemExit(f"mkdocs nav list not found in {nav_config}")

targets = []
seen = set()
for item in nav_items:
    if not isinstance(item, dict) or len(item) != 1:
        continue
    title, path = next(iter(item.items()))
    if not isinstance(title, str) or not isinstance(path, str):
        continue
    if not path.startswith("sections/") or not path.endswith(".adoc"):
        continue
    slug = path[len("sections/") : -len(".adoc")]
    if not slug or "/" in slug or slug in seen:
        continue
    seen.add(slug)
    targets.append((title, slug))

if not targets:
    raise SystemExit(f"no section entries found in mkdocs nav: {nav_config}")

lines = index_path.read_text(encoding="utf-8").splitlines()
sections = {}
current_lines = None
for line in lines:
    if line.startswith("== "):
        current_title = line[3:].strip()
        current_lines = sections.setdefault(current_title, [])
    elif current_lines is not None:
        current_lines.append(line)

sections_dir = out_dir / "sections"
if sections_dir.exists():
    if sections_dir.is_dir():
        shutil.rmtree(sections_dir)
    else:
        raise SystemExit(f"expected directory at {sections_dir}")
sections_dir.mkdir(parents=True)

header_template = "= {title}\n:relfileprefix: ../../\n:mrdocs:\n\n"

for title, slug in targets:
    content = sections.get(title)
    if content is None:
        raise SystemExit(f"missing section '{title}' in {index_path}")
    while content and not content[0].strip():
        content = content[1:]
    text = header_template.format(title=title) + "\n".join(content).rstrip() + "\n"
    (sections_dir / f"{slug}.adoc").write_text(text, encoding="utf-8")
PY
}

####################################################################################################################################
config-bool() {
    local config="$1"
    local key="$2"
    local value
    value="$(sed -n "s/^[[:space:]]*$key:[[:space:]]*//p" "$config" | head -n 1)"
    value="${value%%#*}"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
    case "$value" in
        true|yes|on|1)
            echo "true"
            ;;
        *)
            echo "false"
            ;;
    esac
}

####################################################################################################################################
compiler-from-db() {
    local db="$1"
    "$PYTHON_BIN" - "$db" <<'PY'
import json
import os
import shlex
import sys

db = sys.argv[1]
with open(db, "r", encoding="utf-8") as fh:
    data = json.load(fh)
if not isinstance(data, list) or not data:
    raise SystemExit("compile_commands.json is empty")

entry = data[0]
args = entry.get("arguments")
if not isinstance(args, list) or not args:
    cmd = entry.get("command")
    if not isinstance(cmd, str):
        raise SystemExit("compile_commands entry missing command/arguments")
    args = shlex.split(cmd)
if not args:
    raise SystemExit("compile_commands entry has empty command")

wrappers = {"ccache", "sccache", "distcc", "icecc", "buildcache"}
tool = args[0]
if os.path.basename(tool) in wrappers and len(args) > 1:
    tool = args[1]
print(tool)
PY
}

resolve-compiler() {
    local compiler="$1"
    if [ -x "$compiler" ]; then
        echo "$compiler"
        return 0
    fi
    local found
    found="$(command -v "$compiler" 2>/dev/null || true)"
    if [ -n "$found" ] && [ -x "$found" ]; then
        echo "$found"
        return 0
    fi
    die "compiler not found: $compiler"
}

collect-include-paths() {
    local compiler="$1"
    "$PYTHON_BIN" - "$compiler" <<'PY'
import subprocess
import sys

compiler = sys.argv[1]
proc = subprocess.run(
    [compiler, "-E", "-x", "c++", "-", "-v"],
    input=b"",
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    check=True,
)
text = proc.stderr.decode("utf-8")

paths = []
in_block = False
for line in text.splitlines():
    if line.strip() == "#include <...> search starts here:":
        in_block = True
        continue
    if in_block:
        if line.strip() == "End of search list.":
            break
        line = line.strip()
        if not line or line.startswith("("):
            continue
        paths.append(line)

seen = set()
deduped = []
for path in paths:
    if path in seen:
        continue
    seen.add(path)
    deduped.append(path)

libc = []
stdlib = []
system = []
for path in deduped:
    if "/lib/clang/" in path or "/llvm" in path:
        system.append(path)
    elif "/include/c++/" in path or "/c++/" in path:
        stdlib.append(path)
    else:
        libc.append(path)

for path in libc:
    print(f"libc:{path}")
for path in stdlib:
    print(f"stdlib:{path}")
for path in system:
    print(f"system:{path}")
PY
}

####################################################################################################################################
build-docs-compilation-db() {
    local config="$1"
    local out_dir="$2"
    local compiler="$3"
    local build_dir="$4"
    local compile_db="$5"
    local overlay_dir="${6-}"
    local root
    root="$(rose-source)"
    "$PYTHON_BIN" "$root/scripts/build-docs-compilation-db.py" \
        --config "$config" \
        --out-dir "$out_dir" \
        --compiler "$compiler" \
        --build-dir "$build_dir" \
        --compile-db "$compile_db" \
        --overlay-dir "$overlay_dir"
}

####################################################################################################################################
filter-compilation-db() {
    local config="$1"
    local compile_db="$2"
    local out_dir="$3"
    local overlay="${4-}"
"$PYTHON_BIN" - "$config" "$compile_db" "$out_dir" "$overlay" <<'PY'
import fnmatch
import json
import os
import sys
from pathlib import Path

config_path = Path(sys.argv[1])
compile_db_path = Path(sys.argv[2])
out_dir = Path(sys.argv[3])
overlay_path = Path(sys.argv[4]) if len(sys.argv) > 4 and sys.argv[4] else None

lines = config_path.read_text(encoding="utf-8").splitlines()

def parse_scalar(key: str) -> str | None:
    for line in lines:
        stripped = line.lstrip()
        if stripped.startswith(f"{key}:"):
            value = stripped.split(":", 1)[1].strip()
            if value:
                return value.strip("\"'")
    return None

def parse_list(key: str) -> list[str]:
    items = []
    in_block = False
    indent = None
    for line in lines:
        stripped = line.lstrip()
        if not in_block:
            if stripped.startswith(f"{key}:"):
                in_block = True
                indent = len(line) - len(stripped) + 2
            continue
        if not stripped:
            continue
        leading = len(line) - len(stripped)
        if leading < (indent or 0):
            break
        if stripped.startswith("- "):
            item = stripped[2:].strip().strip("\"'")
            if item:
                items.append(item)
    return items

config_dir = config_path.parent
use_system_stdlib_value = parse_scalar("use-system-stdlib")
use_system_stdlib = (use_system_stdlib_value or "").lower() == "true"
source_root_value = parse_scalar("source-root")
if source_root_value:
    source_root_path = Path(source_root_value)
    if not source_root_path.is_absolute():
        source_root_path = (config_dir / source_root_path).resolve()
    else:
        source_root_path = source_root_path.resolve()
else:
    source_root_path = config_dir.resolve()

input_items = parse_list("input") or [str(source_root_path / "src")]
input_paths = []
for item in input_items:
    path = Path(item)
    if not path.is_absolute():
        path = (config_dir / path).resolve()
    else:
        path = path.resolve()
    input_paths.append(path)

exclude_items = parse_list("exclude")
exclude_paths = []
for item in exclude_items:
    path = Path(item)
    if not path.is_absolute():
        path = (config_dir / path).resolve()
    else:
        path = path.resolve()
    exclude_paths.append(path)
exclude_patterns = parse_list("exclude-patterns")

def matches_exclude_patterns(path: Path) -> bool:
    if not exclude_patterns:
        return False
    path_posix = path.as_posix()
    for pat in exclude_patterns:
        if fnmatch.fnmatch(path_posix, pat):
            return True
    try:
        rel = path.resolve().relative_to(source_root_path)
    except ValueError:
        return False
    rel_posix = rel.as_posix()
    for pat in exclude_patterns:
        if fnmatch.fnmatch(rel_posix, pat):
            return True
    return False

def is_excluded(path: Path) -> bool:
    for ex in exclude_paths:
        try:
            path.relative_to(ex)
            return True
        except ValueError:
            continue
    return matches_exclude_patterns(path)

def is_in_inputs(path: Path) -> bool:
    if not input_paths:
        return True
    for base in input_paths:
        try:
            path.relative_to(base)
            return True
        except ValueError:
            continue
    return False

def is_cmake_pch_arg(arg: str) -> bool:
    return Path(arg).name.startswith("cmake_pch.")

def strip_cmake_pch_args(argv: list[str]) -> list[str]:
    if not any(is_cmake_pch_arg(arg) for arg in argv):
        return list(argv)

    cleaned = []
    i = 0
    while i < len(argv):
        arg = argv[i]

        if arg in {"-Winvalid-pch", "-fpch-instantiate-templates"}:
            i += 1
            continue

        if arg == "-include-pch" and i + 1 < len(argv) and is_cmake_pch_arg(argv[i + 1]):
            i += 2
            continue

        if arg == "-include" and i + 1 < len(argv) and is_cmake_pch_arg(argv[i + 1]):
            i += 2
            continue

        if arg == "-Xclang" and i + 1 < len(argv):
            xclang_arg = argv[i + 1]
            if xclang_arg == "-include-pch":
                if (
                    i + 3 < len(argv)
                    and argv[i + 2] == "-Xclang"
                    and is_cmake_pch_arg(argv[i + 3])
                ):
                    i += 4
                    continue
                if i + 2 < len(argv) and is_cmake_pch_arg(argv[i + 2]):
                    i += 3
                    continue
            if xclang_arg == "-include":
                if (
                    i + 3 < len(argv)
                    and argv[i + 2] == "-Xclang"
                    and is_cmake_pch_arg(argv[i + 3])
                ):
                    i += 4
                    continue
                if i + 2 < len(argv) and is_cmake_pch_arg(argv[i + 2]):
                    i += 3
                    continue

        if is_cmake_pch_arg(arg):
            i += 1
            continue

        cleaned.append(arg)
        i += 1
    return cleaned

data = json.loads(compile_db_path.read_text(encoding="utf-8"))
if not isinstance(data, list):
    raise SystemExit("compile_commands.json is not a list")

filtered = []
for entry in data:
    file_value = entry.get("file")
    if not file_value:
        continue
    file_path = Path(file_value)
    if not file_path.is_absolute():
        directory = entry.get("directory")
        base_dir = Path(directory) if directory else source_root_path
        file_path = (base_dir / file_path).resolve()
    else:
        file_path = file_path.resolve()
    if is_excluded(file_path):
        continue
    if not is_in_inputs(file_path):
        continue
    new_entry = dict(entry)
    new_entry["file"] = str(file_path)
    if "directory" in new_entry and new_entry["directory"]:
        new_entry["directory"] = str(Path(new_entry["directory"]).resolve())
    args = new_entry.get("arguments")
    if not isinstance(args, list) or not args:
        cmd = new_entry.get("command")
        if isinstance(cmd, str):
            import shlex
            args = shlex.split(cmd)
    if isinstance(args, list) and args:
        args = strip_cmake_pch_args(args)

        def is_cpp_source(path: Path, argv: list[str]) -> bool:
            suffix = path.suffix
            suffix_lower = suffix.lower()
            if suffix == ".C":
                return True
            if suffix_lower in {".cc", ".cpp", ".cxx", ".c++", ".cp"}:
                return True
            if suffix_lower == ".c":
                return False
            it = iter(range(len(argv)))
            i = 0
            while i < len(argv):
                arg = argv[i]
                if arg == "-x" and i + 1 < len(argv):
                    if "c++" in argv[i + 1]:
                        return True
                    i += 1
                elif arg.startswith("-x") and "c++" in arg:
                    return True
                i += 1
            return False

        if is_cpp_source(file_path, args):
            if not use_system_stdlib and "-nostdinc++" not in args:
                args.insert(1, "-nostdinc++")
            if overlay_path and overlay_path.is_dir():
                overlay_args = [args[i:i + 2] for i in range(len(args) - 1)]
                if ["-I", str(overlay_path)] not in overlay_args and ["-isystem", str(overlay_path)] not in overlay_args:
                    insert_at = 2 if len(args) > 1 and args[1] == "-nostdinc++" else 1
                    args[insert_at:insert_at] = ["-I", str(overlay_path)]
            prelude_arg = None
            doc_prelude = source_root_path / "src" / "docs" / "mrdocs" / "doc_prelude.h"
            if not doc_prelude.is_file():
                doc_prelude = source_root_path / "src" / "docs" / "mrdocs" / "ast_node_docs.h"
            if doc_prelude.is_file():
                prelude_arg = str(doc_prelude.resolve())
                if ["-include", prelude_arg] not in [args[i:i+2] for i in range(len(args) - 1)]:
                    insert_at = 1
                    while insert_at < len(args):
                        if args[insert_at] == "-nostdinc++":
                            insert_at += 1
                            continue
                        if overlay_path and overlay_path.is_dir():
                            if args[insert_at] in {"-I", "-isystem"} and insert_at + 1 < len(args) and args[insert_at + 1] == str(overlay_path):
                                insert_at += 2
                                continue
                        break
                    args[insert_at:insert_at] = ["-include", prelude_arg]
            if "-DROSE_DOCGEN" not in args:
                insert_at = 1
                while insert_at < len(args):
                    if args[insert_at] == "-nostdinc++":
                        insert_at += 1
                        continue
                    if overlay_path and overlay_path.is_dir():
                        if args[insert_at] in {"-I", "-isystem"} and insert_at + 1 < len(args) and args[insert_at + 1] == str(overlay_path):
                            insert_at += 2
                            continue
                    if prelude_arg and args[insert_at] == "-include" and insert_at + 1 < len(args) and args[insert_at + 1] == prelude_arg:
                        insert_at += 2
                        continue
                    break
                args.insert(insert_at, "-DROSE_DOCGEN")
        new_entry["arguments"] = args
        new_entry.pop("command", None)
    filtered.append(new_entry)

if not filtered:
    raise SystemExit("no compile_commands entries matched documentation input")

out_path = out_dir / "compile_commands.json"
out_path.write_text(json.dumps(filtered, indent=2), encoding="utf-8")
print(out_path)
PY
}

merge-compilation-db() {
    local base_db="$1"
    local extra_db="$2"
    local out_path="$3"
    "$PYTHON_BIN" - "$base_db" "$extra_db" "$out_path" <<'PY'
import json
import sys
from pathlib import Path

base_db = Path(sys.argv[1])
extra_db = Path(sys.argv[2])
out_path = Path(sys.argv[3])

def load(path: Path):
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, list):
        raise SystemExit(f"compile_commands.json is not a list: {path}")
    return data

base = load(base_db)
extra = load(extra_db)

seen = set()
merged = []
for entry in base + extra:
    if not isinstance(entry, dict):
        continue
    file_value = entry.get("file")
    directory = entry.get("directory")
    arguments = entry.get("arguments")
    key = (
        str(directory or ""),
        str(file_value or ""),
        tuple(arguments) if isinstance(arguments, list) else (),
    )
    if key in seen:
        continue
    seen.add(key)
    merged.append(entry)

out_path.write_text(json.dumps(merged, indent=2), encoding="utf-8")
print(out_path)
PY
}

####################################################################################################################################
build-include-overlay() {
    local compiler="$1"
    local out_dir="$2"
    local compile_db="${3-}"
    local overlay_dir="$out_dir/include-overlay"
    local include_paths=()

    while IFS=: read -r kind path; do
        if [ -n "$path" ]; then
            include_paths+=("$path")
        fi
    done < <(collect-include-paths "$compiler")

    if [ -n "$compile_db" ] && [ -f "$compile_db" ]; then
        while IFS= read -r path; do
            if [ -n "$path" ]; then
                include_paths+=("$path")
            fi
        done < <("$PYTHON_BIN" - "$compile_db" <<'PY'
import json
import shlex
import sys
from pathlib import Path

db = Path(sys.argv[1])
data = json.loads(db.read_text(encoding="utf-8"))
if not isinstance(data, list):
    raise SystemExit(0)

paths = []
for entry in data:
    args = entry.get("arguments")
    if not isinstance(args, list) or not args:
        cmd = entry.get("command")
        if not isinstance(cmd, str):
            continue
        args = shlex.split(cmd)
    it = iter(range(len(args)))
    i = 0
    while i < len(args):
        arg = args[i]
        next_val = args[i + 1] if i + 1 < len(args) else None
        if arg == "-isystem" and next_val:
            paths.append(next_val)
            i += 1
        i += 1

seen = set()
for raw in paths:
    path = Path(raw).resolve()
    if path in seen:
        continue
    seen.add(path)
    print(path)
PY
)
    fi

    if [ "${#include_paths[@]}" -eq 0 ]; then
        echo ""
        return 0
    fi

    "$PYTHON_BIN" - "$overlay_dir" "${include_paths[@]}" <<'PY'
import re
import sys
from pathlib import Path

overlay = Path(sys.argv[1])
bases = []
seen = set()
for raw in sys.argv[2:]:
    path = Path(raw)
    try:
        resolved = path.resolve()
    except Exception:
        resolved = path
    if resolved in seen:
        continue
    seen.add(resolved)
    bases.append(path)
pattern_tags = re.compile(r"</?\s*(tt|summary|p|strong|pre|ul|li|code|em)\b[^>]*>", re.IGNORECASE)
written = 0

for base in bases:
    if not base.is_dir():
        continue
    for path in base.rglob("*"):
        if not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except Exception:
            continue
        if not pattern_tags.search(text):
            continue
        replaced = pattern_tags.sub("", text)
        if replaced == text:
            continue
        rel = path.relative_to(base)
        dest = overlay / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(replaced, encoding="utf-8")
        written += 1

if written == 0:
    sys.exit(0)
PY

    if [ -d "$overlay_dir" ]; then
        echo "$overlay_dir"
    else
        echo ""
    fi
}

####################################################################################################################################
# Parse command-line
while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h)
            help
            exit 0
            ;;
        --version|-V)
            rose-version-long
            exit 0
            ;;
        -*)
            die "invalid switch \"$1\"; see source code for help"
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -gt 1 ]; then
    die "incorrect usage; see source code for help"
fi

check-prerequisites
CONFIG="$(config-file "${1-$DEFAULT_CONFIG}")"
output_dir="$(output-dir-from-config "$CONFIG")"
output_override="${MRDOCS_OUTPUT_DIR-}"
if [ -n "$output_override" ]; then
    if [[ "$output_override" = /* ]]; then
        output_dir="$output_override"
    else
        output_dir="$(cd "$(rose-source)" && pwd -P)/$output_override"
    fi
fi
if [ -n "$output_dir" ] && [ -d "$output_dir" ]; then
    rose_root="$(cd "$(rose-source)" && pwd -P)"
    resolved_output_dir="$(cd "$output_dir" && pwd -P)" || die "unable to resolve output directory: $output_dir"
    if [ "$resolved_output_dir" = "$rose_root" ] || [[ "$resolved_output_dir" != "$rose_root/"* ]]; then
        die "refusing to remove output directory that is not a strict subdirectory of the project root: $output_dir"
    fi
    if [ "$resolved_output_dir" = "/" ]; then
        die "refusing to remove output directory at /"
    fi
    config_dir_resolved="$(cd "$(dirname "$CONFIG")" && pwd -P)" || die "unable to resolve config directory"
    if [[ "$config_dir_resolved" == "$resolved_output_dir" || "$config_dir_resolved" == "$resolved_output_dir/"* ]]; then
        die "refusing to remove output directory that contains or is the parent of the config file: $output_dir"
    fi
    rm -rf "$resolved_output_dir"
fi

compilation_db="$(compilation-db-from-config "$CONFIG")"
if [ -z "$compilation_db" ]; then
    if [ -n "${MRDOCS_COMPILATION_DATABASE-}" ]; then
        compilation_db="$MRDOCS_COMPILATION_DATABASE"
    else
        compilation_db="$(rose-source)/build/compile_commands.json"
    fi
fi
if [ -n "$compilation_db" ] && [ ! -f "$compilation_db" ]; then
    die "compile_commands.json not found at $compilation_db (run build-rex.sh or CMake with CMAKE_EXPORT_COMPILE_COMMANDS=ON)"
fi

libc_args=()
stdlib_args=()
use_system_libc="$(config-bool "$CONFIG" "use-system-libc")"
use_system_stdlib="$(config-bool "$CONFIG" "use-system-stdlib")"
if [ "$use_system_libc" = "true" ]; then
    libc_args+=("--use-system-libc")
else
    mrdocs_root="$(mrdocs-root)"
    libc_args+=("--libc-includes" "$mrdocs_root/share/mrdocs/headers/libc-stubs")
fi

if [ "$use_system_stdlib" = "true" ]; then
    stdlib_args+=("--use-system-stdlib")
else
    mrdocs_root="${mrdocs_root-$(mrdocs-root)}"
    stdlib_args+=("--stdlib-includes" "$mrdocs_root/share/mrdocs/headers/libcxx")
    stdlib_args+=("--stdlib-includes" "$mrdocs_root/share/mrdocs/headers/clang")
fi

compiler="$(resolve-compiler "$(compiler-from-db "$compilation_db")")"
docs_dir="$(mktemp -d)"
include_overlay="$(build-include-overlay "$compiler" "$docs_dir" "$compilation_db")"
docs_db="$(filter-compilation-db "$CONFIG" "$compilation_db" "$docs_dir" "$include_overlay")"

output_args=()
if [ -n "${MRDOCS_OUTPUT_DIR-}" ]; then
    output_args=(--output "$output_dir")
fi

"$MRDOCS_CMD" --config "$CONFIG" --compilation-database "$docs_db" \
    "${output_args[@]}" \
    "${stdlib_args[@]}" \
    "${libc_args[@]}"
if [ -n "$output_dir" ]; then
    generate-reference-sections "$output_dir" "$(rose-source)/mkdocs-reference.yml"
fi
if [ -n "${MRDOCS_KEEP_TMP-}" ]; then
    echo "Keeping temporary documentation directory at $docs_dir"
else
    rm -rf "$docs_dir"
fi
