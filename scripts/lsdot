#!/usr/bin/env perl
# Author: Markus Schordan, 2003.
use strict;
use warnings;
use Cwd qw(abs_path);
use File::Basename qw(basename dirname);
use File::Find qw(find);
use Getopt::Long qw(GetOptions);

my ($output, $format, $exclude, $basename_only, $help);
GetOptions('outputfile|o=s' => \$output, 'format|f=s' => \$format,
           'exclude|e=s' => \$exclude,
           'basename|basename_opt!' => \$basename_only, 'help|h' => \$help)
    or die "Invalid lsdot options\n";
if ($help) {
    print "Usage: lsdot path [--basename] [--exclude=REGEX]\n",
          "                  [--format=FORMAT --outputfile=FILE]\n",
          "Without --outputfile, writes DOT to standard output.\n",
          "--basename labels the root with its basename instead of its full path.\n",
          "--exclude prunes directories whose paths match REGEX.\n";
    exit 0;
}
@ARGV == 1 or die "Expected one directory; see lsdot --help\n";
!defined($output) || (defined($format) && length($format))
    or die "--outputfile requires --format\n";
my $root = abs_path($ARGV[0]);
defined($root) && -d $root or die "Not a directory: $ARGV[0]\n";
my $excluded = defined($exclude) ? qr/$exclude/ : undef;
my %directories;
{
    local $SIG{__WARN__} = sub { die @_ };
    find({no_chdir => 1, preprocess => sub { sort @_ }, wanted => sub {
        return unless -d $_;
        my $path = $File::Find::name;
        if (defined($excluded) && $path =~ $excluded) {
            $File::Find::prune = 1;
            return;
        }
        $directories{$path} = 1;
    }}, $root);
}

sub dot_string {
    my ($text) = @_;
    $text =~ s/\\/\\\\/g;
    $text =~ s/"/\\"/g;
    $text =~ s/\r/\\r/g;
    $text =~ s/\n/\\n/g;
    return qq{"$text"};
}

my $graph = "digraph G {\n rankdir=LR;\n concentrate=true;\n node [shape=box];\n";
for my $path (sort keys %directories) {
    my $node = dot_string($path);
    my $label = dot_string($path eq $root && !$basename_only ? $root : basename($path));
    $graph .= " $node [label=$label];\n";
    if ($path ne $root) {
        my $parent = dirname($path);
        exists($directories{$parent}) or die "Missing directory parent: $path\n";
        $graph .= ' ' . dot_string($parent) . " -> $node;\n";
    }
}
$graph .= "}\n";
if (defined($output)) {
    open(my $dot, '|-', 'dot', '-Gfontname=Helvetica',
         '-Gorientation=landscape', "-T$format", '-o', $output)
        or die "Cannot start Graphviz: $!\n";
    print {$dot} $graph or die "Cannot write graph to Graphviz: $!\n";
    close($dot) or die "Graphviz failed (status $?)\n";
    print "$output generated.\n" or die "Cannot write output: $!\n";
} else {
    print $graph or die "Cannot write graph: $!\n";
}
