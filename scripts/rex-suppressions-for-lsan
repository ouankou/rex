# LeakSanitizer suppressions for external JVM/runtime allocations.
# These are process-lifetime allocations inside HotSpot and its native helpers
# that LSan cannot attribute correctly when embedding the JVM.
leak:libjvm.so
leak:libjava.so
leak:libzip.so

# Upstream LLVM/Clang 21 process-exit leak in template deduction diagnostics.
# Reproduced in astInterface tuple/variant tests via clang::MakeDeductionFailureInfo.
leak:clang::MakeDeductionFailureInfo
