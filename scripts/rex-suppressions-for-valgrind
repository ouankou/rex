# EXT-FLANG-SYMBOL-ARENA: docs/codebase-audit/external-exceptions.md
# Removed the nine semantic possible-leak exceptions: repeated standalone
# parsing demonstrates growing retained symbol storage, not a bounded cache.
# Keep reports visible until a supported lifetime integration is established.

# EXT-FLANG-INACTIVE-DATAREF: docs/codebase-audit/external-exceptions.md
# Debian LLVM/Flang 22.1.8, x86_64, Valgrind 3.27.1. The packaged optional
# overload speculates a read of an inactive variant tag, then selects nullptr
# using the initialized optional engagement flag. Source and assembly checked
# in both standalone flang and librose. Match only these reproduced call paths;
# no semantic fields or REX allocations are marked defined. Recheck the focused
# reproducer unsuppressed when the dependency, package build, or tool changes.
{
  llvm22_flang_inactive_dataref_assumed_rank
  Memcheck:Cond
  fun:_ZN7Fortran8evaluate24UnwrapWholeSymbolDataRefERKSt8optionalINS0_7DataRefEE
  fun:_ZN7Fortran8evaluate24UnwrapWholeSymbolDataRefIPKNS0_4ExprINS0_8SomeTypeEEEEEPKNS_9semantics6SymbolERKT_
  fun:_ZN7Fortran8evaluate16ArgumentAnalyzer19CheckForAssumedRankEPKc
}
{
  llvm22_flang_inactive_dataref_assignment
  Memcheck:Cond
  fun:_ZN7Fortran8evaluate24UnwrapWholeSymbolDataRefERKSt8optionalINS0_7DataRefEE
  fun:_ZN7Fortran8evaluate18ExpressionAnalyzer7AnalyzeERKNS_6parser14AssignmentStmtE
}
{
  llvm22_flang_inactive_dataref_argument_rank
  Memcheck:Cond
  fun:_ZN7Fortran8evaluate24UnwrapWholeSymbolDataRefERKSt8optionalINS0_7DataRefEE
  fun:_ZN7Fortran9semantics13IsAssumedRankINS_8evaluate4ExprINS2_8SomeTypeEEEEEbRKT_
}

# EXT-FLANG-INACTIVE-DATAREF / AUD-273: association analysis constructs this
# local optional in stock Flang. Its disengaged variant tag is speculatively
# read before the initialized engagement flag selects nullptr. Exact source,
# instruction and caller-boundary evidence: docs/codebase-audit/external-exceptions.md.
{
  llvm22_flang_inactive_dataref_association_rank
  Memcheck:Cond
  fun:_ZN7Fortran8evaluate24UnwrapWholeSymbolDataRefERKSt8optionalINS0_7DataRefEE
  fun:_ZN7Fortran9semantics13IsAssumedRankISt8optionalINS_8evaluate4ExprINS3_8SomeTypeEEEEEEbRKT_
  fun:_ZN7Fortran9semantics16ConstructVisitor4PostERKNS_6parser13AssociateStmtE
}

