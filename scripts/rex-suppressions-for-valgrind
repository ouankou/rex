# EXT-GREP-PATTERN-ARRAY: docs/codebase-audit/external-exceptions.md.
# GNU grep 3.12 retains patterns as an interior pointer into its pattern array.
# Require every allocation frame and the owning executable; debug symbols are
# required. Never replace an unavailable frame with an allocator-wide mask.
{
   rex_external_grep312_pattern_array_interior
   Memcheck:Leak
   match-leak-kinds: possible
   fun:realloc
   fun:rpl_realloc
   fun:xrealloc
   fun:xpalloc
   fun:GEAcompile
   obj:*/grep
}

