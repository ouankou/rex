#!/bin/bash
set -euo pipefail

arg0="${0##*/}"
dir0="${0%/*}"
root="$(cd "$dir0/.." && pwd)"

venv_dir="${DOCS_VENV_DIR:-$root/.venv-docs}"
tools_dir="${DOCS_TOOLS_DIR:-$root/.tools}"
mrdocs_root="${MRDOCS_ROOT:-$tools_dir/mrdocs}"

die() {
    echo "$arg0: error:" "$@" >&2
    exit 1
}

install_mrdocs() {
    local info version url
    info="$(python3 - <<'PY'
import json
import urllib.request

release = json.loads(urllib.request.urlopen(
    "https://api.github.com/repos/cppalliance/mrdocs/releases/latest",
    timeout=10,
).read().decode("utf-8"))
tag = release.get("tag_name", "")
assets = {a.get("name", ""): a.get("browser_download_url", "") for a in release.get("assets", [])}
linux_xz = next((u for n, u in assets.items() if n.endswith("Linux.tar.xz")), "")
linux_gz = next((u for n, u in assets.items() if n.endswith("Linux.tar.gz")), "")
url = linux_xz or linux_gz
print(f"{tag}\n{url}")
PY
)"
    version="$(printf '%s\n' "$info" | head -n 1)"
    url="$(printf '%s\n' "$info" | sed -n '2p')"
    if [ -z "$version" ] || [ -z "$url" ]; then
        die "unable to resolve latest MrDocs release"
    fi

    if [ -f "$mrdocs_root/.version" ] && [ "$(cat "$mrdocs_root/.version")" = "$version" ] \
        && [ -x "$mrdocs_root/current/bin/mrdocs" ]; then
        echo "$mrdocs_root/current/bin/mrdocs"
        return 0
    fi

    rm -rf "$mrdocs_root"
    mkdir -p "$mrdocs_root"

    local tmp_dir
    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' RETURN

    curl -L "$url" -o "$tmp_dir/mrdocs.tar.xz"
    tar -xf "$tmp_dir/mrdocs.tar.xz" -C "$mrdocs_root"
    local top_dir
    top_dir="$(tar -tf "$tmp_dir/mrdocs.tar.xz" | sed -n '1p' | cut -d/ -f1)"
    if [ -z "$top_dir" ] || [ ! -d "$mrdocs_root/$top_dir" ]; then
        die "failed to unpack MrDocs archive"
    fi
    ln -sfn "$mrdocs_root/$top_dir" "$mrdocs_root/current"
    echo "$version" > "$mrdocs_root/.version"
    echo "$mrdocs_root/current/bin/mrdocs"
}

if [ ! -d "$venv_dir" ]; then
    python3 -m venv "$venv_dir"
fi

"$venv_dir/bin/python" -m pip install --upgrade pip
"$venv_dir/bin/python" -m pip install -r "$root/docs/requirements.txt"

MRDOCS_BIN="$(install_mrdocs)"
export MRDOCS_BIN

"$root/scripts/generate-api-documentation"
"$venv_dir/bin/mkdocs" build

echo "Docs built in $root/_site"
